# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env*
.dev.vars*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code worktrees & tooling
.claude/
.playwright-cli/
output/
tmp/

# Private working notes — never commit (roadmap drafts, internal scratch)
.private/

# Internal tooling — NEVER commit these to a public repo
# Contains: sprint plans, agent state, security findings, internal docs
# Exception: brand reference docs (tone of voice, design system) are public-safe
# The same allowlist is duplicated in .github/workflows/sensitive-path-guard.yml
# and both have to be edited together. See that file for what happens otherwise.
docs/**
!docs/10-tone-of-voice.md
!docs/design-system.md
!docs/lighthouse-baseline-*.md
!docs/security-audit-*.md
!docs/insight-cover-generation-brief.md
# stack-icons-brief.md documents the icon convention on /stack: file shape,
# why currentColor is load-bearing, and how a missing icon degrades. Same
# class as the cover brief above, and src/pages/stack.astro points at it.
!docs/stack-icons-brief.md
!docs/*-image-prompts.md
# copy-quality.md describes how the two copy checks work and where their
# thresholds came from. Same class as the tone-of-voice and design-system
# docs: a public-safe reference, no client names and no internal state. It
# was written in #575 and silently swallowed by docs/** until #582, while
# both slop-structure.mjs and content-guard.yml pointed readers at it.
!docs/copy-quality.md
.agent-reports/
.agent-state/
.codex-tasks/
HANDOFF.md
archive/insights-legacy/
templates/
prompts/

# Playwright artifacts (snapshots ARE committed; outputs are not)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Terraform
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
terraform/.terraform.lock.hcl

# Internal agent handoff files
HANDOFF.md
HANDOFF*.md

# Raw/unprocessed source assets
public/images/_raw/

# Design mockups (local only, never deploy)
public/_*.html
public/_mockup-*.html
public/_full-*.html
public/_compare.html

# Local working notes and one-off scripts: never commit (private drafts leaked once via git add -A)
drafts/
check-lengths.mjs

# Vale styles are fetched by `vale sync` from the pinned Packages URL in
# .vale.ini. Committing them would vendor a copy that silently diverges from
# the pin the moment anyone runs sync with a different version.
.vale/styles/
