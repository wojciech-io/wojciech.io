# HTML pages: browser revalidates each time, CF edge caches for 1 day
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600

/insights/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600

/insights/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600

# Hashed static assets: immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# OG images: immutable (content changes only on redeploy, paths are stable)
/og/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts: immutable (versioned via ?v= query param in SEOHead preload links)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# JSON Feed: correct MIME type for feed readers
/feed.json
  Content-Type: application/feed+json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=600

# Public images: long-lived browser cache, short CF edge cache (may change)
/images/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

# Pagefind search index (served from /search/, relocated from /pagefind/ to escape a
# stale CF edge-cached worker that pinned an outdated CSP). Short edge TTL so header
# changes (e.g. CSP) can never get stuck on the stable-named entry files again.
/search/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=600

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=(), payment=()
