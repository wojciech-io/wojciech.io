---
const rows = [
  { label: 'Repository', value: 'GitHub Actions + branch protection', status: 'public-safe' },
  { label: 'Deploys', value: 'Cloudflare Pages via Wrangler', status: 'active' },
  { label: 'Security', value: 'Gitleaks, Semgrep, sensitive path guard', status: 'active' },
  { label: 'Production smoke', value: 'Post-deploy Playwright smoke', status: 'active' },
];
---

<section class="mb-8">
  <h2 class="flex items-center gap-3 mb-3">
    <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
    <span class="obs-label-accent">Operations health</span>
  </h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {rows.map((row) => (
      <li class="card-hover border border-[var(--color-border)] rounded-[var(--radius-card)] p-4 bg-[var(--color-surface)]">
        <div class="flex items-baseline justify-between gap-4">
          <span class="font-mono text-sm">{row.label}</span>
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-success)]">
            {row.status}
          </span>
        </div>
        <p class="text-xs text-[var(--color-text-dim)] mt-2">{row.value}</p>
      </li>
    ))}
  </ul>
</section>
