---
const rows = [
  { label: 'Repository', value: 'GitHub Actions + branch protection', status: 'public-safe' },
  { label: 'Deploys', value: 'Cloudflare Pages via Wrangler', status: 'active' },
  { label: 'Security', value: 'Gitleaks, Semgrep, sensitive path guard', status: 'active' },
  { label: 'Production smoke', value: 'Post-deploy Playwright smoke', status: 'active' },
];
---

<section class="mb-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-3">
    Operations health
  </h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {rows.map((row) => (
      <li class="border border-zinc-800 rounded-lg p-4 bg-zinc-900/40">
        <div class="flex items-baseline justify-between gap-4">
          <span class="font-mono text-sm">{row.label}</span>
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-900/50 text-emerald-300">
            {row.status}
          </span>
        </div>
        <p class="text-xs text-zinc-500 mt-2">{row.value}</p>
      </li>
    ))}
  </ul>
</section>
