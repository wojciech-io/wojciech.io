---
import Dashboard from '../layouts/Dashboard.astro';
import AgentHealth from '../components/AgentHealth.astro';
---

<Dashboard
  title="Operations"
  subtitle="Agent fleet — read-only. Actions deep-link to GitHub."
>
  <AgentHealth />

  <section class="mb-8">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-3">
      Quick links
    </h2>
    <ul class="space-y-2 text-sm">
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/pulls"
          class="text-emerald-400 hover:text-emerald-300 underline"
          rel="noopener"
        >
          Open PRs →
        </a>
      </li>
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/issues"
          class="text-emerald-400 hover:text-emerald-300 underline"
          rel="noopener"
        >
          Open Issues →
        </a>
      </li>
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/actions"
          class="text-emerald-400 hover:text-emerald-300 underline"
          rel="noopener"
        >
          Workflow runs →
        </a>
      </li>
      <li>
        <a
          href="https://dash.cloudflare.com"
          class="text-emerald-400 hover:text-emerald-300 underline"
          rel="noopener"
        >
          Cloudflare dashboard →
        </a>
      </li>
    </ul>
  </section>

  <section>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-3">
      Roadmap (Sprint 2)
    </h2>
    <ul class="text-sm text-zinc-300 space-y-2">
      <li>
        <span class="text-zinc-500 font-mono text-xs">[ ]</span>
        Live PR + Issue feed via GitHub API (currently links only)
      </li>
      <li>
        <span class="text-zinc-500 font-mono text-xs">[ ]</span>
        Recent <code class="text-xs bg-zinc-800 px-1 rounded">.agent-reports/</code> stream
      </li>
      <li>
        <span class="text-zinc-500 font-mono text-xs">[ ]</span>
        Last 7 days of deploy outcomes (success / fail / rollback)
      </li>
      <li>
        <span class="text-zinc-500 font-mono text-xs">[ ]</span>
        Decision queue: items waiting on Wojciech ACK
      </li>
      <li>
        <span class="text-zinc-500 font-mono text-xs">[ ]</span>
        Lighthouse score trends (last 4 weekly runs)
      </li>
    </ul>
  </section>
</Dashboard>
