---
import Dashboard from '../layouts/Dashboard.astro';
import AgentHealth from '../components/AgentHealth.astro';
---

<Dashboard
  title="Operations"
  subtitle="Agent fleet, read-only. Actions deep-link to GitHub."
>
  <AgentHealth />

  <section class="mb-8">
    <h2 class="flex items-center gap-3 mb-3">
      <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
      <span class="obs-label-accent">Quick links</span>
    </h2>
    <ul class="space-y-2 text-sm">
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/pulls"
          class="link-underline text-[var(--color-accent)] hover:text-[var(--color-accent-hi)]"
          rel="noopener"
        >
          Open PRs →
        </a>
      </li>
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/issues"
          class="link-underline text-[var(--color-accent)] hover:text-[var(--color-accent-hi)]"
          rel="noopener"
        >
          Open Issues →
        </a>
      </li>
      <li>
        <a
          href="https://github.com/wojciech-io/wojciech.io/actions"
          class="link-underline text-[var(--color-accent)] hover:text-[var(--color-accent-hi)]"
          rel="noopener"
        >
          Workflow runs →
        </a>
      </li>
      <li>
        <a
          href="https://dash.cloudflare.com"
          class="link-underline text-[var(--color-accent)] hover:text-[var(--color-accent-hi)]"
          rel="noopener"
        >
          Cloudflare dashboard →
        </a>
      </li>
    </ul>
  </section>

  <section>
    <h2 class="flex items-center gap-3 mb-3">
      <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
      <span class="obs-label-accent">Roadmap (Sprint 2)</span>
    </h2>
    <ul class="text-sm text-[var(--color-text-muted)] space-y-2">
      <li>
        <span class="text-[var(--color-text-dim)] font-mono text-xs">[ ]</span>
        Live PR + Issue feed via GitHub API (currently links only)
      </li>
      <li>
        <span class="text-[var(--color-text-dim)] font-mono text-xs">[ ]</span>
        Recent private incident and review notes
      </li>
      <li>
        <span class="text-[var(--color-text-dim)] font-mono text-xs">[ ]</span>
        Last 7 days of deploy outcomes (success / fail / rollback)
      </li>
      <li>
        <span class="text-[var(--color-text-dim)] font-mono text-xs">[ ]</span>
        Decision queue: items waiting on Wojciech ACK
      </li>
      <li>
        <span class="text-[var(--color-text-dim)] font-mono text-xs">[ ]</span>
        Lighthouse score trends (last 4 weekly runs)
      </li>
    </ul>
  </section>
</Dashboard>
