---
// Ramp-style shell for the portfolio, served at the root of app.wojciech.io.
// /apps 301s here from the edge (see public/_redirects) for published links.
// Geometry measured off the live Ramp product UI (162 real surfaces sampled):
// page #fcfbfa, rail #f4f2f0 @216px, surfaces #ffffff, lines #e9e5e2,
// radius 0 on 155/162 surfaces, headings at weight 400, rows 78px.
// Accent is Wojciech's #eaff00 and, like Ramp, is spent on ONE element per screen.
// Previews built by scripts/shoot-app-previews.mjs, all 720x450.
import '../styles/shell.css';
import { apps } from '../lib/apps-data';

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  'private-mvp': 'Private MVP',
  'private-beta': 'Private beta',
  private: 'Private',
  soon: 'Soon',
};

const HAS_PREVIEW = new Set([
  'wojciech-coach', 'klaro', 'notchcue', 'growthhub',
  'sabiszop', 'ads-assistant', 'camper-rental',
  'an-projekt', 'ciryam', 'kade', 'relora',
  'academy', 'gtm-starter-pack',
]);

// Curated running order, not alphabetical and not by status. Strongest, most
// on-brand previews lead; the entries with a designed tile instead of a
// screenshot sit last. Anything not listed falls in at the end, so adding an
// app can't silently drop it from the page.
const ORDER = [
  'wojciech-coach', 'klaro', 'notchcue', 'growthhub',
  'sabiszop', 'ads-assistant', 'camper-rental',
  'an-projekt', 'ciryam',
  'kade', 'relora', 'academy', 'gtm-starter-pack',
  'dzialkometr', 'mini-apps', 'content-hub',
];
const rank = (id: string) => {
  const i = ORDER.indexOf(id);
  return i === -1 ? ORDER.length : i;
};
const ordered = [...apps].sort((a, b) => rank(a.id) - rank(b.id));

const liveApps = ordered.filter((a) => a.status === 'live' && a.url);
const liveCount = liveApps.length;
const privateCount = ordered.filter((a) => a.status.startsWith('private')).length;
const buildingCount = ordered.filter((a) => a.status === 'in-progress' || a.status === 'soon').length;

// Overview leads with the four strongest live builds, in running order.
const featured = liveApps.slice(0, 4);

// Compact, serialisable copy of every app for the detail drawer. Rendered into a
// <script type="application/json"> blob and read client-side when a row opens.
const drawerData = ordered.map((a) => ({
  id: a.id,
  name: a.name,
  category: a.category,
  desc: a.tagline.en,
  tech: a.tech.map((t) => t.label),
  status: statusLabel[a.status],
  live: a.status === 'live' && a.url ? 1 : 0,
  url: a.url || '',
  urlLabel: (a.urlLabel && a.urlLabel.en) || 'Open',
  preview: HAS_PREVIEW.has(a.id) ? `/previews/${a.id}.webp` : '',
  tileNote: a.tileNote || '',
  icon: a.icon,
}));

const NAV_ICON: Record<string, string> = {
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  play: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>',
};

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/wojciech-luszczynski/', icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>' },
  { label: 'GitHub', href: 'https://github.com/wojciechluszczynski', icon: '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>' },
  { label: 'X', href: 'https://twitter.com/w_luszczynski', icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>' },
  { label: 'Substack', href: 'https://substack.com/@wojciechluszczynski', icon: '<path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Applications · app.wojciech.io</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      /* Shared shell (rail, topbar, main frame, metrics) lives in
         src/styles/shell.css, imported above. Only the app-list view is here. */
      .rows { border: 1px solid var(--line); background: var(--surface); }
      /* Rows are a mix of <a> (has a live URL) and <button> (no URL); both open the
         detail drawer. Reset the button so it reads identically to the anchor. */
      .row { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border: 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; background: none; width: 100%; text-align: left; font-family: inherit; font-size: 14px; cursor: pointer; }
      .row:last-child { border-bottom: 0; }
      .row:hover { background: #faf9f8; }

      .thumb { width: 148px; height: 92px; flex: none; border: 1px solid var(--line); background: var(--page); object-fit: cover; object-position: top center; border-radius: var(--radius); display: block; }
      /* Designed tile for apps with nothing worth screenshotting yet. Reads as
         deliberate artwork, never pretends to be a UI. */
      .thumb-none {
        width: 148px; height: 92px; flex: none;
        border: 1px solid var(--line); border-radius: var(--radius);
        display: grid; place-items: center; position: relative; overflow: hidden;
        background:
          repeating-linear-gradient(-45deg, transparent 0 7px, rgba(26,25,25,0.028) 7px 8px),
          radial-gradient(120% 90% at 50% 118%, rgba(234,255,0,0.32) 0%, transparent 62%),
          var(--page);
      }
      .thumb-none svg { position: relative; color: var(--ink-2); opacity: 0.85; }
      .thumb-none::after {
        content: attr(data-note);
        position: absolute; left: 0; right: 0; bottom: 0;
        font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase;
        color: var(--ink-3); text-align: center; padding: 3px 0 4px;
        border-top: 1px solid var(--line); background: rgba(255,255,255,0.7);
      }

      .row-main { min-width: 0; flex: 1; }
      .row-name { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
      .row-cat { font-size: 12px; color: var(--ink-3); margin-bottom: 5px; }
      .row-desc { font-size: 13px; color: var(--ink-2); max-width: 72ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .row-tech { display: flex; gap: 4px; width: 176px; flex: none; flex-wrap: wrap; }
      .tech { font-family: 'Geist Mono', monospace; font-size: 10px; border: 1px solid var(--line); padding: 1px 5px; color: var(--ink-2); border-radius: var(--radius); white-space: nowrap; }
      .tech.is-accent { border-color: var(--ink-3); color: var(--ink); }

      .status { font-size: 12px; flex: none; width: 92px; color: var(--ink-2); display: flex; align-items: center; gap: 6px; }
      .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--ink-3); flex: none; }
      .status.is-live .dot { background: #1f9d4d; }
      .status.is-live { color: var(--ink); }
      .row-go { color: var(--ink-3); flex: none; }
      .row:hover .row-go { color: var(--ink); }

      .empty { padding: 22px 18px; color: var(--ink-3); font-size: 13px; display: none; }

      /* ---------- locked view ---------- */
      .locked { border: 1px solid var(--line); background: var(--surface); padding: 40px 32px; text-align: center; }
      .locked-ico { width: 40px; height: 40px; margin: 0 auto 14px; display: grid; place-items: center; border: 1px solid var(--line); color: var(--ink-3); }
      .locked h3 { font-size: 16px; font-weight: 500; margin: 0 0 6px; }
      .locked p { color: var(--ink-2); font-size: 13px; margin: 0 auto; max-width: 46ch; }

      .view { display: none; }
      .view.is-on { display: block; }

      @media (max-width: 1100px) { .row-tech { display: none; } }
      @media (max-width: 860px) { .row-cat, .status { display: none; } }

      /* ---------- overview dashboard ---------- */
      .ov-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; align-items: start; }
      .card { border: 1px solid var(--line); background: var(--surface); }
      .card-h { display: flex; align-items: baseline; justify-content: space-between; padding: 13px 16px; border-bottom: 1px solid var(--line); }
      .card-h h2 { font-size: 13px; font-weight: 500; margin: 0; }
      .card-h a { font-size: 12px; color: var(--ink-3); text-decoration: none; }
      .card-h a:hover { color: var(--ink); }

      .feat { display: flex; align-items: center; gap: 13px; padding: 12px 16px; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; background: none; border-left: 0; border-right: 0; border-top: 0; width: 100%; text-align: left; font-family: inherit; cursor: pointer; }
      .feat:last-child { border-bottom: 0; }
      .feat:hover { background: #faf9f8; }
      .feat-thumb { width: 84px; height: 53px; flex: none; border: 1px solid var(--line); object-fit: cover; object-position: top center; background: var(--page); border-radius: var(--radius); }
      .feat-main { min-width: 0; flex: 1; }
      .feat-name { font-size: 13px; font-weight: 500; }
      .feat-cat { font-size: 11px; color: var(--ink-3); }
      .feat-go { color: var(--ink-3); flex: none; }
      .feat:hover .feat-go { color: var(--ink); }

      .ov-side { display: flex; flex-direction: column; gap: 16px; }
      .mini { display: flex; align-items: center; gap: 9px; padding: 10px 16px; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; background: none; border-left: 0; border-right: 0; border-top: 0; width: 100%; text-align: left; font-family: inherit; cursor: pointer; font-size: 13px; }
      .mini:last-child { border-bottom: 0; }
      .mini:hover { background: #faf9f8; }
      .mini .dot { width: 5px; height: 5px; border-radius: 50%; background: #1f9d4d; flex: none; }
      .mini .mini-cat { margin-left: auto; font-size: 11px; color: var(--ink-3); }
      .link-row { display: flex; align-items: center; gap: 9px; padding: 11px 16px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink-2); font-size: 13px; }
      .link-row:last-child { border-bottom: 0; }
      .link-row:hover { background: #faf9f8; color: var(--ink); }
      .link-row svg { color: var(--ink-3); flex: none; }
      .link-row .arr { margin-left: auto; }

      /* ---------- segmented status filter ---------- */
      .listbar { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; }
      .seg { display: inline-flex; border: 1px solid var(--line); background: var(--surface); }
      .seg-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; font: inherit; font-size: 13px; color: var(--ink-2); background: none; border: 0; border-right: 1px solid var(--line); cursor: pointer; }
      .seg-btn:last-child { border-right: 0; }
      .seg-btn:hover { color: var(--ink); background: #faf9f8; }
      .seg-btn.is-on { background: var(--ink); color: #fff; }
      .seg-ct { font-family: 'Geist Mono', monospace; font-size: 10px; opacity: 0.7; }
      .seg-btn.is-on .seg-ct { opacity: 0.85; }

      /* ---------- table header ---------- */
      .thead { display: flex; align-items: center; gap: 16px; padding: 0 18px 8px; }
      .th { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }
      .th-lead { width: 148px; flex: none; }
      .th-app { flex: 1; min-width: 0; }
      .th-tech { width: 176px; flex: none; }
      .th-status { width: 92px; flex: none; }
      .th-go { width: 15px; flex: none; }
      @media (max-width: 1100px) { .th-tech { display: none; } }
      @media (max-width: 860px) { .th-status, .th-lead { display: none; } }

      /* ---------- detail drawer ---------- */
      .drawer { position: fixed; inset: 0; z-index: 40; display: none; }
      .drawer.is-open { display: block; }
      .drawer-scrim { position: absolute; inset: 0; background: rgba(26,25,25,0.32); opacity: 0; transition: opacity .18s ease; }
      .drawer.is-open .drawer-scrim { opacity: 1; }
      .drawer-panel {
        position: absolute; top: 0; right: 0; height: 100%; width: 440px; max-width: 92vw;
        background: var(--surface); border-left: 1px solid var(--line);
        transform: translateX(100%); transition: transform .2s ease;
        display: flex; flex-direction: column; overflow-y: auto;
      }
      .drawer.is-open .drawer-panel { transform: translateX(0); }
      .drawer-x { position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); cursor: pointer; z-index: 2; }
      .drawer-x:hover { color: var(--ink); border-color: var(--ink-3); }
      .dr-media { height: 232px; border-bottom: 1px solid var(--line); background: var(--page); display: grid; place-items: center; overflow: hidden; }
      .dr-media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
      .dr-media.is-tile { background:
          repeating-linear-gradient(-45deg, transparent 0 7px, rgba(26,25,25,0.028) 7px 8px),
          radial-gradient(120% 90% at 50% 118%, rgba(234,255,0,0.32) 0%, transparent 62%),
          var(--page); }
      .dr-media.is-tile svg { color: var(--ink-2); opacity: 0.85; }
      .dr-body { padding: 22px 24px 28px; }
      .dr-cat { font-size: 12px; color: var(--ink-3); margin-bottom: 5px; }
      .dr-name { font-size: 21px; font-weight: 400; letter-spacing: -0.02em; margin: 0 0 12px; }
      .dr-status { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-2); border: 1px solid var(--line); padding: 3px 9px; margin-bottom: 16px; }
      .dr-status::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--ink-3); }
      .dr-status.is-live { color: var(--ink); }
      .dr-status.is-live::before { background: #1f9d4d; }
      .dr-desc { font-size: 14px; color: var(--ink-2); line-height: 1.55; margin: 0 0 18px; }
      .dr-tech { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 22px; }
      .dr-tech .tech { font-family: 'Geist Mono', monospace; font-size: 10px; border: 1px solid var(--line); padding: 2px 6px; color: var(--ink-2); }
      .dr-actions { display: flex; }
      .dr-open { display: inline-flex; align-items: center; gap: 7px; height: 44px; padding: 0 20px; background: var(--lime); color: var(--ink); font-size: 14px; font-weight: 500; text-decoration: none; border: 1px solid var(--lime); }
      .dr-open:hover { background: #d8ec00; border-color: #d8ec00; }
      .dr-locked { font-size: 13px; color: var(--ink-3); border: 1px solid var(--line); padding: 11px 15px; width: 100%; }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="rail">
        <a class="rail-brand" href="/">
          <svg class="brand-tile" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#ebff00"></rect>
            <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle"
              font-family="ui-sans-serif, system-ui, sans-serif" font-weight="800"
              font-size="14" fill="#080d1a">.io</text>
          </svg>
          <span class="brand-word">app<span>.wojciech.io</span></span>
        </a>

        <button class="nav-item" data-view="overview" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.home} />
          <span class="lbl">Overview</span>
        </button>

        <div class="rail-sep"></div>

        <button class="nav-item is-active" data-view="apps" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.grid} />
          <span class="lbl">Applications</span>
          <span class="pill">{ordered.length}</span>
        </button>
        <button class="nav-item" data-view="live" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.play} />
          <span class="lbl">Live demos</span>
          <span class="pill is-quiet">{liveCount}</span>
        </button>
        <a class="nav-item" href="/stack">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.layers} />
          <span class="lbl">Stack</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>

        <div class="rail-group-label">Private</div>
        <button class="nav-item" data-view="microapps" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.lock} />
          <span class="lbl">Micro-apps</span>
        </button>
        <button class="nav-item" data-view="access" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.users} />
          <span class="lbl">Access</span>
        </button>

        <div class="author">
          <div class="author-row">
            <img class="author-img" src="/wojciech-avatar-2026-384.webp" width="30" height="30" alt="Wojciech Łuszczyński" loading="lazy" />
            <div>
              <div class="author-name">Wojciech Łuszczyński</div>
              <div class="author-role">GTM architect · builder</div>
            </div>
          </div>
          <div class="author-socials">
            {socials.map((s) => (
              <a class="soc" href={s.href} target="_blank" rel="noopener me" title={s.label} aria-label={s.label}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={s.icon} />
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="main">
        <div class="topbar">
          <label class="search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input id="q" type="search" placeholder="Search apps, tags, tech…" autocomplete="off" aria-label="Search applications" />
          </label>
          <div class="top-spacer"></div>
          <a class="top-link" href="https://wojciech.io" target="_blank" rel="noopener">wojciech.io ↗</a>
        </div>

        <div class="wrap">
          <h1 id="viewTitle">Applications</h1>
          <p class="sub" id="viewSub">Things I designed, built and shipped. Most of them are live, open any.</p>

          <div class="metrics">
            <div class="metric"><div class="metric-k">Shipped</div><div class="metric-v">{ordered.length}</div></div>
            <div class="metric"><div class="metric-k">Live right now</div><div class="metric-v">{liveCount}</div></div>
            <div class="metric"><div class="metric-k">Private / building</div><div class="metric-v">{privateCount + buildingCount}</div></div>
          </div>

          <!-- overview: a real dashboard, not a trimmed list -->
          <div class="view" id="view-overview" style="display:none">
            <div class="ov-grid">
              <div class="card">
                <div class="card-h">
                  <h2>Featured work</h2>
                  <a href="#applications">All applications →</a>
                </div>
                {featured.map((app) => (
                  <button class="feat" type="button" data-app={app.id}>
                    <img class="feat-thumb" src={`/previews/${app.id}.webp`} width="84" height="53" alt={`${app.name} preview`} loading="lazy" />
                    <div class="feat-main">
                      <div class="feat-name">{app.name}</div>
                      <div class="feat-cat">{app.category}</div>
                    </div>
                    <svg class="feat-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </button>
                ))}
              </div>

              <div class="ov-side">
                <div class="card">
                  <div class="card-h"><h2>Live right now</h2><span class="card-ct">{liveCount}</span></div>
                  {liveApps.map((app) => (
                    <button class="mini" type="button" data-app={app.id}>
                      <span class="dot"></span>{app.name}<span class="mini-cat">{app.badge}</span>
                    </button>
                  ))}
                </div>
                <div class="card">
                  <div class="card-h"><h2>Explore</h2></div>
                  <a class="link-row" href="#applications">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.grid} />
                    All applications<span class="arr">→</span>
                  </a>
                  <a class="link-row" href="#live-demos">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.play} />
                    Live demos<span class="arr">→</span>
                  </a>
                  <a class="link-row" href="/stack">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.layers} />
                    Stack<span class="arr">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- list views: apps + live share one list, filtered client side -->
          <div class="view is-on" id="view-list">
            <div class="listbar">
              <div class="seg" role="group" aria-label="Filter by status">
                <button class="seg-btn is-on" type="button" data-filter="all">All <span class="seg-ct">{ordered.length}</span></button>
                <button class="seg-btn" type="button" data-filter="live">Live <span class="seg-ct">{liveCount}</span></button>
                <button class="seg-btn" type="button" data-filter="private">Private <span class="seg-ct">{privateCount}</span></button>
                <button class="seg-btn" type="button" data-filter="building">Building <span class="seg-ct">{buildingCount}</span></button>
              </div>
            </div>

            <div class="thead">
              <span class="th th-lead"></span>
              <span class="th th-app">Application</span>
              <span class="th th-tech">Stack</span>
              <span class="th th-status">Status</span>
              <span class="th th-go"></span>
            </div>

            <div class="rows" id="rows">
              {ordered.map((app) => {
                const Tag = app.url ? 'a' : 'button';
                return (
                  <Tag
                    class="row"
                    type={app.url ? undefined : 'button'}
                    href={app.url}
                    target={app.url ? '_blank' : undefined}
                    rel={app.url ? 'noopener' : undefined}
                    data-app={app.id}
                    data-status={app.status}
                    data-search={`${app.searchName} ${app.tags} ${app.name}`.toLowerCase()}
                    data-live={app.status === 'live' && app.url ? '1' : '0'}
                  >
                    {HAS_PREVIEW.has(app.id) ? (
                      <img class="thumb" src={`/previews/${app.id}.webp`} width="148" height="92" alt={`${app.name} preview`} loading="lazy" />
                    ) : (
                      <div class="thumb-none" data-note={app.tileNote}>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" set:html={app.icon} />
                      </div>
                    )}

                    <div class="row-main">
                      <div class="row-name">{app.name}</div>
                      <div class="row-cat">{app.category}</div>
                      <div class="row-desc">{app.tagline.en}</div>
                    </div>

                    <div class="row-tech">
                      {app.tech.slice(0, 3).map((t) => <span class:list={['tech', { 'is-accent': t.accent }]}>{t.label}</span>)}
                    </div>

                    <div class={`status${app.status === 'live' ? ' is-live' : ''}`}>
                      <span class="dot"></span>{statusLabel[app.status]}
                    </div>

                    {app.url ? (
                      <svg class="row-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    ) : (
                      <svg class="row-go" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    )}
                  </Tag>
                );
              })}
              <div class="empty" id="empty">Nothing matches that.</div>
            </div>
          </div>

          <div class="view" id="view-microapps" style="display:none">
            <div class="locked">
              <div class="locked-ico">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={NAV_ICON.lock} />
              </div>
              <h3>Micro-apps are not open yet</h3>
              <p>Small internal tools I hand out one by one. This needs accounts and per-person access, which is not built. Nothing to see here until it is.</p>
            </div>
          </div>

          <div class="view" id="view-access" style="display:none">
            <div class="locked">
              <div class="locked-ico">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={NAV_ICON.users} />
              </div>
              <h3>Access management is not built</h3>
              <p>This is where invites go out and permissions get granted. It arrives with the accounts system, not before.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Detail drawer: a right slide-over opened when a row (or an Overview card)
         is clicked. Content is filled client-side from the JSON blob below. -->
    <div class="drawer" id="drawer" aria-hidden="true">
      <div class="drawer-scrim" data-close></div>
      <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="dr-name">
        <button class="drawer-x" type="button" data-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <div class="dr-media" id="dr-media"></div>
        <div class="dr-body">
          <div class="dr-cat" id="dr-cat"></div>
          <h2 class="dr-name" id="dr-name"></h2>
          <div class="dr-status" id="dr-status"></div>
          <p class="dr-desc" id="dr-desc"></p>
          <div class="dr-tech" id="dr-tech"></div>
          <div class="dr-actions" id="dr-actions"></div>
        </div>
      </aside>
    </div>

    <script id="apps-json" type="application/json" is:inline set:html={JSON.stringify(drawerData)}></script>

    <script is:inline>
      (function () {
        var rows = Array.prototype.slice.call(document.querySelectorAll('#rows .row'));
        var q = document.getElementById('q');
        var empty = document.getElementById('empty');
        var title = document.getElementById('viewTitle');
        var sub = document.getElementById('viewSub');
        var navs = Array.prototype.slice.call(document.querySelectorAll('.nav-item[data-view]'));
        var segBtns = Array.prototype.slice.call(document.querySelectorAll('.seg-btn'));

        var COPY = {
          overview: ['Overview', 'The short version: what is shipped, what is live, what is still cooking.'],
          apps: ['Applications', 'Things I designed, built and shipped. Most of them are live, open any.'],
          live: ['Live demos', 'Everything you can click right now and see running.'],
          microapps: ['Micro-apps', 'Private tools, handed out one by one.'],
          access: ['Access', 'Who gets into what.'],
        };

        var view = 'apps';    // overview | apps | live | microapps | access
        var filter = 'all';   // all | live | private | building: refines the list

        // Each view is addressable via the URL hash so tabs are linkable and the
        // browser back/forward buttons move between them.
        var SLUG = { overview: 'overview', apps: 'applications', live: 'live-demos', microapps: 'micro-apps', access: 'access' };
        var VIEW = {};
        Object.keys(SLUG).forEach(function (k) { VIEW[SLUG[k]] = k; });

        function statusOK(r) {
          if (filter === 'all') return true;
          if (filter === 'live') return r.dataset.live === '1';
          if (filter === 'private') return (r.dataset.status || '').indexOf('private') === 0;
          if (filter === 'building') return r.dataset.status === 'in-progress' || r.dataset.status === 'soon';
          return true;
        }
        function syncSeg() {
          segBtns.forEach(function (b) { b.classList.toggle('is-on', b.dataset.filter === filter); });
        }

        function apply() {
          var term = (q.value || '').trim().toLowerCase();
          var shown = 0;
          rows.forEach(function (r) {
            var hit = (!term || (r.dataset.search || '').indexOf(term) !== -1) && statusOK(r);
            r.style.display = hit ? '' : 'none';
            if (hit) shown++;
          });
          empty.style.display = shown ? 'none' : 'block';
        }

        // Display is set inline so view switching never depends on the .view CSS
        // rule loading (it can drop out of the dev-mode CSSOM). Inline wins.
        function setView(id, on) {
          var el = document.getElementById(id);
          if (!el) return;
          el.classList.toggle('is-on', on);
          el.style.display = on ? 'block' : 'none';
        }

        function show(next) {
          var changed = next !== view;
          view = next;
          navs.forEach(function (n) { n.classList.toggle('is-active', n.dataset.view === next); });
          var copy = COPY[next];
          title.textContent = copy[0];
          sub.textContent = copy[1];

          var isList = next === 'apps' || next === 'live';
          setView('view-overview', next === 'overview');
          setView('view-list', isList);
          setView('view-microapps', next === 'microapps');
          setView('view-access', next === 'access');
          if (isList) { syncSeg(); apply(); }
          if (SLUG[next] && location.hash.slice(1) !== SLUG[next]) location.hash = SLUG[next];
          // A tab switch always lands at the top of the new view. Without this the
          // browser clamps the old scroll position into the new (often shorter)
          // page, which reads as the layout jumping around.
          if (changed) window.scrollTo(0, 0);
        }

        navs.forEach(function (n) {
          n.addEventListener('click', function () {
            var v = n.dataset.view;
            if (v === 'apps') filter = 'all';
            if (v === 'live') filter = 'live';
            show(v);
          });
        });

        // Status chips refine the list. 'live' maps onto the Live demos rail item;
        // every other chip lives under Applications.
        segBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            filter = b.dataset.filter;
            var railView = filter === 'live' ? 'live' : 'apps';
            if (railView !== view) show(railView);
            else { syncSeg(); apply(); }
          });
        });

        q.addEventListener('input', function () {
          if (view !== 'apps' && view !== 'live') { filter = 'all'; show('apps'); }
          else apply();
        });
        window.addEventListener('hashchange', function () {
          var v = VIEW[location.hash.slice(1)] || 'apps';
          if (v !== view) {
            if (v === 'apps') filter = 'all';
            if (v === 'live') filter = 'live';
            show(v);
          }
        });

        // ---------- detail drawer ----------
        var byId = {};
        try {
          JSON.parse(document.getElementById('apps-json').textContent || '[]')
            .forEach(function (a) { byId[a.id] = a; });
        } catch (e) {}
        var drawer = document.getElementById('drawer');

        function esc(s) {
          return String(s).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
          });
        }

        function openDrawer(id) {
          var a = byId[id];
          if (!a || !drawer) return;
          var media = document.getElementById('dr-media');
          if (a.preview) {
            media.className = 'dr-media has-img';
            media.innerHTML = '<img src="' + esc(a.preview) + '" alt="' + esc(a.name) + ' preview">';
          } else {
            media.className = 'dr-media is-tile';
            // a.icon is our own trusted SVG path markup, inserted raw on purpose.
            media.innerHTML = '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">' + a.icon + '</svg>';
          }
          document.getElementById('dr-cat').textContent = a.category;
          document.getElementById('dr-name').textContent = a.name;
          var st = document.getElementById('dr-status');
          st.textContent = a.status;
          st.className = 'dr-status' + (a.live ? ' is-live' : '');
          document.getElementById('dr-desc').textContent = a.desc;
          document.getElementById('dr-tech').innerHTML =
            (a.tech || []).map(function (t) { return '<span class="tech">' + esc(t) + '</span>'; }).join('');
          var act = document.getElementById('dr-actions');
          if (a.url) {
            act.innerHTML = '<a class="dr-open" href="' + esc(a.url) + '" target="_blank" rel="noopener">' + esc(a.urlLabel) + ' ↗</a>';
          } else {
            act.innerHTML = '<span class="dr-locked">' + esc(a.tileNote || 'Private, not public yet') + '</span>';
          }
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
        function closeDrawer() {
          if (!drawer) return;
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        // Any element carrying data-app opens the drawer: table rows and Overview cards.
        Array.prototype.forEach.call(document.querySelectorAll('[data-app]'), function (el) {
          el.addEventListener('click', function (e) {
            // Let modifier / middle clicks on real links open the site in a new tab.
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
            e.preventDefault();
            openDrawer(el.dataset.app);
          });
        });
        if (drawer) {
          Array.prototype.forEach.call(drawer.querySelectorAll('[data-close]'), function (el) {
            el.addEventListener('click', closeDrawer);
          });
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });

        // Open on the view named in the URL hash, defaulting to Applications.
        var start = VIEW[location.hash.slice(1)] || 'apps';
        if (start === 'live') filter = 'live';
        show(start);

        // Honour a ?q= term handed over from the stack page's search box.
        var qp = new URLSearchParams(location.search).get('q');
        if (qp) { q.value = qp; if (view === 'apps' || view === 'live') apply(); }
      })();
    </script>
  </body>
</html>
