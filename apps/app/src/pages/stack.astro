---
// Ramp-style stack map, served at /stack. Uses the shared shell (rail + topbar)
// from src/styles/shell.css so it matches the portfolio at the root exactly.
// The rail nav items are links here (not view-switch buttons like on index):
// the portfolio views live on / and are addressed by hash.
import '../styles/shell.css';

const NAV_ICON: Record<string, string> = {
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  play: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>',
};

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/wojciech-luszczynski/', icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>' },
  { label: 'GitHub', href: 'https://github.com/wojciechluszczynski', icon: '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>' },
  { label: 'X', href: 'https://twitter.com/w_luszczynski', icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>' },
  { label: 'Substack', href: 'https://substack.com/@wojciechluszczynski', icon: '<path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>' },
];

// Simple line icons per layer, same stroke language as the rail nav icons.
const LAYER_ICON: Record<string, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>',
  sparkle: '<path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"/><path d="M19 4v3M20.5 5.5h-3M5 17v2M6 18H4"/>',
  zap: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="1"/><path d="M2 10h20"/>',
  cpu: '<rect x="5" y="5" width="14" height="14" rx="1"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>',
  server: '<rect x="2" y="3" width="20" height="8" rx="1"/><rect x="2" y="13" width="20" height="8" rx="1"/><path d="M6 7h.01M6 17h.01"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>',
};

// The stack, in the operator's own words. English only, to match the portfolio.
const stack = [
  {
    name: 'Frontend',
    icon: LAYER_ICON.code,
    tech: ['React', 'TypeScript', 'Tailwind', 'Vite', 'shadcn/ui', 'Next.js'],
    note: 'Landing pages, operating dashboards and full SaaS apps. Type safety and component structure keep the product easy to extend after the first version ships.',
  },
  {
    name: 'Backend & data',
    icon: LAYER_ICON.database,
    tech: ['Supabase', 'FastAPI', 'Cloud Run', 'BigQuery'],
    note: 'Supabase gets auth, database and storage moving fast. As a project grows I add FastAPI, Cloud Run and BigQuery so reporting, scoring and integrations stay reliable at higher volume.',
  },
  {
    name: 'AI',
    icon: LAYER_ICON.sparkle,
    tech: ['OpenAI', 'Anthropic', 'ElevenLabs'],
    note: 'Added to specific jobs: document analysis, lead scoring, brief generation, search and summaries. What matters is input quality, decision logic and cost control.',
  },
  {
    name: 'Automation',
    icon: LAYER_ICON.zap,
    tech: ['Zapier', 'Make', 'n8n'],
    note: 'Connects CRM, email, webhooks, spreadsheets and sales tools. In practice: less manual transfer, better data quality and faster follow-up loops.',
  },
  {
    name: 'Payments & email',
    icon: LAYER_ICON.card,
    tech: ['Stripe', 'Resend'],
    note: 'Stripe covers payments, subscriptions and the customer portal. Resend closes onboarding, confirmations and lifecycle messages, the details that make a product feel mature.',
  },
  {
    name: 'Native / desktop',
    icon: LAYER_ICON.cpu,
    tech: ['Swift', 'AppKit', 'Xcode'],
    note: 'When native quality matters: menu-bar behaviour, local-first data, system APIs and a custom distribution pipeline give a better experience than a thin web wrapper.',
  },
  {
    name: 'Infrastructure',
    icon: LAYER_ICON.server,
    tech: ['Vercel', 'Netlify', 'Cloudflare', 'Cloudflare Pages', 'GitHub'],
    note: 'Hosting with fast previews, simple rollback and readable build history. These cover different needs without heavy DevOps overhead.',
  },
  {
    name: 'Static & content',
    icon: LAYER_ICON.file,
    tech: ['Astro', 'Framer', 'Webflow'],
    note: 'For work where content and publishing speed matter more than heavy app logic: landing pages, documentation and content-heavy projects.',
  },
];
const toolCount = stack.reduce((n, c) => n + c.tech.length, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stack · app.wojciech.io</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      /* Shared shell (rail, topbar, main frame) is in src/styles/shell.css.
         Only the stack map is here. */
      .sec-meta { margin-left: auto; color: var(--ink-3); font-size: 12px; }

      .stack { border: 1px solid var(--line); background: var(--surface); }
      .srow { display: flex; align-items: flex-start; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--line); transition: background 0.12s ease; }
      .srow:last-child { border-bottom: 0; }
      .srow:hover { background: #faf9f8; }

      /* Icon tile: bordered, square, thin stroke. Echoes the visual-on-the-left
         rhythm of the app rows without pretending to be a screenshot. */
      .sicon { width: 40px; height: 40px; flex: none; border: 1px solid var(--line); background: var(--page); display: grid; place-items: center; color: var(--ink-2); transition: color 0.12s ease, border-color 0.12s ease; }
      .srow:hover .sicon { color: var(--ink); border-color: var(--line-hi); }

      .smain { flex: 1; min-width: 0; }
      .scat { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 4px; }
      .snote { font-size: 13px; color: var(--ink-2); max-width: 84ch; line-height: 1.5; }

      .schips { width: 196px; flex: none; display: flex; flex-wrap: wrap; gap: 4px; align-content: flex-start; padding-top: 2px; }
      .chip { font-family: 'Geist Mono', monospace; font-size: 10px; border: 1px solid var(--line); padding: 2px 6px; color: var(--ink-2); border-radius: var(--radius); white-space: nowrap; }
      .srow:hover .chip { border-color: var(--line-hi); }

      @media (max-width: 1100px) {
        .srow { flex-wrap: wrap; }
        .smain { flex-basis: calc(100% - 56px); }
        .schips { width: 100%; order: 3; padding-left: 56px; }
      }
      @media (max-width: 560px) {
        .schips { padding-left: 0; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="rail">
        <a class="rail-brand" href="/">
          <svg class="brand-tile" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#ebff00"></rect>
            <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle"
              font-family="ui-sans-serif, system-ui, sans-serif" font-weight="800"
              font-size="14" fill="#080d1a">.io</text>
          </svg>
          <span class="brand-word">app<span>.wojciech.io</span></span>
        </a>

        <a class="nav-item" href="/#overview">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.home} />
          <span class="lbl">Overview</span>
        </a>

        <div class="rail-sep"></div>

        <a class="nav-item" href="/#applications">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.grid} />
          <span class="lbl">Applications</span>
        </a>
        <a class="nav-item" href="/#live-demos">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.play} />
          <span class="lbl">Live demos</span>
        </a>
        <a class="nav-item is-active" href="/stack" aria-current="page">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.layers} />
          <span class="lbl">Stack</span>
        </a>

        <div class="rail-group-label">Private</div>
        <a class="nav-item" href="/#micro-apps">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.lock} />
          <span class="lbl">Micro-apps</span>
        </a>
        <a class="nav-item" href="/#access">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={NAV_ICON.users} />
          <span class="lbl">Access</span>
        </a>

        <div class="author">
          <div class="author-row">
            <img class="author-img" src="/wojciech-avatar-2026-384.webp" width="30" height="30" alt="Wojciech Łuszczyński" loading="lazy" />
            <div>
              <div class="author-name">Wojciech Łuszczyński</div>
              <div class="author-role">GTM architect · builder</div>
            </div>
          </div>
          <div class="author-socials">
            {socials.map((s) => (
              <a class="soc" href={s.href} target="_blank" rel="noopener me" title={s.label} aria-label={s.label}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={s.icon} />
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="main">
        <div class="topbar">
          <label class="search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input id="q" type="search" placeholder="Search apps, tags, tech…" autocomplete="off" aria-label="Search applications" />
          </label>
          <div class="top-spacer"></div>
          <a class="top-link" href="https://wojciech.io" target="_blank" rel="noopener">wojciech.io ↗</a>
        </div>

        <div class="wrap">
          <h1>How I build</h1>
          <p class="sub">The stack, treated operationally: frontend for faster decisions, backend for reliable data, automation for repeatability, AI where it shortens a real process.</p>

          <div class="sec">
            <h2>Layers</h2>
            <span class="ct">{stack.length}</span>
            <span class="sec-meta">{toolCount} tools in rotation</span>
          </div>

          <div class="stack">
            {stack.map((cat) => (
              <div class="srow">
                <div class="sicon">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
                </div>
                <div class="smain">
                  <div class="scat">{cat.name}</div>
                  <div class="snote">{cat.note}</div>
                </div>
                <div class="schips">
                  {cat.tech.map((t) => <span class="chip">{t}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      // The search box lives with the app list on /. From the stack page, send
      // the typed term there so search still works from anywhere in the shell.
      (function () {
        var q = document.getElementById('q');
        if (!q) return;
        q.addEventListener('keydown', function (e) {
          if (e.key !== 'Enter') return;
          var term = (q.value || '').trim();
          location.href = '/?q=' + encodeURIComponent(term) + '#applications';
        });
      })();
    </script>
  </body>
</html>
