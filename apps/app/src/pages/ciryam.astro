<script is:inline>
  const statusPrefix = 'ciryam-pipeline-status:';
  document.querySelectorAll('[data-stage-control]').forEach((control) => {
    const key = statusPrefix + control.dataset.stageControl;
    const saved = localStorage.getItem(key);
    if (saved) control.value = saved;
    control.addEventListener('change', () => localStorage.setItem(key, control.value));
  });

  const eventSearch = document.getElementById('eventSearch');
  const accountSearch = document.getElementById('accountSearch');
  let activeRegion = 'all';

  function filterEvents() {
    const query = (eventSearch?.value || '').toLowerCase().trim();
    document.querySelectorAll('[data-event-row]').forEach((row) => {
      const matchesQuery = !query || row.dataset.search.includes(query);
      const matchesRegion = activeRegion === 'all' || row.dataset.region === activeRegion;
      row.hidden = !(matchesQuery && matchesRegion);
    });
  }

  function filterAccounts() {
    const query = (accountSearch?.value || '').toLowerCase().trim();
    document.querySelectorAll('[data-account-row]').forEach((row) => {
      row.hidden = query && !row.dataset.search.includes(query);
    });
  }

  eventSearch?.addEventListener('input', filterEvents);
  accountSearch?.addEventListener('input', filterAccounts);
  document.querySelectorAll('[data-event-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      activeRegion = button.dataset.eventFilter || 'all';
      document.querySelectorAll('[data-event-filter]').forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      filterEvents();
    });
  });
</script>
