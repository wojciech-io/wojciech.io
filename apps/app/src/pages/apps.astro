<script is:inline>
var _activeFilter = 'all';
var _searchTerm = '';

function filterApps() {
  _searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
  _applyFilter();
}

function setFilter(f, btn) {
  _activeFilter = f;
  document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  _applyFilter();
}

function _applyFilter() {
  var cards = document.querySelectorAll('.app-card');
  var vis = 0;
  cards.forEach(function(card) {
    var tags = (card.dataset.tags || '').toLowerCase();
    var name = (card.dataset.name || '').toLowerCase();
    var matchFilter = _activeFilter === 'all' || tags.indexOf(_activeFilter) > -1;
    var matchSearch = !_searchTerm || tags.indexOf(_searchTerm) > -1 || name.indexOf(_searchTerm) > -1;
    var show = matchFilter && matchSearch;
    card.style.display = show ? '' : 'none';
    if (show) vis++;
  });
  var ct = document.getElementById('visCount');
  if (ct) ct.textContent = vis;
  var nr = document.getElementById('noResults');
  if (nr) nr.style.display = vis === 0 ? 'block' : 'none';
}
</script>
