---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../lib/apps-data';
---
<Layout title="Apps · workspace" activePage="apps">

  <div class="profile-hero">
    <img class="profile-photo" src="/wojciech-avatar.webp" alt="Wojciech Łuszczyński" onerror="this.style.display='none'">
    <div class="profile-info">
      <div class="profile-name">Wojciech Łuszczyński</div>
      <div class="cv-h-title"
        data-pl="Architekt GTM i operator wzrostu. AI-native systemy przychodowe"
        data-en="GTM Architect & Growth Operator. AI-native revenue systems"
        data-it="Architetto GTM e operatore growth. Sistemi revenue AI-native"
      >GTM Architect & Growth Operator. AI-native revenue systems</div>
      <p class="profile-about"
        data-pl="Buduję praktyczne aplikacje, automatyzacje i dashboardy dla wzrostu B2B. Najbliżej mi do narzędzi, które spinają marketing, sprzedaż, dane i AI w jeden działający system."
        data-en="I build practical apps, automations and dashboards for B2B growth. Most of this workspace connects marketing, sales, data and AI into one operating system."
        data-it="Creo app, automazioni e dashboard pratiche per la crescita B2B. Questo workspace collega marketing, vendite, dati e AI in un unico sistema operativo."
      >I build practical apps, automations and dashboards for B2B growth. Most of this workspace connects marketing, sales, data and AI into one operating system.</p>
      <div class="profile-meta-row" aria-label="Workspace summary">
        <span>{apps.length} apps</span>
        <span>AI-native GTM</span>
        <span>B2B SaaS</span>
      </div>
    </div>
  </div>

  <div class="apps-search-wrap">
    <div class="apps-search-inner">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" id="searchInput" placeholder="Search apps, tags..." oninput="filterApps()" autocomplete="off">
    </div>
  </div>

  <div class="filters-row" style="margin-top:14px">
    <span class="f-lbl" data-pl="Filtruj:" data-en="Filter:" data-it="Filtra:">Filter:</span>
    <button class="chip active" onclick="setFilter('all',this)" data-pl="Wszystkie" data-en="All" data-it="Tutti">All</button>
    <button class="chip" onclick="setFilter('b2b',this)" data-pl="B2B / SaaS" data-en="B2B / SaaS" data-it="B2B / SaaS">B2B / SaaS</button>
    <button class="chip" onclick="setFilter('consumer',this)" data-pl="Consumer Apps" data-en="Consumer Apps" data-it="App Consumer">Consumer Apps</button>
    <button class="chip" onclick="setFilter('booking',this)" data-pl="Booking / E-commerce" data-en="Booking / E-commerce" data-it="Booking / E-commerce">Booking / E-commerce</button>
    <button class="chip" onclick="setFilter('brand',this)" data-pl="Brand Sites" data-en="Brand Sites" data-it="Siti Brand">Brand Sites</button>
    <button class="chip" onclick="setFilter('productivity',this)" data-pl="Productivity" data-en="Productivity" data-it="Produttività">Productivity</button>
  </div>

  <div class="sec-head">
    <h2 data-pl="Aplikacje" data-en="Applications" data-it="Applicazioni">Applications</h2>
    <div class="sec-line"></div>
    <div class="sec-ct" id="visCount">{apps.length}</div>
  </div>

  <div class="app-grid" id="appGrid">
    {apps.map(app => <AppCard app={app} />)}

    <div class="no-results" id="noResults" style="display:none">
      <div style="font-size:36px;margin-bottom:12px">🔍</div>
      <h3 data-pl="Brak wyników" data-en="No results" data-it="Nessun risultato">No results</h3>
      <p data-pl="Spróbuj innej frazy lub zmień filtry." data-en="Try different keywords or change filters." data-it="Prova parole chiave diverse o cambia i filtri.">Try different keywords or change filters.</p>
    </div>
  </div>

</Layout>

<script is:inline>
var _activeFilter = 'all';
var _searchTerm = '';

function filterApps() {
  _searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
  _applyFilter();
}

function setFilter(f, btn) {
  _activeFilter = f;
  document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  _applyFilter();
}

function _applyFilter() {
  var cards = document.querySelectorAll('.app-card');
  var vis = 0;
  cards.forEach(function(card) {
    var tags = (card.dataset.tags || '').toLowerCase();
    var name = (card.dataset.name || '').toLowerCase();
    var matchFilter = _activeFilter === 'all' || tags.indexOf(_activeFilter) > -1;
    var matchSearch = !_searchTerm || tags.indexOf(_searchTerm) > -1 || name.indexOf(_searchTerm) > -1;
    var show = matchFilter && matchSearch;
    card.style.display = show ? '' : 'none';
    if (show) vis++;
  });
  var ct = document.getElementById('visCount');
  if (ct) ct.textContent = vis;
  var nr = document.getElementById('noResults');
  if (nr) nr.style.display = vis === 0 ? 'block' : 'none';
}
</script>
