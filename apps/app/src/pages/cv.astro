---
import Layout from '../layouts/Layout.astro';
import CvToolChip from '../components/CvToolChip.astro';
import { stats, roles, toolGroups, setups, skillCategories, certifications, education, languages } from '../lib/cv-data';
---

<Layout title="CV · workspace" activePage="cv">
<div class="tab-content" id="tab-cv">
<div class="cv-page">

  <!-- ── 1. HEADER ── -->
  <div class="cv-header-strip">
    <div class="cv-header-inner">
      <img src="/wojciech-photo.png" class="cv-header-photo" alt="Wojciech">
      <div>
        <div class="cv-h-name">Wojciech Łuszczyński</div>
        <div class="cv-h-title"
          data-pl="Architekt GTM i operator wzrostu · AI-native systemy przychodowe"
          data-en="GTM Architect & Growth Operator · AI-native revenue systems"
          data-it="Architetto GTM e operatore growth · sistemi revenue AI-native"
        >GTM Architect & Growth Operator · AI-native revenue systems</div>
        <div class="cv-h-contacts" style="margin-top:10px">
          <span class="cv-h-contact">B2B SaaS</span>
          <span class="cv-h-contact">GTM</span>
          <span class="cv-h-contact">AI workflows</span>
          <span class="cv-h-contact">Marketing automation</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 2. SUMMARY + BY THE NUMBERS ── -->
  <div class="cv-card">
    <div class="cv-sec-title" data-pl="Summary" data-en="Summary" data-it="Sommario">Summary</div>
    <p class="cv-summary-p"
      data-pl="Buduję systemy wzrostu dla firm B2B SaaS, które mają realny produkt, ale nie mają jeszcze przewidywalnego silnika przychodu. Łączę GTM, marketing, CRM, automatyzację i AI w jeden model działania."
      data-en="I build growth systems for B2B SaaS companies that have a real product but not yet a reliable revenue engine. I connect GTM, marketing, CRM, automation and AI into one operating model."
      data-it="Creo sistemi di crescita per aziende B2B SaaS con un prodotto reale ma senza ancora un motore di revenue affidabile. Collegando GTM, marketing, CRM, automazione e AI in un unico modello operativo."
    >I build growth systems for B2B SaaS companies that have a real product but not yet a reliable revenue engine. I connect GTM, marketing, CRM, automation and AI into one operating model.</p>
    <div class="cv-stats-grid">
      {stats.map(s => (
        <div class="cv-stat-item">
          <div class="cv-stat-value">{s.value}</div>
          <div class="cv-stat-label"
            data-pl={s.label.pl}
            data-en={s.label.en}
            data-it={s.label.it}
          >{s.label.en}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ── 3. EXPERIENCE + TOOLS (2-col) ── -->
  <div class="cv-body">

    <!-- Experience -->
    <div class="cv-card">
      <div class="cv-sec-title" data-pl="Doświadczenie zawodowe" data-en="Professional Experience" data-it="Esperienza professionale">Doświadczenie zawodowe</div>

      {roles.map(role => (
        <div class="cv-role">
          <div class="cv-role-head">
            <div class="cv-role-title"
              data-pl={role.title.pl}
              data-en={role.title.en}
              data-it={role.title.it}
            >{role.title.en}</div>
            <div class="cv-role-date">{role.date}</div>
          </div>
          <div class="cv-role-company">
            {role.companyUrl
              ? <a href={role.companyUrl} target="_blank" rel="nofollow noopener">{role.company}</a>
              : role.company
            }
            {role.location && <span> · {role.location}</span>}
          </div>
          <div class="cv-role-badges">
            <span class="cv-badge-type"
              data-pl={role.type.pl}
              data-en={role.type.en}
              data-it={role.type.it}
            >{role.type.en}</span>
            {role.badges.map(b => <span class="cv-badge-ind">{b}</span>)}
          </div>
          <ul class="cv-role-bullets">
            {role.bullets.map(b => (
              <li data-pl={b.pl} data-en={b.en} data-it={b.it}>{b.en}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- RIGHT: Tools + Setups + Skills -->
    <div class="cv-right-stack">

      <div class="cv-card">
        <div class="cv-sec-title" data-pl="Narzędzia & Stack" data-en="Professional Tools" data-it="Strumenti professionali">Narzędzia & Stack</div>
        {toolGroups.map(group => (
          <div class="cv-tool-group">
            <div class="cv-tool-group-label"
              data-pl={group.label.pl}
              data-en={group.label.en}
              data-it={group.label.it}
            >{group.label.en}</div>
            <div class="cv-tool-list">
              {group.tools.map(tool => <CvToolChip tool={tool} />)}
            </div>
          </div>
        ))}
      </div>

      <div class="cv-card">
        <div class="cv-sec-title" data-pl="Setups per Usecase" data-en="Tool Setups" data-it="Configurazioni per caso d'uso">Setups per Usecase</div>
        <div class="cv-setup-list">
          {setups.map(s => (
            <div class="cv-setup-entry">
              <div class="cv-setup-name"
                data-pl={s.name.pl}
                data-en={s.name.en}
                data-it={s.name.it}
              >{s.name.en}</div>
              <div class="cv-setup-tools">
                {s.tools.map(t => <span class="cv-setup-tool">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="cv-card">
        <div class="cv-sec-title" data-pl="Kluczowe kompetencje" data-en="Key Technical Skills" data-it="Competenze chiave">Kluczowe kompetencje</div>
        <div class="cv-skills-wrap">
          {skillCategories.map(cat => (
            <div class="cv-skill-group">
              <div class="cv-skill-category"
                data-pl={cat.label.pl}
                data-en={cat.label.en}
                data-it={cat.label.it}
              >{cat.label.en}</div>
              <div class="cv-skill-list">{cat.skills}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- ── 5. CERTIFICATIONS ── -->
  <div class="cv-card">
    <div class="cv-sec-title" data-pl="Licencje & Certyfikaty" data-en="Licenses & Certifications" data-it="Licenze & Certificazioni">Licencje & Certyfikaty</div>
    <div class="cv-certs-grid">
      {certifications.map(cert => (
        <div class="cv-cert-item">
          <span class="cv-cert-badge" style={`background:${cert.bg};color:${cert.textColor ?? '#fff'}`}>{cert.badge}</span>
          <div>
            <div class="cv-cert-name">{cert.name}</div>
            <div class="cv-cert-meta">{cert.issuer} · {cert.year}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ── 6. EDUCATION ── -->
  <div class="cv-card">
    <div class="cv-sec-title" data-pl="Edukacja" data-en="Education" data-it="Istruzione">Edukacja</div>
    <div class="cv-edu-grid">
      {education.map(ed => (
        <div class="cv-edu-item">
          <div class="cv-edu-degree"
            data-pl={ed.degree.pl}
            data-en={ed.degree.en}
            data-it={ed.degree.it}
          >{ed.degree.en}</div>
          <div class="cv-edu-school">{ed.school}</div>
          <div class="cv-edu-subject"
            data-pl={ed.subject.pl}
            data-en={ed.subject.en}
            data-it={ed.subject.it}
          >{ed.subject.en}</div>
        </div>
      ))}
    </div>

    <div class="cv-lang-section">
      <div class="cv-lang-label"
        data-pl="Języki"
        data-en="Languages"
        data-it="Lingue"
      >Languages</div>
      <div class="cv-lang-list">
        {languages.map(lang => (
          <span class="cv-lang-item">
            {lang.flag}
            <span data-pl={lang.name.pl} data-en={lang.name.en} data-it={lang.name.it}>{lang.name.en}</span>,
            <span class={lang.levelClass} data-pl={lang.level.pl} data-en={lang.level.en} data-it={lang.level.it}>{lang.level.en}</span>
          </span>
        ))}
      </div>
    </div>
  </div>

</div><!-- /cv-page -->
</div>
</Layout>
