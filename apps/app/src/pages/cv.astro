---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV · workspace" activePage="cv">
<div class="tab-content" id="tab-cv">
<div class="cv-page">

  <!-- ── 1. HEADER ── -->
  <div class="cv-header-strip">
    <div style="display:flex;align-items:flex-start;gap:20px">
      <img src="/wojciech-photo.png" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--lime);flex-shrink:0" alt="Wojciech">
      <div>
        <div class="cv-h-name">Wojciech Łuszczyński</div>
        <div class="cv-h-title" data-pl="Architekt GTM i operator wzrostu · AI-native systemy przychodowe" data-en="GTM Architect & Growth Operator · AI-native revenue systems" data-it="Architetto GTM e operatore growth · sistemi revenue AI-native">GTM Architect & Growth Operator · AI-native revenue systems</div>
        <div class="cv-h-contacts" style="margin-top:10px">
          <span class="cv-h-contact">B2B SaaS</span>
          <span class="cv-h-contact">GTM</span>
          <span class="cv-h-contact">AI workflows</span>
          <span class="cv-h-contact">Marketing automation</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 2. SUMMARY + BY THE NUMBERS ── -->
  <div class="cv-card">
    <div class="cv-sec-title" data-pl="Summary" data-en="Summary" data-it="Sommario">Summary</div>
    <p style="font-size:14px;color:var(--text-2);line-height:1.75;margin-bottom:20px" data-pl="Buduję systemy wzrostu dla firm B2B SaaS, które mają realny produkt, ale nie mają jeszcze przewidywalnego silnika przychodu. Łączę GTM, marketing, CRM, automatyzację i AI w jeden model działania." data-en="I build growth systems for B2B SaaS companies that have a real product but not yet a reliable revenue engine. I connect GTM, marketing, CRM, automation and AI into one operating model." data-it="Creo sistemi di crescita per aziende B2B SaaS con un prodotto reale ma senza ancora un motore di revenue affidabile. Collegando GTM, marketing, CRM, automazione e AI in un unico modello operativo.">I build growth systems for B2B SaaS companies that have a real product but not yet a reliable revenue engine. I connect GTM, marketing, CRM, automation and AI into one operating model.</p>
    <div id="cv-summary-stats" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;border-top:1px solid var(--border);padding-top:18px">
      <div style="text-align:center;padding:8px 0">
        <div style="font-size:clamp(28px,5vw,40px);font-weight:900;color:var(--text);letter-spacing:-1.5px;line-height:1">20</div>
        <div style="font-size:11px;color:var(--text-2);margin-top:5px;line-height:1.4" data-pl="Lat marketing i digital · 10 SaaS · 10 GTM" data-en="Years marketing &amp; digital · 10 SaaS · 10 GTM" data-it="Anni marketing &amp; digital · 10 SaaS · 10 GTM">Years marketing &amp; digital · 10 SaaS · 10 GTM</div>
      </div>
      <div style="text-align:center;padding:8px 0;border-left:1px solid var(--border)">
        <div style="font-size:clamp(28px,5vw,40px);font-weight:900;color:var(--text);letter-spacing:-1.5px;line-height:1">60%</div>
        <div style="font-size:11px;color:var(--text-2);margin-top:5px;line-height:1.4" data-pl="Brand Lift przy SentiOne" data-en="Brand Lift at SentiOne" data-it="Brand Lift a SentiOne">Brand Lift przy SentiOne</div>
      </div>
      <div style="text-align:center;padding:8px 0;border-left:1px solid var(--border)">
        <div style="font-size:clamp(28px,5vw,40px);font-weight:900;color:var(--text);letter-spacing:-1.5px;line-height:1">80%</div>
        <div style="font-size:11px;color:var(--text-2);margin-top:5px;line-height:1.4" data-pl="Wzrost pozyskiwania klientów" data-en="Customer Acq. Growth" data-it="Crescita acquisizione clienti">Customer Acq. Growth</div>
      </div>
      <div style="text-align:center;padding:8px 0;border-left:1px solid var(--border)">
        <div style="font-size:clamp(28px,5vw,40px);font-weight:900;color:var(--text);letter-spacing:-1.5px;line-height:1">150%</div>
        <div style="font-size:11px;color:var(--text-2);margin-top:5px;line-height:1.4" data-pl="Śr. wzrost<br>przychodów" data-en="Avg. Revenue Uplift" data-it="Crescita media ricavi">Avg. Revenue Uplift</div>
      </div>
    </div>
  </div>

  <!-- ── 3. EXPERIENCE + TOOLS (2-col) ── -->
