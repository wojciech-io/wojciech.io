          <div class="cv-role-date">Oct 2025 to Feb 2026</div>
        </div>
        <div class="cv-role-company"><a href="https://codilime.com" target="_blank" rel="nofollow noopener" style="color:inherit;text-decoration:none">CodiLime</a></div>
        <div class="cv-role-badges"><span class="cv-badge-type" data-pl="Kontrakt" data-en="Contract" data-it="Contratto">Contract</span><span class="cv-badge-ind">B2B Tech</span><span class="cv-badge-ind">Fractional GTM</span></div>
        <ul class="cv-role-bullets">
          <li data-pl="Owned end-to-end GTM, full-funnel od awareness do zamkniętego pipeline" data-en="Owned end-to-end GTM execution, building the full funnel from awareness to pipeline" data-it="GTM end-to-end, full-funnel dall'awareness al pipeline">Owned E2E GTM, full-funnel od awareness do pipeline</li>
