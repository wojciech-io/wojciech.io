    <!-- Experience, all bullets visible -->
    <div class="cv-card">
      <div class="cv-sec-title" data-pl="Doświadczenie zawodowe" data-en="Professional Experience" data-it="Esperienza professionale">Doświadczenie zawodowe</div>

      <div class="cv-role">
        <div class="cv-role-head" style="cursor:default">
