---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact · workspace" activePage="contact">
<div class="tab-content" id="tab-contact">
<div class="contact-page">

  <section class="contact-hero contact-hero-simple">
    <div class="contact-lead-copy">
      <div class="eyebrow" data-pl="Kontakt" data-en="Contact" data-it="Contatto">Contact</div>
      <h2 class="contact-lead-title" data-pl="Opisz system i najbliższy blocker." data-en="Describe the system and the next blocker." data-it="Descrivi il sistema e il prossimo blocco.">Describe the system and the next blocker.</h2>
      <p class="contact-lead-body" data-pl="Najlepszy brief jest krótki: cel, obecny stan, co nie działa i jaki wynik ma być widoczny po pierwszym tygodniu. Odpowiem konkretnym następnym krokiem." data-en="The best brief is short: goal, current state, what is not working, and what should be visible after the first week. I will reply with a concrete next step." data-it="Il brief migliore è breve: obiettivo, stato attuale, cosa non funziona e cosa deve essere visibile dopo la prima settimana. Risponderò con un prossimo passo concreto.">The best brief is short: goal, current state, what is not working, and what should be visible after the first week. I will reply with a concrete next step.</p>
      <div class="contact-proof-strip">
        <span data-pl="GTM" data-en="GTM" data-it="GTM">GTM</span>
        <span data-pl="AI workflows" data-en="AI workflows" data-it="AI workflow">AI workflows</span>
        <span data-pl="CRM i automatyzacja" data-en="CRM and automation" data-it="CRM e automazione">CRM and automation</span>
        <span data-pl="Audyt wzrostu" data-en="Growth audit" data-it="Audit growth">Growth audit</span>
      </div>
    </div>

    <div class="contact-form-card">
      <form id="contactForm" class="contact-intake-form">
        <div class="contact-intake-head">
          <h3 data-pl="Wyślij kontekst" data-en="Send context" data-it="Invia il contesto">Send context</h3>
          <p data-pl="Formularz przygotuje wiadomość e-mail z uporządkowanym briefem." data-en="The form prepares an email with a structured brief." data-it="Il form prepara una email con un brief strutturato.">The form prepares an email with a structured brief.</p>
        </div>

        <div class="cf-grid">
          <label class="cf-field">
            <span class="cf-label" data-pl="Imię" data-en="Name" data-it="Nome">Name</span>
            <input type="text" class="cf-input" id="intakeName" placeholder="John Smith" autocomplete="name" data-pl-placeholder="Jan Kowalski" data-en-placeholder="John Smith" data-it-placeholder="Mario Rossi">
          </label>
          <label class="cf-field">
            <span class="cf-label" data-pl="Email" data-en="Email" data-it="Email">Email</span>
            <input type="email" class="cf-input" id="intakeEmail" placeholder="you@company.com" autocomplete="email" data-pl-placeholder="jan@firma.pl" data-en-placeholder="you@company.com" data-it-placeholder="tu@azienda.it">
          </label>
          <label class="cf-field cf-wide">
            <span class="cf-label" data-pl="Temat" data-en="Focus" data-it="Focus">Focus</span>
            <select class="cf-input cf-select" id="projectNeed">
              <option value="GTM / Growth">GTM / Growth</option>
              <option value="AI workflow">AI workflow</option>
              <option value="CRM / Automation">CRM / Automation</option>
              <option value="Audit / review">Audit / review</option>
            </select>
          </label>
          <label class="cf-field cf-wide">
            <span class="cf-label" data-pl="Brief" data-en="Brief" data-it="Brief">Brief</span>
            <textarea class="cf-input cf-textarea" id="intakeMessage" rows="7" placeholder="Goal, current state, blocker, links." data-pl-placeholder="Cel, obecny stan, blocker, linki." data-en-placeholder="Goal, current state, blocker, links." data-it-placeholder="Obiettivo, stato attuale, blocker, link."></textarea>
          </label>
        </div>

        <div id="intakeError" class="cf-error" style="display:none"></div>
        <div class="cf-actions cf-actions-single">
          <button class="cf-submit-btn" id="intakeSubmitBtn" type="submit">
            <span data-pl="Przygotuj wiadomość" data-en="Prepare message" data-it="Prepara messaggio">Prepare message</span>
          </button>
        </div>
        <div class="cf-meta-row">
          <span data-pl="Najlepiej: 5 to 10 zdań i linki do źródeł." data-en="Best format: 5 to 10 sentences and source links." data-it="Formato migliore: 5 to 10 frasi e link alle fonti.">Best format: 5 to 10 sentences and source links.</span>
          <span data-pl="Odpowiadam zwykle w 24h." data-en="I usually reply within 24h." data-it="Di solito rispondo entro 24h.">I usually reply within 24h.</span>
        </div>
      </form>
    </div>
  </section>

  <section class="nl-band">
    <div class="nl-band-inner">
      <div class="nl-band-left">
        <div class="nl-band-eyebrow" data-pl="Newsletter" data-en="Newsletter" data-it="Newsletter">Newsletter</div>
        <div class="nl-band-title" data-pl="Notatki operatora z działających systemów." data-en="Operator notes from live systems." data-it="Note operative da sistemi reali.">Operator notes from live systems.</div>
        <div class="nl-band-sub" data-pl="Krótko o GTM, AI workflows, CRM, automatyzacji i wzorcach, które warto powtarzać." data-en="Short notes on GTM, AI workflows, CRM, automation and patterns worth repeating." data-it="Note brevi su GTM, AI workflow, CRM, automazione e pattern da riusare.">Short notes on GTM, AI workflows, CRM, automation and patterns worth repeating.</div>
      </div>
      <form class="nl-band-right" id="newsletterForm">
        <input type="email" class="nl-input" id="nlEmail" data-pl-placeholder="twoj@email.pl" data-en-placeholder="your@email.com" data-it-placeholder="tua@email.it" placeholder="your@email.com" autocomplete="email">
        <button class="nl-btn" type="submit"><span data-pl="Zapisz się" data-en="Subscribe" data-it="Iscriviti">Subscribe</span></button>
        <div class="nl-band-note" id="nlStatus" data-pl="Raz w tygodniu. Bez szumu." data-en="Once a week. No noise." data-it="Una volta a settimana. Senza rumore.">Once a week. No noise.</div>
      </form>
    </div>
  </section>

</div>
</div>
</Layout>

<script is:inline>
function getValue(id) {
  var el = document.getElementById(id);
  return el ? (el.value || '').trim() : '';
}

var contactForm = document.getElementById('contactForm');
if (contactForm) {
  contactForm.addEventListener('submit', function(event) {
    event.preventDefault();
    var name = getValue('intakeName');
    var email = getValue('intakeEmail');
    var focus = getValue('projectNeed');
    var message = getValue('intakeMessage');
    var error = document.getElementById('intakeError');

    if (!email || !message) {
      if (error) {
        error.textContent = 'Add email and brief.';
        error.style.display = 'block';
      }
      return;
    }

    if (error) error.style.display = 'none';
    var subject = encodeURIComponent('Project context: ' + focus);
    var body = encodeURIComponent(
      'Name: ' + (name || '-') + '\n' +
      'Email: ' + email + '\n' +
      'Focus: ' + focus + '\n\n' +
      message
    );
    window.location.href = 'mailto:hello@wojciech.io?subject=' + subject + '&body=' + body;
  });
}

var newsletterForm = document.getElementById('newsletterForm');
if (newsletterForm) {
  newsletterForm.addEventListener('submit', async function(event) {
    event.preventDefault();
    var email = getValue('nlEmail');
    var status = document.getElementById('nlStatus');
    if (!email) {
      if (status) status.textContent = 'Add your email.';
      return;
    }
    if (status) status.textContent = 'Saving...';
    try {
      var res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: email }),
      });
      var data = await res.json().catch(function() { return {}; });
      if (!res.ok || data.ok === false) throw new Error(data.error || 'Subscription failed.');
      if (status) status.textContent = data.already ? 'Already subscribed.' : 'Subscribed.';
    } catch (err) {
      if (status) status.textContent = err.message || 'Try again later.';
    }
  });
}
</script>
