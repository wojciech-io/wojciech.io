---
import Layout from '../layouts/Layout.astro';
import { timelineData } from '../data/timeline-data';

function txt(val: string | { pl: string; en: string; it: string }, lang: string): string {
  if (typeof val === 'string') return val;
  return val[lang as keyof typeof val] ?? val.en;
}
---

<Layout title="Journey · workspace" activePage="timeline">
<div class="tab-content" id="tab-timeline">
<div class="tl-page">

  <div class="tl-header">
    <div class="eyebrow" data-pl="Ścieżka rozwoju" data-en="Journey" data-it="Percorso">Journey</div>
    <h2 data-pl="Od marketingu do produktu" data-en="From marketing to product" data-it="Dal marketing al prodotto">From marketing to product</h2>
    <p data-pl="Aplikacje, które zbudowałem i narzędzia, które poznałem po drodze." data-en="Apps I shipped and tools I picked up along the way." data-it="App costruite e strumenti appresi lungo il percorso.">Apps I shipped and tools I picked up along the way.</p>
  </div>

  <div class="tl-body">
    {timelineData.map(({ year, entries }) => (
      <div class="tl-year-block">
        <div class="tl-year-label">
          <div class="tl-year-num">{year}</div>
          <div class="tl-year-line"></div>
        </div>

        {entries.map((entry) => (
          <div class={`tl-entry${entry.isMilestone ? ' milestone' : ''}`}>
            <div class="tl-entry-right">
              <div class="tl-entry-head">
                <span class="tl-tech-name"
                  data-pl={typeof entry.name === 'object' ? entry.name.pl : undefined}
                  data-en={typeof entry.name === 'object' ? entry.name.en : undefined}
                  data-it={typeof entry.name === 'object' ? entry.name.it : undefined}
                >{txt(entry.name, 'en')}</span>
                <span class={`tl-cat-badge${entry.badgeStyle === 'shipped' ? ' tl-badge-shipped' : ''}`}
                  data-pl={entry.badge}
                  data-en={entry.badge}
                  data-it={entry.badge === 'Shipped' ? 'Lanciato' : entry.badge}
                >{entry.badge}</span>
              </div>
              <div class="tl-note"
                data-pl={entry.note.pl}
                data-en={entry.note.en}
                data-it={entry.note.it}
              >{entry.note.en}</div>
              {entry.tech && entry.tech.length > 0 && (
                <div class="tl-tech-row">
                  {entry.tech.map(t => <span class="tl-tc">{t}</span>)}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</div>
</div>
</Layout>
