---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
  activePage?: string;
}
const { title = 'app.wojciech.io', activePage = 'apps' } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

<!--
  Server-side gate via Pages Functions (functions/_middleware.ts).
  Unauthenticated requests are intercepted before this HTML renders and
  receive /public/login.html instead. No client-side gate needed.
-->
<div id="app" style="display:block;display:flex;flex-direction:column;min-height:100vh">
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/apps" class="app-wordmark" aria-label="app.wojciech.io">
        <span class="app-wordmark-text">app</span><span class="app-wordmark-tag">.wojciech.io</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/apps" class={`nav-link${activePage === 'apps' ? ' active' : ''}`} data-en="Apps" data-pl="Aplikacje" data-it="Applicazioni">Apps</a>
        <a href="/cv" class={`nav-link${activePage === 'cv' ? ' active' : ''}`} data-en="CV" data-pl="CV" data-it="CV">CV</a>
        <a href="/stack" class={`nav-link${activePage === 'stack' ? ' active' : ''}`} data-en="Stack" data-pl="Stack" data-it="Stack">Stack</a>
        <a href="/timeline" class={`nav-link${activePage === 'timeline' ? ' active' : ''}`} data-en="Journey" data-pl="Droga" data-it="Percorso">Journey</a>
        <a href="/contact" class={`nav-link${activePage === 'contact' ? ' active' : ''}`} data-en="Contact" data-pl="Kontakt" data-it="Contatti">Contact</a>
      </nav>
      <div class="app-header-right">
        <div class="nav-lang">
          <button class="nav-lang-btn" onclick="applyLang('pl')">PL</button>
          <button class="nav-lang-btn active" onclick="applyLang('en')">EN</button>
          <button class="nav-lang-btn" onclick="applyLang('it')">IT</button>
        </div>
        <button class="nav-theme-btn" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
          <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="app-page" style="flex:1">
    <slot />
  </main>

  <Footer />
</div>

<style>
  .app-header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .app-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .app-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .app-wordmark-text {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }
  .app-wordmark-tag {
    display: inline-block;
    background: var(--color-accent-cta);
    color: var(--color-accent-text);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1;
    margin-left: 2px;
  }
  .nav-links {
    display: flex;
    gap: 6px;
    margin-right: auto;
    margin-left: 24px;
  }
  .app-header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  @media (max-width: 720px) {
    .app-header-inner { gap: 12px; }
    .nav-links { gap: 0; margin-left: 8px; }
    .nav-link { padding: 5px 6px; font-size: 11.5px; }
  }
</style>

<script is:inline>
// ── Gate ──────────────────────────────────────
// ── Theme ──────────────────────────────────────
function setTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  var icon = document.getElementById('themeIcon');
  if (icon) icon.innerHTML = t === 'dark'
    ? '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" stroke="none"/>'
    : '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  try { localStorage.setItem('appTheme', t); } catch(e) {}
}
function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme');
  setTheme(cur === 'dark' ? 'light' : 'dark');
}
function initAppTheme() {
  var saved;
  try { saved = localStorage.getItem('appTheme'); } catch(e) {}
  var t = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  setTheme(t);
}

// ── Language ───────────────────────────────────
function applyLang(l) {
  if (l) {
    try { localStorage.setItem('appLang', l); } catch(e) {}
  } else {
    try { l = localStorage.getItem('appLang'); } catch(e) {}
    if (!l) {
      var bl = (navigator.language || 'en').toLowerCase();
      l = bl.startsWith('pl') ? 'pl' : bl.startsWith('it') ? 'it' : 'en';
    }
  }
  document.querySelectorAll('[data-en],[data-pl],[data-it]').forEach(function(el) {
    var v = el.getAttribute('data-' + l) || el.getAttribute('data-en');
    if (v !== null) el.textContent = v;
  });
  document.querySelectorAll('.nav-lang-btn').forEach(function(b) {
    b.classList.toggle('active', b.textContent === l.toUpperCase());
  });
}

// ── Init ───────────────────────────────────────
(function() {
  initAppTheme();
  applyLang();
})();
</script>
</body>
</html>
