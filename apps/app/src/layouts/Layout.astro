---
import '../styles/global.css';
interface Props {
  title?: string;
  activePage?: string;
}
const { title = 'app.wojciech.io', activePage = 'apps' } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

<!-- ═══════════════ GATE ═══════════════ -->
<div id="gate">
  <div class="g-lang">
    <button class="g-lang-btn" onclick="gLang('pl')">PL</button>
    <button class="g-lang-btn active" onclick="gLang('en')">EN</button>
    <button class="g-lang-btn" onclick="gLang('it')">IT</button>
  </div>
  <button class="g-theme-btn" id="gThemeBtn" onclick="toggleGateTheme()" title="Toggle theme" aria-label="Toggle theme">
    <svg id="gThemeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
  </button>
  <div class="g-card">
    <div class="g-avatar" id="gAvt">
      <img src="/wojciech-photo.png" id="gPhoto" onerror="this.style.display='none';document.getElementById('gInit').style.display='flex'" alt="Wojciech Łuszczyński">
      <span class="g-avatar-init" id="gInit" style="display:none">WL</span>
    </div>
    <div class="g-name">Wojciech Łuszczyński</div>
    <div class="g-badge"><span id="gBadge">AI-native revenue systems</span></div>
    <div class="g-desc" id="gDesc">I build AI-native revenue systems for B2B SaaS and technology companies: GTM, marketing, CRM, automation, analytics and AI as one operating model.</div>
    <div class="g-socials">
      <a href="https://wojciech.io" target="_blank" class="g-social">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        Portfolio
      </a>
      <a href="https://github.com/wojciechluszczynski" target="_blank" class="g-social">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/wojciech-luszczynski/" target="_blank" class="g-social">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        LinkedIn
      </a>
    </div>
    <div class="g-divider"></div>
    <input class="gate-input" type="password" id="pwInput" placeholder="Password" autocomplete="off">
    <button class="gate-btn" onclick="checkPw()" id="gBtn">Enter &rarr;</button>
    <div class="gate-err" id="gateErr">Wrong password</div>
  </div>
  <div class="g-trusted">
    <p class="g-trusted-lbl">Trusted by</p>
    <div class="g-trusted-names">
      <a href="https://www.getresponse.com" rel="nofollow noopener" target="_blank">GetResponse</a>
      <span class="g-dot">&middot;</span>
      <a href="https://sentione.com" rel="nofollow noopener" target="_blank">SentiOne</a>
      <span class="g-dot">&middot;</span>
      <a href="https://www.gigroupholding.com" rel="nofollow noopener" target="_blank">Gi Group</a>
      <span class="g-dot">&middot;</span>
      <a href="https://webwave.me" rel="nofollow noopener" target="_blank">WebWave</a>
    </div>
  </div>
</div>

<!-- ═══════════════ APP ═══════════════ -->
<div id="app">
  <nav class="app-nav">
    <a href="/apps" class="nav-brand">
      <span>W</span>L · workspace
    </a>
    <div class="nav-links">
      <a href="/apps" class={`nav-link${activePage === 'apps' ? ' active' : ''}`} data-en="Apps" data-pl="Aplikacje" data-it="Applicazioni">Apps</a>
      <a href="/cv" class={`nav-link${activePage === 'cv' ? ' active' : ''}`} data-en="CV" data-pl="CV" data-it="CV">CV</a>
      <a href="/stack" class={`nav-link${activePage === 'stack' ? ' active' : ''}`} data-en="Stack" data-pl="Stack" data-it="Stack">Stack</a>
      <a href="/timeline" class={`nav-link${activePage === 'timeline' ? ' active' : ''}`} data-en="Journey" data-pl="Droga" data-it="Percorso">Journey</a>
      <a href="/contact" class={`nav-link${activePage === 'contact' ? ' active' : ''}`} data-en="Contact" data-pl="Kontakt" data-it="Contatti">Contact</a>
    </div>
    <div class="nav-lang">
      <button class="nav-lang-btn" onclick="applyLang('pl')">PL</button>
      <button class="nav-lang-btn active" onclick="applyLang('en')">EN</button>
      <button class="nav-lang-btn" onclick="applyLang('it')">IT</button>
    </div>
    <button class="nav-theme-btn" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">
      <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>
  </nav>

  <main class="app-page">
    <slot />
  </main>
</div>

<script is:inline>
// ── Gate ──────────────────────────────────────
var _gL = 'en';
var _gC = {
  pl: { desc: 'Buduje AI-native systemy przychodowe dla firm B2B SaaS i technologicznych: GTM, marketing, CRM, automatyzacja, analityka i AI jako jeden model operacyjny.', btn: 'Wejdź →', err: 'Nieprawidłowe hasło', ph: 'Hasło', bdg: 'AI-native revenue systems' },
  en: { desc: 'I build AI-native revenue systems for B2B SaaS and technology companies: GTM, marketing, CRM, automation, analytics and AI as one operating model.', btn: 'Enter →', err: 'Wrong password', ph: 'Password', bdg: 'AI-native revenue systems' },
  it: { desc: 'Creo sistemi revenue AI-native per aziende B2B SaaS e tecnologiche: GTM, marketing, CRM, automazione, analytics e AI in un unico modello operativo.', btn: 'Entra →', err: 'Password errata', ph: 'Password', bdg: 'AI-native revenue systems' }
};
function gLang(l) {
  _gL = l;
  try { localStorage.setItem('gLang', l); } catch(e) {}
  document.querySelectorAll('.g-lang-btn').forEach(function(b) {
    b.classList.toggle('active', b.textContent === l.toUpperCase());
  });
  var c = _gC[l] || _gC.en;
  var descEl = document.getElementById('gDesc');
  var btnEl = document.getElementById('gBtn');
  var errEl = document.getElementById('gateErr');
  var bdgEl = document.getElementById('gBadge');
  var pwEl = document.getElementById('pwInput');
  if (descEl) descEl.textContent = c.desc;
  if (btnEl) btnEl.textContent = c.btn;
  if (errEl) errEl.textContent = c.err;
  if (bdgEl) bdgEl.textContent = c.bdg;
  if (pwEl) pwEl.placeholder = c.ph;
}
function toggleGateTheme() {
  var isDark = document.documentElement.getAttribute('data-theme') !== 'dark';
  document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
  var icon = document.getElementById('gThemeIcon');
  if (icon) icon.innerHTML = isDark
    ? '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" stroke="none"/>'
    : '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  try { localStorage.setItem('appTheme', isDark ? 'dark' : 'light'); } catch(e) {}
}
function checkPw() {
  var val = document.getElementById('pwInput').value.trim().toLowerCase();
  var errEl = document.getElementById('gateErr');
  if (val === 'wojciech') {
    sessionStorage.setItem('pw_ok', '1');
    document.getElementById('gate').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    initAppTheme();
    applyLang();
  } else {
    errEl.classList.add('show');
    document.getElementById('pwInput').value = '';
    setTimeout(function() { errEl.classList.remove('show'); }, 2000);
  }
}
document.getElementById('pwInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') checkPw();
});

// ── Theme ──────────────────────────────────────
function setTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  var icon = document.getElementById('themeIcon');
  if (icon) icon.innerHTML = t === 'dark'
    ? '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" stroke="none"/>'
    : '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  try { localStorage.setItem('appTheme', t); } catch(e) {}
}
function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme');
  setTheme(cur === 'dark' ? 'light' : 'dark');
}
function initAppTheme() {
  var saved;
  try { saved = localStorage.getItem('appTheme'); } catch(e) {}
  var t = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  setTheme(t);
}

// ── Language ───────────────────────────────────
function applyLang(l) {
  if (l) {
    try { localStorage.setItem('appLang', l); } catch(e) {}
  } else {
    try { l = localStorage.getItem('appLang'); } catch(e) {}
    if (!l) {
      var bl = (navigator.language || 'en').toLowerCase();
      l = bl.startsWith('pl') ? 'pl' : bl.startsWith('it') ? 'it' : 'en';
    }
  }
  document.querySelectorAll('[data-en],[data-pl],[data-it]').forEach(function(el) {
    var v = el.getAttribute('data-' + l) || el.getAttribute('data-en');
    if (v !== null) el.textContent = v;
  });
  document.querySelectorAll('.nav-lang-btn').forEach(function(b) {
    b.classList.toggle('active', b.textContent === l.toUpperCase());
  });
}

// ── Init ───────────────────────────────────────
(function() {
  // Gate language
  var sl;
  try { sl = localStorage.getItem('gLang'); } catch(e) {}
  if (sl && ['pl','en','it'].indexOf(sl) > -1) { gLang(sl); }
  else {
    var bl = (navigator.language || 'en').toLowerCase();
    gLang(bl.startsWith('pl') ? 'pl' : bl.startsWith('it') ? 'it' : 'en');
  }
  // Auto-unlock
  if (sessionStorage.getItem('pw_ok') === '1') {
    document.getElementById('gate').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    initAppTheme();
    applyLang();
  } else {
    // Apply gate theme from saved preference
    var saved;
    try { saved = localStorage.getItem('appTheme'); } catch(e) {}
    var gateTheme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', gateTheme);
    if (gateTheme === 'light') {
      var icon = document.getElementById('gThemeIcon');
      if (icon) icon.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" stroke="none"/>';
    }
    setTimeout(function() {
      var inp = document.getElementById('pwInput');
      if (inp) inp.focus();
    }, 80);
  }
})();
</script>
</body>
</html>
