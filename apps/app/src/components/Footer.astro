---
import NetworkFooter from '@wojciech/ui/components/NetworkFooter.astro';
---

<NetworkFooter variant="full">
  <div slot="brand">
    <a href="/apps" class="nfa-wordmark" aria-label="app.wojciech.io">
      <span>app</span><span class="nfa-badge">.wojciech.io</span>
    </a>
    <p
      data-en="Private workspace for apps and stack. Built on the same monorepo as wojciech.io."
      data-pl="Prywatne miejsce pracy dla aplikacji i stacku. Zbudowane w jednym monorepo z wojciech.io."
      data-it="Workspace privato per app e stack. Costruito nello stesso monorepo di wojciech.io."
      class="nfa-blurb"
    >
      Private workspace for apps and stack. Built on the same monorepo as wojciech.io.
    </p>
    <p class="nfa-cta">
      <a
        href="https://wojciech.io/contact"
        data-en="Available for projects"
        data-pl="Dostępny do projektów"
        data-it="Disponibile per progetti"
      >Available for projects</a>
    </p>
  </div>
</NetworkFooter>

<style>
  .nfa-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 16px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }
  .nfa-badge {
    display: inline-block;
    background: var(--color-accent-cta);
    color: var(--color-accent-text);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1;
    margin-left: 2px;
  }
  .nfa-blurb {
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 20px;
  }
  .nfa-cta a {
    font-size: 11px;
    color: var(--color-text-dim);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .nfa-cta a:hover { color: var(--color-text); }
</style>
