---

<footer class="app-footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <div class="footer-brand">
        <a href="/apps" class="footer-wordmark" aria-label="app.wojciech.io">
          <span>app</span><span class="footer-wordmark-tag">.wojciech.io</span>
        </a>
        <p data-en="Private workspace for apps, CV, stack and timeline. Built on the same monorepo as wojciech.io." data-pl="Prywatne miejsce pracy dla aplikacji, CV, stacku i historii. Zbudowane w jednym monorepo z wojciech.io." data-it="Workspace privato per app, CV, stack e timeline. Costruito nello stesso monorepo di wojciech.io." class="footer-blurb">
          Private workspace for apps, CV, stack and timeline. Built on the same monorepo as wojciech.io.
        </p>
        <p class="footer-tag">
          <a href="/contact" data-en="Available for projects" data-pl="Dostępny do projektów" data-it="Disponibile per progetti">Available for projects</a>
        </p>
      </div>

      <div>
        <p data-en="Workspace" data-pl="Workspace" data-it="Workspace" class="footer-col-title">Workspace</p>
        <ul class="footer-list">
          {workspace.map(({ label, href, desc }) => (
            <li><a href={href} title={desc} class="footer-link">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p data-en="Network" data-pl="Ekosystem" data-it="Ecosistema" class="footer-col-title">Network</p>
        <ul class="footer-list">
          {network.map(({ label, href, desc }) => (
            <li><a href={href} title={desc} target="_blank" rel="noopener noreferrer" class="footer-link">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p data-en="Connect" data-pl="Połącz się" data-it="Connettiti" class="footer-col-title">Connect</p>
        <ul class="footer-list">
          {connect.map(({ label, href, icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="footer-link footer-link-icon">
                <span class="footer-icon" set:html={icon} />
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Wojciech Łuszczyński · <a href="https://wojciech.io" class="footer-bottom-link">wojciech.io</a></p>
      <p data-en="GTM architect · AI-native builder" data-pl="Architekt GTM · Builder AI-native" data-it="Architetto GTM · Builder AI-native" class="footer-tagline">
        GTM architect · AI-native builder
      </p>
    </div>
  </div>
</footer>

<style>
  .app-footer {
    margin-top: 64px;
    width: 100%;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .footer-inner {
    margin: 0 auto;
    max-width: 1120px;
    padding: 0 24px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 40px 0;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 32px;
      padding: 48px 0;
    }
  }
  @media (min-width: 880px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      align-items: start;
    }
  }
  .footer-brand { max-width: 320px; }
  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 16px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }
  .footer-wordmark-tag {
    display: inline-block;
    background: var(--color-accent-cta);
    color: var(--color-accent-text);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1;
    margin-left: 2px;
  }
  .footer-blurb {
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 20px;
  }
  .footer-tag a {
    font-size: 11px;
    color: var(--color-text-dim);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .footer-tag a:hover { color: var(--color-text); }
  .footer-col-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 16px;
  }
  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-link {
    color: var(--color-text-muted);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--color-text); }
  .footer-link-icon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .footer-icon {
    flex-shrink: 0;
    opacity: 0.7;
    display: inline-flex;
    align-items: center;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--color-border);
    padding: 20px 0;
    font-size: 11px;
    color: var(--color-text-dim);
  }
  .footer-bottom-link {
    color: inherit;
    transition: color 0.15s;
  }
  .footer-bottom-link:hover { color: var(--color-text); }
  .footer-tagline { text-align: right; }
</style>
