---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    icon: '⌘',
    title: 'Start when you need it',
    title_pl: 'Włącz kiedy potrzebujesz',
    title_it: 'Avvialo quando ne hai bisogno',
    body: 'The prompter stays hidden until you need it. Show it with a keyboard shortcut right before your call, demo, or recording.',
    body_pl: 'Prompter pozostaje ukryty, dopóki go nie potrzebujesz. Wywołaj go skrótem klawiszowym tuż przed rozmową, demo lub nagraniem.',
    body_it: 'Il prompter rimane nascosto finché non ne hai bisogno. Mostralo con una scorciatoia da tastiera subito prima della chiamata, demo o registrazione.',
  },
  {
    icon: '◉',
    title: 'Close to the camera',
    title_pl: 'Blisko kamery',
    title_it: 'Vicino alla fotocamera',
    body: 'Text appears in the notch area, where your eyes already point. Less visible drift, more natural delivery.',
    body_pl: 'Tekst pojawia się w obszarze notcha: tam, gdzie i tak kierujesz wzrok. Mniej widoczne odchylenia, bardziej naturalne wypowiedzi.',
    body_it: 'Il testo appare nell\'area del notch, dove i tuoi occhi già guardano. Meno deriva visibile, consegna più naturale.',
  },
  {
    icon: '≋',
    title: 'Calm pacing',
    title_pl: 'Spokojne tempo',
    title_it: 'Ritmo tranquillo',
    body: 'Set scroll speed to match your voice. Short lines let you grab the next thought at a glance without losing your place.',
    body_pl: 'Ustaw prędkość przewijania dopasowaną do swojego głosu. Krótkie linijki pozwalają uchwycić kolejną myśl jednym spojrzeniem bez gubienia miejsca.',
    body_it: 'Imposta la velocità di scorrimento in base alla tua voce. Le righe brevi ti permettono di cogliere il pensiero successivo con uno sguardo senza perdere il filo.',
  },
  {
    icon: '◌',
    title: 'Voice-aware scrolling',
    title_pl: 'Przewijanie reagujące na głos',
    title_it: 'Scorrimento sensibile alla voce',
    body: "Optionally, the text moves while you speak and pauses when you stop. Useful when the conversation doesn't follow the script.",
    body_pl: 'Opcjonalnie tekst przesuwa się, gdy mówisz, i zatrzymuje, gdy milczysz. Przydatne, gdy rozmowa odbiega od scenariusza.',
    body_it: 'Facoltativamente, il testo si muove mentre parli e si ferma quando smetti. Utile quando la conversazione non segue lo script.',
  },
  {
    icon: '▣',
    title: 'Local notes',
    title_pl: 'Lokalne notatki',
    title_it: 'Note locali',
    body: 'Scripts, answers, and talking points stay on your Mac. No account required, no uploads before every call.',
    body_pl: 'Scenariusze, odpowiedzi i punkty do omówienia pozostają na Twoim Macu. Bez konta, bez przesyłania przed każdą rozmową.',
    body_it: 'Script, risposte e punti chiave rimangono sul tuo Mac. Nessun account richiesto, nessun caricamento prima di ogni chiamata.',
  },
  {
    icon: '☉',
    title: 'Adjustable layout',
    title_pl: 'Regulowany układ',
    title_it: 'Layout regolabile',
    body: 'Change text size, panel width, and position to fit your screen, your eyesight, and your speaking style.',
    body_pl: 'Zmień rozmiar tekstu, szerokość panelu i jego pozycję, aby dopasować do ekranu, wzroku i stylu mówienia.',
    body_it: 'Cambia dimensione del testo, larghezza del pannello e posizione per adattarli al tuo schermo, alla tua vista e al tuo stile di parlare.',
  },
];

const steps = [
  {
    img: '/assets/notchcue-call-20260510.png',
    n: '1',
    title: 'Write your talking points',
    title_pl: 'Wpisz swoje punkty do omówienia',
    title_it: 'Scrivi i tuoi punti chiave',
    body: 'Paste short bullets, an intro, questions, or offer fragments. Spoken-language text works best. Skip long paragraphs.',
    body_pl: 'Wklej krótkie punkty, wstęp, pytania lub fragmenty oferty. Tekst pisany językiem mówionym działa najlepiej. Unikaj długich akapitów.',
    body_it: 'Incolla brevi bullet, un\'introduzione, domande o frammenti di offerta. Il testo in linguaggio parlato funziona meglio. Evita paragrafi lunghi.',
  },
  {
    img: '/assets/notchcue-hero-20260510.png',
    n: '2',
    title: 'Position it near the camera',
    title_pl: 'Umieść go blisko kamery',
    title_it: 'Posizionalo vicino alla fotocamera',
    body: "The prompter sits in the notch, so you don't have to look to the corner of the screen. Adjust size, position and speed to your MacBook.",
    body_pl: 'Prompter siedzi w notchu, więc nie musisz patrzeć w róg ekranu. Dostosuj rozmiar, pozycję i prędkość do swojego MacBooka.',
    body_it: 'Il prompter si trova nel notch, quindi non devi guardare l\'angolo dello schermo. Regola dimensione, posizione e velocità al tuo MacBook.',
  },
  {
    img: '/assets/notchcue-desk-20260510.png',
    n: '3',
    title: 'Run your meeting',
    title_pl: 'Poprowadź swoje spotkanie',
    title_it: 'Conduci la tua riunione',
    body: 'You have structure close by but still sound like a person. Easy to recover after a question, a pause, or a topic change.',
    body_pl: 'Masz strukturę pod ręką, ale nadal brzmisz naturalnie. Łatwo wróć do tematu po pytaniu, przerwie lub zmianie wątku.',
    body_it: 'Hai la struttura vicina ma suoni ancora come una persona. Facile recuperare dopo una domanda, una pausa o un cambio di argomento.',
  },
];
---

<Layout>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <div class="pointer-events-none absolute left-1/2 top-[-200px] h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[var(--color-surface)] opacity-70 blur-[150px]" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32 text-center">
      <!-- Badge -->
      <div class="animate-fade-up inline-flex items-center justify-center gap-3 mb-8">
        <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span
          class="obs-label-accent"
          data-en="macOS app · Swift + Codex"
          data-pl="Aplikacja macOS · Swift + Codex"
          data-it="App macOS · Swift + Codex"
        >macOS app · Swift + Codex</span>
      </div>

      <h1 class="animate-fade-up [animation-delay:60ms] text-[clamp(3rem,8vw,6rem)] font-semibold leading-[0.92] tracking-tight text-[var(--color-text)] max-w-[800px] mx-auto mb-7">
        <span
          data-en="Notes that stay"
          data-pl="Notatki, które zostają"
          data-it="Note che restano"
        >Notes that stay</span><br>
        <span
          class="text-[var(--color-text-muted)]"
          data-en="close to the lens."
          data-pl="blisko obiektywu."
          data-it="vicino all'obiettivo."
        >close to the lens.</span>
      </h1>

      <p
        class="animate-fade-up [animation-delay:120ms] max-w-[34rem] mx-auto text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-10"
        data-en="NotchCue puts your talking points around the MacBook camera notch. Your delivery stays natural. Eye contact stays intact."
        data-pl="NotchCue umieszcza Twoje punkty do omówienia wokół notcha kamery MacBooka. Twoja wypowiedź pozostaje naturalna, kontakt wzrokowy nienaruszony."
        data-it="NotchCue posiziona i tuoi punti chiave intorno al notch della fotocamera del MacBook. La tua consegna rimane naturale, il contatto visivo rimane intatto."
      >
        NotchCue puts your talking points around the MacBook camera notch.
        Your delivery stays natural. Eye contact stays intact.
      </p>

      <div class="animate-fade-up [animation-delay:180ms] flex flex-wrap items-center justify-center gap-3">
        <a
          href="/downloads/NotchCue.dmg"
          class="btn-press inline-flex flex-col items-center h-auto rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-2.5 no-underline"
        >
          <span
            class="text-sm font-semibold text-[var(--color-accent-text)] leading-tight"
            data-en="Download NotchCue"
            data-pl="Pobierz NotchCue"
            data-it="Scarica NotchCue"
          >Download NotchCue</span>
          <span
            class="text-[10px] font-medium text-[var(--color-accent-text)] opacity-70 leading-tight"
            data-en="DMG for macOS"
            data-pl="DMG dla macOS"
            data-it="DMG per macOS"
          >DMG for macOS</span>
        </a>
        <a
          href="#how"
          class="inline-flex items-center h-11 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors"
          data-en="See how it works"
          data-pl="Zobacz jak to działa"
          data-it="Scopri come funziona"
        >
          See how it works
        </a>
      </div>

      <p
        class="animate-fade-up [animation-delay:240ms] mt-4 text-xs text-[var(--color-text-dim)]"
        data-en="Runs locally on your Mac. No account, no uploads, no browser required."
        data-pl="Działa lokalnie na Twoim Macu. Bez konta, bez przesyłania, bez przeglądarki."
        data-it="Funziona localmente sul tuo Mac. Nessun account, nessun caricamento, nessun browser richiesto."
      >
        Runs locally on your Mac. No account, no uploads, no browser required.
      </p>
    </div>

    <!-- Hero image -->
    <div class="animate-fade-up [animation-delay:300ms] mx-auto max-w-4xl px-6 pb-16">
      <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
        <img
          src="/assets/notchcue-hero-20260510.png"
          alt="NotchCue teleprompter in the MacBook notch area during a video call"
          class="w-full h-auto block"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="border-b border-[var(--color-border)] py-6">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-[var(--color-border)]">
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong
            class="text-sm font-semibold text-[var(--color-text)]"
            data-en="Less eye drift"
            data-pl="Mniej błądzenia wzrokiem"
            data-it="Sguardo in camera"
          >Less eye drift</strong>
          <span
            class="text-xs text-[var(--color-text-muted)] leading-relaxed"
            data-en="prompts are close to the camera, not at the bottom of the screen"
            data-pl="podpowiedzi są blisko kamery, nie na dole ekranu"
            data-it="i prompt sono vicini alla fotocamera, non in fondo allo schermo"
          >prompts are close to the camera, not at the bottom of the screen</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong
            class="text-sm font-semibold text-[var(--color-text)]"
            data-en="Calm delivery"
            data-pl="Spokojne wypowiedzi"
            data-it="Esposizione fluida"
          >Calm delivery</strong>
          <span
            class="text-xs text-[var(--color-text-muted)] leading-relaxed"
            data-en="know what comes next without searching through notes"
            data-pl="wiesz, co powiesz dalej, bez przeszukiwania notatek"
            data-it="sai cosa viene dopo senza cercare tra gli appunti"
          >know what comes next without searching through notes</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong
            class="text-sm font-semibold text-[var(--color-text)]"
            data-en="Fully local"
            data-pl="W pełni lokalnie"
            data-it="Completamente locale"
          >Fully local</strong>
          <span
            class="text-xs text-[var(--color-text-muted)] leading-relaxed"
            data-en="notes stay on your Mac, no account required"
            data-pl="notatki zostają na Twoim Macu, bez konta"
            data-it="le note rimangono sul tuo Mac, nessun account richiesto"
          >notes stay on your Mac, no account required</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3"
          data-en="The problem"
          data-pl="Problem"
          data-it="Il problema"
        >The problem</p>
        <h2
          class="text-xl md:text-2xl font-semibold text-[var(--color-text)] leading-snug mb-4"
          data-en="Notes break eye contact."
          data-pl="Notatki przerywają kontakt wzrokowy."
          data-it="Le note spezzano il contatto visivo."
        >Notes break eye contact.</h2>
        <p
          class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]"
          data-en="Whether it's a second monitor, a printed script, or a floating notes app, the moment your eyes drift from the camera, the audience feels it. Presence drops. Delivery sounds rehearsed."
          data-pl="Czy to drugi monitor, wydrukowany scenariusz, czy pływająca aplikacja z notatkami, w chwili gdy Twój wzrok odwraca się od kamery, rozmówca to czuje. Obecność spada. Wypowiedź brzmi wyćwiczona."
          data-it="Che sia un secondo monitor, uno script stampato o un'app di note flottante, nel momento in cui i tuoi occhi si allontanano dalla fotocamera, il pubblico lo sente. La presenza cala. La consegna suona a memoria."
        >
          Whether it's a second monitor, a printed script, or a floating notes app, the moment your eyes drift from the camera, the audience feels it. Presence drops. Delivery sounds rehearsed.
        </p>
      </div>
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3"
          data-en="The fix"
          data-pl="Rozwiązanie"
          data-it="La soluzione"
        >The fix</p>
        <h2
          class="text-xl md:text-2xl font-semibold text-[var(--color-text)] leading-snug mb-4"
          data-en="Prompts live next to the lens."
          data-pl="Podpowiedzi żyją tuż przy obiektywie."
          data-it="I prompt vivono accanto all'obiettivo."
        >Prompts live next to the lens.</h2>
        <p
          class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]"
          data-en="NotchCue places a minimal scrolling overlay directly above the camera, in the MacBook notch area. You read toward the lens, not away from it. Structure stays, eye contact stays."
          data-pl="NotchCue umieszcza minimalistyczną przewijaną nakładkę bezpośrednio nad kamerą, w obszarze notcha MacBooka. Czytasz w stronę obiektywu, nie od niego. Struktura zostaje, kontakt wzrokowy zostaje."
          data-it="NotchCue posiziona una sovrapposizione a scorrimento minimale direttamente sopra la fotocamera, nell'area del notch del MacBook. Leggi verso l'obiettivo, non lontano da esso. La struttura rimane, il contatto visivo rimane."
        >
          NotchCue places a minimal scrolling overlay directly above the camera, in the MacBook notch area. You read toward the lens, not away from it. Structure stays, eye contact stays.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p
        class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3"
        data-en="How it works"
        data-pl="Jak to działa"
        data-it="Come funziona"
      >How it works</p>
      <h2
        class="reveal-up text-2xl md:text-3xl font-semibold text-[var(--color-text)] leading-snug mb-12 max-w-lg"
        data-en="Prepare once, then run your meeting calmly."
        data-pl="Przygotuj się raz, potem spokojnie poprowadź spotkanie."
        data-it="Prepara una volta, poi conduci la tua riunione con calma."
      >
        Prepare once, then run your meeting calmly.
      </h2>

      <div class="grid md:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {steps.map((s) => (
          <article class="reveal-up card-hover bg-[var(--color-surface)] flex flex-col">
            <div class="overflow-hidden border-b border-[var(--color-border)]">
              <img
                src={s.img}
                alt={s.title}
                class="w-full h-48 object-cover object-top"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex-1 flex flex-col gap-2">
              <div class="mb-2 h-px w-8 bg-[var(--color-accent-cta)]"></div>
              <div class="flex items-center gap-2 mb-1">
                <span
                  class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]"
                  data-en={`Step ${s.n}`}
                  data-pl={`Krok ${s.n}`}
                  data-it={`Passo ${s.n}`}
                >Step {s.n}</span>
              </div>
              <h3
                class="text-sm font-semibold text-[var(--color-text)]"
                data-en={s.title}
                data-pl={s.title_pl}
                data-it={s.title_it}
              >{s.title}</h3>
              <p
                class="text-sm leading-relaxed text-[var(--color-text-muted)]"
                data-en={s.body}
                data-pl={s.body_pl}
                data-it={s.body_it}
              >{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo video -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p
            class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3"
            data-en="On calls"
            data-pl="Na rozmowach"
            data-it="Nelle chiamate"
          >On calls</p>
          <h2
            class="reveal-up text-2xl md:text-3xl font-semibold text-[var(--color-text)] leading-snug mb-4"
            data-en="Looks like part of the screen, not a second notes window."
            data-pl="Wygląda jak część ekranu, nie drugie okno z notatkami."
            data-it="Sembra parte dello schermo, non una seconda finestra di note."
          >
            Looks like part of the screen, not a second notes window.
          </h2>
          <p
            class="reveal-up text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]"
            data-en="NotchCue is designed for real calls: discreet, fast to launch, readable enough to catch the next thought without scanning a full document."
            data-pl="NotchCue jest zaprojektowany do prawdziwych rozmów: dyskretny, szybki do uruchomienia, wystarczająco czytelny, by uchwycić kolejną myśl bez przeglądania całego dokumentu."
            data-it="NotchCue è progettato per chiamate reali: discreto, veloce da avviare, abbastanza leggibile da cogliere il prossimo pensiero senza scorrere un intero documento."
          >
            NotchCue is designed for real calls: discreet, fast to launch, readable enough to catch the next thought without scanning a full document.
          </p>
        </div>
        <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/assets/notchcue-hero-20260510.png"
            class="w-full h-auto block"
          >
            <source src="/assets/notchcue-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p
        class="reveal-up text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)] mb-8"
        data-en="What it does"
        data-pl="Co robi"
        data-it="Cosa fa"
      >What it does</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {features.map((f) => (
          <article class="reveal-up card-hover bg-[var(--color-surface)] p-6">
            <div class="mb-4 h-px w-8 bg-[var(--color-accent-cta)]"></div>
            <h3
              class="text-sm font-semibold text-[var(--color-text)] mb-2"
              data-en={f.title}
              data-pl={f.title_pl}
              data-it={f.title_it}
            >{f.title}</h3>
            <p
              class="text-sm leading-relaxed text-[var(--color-text-muted)]"
              data-en={f.body}
              data-pl={f.body_pl}
              data-it={f.body_it}
            >{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Built by -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-wrap items-center justify-between gap-6">
      <div class="reveal-up">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-2"
          data-en="Built by"
          data-pl="Zbudowane przez"
          data-it="Creato da"
        >Built by</p>
        <a href="https://wojciech.io" class="group flex items-center gap-2 no-underline">
          <span class="link-underline text-base font-semibold text-[var(--color-text)] transition-colors">Wojciech Łuszczyński</span>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="opacity-40"><path d="M6 3h7m0 0v7m0-7L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="reveal-up flex flex-wrap gap-2">
        {['Swift', 'Codex', 'AI-built', 'macOS native'].map((tag) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium text-[var(--color-text-muted)]">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
