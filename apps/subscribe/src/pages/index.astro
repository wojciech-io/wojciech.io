---
import Layout from '../layouts/Layout.astro';
import { editions, totalIssues } from '../data/editions';

const latest = editions[0];
// Skip the latest issue here — it's already rendered in full above.
const inbox = editions.slice(1, 9);

const EN_MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
function fmtDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return `${EN_MONTHS[m - 1]} ${d}, ${y}`;
}
function shortDate(iso: string): string {
  const [, m, d] = iso.split('-').map(Number);
  return `${EN_MONTHS[m - 1].slice(0, 3)} ${d}`;
}

// Preview cards mirror the latest sent issue (editions[0]) so the page shows the
// real thing, not a divergent mockup. Update alongside editions.ts.
const previewItems = [
  {
    label: 'Routing',
    title: 'GitHub ships Opus 4.8 fast mode to Copilot.',
    body: 'It lands the same week Anthropic retires fast mode for 4.6. Model choice is turning into a routing decision you design, not a switch you flip.',
    why: 'Teams will pick models per task and per budget. The routing layer is the new architecture.',
    source: 'github.blog',
  },
  {
    label: 'Seats',
    title: 'OpenAI folds Codex into ChatGPT Business seats.',
    body: 'Business workspaces can no longer add usage-billed Codex seats. One per-user price now covers ChatGPT and Codex, moving agent coding from metered experiment to standard seat.',
    why: 'Flat pricing makes agent coding a default, not a line item someone has to justify.',
    source: 'help.openai.com',
  },
  {
    label: 'Supply chain',
    title: 'GitHub locks the Actions cache for untrusted triggers.',
    body: 'Forked pull requests get read-only cache, closing the path where an outside contribution poisons a cache that trusted CI later reuses.',
    why: 'Agentic CI runs more outside code. Cache isolation is now part of the threat model.',
    source: 'github.blog',
  },
];
---

<Layout>
  <main id="top">

    <!-- ─── HERO ───────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden subscribe-hero" style="border-bottom: 1px solid var(--color-border);">

      <!-- Grid: dissolves toward the edges (depth, not a flat sheet) -->
      <div class="subscribe-hero-grid pointer-events-none absolute inset-0" style="background-image: linear-gradient(to right, var(--color-grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--color-grid-line) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <!-- Lime aura: colour + depth behind the headline, matched to the homepage hero -->
      <div class="subscribe-hero-aura pointer-events-none absolute" style="left: -140px; top: -170px; height: 520px; width: 620px; border-radius: 9999px;" aria-hidden="true"></div>
      <!-- Neutral depth, kept subtle under the aura -->
      <div class="pointer-events-none absolute" style="left: -160px; top: -180px; height: 520px; width: 620px; border-radius: 9999px; background: var(--color-surface); filter: blur(140px); opacity: 0.5;" aria-hidden="true"></div>

      <!-- Photo: desktop right half, absolute. Same retouched shot + warm grade as the homepage hero, so the funnel and the site read as one person, one world. -->
      <div class="subscribe-hero-photo hidden lg:block absolute right-0 top-0 bottom-0" style="width: 46%; overflow: hidden;" aria-hidden="true">
        <img
          src="/wojciech-office-hq.webp"
          alt=""
          width="1200"
          height="1500"
          loading="eager"
          decoding="async"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%;"
        />
        <!-- Left fade: blends photo into bg -->
        <div class="absolute inset-y-0 left-0 pointer-events-none" style="width: 38%; background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);"></div>
        <!-- Top fade -->
        <div class="absolute inset-x-0 top-0 pointer-events-none" style="height: 14%; background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 100%);"></div>
        <!-- Bottom fade -->
        <div class="absolute inset-x-0 bottom-0 pointer-events-none" style="height: 22%; background: linear-gradient(to top, var(--color-bg) 0%, transparent 100%);"></div>
      </div>

      <!-- Left column: copy + form -->
      <div class="relative mx-auto px-6" style="max-width: 72rem;">
        <div class="animate-fade-up flex flex-col justify-center" style="padding-top: clamp(2rem, 7vw, 6.5rem); padding-bottom: clamp(2.5rem, 9vw, 8rem); max-width: 100%;" id="form-col">

          <!-- avatar + name -->
          <div class="flex items-center gap-3 mb-7">
            <img
              src="/wojciech-avatar.webp"
              alt="Wojciech Łuszczyński"
              width="44"
              height="44"
              loading="eager"
              style="width: 44px; height: 44px; border-radius: 9999px; object-fit: cover; object-position: top; border: 2px solid var(--color-border); flex-shrink: 0;"
            />
            <div>
              <p style="font-size: 13px; font-weight: 600; color: var(--color-text); line-height: 1.2;">Wojciech Łuszczyński</p>
              <p style="font-size: 11px; color: var(--color-text-dim);">GTM architect and AI-native builder</p>
            </div>
          </div>

          <!-- Badge -->
          <div style="display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; border-radius: 9999px; border: 1px solid var(--color-border); background: var(--color-glass); padding: 0.5rem 0.875rem; margin-bottom: 1.75rem; box-shadow: var(--shadow-card); backdrop-filter: blur(8px);">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--color-accent-cta); box-shadow: 0 0 14px rgb(235 255 0 / 0.6); flex-shrink: 0;"></span>
            <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text);">AI Espresso</span>
          </div>

          <!-- Headline -->
          <h1 style="font-size: clamp(1.875rem, 6vw, 4.25rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
            <span style="color: var(--color-text);">The morning AI brief</span><br />
            <span style="color: var(--color-text-muted);">for operators.</span>
          </h1>

          <!-- Copy -->
          <p style="max-width: 34rem; font-size: 1.0625rem; line-height: 1.65; color: var(--color-text-muted); margin-bottom: 1.75rem;">
            Models, agents, automation, and GTM workflows. What actually shipped, why it matters, and where it changes the work. Read in under three minutes, written from the builds.
          </p>

          <!-- Subscribe form -->
          <form id="subscribe-form" style="display: flex; flex-direction: column; gap: 0.5rem; max-width: 26rem;" novalidate>
              <input
                type="email"
                id="sub-email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@company.com"
                style="width: 100%; height: 3rem; border-radius: var(--radius-btn); border: 1px solid var(--color-border-2); background: var(--color-surface); padding: 0 1rem; font-size: 0.9375rem; font-weight: 500; color: var(--color-text); outline: none; transition: border-color 0.15s, box-shadow 0.15s;"
              />
              <button
                type="submit"
                id="sub-btn"
                style="width: 100%; height: 3rem; border-radius: var(--radius-btn); background: var(--color-accent-cta); font-size: 0.9375rem; font-weight: 700; color: var(--color-accent-text); border: none; cursor: pointer; transition: opacity 0.15s; letter-spacing: -0.01em;"
              >
                Get tomorrow's issue →
              </button>
            <p id="sub-status" style="min-height: 1.25rem; font-size: 0.75rem; color: var(--color-text-dim);" role="status" aria-live="polite"></p>
          </form>

          <div id="confirmed-state" style="display: none; max-width: 22rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.875rem 1rem; border-radius: var(--radius-card); border: 1px solid var(--color-border); background: var(--color-surface);">
              <div style="width: 2rem; height: 2rem; border-radius: 9999px; background: color-mix(in srgb, var(--color-success) 18%, var(--color-surface)); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4 10l4.5 4.5L16 6" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text);">You're confirmed.</p>
                <p style="font-size: 0.8125rem; color: var(--color-text-muted);">First issue lands tomorrow morning.</p>
              </div>
            </div>
          </div>

          <!-- Proof row: one place, no repetition -->
          <div class="proof-row" style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.875rem; margin-top: 1.5rem; font-size: 0.8125rem; color: var(--color-text-muted);" aria-label="Newsletter details">
            <span style="font-weight: 600; color: var(--color-text);">Daily</span>
            <span style="width: 4px; height: 4px; border-radius: 9999px; background: var(--color-accent-cta);" aria-hidden="true"></span>
            <span>Under 3 minutes</span>
            <span style="width: 4px; height: 4px; border-radius: 9999px; background: var(--color-accent-cta);" aria-hidden="true"></span>
            <span>Free, no sequences</span>
            <span style="width: 4px; height: 4px; border-radius: 9999px; background: var(--color-accent-cta);" aria-hidden="true"></span>
            <span><span style="font-weight: 600; color: var(--color-text);">{totalIssues}</span> issues sent</span>
          </div>

        </div>
      </div>
    </section>

    <!-- ─── WHAT YOU GET: AUTHENTIC NEWSLETTER PREVIEW ─────────────── -->
    <section style="border-bottom: 1px solid var(--color-border); padding: clamp(3rem, 5vw, 5rem) 0;">
      <div style="max-width: 60rem; margin: 0 auto; padding: 0 1.5rem;">

        <div class="archive-grid">

        <div style="min-width: 0;">

        <div style="margin-bottom: 2.5rem; max-width: 40rem;">
          <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-dim); margin-bottom: 0.5rem;">What lands in your inbox</p>
          <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text);">This is the whole thing.</h2>
          <p style="margin-top: 0.75rem; font-size: 0.9375rem; line-height: 1.6; color: var(--color-text-muted);">No teaser, no upsell tucked at the bottom. The real {fmtDate(latest.date)} issue, exactly as it sends.</p>
        </div>

        <!-- Email client mockup wrapping a faithful AI Espresso render -->
        <div style="border-radius: 16px; border: 1px solid var(--color-border); overflow: hidden; box-shadow: 0 24px 80px rgb(0 0 0 / 0.12), 0 4px 16px rgb(0 0 0 / 0.06);">

          <!-- Window chrome -->
          <div style="background: #e8e4dc; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #d8d4cb;">
            <div style="display: flex; gap: 6px; flex-shrink: 0;">
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #ff5f57;"></div>
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #ffbd2e;"></div>
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #28ca41;"></div>
            </div>
            <div style="flex: 1; background: #d8d4cb; border-radius: 5px; height: 22px; display: flex; align-items: center; padding: 0 10px; min-width: 0;">
              <span style="font-size: 11px; color: #555; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">AI Espresso · {fmtDate(latest.date)} · hello@wojciech.io</span>
            </div>
          </div>

          <!-- Email body: warm AI Espresso palette, matched to the sent template -->
          <div style="background: #f4f3ef; padding: 22px 16px 0; position: relative; overflow: hidden;">

            <!-- Pill masthead -->
            <div style="max-width: 660px; margin: 0 auto 12px;">
              <div style="background: #fffefb; border: 1px solid #dcdbd3; border-radius: 999px; display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 9px; min-width: 0;">
                  <img src="/ai-espresso-avatar.png" width="24" height="24" alt="" style="border-radius: 12px; display: block; flex-shrink: 0;" />
                  <span style="font-size: 14px; font-weight: 600; color: #080808; white-space: nowrap;">AI Espresso</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
                  <span style="font-size: 12px; font-weight: 500; color: #74746e;">{fmtDate(latest.date)}</span>
                  <img src="/wojciech-avatar.webp" width="30" height="30" alt="Wojciech" style="border-radius: 50%; display: block; object-fit: cover; object-position: top; flex-shrink: 0;" />
                </div>
              </div>
              <p style="margin: 11px auto 0; max-width: 560px; font-size: 13px; line-height: 1.5; color: #64645e; text-align: center;">A daily operator briefing on AI models, agents, automation, and GTM workflows.</p>
            </div>

            <!-- Operator briefing -->
            <div style="max-width: 660px; margin: 0 auto 10px; background: #fffefb; border-radius: 12px; padding: 24px 28px;">
              <p style="margin: 0 0 11px; color: #080808; font-size: 10px; letter-spacing: 0.11em; text-transform: uppercase; font-weight: 600;"><span style="display: inline-block; width: 26px; height: 3px; background: #eaff00; border-radius: 9px; vertical-align: middle; margin-right: 10px;"></span>Operator briefing</p>
              <h3 style="margin: 0 0 11px; font-size: 25px; line-height: 1.14; font-weight: 600; letter-spacing: -0.01em; color: #080808;">{latest.title}</h3>
              <p style="margin: 0; font-size: 14.5px; line-height: 1.62; color: #343430;">{latest.lead}</p>
            </div>

            <!-- Item cards -->
            {previewItems.map((item) => (
              <div style="max-width: 660px; margin: 0 auto 10px; background: #ffffff; border-radius: 12px; padding: 22px 26px;">
                <p style="margin: 0 0 9px; font-size: 10px; letter-spacing: 0.11em; text-transform: uppercase; color: #74746e; font-weight: 600;"><span style="display: inline-block; width: 20px; height: 3px; background: #eaff00; border-radius: 9px; vertical-align: middle; margin-right: 9px;"></span>{item.label}</p>
                <p style="margin: 0 0 9px; font-size: 19px; line-height: 1.24; font-weight: 600; letter-spacing: -0.01em; color: #080808;">{item.title}</p>
                <p style="margin: 0 0 9px; font-size: 14px; line-height: 1.6; color: #343430;">{item.body}</p>
                <p style="margin: 0; font-size: 14px; line-height: 1.55; color: #343430;"><strong style="font-weight: 600; color: #080808;">Why it matters:</strong> {item.why}</p>
                <p style="margin: 12px 0 0; font-size: 12.5px;"><span style="display: inline-block; width: 16px; height: 2px; background: #eaff00; border-radius: 9px; vertical-align: middle; margin: 0 8px 2px 0;"></span><span style="color: #74746e;">Source: {item.source}</span></p>
              </div>
            ))}

            <!-- Fade out -->
            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 96px; background: linear-gradient(to bottom, transparent, #f4f3ef);"></div>
          </div>

          <!-- Bottom bar -->
          <div style="background: var(--color-surface); border-top: 1px solid var(--color-border); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <p style="margin: 0; font-size: 12px; color: var(--color-text-muted);">Every weekday morning. In English, to the point.</p>
            <a href="#top" style="display: inline-flex; align-items: center; height: 2rem; border-radius: var(--radius-btn); background: var(--color-accent-cta); padding: 0 0.875rem; font-size: 0.75rem; font-weight: 700; color: var(--color-accent-text); text-decoration: none; white-space: nowrap;">Get it free →</a>
          </div>
        </div>

        </div>

        <!-- Topics + close -->
        <aside style="min-width: 0;">
          <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-dim); margin-bottom: 1.25rem;">Inside the notes</p>
          <div style="display: flex; flex-direction: column;">
            {[
              { h: 'AI systems', p: 'Agents, automations, and product workflows. What survives real usage.' },
              { h: 'GTM architecture', p: 'Revenue systems, messaging, growth loops, and operating cadence.' },
              { h: 'Build log', p: 'What shipped across wojciech.io and the tools around it.' },
            ].map(({ h, p }, i) => (
              <div style={`padding: 1rem 0;${i > 0 ? ' border-top: 1px solid var(--color-border);' : ''}`}>
                <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.375rem;">
                  <span style="width: 1.25rem; height: 2px; background: var(--color-accent-cta); border-radius: 9px; flex-shrink: 0; display: inline-block; margin-bottom: 2px;"></span>
                  <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text);">{h}</h3>
                </div>
                <p style="margin: 0; padding-left: 2rem; font-size: 0.875rem; line-height: 1.6; color: var(--color-text-muted);">{p}</p>
              </div>
            ))}
          </div>

          <div class="card-hover" style="margin-top: 1.75rem; padding: 1.25rem; border-radius: var(--radius-card); border: 1px solid var(--color-border); background: var(--color-surface);">
            <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.375rem;">Start tomorrow morning.</p>
            <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 1rem;">One issue a day. Leave whenever you want.</p>
            <a href="#top" style="display: inline-flex; align-items: center; height: 2.5rem; width: 100%; justify-content: center; border-radius: var(--radius-btn); background: var(--color-accent-cta); font-size: 0.875rem; font-weight: 700; color: var(--color-accent-text); text-decoration: none; letter-spacing: -0.01em;">
              Subscribe free →
            </a>
          </div>
        </aside>

        </div>
      </div>
    </section>

    <!-- ─── RECENT ISSUES ──────────────────────────────────────────── -->
    <section style="padding: clamp(3rem, 5vw, 5rem) 0;">
      <div style="max-width: 60rem; margin: 0 auto; padding: 0 1.5rem;">

        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
          <div>
            <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-dim); margin-bottom: 0.5rem;">Recent issues</p>
            <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text);">What's been landing.</h2>
          </div>
          <p style="font-size: 0.8125rem; color: var(--color-text-muted);">
            <span style="color: var(--color-text); font-weight: 600;">{totalIssues}</span>
            <span> sent to date</span>
          </p>
        </div>

        <ul style="list-style: none; margin: 0; padding: 0;">
          {inbox.map((item) => (
            <li class="issue-row">
              <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--color-accent-cta); align-self: center; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="min-width: 0;">
                <span style="display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-dim); border: 1px solid var(--color-border-2); border-radius: 999px; padding: 2px 7px; margin-right: 0.5rem; vertical-align: middle;">{item.tag}</span>
                <span style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); vertical-align: middle;">{item.title}</span>
                <span style="display: block; font-size: 0.8125rem; line-height: 1.5; color: var(--color-text-muted); margin-top: 0.25rem;">{item.lead}</span>
              </span>
              <time datetime={item.date} style="font-size: 0.75rem; font-weight: 500; color: var(--color-text-dim); white-space: nowrap;">{shortDate(item.date)}</time>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>
</Layout>

<script>
  if (new URLSearchParams(location.search).get('confirmed') === '1') {
    (document.getElementById('subscribe-form') as HTMLElement).style.display = 'none';
    (document.getElementById('confirmed-state') as HTMLElement).style.display = 'block';
    history.replaceState({}, '', '/');
  }

  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const status = document.getElementById('sub-status') as HTMLElement;
  const btn = document.getElementById('sub-btn') as HTMLButtonElement;
  const emailInput = document.getElementById('sub-email') as HTMLInputElement;

  emailInput?.addEventListener('focus', () => {
    emailInput.style.borderColor = 'var(--color-accent-cta)';
    emailInput.style.boxShadow = '0 0 0 2px rgb(235 255 0 / 0.15)';
  });
  emailInput?.addEventListener('blur', () => {
    emailInput.style.borderColor = 'var(--color-border-2)';
    emailInput.style.boxShadow = 'none';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim().toLowerCase();
    if (!email || !emailInput.validity.valid) {
      status.textContent = 'Please enter a valid email address.';
      status.style.color = '#f87171';
      emailInput.focus();
      return;
    }
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.textContent = 'Sending...';
    status.textContent = '';
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.style.display = 'none';
        const confirmed = document.getElementById('confirmed-state') as HTMLElement;
        confirmed.style.display = 'block';
      } else {
        throw new Error((data as any)?.error || 'Failed');
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      btn.textContent = "Get tomorrow's issue →";
      status.textContent = err?.message === 'Failed' ? 'Something went wrong. Try again.' : (err?.message || 'Something went wrong.');
      status.style.color = '#f87171';
    }
  });
</script>

<style>
  /* Hero min-height: tall on desktop where the photo is shown, natural on mobile. */
  .subscribe-hero { min-height: auto; }
  @media (min-width: 1024px) {
    .subscribe-hero { min-height: 620px; }
    #form-col { max-width: 54%; }
  }

  /* Grid dissolves toward the edges so it reads as depth, not a flat sheet. */
  .subscribe-hero-grid {
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
  }

  /* Lime aura: subtle colour wash + depth behind the headline. */
  .subscribe-hero-aura {
    background: radial-gradient(circle, var(--color-accent-cta) 0%, transparent 68%);
    opacity: 0.08;
    filter: blur(60px);
  }
  :global(:root[data-theme='dark']) .subscribe-hero-aura {
    opacity: 0.16;
  }

  /* Photo was shot dark for a dark UI; lift it against the cream (light)
     surface, same grade as the homepage hero. Dark roast keeps the source
     grade — it already sits fine on that background. */
  .subscribe-hero-photo img {
    filter: brightness(1.16) contrast(0.96) saturate(1.05);
