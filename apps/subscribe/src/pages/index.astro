---
import Layout from '../layouts/Layout.astro';
import { editions, totalIssues } from '../data/editions';

const latest = editions[0];
const inbox = editions.slice(0, 8);

const PL_MONTHS = [
  'stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca',
  'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia',
];
function plDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${PL_MONTHS[m - 1]} ${y}`;
}
function shortDate(iso: string): string {
  const [, m, d] = iso.split('-').map(Number);
  return `${d} ${PL_MONTHS[m - 1].slice(0, 3)}`;
}

const previewItems = [
  {
    tag: 'GTM',
    title: 'Copilot idzie w usage based billing, policz to na raportach.',
    body: 'GitHub udostępnia raporty, żeby przygotować się do AI Credits. Warto teraz wpiąć to do budżetu i zasad użycia.',
    link: 'github.blog',
  },
  {
    tag: 'SDK',
    title: 'Vercel publikuje SDK, które działa też jako MCP server.',
    body: 'Mniej własnych wrapperów na API. Szybciej dodasz: deploy, env vars, projekty, logi.',
    link: 'github.com/vercel/sdk',
  },
  {
    tag: 'SEC',
    title: 'OpenAI Privacy Filter: open weight model do redakcji PII.',
    body: 'Wykrywa dane wrażliwe zanim trafią do modelu. Przydaje się gdy agent czyta tickety, maile, logi.',
    link: 'openai.com',
  },
];

// Realne wydania AI Espresso (tytuł + lead wprost z wysłanych edycji).
// Lead = pierwszy substancjonalny akapit wydania. Najnowsze u góry.
// Hero-preview inbox uses human-formatted dates ("27 maja"). The dedicated
// inbox section below uses ISO-dated `inbox` from ../data/editions.ts.
const heroInboxEditions = [
  { date: '27 maja', title: 'Trwały runtime dla agentów.',                       lead: 'W 2026 wygrywa nie tylko model, ale infrastruktura wykonania. Dziś widać trzy klocki: trwały stan, powtarzalne procedury i twarde dopuszczanie integracji.' },
  { date: '26 maja', title: 'MCP bez sesji.',                                    lead: 'Agent stack idzie w stronę zwykłej infrastruktury: skalowanie jak HTTP, audyt jak w SaaS i rozliczanie za wynik, a nie za obietnicę.' },
  { date: '25 maja', title: 'Governance dla agentów.',                           lead: 'Agenci w firmie zaczynają być traktowani jak normalna aplikacja w stacku. Liczą się uprawnienia, audyt, zgodność i szybkie poprawki po review.' },
  { date: '24 maja', title: 'Agenci za firewallem.',                             lead: 'Dwa sygnały na dziś: MCP wchodzi do kolejnych produktów, i rośnie presja na bezpieczne uwierzytelnianie zdalnych serwerów.' },
  { date: '22 maja', title: 'Agent ops w terminalu.',                            lead: 'Widoczny trend: modele stają się wymienne, a przewaga idzie w stronę obserwowalności, kontroli kosztów i stabilnych interfejsów narzędzi.' },
  { date: '21 maja', title: 'MCP zamiast bety.',                                 lead: 'Tydzień, w którym widać szybki pivot: mniej jednorazowych „AI akcji", więcej standardu MCP, kontroli uprawnień i uruchamiania agentów na zdalnej infrastrukturze.' },
  { date: '20 maja', title: 'Zaufanie i koszty w stacku.',                       lead: 'Widać dwa trendy: provenance dla mediów i coraz twardsze podejście do jakości integracji, modeli i kosztów w produkcji.' },
  { date: '19 maja', title: 'Kontekst i koszty w ryzach.',                       lead: 'Nowości idą w dwóch kierunkach: mniej przełączania kontekstu i mniej niespodzianek w kosztach oraz dostępach.' },
  { date: '18 maja', title: 'Agenci przechodzą na platformę.',                   lead: 'Widać kolejną falę produkcyjnych klocków: desktop do pracy w sesjach, API do odpalania agentów oraz governance i routing po stronie infra.' },
  { date: '15 maja', title: 'Koszt agenta staje się policzalny.',                lead: 'Widać mocny trend: billing, metryki i polityki narzędzi wchodzą do agent stacku. To dobra wiadomość, bo dopiero wtedy automaty da się skalować w firmie.' },
  { date: '14 maja', title: 'Orkiestracja wchodzi do enterprise.',               lead: 'Dziś najmocniejszy sygnał to nie kolejny model, tylko to, kto daje wykonanie, kontrolę i integracje pod duże systemy.' },
  { date: '13 maja', title: 'Agenci w Teams. Review na usage.',                  lead: 'Dziś liczy się to, czy agent wchodzi w narzędzia zespołu i czy da się policzyć koszt per wykonana akcja.' },
  { date: '12 maja', title: 'Głos, przeglądarka, agenci.',                       lead: 'Dzisiejszy update od OpenAI dobrze pokazuje kierunek: modele są ważne, ale przewaga zaczyna siedzieć w runtime, sandboxach, przeglądarce, danych i gotowych workflow.' },
  { date: '11 maja', title: 'MCP bez wpadek.',                                   lead: 'Dziś wchodzi praktyczny temat: jak podkręcić agent stack i jednocześnie nie otworzyć sobie drzwi do wycieków i RCE. Są już twarde sygnały: GA dla secret scanning przez MCP, plus konkretne checklisty.' },
  { date: '10 maja', title: 'MCP wchodzi na produkcję.',                         lead: 'Dwa sygnały na dziś: limity dla narzędzi kodujących rosną, a integracje MCP przesuwają się w stronę governance, audytu i dystrybucji skills.' },
  { date: '8 maja',  title: "Głos wchodzi do produktu. Agenty do pipeline'u.",   lead: 'W tym wydaniu: nowe realtime modele głosowe w API, świeższa „Instant" jako domyślny runtime w czacie, twardsze testy przed wdrożeniem (CAISI/NIST) oraz dwa ruchy w stronę „AI jako SDLC/workflow engine".' },
];
---

<Layout>
  <main id="top">

    <!-- ─── HERO ───────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden subscribe-hero" style="border-bottom: 1px solid var(--color-border);">

      <!-- Subtle grid -->
      <div class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(to right, var(--color-grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--color-grid-line) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <!-- Depth blob -->
      <div class="pointer-events-none absolute" style="left: -120px; top: -200px; height: 520px; width: 620px; border-radius: 9999px; background: var(--color-surface); filter: blur(140px); opacity: 0.65;" aria-hidden="true"></div>

      <!-- Photo: desktop right half, absolute -->
      <div class="hidden lg:block absolute right-0 top-0 bottom-0" style="width: 46%; overflow: hidden;" aria-hidden="true">
        <img
          src="/wojciech.jpg"
          alt=""
          width="860"
          height="1100"
          loading="eager"
          decoding="async"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center;"
        />
        <!-- Left fade: blends photo into warm bg -->
        <div class="absolute inset-y-0 left-0 pointer-events-none" style="width: 32%; background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);"></div>
        <!-- Bottom fade -->
        <div class="absolute inset-x-0 bottom-0 pointer-events-none" style="height: 22%; background: linear-gradient(to top, var(--color-bg) 0%, transparent 100%);"></div>

        <!-- Proof rail -->
        <div class="absolute" style="bottom: 2.5rem; left: 2rem; right: 1rem; z-index: 10;">
          <div style="width: min(380px, 100%); overflow: hidden; border-radius: 1rem; border: 1px solid var(--color-border); background: var(--color-glass); box-shadow: var(--shadow-card); backdrop-filter: blur(12px);">
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); divide-x: 1px solid var(--color-border);">
              {[
                { label: 'Cadence', value: 'Daily', note: 'weekdays' },
                { label: 'Read time', value: '3 min', note: 'or less' },
                { label: 'Cost', value: 'Free', note: 'always' },
              ].map(({ label, value, note }) => (
                <div style="padding: 0.875rem 1rem; border-right: 1px solid var(--color-border);">
                  <p style="font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-dim);">{label}</p>
                  <p style="margin-top: 0.25rem; font-size: 0.875rem; font-weight: 600; color: var(--color-text);">{value}</p>
                  <p style="font-size: 11px; color: var(--color-text-muted);">{note}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Left column: copy + form (mobile padding floor lowered so headline and form sit above the fold) -->
      <div class="relative mx-auto px-6" style="max-width: 72rem;">
        <div class="animate-fade-up flex flex-col justify-center" style="padding-top: clamp(2rem, 7vw, 7rem); padding-bottom: clamp(2.5rem, 9vw, 9rem); max-width: 100%;" id="form-col">

          <!-- Mobile: avatar + name -->
          <div class="flex items-center gap-3 mb-7" style="display: flex;">
            <img
              src="/wojciech-avatar.webp"
              alt="Wojciech Łuszczyński"
              width="44"
              height="44"
              loading="eager"
              style="width: 44px; height: 44px; border-radius: 9999px; object-fit: cover; object-position: top; border: 2px solid var(--color-border); flex-shrink: 0;"
            />
            <div>
              <p style="font-size: 13px; font-weight: 600; color: var(--color-text); line-height: 1.2;">Wojciech Łuszczyński</p>
              <p style="font-size: 11px; color: var(--color-text-dim);"
                data-en="Growth / GTM operator &amp; builder"
                data-pl="Operator i builder growth / GTM"
                data-it="Operatore e builder growth / GTM"
              >Growth / GTM operator &amp; builder</p>
            </div>
          </div>

          <!-- Badge -->
          <div style="display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; border-radius: 9999px; border: 1px solid var(--color-border); background: var(--color-glass); padding: 0.5rem 0.875rem; margin-bottom: 1.75rem; box-shadow: var(--shadow-card); backdrop-filter: blur(8px);">
            <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--color-accent-cta); box-shadow: 0 0 14px rgb(235 255 0 / 0.6); flex-shrink: 0;"></span>
            <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text);" data-en="AI Espresso" data-pl="AI Espresso" data-it="AI Espresso">AI Espresso</span>
          </div>

          <!-- Headline (mobile floor lowered so 375px viewports don't get a 42px headline) -->
          <h1 style="font-size: clamp(1.875rem, 6.5vw, 4.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
            <span style="color: var(--color-text);" data-en="Notes for people" data-pl="Notatki dla ludzi," data-it="Note per chi">Notes for people</span><br />
            <span style="color: var(--color-text-muted);" data-en="who ship." data-pl="którzy shipują." data-it="che costruiscono.">who ship.</span>
          </h1>

          <!-- Copy -->
          <p style="max-width: 34rem; font-size: 1.0625rem; line-height: 1.65; color: var(--color-text-muted); margin-bottom: 2rem;">
            <span data-en="Short operator notes on AI systems, GTM architecture, automation, and software workflows. Practical, written from the builds, sent from" data-pl="Krótkie notatki operatora o systemach AI, architekturze GTM, automatyzacji i workflow'ach. Praktyczne, pisane z buildów, wysyłane z" data-it="Brevi note operative su sistemi AI, architettura GTM, automazione e workflow del software. Pratiche, scritte dai build, inviate da">Short operator notes on AI systems, GTM architecture, automation, and software workflows. Practical, written from the builds, sent from</span> <a href="mailto:hello@wojciech.io" style="color: var(--color-text); font-weight: 500;">hello@wojciech.io</a>.
          </p>

          <!-- Subscribe form -->
          <form id="subscribe-form" style="display: flex; flex-direction: column; gap: 0.5rem; max-width: 26rem;" novalidate>
              <input
                type="email"
                id="sub-email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@company.com"
                style="width: 100%; height: 3rem; border-radius: var(--radius-btn); border: 1px solid var(--color-border-2); background: var(--color-surface); padding: 0 1rem; font-size: 0.9375rem; font-weight: 500; color: var(--color-text); outline: none; transition: border-color 0.15s, box-shadow 0.15s;"
              />
              <button
                type="submit"
                id="sub-btn"
                style="width: 100%; height: 3rem; border-radius: var(--radius-btn); background: var(--color-accent-cta); font-size: 0.9375rem; font-weight: 700; color: var(--color-accent-text); border: none; cursor: pointer; transition: opacity 0.15s; letter-spacing: -0.01em;"
                data-en="Subscribe free →"
                data-pl="Zapisz się za darmo →"
                data-it="Iscriviti gratis →"
              >
                Subscribe free →
              </button>
            <p id="sub-status" style="min-height: 1.25rem; font-size: 0.75rem; color: var(--color-text-dim);" role="status" aria-live="polite"></p>
          </form>

          <div id="confirmed-state" style="display: none; max-width: 22rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.875rem 1rem; border-radius: var(--radius-card); border: 1px solid var(--color-border); background: var(--color-surface);">
              <div style="width: 2rem; height: 2rem; border-radius: 9999px; background: #dcfce7; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4 10l4.5 4.5L16 6" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text);" data-en="You're confirmed." data-pl="Potwierdzono." data-it="Confermato.">You're confirmed.</p>
                <p style="font-size: 0.8125rem; color: var(--color-text-muted);" data-en="First issue on the way." data-pl="Pierwsze wydanie już w drodze." data-it="Il primo numero è in arrivo.">First issue on the way.</p>
              </div>
            </div>
          </div>

          <!-- Pills -->
          <div class="flex flex-wrap gap-2 mt-5" aria-label="Newsletter details">
            <span style="border-radius: 9999px; border: 1px solid var(--color-border-2); background: rgb(var(--color-surface-rgb) / 0.7); padding: 0.3125rem 0.75rem; font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);" data-en="Free" data-pl="Bezpłatny" data-it="Gratuito">Free</span>
            <span style="border-radius: 9999px; border: 1px solid var(--color-border-2); background: rgb(var(--color-surface-rgb) / 0.7); padding: 0.3125rem 0.75rem; font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);" data-en="Under 3 minutes" data-pl="Poniżej 3 minut" data-it="Meno di 3 minuti">Under 3 minutes</span>
            <span style="border-radius: 9999px; border: 1px solid var(--color-border-2); background: rgb(var(--color-surface-rgb) / 0.7); padding: 0.3125rem 0.75rem; font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);" data-en="No surprise sequences" data-pl="Bez niespodziewanych sekwencji" data-it="Nessuna sequenza a sorpresa">No surprise sequences</span>
            <span style="border-radius: 9999px; border: 1px solid var(--color-border-2); background: rgb(var(--color-surface-rgb) / 0.7); padding: 0.3125rem 0.75rem; font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);" data-en="Unsubscribe anytime" data-pl="Wypisz się kiedy chcesz" data-it="Cancellati in qualsiasi momento">Unsubscribe anytime</span>
          </div>

        </div>
      </div>
    </section>

    <!-- ─── LATEST ISSUE + INSIDE THE NOTES ───────────────────────── -->
    <section style="border-bottom: 1px solid var(--color-border); padding: clamp(3rem, 5vw, 5rem) 0;">
      <div style="max-width: 72rem; margin: 0 auto; padding: 0 1.5rem;">

        <div class="preview-notes-grid">

        <!-- Left: mockup + header -->
        <div class="preview-col">
        <div style="margin-bottom: 2.5rem;">
          <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-dim); margin-bottom: 0.5rem;" data-en="Latest issue" data-pl="Ostatnie wydanie" data-it="Ultimo numero">Latest issue</p>
          <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text);" data-en="What the note looks like." data-pl="Jak wygląda notatka." data-it="Come appare la nota.">What the note looks like.</h2>
        </div>

        <!-- Email client mockup -->
        <div style="border-radius: 16px; border: 1px solid var(--color-border); overflow: hidden; box-shadow: 0 24px 80px rgb(59 51 39 / 0.10), 0 4px 16px rgb(59 51 39 / 0.06); max-width: 760px;">

          <!-- Window chrome -->
          <div style="background: #e8e4dc; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #d8d4cb;">
            <div style="display: flex; gap: 6px; flex-shrink: 0;">
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #ff5f57;"></div>
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #ffbd2e;"></div>
              <div style="width: 11px; height: 11px; border-radius: 50%; background: #28ca41;"></div>
            </div>
            <div style="flex: 1; background: #d8d4cb; border-radius: 5px; height: 22px; display: flex; align-items: center; padding: 0 10px; min-width: 0;">
              <span style="font-size: 11px; color: #555; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">AI Espresso · {plDate(latest.date)} · hello@wojciech.io</span>
            </div>
          </div>

          <!-- Email body -->
          <div style="background: #f3f2ef; padding: 24px 16px; position: relative; overflow: hidden;">

            <!-- Email header pill -->
            <div style="max-width: 680px; margin: 0 auto 14px;">
              <div style="background: #fff; border: 1px solid #e2e2df; border-radius: 999px; display: flex; align-items: center; justify-content: space-between; padding: 9px 16px; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 9px; min-width: 0;">
                  <img src="/ai-espresso-avatar.png" width="24" height="24" alt="" style="border-radius: 12px; display: block; flex-shrink: 0;" />
                  <span style="font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #111; white-space: nowrap;">AI Espresso</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
                  <span style="font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8a8a86;">{plDate(latest.date)}</span>
                  <img src="/wojciech-avatar.webp" width="30" height="30" alt="Wojciech" style="border-radius: 50%; display: block; object-fit: cover; object-position: top; flex-shrink: 0;" />
                </div>
              </div>
            </div>

            <!-- Headline card -->
            <div style="max-width: 680px; margin: 0 auto 10px; background: #fff; border-radius: 20px; padding: 24px 28px; text-align: center;">
              <span style="display: inline-block; background: #ebff00; color: #080808; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; margin-bottom: 12px;">Poranny skrót</span>
              <h3 style="margin: 0 0 10px; font-size: 22px; line-height: 1.15; font-weight: 700; color: #080808; letter-spacing: -0.01em;">{latest.title}</h3>
              <p style="margin: 0 auto; max-width: 480px; font-size: 14px; line-height: 1.5; color: #3d3d3d;">{latest.lead}</p>
            </div>

            <!-- Article cards -->
            {previewItems.map((item) => (
              <div style="max-width: 680px; margin: 0 auto 8px; background: #fff; border-radius: 20px; padding: 18px 24px;">
                <div style="margin-bottom: 7px;">
                  <span style="display: inline-block; background: #ebff00; color: #080808; font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px;">{item.tag}</span>
                </div>
                <p style="margin: 0 0 6px; font-size: 15px; line-height: 1.25; font-weight: 700; color: #080808;">{item.title}</p>
                <p style="margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: #555;">{item.body}</p>
                <span style="font-size: 11px; color: #aaa; font-weight: 500;">↗ {item.link}</span>
              </div>
            ))}

            <!-- Fade out -->
            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background: linear-gradient(to bottom, transparent, #f3f2ef);"></div>
          </div>

          <!-- Bottom bar -->
          <div style="background: var(--color-surface); border-top: 1px solid var(--color-border); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <p style="margin: 0; font-size: 12px; color: var(--color-text-muted);"
              data-en="New issue every morning. In English, straight to the point."
              data-pl="Nowe wydanie co rano. Po polsku, do rzeczy."
              data-it="Una nuova edizione ogni mattina. In italiano, dritti al punto."
            >Nowe wydanie co rano. Po polsku, do rzeczy.</p>
            <a href="#top" style="display: inline-flex; align-items: center; height: 2rem; border-radius: var(--radius-btn); background: var(--color-accent-cta); padding: 0 0.875rem; font-size: 0.75rem; font-weight: 600; color: var(--color-accent-text); text-decoration: none; white-space: nowrap;"
              data-en="Subscribe →" data-pl="Zapisz się →" data-it="Iscriviti →"
            >Zapisz się →</a>
          </div>
        </div>

        <!-- Inbox: realne ostatnie wydania -->
        <div class="editions-inbox" style="margin-top: 1.25rem; border-radius: 14px; border: 1px solid var(--color-border); background: var(--color-surface); overflow: hidden;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-border);">
            <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-dim);"
              data-en="Inbox" data-pl="Skrzynka" data-it="Inbox">Skrzynka</span>
            <span style="font-size: 0.6875rem; color: var(--color-text-dim);">{heroInboxEditions.length} {''}
              <span data-en="recent issues" data-pl="ostatnich wydań" data-it="numeri recenti">ostatnich wydań</span>
            </span>
          </div>
          <div style="max-height: 420px; overflow-y: auto;">
            {heroInboxEditions.map((e, i) => (
              <details open={i === 0} class="edition-item" style={`border-top: ${i === 0 ? 'none' : '1px solid var(--color-border)'};`}>
                <summary style="display: flex; align-items: baseline; gap: 0.75rem; padding: 0.625rem 1rem; cursor: pointer; list-style: none;">
