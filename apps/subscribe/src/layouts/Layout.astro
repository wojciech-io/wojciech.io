---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Espresso — subscribe.wojciech.io',
  description = 'Short operator notes on AI systems, GTM architecture, and what ships. Free. Under 3 minutes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://subscribe.wojciech.io" />
    <meta name="robots" content="index, follow" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://subscribe.wojciech.io" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://subscribe.wojciech.io/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://subscribe.wojciech.io/og-default.png" />

    <!-- JSON-LD: WebSite + Newsletter + author Person for LLM and rich-result crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AI Espresso',
      alternateName: 'AI Espresso newsletter',
      url: 'https://subscribe.wojciech.io/',
      description: 'Daily operator notes on AI systems, GTM architecture, and what ships. Free. Under 3 minutes per issue.',
      inLanguage: 'en',
      publisher: {
        '@type': 'Person',
        name: 'Wojciech Łuszczyński',
        url: 'https://wojciech.io/',
        jobTitle: 'GTM Architect & Growth Operator',
        sameAs: [
          'https://www.linkedin.com/in/wojciech-luszczynski/',
          'https://x.com/w_luszczynski',
          'https://github.com/wojciechluszczynski',
          'https://substack.com/@luscinetti',
        ],
      },
      author: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: 'https://wojciech.io/' },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NewsletterPublication',
      name: 'AI Espresso',
      url: 'https://subscribe.wojciech.io/',
      description: 'Short operator notes on AI systems, GTM architecture, and what ships. Under 3 minutes per issue. Free.',
      inLanguage: 'en',
      publisher: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: 'https://wojciech.io/' },
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Theme init (before paint) -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        document.documentElement.dataset.theme = t === 'dark' ? 'dark' : 'light';
        document.documentElement.style.colorScheme = t === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <!-- Language init -->
    <script is:inline>
      window.setLang = function(l) {
        var lang = (l || 'en').toLowerCase();
        localStorage.setItem('wio_lang', lang);
        document.querySelectorAll('[data-pl],[data-en],[data-it]').forEach(function(el) {
          var v = el.getAttribute('data-' + lang);
          if (v === null) v = el.getAttribute('data-en');
          if (v !== null) el.textContent = v;
        });
        document.documentElement.lang = lang === 'pl' ? 'pl' : lang === 'it' ? 'it' : 'en';
      };
      window.switchLang = function(lang) {
        localStorage.setItem('wio_lang', lang);
        window.setLang(lang);
        // update trigger display
        var flagMap = {
          en: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>',
          pl: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>',
          it: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>'
        };
        var codeMap = { en: 'EN', pl: 'PL', it: 'IT' };
        var flagEl = document.getElementById('lang-flag-current');
        var codeEl = document.getElementById('lang-code-current');
        if (flagEl) flagEl.innerHTML = flagMap[lang] || flagMap.en;
        if (codeEl) codeEl.textContent = codeMap[lang] || 'EN';
        document.querySelectorAll('[data-lang-opt]').forEach(function(el) {
          el.classList.toggle('text-[var(--color-text)]', el.dataset.langOpt === lang);
          el.classList.toggle('bg-[var(--color-surface-2)]', el.dataset.langOpt === lang);
        });
        document.getElementById('lang-menu')?.classList.add('hidden');
        document.getElementById('lang-trigger')?.setAttribute('aria-expanded', 'false');
        document.getElementById('lang-chevron') && (document.getElementById('lang-chevron').style.transform = '');
      };
      (function() {
        var saved = localStorage.getItem('wio_lang');
        var nav = (navigator.language || '').toLowerCase();
        var detected = saved || (nav.startsWith('pl') ? 'pl' : nav.startsWith('it') ? 'it' : 'en');
        document.addEventListener('DOMContentLoaded', function() { window.setLang(detected); });
      })();
    </script>

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4ED804XJLP"></script>
    <script is:inline>
      window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
      gtag('js',new Date());gtag('config','G-4ED804XJLP',{anonymize_ip:true});
    </script>

    <!-- Mixpanel EU — consent-gated -->
    <script is:inline>
      (function(c,a){window.mixpanel=a;var b,d,h,e;b=c.createElement("script");b.type="text/javascript";b.async=!0;b.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";d=c.getElementsByTagName("script")[0];d.parentNode.insertBefore(b,d);a._i=[];a.init=function(b,c,f){function d(a,b){var c=b.split(".");2==c.length&&(a=a[c[0]],b=c[1]);a[b]=function(){a.push([b].concat(Array.prototype.slice.call(arguments,0)))}}var g=a;"undefined"!==typeof f?g=a[f]=[]:f="mixpanel";g.people=g.people||[];h="disable time_event track track_pageview track_links track_forms register register_once unregister identify name_tag set_config reset people.set people.increment".split(" ");for(e=0;e<h.length;e++)d(g,h[e]);a._i.push([b,c,f])};a.__SV=1.1})(document,window.mixpanel||[]);
      mixpanel.init("efa47f584d961f6fdbe3857da52daf9a",{api_host:"https://api-eu.mixpanel.com",persistence:"localStorage",track_pageview:false,ip:false});
      if(localStorage.getItem('mp-consent')==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"subscribe.wojciech.io"});}
      else{mixpanel.opt_out_tracking();}
    </script>
  </head>
  <body class="min-h-dvh flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">

    <!-- Language selector -->
    <div class="fixed top-3 right-4 z-50">
      <div class="relative" id="lang-dd">
        <button id="lang-trigger" aria-haspopup="listbox" aria-expanded="false"
          class="inline-flex items-center gap-1.5 h-8 px-2 rounded-[7px] text-[11px] font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          <span id="lang-flag-current" class="inline-flex items-center">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
          </span>
          <span id="lang-code-current">EN</span>
          <svg id="lang-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="opacity-40 transition-transform duration-150"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div id="lang-menu" role="listbox"
          class="hidden absolute right-0 top-[calc(100%+6px)] z-50 min-w-[9rem] overflow-hidden rounded-[8px] bg-[var(--color-surface)] shadow-[0_8px_32px_rgb(0_0_0/0.18)] py-1 border border-[var(--color-border)]">
          <button onclick="switchLang('en')" data-lang-opt="en" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
            English
          </button>
          <button onclick="switchLang('pl')" data-lang-opt="pl" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>
            Polski
          </button>
          <button onclick="switchLang('it')" data-lang-opt="it" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>
            Italiano
          </button>
        </div>
      </div>
    </div>
    <script>
      document.getElementById('lang-trigger')?.addEventListener('click', function(e) {
        e.stopPropagation();
        var menu = document.getElementById('lang-menu');
        var chev = document.getElementById('lang-chevron');
        var trigger = document.getElementById('lang-trigger');
        var open = !menu?.classList.contains('hidden');
        if (open) {
          menu?.classList.add('hidden');
          trigger?.setAttribute('aria-expanded', 'false');
          if (chev) chev.style.transform = '';
        } else {
          menu?.classList.remove('hidden');
          trigger?.setAttribute('aria-expanded', 'true');
          if (chev) chev.style.transform = 'rotate(180deg)';
        }
      });
      document.addEventListener('click', function() {
        document.getElementById('lang-menu')?.classList.add('hidden');
        document.getElementById('lang-trigger')?.setAttribute('aria-expanded', 'false');
        var chev = document.getElementById('lang-chevron');
        if (chev) chev.style.transform = '';
      });
      // Init flag display
      (function() {
        var lang = localStorage.getItem('wio_lang') || 'en';
        var flagMap = {
          en: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>',
          pl: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>',
          it: '<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>'
        };
        var codeMap = { en: 'EN', pl: 'PL', it: 'IT' };
        var flagEl = document.getElementById('lang-flag-current');
        var codeEl = document.getElementById('lang-code-current');
        if (flagEl) flagEl.innerHTML = flagMap[lang] || flagMap.en;
        if (codeEl) codeEl.textContent = codeMap[lang] || 'EN';
      })();
    </script>

    <slot />

    <!-- Footer -->
    <footer style="border-top:1px solid var(--color-border);background:var(--color-bg);">
      <div style="max-width:72rem;margin:0 auto;padding:0 1.5rem;">
        <div style="display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:2rem;padding:2rem 0 1.5rem;">
          <!-- Brand -->
          <div>
            <a href="https://wojciech.io" target="_blank" rel="noopener" style="display:inline-flex;align-items:baseline;text-decoration:none;margin-bottom:0.75rem;font-size:14px;font-weight:700;color:var(--color-text);">wojciech<span style="background:#ebff00;color:#080808;border-radius:5px;padding:1px 5px;font-size:10px;font-weight:700;margin-left:2px;">.io</span></a>
            <p style="font-size:12px;color:var(--color-text-muted);line-height:1.5;max-width:220px;" data-en="GTM architect and AI-native builder. Revenue systems for B2B SaaS and technology companies." data-pl="GTM architect i AI-native builder. Systemy revenue dla B2B SaaS i firm technologicznych." data-it="GTM architect e AI-native builder. Sistemi revenue per B2B SaaS e aziende tecnologiche.">GTM architect and AI-native builder. Revenue systems for B2B SaaS and technology companies.</p>
          </div>
          <!-- Network -->
          <div>
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-text-dim);margin-bottom:0.75rem;" data-en="Network" data-pl="Sieć" data-it="Rete">Network</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
              <li><a href="https://wojciech.io" target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">wojciech.io</a></li>
              <li><a href="https://app.wojciech.io" target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">app.wojciech.io</a></li>
              <li><a href="https://academy.wojciech.io" target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">academy.wojciech.io</a></li>
              <li><a href="https://notch.wojciech.io" target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">notch.wojciech.io</a></li>
            </ul>
          </div>
          <!-- Connect -->
          <div>
            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-text-dim);margin-bottom:0.75rem;" data-en="Connect" data-pl="Kontakt" data-it="Contatti">Connect</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
              <li><a href="https://www.linkedin.com/in/wojciech-luszczynski/" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">LinkedIn</a></li>
              <li><a href="https://github.com/wojciechluszczynski" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">GitHub</a></li>
              <li><a href="https://twitter.com/w_luszczynski" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">X / Twitter</a></li>
              <li><a href="https://substack.com/@luscinetti" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--color-text-muted);text-decoration:none;">Substack</a></li>
            </ul>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;border-top:1px solid var(--color-border);padding:1rem 0;font-size:11px;color:var(--color-text-dim);">
          <p>© 2026 Wojciech Łuszczyński · <a href="https://wojciech.io/now" target="_blank" rel="noopener" style="color:var(--color-text-muted);text-decoration:none;" data-en="What I'm doing now" data-pl="Co teraz robię" data-it="Cosa faccio ora">What I'm doing now</a></p>
          <p>GTM architect · AI-native builder</p>
        </div>
      </div>
    </footer>
    <style>
      @media (max-width: 700px) {
        footer > div > div:first-of-type {
          grid-template-columns: 1fr 1fr !important;
        }
        footer > div > div:first-of-type > div:first-child {
          grid-column: 1 / -1;
        }
      }
      @media (max-width: 440px) {
        footer > div > div:first-of-type {
          grid-template-columns: 1fr !important;
        }
        footer > div > div:last-of-type {
          flex-direction: column !important;
          align-items: center !important;
          text-align: center !important;
        }
      }
    </style>

    <!-- Analytics consent — minimal bottom bar -->
    <div id="sub-consent" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;border-top:1px solid var(--color-border);background:var(--color-surface);padding:10px 20px;gap:12px;align-items:center;font-size:12px;color:var(--color-text-muted)">
      <span style="flex:1">I use Mixpanel (EU) &amp; Google Analytics to understand sign-up flow — anonymously, no ads. <a href="https://wojciech.io/privacy/" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);text-decoration:underline">Details</a></span>
      <button onclick="subConsent('yes')" style="padding:5px 14px;background:var(--color-accent);color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer">Accept</button>
      <button onclick="subConsent('no')" style="padding:5px 10px;background:none;border:none;font-size:11px;color:var(--color-text-muted);cursor:pointer">No thanks</button>
    </div>
    <script is:inline>
      function subConsent(v){
        localStorage.setItem('mp-consent',v);
        document.getElementById('sub-consent').style.display='none';
        if(v==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"subscribe.wojciech.io"});}
      }
      (function(){
        var c=localStorage.getItem('mp-consent');
        var el=document.getElementById('sub-consent');
        if(!c){el.style.display='flex';}
      })();
    </script>
  </body>
</html>
