---
import ThemeToggle from '@wojciech/ui/components/ThemeToggle.astro';
import NetworkTopBar from '@wojciech/ui/components/NetworkTopBar.astro';
import NetworkFooter from '@wojciech/ui/components/NetworkFooter.astro';
import '../styles/global.css';
import OutboundTelemetry from '@wojciech/ui/components/OutboundTelemetry.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Espresso · subscribe.wojciech.io',
  description = 'Short operator notes on AI systems, GTM architecture, and what ships. Free. Under 3 minutes.',
} = Astro.props;

const SITE = 'https://subscribe.wojciech.io';
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE;
const image = `${SITE}/og-default.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · wojciech.io</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Wojciech Łuszczyński" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08080a" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Espresso" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Espresso newsletter preview" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@w_luszczynski" />
    <meta name="twitter:creator" content="@w_luszczynski" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="AI Espresso newsletter preview" />

    <!-- JSON-LD: WebSite + Newsletter + author Person for LLM and rich-result crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AI Espresso',
      alternateName: 'AI Espresso newsletter',
      url: 'https://subscribe.wojciech.io/',
      description: 'Daily operator notes on AI systems, GTM architecture, and what ships. Free. Under 3 minutes per issue.',
      inLanguage: 'en',
      publisher: {
        '@type': 'Person',
        name: 'Wojciech Łuszczyński',
        url: 'https://wojciech.io/',
        jobTitle: 'GTM Architect & Growth Operator',
        sameAs: [
          'https://www.linkedin.com/in/wojciech-luszczynski/',
          'https://x.com/w_luszczynski',
          'https://github.com/wojciechluszczynski',
          'https://substack.com/@wojciechluszczynski',
        ],
      },
      author: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: 'https://wojciech.io/' },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NewsletterPublication',
      name: 'AI Espresso',
      url: 'https://subscribe.wojciech.io/',
      description: 'Short operator notes on AI systems, GTM architecture, and what ships. Under 3 minutes per issue. Free.',
      inLanguage: 'en',
      publisher: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: 'https://wojciech.io/' },
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=8" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=8" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png?v=8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=8" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme init (before paint) -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('theme');
          var d = document.documentElement;
          if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            d.dataset.theme = 'dark';
            d.style.colorScheme = 'dark';
          } else {
            d.dataset.theme = 'light';
            d.style.colorScheme = 'light';
          }
        } catch(_) {}
      })();
    </script>

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4ED804XJLP"></script>
    <script is:inline>
      window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
      gtag('js',new Date());gtag('config','G-4ED804XJLP',{anonymize_ip:true});
    </script>

    <!-- Mixpanel EU — consent-gated -->
    <script is:inline>
      (function(c,a){window.mixpanel=a;var b,d,h,e;b=c.createElement("script");b.type="text/javascript";b.async=!0;b.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";d=c.getElementsByTagName("script")[0];d.parentNode.insertBefore(b,d);a._i=[];a.init=function(b,c,f){function d(a,b){var c=b.split(".");2==c.length&&(a=a[c[0]],b=c[1]);a[b]=function(){a.push([b].concat(Array.prototype.slice.call(arguments,0)))}}var g=a;"undefined"!==typeof f?g=a[f]=[]:f="mixpanel";g.people=g.people||[];h="disable time_event track track_pageview track_links track_forms register register_once unregister identify name_tag set_config reset people.set people.increment".split(" ");for(e=0;e<h.length;e++)d(g,h[e]);a._i.push([b,c,f])};a.__SV=1.1})(document,window.mixpanel||[]);
      mixpanel.init("efa47f584d961f6fdbe3857da52daf9a",{api_host:"https://api-eu.mixpanel.com",persistence:"localStorage",track_pageview:false,ip:false});
      if(localStorage.getItem('mp-consent')==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"subscribe.wojciech.io"});}
      else{mixpanel.opt_out_tracking();}
      window.addEventListener('wio:outbound-clicked',function(event){
        mixpanel.track("outbound_clicked",Object.assign({site:"subscribe.wojciech.io"},event.detail||{}));
      });
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">

    <NetworkTopBar current="subscribe" />

    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgb(var(--color-bg-rgb)/0.86)] backdrop-blur-md">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between gap-3 sm:gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-sm font-semibold tracking-tight text-[var(--color-text)]">AI Espresso</span>
          <span class="hidden sm:inline-flex text-[10px] font-semibold uppercase tracking-[0.1em] text-[var(--color-text-dim)] border border-[var(--color-border)] rounded-full px-2 py-0.5">newsletter</span>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <NetworkFooter variant="full">
      <div slot="brand" class="sub-nf-brand">
        <a href="https://wojciech.io" target="_blank" rel="noopener" class="sub-nf-wordmark">wojciech<span class="sub-nf-badge">.io</span></a>
        <p class="sub-nf-tagline">GTM architect and AI-native builder.<br />Revenue systems for B2B SaaS and technology companies.</p>
      </div>
    </NetworkFooter>
    <style>
      .sub-nf-wordmark { display: inline-flex; align-items: baseline; text-decoration: none; margin-bottom: 0.625rem; font-size: 14px; font-weight: 700; color: var(--color-text); }
      .sub-nf-badge { background: var(--color-accent-cta); color: var(--color-accent-text); border-radius: 5px; padding: 1px 5px; font-size: 10px; font-weight: 700; margin-left: 2px; }
      .sub-nf-tagline { font-size: 12px; color: var(--color-text-muted); line-height: 1.5; max-width: 240px; margin-top: 6px; }
    </style>

    <!-- Analytics consent — minimal bottom bar -->
    <div id="sub-consent" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;border-top:1px solid var(--color-border);background:var(--color-surface);padding:10px 20px;gap:12px;align-items:center;font-size:12px;color:var(--color-text-muted)">
      <span style="flex:1">I use Mixpanel (EU) &amp; Google Analytics to understand sign-up flow, anonymously, no ads. <a href="https://wojciech.io/privacy/" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);text-decoration:underline">Details</a></span>
      <button onclick="subConsent('yes')" style="padding:5px 14px;background:var(--color-accent-cta);color:var(--color-accent-text);border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer">Accept</button>
      <button onclick="subConsent('no')" style="padding:5px 10px;background:none;border:none;font-size:11px;color:var(--color-text-muted);cursor:pointer">No thanks</button>
    </div>
    <script is:inline>
      function subConsent(v){
        localStorage.setItem('mp-consent',v);
        document.getElementById('sub-consent').style.display='none';
        if(v==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"subscribe.wojciech.io"});}
      }
      (function(){
        var c=localStorage.getItem('mp-consent');
        var el=document.getElementById('sub-consent');
        if(!c){el.style.display='flex';}
      })();
    </script>
    <OutboundTelemetry />
  </body>
</html>
