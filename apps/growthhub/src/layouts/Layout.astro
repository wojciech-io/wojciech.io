---
import '../styles/global.css';
import OutboundTelemetry from '@wojciech/ui/components/OutboundTelemetry.astro';
import NetworkTopBar from '@wojciech/ui/components/NetworkTopBar.astro';
import LangSwitcher from '@wojciech/ui/components/LangSwitcher.astro';
interface Props {
  title?: string;
  activePage?: string;
  isDemo?: boolean;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'GrowthHub',
  activePage = 'review',
  isDemo = false,
  description = isDemo
    ? 'GrowthHub demo — operator-grade weekly review for B2B SaaS growth teams: acquisition, pipeline, lead scoring, paid channels. Synthetic dataset, full UX.'
    : 'GrowthHub — operator-grade dashboard for B2B SaaS growth (D1 + Cloudflare). Weekly review for growth/GTM teams on a single screen.',
  // Gated dashboard is noindex by default; /demo overrides this since it
  // is the public showcase route (the only one in robots Allow + sitemap).
  noindex = !isDemo,
} = Astro.props;
const fullTitle = isDemo ? `${title} Demo — operator dashboard for B2B SaaS growth` : `${title} — gh.wojciech.io`;
const SITE = 'https://gh.wojciech.io';
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE;
const ogImage = `${SITE}/og-default.png`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0b" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
  <link rel="manifest" href="/site.webmanifest" />
  <script is:inline>
    (function(){
      try {
        var saved = localStorage.getItem('theme');
        var mode = saved ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', mode);
        document.documentElement.style.colorScheme = mode;
      } catch(e) { document.documentElement.setAttribute('data-theme','light'); }
    })();
  </script>

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4ED804XJLP"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','G-4ED804XJLP',{anonymize_ip:true});
  </script>

  <!-- Mixpanel EU — consent-gated -->
  <script is:inline>
    (function(c,a){window.mixpanel=a;var b,d,h,e;b=c.createElement("script");b.type="text/javascript";b.async=!0;b.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";d=c.getElementsByTagName("script")[0];d.parentNode.insertBefore(b,d);a._i=[];a.init=function(b,c,f){function d(a,b){var c=b.split(".");2==c.length&&(a=a[c[0]],b=c[1]);a[b]=function(){a.push([b].concat(Array.prototype.slice.call(arguments,0)))}}var g=a;"undefined"!==typeof f?g=a[f]=[]:f="mixpanel";g.people=g.people||[];h="disable time_event track track_pageview track_links track_forms register register_once unregister identify name_tag set_config reset people.set people.increment".split(" ");for(e=0;e<h.length;e++)d(g,h[e]);a._i.push([b,c,f])};a.__SV=1.1})(document,window.mixpanel||[]);
    mixpanel.init("efa47f584d961f6fdbe3857da52daf9a",{api_host:"https://api-eu.mixpanel.com",persistence:"localStorage",track_pageview:false,ip:false});
    if(localStorage.getItem('mp-consent')==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"gh.wojciech.io"});}
    else{mixpanel.opt_out_tracking();}
    window.addEventListener('wio:outbound-clicked',function(event){
      mixpanel.track("outbound_clicked",Object.assign({site:"gh.wojciech.io"},event.detail||{}));
    });
  </script>
</head>
<body>
<NetworkTopBar current="growthhub" />
<div class="gh-shell">
  <header class="gh-header">
    <div class="gh-header-inner">
      <a href={isDemo ? '/demo' : '/'} class="gh-wordmark" aria-label="GrowthHub">
        GrowthHub<span class="gh-wordmark-tag">.</span>
      </a>
      <nav class="gh-nav" aria-label="Primary">
        <a href={isDemo ? '/demo' : '/'} class={`gh-nav-link${activePage === 'review' ? ' active' : ''}`} data-en="Weekly review" data-pl="Przegląd tygodnia">Weekly review</a>
        <a href={isDemo ? '/demo/demand' : '/demand'} class={`gh-nav-link${activePage === 'demand' ? ' active' : ''}`} data-en="Demand-gen" data-pl="Generowanie popytu">Demand-gen</a>
        <a href={isDemo ? '/demo/leads' : '/leads'} class={`gh-nav-link${activePage === 'leads' ? ' active' : ''}`} data-en="Leads" data-pl="Leady">Leads</a>
        <a href={isDemo ? '/demo/revenue' : '/revenue'} class={`gh-nav-link${activePage === 'revenue' ? ' active' : ''}`} data-en="Revenue" data-pl="Przychody">Revenue</a>
      </nav>
      <div class="gh-header-right">
        {isDemo ? (
          <span data-en="Demo mode" data-pl="Tryb demo">Demo mode</span>
        ) : (
          <>
            <span data-en="Single user" data-pl="Użytkownik">Single user</span>
            <a href="/api/auth?logout=1" style="color:var(--text-3)" data-en="Sign out" data-pl="Wyloguj">Sign out</a>
          </>
        )}
        <LangSwitcher langs={['en', 'pl']} storageKey="ghLang" defaultLang="en" />
      </div>
    </div>
  </header>

  <main class="gh-main">
    {isDemo && (
      <div class="gh-demo-banner">
        <span class="gh-demo-tag">DEMO</span>
        <span>Synthetic data — not real client metrics. A live preview of the dashboard a single B2B SaaS growth team would see.</span>
      </div>
    )}
    <slot />
  </main>

  <footer class="gh-footer">
    GrowthHub — operator-grade demand & revenue dashboard. Single tenant, edge-native.
    {isDemo && (
      <span> · <a href="https://wojciech.io" style="color:var(--text-2);text-decoration:underline">wojciech.io</a></span>
    )}
  </footer>
</div>

<!-- Analytics consent — minimal bottom bar -->
<div id="gh-consent" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;border-top:1px solid var(--border);background:var(--surface);padding:10px 20px;display:flex;align-items:center;gap:12px;font-size:12px;color:var(--text-2)">
  <span style="flex:1">This site uses Mixpanel (EU) &amp; Google Analytics to understand usage — anonymously, no advertising. <a href="https://wojciech.io/privacy/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);text-decoration:underline">Details</a></span>
  <button onclick="ghConsent('yes')" style="padding:5px 14px;background:var(--accent);color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer">Accept</button>
  <button onclick="ghConsent('no')" style="padding:5px 10px;background:none;border:none;font-size:11px;color:var(--text-2);cursor:pointer">No thanks</button>
</div>
<script is:inline>
  function ghConsent(v){
    localStorage.setItem('mp-consent',v);
    document.getElementById('gh-consent').style.display='none';
    if(v==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"gh.wojciech.io"});}
  }
  (function(){
    var c=localStorage.getItem('mp-consent');
    if(!c) document.getElementById('gh-consent').style.display='flex';
  })();
</script>
<OutboundTelemetry />
</body>
</html>
