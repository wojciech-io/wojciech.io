---
import Layout from '../layouts/Layout.astro';
import { topLeads, pipeline, headlineMetrics, formatCurrency, formatPct } from '../lib/dummy-data';

const pipelineTotal = pipeline.reduce((s, p) => s + p.amount_cents, 0);
const hotLeads      = topLeads.filter(l => l.total_score >= 80).length;
const avgScore      = Math.round(topLeads.reduce((s, l) => s + l.total_score, 0) / topLeads.length);
const maxPipeline   = Math.max(...pipeline.map(p => p.amount_cents));

const stageHexMap: Record<string, string> = {
  'New': '#64748b', 'Discovery': '#3b82f6', 'Qualified': '#6366f1',
  'Demo': '#8b5cf6', 'Proposal': '#a855f7', 'Negotiation': '#ec4899',
};
const stageBadgeStyle: Record<string, string> = {
  'New':         'background:rgba(100,116,139,.15);color:#94a3b8',
  'Discovery':   'background:rgba(59,130,246,.15);color:#60a5fa',
  'Qualified':   'background:rgba(99,102,241,.15);color:#818cf8',
  'Demo':        'background:rgba(139,92,246,.15);color:#c084fc',
  'Proposal':    'background:rgba(168,85,247,.15);color:#d8b4fe',
  'Negotiation': 'background:rgba(236,72,153,.15);color:#f9a8d4',
};

function scoreClass(n: number) {
  if (n >= 85) return 's-90';
  if (n >= 75) return 's-80';
  return 's-60';
}
---

<Layout title="Leads" activePage="leads" isDemo={false}>
  <div class="gh-page-header">
    <h1 class="gh-page-title">Leads</h1>
    <p class="gh-page-sub">Lead scoring · ICP fit · pipeline stages</p>
  </div>

  <!-- ── KPI row ── -->
  <div class="gh-metric-row">
    <div class="gh-card gh-metric m-violet">
      <p class="gh-metric-label">Leads · 7d</p>
      <div class="gh-metric-value">{headlineMetrics.leads_7d}</div>
      <div class={`gh-metric-delta ${headlineMetrics.leads_7d_delta >= 0 ? 'gh-up' : 'gh-down'}`}>
        {headlineMetrics.leads_7d_delta >= 0 ? '↑' : '↓'} {formatPct(headlineMetrics.leads_7d_delta)} WoW
      </div>
    </div>
    <div class="gh-card gh-metric m-lime">
      <p class="gh-metric-label">Hot leads (score ≥80)</p>
      <div class="gh-metric-value">{hotLeads}</div>
      <div class="gh-metric-delta" style="color:var(--text-3)">{hotLeads} of {topLeads.length} shown</div>
    </div>
    <div class="gh-card gh-metric m-blue">
      <p class="gh-metric-label">Avg lead score</p>
      <div class="gh-metric-value">{avgScore}</div>
    </div>
    <div class="gh-card gh-metric m-green">
      <p class="gh-metric-label">Pipeline value</p>
      <div class="gh-metric-value">{formatCurrency(pipelineTotal)}</div>
      <div class={`gh-metric-delta ${headlineMetrics.pipeline_delta >= 0 ? 'gh-up' : 'gh-down'}`}>
        {headlineMetrics.pipeline_delta >= 0 ? '↑' : '↓'} {formatPct(headlineMetrics.pipeline_delta)} WoW
      </div>
    </div>
  </div>

  <!-- ── Pipeline funnel ── -->
  <div class="gh-card" style="margin-bottom:14px">
    <div class="gh-card-header">Pipeline funnel</div>
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:12px">
      {pipeline.map(p => {
        const color = stageHexMap[p.stage] ?? '#888';
        const pct   = (p.amount_cents / pipelineTotal * 100).toFixed(0);
        return (
          <div style="text-align:center">
            <div style={`width:28px;height:28px;border-radius:8px;margin:0 auto 8px;background:${color}22;display:flex;align-items:center;justify-content:center`}>
              <div style={`width:10px;height:10px;border-radius:50%;background:${color}`}></div>
            </div>
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-3);margin-bottom:4px">{p.stage}</div>
            <div style="font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--text-1);line-height:1">{p.count}</div>
            <div style={`font-size:11px;font-weight:600;color:${color};margin-top:3px`}>{formatCurrency(p.amount_cents)}</div>
            <div style="font-size:10px;color:var(--text-3);margin-top:2px">{pct}%</div>
          </div>
        );
      })}
    </div>
    <!-- Color bar -->
    <div class="gh-funnel-strip">
      {pipeline.map(p => (
        <div class="gh-funnel-seg" style={`background:${stageHexMap[p.stage] ?? '#888'};flex:${p.count}`}></div>
      ))}
    </div>
  </div>

  <!-- ── Lead table ── -->
  <div class="gh-card">
    <div class="gh-card-header">
      Top leads by score
      <span class="gh-card-meta">{topLeads.length} shown · sorted by total score</span>
    </div>
    <div style="overflow-x:auto">
      <table class="gh-table">
        <thead>
          <tr>
            <th>Score</th>
            <th>ICP</th>
            <th>Behav.</th>
            <th>Role</th>
            <th>Industry · size</th>
            <th>Source</th>
            <th>Stage</th>
            <th class="gh-num">Amount</th>
            <th class="gh-num">Added</th>
          </tr>
        </thead>
        <tbody>
          {topLeads.map(l => (
            <tr>
              <td>
                <span class={`gh-score ${scoreClass(l.total_score)}`}>{l.total_score}</span>
              </td>
              <td style="color:var(--text-3)">{l.icp_score}</td>
              <td style="color:var(--text-3)">{l.behaviour_score}</td>
              <td style="font-weight:600;color:var(--text-1);white-space:nowrap">{l.role}</td>
              <td>
                <div style="color:var(--text-2)">{l.industry}</div>
                <div style="font-size:11px;color:var(--text-3)">{l.company_size}</div>
              </td>
              <td class="gh-mono" style="color:var(--text-3)">{l.source}</td>
              <td>
                <span class="gh-badge" style={stageBadgeStyle[l.stage] ?? ''}>{l.stage}</span>
              </td>
              <td class="gh-num" style="font-weight:700;color:var(--text-1)">{formatCurrency(l.amount_cents)}</td>
              <td class="gh-num gh-mono" style="color:var(--text-3)">{l.created_at}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>
