---
import Layout from '../layouts/Layout.astro';
import WeeklyReview from '../components/WeeklyReview.astro';
import {
  headlineMetrics,
  acquisitionLast14,
  sourceBreakdown,
  pipeline,
  topLeads,
  paidChannels,
  dataSources,
} from '../lib/dummy-data';
---
<Layout title="GrowthHub" activePage="review" isDemo={true}>
  <WeeklyReview
    headline={headlineMetrics}
    acquisition={acquisitionLast14}
    sources={sourceBreakdown}
    pipeline={pipeline}
    topLeads={topLeads}
    paid={paidChannels}
    dataSources={dataSources}
  />
</Layout>
