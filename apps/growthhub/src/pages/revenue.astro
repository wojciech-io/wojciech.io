---
import Layout from '../layouts/Layout.astro';
import { pipeline, paidChannels, headlineMetrics, formatCurrency, formatPct } from '../lib/dummy-data';

const pipelineTotal  = pipeline.reduce((s, p) => s + p.amount_cents, 0);
const totalSpend     = paidChannels.reduce((s, c) => s + c.spend_cents, 0);
const totalClicks    = paidChannels.reduce((s, c) => s + c.clicks, 0);
const totalPaidLeads = paidChannels.reduce((s, c) => s + c.leads, 0);
const blendedRoas    = paidChannels.reduce((s, c) => s + c.roas * c.spend_cents, 0) / totalSpend;
const maxPipe        = Math.max(...pipeline.map(p => p.amount_cents));

const stageHexMap: Record<string, string> = {
  'New': '#64748b', 'Discovery': '#3b82f6', 'Qualified': '#6366f1',
  'Demo': '#8b5cf6', 'Proposal': '#a855f7', 'Negotiation': '#ec4899',
};

const wonMoM = [
  { month: 'Dec', won_cents: 4200000, count: 2 },
  { month: 'Jan', won_cents: 5800000, count: 3 },
  { month: 'Feb', won_cents: 6100000, count: 3 },
  { month: 'Mar', won_cents: 7400000, count: 4 },
  { month: 'Apr', won_cents: 7900000, count: 4 },
  { month: 'May', won_cents: headlineMetrics.won_mtd_cents, count: headlineMetrics.won_count_mtd },
];
const maxWon = Math.max(...wonMoM.map(m => m.won_cents));
---

<Layout title="Revenue" activePage="revenue" isDemo={false}>
  <div class="gh-page-header">
    <h1 class="gh-page-title">Revenue</h1>
    <p class="gh-page-sub">Pipeline · closed-won · paid ROAS</p>
  </div>

  <!-- ── KPI row ── -->
  <div class="gh-metric-row">
    <div class="gh-card gh-metric m-violet">
      <p class="gh-metric-label">Pipeline total</p>
      <div class="gh-metric-value">{formatCurrency(pipelineTotal)}</div>
      <div class={`gh-metric-delta ${headlineMetrics.pipeline_delta >= 0 ? 'gh-up' : 'gh-down'}`}>
        {headlineMetrics.pipeline_delta >= 0 ? '↑' : '↓'} {formatPct(headlineMetrics.pipeline_delta)} WoW
      </div>
    </div>
    <div class="gh-card gh-metric m-lime">
      <p class="gh-metric-label">Won MTD</p>
      <div class="gh-metric-value">{formatCurrency(headlineMetrics.won_mtd_cents)}</div>
      <div class="gh-metric-delta" style="color:var(--text-3)">{headlineMetrics.won_count_mtd} deals closed</div>
    </div>
    <div class="gh-card gh-metric m-amber">
      <p class="gh-metric-label">Total spend · 14d</p>
      <div class="gh-metric-value">{formatCurrency(totalSpend)}</div>
    </div>
    <div class="gh-card gh-metric m-green">
      <p class="gh-metric-label">Blended ROAS</p>
      <div class={`gh-metric-value ${blendedRoas >= 3 ? 'gh-up' : blendedRoas >= 2 ? '' : 'gh-down'}`}>
        {blendedRoas.toFixed(1)}x
      </div>
    </div>
  </div>

  <!-- ── Pipeline funnel + MoM chart ── -->
  <div style="display:grid;grid-template-columns:1.2fr 1fr;gap:14px;margin-bottom:14px">

    <!-- Pipeline bars -->
    <div class="gh-card">
      <div class="gh-card-header">
        Pipeline funnel
        <span class="gh-card-meta">{formatCurrency(pipelineTotal)} total</span>
      </div>
      <div class="gh-pipeline">
        {pipeline.map(p => {
          const barPct = Math.round((p.amount_cents / maxPipe) * 100);
          const color  = stageHexMap[p.stage] ?? '#888';
          return (
            <div class="gh-stage">
              <div class="gh-stage-name">{p.stage}</div>
              <div class="gh-stage-track">
                <div class="gh-stage-fill" style={`width:${barPct}%;background:${color}`}></div>
              </div>
              <div class="gh-stage-count">{p.count}</div>
              <div class="gh-stage-amt">{formatCurrency(p.amount_cents)}</div>
            </div>
          );
        })}
      </div>
      <div class="gh-funnel-strip" style="margin-top:14px">
        {pipeline.map(p => (
          <div class="gh-funnel-seg" style={`background:${stageHexMap[p.stage] ?? '#888'};flex:${p.count}`}></div>
        ))}
      </div>
    </div>

    <!-- Closed-won MoM bar chart -->
    <div class="gh-card">
      <div class="gh-card-header">Closed-won MoM <span class="gh-card-meta">last 6 months</span></div>
      <div class="gh-bar-chart" style="height:110px;align-items:flex-end">
        {wonMoM.map((m, i) => {
          const hPct = Math.max(6, Math.round((m.won_cents / maxWon) * 100));
          const isCurrent = i === wonMoM.length - 1;
          return (
            <div class="gh-bar-col" style="height:100%">
              <div style="flex:1;width:100%;display:flex;align-items:flex-end">
                <div
                  class={`gh-bar-fill${isCurrent ? ' current' : ''}`}
                  style={`height:${hPct}%;width:100%`}
                  title={`${m.month}: ${formatCurrency(m.won_cents)}`}
                ></div>
              </div>
              <div class="gh-bar-label">{m.month}</div>
              <div class="gh-bar-val" style={isCurrent ? 'color:var(--lime)' : ''}>{formatCurrency(m.won_cents)}</div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ── Paid channel ROAS ── -->
  <div class="gh-card">
    <div class="gh-card-header">
      Paid channel performance · 14d
      <span class="gh-card-meta">
        {formatCurrency(totalSpend)} · {totalPaidLeads} leads · {blendedRoas.toFixed(1)}x blended
      </span>
    </div>
    <div style="overflow-x:auto">
      <table class="gh-table">
        <thead>
          <tr>
            <th>Channel</th>
            <th class="gh-num">Spend</th>
            <th class="gh-num">Clicks</th>
            <th class="gh-num">Leads</th>
            <th class="gh-num">CPL</th>
            <th class="gh-num">Pipeline attr.</th>
            <th>ROAS</th>
            <th class="gh-num">Spend %</th>
          </tr>
        </thead>
        <tbody>
          {paidChannels.map(c => {
            const pipeAttr   = Math.round(c.spend_cents * c.roas);
            const spendShare = Math.round((c.spend_cents / totalSpend) * 100);
            const roasCls    = c.roas >= 3 ? 'gh-up' : c.roas >= 2 ? '' : 'gh-down';
            const roasColor  = c.roas >= 3 ? 'var(--lime)' : c.roas >= 2 ? '#6366f1' : 'var(--bad)';
            return (
              <tr>
                <td style="font-weight:600;color:var(--text-1)">{c.channel}</td>
                <td class="gh-num">{formatCurrency(c.spend_cents)}</td>
                <td class="gh-num">{c.clicks.toLocaleString()}</td>
                <td class="gh-num">{c.leads}</td>
                <td class="gh-num">{formatCurrency(c.cpl_cents)}</td>
                <td class="gh-num gh-up" style="font-weight:600">{formatCurrency(pipeAttr)}</td>
                <td>
                  <div class="gh-roas-bar">
                    <div class="gh-roas-track">
                      <div class="gh-roas-fill" style={`width:${Math.round((c.roas / 4) * 100)}%;background:${roasColor}`}></div>
                    </div>
                    <span class={roasCls} style="font-weight:700;font-size:12px;white-space:nowrap">{c.roas.toFixed(1)}x</span>
                  </div>
                </td>
                <td class="gh-num">
                  <div style="display:flex;align-items:center;justify-content:flex-end;gap:6px">
                    <div style={`height:4px;width:${spendShare * 0.6}px;background:var(--text-3);border-radius:2px;opacity:.4`}></div>
                    {spendShare}%
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
        <tfoot>
          <tr>
            <td style="font-weight:700;color:var(--text-1)">Total</td>
            <td class="gh-num" style="font-weight:700">{formatCurrency(totalSpend)}</td>
            <td class="gh-num" style="color:var(--text-3)">{totalClicks.toLocaleString()}</td>
            <td class="gh-num" style="font-weight:700">{totalPaidLeads}</td>
            <td class="gh-num" style="color:var(--text-3)">–</td>
            <td class="gh-num gh-up" style="font-weight:700">{formatCurrency(Math.round(totalSpend * blendedRoas))}</td>
            <td>
              <span class={blendedRoas >= 3 ? 'gh-up' : ''} style="font-weight:800">{blendedRoas.toFixed(1)}x</span>
            </td>
            <td class="gh-num">100%</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</Layout>
