---
import '../styles/global.css';
import OutboundTelemetry from '@wojciech/ui/components/OutboundTelemetry.astro';
import NetworkTopBar from '@wojciech/ui/components/NetworkTopBar.astro';
import LangSwitcher from '@wojciech/ui/components/LangSwitcher.astro';
import NetworkFooter from '@wojciech/ui/components/NetworkFooter.astro';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'AI Growth OS — program wdrożenia AI dla zespołów GTM w B2B SaaS',
  description = 'Program wdrożenia AI dla zespołów GTM w B2B SaaS — outbound, content, revenue ops jako powtarzalny proces. 36 odcinków, playbooki, blueprinty od praktyka.',
  ogImage,
  noindex = false,
  schema,
} = Astro.props;

const SITE = 'https://academy.wojciech.io';
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE;
const ogImageURL = ogImage ? new URL(ogImage, SITE).href : `${SITE}/og-cover.png`;

// Base JSON-LD: identifies the Academy and its anchor program for LLMs and
// rich-result crawlers. Per-page schema is appended via the `schema` prop.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'AI Growth OS Academy',
    alternateName: 'AI Growth OS',
    url: SITE + '/',
    logo: SITE + '/og-cover.png',
    description:
      'Polskojęzyczna akademia AI dla operatorów, marketerów i builderów B2B SaaS. Cohort live + biblioteka odcinków audio, ranking modeli, workflow do realnej roboty.',
    inLanguage: 'pl',
    founder: {
      '@type': 'Person',
      name: 'Wojciech Łuszczyński',
      url: 'https://wojciech.io/',
      jobTitle: 'GTM Architect & Growth Operator',
      sameAs: [
        'https://www.linkedin.com/in/wojciech-luszczynski/',
        'https://x.com/w_luszczynski',
        'https://github.com/wojciechluszczynski',
      ],
    },
    sameAs: ['https://wojciech.io/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'AI Growth OS',
    description:
      'Operator-grade AI dla zespołów GTM w B2B SaaS. 6 tygodni live cohortu plus biblioteka 36 odcinków audio, blueprinty i vault z promptami.',
    provider: {
      '@type': 'EducationalOrganization',
      name: 'AI Growth OS Academy',
      url: SITE + '/',
    },
    url: SITE + '/',
    inLanguage: 'pl',
    educationalLevel: 'Professional',
    teaches: [
      'Wybór modelu AI do zadania (Claude, GPT, modele lokalne)',
      'Outbound jako system: Clay + Pipedrive + signal stack',
      'Content jako infrastruktura: research, draft, dystrybucja',
      'Revenue operations i dashboardy operatorskie',
      'MCP agents i custom workflow automation',
      'Adopcja AI w zespole, mierzenie ROI',
    ],
  },
];
const pageSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaItems = [...baseSchema, ...pageSchema];
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0c" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf8" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AI Growth OS" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  {schemaItems.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  {import.meta.env.PUBLIC_TURNSTILE_SITEKEY && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  <script is:inline>
    (function(c,a){window.mixpanel=a;var b,d,h,e;b=c.createElement("script");b.type="text/javascript";b.async=!0;b.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";d=c.getElementsByTagName("script")[0];d.parentNode.insertBefore(b,d);a._i=[];a.init=function(b,c,f){function d(a,b){var c=b.split(".");2==c.length&&(a=a[c[0]],b=c[1]);a[b]=function(){a.push([b].concat(Array.prototype.slice.call(arguments,0)))}}var g=a;"undefined"!==typeof f?g=a[f]=[]:f="mixpanel";g.people=g.people||[];h="disable time_event track track_pageview track_links track_forms register register_once unregister identify name_tag set_config reset people.set people.increment".split(" ");for(e=0;e<h.length;e++)d(g,h[e]);a._i.push([b,c,f])};a.__SV=1.1})(document,window.mixpanel||[]);
    mixpanel.init("efa47f584d961f6fdbe3857da52daf9a",{api_host:"https://api-eu.mixpanel.com",persistence:"localStorage",track_pageview:false,ip:false});
    if(localStorage.getItem('mp-consent')==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"academy.wojciech.io"});}
    else{mixpanel.opt_out_tracking();}
    window.addEventListener('wio:outbound-clicked',function(event){
      mixpanel.track("outbound_clicked",Object.assign({site:"academy.wojciech.io"},event.detail||{}));
    });
  </script>
  <script is:inline>
    (function(){
      // Mark JS available BEFORE first paint so reveal animations only hide
      // content when we can actually reveal it. No-JS users see everything.
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('theme');
        var mode = saved ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark');
        document.documentElement.setAttribute('data-theme', mode);
      } catch(e) { document.documentElement.setAttribute('data-theme','dark'); }
    })();
  </script>
</head>
<body>
  <NetworkTopBar current="academy" />
  <header class="ac-header">
    <div class="ac-header-inner">
      <a href="/" class="ac-wordmark" aria-label="AI Growth OS">
        academy<span class="ac-wordmark-tag">.</span>
      </a>
      <nav class="ac-nav" aria-label="Primary">
        <a href="/#program" class="ac-nav-link" data-pl="Program" data-en="Programme">Program</a>
        <a href="/pricing" class="ac-nav-link" data-pl="Cennik" data-en="Pricing">Cennik</a>
        <a href="/cohort" class="ac-nav-link" data-pl="Cohort" data-en="Cohort">Cohort</a>
        <a href="/login" class="ac-nav-link" data-pl="Panel" data-en="Panel">Panel</a>
      </nav>
      <div class="ac-header-actions">
        <a href="/pricing" class="ac-header-cta" data-pl="Dołącz" data-en="Join">Dołącz</a>
        <LangSwitcher langs={['pl', 'en']} defaultLang="pl" />
      </div>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <NetworkFooter variant="full">
    <div slot="brand" class="ac-nf-brand">
      <a href="https://wojciech.io" target="_blank" rel="noopener" class="ac-nf-wordmark">
        wojciech<span class="ac-nf-badge">.io</span>
      </a>
      <p class="ac-nf-tagline">GTM architect and AI-native builder.<br />Revenue systems for B2B SaaS.</p>
    </div>
  </NetworkFooter>
  <!-- Reveal bootstrap runs inline (no network fetch) so above-the-fold
       content is never stuck invisible while the module loads. A safety
       timer force-reveals everything after 1.2s in case anything slips. -->
  <script is:inline>
    (function(){
      var els = document.querySelectorAll('.reveal,.reveal-up,.reveal-left,.reveal-right,.reveal-zoom');
      if (!els.length) return;
      var show = function(el){ el.classList.add('in'); };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ if (e.isIntersecting){ show(e.target); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.04 });
        els.forEach(function(el){ io.observe(el); });
        // Safety: nothing should stay hidden longer than 1.2s.
        setTimeout(function(){ els.forEach(show); }, 1200);
      } else {
        els.forEach(show);
      }
    })();
  </script>
  <script>
    import('../scripts/interactions.client.ts');
  </script>

  <style>
    .ac-nf-wordmark {
      display: inline-flex;
      align-items: baseline;
      text-decoration: none;
      margin-bottom: 10px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
    }
    .ac-nf-badge {
      background: var(--orange);
      color: #0a0a0c;
      border-radius: 5px;
      padding: 1px 5px;
      font-size: 10px;
      font-weight: 700;
      margin-left: 2px;
    }
    .ac-nf-tagline {
      font-size: 12px;
      color: var(--text-2);
      line-height: 1.55;
      max-width: 240px;
      margin: 0;
    }
  </style>
  <div id="academy-consent" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;border-top:1px solid var(--border);background:var(--bg1);padding:10px 20px;gap:12px;align-items:center;font-size:12px;color:var(--text-2)">
    <span style="flex:1">Używam Mixpanel (EU), żeby rozumieć zainteresowanie programem — anonimowo, bez reklam. <a href="https://wojciech.io/privacy/" target="_blank" rel="noopener noreferrer" style="color:var(--orange);text-decoration:underline">Szczegóły</a></span>
    <button onclick="academyConsent('yes')" style="padding:5px 14px;background:var(--orange);color:#050505;border:none;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">OK</button>
    <button onclick="academyConsent('no')" style="padding:5px 10px;background:none;border:none;font-size:11px;color:var(--text-2);cursor:pointer">Nie</button>
  </div>
  <script is:inline>
    function academyConsent(v){
      localStorage.setItem('mp-consent',v);
      document.getElementById('academy-consent').style.display='none';
      if(v==='yes'){mixpanel.opt_in_tracking();mixpanel.track("page_viewed",{path:location.pathname,site:"academy.wojciech.io"});}
    }
    (function(){
      var c=localStorage.getItem('mp-consent');
      if(!c) document.getElementById('academy-consent').style.display='flex';
    })();
  </script>
  <OutboundTelemetry />
</body>
</html>
