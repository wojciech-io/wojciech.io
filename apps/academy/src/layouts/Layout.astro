---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'AI Growth OS — program wdrożenia AI dla zespołów GTM w B2B SaaS',
  description = 'Program wdrożenia AI dla zespołów GTM w B2B SaaS — outbound, content, revenue ops jako powtarzalny proces. 36 odcinków, playbooki, blueprinty od praktyka.',
  ogImage,
  noindex = false,
  schema,
} = Astro.props;

const SITE = 'https://academy.wojciech.io';
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE;
const ogImageURL = ogImage ? new URL(ogImage, SITE).href : `${SITE}/og-cover.png`;

// Base JSON-LD: identifies the Academy and its anchor program for LLMs and
// rich-result crawlers. Per-page schema is appended via the `schema` prop.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'AI Growth OS Academy',
    alternateName: 'AI Growth OS',
    url: SITE + '/',
    logo: SITE + '/og-cover.png',
    description:
      'Polskojęzyczna akademia AI dla operatorów, marketerów i builderów B2B SaaS. Cohort live + biblioteka odcinków audio, ranking modeli, workflow do realnej roboty.',
    inLanguage: 'pl',
    founder: {
      '@type': 'Person',
      name: 'Wojciech Łuszczyński',
      url: 'https://wojciech.io/',
      jobTitle: 'GTM Architect & Growth Operator',
      sameAs: [
        'https://www.linkedin.com/in/wojciech-luszczynski/',
        'https://x.com/w_luszczynski',
        'https://github.com/wojciechluszczynski',
      ],
    },
    sameAs: ['https://wojciech.io/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'AI Growth OS',
    description:
      'Operator-grade AI dla zespołów GTM w B2B SaaS. 6 tygodni live cohortu plus biblioteka 36 odcinków audio, blueprinty i vault z promptami.',
    provider: {
      '@type': 'EducationalOrganization',
      name: 'AI Growth OS Academy',
      url: SITE + '/',
    },
    url: SITE + '/',
    inLanguage: 'pl',
    educationalLevel: 'Professional',
    teaches: [
      'Wybór modelu AI do zadania (Claude, GPT, modele lokalne)',
      'Outbound jako system: Clay + Pipedrive + signal stack',
      'Content jako infrastruktura: research, draft, dystrybucja',
      'Revenue operations i dashboardy operatorskie',
      'MCP agents i custom workflow automation',
      'Adopcja AI w zespole, mierzenie ROI',
    ],
  },
];
const pageSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaItems = [...baseSchema, ...pageSchema];
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AI Growth OS" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  {schemaItems.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  {import.meta.env.PUBLIC_TURNSTILE_SITEKEY && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  <script is:inline>
    (function(){
      // Mark JS available BEFORE first paint so reveal animations only hide
      // content when we can actually reveal it. No-JS users see everything.
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('theme');
        var mode = saved ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark');
        document.documentElement.setAttribute('data-theme', mode);
      } catch(e) { document.documentElement.setAttribute('data-theme','dark'); }
    })();
  </script>
</head>
<body>
  <header class="ac-header">
    <div class="ac-header-inner">
      <a href="/" class="ac-wordmark" aria-label="AI Growth OS">
        academy<span class="ac-wordmark-tag">.</span>
      </a>
      <nav class="ac-nav" aria-label="Primary">
        <a href="/#program" class="ac-nav-link">Program</a>
        <a href="/pricing" class="ac-nav-link">Cennik</a>
        <a href="/cohort" class="ac-nav-link">Cohort</a>
        <a href="/login" class="ac-nav-link">Panel</a>
      </nav>
      <a href="/pricing" class="ac-header-cta">Dołącz</a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="ac-footer">
    AI Growth OS · operator-grade AI dla zespołów B2B SaaS ·
    <a href="https://wojciech.io">wojciech.io</a> ·
    <a href="mailto:hello@wojciech.io">hello@wojciech.io</a>
  </footer>
  <!-- Reveal bootstrap runs inline (no network fetch) so above-the-fold
       content is never stuck invisible while the module loads. A safety
       timer force-reveals everything after 1.2s in case anything slips. -->
  <script is:inline>
    (function(){
      var els = document.querySelectorAll('.reveal,.reveal-up,.reveal-left,.reveal-right,.reveal-zoom');
      if (!els.length) return;
      var show = function(el){ el.classList.add('in'); };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ if (e.isIntersecting){ show(e.target); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.04 });
        els.forEach(function(el){ io.observe(el); });
        // Safety: nothing should stay hidden longer than 1.2s.
        setTimeout(function(){ els.forEach(show); }, 1200);
      } else {
        els.forEach(show);
      }
    })();
  </script>
  <script>
    import('../scripts/interactions.client.ts');
  </script>
</body>
</html>
