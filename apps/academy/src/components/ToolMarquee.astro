---
const tools = ['Claude', 'ChatGPT', 'Perplexity', 'Gemini', 'Clay', 'Pipedrive', 'n8n', 'ElevenLabs', 'Cursor', 'Midjourney', 'HubSpot', 'LinkedIn'];
const all = [...tools, ...tools];
---
<div class="ac-tool-strip reveal-up" aria-label="Narzędzia w programie">
  <p>Narzędzia w programie</p>
  <div class="ac-tool-marquee">
    <div class="ac-tool-track">
      {all.map((tool) => (
        <span class="ac-tool-chip"><i>{tool.slice(0, 1)}</i>{tool}</span>
      ))}
    </div>
  </div>
</div>
