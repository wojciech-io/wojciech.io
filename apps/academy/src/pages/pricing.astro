---
import Layout from '../layouts/Layout.astro';

// Gated pricing model (aisales.pl playbook): Individual + Team behind a
// request form, Cohort shown openly. Builds a sales conversation + premium
// positioning instead of an impulse-buy price tag.

const gatedTiers = [
  {
    tier: 'Dla Ciebie',
    sub: 'Indywidualny operator',
    features: [
      'Wszystkie 36 odcinków (4 serie)',
      'Vault — 100+ plików: prompty, blueprinty, szablony',
      'Certyfikat po zaliczeniu quizów (PDF + LinkedIn)',
      'Dostęp do materiałów: 12 miesięcy',
      '2 raty 0% · faktura VAT',
    ],
  },
  {
    tier: 'Dla zespołu',
    sub: 'Cały zespół GTM',
    featured: true,
    label: 'Najczęściej wdrażane',
    features: [
      'Wszystko z pakietu indywidualnego × cały zespół',
      'Team dashboard — kto co odsłuchał, kto zdał quizy',
      'Wspólny Vault z notatkami zespołu',
      'Godzina Q&A z Wojtkiem dla całego zespołu',
      'Rabat ilościowy · jeden centralny billing · faktura VAT',
    ],
  },
];

// Cohort has a published price (open); individual/team are gated behind a
// pricing request (so no price field on those offers — schema.org allows
// PriceSpecification omission with "InStock"/"PreOrder" flags).
const pricingSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'AI Growth OS — cohort live (1 miejsce)',
    description:
      'Pojedyncze miejsce w live cohort: 6 tygodni warsztatów, office hours, case-work na waszym CRM.',
    price: '2900',
    priceCurrency: 'PLN',
    availability: 'https://schema.org/PreOrder',
    category: 'Course',
    url: 'https://academy.wojciech.io/cohort',
    seller: {
      '@type': 'EducationalOrganization',
      name: 'AI Growth OS Academy',
      url: 'https://academy.wojciech.io/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'AI Growth OS — dostęp indywidualny',
    description:
      'Indywidualny dostęp do 36 odcinków, vaultu i certyfikatu. Cena na zapytanie.',
    availability: 'https://schema.org/InStock',
    category: 'OnlineCourse',
    url: 'https://academy.wojciech.io/pricing',
    seller: {
      '@type': 'EducationalOrganization',
      name: 'AI Growth OS Academy',
      url: 'https://academy.wojciech.io/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'AI Growth OS — dostęp zespołowy (Team)',
    description:
      'Dostęp dla całego zespołu GTM: team dashboard, wspólny vault, godzina Q&A z Wojciechem. Cena na zapytanie.',
    availability: 'https://schema.org/InStock',
    category: 'OnlineCourse',
    url: 'https://academy.wojciech.io/pricing',
    seller: {
      '@type': 'EducationalOrganization',
      name: 'AI Growth OS Academy',
      url: 'https://academy.wojciech.io/',
    },
  },
];
---
<Layout
  title="Cennik · AI Growth OS · Academy"
  description="Dostęp do programu wdrożenia AI dla zespołów GTM — indywidualnie albo zespołowo. Cennik na zapytanie, cohort live z otwartą ceną 2 900 zł/os."
  schema={pricingSchema}
>

  <section class="ac-hero" style="padding-bottom: 40px">
    <span class="ac-hero-eyebrow reveal-up">Dostęp do programu</span>
    <h1 class="reveal-up delay-1">Dla Ciebie albo dla całego zespołu.<br /><em>Cennik dopasowuję do zakresu.</em></h1>
    <p class="ac-hero-sub reveal-up delay-2">Zamiast jednej ceny z kapelusza — krótka informacja o tym, kogo i ile osób chcesz wdrożyć, a w 24 h odsyłam konkretny cennik i warunki (raty, faktura, onboarding zespołu). Cohort live ma cenę otwartą — niżej.</p>
  </section>

  <!-- Gated tiers -->
  <section class="ac-section" style="padding-top: 24px">
    <div class="ac-price-grid" style="grid-template-columns: repeat(2, 1fr); max-width: 880px; margin: 0 auto;">
      {gatedTiers.map((t, i) => (
        <article class:list={['ac-price', `reveal-up delay-${i + 1}`, t.featured && 'featured']}>
          {t.label && <span class="ac-price-top-label">{t.label}</span>}
          <p class="ac-price-tier">{t.tier}</p>
          <p class="ac-price-period" style="margin-top:-6px">{t.sub}</p>
          <div class="ac-price-amount" style="font-size:22px">Cennik na zapytanie</div>
          <ul class="ac-price-list">
            {t.features.map(f => (
              <li><span class="ac-check">✓</span><span>{f}</span></li>
            ))}
          </ul>
          <span class="ac-btn ac-btn-primary" style="margin-top:auto;justify-content:center;opacity:0.45;cursor:default;pointer-events:none">Wkrótce dostępne</span>
        </article>
      ))}
    </div>

    <!-- Trust row -->
    <div class="reveal-up" style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:28px">
      {['12 miesięcy dostępu', '14 dni gwarancji zwrotu', '2 raty 0%', 'Faktura VAT', 'Onboarding zespołu'].map(s => (
        <span class="ac-series-chip">{s}</span>
      ))}
    </div>
  </section>

  <!-- Cohort (open price) -->
  <section class="ac-section" id="cohort-price" style="padding-top: 0">
    <p class="ac-section-eyebrow reveal-up"><span class="ac-pulse"></span>Cohort live · cena otwarta</p>
    <h2 class="reveal-up delay-1">Sześć tygodni live z grupą. 2 900 zł / osoba.</h2>
    <p class="ac-section-sub reveal-up delay-2">Jeśli wolisz format prowadzony — 6 tygodni warsztatów, office hours i case-work na własnym lejku. To jedyny tier z ceną podaną wprost, bo grupa rusza w stałym rytmie. Termin ustalany pod zebraną grupę.</p>
    <div class="reveal-up delay-3" style="display:flex;gap:12px;flex-wrap:wrap">
      <a href="/cohort" class="ac-btn ac-btn-primary">Zobacz program cohortu →</a>
      <a href="/cohort#reservation" class="ac-btn ac-btn-ghost">Zarezerwuj miejsce</a>
    </div>
  </section>

  <!-- Coming soon notice -->
  <section class="ac-section" id="cennik" style="padding-top: 0">
    <div class="reveal-up" style="max-width:560px;margin:0 auto;text-align:center;padding:48px 32px;border:1px solid var(--border);border-radius:16px;background:var(--bg2)">
      <p style="font-size:32px;margin:0 0 16px">⏳</p>
      <p class="ac-section-eyebrow" style="margin-bottom:12px">Wkrótce</p>
      <h2 style="font-size:22px;margin:0 0 12px">Zapisy otwieramy niedługo.</h2>
      <p style="font-size:14px;color:var(--text-2);margin:0 0 24px;line-height:1.6">
        Program jest gotowy — dopinamy ostatnie szczegóły oferty. Zostaw email, żebym dał Ci znać, gdy zapisy się otworzą.
      </p>
      <form class="ac-form" data-ac-form action="/api/contact" style="text-align:left">
        <input type="hidden" name="kind" value="pricing-waitlist" />
        <div class="ac-form-row">
          <div>
            <label class="ac-form-label" for="pw-name">Imię</label>
            <input class="ac-input" id="pw-name" name="name" type="text" required autocomplete="given-name" />
          </div>
          <div>
            <label class="ac-form-label" for="pw-email">Email</label>
            <input class="ac-input" id="pw-email" name="email" type="email" required autocomplete="email" />
          </div>
        </div>
        <p class="ac-form-help">Bez spamu. Jeden email, gdy otwieramy.</p>
        {import.meta.env.PUBLIC_TURNSTILE_SITEKEY && (
          <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY} data-theme="dark"></div>
        )}
        <button type="submit" class="ac-btn ac-btn-primary" style="width:100%" data-label="Daj mi znać →">Daj mi znać →</button>
        <div class="ac-form-status" role="status" aria-live="polite"></div>
      </form>
    </div>

    <p class="reveal-up" style="margin-top:28px;font-size:13px;color:var(--text-3);text-align:center">
      Chcesz najpierw ocenić format? <a href="https://academy.wojciech.io/audio/s1e01.mp3" style="color:var(--orange)">Pierwszy odcinek (S1E01) jest otwarty ↗</a> — bez karty, bez zapisu.
    </p>
  </section>

</Layout>
