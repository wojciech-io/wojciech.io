---
import Layout from '../layouts/Layout.astro';
import CodeScene from '../components/CodeScene.astro';
import StackFlow from '../components/StackFlow.astro';
import EpisodeBrowser from '../components/EpisodeBrowser.astro';
import ModelRanker from '../components/ModelRanker.astro';
import ToolMarquee from '../components/ToolMarquee.astro';
import AudioSample from '../components/AudioSample.astro';
import LearningFlow from '../components/LearningFlow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import OutcomeBoard from '../components/OutcomeBoard.astro';

const proof = [
  { n: '20', unit: 'lat', l: 'marketingu i digitalu' },
  { n: '10', unit: 'lat', l: 'B2B SaaS growth' },
  { n: '10', unit: 'lat', l: 'GTM i revenue ops' },
  { n: '200+', unit: '',  l: 'aplikacji i systemów' },
];

const workflow = [
  { tag: '01', title: 'Wybierasz model', body: 'Nie “najlepszy model na rynku”, tylko właściwy model do zadania. Inaczej research, inaczej kod, inaczej outbound.' },
  { tag: '02', title: 'Układasz workflow', body: 'Prompt nie jest strategią. Łączysz źródła danych, model, decyzję człowieka i miejsce, gdzie wynik trafia dalej.' },
  { tag: '03', title: 'Wdrażasz w stacku', body: 'Claude, Clay, Pipedrive, n8n, Notion, D1. Pracujemy na narzędziach, które da się zostawić zespołowi.' },
  { tag: '04', title: 'Mierzysz efekt', body: 'Mniej zachwytu nad outputem, więcej pytań: czy szybciej mamy SQL, lepszy brief, krótszy research, mniej ręcznej roboty.' },
];

const series = [
  { n: '1', title: 'AI jako narzędzie operatora', meta: '12 odcinków · ~5h audio',
    body: 'Od mental modelu po wybór modeli: kiedy Claude vs GPT vs lokalny, jak nie palić tokenów, gdzie kończy się demo a zaczyna produkcja.',
    chips: ['Claude', 'GPT', 'Mental models', 'Cost ops'] },
  { n: '2', title: 'Outbound jak system, nie spam', meta: '12 odcinków · ~6h audio',
    body: 'ICP → SQL quality. Buduję system, który znajduje właściwe firmy, wzbogaca dane, rozpoznaje sygnały zakupowe, kwalifikuje fit i pisze personalizację bez SDR-a.',
    chips: ['Clay', 'Pipedrive', 'Signal stack', 'ICP'] },
  { n: '3', title: 'Content jako infrastruktura',  meta: '12 odcinków · ~5h audio',
    body: 'Treść nie jako kalendarz publikacji, ale jako asset dystrybucji i zaufania. Pipeline od research → draft → publikacja → loop SEO/social/email — całość operowana przez AI z człowiekiem na końcu.',
    chips: ['LLM workflows', 'SEO', 'Distribution', 'Repurposing'] },
  { n: '4', title: 'Operating system dla GTM',     meta: '12 odcinków · ~6h audio',
    body: 'Spinanie wszystkiego w jeden operacyjny system: dashboardy z D1, scoring, automatyzacje, agenty MCP, ownership rytmów. AI nie jako warstwa, ale jako codzienna praktyka teamu.',
    chips: ['MCP agents', 'Dashboards', 'Scoring', 'Team rhythm'] },
];

// Opinie — TYLKO prawdziwe. Pusta do pierwszego cohortu; zero zmyślonych
// cytatów (CLAUDE.md). Dodajesz wpis: { quote, name, role }.
const testimonials: { quote: string; name: string; role: string }[] = [];
---
<Layout>

  <!-- Hero -->
  <section class="ac-hero ac-hero-coded">
    <span class="ac-hero-eyebrow reveal-up">Program wdrożenia AI · dla ludzi, którzy robią GTM</span>
    <h1 class="reveal-up delay-1">Naucz zespół AI od praktyka. <br /><em>Nie od slajdów.</em></h1>
    <p class="ac-hero-sub reveal-up delay-2">
      36 krótkich odcinków o tym, jak używać AI w marketingu, sprzedaży
      i pracy founderów B2B. Nie uczysz się nazw narzędzi. Składasz procesy:
      research, scoring, outbound, content, dashboardy i pliki, które można
      oddać zespołowi.
    </p>
    <div class="ac-hero-ctas reveal-up delay-3">
      <a href="#sample" class="ac-btn ac-btn-primary">Posłuchaj za darmo →</a>
      <a href="#program" class="ac-btn ac-btn-ghost">Zobacz program</a>
    </div>

    <div class="ac-proof reveal-zoom delay-4">
      {proof.map(({ n, unit, l }) => {
        const numeric = parseInt(n.replace(/\D/g, ''), 10);
        const suffix = n.includes('+') ? '+' : '';
        return (
          <div class="ac-proof-cell">
            <div class="ac-proof-n"><span data-count-target={numeric} data-count-suffix={suffix}>0</span>{unit && <span>{unit}</span>}</div>
            <p class="ac-proof-l">{l}</p>
          </div>
        );
      })}
    </div>

    <ModelRanker />
    <CodeScene />
    <ToolMarquee />
  </section>

  <AudioSample />
  <LearningFlow />
  <FeatureGrid />
  <OutcomeBoard />

  <!-- How it works -->
  <section class="ac-section" id="workflow">
    <p class="ac-section-eyebrow reveal-up">System pracy</p>
    <h2 class="reveal-up delay-1">Nie chodzi o to, żeby znać więcej narzędzi. Chodzi o to, żeby przestać robić AI na wyczucie.</h2>
    <p class="ac-section-sub reveal-up delay-2">Program prowadzi od wyboru modelu do procesów, które ktoś w firmie może powtarzać. Każdy blok kończy się konkretną decyzją albo artefaktem, nie inspiracją do zapisania w Notion.</p>

    <div class="ac-workflow-grid">
      {workflow.map(({ tag, title, body }, i) => (
        <article class={`ac-card reveal-up delay-${i + 1}`}>
          <span class="ac-card-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="ac-card-tag">Krok {tag}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>

    <!-- Pipeline the program builds -->
    <p class="reveal-up" style="margin:56px 0 6px;font-size:13px;font-weight:600;color:var(--text-2);text-align:center">Pipeline, który składasz przez 4 serie:</p>
    <StackFlow />
  </section>

  <!-- Program -->
  <section class="ac-section" id="program">
    <p class="ac-section-eyebrow reveal-up">Program</p>
    <h2 class="reveal-up delay-1">4 serie. 36 odcinków. Zero waty.</h2>
    <p class="ac-section-sub reveal-up delay-2">Możesz przerobić jedną serię albo cały program. W każdym module jest audio, quiz i materiał do użycia od razu po odcinku.</p>

    <div class="ac-series-grid">
      {series.map(({ n, title, meta, body, chips }, i) => (
        <article class={`ac-series reveal-up delay-${(i % 2) + 1}`}>
          <div class="ac-series-head">
            <div class="ac-series-num">{n}</div>
            <div>
              <h3>{title}</h3>
              <p class="ac-series-meta">Seria {n} · {meta}</p>
            </div>
          </div>
          <p class="ac-series-body">{body}</p>
          <div class="ac-series-foot">
            {chips.map(c => <span class="ac-series-chip">{c}</span>)}
          </div>
        </article>
      ))}
    </div>

    <!-- Episode browser mockup -->
    <div style="margin-top:48px">
      <EpisodeBrowser />
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="ac-section" id="pricing">
    <p class="ac-section-eyebrow reveal-up">Dostęp</p>
    <h2 class="reveal-up delay-1">Najpierw sprawdzasz format. Potem wybierasz dostęp.</h2>
    <p class="ac-section-sub reveal-up delay-2">Dla jednej osoby i zespołu cennik dobieram do zakresu. Cohort live ma cenę otwartą, bo to konkretna grupa i konkretna praca na procesach uczestników.</p>

    <div class="ac-workflow-grid ac-pricing-teaser-grid">
      <a href="/pricing#cennik" class="ac-card reveal-up delay-1" style="display:block"><span class="ac-card-tag">Dla Ciebie</span><h3>Cennik na zapytanie</h3><p>Dostęp do programu, Vault i certyfikat. Dla osoby, która chce poukładać własny warsztat.</p></a>
      <a href="/pricing#cennik" class="ac-card reveal-up delay-2" style="display:block"><span class="ac-card-tag">Dla zespołu</span><h3>Cennik na zapytanie</h3><p>Ten sam język pracy dla marketingu, sprzedaży i founderów. Z wdrożeniem, nie samym dostępem.</p></a>
      <a href="/cohort" class="ac-card reveal-up delay-3" style="display:block"><span class="ac-card-tag"><span class="ac-pulse"></span>Cohort live</span><h3>2 900 zł / os.</h3><p>6 tygodni live, case-work i praca na prawdziwych procesach uczestników.</p></a>
    </div>
    <div style="text-align:center;margin-top:32px" class="reveal-up">
      <a href="/pricing" class="ac-btn ac-btn-primary">Otrzymaj cennik →</a>
    </div>
  </section>

  <!-- Opinie — renders only when there are REAL testimonials. No empty-state
       apology copy on a live page; fill the `testimonials` array to enable. -->
  {testimonials.length > 0 && (
    <section class="ac-section" id="opinie">
      <p class="ac-section-eyebrow reveal-up">Opinie</p>
      <h2 class="reveal-up delay-1">Co mówią uczestnicy.</h2>
      <div class="ac-workflow-grid">
        {testimonials.map(t => (
          <article class="ac-card reveal-up">
            <p style="font-size:16px;line-height:1.55;color:var(--text-1)">„{t.quote}"</p>
            <p style="margin-top:14px;font-size:13px;color:var(--text-3)"><strong style="color:var(--text-2)">{t.name}</strong> · {t.role}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <div class="ac-cta reveal-zoom">
    <h2>Jeśli po pierwszym odcinku nie czujesz konkretu, nie kupuj.</h2>
    <p>To ma być roboczy program dla ludzi, którzy muszą dowieźć marketing, sprzedaż albo content. Nie kolekcja ciekawostek o AI.</p>
    <a href="#sample" class="ac-btn ac-btn-primary">Wróć do próbki audio →</a>
  </div>

</Layout>
