---
import Layout from '../layouts/Layout.astro';
import CodeScene from '../components/CodeScene.astro';

const proof = [
  { n: '20', unit: 'lat', l: 'marketingu i digitalu' },
  { n: '10', unit: 'lat', l: 'B2B SaaS growth' },
  { n: '10', unit: 'lat', l: 'GTM i revenue ops' },
  { n: '200+', unit: '',  l: 'aplikacji i systemów' },
];

const workflow = [
  { tag: 'Step 01', title: 'Diagnoza', body: 'Audyt jak twój zespół realnie używa AI. Co przyspiesza, co bawi się w demo, co duplikuje pracę.' },
  { tag: 'Step 02', title: 'Architektura', body: 'Operacyjny stos AI dla GTM: gdzie modele, gdzie agenty, gdzie automatyzacja, co zostaje człowiekiem.' },
  { tag: 'Step 03', title: 'Wdrożenie', body: 'Konkretne workflow w outbound, contencie, lifecycle, dashboardach. Nie demo — produkcyjne procesy.' },
  { tag: 'Step 04', title: 'Adopcja', body: 'Twój team używa tego codziennie. Mierzymy SQL velocity, CPL, time-to-content, nie liczbę użytych promptów.' },
];

const series = [
  { n: '1', title: 'AI jako narzędzie operatora', meta: '12 odcinków · ~5h audio',
    body: 'Od mental modelu po wybór modeli: kiedy Claude vs GPT vs lokalny, jak nie palić tokenów, gdzie kończy się demo a zaczyna produkcja.',
    chips: ['Claude', 'GPT', 'Mental models', 'Cost ops'] },
  { n: '2', title: 'Outbound jak system, nie spam', meta: '12 odcinków · ~6h audio',
    body: 'ICP → SQL quality. Buduję system, który znajduje właściwe firmy, wzbogaca dane, rozpoznaje sygnały zakupowe, kwalifikuje fit i pisze personalizację bez SDR-a.',
    chips: ['Clay', 'Pipedrive', 'Signal stack', 'ICP'] },
  { n: '3', title: 'Content jako infrastruktura',  meta: '12 odcinków · ~5h audio',
    body: 'Treść nie jako kalendarz publikacji, ale jako asset dystrybucji i zaufania. Pipeline od research → draft → publikacja → loop SEO/social/email — całość operowana przez AI z człowiekiem na końcu.',
    chips: ['LLM workflows', 'SEO', 'Distribution', 'Repurposing'] },
  { n: '4', title: 'Operating system dla GTM',     meta: '12 odcinków · ~6h audio',
    body: 'Spinanie wszystkiego w jeden operacyjny system: dashboardy z D1, scoring, automatyzacje, agenty MCP, ownership rytmów. AI nie jako warstwa, ale jako codzienna praktyka teamu.',
    chips: ['MCP agents', 'Dashboards', 'Scoring', 'Team rhythm'] },
];
---
<Layout>

  <!-- Hero -->
  <section class="ac-hero ac-hero-coded">
    <span class="ac-hero-eyebrow reveal-up">Program wdrożenia AI · zespoły GTM</span>
    <h1 class="reveal-up delay-1">Twój zespół już używa AI.<br /><em>Pytanie, czy z tego coś wynika.</em></h1>
    <p class="ac-hero-sub reveal-up delay-2">
      W większości zespołów B2B SaaS AI działa chaotycznie: każdy promptuje
      inaczej, nikt nie wie co realnie skraca czas do SQL, a budżet idzie na
      narzędzia, których nikt nie wdrożył do końca. Ten program zamienia to
      w powtarzalny proces — outbound, content, revenue ops — z konkretnymi
      playbookami, które zostają w zespole.
    </p>
    <div class="ac-hero-ctas reveal-up delay-3">
      <a href="/pricing" class="ac-btn ac-btn-primary">Zobacz formaty wdrożenia →</a>
      <a href="#program" class="ac-btn ac-btn-ghost">Co jest w środku</a>
    </div>

    <div class="ac-proof reveal-zoom delay-4">
      {proof.map(({ n, unit, l }) => {
        const numeric = parseInt(n.replace(/\D/g, ''), 10);
        const suffix = n.includes('+') ? '+' : '';
        return (
          <div class="ac-proof-cell">
            <div class="ac-proof-n"><span data-count-target={numeric} data-count-suffix={suffix}>0</span>{unit && <span>{unit}</span>}</div>
            <p class="ac-proof-l">{l}</p>
          </div>
        );
      })}
    </div>

    <CodeScene />
  </section>

  <!-- How it works -->
  <section class="ac-section" id="workflow">
    <p class="ac-section-eyebrow reveal-up">Jak to działa</p>
    <h2 class="reveal-up delay-1">Nie kolejny kurs do odhaczenia. Operacyjny system, który zostaje w zespole.</h2>
    <p class="ac-section-sub reveal-up delay-2">36 odcinków układa się w jedną ścieżkę: diagnoza → architektura → wdrożenie → adopcja. Każdy kończy się playbookiem, promptem produkcyjnym albo blueprintem workflow, który Twój zespół wdraża u siebie — nie notatkami do szuflady.</p>

    <div class="ac-workflow-grid">
      {workflow.map(({ tag, title, body }, i) => (
        <article class={`ac-card reveal-up delay-${i + 1}`}>
          <span class="ac-card-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="ac-card-tag">{tag}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Program -->
  <section class="ac-section" id="program">
    <p class="ac-section-eyebrow reveal-up">Program</p>
    <h2 class="reveal-up delay-1">4 serie · 36 odcinków · ~22 godziny audio · 100+ plików w Vault.</h2>
    <p class="ac-section-sub reveal-up delay-2">Każda seria to operacyjna ścieżka, którą realny zespół GTM przechodzi w 2-3 tygodnie. Audio do słuchania w drodze, blueprinty i prompty do implementacji w teamie.</p>

    <div class="ac-series-grid">
      {series.map(({ n, title, meta, body, chips }, i) => (
        <article class={`ac-series reveal-up delay-${(i % 2) + 1}`}>
          <div class="ac-series-head">
            <div class="ac-series-num">{n}</div>
            <div>
              <h3>{title}</h3>
              <p class="ac-series-meta">Seria {n} · {meta}</p>
            </div>
          </div>
          <p class="ac-series-body">{body}</p>
          <div class="ac-series-foot">
            {chips.map(c => <span class="ac-series-chip">{c}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Pricing teaser (full pricing on Day 2) -->
  <section class="ac-section" id="pricing">
    <p class="ac-section-eyebrow reveal-up">Cennik</p>
    <h2 class="reveal-up delay-1">Cztery sposoby na dostęp. Dla operatora, teamu, lub całej firmy.</h2>
    <p class="ac-section-sub reveal-up delay-2">Pełna tabela cen z kalkulatorem seatów, live cohort i formularzem enterprise — na osobnej stronie.</p>

    <div class="ac-workflow-grid">
      <a href="/pricing" class="ac-card reveal-up delay-1" style="display:block"><span class="ac-card-tag">Individual</span><h3>1 900 zł</h3><p>Pełny dostęp do 36 odcinków, Vault, certyfikat. Self-paced.</p></a>
      <a href="/pricing" class="ac-card reveal-up delay-2" style="display:block"><span class="ac-card-tag">Team license</span><h3>9 900 zł</h3><p>10 seatów dla zespołu GTM, team dashboard, godzina Q&amp;A.</p></a>
      <a href="/cohort" class="ac-card reveal-up delay-3" style="display:block"><span class="ac-card-tag"><span class="ac-pulse"></span>Cohort</span><h3>4 900 zł / os.</h3><p>6 tygodni live + case-work + community. Start 2026-06-15.</p></a>
      <a href="/pricing#enterprise" class="ac-card reveal-up delay-4" style="display:block"><span class="ac-card-tag">Enterprise</span><h3>od 39 900 zł</h3><p>Custom curriculum, onsite/zdalnie, konsultacja architektury.</p></a>
    </div>
    <div style="text-align:center;margin-top:32px" class="reveal-up">
      <a href="/pricing" class="ac-btn ac-btn-primary">Pełny cennik →</a>
    </div>
  </section>

  <!-- CTA -->
  <div class="ac-cta reveal-zoom">
    <h2>Zanim wpiszesz zespół, posłuchaj sam.</h2>
    <p>Pierwszy odcinek (S1E01 — wybór modelu pod konkretny task) jest otwarty. Bez karty, bez zapisu. Cały odcinek + plik bonusowy, żebyś ocenił format zanim zdecydujesz dla teamu.</p>
    <a href="https://academy.wojciech.io/audio/s1e01.mp3" class="ac-btn ac-btn-primary">Posłuchaj S1E01 ↗</a>
  </div>

</Layout>
