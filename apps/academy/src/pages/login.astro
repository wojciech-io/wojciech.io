---
import Layout from '../layouts/Layout.astro';
const next = Astro.url.searchParams.get('next') || '/app';
---
<Layout title="Login · AI Growth OS Academy" description="Magic-link login do panelu AI Growth OS Academy.">
  <section class="ac-login-wrap">
    <div class="ac-login-visual" aria-hidden="true">
      <div class="ac-login-orb"></div>
      <div class="ac-login-console">
        <span>academy.auth()</span>
        <span>{'{'}</span>
        <span>&nbsp;&nbsp;method: "magic_link",</span>
        <span>&nbsp;&nbsp;access: "member_area",</span>
        <span>&nbsp;&nbsp;expires: "30min"</span>
        <span>{'}'}</span>
      </div>
    </div>
    <form class="ac-form ac-login-card" data-login-form action="/api/auth">
      <input type="hidden" name="next" value={next} />
      <p class="ac-section-eyebrow">Mam dostęp</p>
      <h1>Wejdź do panelu Academy.</h1>
      <p>Wpisz email użyty przy zakupie. Jeśli dostęp jest aktywny, dostaniesz jednorazowy link do panelu z odcinkami, vaultem i materiałami.</p>
      <label class="ac-form-label">Email</label>
      <input class="ac-input" name="email" type="email" required autocomplete="email" />
      <button type="submit" class="ac-btn ac-btn-primary" data-label="Wyślij link do panelu">Wyślij link do panelu</button>
      <div class="ac-form-status"></div>
      <div class="ac-login-actions">
        <a href="/cohort#checkout">Kup miejsce w cohorcie</a>
        <a href="/pricing#cennik">Poproś o cennik dla zespołu</a>
      </div>
    </form>
  </section>
</Layout>
