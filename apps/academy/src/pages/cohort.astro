---
import Layout from '../layouts/Layout.astro';

const weeks = [
  { title: 'Mental model i wybór modelu', body: 'Kiedy Claude vs GPT vs lokalny model. Kalkulacja kosztów per task, prompty produkcyjne vs demo, ustawianie własnej "AI baseline" dla teamu.' },
  { title: 'Outbound jako system',         body: 'Clay + Pipedrive + signal stack. ICP → enrichment → scoring → personalizacja. Praca na waszym CRM, nie zabawka. Kończymy działającym pipeline.' },
  { title: 'Content jako infrastruktura',  body: 'Research → draft → publikacja → loop. Dystrybucja przez SEO/social/email. AI w roli edytora, nie autora. Repurposing 1 → 8 formatów.' },
  { title: 'Revenue ops i dashboardy',     body: 'D1, scoring leadów, weekly review na 1 ekranie. Operator wie co odpada, co wraca, co skaluje. Budujemy waszą wersję GrowthHub w realnym tempie.' },
  { title: 'MCP agents w operacji',        body: 'Custom agenty pod wasze workflow: research, outreach, internal Q&A. Co realnie zostawiacie ludziom, a co automatyzujecie.' },
  { title: 'Adopcja i rytm teamu',         body: 'Jak utrwalić te narzędzia w codziennej praktyce. Rytmy review, ownership, mierzenie ROI (SQL velocity, time-to-content, CPL). Cert na koniec.' },
];

const cohortSize = 18;
---
<Layout title="Cohort · AI Growth OS · Academy" description="Live cohort — 6 tygodni, case-work na waszym lejku. Termin po zebraniu grupy. Limit 18 osób.">

  <section class="ac-hero" style="padding-bottom: 60px">
    <span class="ac-hero-eyebrow reveal-up"><span class="ac-pulse"></span>Cohort #1 · lista zainteresowanych otwarta</span>
    <h1 class="reveal-up delay-1">Sześć tygodni live.<br /><em>Twoje konto. Twój lejek. Mój kod.</em></h1>
    <p class="ac-hero-sub reveal-up delay-2">
      Nie kolejna lista live'ów do nadrobienia weekendem. Co tydzień jedna godzina warsztatów, druga office hours, i case-work na waszym własnym CRM. Wychodzicie z systemem, nie ze slajdami.
    </p>
    <div class="ac-hero-ctas reveal-up delay-3">
      <a href="#waitlist" class="ac-btn ac-btn-primary">Dołącz do listy →</a>
      <a href="/pricing" class="ac-btn ac-btn-ghost">Pozostałe formaty</a>
    </div>
  </section>

  <section class="ac-section" style="padding-top: 0">
    <div class="ac-cohort-grid">
      <aside class="ac-cohort-date reveal-zoom">
        <p class="ac-cohort-month">Termin</p>
        <p class="ac-cohort-day" style="font-size:32px;line-height:1.1;margin:10px 0">wkrótce</p>
        <span class="ac-cohort-tag">Rusza po zebraniu grupy</span>
        <p style="margin-top: 18px; font-size: 12px; color: var(--text-3); line-height: 1.55">
          Wtorki 19:00 CEST · 6 tygodni<br />
          Office hours: środy 18:00<br />
          Discord 24/7 dla cohortu
        </p>
        <div style="margin-top: 18px; padding-top: 18px; border-top: 1px dashed var(--border)">
          <p style="font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 4px;">Limit grupy</p>
          <p style="font-size: 28px; font-weight: 800; color: var(--orange); margin: 0;">
            <span data-count-target={cohortSize}>{cohortSize}</span> osób
          </p>
          <p style="font-size: 11px; color: var(--text-3); margin: 6px 0 0;">2 900 zł / osoba</p>
        </div>
      </aside>

      <div class="ac-cohort-weeks">
        {weeks.map((w, i) => (
          <article class="ac-week reveal-up" style={`transition-delay: ${i * 60}ms`}>
            <div class="ac-week-num">W{i + 1}</div>
            <div>
              <h4>{w.title}</h4>
              <p>{w.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Reservation -->
  <section class="ac-section" id="reservation" style="padding-top: 0">
    <div class="ac-checkout-shell reveal-up">
      <div>
        <p class="ac-section-eyebrow">Wstępna rezerwacja</p>
        <h2>Zarezerwuj miejsce bez płatności.</h2>
        <p class="ac-section-sub" style="margin-bottom:0">
          Zostaw kontakt i krótki kontekst. Gdy grupa będzie gotowa, dostaniesz termin, finalne warunki i dopiero wtedy decyzję o płatności. Bez karty teraz, bez automatu, bez presji.
        </p>
      </div>
      <form class="ac-form ac-checkout-form" data-ac-form action="/api/contact">
        <input type="hidden" name="kind" value="cohort-reservation" />
        <div>
          <label class="ac-form-label" for="res-name">Imię i nazwisko</label>
          <input class="ac-input" id="res-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div>
          <label class="ac-form-label" for="res-email">Email</label>
          <input class="ac-input" id="res-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label class="ac-form-label" for="res-brief">Co chcesz wdrożyć w trakcie cohortu?</label>
          <textarea class="ac-textarea" id="res-brief" name="brief" placeholder="Np. outbound z Clay + Pipedrive, content workflow, scoring leadów, team adoption."></textarea>
        </div>
        <button type="submit" class="ac-btn ac-btn-primary" data-label="Zarezerwuj miejsce →">Zarezerwuj miejsce →</button>
        <p class="ac-form-help">Cena orientacyjna zostaje 2 900 zł / osoba. Płatność dopracujemy na końcu, gdy termin i grupa będą potwierdzone.</p>
        <div class="ac-form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <!-- Waitlist -->
  <section class="ac-section" id="waitlist" style="padding-top: 0">
    <p class="ac-section-eyebrow reveal-up">Lista zainteresowanych</p>
    <h2 class="reveal-up delay-1">Grupa {cohortSize} osób · 2 900 zł / osoba.</h2>
    <p class="ac-section-sub reveal-up delay-2">
      Cohort rusza, gdy zbierze się grupa — wpisz email, a dam Ci znać z wyprzedzeniem o terminie i wyślę link do zapisu. Bez zobowiązania. Pierwszeństwo wejścia mają osoby z listy.
    </p>

    <form class="ac-form reveal-up delay-3" data-ac-form action="/api/contact">
      <input type="hidden" name="kind" value="cohort" />
      <div class="ac-form-row">
        <div>
          <label class="ac-form-label" for="wl-name">Imię</label>
          <input class="ac-input" id="wl-name" name="name" type="text" required autocomplete="given-name" />
        </div>
        <div>
          <label class="ac-form-label" for="wl-email">Email</label>
          <input class="ac-input" id="wl-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>
      <div>
        <label class="ac-form-label" for="wl-company">W którym B2B SaaS pracujesz? (opcjonalne)</label>
        <input class="ac-input" id="wl-company" name="company" type="text" placeholder="np. Acme SaaS, Head of Demand Gen" />
      </div>
      <p class="ac-form-help">Bez spamu. Dam znać z wyprzedzeniem o terminie i wyślę link do zapisu, gdy grupa będzie gotowa.</p>
      {import.meta.env.PUBLIC_TURNSTILE_SITEKEY && (
        <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY} data-theme="dark"></div>
      )}
      <button type="submit" class="ac-btn ac-btn-primary" data-label="Zapisz mnie →">Zapisz mnie →</button>
      <div class="ac-form-status" role="status" aria-live="polite"></div>
    </form>
  </section>

</Layout>
