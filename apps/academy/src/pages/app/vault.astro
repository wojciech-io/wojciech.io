---
import AppLayout from '../../layouts/AppLayout.astro';
import { vaultItems } from '../../lib/academy-content';
---
<AppLayout title="Vault · AI Growth OS Academy">
  <section class="ac-app-hero compact">
    <div>
      <p class="ac-app-kicker">Vault</p>
      <h1>Pliki, które zostają w operacji.</h1>
      <p>Prompty, scorecardy, blueprinty i worksheety. Wszystko ułożone pod wdrożenie w zespole, nie pod ładną biblioteczkę.</p>
    </div>
  </section>

  <section class="ac-vault-grid">
    {vaultItems.map((item, index) => (
      <article class="ac-vault-card" style={`transition-delay:${index * 50}ms`}>
        <span>{item.tag}</span>
        <h2>{item.title}</h2>
        <p>{item.meta}</p>
        <button>Pobierz</button>
      </article>
    ))}
  </section>
</AppLayout>
