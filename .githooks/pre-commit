#!/usr/bin/env bash
# Pre-commit guard: blocks internal tooling dirs AND runs the content-guard
# privacy + quality scan on staged files.

set -euo pipefail

BLOCKED_PATHS=(
  "docs/"
  ".agent-reports/"
  ".agent-state/"
  ".claude/"
  ".codex-tasks/"
  "archive/insights-legacy/"
  "templates/"
  "prompts/"
  "HANDOFF.md"
)

STAGED=$(git diff --cached --name-status 2>/dev/null | awk '$1 ~ /^R/ { print $3; next } $1 != "D" { print $2 }' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

# 1. Block sensitive internal dirs
FOUND=""
for path in "${BLOCKED_PATHS[@]}"; do
  if echo "$STAGED" | grep -q "^${path}"; then
    FOUND="${FOUND} ${path}"
  fi
done

if [ -n "$FOUND" ]; then
  echo ""
  echo "  BLOCKED: sensitive internal dirs staged for commit:"
  echo "  $FOUND"
  echo ""
  echo "  Remove from staging: git restore --staged <path>"
  echo ""
  exit 1
fi

# 2. Run content-guard on staged files (privacy + quality scan)
REPO_ROOT="$(git rev-parse --show-toplevel)"
GUARD="${REPO_ROOT}/scripts/content-guard.sh"

if [ -x "$GUARD" ]; then
  "$GUARD" --staged
fi

exit 0
