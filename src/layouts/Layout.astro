---
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import OutboundTelemetry from '@wojciech/ui/components/OutboundTelemetry.astro';
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  htmlLang?: string;
  ogLocale?: string;
  alternates?: Array<{ lang: string; href: string }>;
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  type,
  htmlLang = 'en',
  ogLocale,
  alternates,
  publishedAt,
  updatedAt,
  schema,
} = Astro.props;

// Normalize /en/* canonical to /* (strip /en/ prefix for dedup)
const resolvedCanonical = canonical ?? Astro.url.pathname.replace(/^\/en(\/|$)/, (_, s) => s || '/');

// hreflang + og:locale alternates are emitted centrally by SEOHead
// (single source of truth, restricted to actually-localized pages).
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      (function() {
        try {
          var t = localStorage.getItem('theme');
          var d = document.documentElement;
          if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            d.dataset.theme = 'dark';
            d.style.colorScheme = 'dark';
          } else {
            d.dataset.theme = 'light';
            d.style.colorScheme = 'light';
          }
        } catch(_) {}
      })();
    </script>
    <!-- Cross-subdomain language: write the same cookie subscribe/app/academy read. -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname || '/';
          var seg = path.split('/').filter(Boolean)[0] || '';
          var known = ['en','pl','it','de','dk','no','jp','es'];
          var lang = known.indexOf(seg) >= 0 ? seg : 'en';
          var host = location.hostname;
          if (!host || host === 'localhost' || /^\d+\.\d+\.\d+\.\d+$/.test(host)) {
            try { localStorage.setItem('appLang', lang); } catch (_) {}
            return;
          }
          var domain = host.endsWith('wojciech.io') ? '.wojciech.io' : '.' + host.split('.').slice(-2).join('.');
          var secure = location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = 'wio_lang=' + lang + '; Path=/; Max-Age=31536000; SameSite=Lax; Domain=' + domain + secure;
        } catch (_) {}
      })();
    </script>
    <SEOHead
      title={title}
      description={description}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      ogLocale={ogLocale}
      alternates={alternates}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      schema={schema}
    />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-[var(--radius-btn)] focus:bg-[var(--color-accent)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[var(--color-accent-text)] focus:outline-none"
    >Skip to content</a>
    <Header />
    <main id="main-content" class="flex-1" transition:animate="fade" data-pagefind-body>
      <slot />
    </main>
    <Footer data-pagefind-ignore />
    <CookieBanner />
    <OutboundTelemetry />

    <!-- Analytics: GA4 + Mixpanel + PostHog, loaded only after consent -->
    <script>
      const GA_ID = 'G-4ED804XJLP';
      const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined;
      const hasAnalyticsConsent = () => localStorage.getItem('cookie-consent') === 'accepted';
      let analyticsModule: Promise<typeof import('../utils/mixpanel')> | null = null;
      let googleAnalyticsLoaded = false;
      let postHogLoaded = false;

      const initGoogleAnalytics = () => {
        if (googleAnalyticsLoaded) return;
        googleAnalyticsLoaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(script);

        const w = window as typeof window & {
          dataLayer?: unknown[];
          gtag?: (...args: unknown[]) => void;
        };
        w.dataLayer = w.dataLayer || [];
        w.gtag = (...args: unknown[]) => w.dataLayer?.push(args);
        w.gtag('js', new Date());
        w.gtag('config', GA_ID);
      };

      type PostHog = { init: (k: string, opts: Record<string, unknown>) => void; capture: (e: string, p?: Record<string, unknown>) => void };
      const ph = () => (window as typeof window & { posthog?: PostHog }).posthog;

      const initPostHog = () => {
        if (postHogLoaded || !PH_KEY) return;
        postHogLoaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://eu-assets.i.posthog.com/static/array.js';
        script.onload = () => {
          ph()?.init(PH_KEY, {
            api_host: 'https://eu.i.posthog.com',
            person_profiles: 'identified_only',
            autocapture: false,
            capture_pageview: false,
          });
        };
        document.head.appendChild(script);
      };

      const loadAnalytics = async () => {
        if (!hasAnalyticsConsent()) return null;
        initGoogleAnalytics();
        initPostHog();
        analyticsModule ??= import('../utils/mixpanel');
        const analytics = await analyticsModule;
        analytics.initAfterConsent();
        return analytics;
      };

      const trackCurrentPage = () => {
        loadAnalytics().then((analytics) => {
          analytics?.trackPageViewed({
            path: window.location.pathname,
            title: document.title,
          });
          ph()?.capture('$pageview', { path: window.location.pathname, title: document.title });
        });
      };

      setTimeout(trackCurrentPage, 300);
      window.addEventListener('analytics-consent-accepted', trackCurrentPage, { once: true });

      window.addEventListener('wio:outbound-clicked', (event) => {
        const detail = (event as CustomEvent<{
          href?: string;
          original_href?: string;
          label?: string;
          destination_host?: string;
          source_host?: string;
          path?: string;
        }>).detail;
        if (!detail.href) return;
        loadAnalytics().then((analytics) => analytics?.trackOutboundClicked({
          href: detail.href,
          original_href: detail.original_href,
          label: detail.label,
          destination_host: detail.destination_host,
          source_host: detail.source_host,
          path: detail.path,
        }));
      });

      // Track internal CTAs tagged with data-mp-cta globally via event delegation
      document.addEventListener('click', (e) => {
        const a = (e.target as Element)?.closest('a');
        if (!a) return;
        const href = a.getAttribute('href') ?? '';

        // Internal CTAs tagged with data-mp-cta
        const cta = a.dataset.mpCta;
        if (cta) {
          const location = a.dataset.mpLocation ?? 'unknown';
          if (cta === 'newsletter') {
            loadAnalytics().then((analytics) => analytics?.trackNewsletterCtaClicked({ location }));
          } else {
            loadAnalytics().then((analytics) => analytics?.trackCtaClicked({ label: cta, href, location }));
          }
        }
      });
    </script>

    <!-- Scroll-triggered reveal via native IntersectionObserver.
         Re-registers on every View Transitions navigation (astro:page-load). -->
    <script>
      const REVEAL_SEL = '.reveal-up, .reveal-left, .reveal-right, .reveal-scale, .reveal-blur';

      function initReveal() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll<HTMLElement>(
          REVEAL_SEL.split(', ').map(c => `${c}:not([data-revealed])`).join(', ')
        );

        if (reduced) {
          els.forEach((el) => { el.classList.add('is-visible'); el.dataset.revealed = '1'; });
          return;
        }

        const vh = window.innerHeight;
        els.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh && r.bottom > 0) { el.classList.add('is-visible'); el.dataset.revealed = '1'; }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-visible');
              el.dataset.revealed = '1';
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.01 },
        );

        els.forEach((el) => { if (!el.dataset.revealed) observer.observe(el); });

        // Counter-up: animate numbers when scrolled into view
        document.querySelectorAll<HTMLElement>('.metric-count:not([data-counted])').forEach((el) => {
          const target = parseInt(el.dataset.target || '0', 10);
          const suffix = el.dataset.suffix || '';
          if (reduced) { el.textContent = `${target}${suffix}`; el.dataset.counted = '1'; return; }
          el.textContent = `0${suffix}`;
          const cObs = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              el.dataset.counted = '1'; cObs.unobserve(el);
              const dur = 1600, start = performance.now();
              function tick(now: number) {
                const p = Math.min((now - start) / dur, 1);
                el.textContent = `${Math.round((1 - Math.pow(1 - p, 3)) * target)}${suffix}`;
                if (p < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
            });
          }, { threshold: 0.5 });
          cObs.observe(el);
        });
      }

      // Scroll progress bar
      function initScrollProgress() {
        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        if (!bar) return;
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${h > 0 ? Math.min(window.scrollY / h, 1) : 0})`;
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      initReveal();
      initScrollProgress();
      document.addEventListener('astro:page-load', () => { initReveal(); initScrollProgress(); });
    </script>

    <!-- View Transitions: theme persistence + scroll-to-top ──────────────
         Re-apply theme immediately after DOM swap so there's zero flash.
         Scroll to top with scroll-behavior forced to 'auto' so mobile Safari
         doesn't animate the jump. Single handler avoids ordering races. -->
    <script>
      function applyStoredTheme() {
        try {
          const d = document.documentElement;
          const t = localStorage.getItem('theme');
          const mode = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
          d.dataset.theme = mode;
          d.style.colorScheme = mode;
        } catch (_) {}
      }

      if (!document.documentElement.dataset.vtReady) {
        document.documentElement.dataset.vtReady = '1';

        document.addEventListener('astro:after-swap', () => {
          // 1. Re-apply theme before paint (prevents dark→light→dark flash)
          applyStoredTheme();
          // 2. Kill smooth scroll so scrollTo is truly instant
          document.documentElement.style.scrollBehavior = 'auto';
          // 3. Scroll to top
          window.scrollTo({ top: 0, behavior: 'instant' });
        });
      }
    </script>

    <!-- Lenis smooth scroll: desktop/trackpad only, destroys on View Transitions navigation -->
    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;

      function initLenis() {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        lenis = new Lenis({ duration: 1.15, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        let rafId: number;
        function raf(time: number) {
          if (!lenis) return;
          lenis.raf(time);
          rafId = requestAnimationFrame(raf);
        }
        rafId = requestAnimationFrame(raf);
        return () => cancelAnimationFrame(rafId);
      }

      initLenis();
      document.addEventListener('astro:page-load', () => {
        lenis?.destroy(); lenis = null;
        // Restore smooth scroll after transition completes
        document.documentElement.style.removeProperty('scroll-behavior');
        initLenis();
      });
      document.addEventListener('astro:before-preparation', () => {
        lenis?.destroy(); lenis = null;
      });
    </script>

    <!-- CF_BEACON_TOKEN: set PUBLIC_CF_BEACON_TOKEN in Cloudflare Pages env vars
         Get the token from CF dashboard → Analytics → Web Analytics → Add site
         (account ID: 39783e1749680bed4039662ab696c3b1) -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </body>
</html>
