---
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  type,
  publishedAt,
  updatedAt,
  schema,
} = Astro.props;

// Normalize /en/* canonical to /* (strip /en/ prefix for dedup)
const resolvedCanonical = canonical ?? Astro.url.pathname.replace(/^\/en(\/|$)/, (_, s) => s || '/');

// hreflang + og:locale alternates are emitted centrally by SEOHead
// (single source of truth, restricted to actually-localized pages).
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      schema={schema}
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-4ED804XJLP" />
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-4ED804XJLP');
        </script>
      </>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- Mixpanel: fire page_viewed after consent check has run -->
    <script>
      import { trackPageViewed } from '../utils/mixpanel';
      // CookieBanner.astro handles initAfterConsent() — we just fire the event.
      // Small delay ensures init has run before we track.
      setTimeout(() => {
        trackPageViewed({
          path: window.location.pathname,
          title: document.title,
        });
      }, 300);

      // Track outbound links + internal CTAs globally via event delegation
      import { trackOutboundClicked, trackCtaClicked, trackNewsletterCtaClicked } from '../utils/mixpanel';
      document.addEventListener('click', (e) => {
        const a = (e.target as Element)?.closest('a');
        if (!a) return;
        const href = a.getAttribute('href') ?? '';

        // Outbound
        if (href.startsWith('http') && !href.includes('wojciech.io')) {
          trackOutboundClicked({ href, label: a.textContent?.trim() || undefined });
        }

        // Internal CTAs tagged with data-mp-cta
        const cta = a.dataset.mpCta;
        if (cta) {
          const location = a.dataset.mpLocation ?? 'unknown';
          if (cta === 'newsletter') {
            trackNewsletterCtaClicked({ location });
          } else {
            trackCtaClicked({ label: cta, href, location });
          }
        }
      });
    </script>

    <!-- Scroll-triggered reveal animation -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>

    <!-- CF_BEACON_TOKEN: set PUBLIC_CF_BEACON_TOKEN in Cloudflare Pages env vars
         Get the token from CF dashboard → Analytics → Web Analytics → Add site
         (account ID: 39783e1749680bed4039662ab696c3b1) -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </body>
</html>
