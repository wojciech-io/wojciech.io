---
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  initialLang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  type,
  publishedAt,
  updatedAt,
  schema,
  initialLang,
} = Astro.props;

// Normalize /en/* canonical to /* (strip /en/ prefix for dedup)
const resolvedCanonical = canonical ?? Astro.url.pathname.replace(/^\/en(\/|$)/, (_, s) => s || '/');

// hreflang + og:locale alternates are emitted centrally by SEOHead
// (single source of truth, restricted to actually-localized pages).
---

<!doctype html>
<html lang={initialLang === 'pl' ? 'pl' : initialLang === 'it' ? 'it' : 'en'}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      schema={schema}
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-4ED804XJLP" />
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-4ED804XJLP');
        </script>
      </>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header langPrefix={initialLang === 'pl' ? '/pl' : initialLang === 'it' ? '/it' : ''} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- Scroll-triggered reveal animation -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>

    <!-- Language toggle logic -->
    <script is:inline define:vars={{ _initLang: initialLang ?? '' }}>
      window.setLang = function(l) {
        var lang = (l || 'en').toLowerCase();
        localStorage.setItem('wio_lang', lang);
        // Update active button state
        document.querySelectorAll('.lang-btn').forEach(function(btn) {
          var active = btn.getAttribute('data-lang') === lang;
          if (active) {
            btn.style.background = '#ebff00';
            btn.style.color = '#080808';
          } else {
            btn.style.background = '';
            btn.style.color = '';
          }
        });
        // Update all translatable elements (textContent)
        document.querySelectorAll('[data-pl],[data-en],[data-it]').forEach(function(el) {
          var v = el.getAttribute('data-' + lang);
          if (v === null) v = el.getAttribute('data-en');
          if (v !== null) el.textContent = v;
        });
        // Placeholder + aria-label swaps (data-placeholder-{lang}, data-aria-{lang})
        document.querySelectorAll('[data-placeholder-en],[data-placeholder-pl],[data-placeholder-it]').forEach(function(el) {
          var v = el.getAttribute('data-placeholder-' + lang);
          if (v === null) v = el.getAttribute('data-placeholder-en');
          if (v !== null) el.setAttribute('placeholder', v);
        });
        document.querySelectorAll('[data-aria-en],[data-aria-pl],[data-aria-it]').forEach(function(el) {
          var v = el.getAttribute('data-aria-' + lang);
          if (v === null) v = el.getAttribute('data-aria-en');
          if (v !== null) el.setAttribute('aria-label', v);
        });
        // Update html lang attribute
        document.documentElement.lang = lang === 'pl' ? 'pl' : lang === 'it' ? 'it' : 'en';
        // Notify dynamic scripts (e.g. scheduler) so they can re-render their
        // JS-rendered strings with the new locale.
        try { window.dispatchEvent(new CustomEvent('wio:langchange', { detail: { lang: lang } })); } catch (e) {}
      };
      // Auto-init on DOMContentLoaded
      (function() {
        var saved = localStorage.getItem('wio_lang');
        var nav = (navigator.language || '').toLowerCase();
        // URL-provided lang takes highest priority
        var detected = _initLang || saved || (nav.startsWith('pl') ? 'pl' : nav.startsWith('it') ? 'it' : 'en');
        if (_initLang) localStorage.setItem('wio_lang', _initLang); // persist URL lang
        document.addEventListener('DOMContentLoaded', function() {
          window.setLang(detected);
        });
      })();
    </script>

    <!-- CF_BEACON_TOKEN: set PUBLIC_CF_BEACON_TOKEN in Cloudflare Pages env vars
         Get the token from CF dashboard → Analytics → Web Analytics → Add site
         (account ID: 39783e1749680bed4039662ab696c3b1) -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </body>
</html>
