---
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  initialLang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  type,
  publishedAt,
  updatedAt,
  schema,
  initialLang,
} = Astro.props;

// Normalize /en/* canonical to /* (strip /en/ prefix for dedup)
const resolvedCanonical = canonical ?? Astro.url.pathname.replace(/^\/en(\/|$)/, (_, s) => s || '/');

// Hreflang: strip any lang prefix to get the clean path
const _cleanPath = Astro.url.pathname.replace(/^\/(en|pl|it)(\/|$)/, '/').replace(/\/\//g, '/') || '/';
// Articles are EN-only — skip /pl and /it hreflang alternates for those
const _isArticle = /^\/insights\/.+/.test(_cleanPath);
---

<!doctype html>
<html lang={initialLang === 'pl' ? 'pl' : initialLang === 'it' ? 'it' : 'en'}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      schema={schema}
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    {/* hreflang alternate links — skipped for EN-only article pages */}
    {!_isArticle && (
      <>
        <link rel="alternate" hreflang="en" href={`https://wojciech.io${_cleanPath}`} />
        <link rel="alternate" hreflang="pl" href={`https://wojciech.io/pl${_cleanPath}`} />
        <link rel="alternate" hreflang="it" href={`https://wojciech.io/it${_cleanPath}`} />
        <link rel="alternate" hreflang="x-default" href="https://wojciech.io/" />
      </>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header langPrefix={initialLang === 'pl' ? '/pl' : initialLang === 'it' ? '/it' : ''} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- Scroll-triggered reveal animation -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>

    <!-- Language toggle logic -->
    <script is:inline define:vars={{ _initLang: initialLang ?? '' }}>
      window.setLang = function(l) {
        var lang = (l || 'en').toLowerCase();
        localStorage.setItem('wio_lang', lang);
        // Update active button state
        document.querySelectorAll('.lang-btn').forEach(function(btn) {
          var active = btn.getAttribute('data-lang') === lang;
          if (active) {
            btn.style.background = '#ebff00';
            btn.style.color = '#080808';
          } else {
            btn.style.background = '';
            btn.style.color = '';
          }
        });
        // Update all translatable elements
        document.querySelectorAll('[data-pl],[data-en],[data-it]').forEach(function(el) {
          var v = el.getAttribute('data-' + lang);
          if (v === null) v = el.getAttribute('data-en');
          if (v !== null) el.textContent = v;
        });
        // Update html lang attribute
        document.documentElement.lang = lang === 'pl' ? 'pl' : lang === 'it' ? 'it' : 'en';
      };
      // Auto-init on DOMContentLoaded
      (function() {
        var saved = localStorage.getItem('wio_lang');
        var nav = (navigator.language || '').toLowerCase();
        // URL-provided lang takes highest priority
        var detected = _initLang || saved || (nav.startsWith('pl') ? 'pl' : nav.startsWith('it') ? 'it' : 'en');
        if (_initLang) localStorage.setItem('wio_lang', _initLang); // persist URL lang
        document.addEventListener('DOMContentLoaded', function() {
          window.setLang(detected);
        });
      })();
    </script>

    <!-- CF_BEACON_TOKEN: set PUBLIC_CF_BEACON_TOKEN in Cloudflare Pages env vars
         Get the token from CF dashboard → Analytics → Web Analytics → Add site
         (account ID: 39783e1749680bed4039662ab696c3b1) -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </body>
</html>
