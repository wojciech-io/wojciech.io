---
import Layout from '../layouts/Layout.astro';
import WorkContent from '../components/pages/WorkContent.astro';
import { SITE } from '../data/site';
import { localizedPageAlternates } from '../data/localizedPages';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: SITE.url + '/work/' },
  ],
};
const portfolioSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'GTM Systems & Case Studies · Wojciech Łuszczyński',
  url: SITE.url + '/work/',
  description: 'Selected AI-native GTM systems, growth architecture, and shipped products.',
  author: {
    '@type': 'Person',
    name: 'Wojciech Łuszczyński',
    url: SITE.url + '/',
  },
};
---

<Layout
  title="GTM Systems & Case Studies"
  description="Selected AI-native GTM systems, growth architecture, and shipped products. Real outcomes from operators who needed a revenue operating system, not another SaaS subscription."
  ogImage="/og/pages/work.png"
  alternates={localizedPageAlternates('work')}
  schema={[breadcrumbSchema, portfolioSchema]}
>
  <WorkContent />
</Layout>
