---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTABand from '../components/ui/CTABand.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';
import { SITE } from '../data/site';

const apps = [
  {
    name: 'Notch',
    tagline: 'macOS notch, made useful.',
    description: 'A native macOS utility that turns the MacBook notch into a live workspace: system stats, quick actions, and clipboard history in the dead space above your screen.',
    tags: 'macOS · Swift · Native',
    href: SITE.notchUrl,
    status: 'Live',
    art: 'notch',
  },
  {
    name: 'Subscribe',
    tagline: 'Newsletter built for operators.',
    description: 'GTM, AI, and growth systems, from the operator stack. Practical content, no filler. For people who build and run revenue systems.',
    tags: 'Newsletter · GTM · AI',
    href: '/subscribe',
    status: 'Live',
    art: 'subscribe',
  },
  {
    name: 'App portfolio',
    tagline: "Every tool I've shipped.",
    description: "Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem and shipped. The full catalogue lives at app.wojciech.io.",
    tags: 'Web apps · Mobile · Utilities',
    href: `${SITE.appUrl}/apps`,
    status: 'Growing',
    art: 'portfolio',
  },
];
---

<Layout
  title="Apps"
  description="Products built and shipped by Wojciech Łuszczyński: Notch, Subscribe, and the full app portfolio."
>

  <!-- Hero -->
  <section class="relative pt-24 pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <p data-en="Apps" data-pl="Aplikacje" data-it="App" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Apps</p>
      <h1 data-en="Shipped, not scoped." data-pl="Wdrozone, nie zaplanowane." data-it="Realizzato, non pianificato." class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Shipped, not scoped.
      </h1>
      <p data-en="Tools I built because the right one didn't exist. Native apps, web utilities, and a newsletter for operators who build revenue systems." data-pl="Narzędzia, które zbudowałem, bo właściwego nie było. Natywne aplikacje, narzędzia webowe i newsletter dla operatorów budujących systemy przychodowe." data-it="Strumenti che ho costruito perche quello giusto non esisteva. App native, utilita web e una newsletter per gli operatori che costruiscono sistemi di revenue." class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Tools I built because the right one didn't exist. Native apps, web utilities, and a newsletter for operators who build revenue systems.
      </p>
    </div>
  </section>

  <!-- App cards -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-3 gap-6">

        <!-- Notch -->
        <a
          href={SITE.notchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <!-- Thumbnail -->
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="8" y="8" width="104" height="64" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="42" y="8" width="36" height="14" rx="0 0 5 5" fill="var(--color-surface-2)" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="60" cy="16" r="3" fill="#EBFF00" opacity="0.9"/>
              <rect x="20" y="32" width="80" height="3" rx="1.5" fill="currentColor" opacity="0.25"/>
              <rect x="20" y="41" width="56" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
              <rect x="20" y="50" width="68" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
            </svg>
          </div>
          <!-- Body -->
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">macOS · Swift · Native</p>
              <span data-en="Live" data-pl="Żywe" data-it="Live" class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Notch</h2>
            <p data-en="macOS notch, made useful." data-pl="macOS notch, użyty dobrze." data-it="macOS notch, reso utile." class="text-sm text-[var(--color-text-muted)] mb-1">macOS notch, made useful.</p>
            <p data-en="Native macOS utility that turns the MacBook notch into a live workspace: system stats, quick actions, and clipboard history in the dead space above your screen." data-pl="Natywne narzędzie macOS, które zamienia notch MacBooka w żywy workspace: statystyki systemu, szybkie akcje i historia schowka w martwej przestrzeni nad ekranem." data-it="Utilita nativa macOS che trasforma il notch del MacBook in un workspace live: statistiche di sistema, azioni rapide e cronologia appunti nello spazio morto sopra lo schermo." class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Native macOS utility that turns the MacBook notch into a live workspace: system stats, quick actions, and clipboard history in the dead space above your screen.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              notch.wojciech.io
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Subscribe -->
        <a
          href="/subscribe"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="18" width="96" height="60" rx="5" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <path d="M12 26l48 28 48-28" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="88" cy="22" r="8" fill="#EBFF00" opacity="0.9"/>
              <text x="88" y="26" text-anchor="middle" font-size="9" font-weight="700" fill="#0a0a0a">3</text>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Newsletter · GTM · AI</p>
              <span data-en="Live" data-pl="Żywe" data-it="Live" class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Subscribe</h2>
            <p data-en="Newsletter built for operators." data-pl="Newsletter dla operatorów." data-it="Newsletter per operatori." class="text-sm text-[var(--color-text-muted)] mb-1">Newsletter built for operators.</p>
            <p data-en="GTM, AI, and growth systems from the operator stack. Practical content, no filler. For people who build and run revenue systems." data-pl="GTM, AI i systemy wzrostu ze stosu operatora. Praktyczne treści, bez wypełniacza. Dla ludzi, którzy budują i prowadzą systemy przychodowe." data-it="GTM, AI e sistemi di crescita dallo stack dell'operatore. Contenuto pratico, niente riempitivo. Per chi costruisce e gestisce sistemi di revenue." class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">GTM, AI, and growth systems from the operator stack. Practical content, no filler. For people who build and run revenue systems.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              wojciech.io/subscribe
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- App portfolio -->
        <a
          href={`${SITE.appUrl}/apps`}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="12" y="44" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="44" width="44" height="30" rx="4" fill="#EBFF00" fill-opacity="0.12" stroke="#EBFF00" stroke-width="1.5" opacity="0.8"/>
              <path d="M78 59l5 5 9-9" stroke="#EBFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Web · Mobile · Utilities</p>
              <span data-en="Growing" data-pl="Rosnace" data-it="In crescita" class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] text-[var(--color-text-muted)] border border-[var(--color-border)]">Growing</span>
            </div>
            <h2 data-en="App portfolio" data-pl="Portfolio aplikacji" data-it="Portfolio app" class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">App portfolio</h2>
            <p data-en="Every tool I've shipped." data-pl="Każde narzędzie, które wdrożyłem." data-it="Ogni strumento che ho realizzato." class="text-sm text-[var(--color-text-muted)] mb-1">Every tool I've shipped.</p>
            <p data-en="Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem. The full catalogue lives at app.wojciech.io." data-pl="Działka+, Paczka+, Resume+ i inne. Małe, skupione aplikacje zbudowane, by rozwiązać konkretny problem. Pełny katalog żyje na app.wojciech.io." data-it="Dzialka+, Paczka+, Resume+ e altro. Piccole app mirate costruite per risolvere un problema specifico. Il catalogo completo vive su app.wojciech.io." class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem. The full catalogue lives at app.wojciech.io.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              app.wojciech.io/apps
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- What I build and why -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <SectionHeader
          eyebrow="The operator approach"
          eyebrowPl="Podejście operatora"
          eyebrowIt="L'approccio operatore"
          heading="If the tool doesn't exist, I ship it."
          headingPl="Jeśli narzędzie nie istnieje, wdrażam je."
          headingIt="Se lo strumento non esiste, lo realizzo."
          lead="Every app here started as a gap in my own workflow. I build what's missing, instrument it, and make it available. Operator-grade, not demo-grade."
          leadPl="Każda aplikacja tutaj zaczęła się jako luka w moim własnym workflow. Buduję to, czego brakuje, instrumentuję to i udostępniam. Klasa operatorska, nie klasa demo."
          leadIt="Ogni app qui ha iniziato come un vuoto nel mio workflow. Costruisco cio che manca, lo strumento e lo rendo disponibile. Qualita operatore, non demo."
        />
        <div class="space-y-5 pt-2">
          {[
            { en: 'Built with production constraints, not showcase polish', pl: 'Zbudowane z ograniczeniami produkcyjnymi, nie połyskiem showcase', it: 'Costruito con vincoli di produzione, non lucidatura showcase' },
            { en: 'Native where native matters: Swift for macOS, not Electron', pl: 'Natywne gdy natywność ma znaczenie: Swift dla macOS, nie Electron', it: 'Nativo dove il nativo conta: Swift per macOS, non Electron' },
            { en: 'Designed to solve exactly one problem well', pl: 'Zaprojektowane, by dobrze rozwiązać dokładnie jeden problem', it: 'Progettato per risolvere esattamente un problema bene' },
            { en: 'Shipped when good, iterated after. Not after a 6-month roadmap.', pl: 'Wdrożone gdy dobre, iterowane później. Nie po 6-miesięcznym roadmapie.', it: 'Realizzato quando pronto, iterato dopo. Non dopo una roadmap di 6 mesi.' },
          ].map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              <p data-en={item.en} data-pl={item.pl} data-it={item.it} class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item.en}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse at 20% 50%, rgba(235,255,0,0.04) 0%, transparent 60%);" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/40 to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p data-en="Next step" data-pl="Następny krok" data-it="Prossimo passo" class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Next step</p>
        <h2 data-en="Need the full app workspace?" data-pl="Potrzebujesz pełnego workspace aplikacji?" data-it="Hai bisogno del workspace app completo?" class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
          Need the full app workspace?
        </h2>
        <p data-en="The canonical catalogue, CV, stack, and contact flows live in the app workspace. This page is the public bridge from wojciech.io." data-pl="Kanoniczny katalog, CV, stack i przeplyw kontaktu zyjа w workspace aplikacji. Ta strona to publiczny most z wojciech.io." data-it="Il catalogo canonico, CV, stack e flussi di contatto vivono nel workspace app. Questa pagina e il ponte pubblico da wojciech.io." class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          The canonical catalogue, CV, stack, and contact flows live in the app workspace. This page is the public bridge from wojciech.io.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={SITE.appUrl} target="_blank" rel="noopener noreferrer" data-en="Open app workspace" data-pl="Otwórz workspace aplikacji" data-it="Apri il workspace app" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          Open app workspace
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/contact#book-call" data-en="Book a call" data-pl="Umów rozmowę" data-it="Prenota una call" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]">
          Book a call
        </a>
      </div>
    </div>
  </section>

</Layout>
