---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTABand from '../components/ui/CTABand.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';
import { SITE } from '../data/site';

const apps = [
  {
    name: 'Notch',
    tagline: 'macOS notch, made useful.',
    description: 'A native macOS utility that turns the MacBook notch into a live workspace: system stats, quick actions, and clipboard history in the dead space above your screen.',
    tags: 'macOS · Swift · Native',
    href: SITE.notchUrl,
    status: 'Live',
    art: 'notch',
  },
  {
    name: 'Subscribe',
    tagline: 'Newsletter built for operators.',
    description: 'GTM, AI, and growth systems, from the operator stack. Practical content, no filler. For people who build and run revenue systems.',
    tags: 'Newsletter · GTM · AI',
    href: '/subscribe',
    status: 'Live',
    art: 'subscribe',
  },
  {
    name: 'App portfolio',
    tagline: "Every tool I've shipped.",
    description: "Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem and shipped. The full catalogue lives at app.wojciech.io.",
    tags: 'Web apps · Mobile · Utilities',
    href: `${SITE.appUrl}/apps`,
    status: 'Growing',
    art: 'portfolio',
  },
];
---

<Layout
  title="Apps"
  description="Products built and shipped by Wojciech Łuszczyński: Notch, Subscribe, and the full app portfolio."
>

  <!-- Hero -->
  <section class="relative pt-24 pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Apps</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Shipped, not scoped.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Tools I built because the right one didn't exist. Native apps, web utilities, and a newsletter for operators who build revenue systems.
      </p>
    </div>
  </section>

  <!-- App cards -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-3 gap-6">

        <!-- Notch -->
        <a
          href={SITE.notchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <!-- Thumbnail -->
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="8" y="8" width="104" height="64" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="42" y="8" width="36" height="14" rx="0 0 5 5" fill="var(--color-surface-2)" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="60" cy="16" r="3" fill="#EBFF00" opacity="0.9"/>
              <rect x="20" y="32" width="80" height="3" rx="1.5" fill="currentColor" opacity="0.25"/>
              <rect x="20" y="41" width="56" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
              <rect x="20" y="50" width="68" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
            </svg>
          </div>
          <!-- Body -->
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">macOS · Swift · Native</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Notch</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">macOS notch, made useful.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Native macOS utility that turns the MacBook notch into a live workspace: system stats, quick actions, and clipboard history in the dead space above your screen.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              notch.wojciech.io
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Subscribe -->
        <a
          href="/subscribe"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="18" width="96" height="60" rx="5" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <path d="M12 26l48 28 48-28" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="88" cy="22" r="8" fill="#EBFF00" opacity="0.9"/>
              <text x="88" y="26" text-anchor="middle" font-size="9" font-weight="700" fill="#0a0a0a">3</text>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Newsletter · GTM · AI</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Subscribe</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Newsletter built for operators.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">GTM, AI, and growth systems from the operator stack. Practical content, no filler. For people who build and run revenue systems.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              wojciech.io/subscribe
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- App portfolio -->
        <a
          href={`${SITE.appUrl}/apps`}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(235,255,0,0.07) 0%, transparent 70%);"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="12" y="44" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="44" width="44" height="30" rx="4" fill="#EBFF00" fill-opacity="0.12" stroke="#EBFF00" stroke-width="1.5" opacity="0.8"/>
              <path d="M78 59l5 5 9-9" stroke="#EBFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Web · Mobile · Utilities</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] text-[var(--color-text-muted)] border border-[var(--color-border)]">Growing</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">App portfolio</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Every tool I've shipped.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem. The full catalogue lives at app.wojciech.io.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              app.wojciech.io/apps
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- What I build and why -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <SectionHeader
          eyebrow="The operator approach"
          heading="If the tool doesn't exist, I ship it."
          lead="Every app here started as a gap in my own workflow. I build what's missing, instrument it, and make it available. Operator-grade, not demo-grade."
        />
        <div class="space-y-5 pt-2">
          {[
            'Built with production constraints, not showcase polish',
            'Native where native matters: Swift for macOS, not Electron',
            'Designed to solve exactly one problem well',
            'Shipped when good, iterated after. Not after a 6-month roadmap.',
          ].map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading="Need the full app workspace?"
    subtext="The canonical catalogue, CV, stack, and contact flows live in the app workspace. This page is the public bridge from wojciech.io."
    cta="Open app workspace"
    ctaHref={SITE.appUrl}
    ctaSecondary="Book a call"
    ctaSecondaryHref="/contact#book-call"
  />

</Layout>
