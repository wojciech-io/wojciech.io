---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import { SITE } from '../data/site';

type IconName = 'github' | 'download' | 'guide' | 'stack' | 'apps' | 'newsletter';

interface Resource {
  title: string;
  description: string;
  tags: string[];
  href: string;
  label: string;
  external: boolean;
  icon: IconName;
  download?: boolean;
}

// Inline icon paths (Lucide-style, 24x24, stroke=currentColor). One per resource
// type so every card has an elegant, consistent visual anchor.
const icons: Record<IconName, string> = {
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  guide:
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  stack:
    '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  apps:
    '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  newsletter:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};

const resources: Resource[] = [
  {
    title: 'Claude Code GTM Agent Starter Pack',
    description: 'CLAUDE.md template, Skills definitions, folder structure, and scoring MCP source for building an AI-powered outbound GTM agent. Built for operators who want the system, not the SaaS wrapper.',
    tags: ['Claude Code', 'MCP', 'GTM', 'AI'],
    href: 'https://github.com/wojciechluszczynski/gtm-agent-repo',
    label: 'View on GitHub',
    external: true,
    icon: 'github',
  },
  {
    title: 'Page Optimizer: a Claude Code plugin',
    description: 'Six skills that audit a landing page and ship the fixed version: copy, accessibility, WCAG contrast, responsive checks, and AI answer-engine optimisation. Free, no SaaS wrapper, no login.',
    tags: ['Claude Code', 'Landing page', 'a11y', 'SEO'],
    href: '/bites/page-optimizer.zip',
    label: 'Download the plugin',
    external: false,
    download: true,
    icon: 'download',
  },
  {
    title: 'CLAUDE.md GTM Agent Starter',
    description: 'A ready-to-use CLAUDE.md for GTM AI agents: persistent identity, ICP scoring, tone rules, and five named skills. Fill the brackets with your client data and point Claude Code at it.',
    tags: ['Claude Code', 'GTM', 'Agent', 'Template'],
    href: '/bites/claude-md-starter.zip',
    label: 'Download the template',
    external: false,
    download: true,
    icon: 'download',
  },
  {
    title: 'How to build a Claude Code GTM agent',
    description: 'Architecture breakdown of the four-layer AI outbound system: CLAUDE.md operator brief, MCP data layer, client memory files, and five named Skills. Full cost model included.',
    tags: ['Claude Code', 'GTM', 'AI', 'Guide'],
    href: '/insights/claude-code-vs-clay/',
    label: 'Read the breakdown',
    external: false,
    icon: 'guide',
  },
  {
    title: 'AI stack in production: what runs, what got cut',
    description: 'Every AI tool currently in active use across client work and products. Four layers: reasoning, execution, research, CRM. Includes the cut list, usually more useful than the keep list.',
    tags: ['AI', 'Stack', 'Tools', 'Reference'],
    href: '/insights/ai-production-stack/',
    label: 'Read the stack',
    external: false,
    icon: 'stack',
  },
  {
    title: 'Shipped apps: live reference',
    description: 'A portfolio of independently shipped apps: AdsAI, Relora, a camper rental booking engine, Notch macOS app, and mini-utilities. Practical proof of range across operator tooling, product, and native dev.',
    tags: ['Apps', 'Portfolio', 'Reference'],
    href: 'https://app.wojciech.io/apps',
    label: 'Browse the apps',
    external: true,
    icon: 'apps',
  },
  {
    title: 'Operator notes: newsletter',
    description: 'Dispatches on AI GTM systems, growth architecture, and shipped tools. When a new article or resource is ready, subscribers get it first. No cadence commitments. Only when there is something worth sending.',
    tags: ['Newsletter', 'AI', 'GTM'],
    href: 'https://subscribe.wojciech.io',
    label: 'Subscribe',
    external: true,
    icon: 'newsletter',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: SITE.url + '/resources/' },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Resources · Tools and Templates for Operators',
  url: SITE.url + '/resources/',
  itemListElement: resources.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.title,
    description: r.description,
    url: r.external ? r.href : SITE.url + r.href,
  })),
};
---

<Layout
  title="Resources · wojciech.io"
  description="Starter packs, MCP configs, and operator frameworks for AI-native GTM and growth systems. Built for people who ship."
  ogImage="/og/pages/resources.png"
  schema={[breadcrumbSchema, itemListSchema]}
>

  <!-- Header -->
  <section class="relative overflow-hidden pt-20 pb-16 border-b border-[var(--color-border)]">
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Resources</p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5 max-w-2xl">
        Tools and templates, not content.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Starter packs, MCP configs, and operator frameworks. Built for people who ship, not people who evaluate.
      </p>
    </div>
  </section>

  <!-- Resources grid -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.map(({ title, description, tags, href, label, external, download, icon }) => (
          <a
            href={href}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(download ? { download: true } : {})}
            class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 flex flex-col gap-5 hover:border-[var(--color-accent)]/40 hover:shadow-[var(--shadow-card-hover)] transition-all"
          >
            <div class="flex items-start justify-between">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-[var(--radius-badge)] border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/10 text-[var(--color-accent-hi)] group-hover:bg-[var(--color-accent)]/20 group-hover:border-[var(--color-accent)]/50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[icon]}></svg>
              </span>
              <span class="text-[var(--color-text-muted)] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {external
                    ? <><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></>
                    : <><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></>}
                </svg>
              </span>
            </div>
            <div class="flex-1">
              <h2 class="text-base font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-accent-hi)] transition-colors">{title}</h2>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{description}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">
                  {tag}
                </span>
              ))}
            </div>
            <span class="text-xs font-semibold text-[var(--color-accent-hi)] group-hover:text-[var(--color-text)] transition-colors">
              {label} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    heading="Took a template. Need it wired in?"
    subtext="The downloads are the starting point. Adapting them to your CRM, your data, and your team is the actual work."
    ctaSecondary="Read insights"
    ctaSecondaryHref="/insights/"
    portrait="/images/wojciech-cutout.webp"
  />

</Layout>
