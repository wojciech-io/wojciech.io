---
import Layout from '../layouts/Layout.astro';
import BookingScheduler from '../components/BookingScheduler.astro';
import { getMeetCopy, meetSchema } from '../data/meet';

// English scheduler at /meet. The 7 localized versions live at /[locale]/meet
// and share the BookingScheduler component. Availability + booking are served
// by /api/availability and /api/book.
//
// /contact/ embeds this same BookingScheduler, so the two pages offered search
// engines the same booking form under two URLs. /contact/ is the canonical one:
// it carries the nav entry, the hero and the email fallback, and it exists in
// Arabic too. This page stays live and unredirected because it is the short
// link worth sharing in a calendar invite, but it points its canonical at
// /contact/ and stays out of the index so the two stop competing.
const S = getMeetCopy('en');
---

<Layout
  title={S.title}
  description={S.description}
  canonical="/contact/"
  noindex
  schema={meetSchema('en')}
>
  <BookingScheduler lang="en" />
</Layout>
