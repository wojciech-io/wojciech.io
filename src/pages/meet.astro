---
import Layout from '../layouts/Layout.astro';
import { MEETING_TYPES } from '../data/booking';

// Premium own scheduler. Meeting types come from the shared booking config
// (single source of truth for the front-end AND the Pages Functions).
// Availability + booking are served by /api/availability and /api/book.
const meetingTypes = MEETING_TYPES;
---

<Layout
  title="Book a call"
  description="Book a call with Wojciech Łuszczyński. Pick a format, a day, and a slot. Growth, AI, and GTM systems for SaaS and revenue-focused teams."
>
  <section class="relative pt-10 pb-14 md:pt-14 md:pb-20 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-6">
      <!-- Hero -->
      <div class="max-w-2xl mb-10 md:mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">Book a call</span>
        </div>
        <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">
          Book a call with Wojciech.
        </h1>
        <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
          Growth, AI, and GTM systems for SaaS and revenue-focused teams. Pick the format that fits, then a slot. No pitch deck, no intro slides.
        </p>
      </div>

      <!-- Step 1: meeting type -->
      <p class="obs-label-accent mb-3 block">1 · Choose the format</p>
      <div class="grid gap-4 md:grid-cols-3 mb-10 md:mb-12" role="radiogroup" aria-label="Meeting type">
        {meetingTypes.map((m) => (
          <button
            type="button"
            role="radio"
            aria-checked={m.id === 'systems' ? 'true' : 'false'}
            data-meeting={m.id}
            data-minutes={m.minutes}
            data-name={m.name}
            class="meeting-card group text-left rounded-[var(--radius-card)] border p-5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-cta)]"
          >
            <div class="flex items-center justify-between gap-3 mb-2">
              <span class="font-semibold text-[var(--color-text)]">{m.name}</span>
              <span class="shrink-0 rounded-full border border-[var(--color-border-2)] px-2.5 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">{m.minutes} min</span>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{m.desc}</p>
          </button>
        ))}
      </div>

      <!-- Step 2 + 3: date/time + details -->
      <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <!-- Calendar + slots -->
        <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 md:p-6">
          <div class="flex items-center justify-between mb-5">
            <p class="obs-label-accent block">2 · Pick a day &amp; time</p>
            <span id="tz-note" class="font-mono text-xs text-[var(--color-text-dim)]"></span>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <!-- Month grid -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <button type="button" id="cal-prev" aria-label="Previous month" class="cal-nav">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <span id="cal-month" class="text-sm font-semibold text-[var(--color-text)]"></span>
                <button type="button" id="cal-next" aria-label="Next month" class="cal-nav">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <div class="grid grid-cols-7 gap-1 mb-1 text-center font-mono text-[10px] uppercase tracking-wider text-[var(--color-text-dim)]">
                <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
              </div>
              <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>
            </div>

            <!-- Slots -->
            <div>
              <p id="slots-label" class="text-sm font-semibold text-[var(--color-text)] mb-3">Select a day</p>
              <div id="slots" class="flex flex-col gap-2 max-h-[280px] overflow-y-auto pr-1"></div>
            </div>
          </div>
        </div>

        <!-- Details / summary -->
        <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 md:p-6">
          <p class="obs-label-accent mb-4 block">3 · Your details</p>

          <div id="summary" class="mb-5 rounded-[var(--radius-card)] border border-dashed border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-4 py-3 text-sm text-[var(--color-text-muted)]">
            Pick a format and a slot to see your booking summary here.
          </div>

          <form id="book-form" class="flex flex-col gap-3" novalidate>
            <!-- Honeypot: hidden from humans, catches bots. -->
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
              style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[var(--color-text-muted)]">Name</span>
              <input required name="name" type="text" autocomplete="name" class="field" placeholder="Jane Doe" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[var(--color-text-muted)]">Email</span>
              <input required name="email" type="email" autocomplete="email" class="field" placeholder="jane@company.com" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[var(--color-text-muted)]">Company <span class="text-[var(--color-text-dim)]">(optional)</span></span>
              <input name="company" type="text" autocomplete="organization" class="field" placeholder="Company" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[var(--color-text-muted)]">What do you want to cover? <span class="text-[var(--color-text-dim)]">(optional)</span></span>
              <textarea name="notes" rows="3" class="field resize-none" placeholder="One or two lines on the system or problem."></textarea>
            </label>
            <p id="form-error" role="alert" hidden class="text-sm text-red-600 dark:text-red-400"></p>
            <button id="confirm-btn" type="submit" disabled
              class="mt-1 inline-flex items-center justify-center rounded-[var(--radius-card)] bg-[var(--color-accent-cta)] px-6 py-3 font-semibold text-[var(--color-accent-text)] transition-opacity disabled:opacity-40 disabled:cursor-not-allowed hover:opacity-90">
              Confirm booking
            </button>
            <p class="text-center font-mono text-xs text-[var(--color-text-dim)]">
              You get a calendar invite and a confirmation email.
            </p>
          </form>

          <!-- Success state (hidden until confirmed) -->
          <div id="success" hidden class="text-center py-6">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-accent-cta)]">
              <svg class="w-6 h-6 text-[var(--color-accent-text)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12l5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="text-lg font-semibold text-[var(--color-text)] mb-1">You are booked.</p>
            <p id="success-detail" class="text-sm text-[var(--color-text-muted)]"></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .meeting-card { background: var(--color-surface); border-color: var(--color-border); }
  .meeting-card:hover { border-color: var(--color-border-2); background: var(--color-surface-2); }
  .meeting-card[aria-checked='true'] {
    border-color: var(--color-accent-cta);
    box-shadow: inset 0 0 0 1px var(--color-accent-cta);
    background: var(--color-surface);
  }
  .cal-nav {
    display: inline-flex; align-items: center; justify-content: center;
    height: 2rem; width: 2rem; border-radius: 0.375rem;
    color: var(--color-text-muted); transition: background-color .15s, color .15s;
  }
  .cal-nav:hover:not(:disabled) { background: var(--color-surface-2); color: var(--color-text); }
  .cal-nav:disabled { opacity: 0.3; cursor: default; }
  .cal-day {
    aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center;
    border-radius: 0.375rem; font-size: 0.8125rem; font-variant-numeric: tabular-nums;
    color: var(--color-text); transition: background-color .12s, color .12s;
  }
  .cal-day[data-available='1'] { cursor: pointer; font-weight: 600; }
  .cal-day[data-available='1']:hover { background: var(--color-surface-2); }
  .cal-day[data-available='0'] { color: var(--color-text-dim); opacity: 0.45; }
  .cal-day[aria-selected='true'] { background: var(--color-accent-cta); color: var(--color-accent-text); font-weight: 700; }
  .slot {
    text-align: center; border: 1px solid var(--color-border);
    border-radius: 0.375rem; padding: 0.5rem 0.75rem; font-family: var(--font-mono, monospace);
    font-size: 0.8125rem; color: var(--color-text); cursor: pointer;
    transition: border-color .12s, background-color .12s;
  }
  .slot:hover { border-color: var(--color-accent-cta); }
  .slot[aria-selected='true'] { background: var(--color-accent-cta); color: var(--color-accent-text); border-color: var(--color-accent-cta); font-weight: 600; }
  .field {
    border: 1px solid var(--color-border); border-radius: 0.375rem;
    background: var(--color-bg); padding: 0.5rem 0.75rem; color: var(--color-text); font-size: 0.875rem;
  }
  .field:focus { outline: none; border-color: var(--color-accent-cta); }
  .field::placeholder { color: var(--color-text-dim); }
</style>

<script is:inline>
  (() => {
    const FORM_LOADED = Date.now();
    const locale = document.documentElement.lang || 'en';
    const $ = (id) => document.getElementById(id);
    const pad = (n) => String(n).padStart(2, '0');

    // Intl does the i18n heavy lifting: month/day names + slot times localise to
    // the page locale and the visitor's own timezone with no translation table.
    let tz = 'UTC';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (_) {}
    const fmtMonth = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
    const fmtDay = new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric' });
    const fmtTime = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });
    const fmtSummary = new Intl.DateTimeFormat(locale, {
      weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
    });
    $('tz-note').textContent = tz === 'UTC' ? 'Local time' : 'Times in ' + tz;

    const state = { type: 'systems', minutes: 45, typeName: 'Growth & AI Systems', dateKey: null, slotIso: null };
    const byDay = new Map(); // local YYYY-MM-DD -> [utc iso, ...]
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let view = new Date(today.getFullYear(), today.getMonth(), 1);

    const localKey = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());

    async function loadAvailability() {
      byDay.clear(); state.dateKey = null; state.slotIso = null;
      $('slots-label').textContent = 'Loading…';
      $('slots').innerHTML = '<p class="text-sm text-[var(--color-text-dim)]">Loading availability…</p>';
      try {
        const res = await fetch('/api/availability?type=' + encodeURIComponent(state.type), {
          headers: { accept: 'application/json' },
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'unavailable');
        for (const iso of data.slots) {
          const key = localKey(new Date(iso));
          if (!byDay.has(key)) byDay.set(key, []);
          byDay.get(key).push(iso);
        }
        const first = data.slots[0] ? new Date(data.slots[0]) : null;
        view = first ? new Date(first.getFullYear(), first.getMonth(), 1)
                     : new Date(today.getFullYear(), today.getMonth(), 1);
        $('slots-label').textContent = 'Select a day';
        $('slots').innerHTML = '';
        renderCalendar();
      } catch (_) {
        $('slots-label').textContent = 'Select a day';
        $('slots').innerHTML = '<p class="text-sm text-[var(--color-text-dim)]">Could not load availability. Please refresh.</p>';
      }
      updateSummary();
    }

    function renderCalendar() {
      $('cal-month').textContent = fmtMonth.format(view);
      const grid = $('cal-grid');
      grid.innerHTML = '';
      const startPad = (new Date(view.getFullYear(), view.getMonth(), 1).getDay() + 6) % 7;
      const daysInMonth = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let i = 0; i < startPad; i++) grid.appendChild(document.createElement('span'));
      for (let day = 1; day <= daysInMonth; day++) {
        const d = new Date(view.getFullYear(), view.getMonth(), day);
        const key = localKey(d);
        const ok = byDay.has(key);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cal-day';
        cell.textContent = String(day);
        cell.dataset.available = ok ? '1' : '0';
        cell.dataset.key = key;
        if (!ok) cell.disabled = true;
        if (state.dateKey === key) cell.setAttribute('aria-selected', 'true');
        if (ok) cell.addEventListener('click', () => selectDay(d, key, cell));
        grid.appendChild(cell);
      }
      const atStart = view.getFullYear() === today.getFullYear() && view.getMonth() === today.getMonth();
      $('cal-prev').disabled = atStart;
    }

    function selectDay(d, key, cell) {
      state.dateKey = key; state.slotIso = null;
      document.querySelectorAll('.cal-day[aria-selected="true"]').forEach((c) => c.removeAttribute('aria-selected'));
      cell.setAttribute('aria-selected', 'true');
      $('slots-label').textContent = fmtDay.format(d);
      const wrap = $('slots');
      wrap.innerHTML = '';
      for (const iso of byDay.get(key) || []) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'slot'; b.dataset.iso = iso;
        b.textContent = fmtTime.format(new Date(iso));
        b.addEventListener('click', () => {
          state.slotIso = iso;
          document.querySelectorAll('.slot[aria-selected="true"]').forEach((s) => s.removeAttribute('aria-selected'));
          b.setAttribute('aria-selected', 'true');
          updateSummary();
        });
        wrap.appendChild(b);
      }
      updateSummary();
    }

    function updateSummary() {
      const el = $('summary');
      const btn = $('confirm-btn');
      if (state.slotIso) {
        el.innerHTML = '<span class="text-[var(--color-text)] font-semibold">' + state.typeName + '</span> · ' +
          state.minutes + ' min<br>' + fmtSummary.format(new Date(state.slotIso));
        btn.disabled = false;
      } else {
        el.textContent = state.dateKey ? 'Now pick a time slot.' : 'Pick a format and a slot to see your booking summary here.';
        btn.disabled = true;
      }
    }

    // Meeting type selection → reload availability for that duration.
    document.querySelectorAll('[data-meeting]').forEach((card) => {
      card.addEventListener('click', () => {
        document.querySelectorAll('[data-meeting]').forEach((c) => c.setAttribute('aria-checked', 'false'));
        card.setAttribute('aria-checked', 'true');
        state.type = card.dataset.meeting;
        state.minutes = Number(card.dataset.minutes);
        state.typeName = card.dataset.name;
        loadAvailability();
      });
    });

    $('cal-prev').addEventListener('click', () => { view.setMonth(view.getMonth() - 1); renderCalendar(); });
    $('cal-next').addEventListener('click', () => { view.setMonth(view.getMonth() + 1); renderCalendar(); });

    $('book-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('form-error'); err.hidden = true;
      if (!state.slotIso) return;
      const form = e.currentTarget;
      const btn = $('confirm-btn');
      btn.disabled = true; btn.textContent = 'Booking…';
      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            meetingType: state.type,
            start: state.slotIso,
            name: form.name.value,
            email: form.email.value,
            company: form.company.value,
            notes: form.notes.value,
            website: form.website.value,
            elapsed: Date.now() - FORM_LOADED,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (res.status === 409) { await loadAvailability(); }
          throw new Error(data.error || 'Something went wrong. Please try again.');
        }
        form.hidden = true;
        $('success').hidden = false;
        $('success-detail').innerHTML = state.typeName + ' · ' + state.minutes + ' min<br>' + fmtSummary.format(new Date(state.slotIso));
      } catch (ex) {
        err.textContent = ex.message; err.hidden = false;
        btn.disabled = false; btn.textContent = 'Confirm booking';
      }
    });

    loadAvailability();
  })();
</script>
