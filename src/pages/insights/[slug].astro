---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCover from '../../components/ui/ArticleCover.astro';
import Callout from '../../components/insights/Callout.astro';
import VideoEmbed from '../../components/insights/VideoEmbed.astro';
import Screenshot from '../../components/insights/Screenshot.astro';
import Compare from '../../components/insights/Compare.astro';
import Flow from '../../components/insights/Flow.astro';
import Stat from '../../components/insights/Stat.astro';
import StatCallout from '../../components/insights/StatCallout.astro';
import StatRow from '../../components/insights/StatRow.astro';
import StatGrid from '../../components/insights/StatGrid.astro';
import DoDont from '../../components/insights/DoDont.astro';
import TLDR from '../../components/insights/TLDR.astro';
import Steps from '../../components/insights/Steps.astro';
import PullQuote from '../../components/insights/PullQuote.astro';
import TechStack from '../../components/insights/TechStack.astro';
import TOC from '../../components/insights/TOC.astro';
import BeforeAfter from '../../components/insights/BeforeAfter.astro';
import Diagram from '../../components/insights/diagrams/Diagram.astro';
import Box from '../../components/insights/diagrams/Box.astro';
import Arrow from '../../components/insights/diagrams/Arrow.astro';
import Stack from '../../components/insights/diagrams/Stack.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FAQ from '../../components/ui/FAQ.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProofCard from '../../components/ui/ProofCard.astro';
import DataTable from '../../components/insights/DataTable.astro';
import MetricRow from '../../components/insights/MetricRow.astro';
import ArticleTimeline from '../../components/insights/ArticleTimeline.astro';
import KeyPoint from '../../components/insights/KeyPoint.astro';
import TwoUp from '../../components/insights/TwoUp.astro';
import Quote from '../../components/insights/Quote.astro';
import ToolCard from '../../components/insights/ToolCard.astro';
import ProcessFlow from '../../components/insights/ProcessFlow.astro';
import Grid from '../../components/insights/Grid.astro';
import ResultCard from '../../components/insights/ResultCard.astro';
import Benchmark from '../../components/insights/Benchmark.astro';
import CaseStudyBlock from '../../components/insights/CaseStudyBlock.astro';
import { SITE } from '../../data/site';

const mdxComponents = {
  Callout, VideoEmbed, Screenshot, Compare, Flow,
  Video: VideoEmbed,
  Stat, StatCallout, StatRow, StatGrid, DoDont, TLDR, Steps, PullQuote, TechStack, TOC,
  BeforeAfter,
  Diagram, Box, Arrow, Stack,
  Badge, Button, CTABand, FAQ, SectionHeader, ProofCard,
  DataTable, MetricRow, ArticleTimeline, KeyPoint, TwoUp, Quote,
  Timeline: ArticleTimeline,
  Comparison: Compare,
  ToolCard, ProcessFlow, Grid,
  ResultCard, Benchmark, CaseStudyBlock,
};

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );
  return sorted.map((post, idx) => {
    const others = sorted.filter((_, i) => i !== idx);
    // Related: same tags first, then chronological; pick top 3
    const sameTags = others.filter((p) =>
      p.data.tags.some((t) => post.data.tags.includes(t))
    );
    const related = [...new Set([...sameTags, ...others])].slice(0, 3);
    return {
      params: { slug: post.id.replace(/\.mdx?$/, '') },
      props: {
        post,
        prevPost: sorted[idx + 1] ?? null,
        nextPost: sorted[idx - 1] ?? null,
        related,
      },
    };
  });
}

const { post, prevPost, nextPost, related } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `/insights/${post.id.replace(/\.mdx?$/, '')}/`;
const slug = post.id.replace(/\.mdx?$/, '');
const ogImage = post.data.ogImage ?? `/og/${slug}.png`;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const publishedAt = post.data.publishedAt.toISOString();
const updatedAt = (post.data.updatedAt ?? post.data.publishedAt).toISOString();
const authorSchema = {
  '@type': 'Person',
  name: 'Wojciech Łuszczyński',
  alternateName: 'Wojtek Luszczynski',
  url: SITE.url + '/',
  image: 'https://www.gravatar.com/avatar/31d046a24e8df6bd8cf76fc7026d1907c48cb173ad319077f9d8f43c55f4523d?s=384&r=g',
  jobTitle: 'GTM Architect & Growth Operator',
  description: 'Growth, GTM and AI-native marketing operator building revenue systems for B2B SaaS and technology companies.',
  sameAs: [
    SITE.linkedin,
    SITE.github,
    SITE.twitter.replace('twitter.com', 'x.com'),
    SITE.substack,
    SITE.medium,
    SITE.subscribeUrl,
  ],
  knowsAbout: [
    'GTM architecture',
    'Growth marketing',
    'AI-native revenue systems',
    'Performance marketing',
    'Marketing automation',
    'CRM and RevOps',
    'SEO and content systems',
    'B2B SaaS growth',
  ],
};
const ogImageURL = new URL(ogImage, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  mainEntityOfPage: canonicalURL,
  url: canonicalURL,
  image: ogImageURL,
  inLanguage: 'en',
  keywords: post.data.tags.join(', '),
  articleSection: post.data.tags[0] ?? 'Insights',
  author: authorSchema,
  publisher: authorSchema,
  about: [
    'AI-native GTM systems',
    'growth operating models',
    'marketing automation',
    'revenue architecture',
  ],
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalURL },
  ],
};
const insightsSchema = [articleSchema, breadcrumbSchema];

---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  ogImage={ogImage}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={insightsSchema}
>
  <!-- Reading progress bar -->
  <div
    id="progress-bar"
    class="fixed top-0 left-0 z-50 h-0.5 bg-[var(--color-accent)] w-0 transition-none"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuenow={0}
    aria-valuemin={0}
    aria-valuemax={100}
  />

  <!-- Article cover: full-width, outside max-w constraint -->
  <ArticleCover coverType={post.data.coverType} tags={post.data.tags} title={post.data.title} />

  <article
    id="article-content"
    class="mx-auto max-w-3xl px-6 pt-[var(--space-section)] pb-16"
    data-slug={slug}
    data-title={post.data.title}
    data-category={post.data.category ?? ''}
    data-tags={post.data.tags.join(',')}
    data-read-time={Math.max(4, Math.ceil((post.body?.split(/\s+/).length ?? 0) / 220))}
  >

    <!-- Header -->
    <header class="mb-10">
      <a href="/insights/" class="inline-flex items-center gap-1.5 text-xs text-[var(--color-text-dim)] hover:text-[var(--color-accent)] transition-colors mb-6">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All insights
      </a>
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)]">Insight</span>
        {post.data.tags.map((tag) => (
          <span class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5" transition:name={`article-title-${slug}`}>
        {post.data.title}
      </h1>
      <p class="text-[length:var(--text-body-lg)] text-[var(--color-text-muted)] leading-relaxed mb-6">
        {post.data.description}
      </p>
      <div class="flex items-center gap-3 pb-8 border-b border-[var(--color-border)]">
        <a href="/about/" aria-label="Wojciech Łuszczyński profile">
          <img
            src="https://www.gravatar.com/avatar/31d046a24e8df6bd8cf76fc7026d1907c48cb173ad319077f9d8f43c55f4523d?s=72&r=g"
            alt="Wojciech Łuszczyński"
            width="36"
            height="36"
            loading="eager"
            decoding="async"
            class="w-9 h-9 rounded-full object-cover border-2 border-[var(--color-accent)]/40"
          />
        </a>
        <div class="min-w-0">
          <p class="text-sm font-medium text-[var(--color-text)]">
            <a href="/about/" class="hover:text-[var(--color-accent)] transition-colors">Wojciech Łuszczyński</a>
          </p>
          <p class="text-xs text-[var(--color-text-dim)]">
            GTM Architect & Growth Operator · <a href="/now/" class="hover:text-[var(--color-accent)] transition-colors">Now</a> · {post.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </div>
      </div>
    </header>

    {post.data.tldr && post.data.tldr.length > 0 && <TLDR items={post.data.tldr} />}

    <!-- Article body -->
    <div class="prose-content">
      <Content components={mdxComponents} />
    </div>

  </article>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">About the author</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <img
          src="https://www.gravatar.com/avatar/31d046a24e8df6bd8cf76fc7026d1907c48cb173ad319077f9d8f43c55f4523d?s=96&r=g"
          alt="Wojciech Łuszczyński"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
          class="w-12 h-12 rounded-full object-cover border border-[var(--color-border)]"
        />
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-text)] mb-2">Wojciech Łuszczyński</h2>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)] mb-4">
            GTM Architect and Growth Operator building AI-native revenue systems for B2B SaaS and technology companies. I connect positioning, SEO, content, paid acquisition, CRM, automation, analytics and AI workflows into practical growth infrastructure.
          </p>
          <div class="flex flex-wrap gap-2">
            <a href="/now/" class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)] hover:text-[var(--color-accent)] transition-colors">Now</a>
            <a href="/about/" class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)] hover:text-[var(--color-accent)] transition-colors">Profile</a>
            <a href="/work/" class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)] hover:text-[var(--color-accent)] transition-colors">Work</a>
            <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)] hover:text-[var(--color-accent)] transition-colors">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related articles -->
  {related && related.length > 0 && (
    <section class="border-t border-[var(--color-border)] py-12">
      <div class="mx-auto max-w-3xl px-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)] mb-6">More from insights</p>
        <div class="grid gap-3 sm:grid-cols-3">
          {related.map((rel) => {
            const relSlug = rel.id.replace(/\.mdx?$/, '');
            return (
              <a
                href={`/insights/${relSlug}/`}
                class="group flex flex-col gap-2 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4 hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-surface-2)] transition-colors"
              >
                <div class="flex flex-wrap gap-1.5 mb-1">
                  {rel.data.tags.slice(0, 2).map((tag) => (
                    <span class="text-[9px] font-semibold uppercase tracking-wider text-[var(--color-accent)] bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] border border-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] rounded px-1.5 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
                <p class="text-sm font-semibold text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors line-clamp-3">
                  {rel.data.title}
                </p>
                <p class="mt-auto text-[11px] text-[var(--color-text-dim)]">
                  {rel.data.publishedAt.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Prev / Next navigation -->
  {(prevPost || nextPost) && (
    <nav class="border-t border-[var(--color-border)]" aria-label="Article navigation">
      <div class="mx-auto max-w-3xl px-6 py-8 grid grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/insights/${prevPost.id.replace(/\.mdx?$/, '')}/`}
            class="group flex flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 hover:border-[var(--color-accent)]/40 transition-colors"
          >
            <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)] flex items-center gap-1.5">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M6 2L3 5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Previous
            </span>
            <span class="text-sm font-medium text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors line-clamp-2">{prevPost.data.title}</span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a
            href={`/insights/${nextPost.id.replace(/\.mdx?$/, '')}/`}
            class="group flex flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 hover:border-[var(--color-accent)]/40 transition-colors text-right"
          >
            <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)] flex items-center justify-end gap-1.5">
              Next
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M4 2l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="text-sm font-medium text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors line-clamp-2">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </div>
    </nav>
  )}

  <!-- Newsletter / Subscribe -->
  <section class="border-t border-[var(--color-border)] py-16">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] p-8 md:p-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Newsletter</p>
        <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">Get the next one first.</h2>
        <p class="text-[var(--color-text-muted)] mb-6 max-w-md">
          When I publish a new article on AI systems, GTM architecture, or growth operating models, you'll be the first to know.
        </p>
        <a
          href="/subscribe/"
          class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          Subscribe
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const bar = document.getElementById('progress-bar') as HTMLElement;
  const article = document.getElementById('article-content') as HTMLElement;
  const hasAnalyticsConsent = () => localStorage.getItem('cookie-consent') === 'accepted';
  let analyticsModule: Promise<typeof import('../../utils/mixpanel')> | null = null;
  const loadAnalytics = async () => {
    if (!hasAnalyticsConsent()) return null;
    analyticsModule ??= import('../../utils/mixpanel');
    const analytics = await analyticsModule;
    analytics.initAfterConsent();
    return analytics;
  };

  // Article metadata injected at build time via data attributes on the article element
  const slug = article?.dataset.slug ?? '';
  const title = article?.dataset.title ?? document.title;
  const category = article?.dataset.category ?? '';
  const tags = (article?.dataset.tags ?? '').split(',').filter(Boolean);
  const readTimeMin = parseInt(article?.dataset.readTime ?? '5', 10);

  // fire article_viewed (Layout page_viewed fires first via 300ms timeout)
  setTimeout(() => {
    loadAnalytics().then((analytics) =>
      analytics?.trackArticleViewed({ slug, title, category: category || undefined, tags, read_time_min: readTimeMin }),
    );
  }, 400);

  // Scroll depth milestones: fire once each
  const milestones = new Set<number>();

  function updateProgress() {
    const { top, height } = article.getBoundingClientRect();
    const windowH = window.innerHeight;
    const scrollable = height - windowH;
    const scrolled = Math.max(0, -top);
    const pct = scrollable > 0 ? Math.min(100, (scrolled / scrollable) * 100) : 0;

    bar.style.width = pct + '%';
    bar.setAttribute('aria-valuenow', String(Math.round(pct)));

    for (const milestone of [25, 50, 75, 100] as const) {
      if (pct >= milestone && !milestones.has(milestone)) {
        milestones.add(milestone);
        loadAnalytics().then((analytics) =>
          analytics?.trackArticleScrollDepth({ slug, depth_pct: milestone }),
        );
      }
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Newsletter CTA in article footer
  document.querySelector('a[href="/subscribe/"]')?.addEventListener('click', () => {
    loadAnalytics().then((analytics) =>
      analytics?.trackNewsletterCtaClicked({ location: 'article_end' }),
    );
  });
</script>
