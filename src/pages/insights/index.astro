---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const featuredPost = allPosts.find(p => p.data.featured);
const restPosts = allPosts.filter(p => p !== featuredPost);

const categories = ['All', 'AI Systems', 'GTM Architecture', 'Operator Playbooks', 'Products'];

const author = {
  name: 'Wojciech Łuszczyński',
  avatar: '/images/wojciech-avatar-384.webp',
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const readTime = (body = '') =>
  `${Math.max(4, Math.ceil(body.split(/\s+/).filter(Boolean).length / 220))} min read`;

const coverCfg: Record<string, { from: string; to: string; icon: string }> = {
  'AI Systems':         { from: '#1e1b4b', to: '#4c1d95', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
  'GTM Architecture':   { from: '#78350f', to: '#b45309', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  'Operator Playbooks': { from: '#134e4a', to: '#0f766e', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
  'Products':           { from: '#1e3a5f', to: '#1d4ed8', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  'default':            { from: '#1c1917', to: '#44403c', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
};

const getCover = (cat?: string) => coverCfg[cat ?? ''] ?? coverCfg['default'];

const tagCls = 'bg-[var(--color-surface-2)] text-[var(--color-text-dim)] border-[var(--color-border)]';
---

<Layout
  title="Insights"
  description="Field notes on AI systems, GTM architecture, and revenue system design — from an operator who builds and runs these systems."
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">

    <!-- Header -->
    <div class="mb-10 max-w-3xl">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Insights</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">
        Field notes on AI systems,<br class="hidden md:block" /> GTM, and revenue architecture.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        Practical breakdowns from systems I build and run. Not theory — architecture, stack choices, and operator lessons from live deployments.
      </p>
    </div>

    <!-- Featured hero -->
    {featuredPost && (() => {
      const slug = featuredPost.id.replace(/\.mdx?$/, '');
      const cover = getCover(featuredPost.data.category);
      return (
        <a
          href={`/insights/${slug}/`}
          class="group mb-10 grid overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:shadow-[0_8px_40px_rgb(0_0_0/0.12)] hover:border-[var(--color-border-2)] lg:grid-cols-[0.9fr_1.1fr]"
          data-category={featuredPost.data.category ?? ''}
        >
          <!-- Cover -->
          <div
            class="relative min-h-[300px] overflow-hidden"
            style={`background: linear-gradient(135deg, ${cover.from} 0%, ${cover.to} 100%);`}
          >
            <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 32px 32px;" aria-hidden="true" />
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="rounded-2xl bg-white/8 p-6 ring-1 ring-white/12">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.82)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={cover.icon} />
                </svg>
              </div>
            </div>
            <div class="absolute top-4 left-4">
              <span class="rounded-full bg-white/15 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white/90 ring-1 ring-white/20">Featured</span>
            </div>
            <div class="absolute bottom-4 left-4 right-4">
              <p class="text-xs font-medium text-white/45">{featuredPost.data.category ?? 'Article'}</p>
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center p-8 md:p-10">
            <div class="mb-4 flex flex-wrap gap-1.5">
              {featuredPost.data.tags.slice(0, 4).map(tag => (
                <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${tagCls}`}>{tag}</span>
              ))}
            </div>
            <h2 class="mb-3 text-2xl md:text-[1.75rem] font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">
              {featuredPost.data.title}
            </h2>
            <p class="mb-6 text-[var(--color-text-muted)] leading-relaxed">
              {featuredPost.data.description}
            </p>
            {featuredPost.data.tldr && (
              <ul class="mb-6 grid gap-2">
                {featuredPost.data.tldr.slice(0, 3).map(item => (
                  <li class="flex gap-2.5 text-sm text-[var(--color-text-muted)]">
                    <span class="mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex items-center justify-between border-t border-[var(--color-border)] pt-5">
              <div class="flex items-center gap-2.5">
                <img src={author.avatar} alt="" width="28" height="28" loading="lazy" decoding="async"
                  class="h-7 w-7 rounded-full border border-[var(--color-border)] object-cover" />
                <div class="text-xs text-[var(--color-text-dim)]">
                  <time datetime={featuredPost.data.publishedAt.toISOString()}>{formatDate(featuredPost.data.publishedAt)}</time>
                  <span class="mx-1.5">·</span>
                  <span>{readTime(featuredPost.body)}</span>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-text)]">
                Read article
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      );
    })()}

    <!-- Category filter — single clean row -->
    <div class="mb-2 flex flex-wrap gap-2" id="cat-nav" role="tablist" aria-label="Filter by category">
      {categories.map((cat, i) => (
        <button
          role="tab"
          data-cat={cat}
          aria-selected={i === 0 ? 'true' : 'false'}
          class:list={[
            'cat-btn rounded-[var(--radius-btn)] px-4 py-2 text-sm font-medium transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
            i === 0
              ? 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm'
              : 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]',
          ]}
        >{cat}</button>
      ))}
    </div>

    <p class="mb-6 mt-3 text-sm text-[var(--color-text-dim)]" id="article-count">{restPosts.length} <span>articles</span></p>

    <!-- Article grid -->
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3 mb-16" id="article-grid">
      {restPosts.map(post => {
        const slug = post.id.replace(/\.mdx?$/, '');
        const cover = getCover(post.data.category);
        return (
          <a
            href={`/insights/${slug}/`}
            class="article-card group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:shadow-[0_6px_28px_rgb(0_0_0/0.10)] hover:border-[var(--color-border-2)] hover:-translate-y-px"
            data-category={post.data.category ?? ''}
          >
            <!-- Cover -->
            <div
              class="relative h-44 shrink-0 overflow-hidden"
              style={`background: linear-gradient(135deg, ${cover.from} 0%, ${cover.to} 100%);`}
            >
              <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true" />
              <div class="absolute top-3.5 left-3.5">
                <span class="rounded-full bg-white/12 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-white/65 ring-1 ring-white/15">
                  {post.data.category ?? 'Article'}
                </span>
              </div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="rounded-xl bg-white/8 p-4 ring-1 ring-white/10 transition-colors duration-200 group-hover:bg-white/12">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.78)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={cover.icon} />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Body -->
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium ${tagCls}`}>{tag}</span>
                ))}
              </div>
              <h2 class="mb-2 text-[0.95rem] font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150 line-clamp-3">
                {post.data.title}
              </h2>
              <p class="mb-4 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-[var(--color-border)] pt-3">
                <time class="text-[11px] text-[var(--color-text-dim)]" datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span class="text-[11px] text-[var(--color-text-dim)]">{readTime(post.body)}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="hidden mb-16 py-20 text-center">
      <p class="text-lg font-semibold text-[var(--color-text)] mb-1">No articles in this category yet.</p>
      <p class="text-sm text-[var(--color-text-muted)]">Try a different filter.</p>
    </div>

    <!-- Newsletter CTA -->
    <div class="rounded-2xl border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 px-8 py-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <div class="flex-1">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Newsletter</p>
        <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-2">Want to know more first?</h2>
        <p class="text-[var(--color-text-muted)]">
          New articles on AI systems, GTM architecture, and growth operating models — delivered when they publish.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="https://subscribe.wojciech.io"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors"
        >
          Subscribe
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</Layout>

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('.article-card');
  const noResults = document.getElementById('no-results')!;
  const countEl = document.getElementById('article-count')!;

  const ACTIVE = 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm';
  const INACTIVE = 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]';

  function applyFilter(cat: string) {
    let visible = 0;
    cards.forEach(card => {
      const match = cat === 'All' || (card.dataset.category ?? '') === cat;
      (card as HTMLElement).style.display = match ? '' : 'none';
      if (match) visible++;
    });
    noResults.classList.toggle('hidden', visible > 0);
    countEl.textContent = `${visible} article${visible !== 1 ? 's' : ''}`;
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      catBtns.forEach(b => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.classList.remove(...ACTIVE.split(' '), ...INACTIVE.split(' '));
        b.classList.add(...(active ? ACTIVE : INACTIVE).split(' '));
      });
      applyFilter(btn.dataset.cat ?? 'All');
    });
  });
</script>
