---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PosterFeatured from '../../components/insights/PosterFeatured.astro';
import PosterCard from '../../components/insights/PosterCard.astro';
import ComparisonRow from '../../components/insights/ComparisonRow.astro';
import { SITE } from '../../data/site';
import { versioned } from '../../lib/assetVersion';
import {
  insightSlug,
  isLocalePost,
  localizedInsightIndexAlternates,
  readTime,
  sortInsights,
} from '../../lib/insights';

const allPosts = (await getCollection('insights', isLocalePost('en'))).sort(sortInsights);

const featuredPost = allPosts.find(p => p.data.featured);
// Date order below the hero, not sortInsights order. That sort floats every
// `featured` post to the top, which is right when one post is the hero and
// wrong for the lists under it: six flagged posts once pushed articles from
// June above the current week and read as a broken sort.
const restPosts = allPosts
  .filter(p => p !== featuredPost)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Split the index by what the article is, not by when it was published.
//
// Most of this corpus is model comparisons, and a comparison is something you
// look up, not something you browse. As poster cards they were 4:5 images
// stacked ten screens deep on a phone, each carrying cover art that answered
// nothing. As rows they answer "which of these two, and why" on one line.
//
// The test is the article's own seoTitle, which already reads "A vs B: the
// angle" for every comparison in the set. No new frontmatter, and anything
// that does not match keeps its poster card.
const COMPARISON_TITLE = /^(.+?)\s+vs\.?\s+(.+?):\s*(.+)$/;
type Comparison = { post: (typeof restPosts)[number]; left: string; right: string; angle: string };

const comparisons: Comparison[] = [];
const essays: typeof restPosts = [];
for (const post of restPosts) {
  const m = post.data.seoTitle?.match(COMPARISON_TITLE);
  if (m) comparisons.push({ post, left: m[1], right: m[2], angle: m[3] });
  else essays.push(post);
}

// A front page, not an archive. The three newest after the lead get real
// weight and their cover art; everything behind them is a named band with its
// own rhythm. Fifty-two equal cards was the thing that read as a dump.
const secondary = restPosts.slice(0, 3);
const secondarySet = new Set(secondary);
// Newest first, ignoring `featured`. The shared sort floats featured articles
// to the top, which is right for a card wall and wrong for a lookup table: two
// articles from June and July sat above this week's releases and read as a
// broken sort.
comparisons.sort((a, b) => b.post.data.publishedAt.getTime() - a.post.data.publishedAt.getTime());

// Nothing appears twice on the page: the trio above owns those three.
const tableRows = comparisons.filter((c) => !secondarySet.has(c.post));
const playbooks = essays.filter((e) => !secondarySet.has(e));
// Six visible, the rest rendered and hidden behind a button. Slicing the
// array instead would have cut seventeen articles off their only link from
// this index, which costs more than a long page does.
const PLAYBOOKS_VISIBLE = 6;
// Same cap on the table. Twenty-five rows under one heading is the thing that
// read as an endless list however well each row is set.
const COMPARISONS_VISIBLE = 8;

// What the page actually renders, so the count under the filter is not a
// different number from what a reader can see.
const onPage = 1 + secondary.length + tableRows.length + playbooks.length;

// Only show categories that have at least one article
const usedCategories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))] as string[];
const categories = ['All', ...usedCategories.sort()];

// Article count per category, for filter chip labels
const categoryCounts: Record<string, number> = { All: allPosts.length };
for (const p of allPosts) {
  if (p.data.category) {
    categoryCounts[p.data.category] = (categoryCounts[p.data.category] ?? 0) + 1;
  }
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights/' },
  ],
};
const articleListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AI & GTM Insights · Operator Notes',
  url: SITE.url + '/insights/',
  author: { '@type': 'Person', name: 'Wojciech Luszczynski', url: SITE.url + '/' },
  blogPost: allPosts.slice(0, 10).map((p) => {
    const slug = insightSlug(p);
    return {
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: `${SITE.url}/insights/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      keywords: p.data.tags.join(', '),
    };
  }),
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Layout
  title="AI & GTM Insights · Operator Notes"
  description="Field notes on AI systems, GTM architecture, and revenue system design. Practical patterns from an operator who builds and runs these systems in production."
  ogImage="/og/pages/insights.png"
  schema={[breadcrumbSchema, articleListSchema]}
  alternates={localizedInsightIndexAlternates()}
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">

    <!-- Header -->
    <div class="mb-12 max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">Insights</span>
      </div>
      <h1 class="t-h1 text-[var(--color-text)] mb-4" transition:name="page-title-insights">
        Field notes on AI systems,<br class="hidden md:block" /> GTM, and revenue architecture.
      </h1>
      <p class="t-lead text-[var(--color-text-muted)]">
        Practical breakdowns from systems I build and run. Not theory: architecture, stack choices, and operator lessons from live deployments.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/rss.xml" class="t-small group inline-flex items-center gap-2 text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]">
          <svg class="h-4 w-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zM4 10.1a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"/>
          </svg>
          Subscribe via RSS
        </a>
      </div>
    </div>

    <!-- Lead. One story with real weight, its own cover, and room to
         breathe. Every blog front page worth copying does this before it
         shows an archive; this page used to go straight to the archive. -->
    {featuredPost && (
      <a
        href={`/insights/${insightSlug(featuredPost)}/`}
        class="group mb-14 grid items-center gap-8 md:grid-cols-12 md:gap-10"
        data-featured-article
        data-category={featuredPost.data.category ?? ''}
      >
        <div class="flex flex-col gap-4 md:col-span-7">
          <div class="flex items-center gap-2.5">
            <span class="t-label rounded bg-[var(--color-accent-cta)] px-2 py-1 font-semibold text-[var(--color-accent-text)]">New</span>
            <span class="t-caption text-[var(--color-text-dim)]">
              {formatDate(featuredPost.data.publishedAt)} · {readTime(featuredPost.body, 'en')}
            </span>
          </div>
          <h2 class="t-h2 text-pretty text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)] md:t-h1">
            {featuredPost.data.title}
          </h2>
          <p class="t-lead max-w-[34rem] text-[var(--color-text-muted)]">{featuredPost.data.description}</p>
          <span class="t-caption text-[var(--color-accent-hi)]">Read the comparison →</span>
        </div>
        {featuredPost.data.coverImage && (
          <div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] md:col-span-5">
            <img
              src={versioned(featuredPost.data.coverImage)}
              alt=""
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[1200/630] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>
        )}
      </a>
    )}

    <!-- Second tier: visibly smaller than the lead, still with art. -->
    {secondary.length > 0 && (
      <div class="mb-14 grid gap-7 border-t border-[var(--color-border)] pt-8 sm:grid-cols-3">
        {secondary.map((post) => (
          <a
            href={`/insights/${insightSlug(post)}/`}
            class="js-article group flex flex-col gap-3"
            data-category={post.data.category ?? ''}
          >
            {post.data.coverImage && (
              <div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)]">
                <img
                  src={versioned(post.data.coverImage)}
                  alt=""
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <span class="t-caption text-[var(--color-text-dim)]">
              {formatDate(post.data.publishedAt)} · {readTime(post.body, 'en')}
            </span>
            <h3 class="t-h3 text-pretty text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">
              {post.data.title}
            </h3>
          </a>
        ))}
      </div>
    )}

    <!-- Category filter. It drives the lead, the trio, the table rows and the
         playbook cards through the data-category hooks they all carry. It sat
         above the old card wall; here it belongs with the bands it filters. -->
    <div class="mb-3 flex flex-wrap items-center gap-2 border-t border-[var(--color-border)] pt-8" id="cat-nav" role="tablist" aria-label="Filter by category">
      {categories.map((cat, i) => {
        const count = categoryCounts[cat] ?? 0;
        return (
          <button
            role="tab"
            data-cat={cat}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'cat-btn t-button rounded-[var(--radius-btn)] px-4 py-2 transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
              i === 0
                ? 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm'
                : 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]',
            ]}
          >
            {cat}
            <span class="t-caption cat-btn-count ml-1.5 rounded-full px-1.5 py-0.5 font-semibold tabular-nums" aria-label={`${count} articles`}>{count}</span>
          </button>
        );
      })}
    </div>

    <p class="t-small mb-10 mt-3 text-[var(--color-text-dim)]" id="article-count">{onPage} <span>articles</span></p>

    <div id="no-results" class="hidden mb-16 py-20 text-center">
      <p class="t-lead font-semibold text-[var(--color-text)] mb-1">No articles in this category yet.</p>
      <p class="t-small text-[var(--color-text-muted)]">Try a different filter.</p>
    </div>

    <!-- Band: every comparison, as a table with headers rather than a list. -->
    {tableRows.length > 0 && (
      <section class="mb-14" aria-labelledby="comparisons-heading" id="comparison-list">
        <div class="mb-4 flex items-end justify-between gap-6">
          <div>
            <h2 id="comparisons-heading" class="t-h3 mb-1 text-[var(--color-text)]">Every comparison I have run</h2>
            <p class="t-small text-[var(--color-text-dim)]">Price, independent score, and which one I would put in the loop.</p>
          </div>
          <span class="t-caption shrink-0 text-[var(--color-text-dim)]">{tableRows.length} comparisons</span>
        </div>
        <div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)]">
          <div class="hidden grid-cols-[minmax(0,19rem)_1fr_5rem] gap-6 border-b border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-5 py-3 md:grid">
            <span class="t-label text-[var(--color-text-dim)]">Pair</span>
            <span class="t-label text-[var(--color-text-dim)]">What it comes down to</span>
            <span class="t-label text-right text-[var(--color-text-dim)]">Date</span>
          </div>
          {tableRows.map(({ post, left, right, angle }, i) => (
            <ComparisonRow
              extra={i >= COMPARISONS_VISIBLE}
              href={`/insights/${insightSlug(post)}/`}
              left={left}
              right={right}
              angle={angle}
              categoryKey={post.data.category ?? ''}
              date={formatDate(post.data.publishedAt)}
              read={readTime(post.body, 'en')}
            />
          ))}
        </div>
        {tableRows.length > COMPARISONS_VISIBLE && (
          <button
            type="button"
            id="comparisons-more"
            class="t-button mt-6 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-4 py-2.5 text-[var(--color-text)] transition-colors hover:border-[var(--color-accent-cta)]"
          >
            Show {tableRows.length - COMPARISONS_VISIBLE} more
          </button>
        )}
      </section>
    )}

    <!-- Band: the longer pieces, three up on rules. No cover art here: at this
         size it would be a thumbnail nobody looks at. -->
    {playbooks.length > 0 && (
      <section class="mb-16" aria-labelledby="playbooks-heading">
        <div class="mb-5 flex items-end justify-between gap-6 border-t border-[var(--color-border-2)] pt-8">
          <div>
            <h2 id="playbooks-heading" class="t-h3 mb-1 text-[var(--color-text)]">Playbooks</h2>
            <p class="t-small text-[var(--color-text-dim)]">Longer pieces about systems rather than models.</p>
          </div>
          <span class="t-caption shrink-0 text-[var(--color-text-dim)]">{playbooks.length} pieces</span>
        </div>
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {playbooks.map((post, i) => (
            <a
              href={`/insights/${insightSlug(post)}/`}
              class:list={[
                'js-article group flex flex-col gap-2.5 border-l border-[var(--color-border-2)] pl-5 transition-colors hover:border-[var(--color-accent-cta)]',
                i >= PLAYBOOKS_VISIBLE && 'playbook-extra hidden',
              ]}
              data-category={post.data.category ?? ''}
            >
              <span class="t-caption text-[var(--color-text-dim)]">
                {post.data.category ?? 'Insight'} · {readTime(post.body, 'en')}
              </span>
              <h3 class="t-h3 text-pretty text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">
                {post.data.title}
              </h3>
              <p class="t-small line-clamp-2 text-[var(--color-text-muted)]">{post.data.description}</p>
            </a>
          ))}
        </div>
        {playbooks.length > PLAYBOOKS_VISIBLE && (
          <button
            type="button"
            id="playbooks-more"
            class="t-button mt-7 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-4 py-2.5 text-[var(--color-text)] transition-colors hover:border-[var(--color-accent-cta)]"
          >
            Show {playbooks.length - PLAYBOOKS_VISIBLE} more
          </button>
        )}
      </section>
    )}

    <!-- Newsletter CTA. `page-ask` tells the footer this page already asks,
         so its closing block and the espresso band drop out. -->
    <div class="page-ask border-t border-[var(--color-border)] pt-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
      <div class="max-w-xl">
        <p class="obs-label-accent block mb-3">Newsletter</p>
        <h2 class="t-h2 text-[var(--color-text)] mb-2 text-balance">Want to know more first?</h2>
        <p class="text-[var(--color-text-muted)]">
          New articles on AI systems, GTM architecture, and growth operating models, delivered when they publish.
        </p>
      </div>
      <a
        href="/subscribe/"
        class="t-button btn-press group inline-flex shrink-0 items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
      >
        Subscribe
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</Layout>

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const rows    = document.querySelectorAll<HTMLElement>('.js-article');
  const featured = document.querySelector<HTMLElement>('[data-featured-article]');
  const noResults = document.getElementById('no-results')!;
  const countEl   = document.getElementById('article-count')!;

  const ACTIVE   = 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm';
  const INACTIVE = 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]';
  const COUNT_ACTIVE   = 'bg-[var(--color-bg)]/20 text-[var(--color-bg)]';
  const COUNT_INACTIVE = 'bg-[var(--color-surface-2)] text-[var(--color-text-dim)]';

  function applyFilter(cat: string, pushState = false) {
    catBtns.forEach(b => {
      const active = (b.dataset.cat ?? 'All') === cat;
      b.setAttribute('aria-selected', active ? 'true' : 'false');
      b.classList.remove(...ACTIVE.split(' '), ...INACTIVE.split(' '));
      b.classList.add(...(active ? ACTIVE : INACTIVE).split(' '));
      const badge = b.querySelector<HTMLElement>('.cat-btn-count');
      if (badge) {
        badge.classList.remove(...COUNT_ACTIVE.split(' '), ...COUNT_INACTIVE.split(' '));
        badge.classList.add(...(active ? COUNT_ACTIVE : COUNT_INACTIVE).split(' '));
      }
    });

    let visible = 0;
    if (featured) {
      const match = cat === 'All' || (featured.dataset.category ?? '') === cat;
      featured.style.display = match ? '' : 'none';
      if (match) visible++;
    }
    rows.forEach(row => {
      const match = cat === 'All' || (row.dataset.category ?? '') === cat;
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    noResults.classList.toggle('hidden', visible > 0);
    countEl.textContent = `${visible} article${visible !== 1 ? 's' : ''}`;

    if (pushState) {
      const url = new URL(window.location.href);
      if (cat === 'All') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      window.history.replaceState(null, '', url.toString());
    }
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.cat ?? 'All', true));
  });

  // Restore filter from URL on load
  const initialCat = new URL(window.location.href).searchParams.get('cat') ?? 'All';
  applyFilter(initialCat);

  // Allow category labels in rows to filter
  const activateChip = (chip: HTMLElement) => {
    applyFilter(chip.dataset.filterCat ?? 'All', true);
    document.getElementById('cat-nav')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  // The chip is a span with role="button" and tabindex, so it takes focus but
  // gets no key handling for free. Without this a keyboard user tabs onto it
  // and nothing happens.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const chip = (e.target as Element).closest<HTMLElement>('[data-filter-cat]');
    if (!chip) return;
    e.preventDefault();
    activateChip(chip);
  });

  // Reveal the rest of the playbooks. They are in the DOM either way, so a
  // crawler and a filter both see all of them; this only lifts the visual cap.
  const liftCap = (buttonId: string, itemClass: string) => {
    document.getElementById(buttonId)?.addEventListener('click', (e) => {
      document.querySelectorAll(itemClass).forEach((el) => el.classList.remove('hidden'));
      (e.currentTarget as HTMLElement).remove();
    });
  };
  liftCap('playbooks-more', '.playbook-extra');
  liftCap('comparisons-more', '.comparison-extra');

  document.addEventListener('click', (e) => {
    const chip = (e.target as Element).closest<HTMLElement>('[data-filter-cat]');
    if (!chip) return;
    e.preventDefault();
    applyFilter(chip.dataset.filterCat ?? 'All', true);
    document.getElementById('cat-nav')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
