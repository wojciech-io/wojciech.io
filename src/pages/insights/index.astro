---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
import {
  insightSlug,
  isLocalePost,
  localizedInsightIndexAlternates,
  readTime,
  sortInsights,
} from '../../lib/insights';

const allPosts = (await getCollection('insights', isLocalePost('en'))).sort(sortInsights);

const featuredPost = allPosts.find(p => p.data.featured);
const restPosts = allPosts.filter(p => p !== featuredPost);

// Only show categories that have at least one article
const usedCategories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))] as string[];
const categories = ['All', ...usedCategories.sort()];

// Article count per category, for filter chip labels
const categoryCounts: Record<string, number> = { All: allPosts.length };
for (const p of allPosts) {
  if (p.data.category) {
    categoryCounts[p.data.category] = (categoryCounts[p.data.category] ?? 0) + 1;
  }
}

// Latest band is only useful when the catalog is large enough that the grid
// can't act as the index by itself. Below 7 posts the latest cards and the grid
// duplicate the same articles two or three times on one page.
const byDate = [...allPosts].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const showLatestBand = allPosts.length >= 7;
const latestPosts = showLatestBand ? byDate.slice(0, 3) : [];

const author = {
  name: 'Wojciech Łuszczyński',
  avatar: 'https://www.gravatar.com/avatar/31d046a24e8df6bd8cf76fc7026d1907c48cb173ad319077f9d8f43c55f4523d?s=56&r=g',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights/' },
  ],
};
const articleListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AI & GTM Insights · Operator Notes',
  url: SITE.url + '/insights/',
  author: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: SITE.url + '/' },
  blogPost: allPosts.slice(0, 10).map((p) => {
    const slug = insightSlug(p);
    return {
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: `${SITE.url}/insights/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      keywords: p.data.tags.join(', '),
    };
  }),
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

// Editorial covers: solid category colour, no gradient mesh, no abstract icon.
// The article title carries the cover.
const coverCfg: Record<string, { bg: string; fg: string }> = {
  'AI Systems':         { bg: '#171930', fg: '#c4b5fd' },
  'GTM Architecture':   { bg: '#2a1810', fg: '#fbbf24' },
  'Operator Playbooks': { bg: '#0a2a26', fg: '#5eead4' },
  'Products':           { bg: '#0f1d3a', fg: '#7dd3fc' },
  'default':            { bg: '#1a1a1a', fg: '#e5e5e5' },
};

const getCover = (cat?: string) => coverCfg[cat ?? ''] ?? coverCfg['default'];

const tagCls = 'obs-badge';
---

<Layout
  title="AI & GTM Insights · Operator Notes"
  description="Field notes on AI systems, GTM architecture, and revenue system design. Practical patterns from an operator who builds and runs these systems in production."
  ogImage="/og/pages/insights.png"
  schema={[breadcrumbSchema, articleListSchema]}
  alternates={localizedInsightIndexAlternates()}
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">

    <!-- Header -->
    <div class="mb-10 max-w-3xl">
      <span class="obs-label-accent mb-3">// Insights</span>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-insights">
        Field notes on AI systems,<br class="hidden md:block" /> GTM, and revenue architecture.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        Practical breakdowns from systems I build and run. Not theory: architecture, stack choices, and operator lessons from live deployments.
      </p>
    </div>

    <!-- Featured hero -->
    {featuredPost && (() => {
      const slug = insightSlug(featuredPost);
      const cover = getCover(featuredPost.data.category);
      return (
        <a
          href={`/insights/${slug}/`}
          class="group mb-10 grid overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:shadow-[0_8px_40px_rgb(0_0_0/0.12)] hover:border-[var(--color-border-2)] lg:grid-cols-[0.9fr_1.1fr]"
          data-category={featuredPost.data.category ?? ''}
          data-featured-article
        >
          <!-- Cover: image when available, category-color fallback -->
          <div
            class="relative min-h-[320px] overflow-hidden"
            style={!featuredPost.data.coverImage ? `background: ${cover.bg};` : 'background: #0c0c0c;'}
          >
            {featuredPost.data.coverImage ? (
              <img
                src={featuredPost.data.coverImage}
                alt=""
                width="600"
                height="400"
                loading="eager"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <div class="flex items-end h-full p-8">
                <p class="font-serif text-2xl leading-tight md:text-3xl" style={`color: ${cover.fg};`}>
                  {featuredPost.data.title}
                </p>
              </div>
            )}
            <div class="absolute top-6 left-6 right-6 flex items-center justify-between">
              <span class="obs-badge bg-black/50 backdrop-blur-sm text-white/90 ring-1 ring-white/15">Featured</span>
              <span class="obs-badge bg-black/50 backdrop-blur-sm text-white/80">{featuredPost.data.category ?? 'Article'}</span>
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center p-8 md:p-10">
            <div class="mb-4 flex flex-wrap gap-1.5">
              {featuredPost.data.tags.slice(0, 4).map(tag => (
                <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${tagCls}`}>{tag}</span>
              ))}
            </div>
            <h2 class="mb-3 text-[length:var(--text-h2)] font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">
              {featuredPost.data.title}
            </h2>
            <p class="mb-6 text-[var(--color-text-muted)] leading-relaxed">
              {featuredPost.data.description}
            </p>
            {featuredPost.data.tldr && (
              <ul class="mb-6 grid gap-2">
                {featuredPost.data.tldr.slice(0, 3).map(item => (
                  <li class="flex gap-2.5 text-sm text-[var(--color-text-muted)]">
                    <span class="mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex items-center justify-between border-t border-[var(--color-border)] pt-5">
              <div class="flex items-center gap-2.5">
                <img src={author.avatar} alt="" width="28" height="28" loading="lazy" decoding="async"
                  class="h-7 w-7 rounded-full border border-[var(--color-border)] object-cover" />
                <div class="text-xs text-[var(--color-text-dim)]">
                  <time datetime={featuredPost.data.publishedAt.toISOString()}>{formatDate(featuredPost.data.publishedAt)}</time>
                  <span class="mx-1.5">·</span>
                  <span>{readTime(featuredPost.body, 'en')}</span>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-text)]">
                Read article
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      );
    })()}

    <!-- Category filter: single clean row -->
    <div class="mb-2 flex flex-wrap gap-2" id="cat-nav" role="tablist" aria-label="Filter by category">
      {categories.map((cat, i) => {
        const count = categoryCounts[cat] ?? 0;
        return (
          <button
            role="tab"
            data-cat={cat}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'cat-btn obs-mono rounded-[var(--radius-btn)] px-4 py-2 text-xs font-medium uppercase tracking-wider transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
              i === 0
                ? 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm'
                : 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]',
            ]}
          >
            {cat}
            <span class="cat-btn-count ml-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-semibold tabular-nums" aria-label={`${count} articles`}>{count}</span>
          </button>
        );
      })}
    </div>

    <p class="mb-6 mt-3 text-sm text-[var(--color-text-dim)]" id="article-count">{allPosts.length} <span>articles</span></p>

    <!-- Latest: only shown when the catalog is large enough that the grid alone would feel overwhelming. -->
    {showLatestBand && (
    <section id="latest-section" class="mb-10" aria-label="Latest articles">
      <span class="obs-label mb-4">// Latest</span>
      <div class="flex flex-col gap-3" id="latest-list">
        {latestPosts.map(post => {
          const slug = post.id.replace(/\.mdx?$/, '');
          return (
            <a
              href={`/insights/${slug}/`}
              class="latest-card group flex items-start gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden transition-all duration-150 hover:border-[var(--color-border-2)] hover:bg-[var(--color-surface-2)]"
              data-category={post.data.category ?? ''}
            >
              {post.data.coverImage && (
                <div class="w-24 h-full shrink-0 overflow-hidden bg-[#0c0c0c]">
                  <img
                    src={post.data.coverImage}
                    alt=""
                    width="96"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              <div class="min-w-0 flex-1 py-4 pr-5" class:list={[!post.data.coverImage && 'pl-5']}>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  {post.data.category && (
                    <span class="obs-label text-[var(--color-accent-label)]">{post.data.category}</span>
                  )}
                  <time class="text-[10px] text-[var(--color-text-dim)]" datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)}
                  </time>
                </div>
                <p class="text-sm font-semibold text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors line-clamp-2 mb-1">
                  {post.data.title}
                </p>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed line-clamp-2">
                  {post.data.description}
                </p>
              </div>
              <div class="shrink-0 self-center pr-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </section>
    )}

    <!-- Article grid: 2-col on desktop. Reads as editorial rather than blog-template. -->
    <div class="grid gap-6 sm:grid-cols-2 mb-16" id="article-grid">
      {restPosts.map(post => {
        const slug = insightSlug(post);
        const cover = getCover(post.data.category);
        return (
          <a
            href={`/insights/${slug}/`}
            class="article-card group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:shadow-[0_6px_28px_rgb(0_0_0/0.10)] hover:border-[var(--color-border-2)] hover:-translate-y-px"
            data-category={post.data.category ?? ''}
          >
            <!-- Cover: image when available, category-color fallback -->
            <div
              class="relative h-48 shrink-0 overflow-hidden"
              style={!post.data.coverImage ? `background: ${cover.bg};` : ''}
            >
              {post.data.coverImage ? (
                <img
                  src={post.data.coverImage}
                  alt=""
                  width="600"
                  height="340"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex items-end h-full p-5">
                  <p class="font-serif text-lg leading-tight line-clamp-3" style={`color: ${cover.fg};`}>
                    {post.data.title}
                  </p>
                </div>
              )}
              <span
                class="absolute top-4 left-4 obs-badge bg-black/50 backdrop-blur-sm text-white/90 ring-1 ring-white/15 cursor-pointer hover:bg-black/70 transition-colors"
                data-filter-cat={post.data.category ?? ''}
                role="button"
                tabindex="0"
              >
                {post.data.category ?? 'Article'}
              </span>
            </div>

            <!-- Body -->
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium ${tagCls}`}>{tag}</span>
                ))}
              </div>
              <h2 class="mb-2 text-[0.95rem] font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150 line-clamp-3">
                {post.data.title}
              </h2>
              <p class="mb-4 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-[var(--color-border)] pt-3">
                <time class="text-[11px] text-[var(--color-text-dim)]" datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span class="text-[11px] text-[var(--color-text-dim)]">{readTime(post.body, 'en')}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="hidden mb-16 py-20 text-center">
      <p class="text-lg font-semibold text-[var(--color-text)] mb-1">No articles in this category yet.</p>
      <p class="text-sm text-[var(--color-text-muted)]">Try a different filter.</p>
    </div>

    <!-- Newsletter CTA -->
    <div class="rounded-2xl border border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-8 py-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <div class="flex-1">
        <span class="obs-label-accent mb-3">// Newsletter</span>
        <h2 class="text-[length:var(--text-h2)] font-semibold text-[var(--color-text)] mb-2">Want to know more first?</h2>
        <p class="text-[var(--color-text-muted)]">
          New articles on AI systems, GTM architecture, and growth operating models, delivered when they publish.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="https://subscribe.wojciech.io"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          Subscribe
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</Layout>

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.article-card');
  const latestCards = document.querySelectorAll<HTMLElement>('.latest-card');
  const featured = document.querySelector<HTMLElement>('[data-featured-article]');
  const noResults = document.getElementById('no-results')!;
  const countEl   = document.getElementById('article-count')!;
  const latestSection = document.getElementById('latest-section');

  const ACTIVE   = 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm';
  const INACTIVE = 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]';
  const COUNT_ACTIVE   = 'bg-[var(--color-bg)]/20 text-[var(--color-bg)]';
  const COUNT_INACTIVE = 'bg-[var(--color-surface-2)] text-[var(--color-text-dim)]';

  function applyFilter(cat: string, pushState = false) {
    catBtns.forEach(b => {
      const active = (b.dataset.cat ?? 'All') === cat;
      b.setAttribute('aria-selected', active ? 'true' : 'false');
      b.classList.remove(...ACTIVE.split(' '), ...INACTIVE.split(' '));
      b.classList.add(...(active ? ACTIVE : INACTIVE).split(' '));
      // Update count badge styling
      const badge = b.querySelector<HTMLElement>('.cat-btn-count');
      if (badge) {
        badge.classList.remove(...COUNT_ACTIVE.split(' '), ...COUNT_INACTIVE.split(' '));
        badge.classList.add(...(active ? COUNT_ACTIVE : COUNT_INACTIVE).split(' '));
      }
    });

    let visible = 0;
    if (featured) {
      const match = cat === 'All' || (featured.dataset.category ?? '') === cat;
      featured.style.display = match ? '' : 'none';
      if (match) visible++;
    }
    cards.forEach(card => {
      const match = cat === 'All' || (card.dataset.category ?? '') === cat;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    // Filter latest section cards
    let latestVisible = 0;
    latestCards.forEach(card => {
      const match = cat === 'All' || (card.dataset.category ?? '') === cat;
      card.style.display = match ? '' : 'none';
      if (match) latestVisible++;
    });
    if (latestSection) {
      latestSection.style.display = latestVisible > 0 ? '' : 'none';
    }

    noResults.classList.toggle('hidden', visible > 0);
    countEl.textContent = `${visible} article${visible !== 1 ? 's' : ''}`;

    if (pushState) {
      const url = new URL(window.location.href);
      if (cat === 'All') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      window.history.replaceState(null, '', url.toString());
    }
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.cat ?? 'All', true));
  });

  // Restore filter from URL on load
  const initialCat = new URL(window.location.href).searchParams.get('cat') ?? 'All';
  applyFilter(initialCat);

  // Allow tag chips in article cards to filter
  document.addEventListener('click', (e) => {
    const chip = (e.target as Element).closest<HTMLElement>('[data-filter-cat]');
    if (!chip) return;
    e.preventDefault();
    applyFilter(chip.dataset.filterCat ?? 'All', true);
    document.getElementById('cat-nav')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
