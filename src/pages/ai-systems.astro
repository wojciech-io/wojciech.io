---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ProofCard from '../components/ui/ProofCard.astro';
import CTABand from '../components/ui/CTABand.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';

const principles = [
  {
    n: '01',
    title: 'Fix the system first',
    body: 'AI doesn\'t fix a broken GTM. If the pipeline leaks at qualification, AI-personalized sequences still go nowhere. I design the system first, then find where AI creates real leverage.',
  },
  {
    n: '02',
    title: 'Operator-grade, not demo-grade',
    body: 'Generic AI wrappers don\'t survive contact with real work. I build tools that are instrumented, specific to the workflow, and used in production, not shown in a slide deck.',
  },
  {
    n: '03',
    title: 'Compounding, not one-shots',
    body: 'The goal is a workflow that gets faster and smarter over time. Not a prompt that impresses once, breaks on the second run, and gets abandoned after two weeks.',
  },
  {
    n: '04',
    title: 'Every loop is measured',
    body: 'AI workflows without feedback loops don\'t improve — they drift. Every system I build has measurement baked in, so you know what\'s working, what\'s not, and what to change.',
  },
];

const tools = [
  {
    title: 'AdsAI / Ad Assistant',
    description: 'One full ad lifecycle in AI: brief → generate → score → iterate → prepare variants for deployment. Built for GTM operators, not agency workflows.',
    tags: ['Ads', 'LLMs', 'GTM'],
  },
  {
    title: 'Claude Code GTM Agent Starter Pack',
    description: 'Open-source foundation for building GTM agents with Claude Code. Designed so operators can ship without starting from scratch.',
    tags: ['Claude Code', 'Agents', 'Open source'],
    href: 'https://github.com/wojciechluszczynski/gtm-agent-repo',
  },
  {
    title: 'Notch, native macOS app',
    description: 'Built with Codex and Xcode. Proof that AI-assisted development covers native apps, not just web, extending the operator\'s reach beyond the browser.',
    tags: ['macOS', 'Swift', 'Codex'],
    href: 'https://notch.wojciech.io',
  },
  {
    title: 'AI Adoption playbook for B2B SaaS',
    description: 'Internal framework for responsible, compounding AI adoption across a B2B SaaS company: from growth and marketing through to product and ops.',
    tags: ['AI adoption', 'Framework', 'B2B SaaS'],
  },
  {
    title: 'CRM + outbound AI workflows',
    description: 'Prospecting, sequencing, scoring, and CRM enrichment, redesigned with AI in the loop to cut manual work and improve signal quality.',
    tags: ['CRM', 'Outbound', 'AI'],
  },
  {
    title: 'SEO + content AI workflows',
    description: 'From keyword research and brief generation to programmatic content scoring. Built to scale content production without scaling headcount.',
    tags: ['SEO', 'Content', 'AI'],
  },
];

const stackItems = [
  { label: 'Reasoning', tools: ['Claude Opus', 'GPT-4o', 'Gemini'] },
  { label: 'Coding & agents', tools: ['Claude Code', 'Cursor', 'Codex'] },
  { label: 'Automation', tools: ['Make', 'n8n', 'Zapier'] },
  { label: 'Analytics', tools: ['Amplitude', 'Mixpanel', 'Looker'] },
  { label: 'CRM', tools: ['HubSpot', 'Salesforce', 'Pipedrive'] },
  { label: 'Enrichment', tools: ['Ahrefs', 'Brandwatch', 'SimilarWeb'] },
];
---

<Layout
  title="AI Systems"
  description="AI-native workflows, GTM agents, and operating leverage: how Wojciech builds with AI in practice."
>

  <!-- Hero with terminal mockup -->
  <section class="relative pt-24 pb-20 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-speaking.webp" position="center 35%" opacity={0.075} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">

        <!-- Left: text -->
        <div class="flex-1 max-w-xl animate-fade-up">
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">AI Systems</p>
          <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5">
            AI in the architecture.<br class="hidden md:block" />
            <span class="text-[var(--color-text-muted)]">Not bolted on at the end.</span>
          </h1>
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
            Most teams add AI to tasks. I add it to systems.
            The difference is whether you get a faster copywriter or a different operating model: one that compounds, self-corrects, and runs without a human in every loop.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#principles" class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm">
              How I think about AI
            </a>
            <a href="#tools" class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text)] font-medium px-6 py-3 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 transition-colors text-sm">
              What I've built
            </a>
          </div>
        </div>

        <!-- Right: terminal mockup -->
        <div class="w-full lg:w-[460px] shrink-0 animate-scale-in" style="animation-delay: 150ms">
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] overflow-hidden shadow-2xl">
            <!-- Terminal title bar -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
              <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
              <span class="ml-3 text-xs text-[var(--color-text-dim)] font-mono">gtm-agent — claude-code</span>
            </div>
            <!-- Terminal body -->
            <div class="p-5 font-mono text-xs space-y-2 leading-relaxed">
              <p><span class="text-[var(--color-accent)]">$ </span><span class="text-[var(--color-text)]">claude run gtm-agent --client acme-saas</span></p>
              <p class="text-[var(--color-text-dim)]">▸ Loading CLAUDE.md operator identity...</p>
              <p class="text-[var(--color-text-dim)]">▸ Connecting MCP tools (Ahrefs, HubSpot, LinkedIn)...</p>
              <p class="text-[var(--color-text-dim)]">▸ Reading client memory: <span class="text-[var(--color-text-muted)]">acme-saas.md</span></p>
              <p class="text-[var(--color-text-dim)]">▸ Fetching ICP signal for 247 prospects...</p>
              <p class="text-[var(--color-text-dim)]">▸ Scoring leads against ICP matrix...</p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">12 high-fit leads enriched</span></p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">Sequences drafted and staged in HubSpot</span></p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">Memory file updated with new signals</span></p>
              <p class="pt-1 border-t border-[var(--color-border)] text-[var(--color-text-dim)] mt-2">
                Cost: <span class="text-[var(--color-accent)]">$3.40</span> · Time: <span class="text-[var(--color-accent)]">4m 12s</span>
              </p>
              <p><span class="text-[var(--color-accent)]">$ </span><span class="animate-pulse text-[var(--color-text)]">_</span></p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Principles -->
  <section id="principles" class="scroll-mt-20 py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader eyebrow="How I think about AI" heading="Four principles." class="mb-12" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {principles.map(({ n, title, body }) => (
          <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-border-2)] group">
            <span class="pointer-events-none select-none absolute -right-2 -top-4 text-[7rem] font-bold leading-none text-[var(--color-border)] opacity-60 group-hover:opacity-90 transition-opacity">{n}</span>
            <p class="relative text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-5">{n}</p>
            <h3 class="relative text-base font-semibold text-[var(--color-text)] mb-2">{title}</h3>
            <p class="relative text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader eyebrow="Tech stack" heading="Tools I actually use." class="mb-10" />
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {stackItems.map(({ label, tools: t }) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">{label}</p>
            <div class="flex flex-wrap gap-2">
              {t.map((tool) => (
                <span class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">{tool}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools built -->
  <section id="tools" class="scroll-mt-20 py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader eyebrow="What I've built" heading="AI workflows and tools in production." class="mb-12" />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map(({ title, description, tags, href }) => (
          <ProofCard title={title} description={description} tags={tags} href={href} />
        ))}
      </div>
    </div>
  </section>

  <!-- Working together -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <SectionHeader
          eyebrow="Work with me"
          heading="If you want AI in your GTM stack, done right."
          lead="Not a workshop. Not a deck of use cases. An actual system: built, shipped, and measured."
        />
        <div class="space-y-5">
          {[
            'AI GTM audit: where does AI actually help vs. add noise',
            'Workflow redesign with AI in the critical path',
            'Custom agent and tool development',
            'Team onboarding to AI-native operating patterns',
            'Ongoing iteration and measurement',
          ].map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading="Want AI in your GTM stack, done right?"
    subtext="Not a workshop. Not a use-case deck. An actual system: built, instrumented, and running. Book a call."
  />

</Layout>
