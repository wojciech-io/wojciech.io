---
import Layout from '../layouts/Layout.astro';
import AiSystemsContent from '../components/pages/AiSystemsContent.astro';
import { SITE } from '../data/site';
import { localizedPageAlternates } from '../data/localizedPages';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'AI Systems', item: SITE.url + '/ai-systems/' },
  ],
};
---

<Layout
  title="AI Systems · Workflows, Agents & Operating Leverage"
  description="AI-native workflows, GTM agents, and operating leverage. How I build with Claude Code, MCP, and automation in practice: architecture, decisions, and what actually runs in production."
  ogImage="/og/pages/ai-systems.png"
  alternates={localizedPageAlternates('ai-systems')}
  schema={breadcrumbSchema}
>
  <AiSystemsContent />
</Layout>
