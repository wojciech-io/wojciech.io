---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 Page not found" noindex>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)] text-center">
    <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">404</p>
    <h1 class="text-4xl font-semibold text-[var(--color-text)] mb-4">Page not found</h1>
    <p class="text-[var(--color-text-muted)] mb-8">This page doesn't exist or has been moved.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors"
    >
      ← Back to home
    </a>
  </div>
</Layout>
