---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Wojciech Łuszczyński — growth operator, GTM architect, AI-native builder."
>

  <section class="relative pt-24 pb-20 border-b border-[var(--color-border)] overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-15" aria-hidden="true" />
    <div class="pointer-events-none absolute -top-32 left-1/3 w-[500px] h-[400px] bg-[var(--color-accent-lo)]/15 blur-[120px] rounded-full" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-start">

        <!-- Left: context -->
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Contact</p>
          <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-6">
            Let's talk about the gap.
          </h1>
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10">
            If you have a broken revenue system, a missing GTM layer, or you just need something built that doesn't exist — reach out. I respond within 24h.
          </p>

          <!-- Quick contact options -->
          <div class="space-y-4">
            <a
              href="https://cal.com/wojciech-luszczynski"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-4 hover:border-[var(--color-accent)]/40 transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors">Book a call</p>
                <p class="text-xs text-[var(--color-text-dim)]">30 min · cal.com/wojciech-luszczynski</p>
              </div>
              <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all duration-150" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            <a
              href="https://linkedin.com/in/wojciechluszczynski"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-4 hover:border-[var(--color-accent)]/40 transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors">LinkedIn</p>
                <p class="text-xs text-[var(--color-text-dim)]">linkedin.com/in/wojciechluszczynski</p>
              </div>
              <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all duration-150" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: form -->
        <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8">
          <h2 class="text-lg font-semibold text-[var(--color-text)] mb-6">Send a message</h2>
          <form
            id="contact-form"
            class="space-y-5"
            novalidate
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Your name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Jan Kowalski"
                  class="w-full rounded-lg border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors"
                />
              </div>
              <div>
                <label for="company" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Company</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  placeholder="Acme SaaS"
                  class="w-full rounded-lg border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors"
                />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="jan@acme.com"
                class="w-full rounded-lg border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors"
              />
            </div>
            <div>
              <label for="topic" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">What's the challenge?</label>
              <select
                id="topic"
                name="topic"
                class="w-full rounded-lg border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors appearance-none"
              >
                <option value="">Select a topic...</option>
                <option value="revenue-architecture">Revenue architecture audit</option>
                <option value="gtm-system">GTM system build / rebuild</option>
                <option value="ai-workflow">AI workflow design</option>
                <option value="crm-outbound">CRM / outbound operating model</option>
                <option value="fractional">Fractional GTM leadership</option>
                <option value="other">Something else</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell me about the problem, the stage you're at, and what you've already tried..."
                class="w-full rounded-lg border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors resize-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="btn-press w-full bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm"
            >
              Send message →
            </button>
            <p id="form-status" class="text-xs text-center text-[var(--color-text-dim)] hidden"></p>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    try {
      // Replace YOUR_FORM_ID with a Formspree or Web3Forms key
      const res = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        btn.textContent = 'Message sent ✓';
        btn.classList.remove('bg-[var(--color-accent)]');
        btn.classList.add('bg-green-600');
        status.textContent = "I'll respond within 24h.";
        status.classList.remove('hidden');
      } else {
        throw new Error('Failed');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Send message →';
      status.textContent = 'Something went wrong. Try emailing me directly.';
      status.classList.remove('hidden');
    }
  });
</script>
