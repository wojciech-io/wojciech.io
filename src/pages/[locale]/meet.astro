---
import Layout from '../../layouts/Layout.astro';
import BookingScheduler from '../../components/BookingScheduler.astro';
import { getMeetCopy, meetSchema } from '../../data/meet';
import { localizedHome } from '../../data/locales';
import { NON_EN_LOCALES, type LocaleKey } from '../../data/locale-codes';

export function getStaticPaths() {
  return NON_EN_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: LocaleKey };
const S = getMeetCopy(locale);
const home = localizedHome[locale];
// Same consolidation as the English /meet: /[locale]/contact embeds this very
// scheduler, so this page defers to it rather than competing for the same query.
const canonical = `/${locale}/contact/`;
---

<Layout
  htmlLang={home.htmlLang}
  ogLocale={home.ogLocale}
  title={S.title}
  description={S.description}
  canonical={canonical}
  noindex
  schema={meetSchema(locale)}
>
  <BookingScheduler lang={locale} />
</Layout>
