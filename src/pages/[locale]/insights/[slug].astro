---
import { personName } from '../../../data/site';
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { versioned } from '../../../lib/assetVersion';
import ArticleCover from '../../../components/ui/ArticleCover.astro';
import ArticleShare from '../../../components/article/ArticleShare.astro';
import ArticleToc from '../../../components/article/ArticleToc.astro';
// MDX article components (canonical source: packages/mdx-components)
import Callout from '@wojciech/mdx-components/components/Callout.astro';
import VideoEmbed from '@wojciech/mdx-components/components/VideoEmbed.astro';
import Screenshot from '@wojciech/mdx-components/components/Screenshot.astro';
import Compare from '@wojciech/mdx-components/components/Compare.astro';
import Flow from '@wojciech/mdx-components/components/Flow.astro';
import Stat from '@wojciech/mdx-components/components/Stat.astro';
import StatCallout from '@wojciech/mdx-components/components/StatCallout.astro';
import StatRow from '@wojciech/mdx-components/components/StatRow.astro';
import StatGrid from '@wojciech/mdx-components/components/StatGrid.astro';
import DoDont from '@wojciech/mdx-components/components/DoDont.astro';
import TLDR from '@wojciech/mdx-components/components/TLDR.astro';
import Steps from '@wojciech/mdx-components/components/Steps.astro';
import PullQuote from '@wojciech/mdx-components/components/PullQuote.astro';
import TechStack from '@wojciech/mdx-components/components/TechStack.astro';
import TOC from '@wojciech/mdx-components/components/TOC.astro';
import BeforeAfter from '@wojciech/mdx-components/components/BeforeAfter.astro';
import Diagram from '@wojciech/mdx-components/components/diagrams/Diagram.astro';
import Box from '@wojciech/mdx-components/components/diagrams/Box.astro';
import Arrow from '@wojciech/mdx-components/components/diagrams/Arrow.astro';
import Stack from '@wojciech/mdx-components/components/diagrams/Stack.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import FAQ from '../../../components/ui/FAQ.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import ProofCard from '../../../components/ui/ProofCard.astro';
import DataTable from '@wojciech/mdx-components/components/DataTable.astro';
import MetricRow from '@wojciech/mdx-components/components/MetricRow.astro';
import ArticleTimeline from '@wojciech/mdx-components/components/ArticleTimeline.astro';
import KeyPoint from '@wojciech/mdx-components/components/KeyPoint.astro';
import KeyTakeaway from '@wojciech/mdx-components/components/KeyTakeaway.astro';
import Comparison from '@wojciech/mdx-components/components/Comparison.astro';
import TwoUp from '@wojciech/mdx-components/components/TwoUp.astro';
import Quote from '@wojciech/mdx-components/components/Quote.astro';
import ToolCard from '@wojciech/mdx-components/components/ToolCard.astro';
import ProcessFlow from '@wojciech/mdx-components/components/ProcessFlow.astro';
import Grid from '@wojciech/mdx-components/components/Grid.astro';
import ResultCard from '@wojciech/mdx-components/components/ResultCard.astro';
import Benchmark from '@wojciech/mdx-components/components/Benchmark.astro';
import CaseStudyBlock from '@wojciech/mdx-components/components/CaseStudyBlock.astro';
import MetricDelta from '@wojciech/mdx-components/components/MetricDelta.astro';
import AgentFlow from '@wojciech/mdx-components/components/AgentFlow.astro';
import AnnotatedImage from '@wojciech/mdx-components/components/AnnotatedImage.astro';
import Tabs from '@wojciech/mdx-components/components/Tabs.astro';
import Accordion from '@wojciech/mdx-components/components/Accordion.astro';
import ImageSlider from '@wojciech/mdx-components/components/ImageSlider.astro';
import NumberTicker from '@wojciech/mdx-components/components/NumberTicker.astro';
import EmbedDeck from '@wojciech/mdx-components/components/EmbedDeck.astro';
import CodeBlock from '@wojciech/mdx-components/components/CodeBlock.astro';
import Terminal from '../../../../packages/mdx-components/components/Terminal.astro';
import ProTip from '../../../../packages/mdx-components/components/ProTip.astro';
import MetricBoard from '../../../../packages/mdx-components/components/MetricBoard.astro';
import ThreadBlock from '../../../../packages/mdx-components/components/ThreadBlock.astro';
import StackLayer from '../../../../packages/mdx-components/components/StackLayer.astro';
import { SITE } from '../../../data/site';
import { localizedHome, type LocaleKey } from '../../../data/locales';
import {
  insightLocaleLabels,
  insightSlug,
  isLocalePost,
  localizedInsightAlternates,
  insightAlternateLocales,
  localizedInsightLocales,
  sortInsights,
} from '../../../lib/insights';

const mdxComponents = {
  Callout, VideoEmbed, Screenshot, Compare, Flow,
  Video: VideoEmbed,
  Stat, StatCallout, StatRow, StatGrid, DoDont, TLDR, Steps, PullQuote, TechStack, TOC,
  BeforeAfter,
  Diagram, Box, Arrow, Stack,
  Badge, Button, CTABand, FAQ, SectionHeader, ProofCard,
  DataTable, MetricRow, ArticleTimeline, KeyPoint, TwoUp, Quote,
  Timeline: ArticleTimeline,
  Comparison,
  KeyTakeaway,
  MetricDelta, AgentFlow, AnnotatedImage,
  ToolCard, ProcessFlow, Grid,
  ResultCard, Benchmark, CaseStudyBlock,
  Tabs, Accordion, ImageSlider, NumberTicker, EmbedDeck, CodeBlock,
  Terminal, ProTip, MetricBoard, ThreadBlock, StackLayer,
};

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => localizedInsightLocales.includes(data.locale as LocaleKey) && !data.draft);
  const grouped = new Map<LocaleKey, typeof posts>();
  for (const locale of localizedInsightLocales) {
    grouped.set(locale, posts.filter(isLocalePost(locale)).sort(sortInsights));
  }

  return posts.map((post) => {
    const locale = post.data.locale as LocaleKey;
    const sorted = grouped.get(locale) ?? [];
    const idx = sorted.findIndex((candidate) => candidate.id === post.id);
    const others = sorted.filter((_, i) => i !== idx);
    const sameTags = others.filter((candidate) =>
      candidate.data.tags.some((tag) => post.data.tags.includes(tag))
    );
    const related = [...new Set([...sameTags, ...others])].slice(0, 3);

    return {
      params: { locale, slug: insightSlug(post) },
      props: {
        post,
        prevPost: sorted[idx + 1] ?? null,
        nextPost: sorted[idx - 1] ?? null,
        related,
      },
    };
  });
}

const { post, prevPost, nextPost, related } = Astro.props;
const locale = post.data.locale as LocaleKey;
const localeCopy = localizedHome[locale];
const labels = insightLocaleLabels[locale];
const { Content, headings } = await render(post);
const readMinutes = Math.max(4, Math.ceil((post.body?.split(/\s+/).length ?? 0) / 220));
const slug = insightSlug(post);
const baseSlug = post.data.translationOf ?? slug;
const allInsightPosts = await getCollection('insights');
const canonicalPath = `/${locale}/insights/${slug}/`;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const publishedAt = post.data.publishedAt.toISOString();
const updatedAt = (post.data.updatedAt ?? post.data.publishedAt).toISOString();
const ogImage = post.data.ogImage ?? `/og/${post.data.translationOf ?? slug}.png`;
const ogImageURL = new URL(ogImage, Astro.site).href;
const formatDate = (date: Date) =>
  date.toLocaleDateString(localeCopy.htmlLang, { day: 'numeric', month: 'long', year: 'numeric' });

const authorSchema = {
  '@type': 'Person',
  name: personName(locale),
  alternateName: 'Wojtek Luszczynski',
  url: SITE.url + '/',
  image: SITE.url + '/images/wojciech-avatar-2026-384.webp',
  jobTitle: 'GTM Architect & Growth Operator',
  sameAs: [SITE.linkedin, SITE.github, SITE.twitter.replace('twitter.com', 'x.com'), SITE.substack, SITE.medium, SITE.subscribeUrl],
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: publishedAt,
    dateModified: updatedAt,
    mainEntityOfPage: canonicalURL,
    url: canonicalURL,
    image: ogImageURL,
    inLanguage: localeCopy.htmlLang,
    keywords: post.data.tags.join(', '),
    articleSection: post.data.category ?? 'Insights',
    author: authorSchema,
    publisher: authorSchema,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + `/${locale}/` },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + `/${locale}/insights/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalURL },
    ],
  },
  ...(post.data.faq?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.data.faq.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      }]
    : []),
];
---

<Layout
  htmlLang={localeCopy.htmlLang}
  ogLocale={localeCopy.ogLocale}
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  ogImage={ogImage}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  alternates={localizedInsightAlternates(baseSlug, insightAlternateLocales(allInsightPosts, baseSlug))}
  schema={schema}
>
  <div class="fixed left-0 top-0 z-40 h-1 w-full bg-[color-mix(in_srgb,var(--color-border)_55%,transparent)]" aria-hidden="true" />
  <div id="progress-bar" class="fixed left-0 top-0 z-50 h-1 w-0 bg-[var(--color-accent)] shadow-[0_0_8px_2px_color-mix(in_srgb,var(--color-accent)_55%,transparent)] transition-none" role="progressbar" aria-label="Reading progress" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100} />


  <article
    id="article-content"
    data-slug={slug}
    data-title={post.data.title}
    data-category={post.data.category ?? ''}
    data-tags={post.data.tags.join(',')}
    data-read-time={readMinutes}
    data-pagefind-meta={`date:${post.data.publishedAt.toISOString().split('T')[0]},category:${post.data.category ?? 'Insights'},locale:${locale}`}
  >
    <header class="mx-auto max-w-6xl px-6 pb-10 pt-10 md:pt-16">
      <a href={`/${locale}/insights/`} class="t-caption mb-6 inline-flex items-center gap-1.5 text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-accent)]">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {labels.allInsights}
      </a>
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="t-label text-[var(--color-accent)]">{post.data.category ?? labels.article}</span>
        {post.data.tags.map((tag) => (
          <span class="t-caption rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-0.5 text-[var(--color-text-muted)]">{tag}</span>
        ))}
      </div>
      <h1 class="t-h1 mb-5 max-w-4xl text-[var(--color-text)]" data-pagefind-weight="10">
        {post.data.title}
      </h1>
      <p class="t-lead mb-8 max-w-3xl text-[var(--color-text-muted)]" data-pagefind-weight="5">
        {post.data.description}
      </p>
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
        <div class="flex items-center gap-3">
        <a href={`/${locale}/about/`} aria-label={`${personName(locale)} profile`}>
          <img
            src="/images/wojciech-avatar-2026-384.webp"
            alt={personName(locale)}
            width="36"
            height="36"
            loading="eager"
            decoding="async"
            class="h-9 w-9 rounded-full border-2 border-[var(--color-accent)]/40 object-cover"
          />
        </a>
        <div class="min-w-0">
          <p class="t-small text-[var(--color-text)]">
            <a href={`/${locale}/about/`} class="transition-colors hover:text-[var(--color-accent)]">{personName(locale)}</a>
          </p>
          <p class="t-caption text-[var(--color-text-dim)]">
            {labels.bylineRole} · <a href={`/${locale}/insights/`} class="transition-colors hover:text-[var(--color-accent)]">Insights</a> · {formatDate(post.data.publishedAt)} · {readMinutes} {labels.readTimeSuffix}
          </p>
        </div>
        </div>
        <ArticleShare url={canonicalURL} title={post.data.title} label={labels.share} copyLabel={labels.copyLink} copiedLabel={labels.linkCopied} />
      </div>
    </header>

    <ArticleCover coverType={post.data.coverType} coverImage={post.data.coverImage} tags={post.data.tags} title={post.data.title} />

    <div class="mx-auto max-w-6xl px-6 pb-16 pt-12 md:pt-16 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
      <div class="min-w-0 max-w-[46rem]">
        {post.data.tldr && post.data.tldr.length > 0 && <TLDR items={post.data.tldr} title={labels.tldrTitle} />}

        <div class="prose-content">
          <Content components={mdxComponents} />
        </div>

        <div class="mt-14 border-t border-[var(--color-border)] pt-6" data-pagefind-ignore>
          <ArticleShare url={canonicalURL} title={post.data.title} label={labels.shareArticle} copyLabel={labels.copyLink} copiedLabel={labels.linkCopied} />
        </div>
      </div>

      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-28">
          <ArticleToc headings={headings} label={labels.onThisPage} />
        </div>
      </aside>
    </div>
  </article>

  <section class="mx-auto max-w-6xl px-6 pb-16" data-pagefind-ignore>
    <div class="max-w-[46rem] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6">
      <p class="t-label mb-3 text-[var(--color-accent)]">{labels.authorLabel}</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <img
          src="/images/wojciech-avatar-2026-384.webp"
          alt={personName(locale)}
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
          class="h-12 w-12 rounded-full border border-[var(--color-border)] object-cover"
        />
        <div>
          <h2 class="t-h3 mb-2 text-[var(--color-text)]">{personName(locale)}</h2>
          <p class="t-small mb-4 text-[var(--color-text-muted)]">{labels.authorBio}</p>
          <div class="flex flex-wrap gap-2">
            <a href={`/${locale}/about/`} class="t-caption rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-0.5 text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">Profile</a>
            <a href={`/${locale}/work/`} class="t-caption rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-0.5 text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">Work</a>
            <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="t-caption rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-0.5 text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related && related.length > 0 && (
    <section class="border-t border-[var(--color-border)] py-12" data-pagefind-ignore>
      <div class="mx-auto max-w-6xl px-6">
        <p class="t-label mb-6 text-[var(--color-text-dim)]">{labels.moreFromInsights}</p>
        <div class="grid gap-6 sm:grid-cols-3">
          {related.map((rel) => (
            <a href={`/${locale}/insights/${insightSlug(rel)}/`} class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-hover">
              {rel.data.coverImage && (
                <div class="aspect-[1200/630] overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
                  <img src={versioned(rel.data.coverImage)} alt="" width="1200" height="630" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                </div>
              )}
              <div class="flex flex-1 flex-col gap-2 p-4">
                <p class="t-small font-semibold text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">{rel.data.title}</p>
                <p class="t-caption mt-auto text-[var(--color-text-dim)]">{formatDate(rel.data.publishedAt)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(prevPost || nextPost) && (
    <nav class="border-t border-[var(--color-border)]" aria-label="Article navigation" data-pagefind-ignore>
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-4 px-6 py-8">
        {prevPost ? (
          <a href={`/${locale}/insights/${insightSlug(prevPost)}/`} class="group flex flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 card-hover">
            <span class="t-label flex items-center gap-1.5 text-[var(--color-text-dim)]">{labels.previous}</span>
            <span class="t-small line-clamp-2 text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">{prevPost.data.title}</span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/${locale}/insights/${insightSlug(nextPost)}/`} class="group flex flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 text-right card-hover">
            <span class="t-label flex items-center justify-end gap-1.5 text-[var(--color-text-dim)]">{labels.next}</span>
            <span class="t-small line-clamp-2 text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </div>
    </nav>
  )}

  <section class="border-t border-[var(--color-border)] py-16" data-pagefind-ignore>
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] p-8 md:p-10">
        <p class="t-label mb-3 text-[var(--color-accent)]">{labels.newsletter}</p>
        <h2 class="t-h2 mb-3 text-[var(--color-text)]">{labels.newsletterHeading}</h2>
        <p class="mb-6 max-w-md text-[var(--color-text-muted)]">{labels.newsletterBody}</p>
        <a href="/subscribe/" class="t-button btn-press inline-flex items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3 text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]">
          {labels.subscribe}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const bar = document.getElementById('progress-bar') as HTMLElement;
  const article = document.getElementById('article-content') as HTMLElement;

  function updateProgress() {
    const { top, height } = article.getBoundingClientRect();
    const windowH = window.innerHeight;
    const scrollable = height - windowH;
    const scrolled = Math.max(0, -top);
    const pct = scrollable > 0 ? Math.min(100, (scrolled / scrollable) * 100) : 0;

    bar.style.width = pct + '%';
    bar.setAttribute('aria-valuenow', String(Math.round(pct)));
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
