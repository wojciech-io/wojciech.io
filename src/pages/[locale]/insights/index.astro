---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLocalizedPage } from '../../../data/localizedPages';
import { localizedHome, type LocaleKey } from '../../../data/locales';
import { SITE } from '../../../data/site';
import {
  insightLocaleLabels,
  insightSlug,
  isLocalePost,
  localizedInsightIndexAlternates,
  localizedInsightLocales,
  readTime,
  sortInsights,
} from '../../../lib/insights';

export async function getStaticPaths() {
  return localizedInsightLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleKey;
const localeCopy = localizedHome[locale];
const pageCopy = getLocalizedPage(locale, 'insights');
const labels = insightLocaleLabels[locale];
const allPosts = (await getCollection('insights', isLocalePost(locale))).sort(sortInsights);
const featuredPost = allPosts.find((post) => post.data.featured);
const restPosts = allPosts.filter((post) => post !== featuredPost);

const formatDate = (date: Date) =>
  date.toLocaleDateString(localeCopy.htmlLang, { day: '2-digit', month: 'short', year: 'numeric' });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + `/${locale}/` },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + `/${locale}/insights/` },
  ],
};
---

<Layout
  htmlLang={localeCopy.htmlLang}
  ogLocale={localeCopy.ogLocale}
  title={pageCopy.title}
  description={pageCopy.description}
  canonical={`/${locale}/insights/`}
  ogImage="/og/pages/insights.png"
  alternates={localizedInsightIndexAlternates()}
  schema={breadcrumbSchema}
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{pageCopy.eyebrow}</p>
      <h1 class="mb-4 text-[length:var(--text-h1)] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
        {pageCopy.h1}
      </h1>
      <p class="text-lg leading-relaxed text-[var(--color-text-muted)]">{pageCopy.lead}</p>
    </div>

    {featuredPost && (
      <a
        href={`/${locale}/insights/${insightSlug(featuredPost)}/`}
        class="group mb-10 block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 transition-colors hover:border-[var(--color-accent)]/40 sm:p-8"
        data-featured-article
      >
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{labels.featured}</p>
        <h2 class="mb-3 max-w-3xl text-[length:var(--text-h2)] font-semibold leading-tight text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)]">
          {featuredPost.data.title}
        </h2>
        <p class="mb-5 max-w-3xl text-[var(--color-text-muted)]">{featuredPost.data.description}</p>
        <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--color-text-dim)]">
          <time datetime={featuredPost.data.publishedAt.toISOString()}>{formatDate(featuredPost.data.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{readTime(featuredPost.body, locale)}</span>
          <span aria-hidden="true">·</span>
          <span>{labels.readArticle}</span>
        </div>
      </a>
    )}

    <p class="mb-5 text-sm text-[var(--color-text-dim)]">{allPosts.length} {labels.articles}</p>

    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {restPosts.map((post) => (
        <a
          href={`/${locale}/insights/${insightSlug(post)}/`}
          class="group flex min-h-[260px] flex-col rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-200 hover:-translate-y-px hover:border-[var(--color-border-2)] hover:shadow-[0_6px_28px_rgb(0_0_0/0.10)]"
        >
          <div class="mb-4 flex flex-wrap gap-1.5">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2 py-0.5 text-[11px] font-medium text-[var(--color-text-dim)]">{tag}</span>
            ))}
          </div>
          <h2 class="mb-3 text-base font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)]">
            {post.data.title}
          </h2>
          <p class="mb-5 text-sm leading-relaxed text-[var(--color-text-muted)]">{post.data.description}</p>
          <div class="mt-auto flex items-center justify-between border-t border-[var(--color-border)] pt-3 text-[11px] text-[var(--color-text-dim)]">
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            <span>{readTime(post.body, locale)}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
