---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PosterFeatured from '../../../components/insights/PosterFeatured.astro';
import PosterCard from '../../../components/insights/PosterCard.astro';
import { getLocalizedPage } from '../../../data/localizedPages';
import { localizedHome, type LocaleKey } from '../../../data/locales';
import { SITE } from '../../../data/site';
import {
  insightLocaleLabels,
  insightSlug,
  isLocalePost,
  localizedInsightIndexAlternates,
  localizedInsightLocales,
  readTime,
  sortInsights,
} from '../../../lib/insights';

export async function getStaticPaths() {
  return localizedInsightLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleKey;
const localeCopy = localizedHome[locale];
const pageCopy = getLocalizedPage(locale, 'insights');
const labels = insightLocaleLabels[locale];
const allPosts = (await getCollection('insights', isLocalePost(locale))).sort(sortInsights);
const featuredPost = allPosts.find((post) => post.data.featured);
const restPosts = allPosts.filter((post) => post !== featuredPost);

const formatDate = (date: Date) =>
  date.toLocaleDateString(localeCopy.htmlLang, { day: '2-digit', month: 'short', year: 'numeric' });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + `/${locale}/` },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + `/${locale}/insights/` },
  ],
};
---

<Layout
  htmlLang={localeCopy.htmlLang}
  ogLocale={localeCopy.ogLocale}
  title={pageCopy.title}
  description={pageCopy.description}
  canonical={`/${locale}/insights/`}
  ogImage="/og/pages/insights.png"
  alternates={localizedInsightIndexAlternates()}
  schema={breadcrumbSchema}
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{pageCopy.eyebrow}</p>
      <h1 class="mb-4 text-[length:var(--text-h1)] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
        {pageCopy.h1}
      </h1>
      <p class="text-lg leading-relaxed text-[var(--color-text-muted)]">{pageCopy.lead}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/pl/rss.xml" class="group inline-flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]">
          <svg class="h-4 w-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zM4 10.1a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"/>
          </svg>
          Subskrybuj przez RSS
        </a>
      </div>
    </div>

    {featuredPost && (
      <PosterFeatured
        href={`/${locale}/insights/${insightSlug(featuredPost)}/`}
        title={featuredPost.data.title}
        description={featuredPost.data.description}
        categoryLabel={featuredPost.data.category ?? 'Wpis'}
        categoryKey={featuredPost.data.category ?? ''}
        date={formatDate(featuredPost.data.publishedAt)}
        read={readTime(featuredPost.body, locale)}
        featuredLabel={labels.featured}
        readLabel={labels.readArticle}
      />
    )}

    <p class="mb-5 text-sm text-[var(--color-text-dim)]">{allPosts.length} {labels.articles}</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {restPosts.map((post, i) => (
        <PosterCard
          href={`/${locale}/insights/${insightSlug(post)}/`}
          title={post.data.title}
          categoryLabel={post.data.category ?? 'Wpis'}
          categoryKey={post.data.category ?? ''}
          date={formatDate(post.data.publishedAt)}
          read={readTime(post.body, locale)}
          index={i + 1}
        />
      ))}
    </div>
  </div>
</Layout>
