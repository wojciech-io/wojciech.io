---
import Layout from '../../layouts/Layout.astro';
import {
  htmlLangForLocale,
  localizedPageAlternates,
  localizedPages,
  ogLocaleForLocale,
  type LocalizedPageCopy,
} from '../../data/localizedPages';
import { localizedHome } from '../../data/locales';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return localizedPages
    .filter((copy) => copy.slug !== 'insights')
    .map((copy) => ({
      params: { locale: copy.locale, page: copy.slug },
      props: { copy },
    }));
}

const { copy } = Astro.props as { copy: LocalizedPageCopy };
const locale = localizedHome[copy.locale];
const canonical = `/${copy.locale}/${copy.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': copy.slug === 'contact' ? 'ContactPage' : 'WebPage',
  name: copy.title,
  description: copy.description,
  inLanguage: htmlLangForLocale(copy.locale),
  url: `${SITE.url}${canonical}`,
  isPartOf: { '@type': 'WebSite', name: 'wojciech.io', url: SITE.url + '/' },
};
---

<Layout
  htmlLang={htmlLangForLocale(copy.locale)}
  ogLocale={ogLocaleForLocale(copy.locale)}
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  alternates={localizedPageAlternates(copy.slug)}
  schema={schema}
>
  <section class="relative overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px] opacity-70" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-24">
      {copy.slug === 'about' && (
        <div class="mb-8 lg:mb-0 lg:absolute lg:left-6 lg:top-20 lg:w-[320px]">
          <img
            src="/images/wojciech-speaking-color.webp"
            alt="Wojciech Łuszczyński speaking at Infoshare 2023"
            width="640"
            height="480"
            loading="eager"
            decoding="async"
            class="w-full max-w-xs rounded-[var(--radius-card)] border border-[var(--color-border)] object-cover"
          />
        </div>
      )}
      <div class={copy.slug === 'about' ? 'max-w-3xl lg:pl-[360px]' : 'max-w-3xl'}>
        <span class="obs-label-accent mb-4 block">// {copy.eyebrow}</span>
        <h1 class="reveal-up mb-6 text-[length:var(--text-h1)] font-semibold leading-tight tracking-tight text-[var(--color-text)]" data-reveal-index="0">
          {copy.h1}
        </h1>
        <p class="reveal-up max-w-2xl text-[length:var(--text-body-lg)] leading-relaxed text-[var(--color-text-muted)]" data-reveal-index="1">
          {copy.lead}
        </p>
        <div class="reveal-up mt-8 flex flex-wrap gap-3" data-reveal-index="2">
          <a
            href={copy.primaryHref}
            class="btn-press obs-mono inline-flex rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
            data-mp-cta={copy.primaryCta}
            data-mp-location={`localized_${copy.locale}_${copy.slug}_hero`}
          >
            {copy.primaryCta}
          </a>
          <a
            href={copy.secondaryHref}
            class="btn-press inline-flex rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-bg)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)]"
            data-mp-cta={copy.secondaryCta}
            data-mp-location={`localized_${copy.locale}_${copy.slug}_hero_secondary`}
          >
            {copy.secondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
    <div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-[var(--color-border)] px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {copy.stats.map((stat) => (
        <div class="reveal-up py-7 sm:px-6" data-reveal-index="0">
          <p class="obs-mono mb-1 text-3xl font-semibold text-[var(--color-text)]">{stat.value}</p>
          <p class="obs-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-bg)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-5 lg:grid-cols-3">
        {copy.sections.map((section, index) => (
          <article class="reveal-up obs-panel obs-glow p-6" data-reveal-index={index}>
            <span class="obs-mono text-2xl font-bold text-[var(--color-accent-label)] mb-4 block">{String(index + 1).padStart(2, '0')}</span>
            <h2 class="mb-3 text-xl font-semibold leading-snug text-[var(--color-text)]">{section.title}</h2>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{section.body}</p>
            {section.items && (
              <ul class="mt-5 space-y-2 text-sm text-[var(--color-text-muted)]">
                {section.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
      {copy.slug === 'contact' && (
        <div class="mt-10 text-center">
          <a
            href="https://cal.com/wojciech-luszczynski/30min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press inline-flex items-center justify-center gap-2.5 border border-[var(--color-border)] bg-[var(--color-glass)] backdrop-blur px-7 py-3.5 rounded-[var(--radius-btn)] font-semibold text-[var(--color-text)] hover:border-[var(--color-accent-cta)] hover:bg-[var(--color-accent-lo)] transition-all"
          >
            <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {copy.primaryCta || 'Pick a time slot'}
            <svg class="w-3 h-3 opacity-50" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      )}

      {copy.slug === 'about' && (
        <div class="mt-10 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden">
          <a href="https://www.youtube.com/watch?v=UWJN-DwqDbE" target="_blank" rel="noopener noreferrer" class="group relative block aspect-video">
            <img
              src="https://img.youtube.com/vi/UWJN-DwqDbE/maxresdefault.jpg"
              alt="Wojciech Łuszczyński at Infoshare 2023"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-opacity group-hover:opacity-80"
            />
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-accent-text)] shadow-lg">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
          </a>
        </div>
      )}

      <div class="mt-10 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div>
          <span class="obs-label-accent block">// {copy.eyebrow}</span>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-text-muted)]">
            {copy.description}
          </p>
        </div>
        <a
          href={copy.primaryHref}
          class="btn-press mt-5 inline-flex shrink-0 rounded-[var(--radius-btn)] bg-[var(--color-text)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition-colors hover:opacity-90 sm:mt-0"
          data-mp-cta={copy.primaryCta}
          data-mp-location={`localized_${copy.locale}_${copy.slug}_footer`}
        >
          {copy.primaryCta}
        </a>
      </div>
    </div>
  </section>
</Layout>
