---
import Layout from '../../layouts/Layout.astro';
import {
  htmlLangForLocale,
  localizedPageAlternates,
  localizedPages,
  ogLocaleForLocale,
  type LocalizedPageCopy,
} from '../../data/localizedPages';
import { localizedHome } from '../../data/locales';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return localizedPages
    .filter((copy) => copy.slug !== 'insights')
    .map((copy) => ({
      params: { locale: copy.locale, page: copy.slug },
      props: { copy },
    }));
}

const { copy } = Astro.props as { copy: LocalizedPageCopy };
const locale = localizedHome[copy.locale];
const canonical = `/${copy.locale}/${copy.slug}/`;
const isAbout = copy.slug === 'about';
const isContact = copy.slug === 'contact';
const schema = {
  '@context': 'https://schema.org',
  '@type': isContact ? 'ContactPage' : 'WebPage',
  name: copy.title,
  description: copy.description,
  inLanguage: htmlLangForLocale(copy.locale),
  url: `${SITE.url}${canonical}`,
  isPartOf: { '@type': 'WebSite', name: 'wojciech.io', url: SITE.url + '/' },
};
---

<Layout
  htmlLang={htmlLangForLocale(copy.locale)}
  ogLocale={ogLocaleForLocale(copy.locale)}
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  alternates={localizedPageAlternates(copy.slug)}
  schema={schema}
>
  <section class="relative overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px] opacity-70" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-24">
      <div class:list={['max-w-3xl', isAbout && 'flex flex-col sm:flex-row gap-10 items-start sm:items-center max-w-none']}>

        {isAbout && (
          <div class="shrink-0 w-48 h-60 sm:w-56 sm:h-72 rounded-[var(--radius-card)] overflow-hidden ring-1 ring-[var(--color-border)] shadow-[0_0_28px_rgba(235,255,0,0.08)]">
            <img
              src="/images/wojciech-speaking-color.webp"
              alt="Wojciech Łuszczyński"
              class="w-full h-full object-cover object-[center_15%]"
              width="900"
              height="1429"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )}

        <div class:list={[isAbout ? 'max-w-xl' : 'max-w-3xl']}>
          <p class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
            {copy.eyebrow}
          </p>
          <h1 class="reveal-up mb-6 text-[length:var(--text-h1)] font-semibold leading-tight tracking-tight text-[var(--color-text)]" data-reveal-index="0">
            {copy.h1}
          </h1>
          <p class="reveal-up max-w-2xl text-[length:var(--text-body-lg)] leading-relaxed text-[var(--color-text-muted)]" data-reveal-index="1">
            {copy.lead}
          </p>
          <div class="reveal-up mt-8 flex flex-wrap gap-3" data-reveal-index="2">
            <a
              href={copy.primaryHref}
              class="btn-press inline-flex rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
              data-mp-cta={copy.primaryCta}
              data-mp-location={`localized_${copy.locale}_${copy.slug}_hero`}
            >
              {copy.primaryCta}
            </a>
            <a
              href={copy.secondaryHref}
              class="btn-press inline-flex rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-bg)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)]"
              data-mp-cta={copy.secondaryCta}
              data-mp-location={`localized_${copy.locale}_${copy.slug}_hero_secondary`}
            >
              {copy.secondaryCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
    <div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-[var(--color-border)] px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {copy.stats.map((stat) => (
        <div class="reveal-up py-7 sm:px-6" data-reveal-index="0">
          <p class="mb-1 text-3xl font-semibold text-[var(--color-text)]">{stat.value}</p>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-bg)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-5 lg:grid-cols-3">
        {copy.sections.map((section, index) => (
          <article class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6" data-reveal-index={index}>
            <p class="mb-4 font-mono text-xs text-[var(--color-text-dim)]">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mb-3 text-xl font-semibold leading-snug text-[var(--color-text)]">{section.title}</h2>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{section.body}</p>
            {section.items && (
              <ul class="mt-5 space-y-2 text-sm text-[var(--color-text-muted)]">
                {section.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>

      {/* Cal.com booking for contact pages */}
      {isContact && (
        <div class="mt-12 text-center">
          <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-text)] leading-tight mb-3" id="book-call">
            {copy.primaryCta}
          </h2>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-8 max-w-lg mx-auto">
            {copy.lead}
          </p>
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden shadow-sm">
            <iframe
              src="https://cal.com/wojciech-luszczynski/30min?embed=true&layout=month_view&theme=auto"
              class="w-full border-0"
              style="height: 600px; min-height: 500px;"
              loading="lazy"
              title="Book a call with Wojciech"
            ></iframe>
          </div>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-[var(--color-text-muted)]">
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
            >
              <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex items-center gap-2 text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
              {SITE.email}
            </a>
          </div>
        </div>
      )}

      {/* YouTube talk for about pages */}
      {isAbout && (
        <div class="mt-12">
          <a
            href="https://www.youtube.com/watch?v=UWJN-DwqDbE"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 transition-colors"
            aria-label="Watch the talk on YouTube"
          >
            <div class="relative h-52 overflow-hidden bg-[var(--color-surface-2)]">
              <img
                src="https://i.ytimg.com/vi/UWJN-DwqDbE/maxresdefault.jpg"
                alt=""
                class="w-full h-full object-cover object-[center_30%] group-hover:scale-[1.03] transition-transform duration-500"
                loading="lazy"
                decoding="async"
                onerror="this.src='/images/wojciech-speaking-color.webp';this.style.objectPosition='center 15%'"
              />
              <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                <div class="w-14 h-14 rounded-full bg-white/90 flex items-center justify-center group-hover:scale-110 transition-transform duration-200 shadow-lg">
                  <svg class="w-6 h-6 text-black ml-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.84Z"/></svg>
                </div>
              </div>
            </div>
            <div class="px-5 py-4">
              <p class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-1.5">YouTube &middot; Talk</p>
              <p class="text-sm font-semibold text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors">Infoshare 2023 &middot; AI systems, GTM, and building products</p>
            </div>
          </a>
        </div>
      )}

      <div class="mt-10 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{copy.eyebrow}</p>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-text-muted)]">
            {copy.description}
          </p>
        </div>
        <a
          href={copy.primaryHref}
          class="btn-press mt-5 inline-flex shrink-0 rounded-[var(--radius-btn)] bg-[var(--color-text)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition-colors hover:opacity-90 sm:mt-0"
          data-mp-cta={copy.primaryCta}
          data-mp-location={`localized_${copy.locale}_${copy.slug}_footer`}
        >
          {copy.primaryCta}
        </a>
      </div>
    </div>
  </section>
</Layout>
