---
import Layout from '../../layouts/Layout.astro';
import {
  htmlLangForLocale,
  localizedPageAlternates,
  localizedPages,
  ogLocaleForLocale,
  type LocalizedPageCopy,
} from '../../data/localizedPages';
import { localizedHome } from '../../data/locales';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return localizedPages
    .filter((copy) => copy.slug !== 'insights')
    .map((copy) => ({
      params: { locale: copy.locale, page: copy.slug },
      props: { copy },
    }));
}

const { copy } = Astro.props as { copy: LocalizedPageCopy };
const locale = localizedHome[copy.locale];
const canonical = `/${copy.locale}/${copy.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': copy.slug === 'contact' ? 'ContactPage' : 'WebPage',
  name: copy.title,
  description: copy.description,
  inLanguage: htmlLangForLocale(copy.locale),
  url: `${SITE.url}${canonical}`,
  isPartOf: { '@type': 'WebSite', name: 'wojciech.io', url: SITE.url + '/' },
};

const isContact = copy.slug === 'contact';
const calUrl = 'https://cal.com/wojciech-luszczynski/30min';

/* Contact form labels per locale */
const contactLabels: Record<string, { name: string; email: string; message: string; messageHelp: string; send: string; alt: string; altSub: string; or: string; formIntro: string }> = {
  de: { name: 'Name', email: 'E-Mail', message: 'Woran arbeitest du?', messageHelp: 'Ziel, aktueller Stand, Stack. Was mir hilft, das Problem zu verstehen.', send: 'Nachricht senden', alt: 'Auf LinkedIn schreiben', altSub: 'Zeitzone: Europe/Berlin', or: 'Oder schreib mir', formIntro: 'Schick den Kontext, den Engpass und den aktuellen Stack. Ich antworte innerhalb von 24h.' },
  dk: { name: 'Navn', email: 'E-mail', message: 'Hvad arbejder du med?', messageHelp: 'Mål, nuværende tilstand, stak. Alt, der hjælper mig med at forstå problemet.', send: 'Send besked', alt: 'Skriv på LinkedIn', altSub: 'Tidszone: Europe/Berlin', or: 'Eller send en besked', formIntro: 'Send kontekst, flaskehals og nuværende stak. Jeg svarer inden for 24 timer.' },
  no: { name: 'Navn', email: 'E-post', message: 'Hva jobber du med?', messageHelp: 'Mål, nåværende status, stack. Det som hjelper meg forstå problemet.', send: 'Send melding', alt: 'Skriv på LinkedIn', altSub: 'Tidssone: Europe/Berlin', or: 'Eller send en melding', formIntro: 'Send kontekst, flaskehals og nåværende stack. Jeg svarer innen 24 timer.' },
  jp: { name: '名前', email: 'メールアドレス', message: '取り組んでいることは?', messageHelp: '目標、現状、スタック。問題理解に役立つ情報を。', send: 'メッセージを送る', alt: 'LinkedInで連絡', altSub: 'タイムゾーン: Europe/Berlin', or: 'またはメッセージを送る', formIntro: 'コンテキスト、ボトルネック、現在のスタックを送ってください。24時間以内に返信します。' },
  it: { name: 'Nome', email: 'Email', message: 'A cosa stai lavorando?', messageHelp: 'Obiettivo, stato attuale, stack. Tutto ciò che mi aiuta a capire il problema.', send: 'Invia messaggio', alt: 'Scrivi su LinkedIn', altSub: 'Fuso orario: Europe/Berlin', or: 'Oppure invia un messaggio', formIntro: 'Invia contesto, collo di bottiglia e stack attuale. Rispondo entro 24 ore.' },
  es: { name: 'Nombre', email: 'Email', message: 'En qué estás trabajando?', messageHelp: 'Objetivo, estado actual, stack. Lo que me ayude a entender el problema.', send: 'Enviar mensaje', alt: 'Escribir en LinkedIn', altSub: 'Zona horaria: Europe/Berlin', or: 'O envía un mensaje', formIntro: 'Envía contexto, cuello de botella y stack actual. Respondo en 24 horas.' },
  pl: { name: 'Imię', email: 'Email', message: 'Nad czym pracujesz?', messageHelp: 'Cel, stan aktualny, stack. Cokolwiek pomoże mi zrozumieć problem.', send: 'Wyślij wiadomość', alt: 'Napisz na LinkedIn', altSub: 'Strefa: Europe/Berlin', or: 'Lub napisz do mnie', formIntro: 'Wyślij kontekst, wąskie gardło i aktualny stack. Odpowiadam w ciągu 24h.' },
};
const labels = isContact ? contactLabels[copy.locale] || contactLabels['de'] : null;
---

<Layout
  htmlLang={htmlLangForLocale(copy.locale)}
  ogLocale={ogLocaleForLocale(copy.locale)}
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  alternates={localizedPageAlternates(copy.slug)}
  schema={schema}
>

  {isContact ? (
    <!-- Contact: dedicated layout matching EN /contact/ -->
    <Fragment>
      <!-- Hero: booking is the primary CTA -->
      <section id="book-call" class="relative pt-10 pb-10 md:pt-14 md:pb-12 overflow-hidden border-b border-[var(--color-border)]">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px] opacity-70" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-3xl px-6 text-center">
          <span class="obs-label-accent mb-4 block">{copy.eyebrow}</span>
          <h1 class="reveal-up text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" data-reveal-index="0">
            {copy.h1}
          </h1>
          <p class="reveal-up text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto mb-8" data-reveal-index="1">
            {copy.lead}
          </p>
        </div>

        <!-- Embedded scheduler: the calendar IS the CTA on this page. -->
        <div class="relative mx-auto max-w-5xl px-6">
          <div
            data-cal-inline="wojciech-luszczynski/30min"
            class="min-h-[620px] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden"
          ></div>
          <p class="mt-4 text-center text-sm text-[var(--color-text-muted)]">
            <a
              href={calUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
              data-mp-cta={copy.primaryCta}
              data-mp-location={`localized_${copy.locale}_contact_hero_fallback`}
            >{copy.primaryCta} →</a>
          </p>
        </div>
      </section>

      <!-- Info columns -->
      <section class="py-12 md:py-16 border-t border-b border-[var(--color-border)]">
        <div class="mx-auto max-w-5xl px-6">
          <div class="grid md:grid-cols-3 gap-8 md:gap-10">
            {copy.sections.map((section, i) => (
              <div>
                <p class="obs-label-accent mb-3 block">{section.title}</p>
                <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{section.body}</p>
                {section.items && (
                  <ul class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
                    {section.items.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
          <!-- LinkedIn alternative -->
          <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-8 border-t border-[var(--color-border)]">
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
            >
              <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              {labels!.alt}
            </a>
            <span class="text-xs text-[var(--color-text-dim)]">{labels!.altSub}</span>
          </div>
        </div>
      </section>

    </Fragment>
  ) : (
    <!-- Generic layout: about, work, ai-systems, insights -->
    <Fragment>
      <section class="relative overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px] opacity-70" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-24">
          {copy.slug === 'about' && (
            <div class="mb-8 lg:mb-0 lg:absolute lg:left-6 lg:top-20 lg:w-[320px]">
              <img
                src="/images/wojciech-avatar-768.webp"
                alt="Wojciech Łuszczyński"
                width="768"
                height="768"
                loading="eager"
                decoding="async"
                class="w-full max-w-xs aspect-square rounded-[var(--radius-card)] border border-[var(--color-border)] object-cover"
              />
            </div>
          )}
          <div class={copy.slug === 'about' ? 'max-w-3xl lg:pl-[360px]' : 'max-w-3xl'}>
            <div class="flex items-center gap-3 mb-4">
              <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
              <span class="obs-label-accent">{copy.eyebrow}</span>
            </div>
            <h1 class="reveal-up mb-6 text-[length:var(--text-h1)] font-semibold leading-tight tracking-tight text-[var(--color-text)]" data-reveal-index="0">
              {copy.h1}
            </h1>
            <p class="reveal-up max-w-2xl text-[length:var(--text-body-lg)] leading-relaxed text-[var(--color-text-muted)]" data-reveal-index="1">
              {copy.lead}
            </p>
            <div class="reveal-up mt-8 flex flex-wrap gap-3" data-reveal-index="2">
              <a
                href={copy.primaryHref}
                class="btn-press obs-mono inline-flex rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
                data-mp-cta={copy.primaryCta}
                data-mp-location={`localized_${copy.locale}_${copy.slug}_hero`}
              >
                {copy.primaryCta}
              </a>
              <a
                href={copy.secondaryHref}
                class="btn-press inline-flex rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-bg)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)]"
                data-mp-cta={copy.secondaryCta}
                data-mp-location={`localized_${copy.locale}_${copy.slug}_hero_secondary`}
              >
                {copy.secondaryCta}
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
        <div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-[var(--color-border)] px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {copy.stats.map((stat) => (
            <div class="reveal-up py-7 sm:px-6" data-reveal-index="0">
              <p class="obs-mono mb-1 text-3xl font-semibold text-[var(--color-text)]">{stat.value}</p>
              <p class="obs-label">{stat.label}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="bg-[var(--color-bg)] py-[var(--space-section)]">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid gap-5 lg:grid-cols-3">
            {copy.sections.map((section, index) => (
              <article class="reveal-up obs-panel obs-glow p-6" data-reveal-index={index}>
                <span class="obs-mono text-2xl font-bold text-[var(--color-accent-label)] mb-4 block">{String(index + 1).padStart(2, '0')}</span>
                <h2 class="mb-3 text-xl font-semibold leading-snug text-[var(--color-text)]">{section.title}</h2>
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{section.body}</p>
                {section.items && (
                  <ul class="mt-5 space-y-2 text-sm text-[var(--color-text-muted)]">
                    {section.items.map((item) => (
                      <li class="flex gap-2">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>

          {copy.slug === 'about' && (
            <div class="mt-10 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden">
              <a href="https://www.youtube.com/watch?v=UWJN-DwqDbE" target="_blank" rel="noopener noreferrer" class="group relative block aspect-video">
                <img
                  src="https://img.youtube.com/vi/UWJN-DwqDbE/maxresdefault.jpg"
                  alt="Wojciech Łuszczyński at Infoshare 2023"
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-opacity group-hover:opacity-80"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-accent-text)] shadow-lg">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </span>
              </a>
            </div>
          )}

          <div class="mt-10 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
            <div>
              <span class="obs-label-accent block">{copy.eyebrow}</span>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-text-muted)]">
                {copy.description}
              </p>
            </div>
            <a
              href={copy.primaryHref}
              class="btn-press mt-5 inline-flex shrink-0 rounded-[var(--radius-btn)] bg-[var(--color-text)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition-colors hover:opacity-90 sm:mt-0"
              data-mp-cta={copy.primaryCta}
              data-mp-location={`localized_${copy.locale}_${copy.slug}_footer`}
            >
              {copy.primaryCta}
            </a>
          </div>
        </div>
      </section>
    </Fragment>
  )}
</Layout>
