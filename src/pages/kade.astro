---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kade',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Web, macOS',
  url: `${SITE.url}/kade/`,
  image: `${SITE.url}/images/kade/icon-512.png`,
  description: 'A private local-first link vault for URLs that need notes, ratings, previews and visit history.',
  author: {
    '@type': 'Person',
    name: SITE.nameDisplay,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.nameDisplay,
    url: SITE.url,
  },
};

const workflow = [
  ['Drop', 'Save a single URL or import a batch of bookmarks.'],
  ['Classify', 'Attach category, monthly bucket, source status and short keywords.'],
  ['Review', 'Use notes, ratings, best bites and previews to decide what deserves attention.'],
  ['Demote', 'Visited links move down the queue without losing their context.'],
];

const security = [
  ['Local-first', 'The working vault is designed around local encrypted state, not a public profile or social feed.'],
  ['Public clean', 'The wojciech.io page ships product copy and visuals only. Private vault data never belongs in the public package.'],
  ['Native path', 'The macOS version is the right place for Touch ID, Keychain-protected keys and background sync.'],
];
---

<Layout
  title="Kade — private link vault"
  description="A private local-first link vault for saving URLs with context, ratings, previews and visit history."
  canonical="/kade/"
  ogImage="/images/kade/dashboard.png"
  schema={schema}
>
  <section class="relative min-h-[88svh] overflow-hidden border-b border-[var(--color-border)]">
    <img
      src="/images/kade/dashboard.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center opacity-[0.28] dark:opacity-[0.38]"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-bg)_0%,rgba(10,10,10,0.88)_44%,rgba(10,10,10,0.44)_100%),linear-gradient(180deg,rgba(10,10,10,0)_40%,var(--color-bg)_100%)]" aria-hidden="true"></div>

    <div class="relative mx-auto flex min-h-[88svh] max-w-6xl items-end px-6 py-16 md:py-24">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex items-center gap-3 rounded-[var(--radius-btn)] border border-[var(--color-border)] bg-[var(--color-surface)]/70 px-3 py-2 backdrop-blur">
          <img src="/images/kade/icon.svg" alt="" class="h-8 w-8 rounded-md" loading="eager" decoding="async" />
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Kade</span>
        </div>
        <h1 class="max-w-3xl text-5xl font-semibold leading-[0.95] tracking-tight text-[var(--color-text)] md:text-7xl">
          A private queue for links that matter later.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-text-muted)] md:text-xl">
          Kade turns saved URLs into a local encrypted workspace: notes, ratings, categories, previews, visit history and monthly drops without an account.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact#book-call" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-3 text-sm font-semibold text-[var(--color-accent-text)] transition-opacity hover:opacity-90">
            Request private build
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/insights/kade-local-first-link-vault/" class="btn-press inline-flex items-center justify-center rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]">
            Read the build note
          </a>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          {['Encrypted locally', 'No account required', 'Dashboard first', 'macOS native path'].map((item) => (
            <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/75 px-3 py-1 text-xs font-medium text-[var(--color-text-muted)] backdrop-blur">{item}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Why it exists</p>
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-[var(--color-text)] md:text-4xl">Bookmarks are storage. Kade is recall.</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-[var(--color-text-muted)]">
          Most saved links fail later because the browser remembers the URL, not the reason you saved it. Kade keeps the decision layer close to each link so the next open starts with context instead of archaeology.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Dashboard first', 'Queue health, categories and next actions before the raw list.'],
          ['Context attached', 'Notes, ratings and best bites while the reason is still fresh.'],
          ['Previews where useful', 'Thumbnails appear in the link view, not on the dashboard.'],
          ['Visited links drop', 'Opened items move lower without losing their original category.'],
        ].map(([title, text]) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <h3 class="mb-2 text-base font-semibold text-[var(--color-text)]">{title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Workflow</p>
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-[var(--color-text)] md:text-4xl">Save the link. Save the reason.</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-4">
        {workflow.map(([title, text], index) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <span class="mb-5 inline-grid h-9 w-9 place-items-center rounded-[var(--radius-btn)] border border-[var(--color-accent)]/35 bg-[var(--color-accent)]/10 text-sm font-semibold text-[var(--color-accent)]">{index + 1}</span>
            <h3 class="mb-2 text-lg font-semibold text-[var(--color-text)]">{title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)]">
        <img src="/images/kade/mobile.png" alt="Kade mobile link view" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Security stance</p>
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-[var(--color-text)] md:text-4xl">Private by architecture, quiet by copy.</h2>
        <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
          A link vault can reveal projects, habits and timing even when it is not a password manager. Kade keeps that boundary explicit: product page public, vault contents private, native macOS path for system-grade unlock.
        </p>
        <div class="mt-7 grid gap-3">
          {security.map(([title, text]) => (
            <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
              <h3 class="text-sm font-semibold text-[var(--color-text)]">{title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-[var(--color-text-muted)]">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse at 20% 50%, rgba(235,255,0,0.04) 0%, transparent 60%);" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Native path</p>
        <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">The Mac app is where Kade gets serious.</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          Touch ID, Keychain-protected keys, background sync and local metadata generation belong in the native app, not in a browser-only prototype.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="/insights/kade-local-first-link-vault/" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          Read the article
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/apps/" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]">
          See apps
        </a>
      </div>
    </div>
  </section>
</Layout>
