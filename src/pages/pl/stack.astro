---
import Layout from '../../layouts/Layout.astro';
import Flow from '../../components/insights/Flow.astro';
import Diagram from '../../components/insights/diagrams/Diagram.astro';
import Box from '../../components/insights/diagrams/Box.astro';
import Arrow from '../../components/insights/diagrams/Arrow.astro';
import Stack from '../../components/insights/diagrams/Stack.astro';

// Ukryty przegląd inżynieryjny. Niebudowany w nawigacji, noindex + nofollow,
// wyłączony z sitemapy. Tylko z bezpośredniego linku.

const subdomains = [
  { host: 'wojciech.io', role: 'Publiczne portfolio: insights, case studies, CV, narzędzia', access: 'Publiczny' },
  { host: 'app.wojciech.io', role: 'Prywatny workspace operacyjny', access: 'Brama hasłowa' },
  { host: 'gh.wojciech.io', role: 'Dashboard analityki GrowthHub', access: 'Brama hasłowa' },
  { host: 'academy.wojciech.io', role: 'Academy', access: 'Publiczny + strefa członkowska' },
  { host: 'notch.wojciech.io', role: 'Notch', access: 'Publiczny' },
  { host: 'subscribe.wojciech.io', role: 'Lejek newsletterowy', access: 'Publiczny' },
  { host: 'dev (wewnętrzny)', role: 'Dashboard deweloperski, kondycja agentów', access: 'Wewnętrzny' },
];

const securityChecks = [
  { name: 'Gitleaks · skan sekretów', detail: 'Pełna historia git, każdy PR + cotygodniowy cron' },
  { name: 'Audyt zależności', detail: 'npm audit, fail przy high/critical' },
  { name: 'Semgrep SAST', detail: 'p/default · p/javascript · p/typescript' },
  { name: 'CodeQL', detail: 'Analiza kodu: push/PR + co tydzień' },
  { name: 'Content guard', detail: 'Pre-commit + CI + co tydzień: nazwy NDA, wzorce kluczy' },
  { name: 'Sensitive path guard', detail: 'Blokuje PR-y dotykające chronionych ścieżek' },
  { name: 'Sonda nagłówków bezpieczeństwa', detail: '6 nagłówków weryfikowane na 6 subdomenach' },
  { name: 'Branch protection', detail: 'Wymagane checki przed merge do main' },
  { name: 'Dostępność (axe)', detail: 'Bramka a11y w Playwright: Chromium + WebKit' },
  { name: 'Lighthouse CI', detail: 'Cotygodniowy audyt performance, a11y, SEO' },
];

const techGroups = [
  { label: 'Frontend i treść', icons: [
    { name: 'Astro', slug: 'astro' }, { name: 'TypeScript', slug: 'typescript' },
    { name: 'Tailwind CSS', slug: 'tailwindcss' }, { name: 'Vite', slug: 'vite' },
    { name: 'MDX', slug: 'mdx' }, { name: 'Pagefind', mark: 'PF' },
  ]},
  { label: 'Animacja i interakcja', icons: [
    { name: 'Motion', slug: 'framer' }, { name: 'Lenis', mark: 'LN' },
    { name: 'View Transitions', mark: 'VT' },
  ]},
  { label: 'Edge i infrastruktura', icons: [
    { name: 'Cloudflare', slug: 'cloudflare' }, { name: 'Workers', slug: 'cloudflareworkers' },
    { name: 'Pages', slug: 'cloudflarepages' }, { name: 'D1', mark: 'D1' }, { name: 'KV', mark: 'KV' },
    { name: 'Terraform', slug: 'terraform' }, { name: 'GitHub Actions', slug: 'githubactions' },
  ]},
  { label: 'Pomiar i operacje', icons: [
    { name: 'GA4', slug: 'googleanalytics' }, { name: 'Mixpanel', slug: 'mixpanel' },
    { name: 'PostHog', slug: 'posthog' }, { name: 'Sentry', slug: 'sentry' },
    { name: 'Better Stack', mark: 'BS' }, { name: 'Linear', slug: 'linear' },
  ]},
  { label: 'Płatności i email', icons: [
    { name: 'Stripe', slug: 'stripe' }, { name: 'Resend', slug: 'resend' },
  ]},
];

const cardClass = 'rounded-[var(--radius-card)] border border-[var(--color-border)] p-5';
const h2Class = 'text-xl font-semibold text-[var(--color-text)] mb-1';
const eyebrowClass = 'text-xs font-semibold uppercase tracking-widest text-[var(--color-accent-hi)] mb-2';
---

<Layout
  htmlLang="pl-PL"
  ogLocale="pl_PL"
  title="Stack inżynieryjny i bezpieczeństwo · wojciech.io"
  description="Wewnętrzny przegląd wojciech.io i subdomen: architektura, narzędzia, animacja, CI/CD, bezpieczeństwo, odporność i wieloagentowy model pracy."
  canonical="/pl/stack/"
  noindex={true}
>
  <div class="mx-auto max-w-4xl px-6 py-[var(--space-section)]">

    <header class="mb-14">
      <p class={eyebrowClass}>Przegląd inżynieryjny · link prywatny</p>
      <h1 class="text-4xl sm:text-5xl font-semibold text-[var(--color-text)] tracking-tight mb-4">
        Jak to jest zbudowane.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
        wojciech.io to jeden system operacyjny rozpięty na siedmiu powierzchniach: monorepo Astro
        na Cloudflare, z bramką CI, warstwowym bezpieczeństwem, automatycznym failoverem,
        animacyjnym UI i wieloagentowym modelem pracy. Tu opisuję całość.
      </p>
      <p class="text-sm text-[var(--color-text-dim)] mt-4">Ostatnia weryfikacja: maj 2026 · niezaindeksowane, brak w nawigacji</p>
    </header>

    <div class="space-y-16 text-[var(--color-text-muted)] leading-relaxed">

      <!-- 0. Architektura na pierwszy rzut oka -->
      <section>
        <p class={eyebrowClass}>Jak to się składa</p>
        <h2 class={h2Class}>Od git push do edge</h2>
        <Flow
          caption="Każdy merge do main przechodzi przez bramkę zanim cokolwiek pójdzie na produkcję."
          steps={[
            { label: 'git push', sub: 'main' },
            { label: 'Bramka CI', sub: 'build · test · a11y' },
            { label: 'Deploy', sub: 'Wrangler' },
            { label: 'Cloudflare', sub: '7 projektów Pages' },
            { label: 'Edge', sub: 'Functions · D1 · KV', active: true },
          ]}
        />
        <Diagram direction="column" caption="Runtime, odporność i obserwowalność wokół edge.">
          <Box variant="accent" label="Cloudflare Pages" sub="static + edge, 7 powierzchni" />
          <Arrow direction="down" label="żądanie" />
          <Diagram direction="row">
            <Box variant="outline" label="Pages Functions" sub="auth · API" />
            <Arrow label="odczyt/zapis" />
            <Stack>
              <Box variant="muted" label="D1" sub="członkowie · sesje" />
              <Box variant="muted" label="KV" sub="rate limiting" />
            </Stack>
          </Diagram>
          <Arrow direction="down" dashed label="health check · co 5 min" />
          <Diagram direction="row">
            <Box variant="outline" label="Failover Worker" sub="cron monitor" />
            <Arrow label="zmiana DNS" dashed />
            <Box variant="muted" label="Azure standby" sub="zimna kopia" />
          </Diagram>
          <Arrow direction="down" dashed label="sygnały" />
          <Stack direction="row">
            <Box variant="muted" label="Better Stack" sub="uptime · incydenty" />
            <Box variant="muted" label="Sentry" sub="błędy · perf" />
          </Stack>
        </Diagram>
      </section>

      <!-- 1. Architektura -->
      <section>
        <p class={eyebrowClass}>01 · Architektura</p>
        <h2 class={h2Class}>Jedno repo, siedem powierzchni</h2>
        <p class="mt-3">
          Jedno monorepo npm-workspaces na <strong class="text-[var(--color-text)]">Astro 6</strong>,
          całość hostowana na <strong class="text-[var(--color-text)]">Cloudflare</strong>. Statycznie tam,
          gdzie się da, <strong class="text-[var(--color-text)]">Cloudflare Pages Functions</strong> (edge) tam,
          gdzie potrzebna jest logika: auth i API. Jeden pipeline, siedem niezależnie wdrażanych projektów.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 mt-6">
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Frontend</p>
            <p class="text-sm">Astro 6 + MDX · Tailwind CSS 4 (Vite plugin) · własne właściwości CSS jako design tokens · krój Geist. Strony oparte o własną bibliotekę komponentów MDX (diagramy, callouty, bloki statystyk, ta strona też).</p>
          </div>
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Build-time</p>
            <p class="text-sm">Obrazy OG przez Satori + resvg (SVG do PNG) · indeks Pagefind budowany po buildzie · generacja sitemapy z filtrem indeksowalności.</p>
          </div>
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Współdzielone paczki</p>
            <p class="text-sm">
              Trzy wewnętrzne paczki workspace trzymają powierzchnie w ryzach:
              <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">@wojciech/tokens</code> (design tokens),
              <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">@wojciech/ui</code> (wspólne komponenty),
              <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">@wojciech/mdx-components</code> (klocki MDX).
            </p>
          </div>
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Infrastruktura jako kod</p>
            <p class="text-sm">Projekty Cloudflare Pages i domeny customowe są provisionowane przez Terraform, reguły WAF udokumentowane obok configu. D1 (SQLite na edge) trzyma członków i sesje; Workers KV stoi za rate limitingiem. Bez zewnętrznej bazy.</p>
          </div>
        </div>
      </section>

      <!-- 2. Animacja i interakcja -->
      <section>
        <p class={eyebrowClass}>02 · Motion</p>
        <h2 class={h2Class}>Animacja i interakcja</h2>
        <p class="mt-3">
          Motion to część systemu, nie dekoracja. Jest GPU-friendly, respektuje
          <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">prefers-reduced-motion</code>
          i nigdy nie blokuje głównego wątku.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 mt-6">
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Motion</strong><span class="text-sm">Animacje typu spring i tween dla hero, kart i reveal-on-scroll, oparte na bibliotece <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">motion</code>.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Lenis</strong><span class="text-sm">Płynny, bezwładnościowy scroll wpięty w timeline reveal, z bezpiecznym fallbackiem dla reduced motion.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">View Transitions</strong><span class="text-sm">ClientRouter Astro daje aplikacyjne przejścia między stronami, a strona zostaje w pełni statyczna i indeksowalna.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Scroll choreography</strong><span class="text-sm">Sekcje wjeżdżają z dołu i się odsłaniają; intersection observers układają wejście w kaskady tak, że strona składa się w trakcie czytania.</span></div>
        </div>
      </section>

      <!-- 3. Subdomeny -->
      <section>
        <p class={eyebrowClass}>03 · Powierzchnie</p>
        <h2 class={h2Class}>Subdomeny</h2>
        <p class="mt-3">Każda powierzchnia to osobny projekt Cloudflare Pages, deployowany niezależnie. To samo monorepo, ta sama bramka, te same design tokens.</p>

        <Diagram direction="column" caption="Jedno repo rozgałęzia się w siedem niezależnie wdrażanych powierzchni.">
          <Box variant="accent" label="wojciech.io" sub="monorepo · jedna bramka CI" />
          <Arrow direction="down" dashed label="fan-out · 7 projektów Pages" />
          <Stack direction="row" gap="sm">
            <Box variant="default" label="wojciech.io" sub="portfolio publiczne" />
            <Box variant="outline" label="app.wojciech.io" sub="brama hasłowa" />
            <Box variant="outline" label="gh.wojciech.io" sub="brama hasłowa" />
            <Box variant="default" label="academy.wojciech.io" sub="publiczne + członkowie" />
            <Box variant="default" label="notch.wojciech.io" sub="publiczne" />
            <Box variant="default" label="subscribe.wojciech.io" sub="publiczne" />
            <Box variant="muted" label="dev" sub="wewnętrzne" />
          </Stack>
        </Diagram>

        <div class="mt-6 overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)]">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
                <th class="text-left font-semibold text-[var(--color-text)] px-4 py-3">Domena</th>
                <th class="text-left font-semibold text-[var(--color-text)] px-4 py-3">Rola</th>
                <th class="text-left font-semibold text-[var(--color-text)] px-4 py-3">Dostęp</th>
              </tr>
            </thead>
            <tbody>
              {subdomains.map((s) => (
                <tr class="border-b border-[var(--color-border)] last:border-0">
                  <td class="px-4 py-3 font-mono text-xs text-[var(--color-text)] whitespace-nowrap">{s.host}</td>
                  <td class="px-4 py-3">{s.role}</td>
                  <td class="px-4 py-3 whitespace-nowrap text-[var(--color-text-dim)]">{s.access}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. Analytics -->
      <section>
        <p class={eyebrowClass}>04 · Pomiar</p>
        <h2 class={h2Class}>Analityka, zgoda zanim cokolwiek się załaduje</h2>
        <p class="mt-3">
          Nic nie startuje, dopóki użytkownik nie zaakceptuje analityki
          (<code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">cookie-consent === 'accepted'</code>).
          Bez sieci reklamowych, retargetingu i brokerów danych.
        </p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          <li class={cardClass}><strong class="text-[var(--color-text)]">Cloudflare Web Analytics</strong><br /><span class="text-sm">Privacy-first, bez ciasteczek, zawsze anonimowo.</span></li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Google Analytics 4</strong><br /><span class="text-sm">Ładowane lazy po zgodzie, IP anonimizowane.</span></li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Mixpanel · rezydencja UE</strong><br /><span class="text-sm">Eventy produktowe: pageview, outbound clicks, intencja CTA i newslettera.</span></li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">PostHog · UE</strong><br /><span class="text-sm">Analityka produktowa i tracking pageview, ładowany dopiero po zgodzie.</span></li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Sentry · region UE</strong><br /><span class="text-sm">Monitoring błędów i wydajności.</span></li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Better Stack</strong><br /><span class="text-sm">Monitoring uptime; incydent odpala webhook, który re-runuje smoke test produkcji.</span></li>
        </ul>
      </section>

      <!-- 5. i18n -->
      <section>
        <p class={eyebrowClass}>05 · Języki</p>
        <h2 class={h2Class}>Internacjonalizacja</h2>
        <p class="mt-3">
          Osiem języków w warstwie CV i SEO: EN (baza), PL, DE, DK, NO, JP, IT, ES. Siedem w pełni
          przetłumaczonych homepage'ów (pl, de, dk, no, jp, it, es), każdy z własnym
          <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">htmlLang</code>,
          <code class="text-xs font-mono bg-[var(--color-surface-2)] px-1 rounded">hreflang</code> i OG locale.
          hreflang i html lang są weryfikowane testami end-to-end.
        </p>
        <p class="mt-3 text-sm text-[var(--color-text-dim)]">Treść leży w typowanych kolekcjach: insights, work (case studies), testimonials.</p>
      </section>

      <!-- 6. Testowanie -->
      <section>
        <p class={eyebrowClass}>06 · Jakość</p>
        <h2 class={h2Class}>Testy</h2>
        <div class="grid gap-4 sm:grid-cols-2 mt-3">
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Unit · Vitest</p>
            <p class="text-sm">CSP w middleware, guard treści i locale, logika i18n, z coverage.</p>
          </div>
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">End-to-end · Playwright</p>
            <p class="text-sm">Chromium + WebKit: smoke, SEO, hreflang, dostępność (axe), linki, ścieżki krytyczne, meta. Codzienny smoke leci po żywej produkcji.</p>
          </div>
        </div>
      </section>

      <!-- 7. CI/CD -->
      <section>
        <p class={eyebrowClass}>07 · Dostarczanie</p>
        <h2 class={h2Class}>Pipeline CI/CD</h2>

        <Flow
          caption="Ticket przechodzi z Linear na produkcję, bez klikania w deploy."
          steps={[
            { label: 'Linear', sub: 'scope ticketu' },
            { label: 'Branch', sub: 'atomowy, scope plików' },
            { label: 'PR', sub: 'conventional commit' },
            { label: 'Bramka CI', sub: '10 checków' },
            { label: 'Review', sub: 'agent + człowiek' },
            { label: 'Merge', sub: 'squash do main' },
            { label: 'Deploy', sub: 'Wrangler · równolegle', active: true },
          ]}
        />

        <Diagram direction="column" caption="Deploy rozchodzi się równolegle na wszystkie powierzchnie, potem weryfikuje sam siebie.">
          <Box variant="accent" label="Merge do main" sub="zielone CI wymagane" />
          <Arrow direction="down" label="Wrangler" />
          <Stack direction="row" gap="sm">
            <Box variant="outline" label="wojciech.io" />
            <Box variant="outline" label="app" />
            <Box variant="outline" label="gh" />
            <Box variant="outline" label="academy" />
            <Box variant="outline" label="notch" />
            <Box variant="outline" label="subscribe" />
          </Stack>
          <Arrow direction="down" dashed label="po deployu" />
          <Stack direction="row" gap="sm">
            <Box variant="muted" label="Smoke tests" sub="Playwright vs prod" />
            <Box variant="muted" label="Sonda nagłówków" sub="6 domen" />
            <Box variant="muted" label="Better Stack" sub="baseline uptime" />
          </Stack>
        </Diagram>

        <ol class="mt-6 space-y-3">
          <li class={cardClass}><strong class="text-[var(--color-text)]">1 · CI</strong> na każdym push i PR do main: build i type-check (Node 24), unit testy, end-to-end smoke i a11y. Artefakty zachowane.</li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">2 · Deploy</strong> odpala się tylko po zielonym CI. Site, app, subscribe i notch deployują się równolegle przez Wrangler. Aktywny deploy nigdy nie jest cancelowany w locie.</li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">3 · Higiena commitów</strong>: wymuszone conventional commits, Release Please ogarnia wersjonowanie i changelog.</li>
        </ol>
      </section>

      <!-- 8. Bezpieczeństwo -->
      <section>
        <p class={eyebrowClass}>08 · Bezpieczeństwo</p>
        <h2 class={h2Class}>Warstwowo, nie doczepione na końcu</h2>
        <p class="mt-3">
          Branch protection na main wymaga przejścia każdego checku poniżej przed merge. Sekrety żyją tylko
          w environment bindings Cloudflare, nigdy w repo.
        </p>

        <Diagram direction="column" caption="Defense in depth: żądanie przechodzi przez cztery warstwy, zanim dotrze do aplikacji.">
          <Box variant="muted" label="Publiczny internet" sub="każdy" />
          <Arrow direction="down" />
          <Box variant="outline" label="Cloudflare WAF" sub="managed + OWASP + reguły customowe" />
          <Arrow direction="down" />
          <Box variant="outline" label="Rate limiter" sub="Workers KV · per IP" />
          <Arrow direction="down" />
          <Box variant="outline" label="Brama auth" sub="HMAC cookies · magic links" />
          <Arrow direction="down" />
          <Box variant="accent" label="Pages Functions" sub="kod aplikacji, D1, KV" />
        </Diagram>

        <div class="grid gap-3 sm:grid-cols-2 mt-6">
          {securityChecks.map((c) => (
            <div class={`${cardClass} flex items-start gap-3`}>
              <span class="mt-0.5 shrink-0 text-[var(--color-accent-hi)] font-bold" aria-hidden="true">✓</span>
              <span>
                <strong class="text-[var(--color-text)] block">{c.name}</strong>
                <span class="text-sm">{c.detail}</span>
              </span>
            </div>
          ))}
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Nagłówki bezpieczeństwa na żywo</p>
            <p class="text-sm">HSTS z preload i includeSubDomains. Strict CSP: frame-ancestors none, object-src none, base-uri self, form-action self, upgrade-insecure-requests. X-Frame-Options DENY, nosniff, Referrer-Policy, Permissions-Policy blokuje kamerę, mikrofon, geolokalizację, FLoC, topics, payment.</p>
          </div>
          <div class={cardClass}>
            <p class="font-semibold text-[var(--color-text)] mb-2">Bramy autoryzacji</p>
            <p class="text-sm">Cloudflare Pages Functions. App i GrowthHub używają bramy hasłowej z ciasteczkami podpisanymi HMAC-SHA256, porównanie timing-safe, tokeny z TTL i rate-limited login. Academy używa passwordless magic-link sign-in opartego o store członków w D1. Zero credenciali w źródle.</p>
          </div>
        </div>
      </section>

      <!-- 9. Odporność -->
      <section>
        <p class={eyebrowClass}>09 · Odporność</p>
        <h2 class={h2Class}>Backup, failover, rollback</h2>

        <Diagram direction="row" caption="Failover to maszyna stanów, nie checklist do ręcznego klikania.">
          <Box variant="accent" label="Zdrowy" sub="primary serwuje" />
          <Arrow label="fail · 5 min" dashed />
          <Box variant="outline" label="Wykryto" sub="cron Worker" />
          <Arrow label="zmiana DNS" />
          <Box variant="outline" label="Azure live" sub="cold standby przejmuje" />
          <Arrow label="primary wrócił" dashed />
          <Box variant="muted" label="Przywrócone" sub="DNS z powrotem na CF" />
        </Diagram>

        <div class="grid gap-4 sm:grid-cols-2 mt-4">
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Backup</strong><span class="text-sm">Cotygodniowe mirror na Azure Static Web Apps jako niezależny cold standby.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Failover</strong><span class="text-sm">Cloudflare Worker robi health-check co 5 minut i automatycznie przepina DNS na Azure standby przez API CF, a po recovery wraca do primary. GitHub workflow daje ręczny override.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Rollback</strong><span class="text-sm">Niedestrukcyjny git revert bez force-push, w pełni audytowalny, z wymaganym uzasadnieniem.</span></div>
          <div class={cardClass}><strong class="text-[var(--color-text)] block mb-1">Monitoring</strong><span class="text-sm">Better Stack uptime, codzienny smoke produkcji, status digest w dni robocze, cotygodniowy Lighthouse.</span></div>
        </div>
      </section>

      <!-- 10. Model operacyjny -->
      <section>
        <p class={eyebrowClass}>10 · Model operacyjny</p>
        <h2 class={h2Class}>Wieloagentowy proces budowy</h2>
        <p class="mt-3">Czyste rozdzielenie ról i zdefiniowany protokół handoffu, planowane i trackowane w Linear.</p>

        <Diagram direction="column" caption="Każdy agent ma jedno zadanie. Linear to warstwa koordynacji; ostatnie słowo zostaje przy człowieku.">
          <Box variant="accent" label="Wojciech" sub="orkiestrator · go/no-go" />
          <Arrow direction="down" dashed label="scopuje · tickety" />
          <Box variant="outline" label="Linear" sub="sprinty · atomowe zadania · DoD" />
          <Arrow direction="down" dashed label="dispatch do" />
          <Stack direction="row" gap="sm">
            <Box variant="default" label="GPT-5.5" sub="strategia · pozycjonowanie" />
            <Box variant="default" label="Claude Code" sub="implementacja · testy" />
            <Box variant="default" label="Codex" sub="niezależny review" />
            <Box variant="default" label="Claude Design" sub="eksploracja wizualna" />
          </Stack>
          <Arrow direction="down" dashed label="konwergencja · PR" />
          <Box variant="muted" label="Bramka merge" sub="docs + kod się zgadzają · DoD spełnione" />
        </Diagram>

        <ul class="mt-5 space-y-3">
          <li class={cardClass}><strong class="text-[var(--color-text)]">Claude Code</strong> · implementacja: komponenty, style, szablony, kolekcje treści, dostępność, SEO. Nie rusza DNS, architektury informacji, pozycjonowania ani metryk dowodowych bez akceptacji.</li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Codex</strong> · niezależny review: kod, SEO, mapy przekierowań, scenariusze testowe, checklisty performance. Zamknięte zadania na osobnych branchach.</li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">GPT-5.5 Thinking</strong> · strategia: pozycjonowanie, logika strony, trade-offy, decyzja go / no-go o release.</li>
          <li class={cardClass}><strong class="text-[var(--color-text)]">Claude Design</strong> · eksploracja wizualna: warianty i referencje, nigdy źródło prawdy.</li>
        </ul>
        <div class={`${cardClass} mt-4`}>
          <p class="font-semibold text-[var(--color-text)] mb-2">Sprinty i zadania · Linear</p>
          <p class="text-sm">Praca scope'owana w sprinty i atomowe tickety w Linear. Każdy agent dostaje zamknięte, reviewowalne zadanie z jawnym scope plików; nic nie startuje przed sprawdzeniem git log, żeby uniknąć kolizji. Strategia ląduje w docs, Claude implementuje przeciwko docs, Codex reviewuje niezależnie, a zmiany merge'ują się dopiero, gdy docs i implementacja się zgadzają, względem ustalonej Definition of Done.</p>
        </div>
      </section>

      <!-- 11. Indeks technologiczny -->
      <section>
        <p class={eyebrowClass}>Cały toolbox</p>
        <h2 class={h2Class}>Wszystko na jednym ekranie</h2>
        <div class="mt-6 space-y-6">
          {techGroups.map((group) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)] mb-3">{group.label}</p>
              <ul class="flex flex-wrap gap-2">
                {group.icons.map((t) => (
                  <li class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] py-1.5 pl-1.5 pr-3.5 text-sm">
                    {t.slug
                      ? <img src={`https://cdn.simpleicons.org/${t.slug}/888888`} alt="" width="18" height="18" loading="lazy" class="shrink-0" />
                      : <span class="inline-flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[var(--color-border)] text-[9px] font-bold text-[var(--color-text)]" aria-hidden="true">{t.mark}</span>}
                    <span class="text-[var(--color-text)]">{t.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</Layout>
