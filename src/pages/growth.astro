---
import LensShowcase from '../components/pages/LensShowcase.astro';
import LensWork from '../components/pages/LensWork.astro';
import { localizedPageAlternates } from '../data/localizedPages';

const build = [
  { title: 'Experiments that ship', body: 'A backlog scored by impact, run on a weekly cadence, measured in revenue.' },
  { title: 'Activation and retention', body: 'The loops that decide whether acquisition ever pays back. Found, instrumented, fixed.' },
  { title: 'Lifecycle that runs itself', body: 'Triggered, behavioural messaging owned by the system, not by one person and a spreadsheet.' },
];
const faq = [
  { question: "Is this growth hacking?", answer: "No. Growth hacking looks for tricks. I look for the step in the funnel that leaks the most and fix that, which is usually activation, not acquisition." },
  { question: "What do you need from us to start?", answer: "Access to the analytics, the CRM, and one hour with whoever knows why the numbers look the way they do." },
  { question: "How do you decide what to test first?", answer: "By size of the leak, not by ease of the test. The cheapest experiment on the smallest step is a waste of a sprint." },
];
---

<LensShowcase
  title="Growth"
  description="Growth as a system: experiments, activation, retention, and lifecycle loops measured in revenue, not vanity metrics."
  eyebrow="Growth"
  h1Primary="Experiments"
  h1Secondary="that ship."
  lead="Activation, retention, and lifecycle loops, run weekly and measured in revenue. The loops that decide whether acquisition ever pays back."
  metaLine="experiments · activation · retention · lifecycle"
  heroImage="/images/lens/growth-hero.webp"
  ogImage="/og/pages/growth.png"
  alternates={localizedPageAlternates('growth')}
  build={build}
  pov="Vanity metrics feel like progress. I measure the ones that move revenue."
  ctaHeading="Acquiring users that never pay back?"
  faq={faq}
  ctaSubtext="Send your funnel and what you have tried. I will tell you which loop to fix first."
>
  <LensWork
    eyebrow="Growth in production"
    heading="Shipped products with real funnels."
    lead="Growth and retention systems I built and run: relationship CRM, a growth ops hub, and a self-serve booking funnel. Each one links to the live build."
    ids={['relora', 'growthhub', 'kamperownia']}
    viewLabel="View live"
  />
</LensShowcase>
