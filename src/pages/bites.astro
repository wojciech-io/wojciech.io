---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';
import BeforeAfterDemo from '@wojciech/mdx-components/components/BeforeAfterDemo.astro';
import { SITE } from '../data/site';

// Hosted in this public monorepo: zip download served from /public, source browsable on GitHub.
const PAGE_OPTIMIZER_DOWNLOAD = '/bites/page-optimizer.zip';
const PAGE_OPTIMIZER_REPO = 'https://github.com/wojciech-io/wojciech.io/tree/main/bites/page-optimizer';
const CLAUDE_MD_DOWNLOAD = '/bites/claude-md-starter.zip';
const CLAUDE_MD_REPO = 'https://github.com/wojciech-io/wojciech.io/tree/main/bites/claude-md-starter';

interface Skill {
  command: string;
  what: string;
}

interface Bite {
  name: string;
  kicker: string;
  summary: string;
  audience: string;
  tags: string[];
  repo: string;
  download: string;
  skills: Skill[];
  install: { step: string; text: string }[];
  demos: boolean;
}

const bites: Bite[] = [
  {
    name: 'CLAUDE.md Starter',
    kicker: 'GTM agent template · v1.0',
    summary:
      'A ready-to-use CLAUDE.md for GTM AI agents. Fill in the brackets with your client data, point Claude Code at it, and the agent gets persistent identity, ICP scoring, tone rules, and five named skills.',
    audience:
      'For GTM operators building outbound research and enrichment agents with Claude Code. The template behind the agent stack described in my articles.',
    tags: ['Claude Code', 'GTM', 'Agent', 'Template'],
    repo: CLAUDE_MD_REPO,
    download: CLAUDE_MD_DOWNLOAD,
    skills: [
      { command: '/research [company]', what: 'Full company profile: firmographics, news, tech stack, team size, stakeholders. Writes to research/[company].md.' },
      { command: '/score [company]', what: 'ICP fit score 1-10 with three sentences of reasoning. Below 6 = skip. 8+ = priority.' },
      { command: '/draft [company]', what: 'Personalized first-touch email from research + sequence template. Max 100 words. No merge fields.' },
      { command: '/enrich [csv]', what: 'Batch research + score for a CSV of company names. Outputs enriched CSV with priority flags.' },
      { command: '/log [company] [status]', what: 'Update activity log with account status and timestamp.' },
    ],
    install: [
      { step: '1', text: 'Download claude-md-starter.zip below and unzip it.' },
      { step: '2', text: 'Fill the brackets with your own client data: ICP, tone, the five skills.' },
      { step: '3', text: 'Point Claude Code at the folder. The agent picks up the identity.' },
    ],
    demos: false,
  },
  {
    name: 'Page Optimizer',
    kicker: 'Claude Code plugin · v0.1.0',
    summary:
      'Point it at a single-file HTML landing page. It tells you what is broken, then ships a fixed version. Six skills, one job: turn a rough page into something you can publish.',
    audience:
      'For anyone shipping landing pages with Claude Code: solo founders, operators, indie builders. You write the HTML, it runs the audit and the fixes a designer would bill you for.',
    tags: ['Claude Code', 'Landing page', 'a11y', 'SEO', 'Audit'],
    repo: PAGE_OPTIMIZER_REPO,
    download: PAGE_OPTIMIZER_DOWNLOAD,
    skills: [
      {
        command: '/audit-page',
        what: 'Reads the HTML and writes a full AUDIT.md next to it: copy, em dashes, visuals, micro-animations, mobile nav, performance, SEO, accessibility.',
      },
      {
        command: '/optimize-page',
        what: 'Generates improved/index.html with every high-priority fix applied: broken CTA hover, mobile menus with no Escape key, unpinned CDN versions, missing LCP preload.',
      },
      {
        command: '/responsive-check',
        what: 'Checks mobile and tablet readiness: viewport, breakpoint gaps, 44px touch targets, 16px body text, image sizing and CLS.',
      },
      {
        command: '/llm-copy',
        what: 'Audits copy for AI answer engines: clear answers over poetry, full entity coverage, a Q&A structure models can quote (AEO and GEO).',
      },
      {
        command: '/color-review',
        what: 'Runs WCAG contrast math on every text and background pair, then checks palette consistency and fit with the industry.',
      },
      {
        command: '/visual-harmony',
        what: 'Catches visual dissonance: inconsistent border-radius, broken type scales, random shadows and off-grid spacing.',
      },
    ],
    install: [
      { step: '1', text: 'Download page-optimizer.zip below and unzip it.' },
      { step: '2', text: 'Run install.sh on macOS or Linux, install.ps1 on Windows.' },
      { step: '3', text: 'Restart Claude Code. The skills show up on their own.' },
    ],
    demos: true,
  },
];

const pageOptimizer = bites.find((bite) => bite.download === PAGE_OPTIMIZER_DOWNLOAD) ?? bites[0];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Bites', item: SITE.url + '/bites/' },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Page Optimizer',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: pageOptimizer.summary,
  url: SITE.url + '/bites/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Bites · wojciech.io"
  description="Free Claude Code plugins that each do one job well. Page Optimizer audits a landing page and ships the fixed version. Take it and run."
  ogImage="/og/pages/bites.png"
  schema={[breadcrumbSchema, softwareSchema]}
>

  <!-- Header -->
  <section class="relative overflow-hidden pt-20 pb-16 border-b border-[var(--color-border)]">
    <PageBackdrop src="/images/office-bg.jpg" position="center 52%" opacity={0.07} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Bites</p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5 max-w-2xl">
        Small tools you can take and run.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Claude Code plugins I built for my own work, then gave away. Each one does a single job well. No SaaS wrapper, no login, no monthly fee.
      </p>
    </div>
  </section>

  <!-- Bites -->
  {bites.map((bite) => (
    <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-6">

        <!-- Bite header -->
        <div class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start mb-12">
          <div>
            <div class="flex flex-wrap gap-2 mb-4">
              {bite.tags.map((tag) => (
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-2">{bite.kicker}</p>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight mb-4">{bite.name}</h2>
            <p class="text-base text-[var(--color-text-muted)] leading-relaxed mb-4">{bite.summary}</p>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{bite.audience}</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={bite.download}
                download
                class="inline-flex items-center gap-2 rounded-[var(--radius-badge)] bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-hi)] transition-colors"
              >
                Download the plugin ↓
              </a>
              <a
                href={bite.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-[var(--radius-badge)] border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors"
              >
                View source →
              </a>
            </div>
          </div>

          <!-- Install -->
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7">
            <h3 class="text-sm font-semibold text-[var(--color-text)] mb-5">Install in three steps</h3>
            <ol class="flex flex-col gap-4">
              {bite.install.map(({ step, text }) => (
                <li class="flex gap-3">
                  <span class="flex-none grid place-items-center w-6 h-6 rounded-full border border-[var(--color-border)] text-xs font-semibold text-[var(--color-accent-hi)] bg-[var(--color-surface-2)]">{step}</span>
                  <span class="text-sm text-[var(--color-text-muted)] leading-relaxed">{text}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Before / after: live, interactive demos. Page Optimizer only. -->
        {bite.demos && (
        <Fragment>
        <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-muted)] mb-5">Before and after</h3>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-2xl mb-2">
          Real fixes shown side by side. Each block shows both states at the same time, so the difference is obvious without hovering or clicking.
        </p>
        <div class="mb-12">

          <BeforeAfterDemo label="/optimize-page · CTA hover state" caption="Both buttons shown twice. Rest state and hovered state. Before: the hovered button blends into the background. After: it stays clickable.">
            <Fragment slot="before">
              <div class="demo-state-stack">
                <div class="demo-state">
                  <span class="demo-state-label">Rest</span>
                  <button type="button" class="demo-cta demo-cta-broken">Book a call</button>
                </div>
                <div class="demo-state">
                  <span class="demo-state-label">Hovered</span>
                  <button type="button" class="demo-cta demo-cta-broken is-hover">Book a call</button>
                </div>
              </div>
              <p class="demo-note">Hovered button reads as disabled. Exact moment someone is about to click.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-state-stack">
                <div class="demo-state">
                  <span class="demo-state-label">Rest</span>
                  <button type="button" class="demo-cta demo-cta-fixed">Book a call</button>
                </div>
                <div class="demo-state">
                  <span class="demo-state-label">Hovered</span>
                  <button type="button" class="demo-cta demo-cta-fixed is-hover">Book a call</button>
                </div>
              </div>
              <p class="demo-note">Darker tone of the same accent. Stays legible, signals "yes, click here".</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/optimize-page · Mobile drawer" caption="Both drawers are shown open by default. Before has no close affordance. After has an X, a focus trap, and closes on Escape.">
            <Fragment slot="before">
              <div class="demo-drawer demo-drawer-open" data-demo-drawer="broken">
                <button type="button" class="demo-button" data-demo-drawer-trigger>Menu open</button>
                <div class="demo-drawer-panel" data-demo-drawer-panel>
                  <a href="javascript:void(0)" tabindex="0">Home</a>
                  <a href="javascript:void(0)" tabindex="0">Insights</a>
                  <a href="javascript:void(0)" tabindex="0">Work</a>
                </div>
              </div>
              <p class="demo-note">No close button. No Escape handler. Background page keeps scrolling under it.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-drawer demo-drawer-open" data-demo-drawer="fixed">
                <button type="button" class="demo-button" data-demo-drawer-trigger aria-expanded="true" aria-controls="demo-drawer-fixed-panel">Menu open</button>
                <div id="demo-drawer-fixed-panel" class="demo-drawer-panel" data-demo-drawer-panel role="dialog" aria-modal="true" aria-label="Demo menu">
                  <button type="button" class="demo-drawer-close" data-demo-drawer-close aria-label="Close menu">×</button>
                  <a href="javascript:void(0)">Home</a>
                  <a href="javascript:void(0)">Insights</a>
                  <a href="javascript:void(0)">Work</a>
                </div>
              </div>
              <p class="demo-note">Visible X. Escape closes (try it). Focus returns to the trigger.</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/optimize-page · Submit state" caption="Both forms shown post-submit. Before: a blocking browser alert. After: an inline success state with a phone fallback.">
            <Fragment slot="before">
              <div class="demo-form-frame">
                <form class="demo-form" novalidate onsubmit="event.preventDefault()">
                  <label class="demo-label">
                    <span>Name</span>
                    <input type="text" value="Daria" autocomplete="off" readonly />
                  </label>
                  <button type="submit" class="demo-button">Send</button>
                </form>
                <div class="demo-alert" role="alertdialog" aria-label="Browser alert">
                  <div class="demo-alert-body">
                    <p class="demo-alert-title">localhost says</p>
                    <p class="demo-alert-text">Sent!</p>
                  </div>
                  <div class="demo-alert-actions">
                    <button type="button" class="demo-alert-button" disabled>OK</button>
                  </div>
                </div>
              </div>
              <p class="demo-note">Blocking native dialog. Off-brand, modal, vanishes the second the page reloads.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-form-success">
                <p class="demo-form-success-title">Got it. I reply within 24h.</p>
                <p class="demo-note">Need it faster? <a href="javascript:void(0)" tabindex="0">+48 …</a></p>
              </div>
              <p class="demo-note">Inline success state. Sets reply expectation. Offers a phone fallback.</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/responsive-check · Touch targets" caption="Try tapping the X on a phone. Before: 24px chip. Your finger covers three buttons at once. After: 44px hit area meeting the Apple/Material baseline.">
            <Fragment slot="before">
              <div class="demo-tt-row">
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close A">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close B">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close C">×</button>
              </div>
              <p class="demo-note">24px square. Three crammed side by side. A real thumb hits two of them at once.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-tt-row">
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close A">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close B">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close C">×</button>
              </div>
              <p class="demo-note">44px hit area, breathing room between. Same icon, but each one is actually tappable.</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/color-review · WCAG contrast" caption="Same copy, two palettes. Before fails AA on body text (2.4:1). After clears AAA at 13.6:1. Squint at both. Only one is readable.">
            <Fragment slot="before">
              <div class="demo-contrast demo-contrast-fail">
                <p class="demo-contrast-title">Ship faster</p>
                <p class="demo-contrast-body">A revenue stack your team actually runs. No SaaS rental, no monthly bill, no lock-in.</p>
                <span class="demo-contrast-ratio">2.4:1 · fails WCAG AA</span>
              </div>
              <p class="demo-note">Trendy "low-contrast minimal" palette. Looks fine on a fresh Retina screen at noon. Unreadable on a phone in a coffee shop.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-contrast demo-contrast-pass">
                <p class="demo-contrast-title">Ship faster</p>
                <p class="demo-contrast-body">A revenue stack your team actually runs. No SaaS rental, no monthly bill, no lock-in.</p>
                <span class="demo-contrast-ratio">13.6:1 · clears AAA</span>
              </div>
              <p class="demo-note">Same palette family, picked from contrast math. Body copy survives sunlight, glasses, and a 65" TV in a meeting room.</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/visual-harmony · Card system" caption="Three cards, one component. Before: every one a different radius, shadow, and padding. After: one rhythm.">
            <Fragment slot="before">
              <div class="demo-harmony-row">
                <div class="demo-harmony-card demo-harmony-card-a">
                  <p class="demo-harmony-kicker">Audit</p>
                  <p class="demo-harmony-title">Find what's broken</p>
                </div>
                <div class="demo-harmony-card demo-harmony-card-b">
                  <p class="demo-harmony-kicker">Fix</p>
                  <p class="demo-harmony-title">Ship the patch</p>
                </div>
                <div class="demo-harmony-card demo-harmony-card-c">
                  <p class="demo-harmony-kicker">Verify</p>
                  <p class="demo-harmony-title">Prove it works</p>
                </div>
              </div>
              <p class="demo-note">4px / 16px / 28px radius. Three different shadows. Random padding. Looks like three teams shipped three components.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-harmony-row">
                <div class="demo-harmony-card demo-harmony-card-fixed">
                  <p class="demo-harmony-kicker">Audit</p>
                  <p class="demo-harmony-title">Find what's broken</p>
                </div>
                <div class="demo-harmony-card demo-harmony-card-fixed">
                  <p class="demo-harmony-kicker">Fix</p>
                  <p class="demo-harmony-title">Ship the patch</p>
                </div>
                <div class="demo-harmony-card demo-harmony-card-fixed">
                  <p class="demo-harmony-kicker">Verify</p>
                  <p class="demo-harmony-title">Prove it works</p>
                </div>
              </div>
              <p class="demo-note">One radius token, one shadow token, one padding scale. Reads as a system, not a junkyard.</p>
            </Fragment>
          </BeforeAfterDemo>

        </div>
        </Fragment>
        )}

        <!-- Skills -->
        <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-muted)] mb-5">What is inside</h3>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bite.skills.map(({ command, what }) => (
            <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex flex-col gap-3">
              <code class="text-sm font-semibold text-[var(--color-accent-hi)] font-mono">{command}</code>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{what}</p>
            </div>
          ))}
        </div>

      </div>
    </section>
  ))}

  <!-- Coming next: Kade teaser. Public hint only; the full product page is offline until launch. -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-[var(--radius-card)] border border-dashed border-[var(--color-border-2)] bg-[var(--color-surface)] p-7 md:p-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Coming next</p>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight mb-3">Kade. A quieter way to keep links.</h2>
            <p class="text-base text-[var(--color-text-muted)] leading-relaxed">
              A small macOS tool I built for one job: holding links that need a few minutes of context before they're worth opening again. Local-first, no cloud, no list to share.
            </p>
            <p class="mt-3 text-sm text-[var(--color-text-dim)] leading-relaxed">
              Public launch is paused while I tighten the trust boundary. Notes from the build will land here when it's ready.
            </p>
          </div>
          <div class="shrink-0">
            <span class="inline-flex items-center gap-2 rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
              In private build
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABand />

</Layout>

<style is:global>
  /* Live demos for /bites/. Kept scoped via the `demo-` prefix.
     `is:global` so the styles reach into BeforeAfterDemo's slot content. */
  .demo-cta {
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-badge);
    font-weight: 600;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
    align-self: flex-start;
  }
  .demo-cta-broken:hover,
  .demo-cta-broken:focus-visible,
  .demo-cta-broken.is-hover {
    background: rgba(235, 255, 0, 0.18);
    color: var(--color-text-dim);
  }
  .demo-cta-fixed:hover,
  .demo-cta-fixed:focus-visible,
  .demo-cta-fixed.is-hover {
    background: var(--color-accent-hi);
    color: var(--color-bg);
  }
  /* Side-by-side state stacks for hover/active demos. */
  .demo-state-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .demo-state {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .demo-state-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-text-muted);
    min-width: 56px;
  }
  .demo-note {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0.85rem 0 0;
    line-height: 1.5;
  }
  .demo-note code {
    background: var(--color-surface-2);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    font-size: 0.95em;
  }
  .demo-button {
    background: var(--color-surface-2);
    color: var(--color-text);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-badge);
    font-weight: 600;
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
    cursor: pointer;
    align-self: flex-start;
    transition: border-color 150ms ease;
  }
  .demo-button:hover { border-color: var(--color-accent); }
  .demo-drawer { position: relative; }
  .demo-drawer-open .demo-drawer-panel { display: flex; }
  .demo-drawer-panel {
    margin-top: 0.85rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    position: relative;
  }
  .demo-drawer-panel a {
    color: var(--color-text);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .demo-drawer-panel a:hover,
  .demo-drawer-panel a:focus-visible {
    border-bottom-color: var(--color-accent);
    outline: none;
  }
  .demo-drawer-close {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
  }
  .demo-drawer-close:hover { color: var(--color-text); }
