---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';
import BeforeAfterDemo from '@wojciech/mdx-components/components/BeforeAfterDemo.astro';
import { SITE } from '../data/site';

// Hosted in this public monorepo: zip download served from /public, source browsable on GitHub.
const PAGE_OPTIMIZER_DOWNLOAD = '/bites/page-optimizer.zip';
const PAGE_OPTIMIZER_REPO = 'https://github.com/wojciech-io/wojciech.io/tree/main/bites/page-optimizer';

interface Skill {
  command: string;
  what: string;
}

interface Bite {
  name: string;
  kicker: string;
  summary: string;
  audience: string;
  tags: string[];
  repo: string;
  download: string;
  skills: Skill[];
}

const bites: Bite[] = [
  {
    name: 'Page Optimizer',
    kicker: 'Claude Code plugin · v0.1.0',
    summary:
      'Point it at a single-file HTML landing page. It tells you what is broken, then ships a fixed version. Six skills, one job: turn a rough page into something you can publish.',
    audience:
      'For anyone shipping landing pages with Claude Code: solo founders, operators, indie builders. You write the HTML, it runs the audit and the fixes a designer would bill you for.',
    tags: ['Claude Code', 'Landing page', 'a11y', 'SEO', 'Audit'],
    repo: PAGE_OPTIMIZER_REPO,
    download: PAGE_OPTIMIZER_DOWNLOAD,
    skills: [
      {
        command: '/audit-page',
        what: 'Reads the HTML and writes a full AUDIT.md next to it: copy, em dashes, visuals, micro-animations, mobile nav, performance, SEO, accessibility.',
      },
      {
        command: '/optimize-page',
        what: 'Generates improved/index.html with every high-priority fix applied: broken CTA hover, mobile menus with no Escape key, unpinned CDN versions, missing LCP preload.',
      },
      {
        command: '/responsive-check',
        what: 'Checks mobile and tablet readiness: viewport, breakpoint gaps, 44px touch targets, 16px body text, image sizing and CLS.',
      },
      {
        command: '/llm-copy',
        what: 'Audits copy for AI answer engines: clear answers over poetry, full entity coverage, a Q&A structure models can quote (AEO and GEO).',
      },
      {
        command: '/color-review',
        what: 'Runs WCAG contrast math on every text and background pair, then checks palette consistency and fit with the industry.',
      },
      {
        command: '/visual-harmony',
        what: 'Catches visual dissonance: inconsistent border-radius, broken type scales, random shadows and off-grid spacing.',
      },
    ],
  },
];

const install = [
  { step: '1', text: 'Download page-optimizer.zip below and unzip it.' },
  { step: '2', text: 'Run install.sh on macOS or Linux, install.ps1 on Windows.' },
  { step: '3', text: 'Restart Claude Code. The skills show up on their own.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Bites', item: SITE.url + '/bites/' },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Page Optimizer',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: bites[0].summary,
  url: SITE.url + '/bites/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Bites · Small Claude Code Tools"
  description="Free Claude Code plugins that each do one job well. Page Optimizer audits a landing page and ships the fixed version. Take it and run."
  ogImage="/og/pages/bites.png"
  schema={[breadcrumbSchema, softwareSchema]}
>

  <!-- Header -->
  <section class="relative overflow-hidden pt-20 pb-16 border-b border-[var(--color-border)]">
    <PageBackdrop src="/images/office-bg.jpg" position="center 52%" opacity={0.07} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Bites</p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5 max-w-2xl">
        Small tools you can take and run.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Claude Code plugins I built for my own work, then gave away. Each one does a single job well. No SaaS wrapper, no login, no monthly fee.
      </p>
    </div>
  </section>

  <!-- Bites -->
  {bites.map((bite) => (
    <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-6">

        <!-- Bite header -->
        <div class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start mb-12">
          <div>
            <div class="flex flex-wrap gap-2 mb-4">
              {bite.tags.map((tag) => (
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-2">{bite.kicker}</p>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight mb-4">{bite.name}</h2>
            <p class="text-base text-[var(--color-text-muted)] leading-relaxed mb-4">{bite.summary}</p>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{bite.audience}</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={bite.download}
                download
                class="inline-flex items-center gap-2 rounded-[var(--radius-badge)] bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-hi)] transition-colors"
              >
                Download the plugin ↓
              </a>
              <a
                href={bite.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-[var(--radius-badge)] border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors"
              >
                View source →
              </a>
            </div>
          </div>

          <!-- Install -->
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7">
            <h3 class="text-sm font-semibold text-[var(--color-text)] mb-5">Install in three steps</h3>
            <ol class="flex flex-col gap-4">
              {install.map(({ step, text }) => (
                <li class="flex gap-3">
                  <span class="flex-none grid place-items-center w-6 h-6 rounded-full border border-[var(--color-border)] text-xs font-semibold text-[var(--color-accent-hi)] bg-[var(--color-surface-2)]">{step}</span>
                  <span class="text-sm text-[var(--color-text-muted)] leading-relaxed">{text}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Before / after — live, interactive demos -->
        <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-muted)] mb-5">Before and after</h3>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-2xl mb-2">
          Three fixes <code class="font-mono text-[var(--color-accent-hi)]">/optimize-page</code> ships on a real page. Hover, click, press Escape — the demos are wired up.
        </p>
        <div class="mb-12">

          <BeforeAfterDemo label="/optimize-page · CTA hover state" caption="Hover both buttons. The Before one blends into the background, the After one stays clickable.">
            <Fragment slot="before">
              <button type="button" class="demo-cta demo-cta-broken">Book a call</button>
              <p class="demo-note">Hover blends into background. Reads as disabled right when someone wants to click.</p>
            </Fragment>
            <Fragment slot="after">
              <button type="button" class="demo-cta demo-cta-fixed">Book a call</button>
              <p class="demo-note">Hover shifts to a darker tone of the same accent. Stays legible.</p>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/optimize-page · Mobile drawer" caption="Open the menu, then press Escape. The Before version ignores Escape; the After version closes and returns focus to the trigger.">
            <Fragment slot="before">
              <div class="demo-drawer" data-demo-drawer="broken">
                <button type="button" class="demo-button" data-demo-drawer-trigger>Open menu</button>
                <div class="demo-drawer-panel" data-demo-drawer-panel hidden>
                  <a href="javascript:void(0)" tabindex="0">Home</a>
                  <a href="javascript:void(0)" tabindex="0">Insights</a>
                  <a href="javascript:void(0)" tabindex="0">Work</a>
                </div>
                <p class="demo-note">No Escape handler. No focus management. Page scroll keeps going.</p>
              </div>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-drawer" data-demo-drawer="fixed">
                <button type="button" class="demo-button" data-demo-drawer-trigger aria-expanded="false" aria-controls="demo-drawer-fixed-panel">Open menu</button>
                <div id="demo-drawer-fixed-panel" class="demo-drawer-panel" data-demo-drawer-panel hidden role="dialog" aria-modal="true" aria-label="Demo menu">
                  <button type="button" class="demo-drawer-close" data-demo-drawer-close aria-label="Close menu">×</button>
                  <a href="javascript:void(0)">Home</a>
                  <a href="javascript:void(0)">Insights</a>
                  <a href="javascript:void(0)">Work</a>
                </div>
                <p class="demo-note">Escape closes. Focus enters the panel, returns to the trigger on close.</p>
              </div>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/optimize-page · Submit state" caption="Type something and submit. Both versions “send” nothing — they just show the state.">
            <Fragment slot="before">
              <form class="demo-form" data-demo-form="broken" novalidate>
                <label class="demo-label">
                  <span>Name</span>
                  <input type="text" placeholder="Daria" autocomplete="off" />
                </label>
                <button type="submit" class="demo-button">Send</button>
                <p class="demo-note">Submit fires <code>alert()</code>. Off-brand, blocking, gone the moment the page reloads.</p>
              </form>
            </Fragment>
            <Fragment slot="after">
              <div data-demo-form="fixed">
                <form class="demo-form" data-demo-form-shell novalidate>
                  <label class="demo-label">
                    <span>Name</span>
                    <input type="text" placeholder="Daria" autocomplete="off" />
                  </label>
                  <button type="submit" class="demo-button">Send</button>
                </form>
                <div class="demo-form-success" data-demo-form-success hidden>
                  <p class="demo-form-success-title">Got it. I reply within 24h.</p>
                  <p class="demo-note">Need it faster? <a href="javascript:void(0)" tabindex="0">+48 …</a></p>
                  <button type="button" class="demo-form-reset" data-demo-form-reset>Reset demo</button>
                </div>
                <p class="demo-note demo-note-shell">Inline success state. Sets the reply expectation. Offers a phone fallback.</p>
              </div>
            </Fragment>
          </BeforeAfterDemo>

          <BeforeAfterDemo label="/responsive-check · Touch targets" caption="Try tapping the X on a phone. Before: 24px chip — your finger covers three buttons at once. After: 44px hit area meeting the Apple/Material baseline.">
            <Fragment slot="before">
              <div class="demo-tt-row">
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close A">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close B">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-small" aria-label="Close C">×</button>
              </div>
              <p class="demo-note">24px square. Three crammed side by side. A real thumb hits two of them at once.</p>
            </Fragment>
            <Fragment slot="after">
              <div class="demo-tt-row">
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close A">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close B">×</button>
                <button type="button" class="demo-tt-icon demo-tt-icon-large" aria-label="Close C">×</button>
              </div>
              <p class="demo-note">44px hit area, breathing room between. Same icon, but each one is actually tappable.</p>
            </Fragment>
          </BeforeAfterDemo>

        </div>

        <!-- Skills -->
        <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-muted)] mb-5">What is inside</h3>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bite.skills.map(({ command, what }) => (
            <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex flex-col gap-3">
              <code class="text-sm font-semibold text-[var(--color-accent-hi)] font-mono">{command}</code>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{what}</p>
            </div>
          ))}
        </div>

      </div>
    </section>
  ))}

  <CTABand />

</Layout>

<style is:global>
  /* Live demos for /bites/ — kept scoped via the `demo-` prefix.
     `is:global` so the styles reach into BeforeAfterDemo's slot content. */
  .demo-cta {
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-badge);
    font-weight: 600;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
    align-self: flex-start;
  }
  .demo-cta-broken:hover,
  .demo-cta-broken:focus-visible {
    background: rgba(235, 255, 0, 0.18);
    color: var(--color-text-dim);
  }
  .demo-cta-fixed:hover,
  .demo-cta-fixed:focus-visible {
    background: var(--color-accent-hi);
    color: var(--color-bg);
  }
  .demo-note {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0.85rem 0 0;
    line-height: 1.5;
  }
  .demo-note code {
    background: var(--color-surface-2);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    font-size: 0.95em;
  }
  .demo-button {
    background: var(--color-surface-2);
    color: var(--color-text);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-badge);
    font-weight: 600;
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
    cursor: pointer;
    align-self: flex-start;
    transition: border-color 150ms ease;
  }
  .demo-button:hover { border-color: var(--color-accent); }
  .demo-drawer { position: relative; }
  .demo-drawer-panel {
    margin-top: 0.85rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    position: relative;
  }
  .demo-drawer-panel a {
    color: var(--color-text);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .demo-drawer-panel a:hover,
  .demo-drawer-panel a:focus-visible {
    border-bottom-color: var(--color-accent);
    outline: none;
  }
  .demo-drawer-close {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
  }
  .demo-drawer-close:hover { color: var(--color-text); }
  .demo-form { display: flex; flex-direction: column; gap: 0.65rem; }
  .demo-label { display: flex; flex-direction: column; gap: 0.3rem; }
  .demo-label > span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .demo-label input {
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-badge);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.9rem;
  }
  .demo-label input:focus-visible {
    outline: none;
    border-color: var(--color-accent);
  }
  .demo-form-success {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }
  .demo-form-success-title {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .demo-form-reset {
    margin-top: 0.6rem;
    background: transparent;
    border: none;
    color: var(--color-text-dim);
    font-size: 0.75rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .demo-form-reset:hover { color: var(--color-text); }
  /* Touch target sizes — small vs 44px (Apple HIG / Material baseline). */
  .demo-tt-row { display: flex; align-items: center; gap: 4px; }
  .demo-tt-icon {
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0;
  }
  .demo-tt-icon:hover,
  .demo-tt-icon:focus-visible {
    border-color: var(--color-accent);
    outline: none;
  }
  .demo-tt-icon-small { width: 24px; height: 24px; font-size: 0.8rem; }
  .demo-tt-icon-large { width: 44px; height: 44px; }
  .demo-tt-row:has(.demo-tt-icon-large) { gap: 10px; }
</style>

<script is:inline>
  // Drawer demo: broken version has no Escape/focus management;
  // fixed version closes on Escape, returns focus to trigger.
  document.querySelectorAll('[data-demo-drawer]').forEach((root) => {
    const mode = root.getAttribute('data-demo-drawer'); // 'broken' | 'fixed'
    const trigger = root.querySelector('[data-demo-drawer-trigger]');
    const panel = root.querySelector('[data-demo-drawer-panel]');
    const close = root.querySelector('[data-demo-drawer-close]');
    if (!trigger || !panel) return;

    const open = () => {
      panel.hidden = false;
      if (mode === 'fixed') {
        trigger.setAttribute('aria-expanded', 'true');
        const first = panel.querySelector('a, button');
        if (first) first.focus();
      }
    };
    const closePanel = () => {
      panel.hidden = true;
      if (mode === 'fixed') {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      }
    };

    trigger.addEventListener('click', open);

    if (mode === 'fixed') {
      if (close) close.addEventListener('click', closePanel);
      root.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) {
          e.preventDefault();
          closePanel();
        }
      });
    }
  });

  // Form demo: broken version calls alert(); fixed shows inline success.
  document.querySelectorAll('form[data-demo-form="broken"]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Deliberately the "before" behavior — that's the demo.
      window.alert('Sent!');
    });
  });

  document.querySelectorAll('[data-demo-form="fixed"]').forEach((root) => {
    const form = root.querySelector('[data-demo-form-shell]');
    const success = root.querySelector('[data-demo-form-success]');
    const shellNote = root.querySelector('.demo-note-shell');
    const reset = root.querySelector('[data-demo-form-reset]');
    if (!form || !success) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.hidden = true;
      if (shellNote) shellNote.hidden = true;
      success.hidden = false;
    });

    if (reset) {
      reset.addEventListener('click', () => {
        success.hidden = true;
        form.hidden = false;
        if (shellNote) shellNote.hidden = false;
        const input = form.querySelector('input');
        if (input) input.value = '';
      });
    }
  });
</script>
