<script is:inline>
  // Drawer demos are open-by-default for static legibility.
  // The "fixed" version still demonstrates Escape-to-close so the caption stays honest.
  document.querySelectorAll('[data-demo-drawer="fixed"]').forEach((root) => {
    const trigger = root.querySelector('[data-demo-drawer-trigger]');
    const panel = root.querySelector('[data-demo-drawer-panel]');
    const close = root.querySelector('[data-demo-drawer-close]');
    if (!trigger || !panel) return;

    const closePanel = () => {
      root.classList.remove('demo-drawer-open');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    };
    const openPanel = () => {
      root.classList.add('demo-drawer-open');
      trigger.setAttribute('aria-expanded', 'true');
      const first = panel.querySelector('a, button');
      if (first) first.focus();
    };

    trigger.addEventListener('click', () => {
      if (root.classList.contains('demo-drawer-open')) closePanel();
      else openPanel();
    });
    if (close) close.addEventListener('click', closePanel);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('demo-drawer-open')) {
        e.preventDefault();
        closePanel();
      }
    });
  });
</script>
