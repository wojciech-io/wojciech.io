---
import Layout from '../layouts/Layout.astro';
import AboutContent from '../components/pages/AboutContent.astro';
import { SITE } from '../data/site';

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Wojciech Łuszczyński · About',
  url: SITE.url + '/about/',
  mainEntity: {
    '@type': 'Person',
    name: 'Wojciech Łuszczyński',
    alternateName: 'Wojtek Luszczynski',
    url: SITE.url + '/',
    image: SITE.url + '/images/wojciech-avatar-384.webp',
    jobTitle: 'GTM Architect & Growth Operator',
    description: 'Growth operator building AI-native revenue systems for B2B SaaS. Connects GTM strategy, CRM, outbound, paid acquisition, SEO, automation and AI workflows into one operating model.',
    sameAs: [SITE.linkedin, SITE.github, SITE.twitter.replace('twitter.com', 'x.com'), SITE.substack],
    worksFor: {
      '@type': 'Organization',
      name: 'Independent Operator · wojciech.io',
      url: SITE.url,
    },
  },
};
---

<Layout
  title="Fractional GTM Architect & AI Systems Builder"
  description="Growth operator building AI-native revenue systems for B2B SaaS. I connect CRM, outbound, paid acquisition, SEO, and AI automation into one operating model that compounds over time."
  schema={profileSchema}
>
  <AboutContent />
</Layout>

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;

  function initLenis() {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    lenis = new Lenis({ duration: 1.15, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
    function raf(time: number) { lenis!.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
  }

  initLenis();
  document.addEventListener('astro:page-load', () => { lenis?.destroy(); lenis = null; initLenis(); });
  document.addEventListener('astro:before-preparation', () => { lenis?.destroy(); lenis = null; });
</script>
