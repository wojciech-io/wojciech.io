---
import Layout from '../layouts/Layout.astro';
import AboutContent from '../components/pages/AboutContent.astro';
import { SITE } from '../data/site';
import { localizedPageAlternates } from '../data/localizedPages';

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Wojciech Łuszczyński · About',
  url: SITE.url + '/about/',
  mainEntity: {
    '@type': 'Person',
    name: 'Wojciech Łuszczyński',
    alternateName: 'Wojtek Luszczynski',
    url: SITE.url + '/',
    image: SITE.url + '/images/wojciech-avatar-2026-384.webp',
    jobTitle: 'GTM Architect & Growth Operator',
    description: 'Growth operator building AI-native revenue systems for B2B SaaS. Connects GTM strategy, CRM, outbound, paid acquisition, SEO, automation and AI workflows into one operating model.',
    sameAs: [SITE.linkedin, SITE.github, SITE.twitter.replace('twitter.com', 'x.com'), SITE.substack],
    worksFor: {
      '@type': 'Organization',
      name: 'Independent Operator · wojciech.io',
      url: SITE.url,
    },
  },
};
---

<Layout
  title="About"
  description="Growth operator building AI-native revenue systems for B2B SaaS. I connect CRM, outbound, paid acquisition, SEO, and AI automation into one operating model."
  ogImage="/og/pages/about.png"
  alternates={localizedPageAlternates('about')}
  schema={profileSchema}
>
  <AboutContent />
</Layout>
