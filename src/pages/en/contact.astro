---
import Layout from '../../layouts/Layout.astro';
import CalBookingEmbed from '../../components/ui/CalBookingEmbed.astro';
import PageBackdrop from '../../components/ui/PageBackdrop.astro';
import { SITE } from '../../data/site';
---

<Layout title="Contact" description="Get in touch with Wojciech Łuszczyński — growth operator, GTM architect, AI-native builder." initialLang="en">

  <section class="relative pt-16 pb-10 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-infoshare.webp" position="center 42%" opacity={0.075} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="grid lg:grid-cols-[340px_minmax(0,1fr)] gap-8 lg:gap-10 items-start">
        <div>
          <p data-en="Contact" data-pl="Kontakt" data-it="Contatti" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Contact</p>
          <h1 data-en="Build, fix, or review the system." data-pl="Zbuduj, napraw lub zrecenzuj system." data-it="Costruisci, aggiusta o rivedi il sistema." class="text-4xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">Build, fix, or review the system.</h1>
          <p data-en="Use this for apps, GTM, automation, audits, or a fast review. Share the goal, current state, and useful links. I respond within 24h." data-pl="Uzywaj tego do aplikacji, GTM, automatyzacji, audytow lub szybkiej recenzji. Podaj cel, aktualny stan i przydatne linki. Odpowiadam w ciagu 24h." data-it="Usalo per app, GTM, automazione, audit o una revisione rapida. Condividi l'obiettivo, lo stato attuale e i link utili. Rispondo entro 24h." class="text-base text-[var(--color-text-muted)] leading-relaxed mb-7">Use this for apps, GTM, automation, audits, or a fast review. Share the goal, current state, and useful links. I respond within 24h.</p>
          <div class="space-y-4">
            <a href="#book-call" class="flex items-center gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 hover:border-[var(--color-accent)]/40 transition-colors group">
              <div class="w-9 h-9 rounded-lg bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
              </div>
              <div class="flex-1">
                <p data-en="Book a call" data-pl="Umow rozmowe" data-it="Prenota una call" class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors">Book a call</p>
                <p data-en="30 min · private scheduler" data-pl="30 min · prywatny scheduler" data-it="30 min · scheduler privato" class="text-xs text-[var(--color-text-dim)]">30 min · private scheduler</p>
              </div>
              <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all duration-150" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 hover:border-[var(--color-accent)]/40 transition-colors group">
              <div class="w-9 h-9 rounded-lg bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div class="flex-1">
                <p class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors">LinkedIn</p>
                <p class="text-xs text-[var(--color-text-dim)]">linkedin.com/in/{SITE.linkedinHandle}</p>
              </div>
              <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all duration-150" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <CalBookingEmbed />
      </div>
    </div>
  </section>

</Layout>
