---
/* Arabic (RTL) insights index in the production layout. Same structure and
   components as /insights/, Arabic chrome, dir=rtl. The article catalogue is
   English (articles ship EN+PL only), so the cards keep their English titles
   and link to the English articles — only the page chrome is Arabic. */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PosterFeatured from '../../../components/insights/PosterFeatured.astro';
import PosterCard from '../../../components/insights/PosterCard.astro';
import { SITE } from '../../../data/site';
import {
  insightSlug,
  isLocalePost,
  sortInsights,
} from '../../../lib/insights';

const allPosts = (await getCollection('insights', isLocalePost('en'))).sort(sortInsights);

const featuredPost = allPosts.find(p => p.data.featured);
const restPosts = allPosts.filter(p => p !== featuredPost);

const usedCategories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))] as string[];
const categories = ['All', ...usedCategories.sort()];

const categoryCounts: Record<string, number> = { All: allPosts.length };
for (const p of allPosts) {
  if (p.data.category) {
    categoryCounts[p.data.category] = (categoryCounts[p.data.category] ?? 0) + 1;
  }
}

/* Category display labels in Arabic. The data-* values stay English so they
   match the (English) article category metadata and the filter logic. */
const catLabelsAr: Record<string, string> = {
  All: 'الكل',
  'AI Systems': 'أنظمة الذكاء الاصطناعي',
  'GTM Architecture': 'معمارية GTM',
  'Operator Playbooks': 'أدلة المُشغِّل',
  Products: 'منتجات',
};
const catLabel = (c?: string) => (c ? catLabelsAr[c] ?? c : 'مقال');

/* Read time, Arabic suffix (article bodies are English; word count is the same). */
const readTimeAr = (body = '') =>
  `${Math.max(4, Math.ceil(body.split(/\s+/).filter(Boolean).length / 220))} دقيقة قراءة`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: SITE.url + '/ar/' },
    { '@type': 'ListItem', position: 2, name: 'رؤى', item: SITE.url + '/ar/insights/' },
  ],
};
const articleListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'رؤى في الذكاء الاصطناعي والـ GTM · ملاحظات مُشغِّل',
  url: SITE.url + '/ar/insights/',
  inLanguage: 'ar',
  author: { '@type': 'Person', name: 'فويتشيك لوشتشينسكي', url: SITE.url + '/ar/' },
  blogPost: allPosts.slice(0, 10).map((p) => {
    const slug = insightSlug(p);
    return {
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: `${SITE.url}/insights/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      keywords: p.data.tags.join(', '),
    };
  }),
};

/* Western numerals are kept site-wide on /ar/, so dates stay in en-GB form. */
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

---

<Layout
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  title="رؤى · ملاحظات مُشغِّل في الذكاء الاصطناعي والـ GTM"
  description="ملاحظات ميدانية عن أنظمة الذكاء الاصطناعي، معمارية GTM، وتصميم أنظمة الإيراد. أنماط عملية من مُشغِّل يبني هذه الأنظمة ويُشغّلها في الإنتاج."
  ogImage="/og/pages/ar-insights.png"
  canonical="/ar/insights/"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/insights/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/insights/' },
    { lang: 'x-default', href: 'https://wojciech.io/insights/' },
  ]}
  schema={[breadcrumbSchema, articleListSchema]}
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--space-section)]">

    <!-- Header -->
    <div class="mb-10 max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">رؤى</span>
      </div>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-insights">
        ملاحظات ميدانية حول أنظمة الذكاء الاصطناعي،<br class="hidden md:block" /> الـ GTM، ومعمارية الإيراد.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        تحليلات عملية من أنظمة أبنيها وأُشغّلها. لا نظريات: معمارية، وخيارات حزمة التقنية، ودروس تشغيلية من عمليات نشر حيّة.
      </p>
    </div>

    <!-- Featured poster -->
    {featuredPost && (
      <PosterFeatured
        href={`/insights/${insightSlug(featuredPost)}/`}
        title={featuredPost.data.title}
        description={featuredPost.data.description}
        categoryLabel={catLabel(featuredPost.data.category)}
        categoryKey={featuredPost.data.category ?? ''}
        date={formatDate(featuredPost.data.publishedAt)}
        read={readTimeAr(featuredPost.body)}
        featuredLabel="مميّز"
        readLabel="اقرأ"
        arrowFlip={true}
      />
    )}

    <!-- Category filter -->
    <div class="mb-2 flex flex-wrap gap-2" id="cat-nav" role="tablist" aria-label="التصفية حسب التصنيف">
      {categories.map((cat, i) => {
        const count = categoryCounts[cat] ?? 0;
        return (
          <button
            role="tab"
            data-cat={cat}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'cat-btn rounded-[var(--radius-btn)] px-4 py-2 text-sm font-medium transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
              i === 0
                ? 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm'
                : 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]',
            ]}
          >
            {catLabel(cat)}
            <span class="cat-btn-count mr-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-semibold tabular-nums" aria-label={`${count} مقالة`}>{count}</span>
          </button>
        );
      })}
    </div>

    <p class="mb-6 mt-3 text-sm text-[var(--color-text-dim)]" id="article-count">{allPosts.length} <span>مقالة</span></p>

    <!-- Article grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-16" id="article-grid">
      {restPosts.map((post, i) => (
        <PosterCard
          href={`/insights/${insightSlug(post)}/`}
          title={post.data.title}
          categoryLabel={catLabel(post.data.category)}
          categoryKey={post.data.category ?? ''}
          date={formatDate(post.data.publishedAt)}
          read={readTimeAr(post.body)}
          index={i + 1}
          arrowFlip={true}
          cover={post.data.coverImage}
        />
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="hidden mb-16 py-20 text-center">
      <p class="text-lg font-semibold text-[var(--color-text)] mb-1">لا مقالات في هذا التصنيف بعد.</p>
      <p class="text-sm text-[var(--color-text-muted)]">جرّب تصنيفًا آخر.</p>
    </div>

    <!-- Newsletter CTA -->
    <div class="border-t border-[var(--color-border)] pt-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
      <div class="max-w-xl">
        <p class="obs-label-accent block mb-3">النشرة</p>
        <h2 class="text-[length:var(--text-h2)] font-semibold text-[var(--color-text)] mb-2 text-balance">تريد أن تعرف أولًا؟</h2>
        <p class="text-[var(--color-text-muted)]">
          مقالات جديدة عن أنظمة الذكاء الاصطناعي ومعمارية GTM ونماذج تشغيل النمو، تصل فور نشرها.
        </p>
      </div>
      <a
        href="/subscribe/"
        class="btn-press group inline-flex shrink-0 items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
      >
        اشترك
        <svg class="rtl-flip-x" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</Layout>

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.js-article');
  const featured = document.querySelector<HTMLElement>('[data-featured-article]');
  const noResults = document.getElementById('no-results')!;
  const countEl   = document.getElementById('article-count')!;

  const ACTIVE   = 'bg-[var(--color-text)] text-[var(--color-bg)] shadow-sm';
  const INACTIVE = 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]';
  const COUNT_ACTIVE   = 'bg-[var(--color-bg)]/20 text-[var(--color-bg)]';
  const COUNT_INACTIVE = 'bg-[var(--color-surface-2)] text-[var(--color-text-dim)]';

  function applyFilter(cat: string, pushState = false) {
    catBtns.forEach(b => {
      const active = (b.dataset.cat ?? 'All') === cat;
      b.setAttribute('aria-selected', active ? 'true' : 'false');
      b.classList.remove(...ACTIVE.split(' '), ...INACTIVE.split(' '));
      b.classList.add(...(active ? ACTIVE : INACTIVE).split(' '));
      const badge = b.querySelector<HTMLElement>('.cat-btn-count');
      if (badge) {
        badge.classList.remove(...COUNT_ACTIVE.split(' '), ...COUNT_INACTIVE.split(' '));
        badge.classList.add(...(active ? COUNT_ACTIVE : COUNT_INACTIVE).split(' '));
      }
    });

    let visible = 0;
    if (featured) {
      const match = cat === 'All' || (featured.dataset.category ?? '') === cat;
      featured.style.display = match ? '' : 'none';
      if (match) visible++;
    }
    cards.forEach(card => {
      const match = cat === 'All' || (card.dataset.category ?? '') === cat;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    noResults.classList.toggle('hidden', visible > 0);
    countEl.textContent = `${visible} مقالة`;

    if (pushState) {
      const url = new URL(window.location.href);
      if (cat === 'All') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      window.history.replaceState(null, '', url.toString());
    }
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.cat ?? 'All', true));
  });

  const initialCat = new URL(window.location.href).searchParams.get('cat') ?? 'All';
  applyFilter(initialCat);

  const activateChip = (chip: HTMLElement) => {
    applyFilter(chip.dataset.filterCat ?? 'All', true);
    document.getElementById('cat-nav')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  // The chip is a span with role="button" and tabindex, so it takes focus but
  // gets no key handling for free. Without this a keyboard user tabs onto it
  // and nothing happens.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const chip = (e.target as Element).closest<HTMLElement>('[data-filter-cat]');
    if (!chip) return;
    e.preventDefault();
    activateChip(chip);
  });

  document.addEventListener('click', (e) => {
    const chip = (e.target as Element).closest<HTMLElement>('[data-filter-cat]');
    if (!chip) return;
    e.preventDefault();
    applyFilter(chip.dataset.filterCat ?? 'All', true);
    document.getElementById('cat-nav')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
