---
/* Arabic (RTL) homepage in the CURRENT production layout — same components and
   editorial hero as wojciech.io, only the copy is Arabic and dir=rtl. noindex. */
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/ui/CTABand.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import MetricsStrip from '../../components/home/MetricsStrip.astro';
import HowIWork from '../../components/home/HowIWork.astro';
import ProjectsSection from '../../components/home/ProjectsSection.astro';
import AILeverage from '../../components/home/AILeverage.astro';
import TestimonialsSection from '../../components/home/TestimonialsSection.astro';
import BrandLogos from '../../components/ui/BrandLogos.astro';
import { arProjects, arChrome, arWorkI18n } from '../../data/arProjects';
import { getUiStrings } from '../../data/uiStrings';

const t = getUiStrings('ar');

const proof = [
  { value: '20', label: 'عامًا في التسويق والديجيتال' },
  { value: '10', label: 'أعوام في B2B SaaS' },
  { value: '10', label: 'أعوام في GTM' },
  { value: '3×', label: 'متوسط نمو مسار الصفقات' },
];
const steps = [
  { step: '01', title: 'التشخيص', body: 'تدقيق لمعمارية الإيراد: مسار الصفقات، CRM، حركة GTM، والإسناد. أحدّد أين تنكسر الإشارة قبل لمس أي شيء.' },
  { step: '02', title: 'التصميم', body: 'تصميم النظام: ما الذي يتصل بماذا، وما يُقاس، وما يُؤتمت، وبأي ترتيب يُبنى.' },
  { step: '03', title: 'التنفيذ', body: 'أبنيه بنفسي: تسلسلات، لوحات، نموذج تشغيل CRM، وأدوات. أو أندمج مع فريقك وأبني بجانبه.' },
  { step: '04', title: 'سدّ الفجوة', body: 'حين لا تتوفّر الأداة المناسبة، أكتبها. وكلاء ذكاء اصطناعي، تطبيقات داخلية، وسير عمل MCP.' },
];
const aiI18n = {
  eyebrow: 'أنظمة الذكاء الاصطناعي', title: 'الذكاء الاصطناعي في صميم المعمارية.', titleSecondary: 'لا مُضافًا في النهاية.',
  link: 'كيف أبني بالذكاء الاصطناعي ←', stackLabel: 'حزمة التقنية',
  body: 'ليس لكتابة أسرع، بل لنموذج تشغيل مختلف. الذكاء الاصطناعي مدمج في التنقيب والإثراء والتسلسلات والتقييم. الآلة كلها تعمل أسرع، لا مجرد مهمة واحدة على القائمة.',
  allSystemsLink: 'كل الأنظمة ←',
  rows: [
    { label: 'إنشاء الإعلانات', before: 'أيام', after: 'دقائق' },
    { label: 'إثراء الـ CRM', before: 'يدوي / وقت BDR', after: 'مؤتمت' },
    { label: 'موجز SEO ← مسودة', before: 'أسبوع', after: 'ساعات' },
    { label: 'تسلسلات التواصل', before: 'قوالب', after: 'مخصّصة بالذكاء الاصطناعي' },
  ],
  roles: ['نواة الوكيل', 'جسر الأدوات', 'CRM + التسلسلات', 'الإعلانات المدفوعة', 'Edge + Workers', 'طبقة الموقع'],
  stackStatus: 'حزمة المُشغِّل · نشطة دائمًا', bridgeStatus: 'جسر MCP · مباشر', activeLabel: 'نشط',
};
const testimonialsI18n = { eyebrow: 'آراء', title: 'كيف هو', titleSecondary: 'العمل معي.' };

const arTestimonials = [
  { quote: 'فويتشيك مدير تسويق ماهر ومُلهِم بعقلية استراتيجية قوية. أظهر دائمًا استعدادًا لمشاركة معرفته وخبرته. كان تواصله احترافيًا وواضحًا وبنّاءً، ما سهّل التوافق على الأهداف والتنفيذ بكفاءة. خلق بيئة عمل إيجابية وداعمة تُرحّب بالأفكار الجديدة وتواجه التحديات معًا.', name: 'Johanna Elise Adolfsen', role: 'محلّلة تسويق ومستشارة استراتيجية', linkedin: 'https://no.linkedin.com/in/johanna-elise-adolfsen/' },
  { quote: 'عملتُ مع فويتشيك في Tekhuset AS ولم تكن لديّ سوى تجارب إيجابية في تعاوننا. إنه فعّال ويأتي بحلول جيدة.', name: 'Ida Sofie Fritzø Visnes', role: 'منسّقة الأنشطة', company: 'Tekhuset AS', linkedin: 'https://no.linkedin.com/in/ida-sofie-fritz%C3%B8-visnes/' },
  { quote: 'كان العمل مع فويتشيك في SentiOne تجربة استثنائية. بصفته Global Head of Growth، مهاراته القيادية متميّزة وتعزّز التعاون عبر جميع الأقسام. انفتاحه وإصراره يدفعان المشاريع للأمام بحلول مبتكرة باستمرار. قدرته على مواءمة جهود التسويق مع أهداف العمل الأوسع تجعله قيمة لا تُقدّر.', name: 'Thomas Zduleczny', role: 'الاستراتيجية والنمو', company: 'SentiOne', linkedin: 'https://pl.linkedin.com/in/thomas-zduleczny/' },
  { quote: 'فويتشيك شغوف وواسع المعرفة بالتسويق الرقمي وكل ما يتعلق به، ومنسجم تمامًا مع تحديات التسويق والمبيعات الأوسع. ساهم في تحديد وتنفيذ عدة مبادرات تسويق رقمي ساعدت في الاحتفاظ بالعملاء وبناء خط أنابيب المبيعات.', name: 'Robert Sikorski', role: 'رئيس التسويق', company: 'GetResponse', linkedin: 'https://uk.linkedin.com/in/rob-sikorski-0348141' },
  { quote: 'فويتشيك رجل مهمّات محدّدة، العقبة بالنسبة له تحدٍّ جديد. تعلّم بسرعة وكثيرًا ما تجاوز التوقعات، وكان قادرًا على تنفيذ عدة مهام في آنٍ واحد. كفؤ ومتعاون، وفي الوقت نفسه دقيق ومثابر.', name: 'Dariusz Gołębiewski', role: 'مدير', company: 'mBank SA', linkedin: 'https://pl.linkedin.com/in/dariusz-go%C5%82%C4%99biewski-he-him-412371120' },
  { quote: 'أعمل مع فويتشيك منذ عدة أشهر. التعاون يسير بسلاسة، ونعرف دائمًا مسؤولية كلٍّ منا. أوصي بفويتشيك كزميل وشريك عمل جيد.', name: 'Mike Zoladkowski', role: 'مؤسّس', company: 'Type2Sell', linkedin: 'https://ca.linkedin.com/in/mikezoladkowski' },
  { quote: 'كشريك، مستعد للمساعدة ويُبدي اهتمامًا كبيرًا، ليس فقط بزملائه بل أيضًا بعملائه ومزوّدي خدماته. الاستعداد للإصغاء وفهم كل طرف ميزة جيدة لمديري المشاريع ورؤساء الأقسام.', name: 'Martyna Badera', role: 'SAFe Scrum Master', company: 'Rockwell Automation', linkedin: 'https://pl.linkedin.com/in/martyna-badera/' },
];
---

<Layout
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  title="فويتشيك لوشتشينسكي · مُشغِّل نمو وأنظمة إيراد بالذكاء الاصطناعي"
  description="أبني وأُشغّل أنظمة إيراد قائمة على الذكاء الاصطناعي لشركات B2B SaaS والتقنية: استراتيجية الدخول إلى السوق، التسويق، والنمو في نموذج تشغيلي واحد — جاهزة للتوسّع في السعودية ومنطقة الخليج."
  canonical="/ar/"
  ogImage="/og/pages/ar-home.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/' },
    { lang: 'x-default', href: 'https://wojciech.io/' },
  ]}
  preloadImage="/images/wojciech-hero-loft.webp"
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'فويتشيك لوشتشينسكي',
      alternateName: 'Wojciech Łuszczyński',
      jobTitle: 'مُشغِّل نمو · مهندس استراتيجية الدخول إلى السوق (GTM)',
      description: 'عشرون عامًا في بناء أنظمة نمو وإيراد قائمة على الذكاء الاصطناعي لشركات B2B SaaS والتقنية.',
      url: 'https://wojciech.io/ar/',
      knowsLanguage: ['ar', 'en', 'pl'],
      knowsAbout: ['الذكاء الاصطناعي', 'استراتيجية الدخول إلى السوق', 'النمو', 'B2B SaaS', 'أتمتة المؤسسات', 'عمليات الإيراد', 'وكلاء الذكاء الاصطناعي', 'التوسّع الدولي'],
      areaServed: ['السعودية', 'الرياض', 'دول مجلس التعاون الخليجي', 'أوروبا'],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'فويتشيك لوشتشينسكي · مُشغِّل نمو بالذكاء الاصطناعي',
      inLanguage: 'ar',
      isPartOf: { '@type': 'WebSite', name: 'wojciech.io', url: 'https://wojciech.io/' },
    },
  ]}
>
  <HeroSection
    eyebrow="مُشغِّل نمو قائم على الذكاء الاصطناعي"
    h1Primary="أبني أنظمة الإيرادات."
    h1Secondary="ثم أُشغّلها."
    lead="عشرون عامًا في استراتيجية الدخول إلى السوق والتسويق والنمو. أدمجها في نموذج تشغيلي واحد قائم على الذكاء الاصطناعي، أبني ما ينقص، وأبقى إلى أن يعمل النظام فعليًا."
    primaryCta={{ label: 'شاهد الأعمال', href: '#work' }}
    secondaryCta={{ label: 'اشترك في النشرة', href: '/subscribe/' }}
    metaLine="GTM · التسويق · النمو × الذكاء الاصطناعي"
  />

  <MetricsStrip metrics={proof} indexLabel="" />

  <section class="border-b border-[var(--color-border)] py-10 md:py-12">
    <div class="mx-auto max-w-6xl px-6">
      <p class="obs-label-accent mb-7 text-center sm:text-right">{t.operatedAt}</p>
      <div dir="ltr"><BrandLogos variant="marquee" /></div>
    </div>
  </section>

  <HowIWork
    eyebrow="كيف أعمل"
    titlePrimary="لستُ استشاريًا."
    titleSecondary="أنا مُشغِّل."
    steps={steps}
  />

  <ProjectsSection i18n={arWorkI18n} chrome={arChrome} projects={arProjects} />
  <AILeverage i18n={aiI18n} />
  <TestimonialsSection i18n={testimonialsI18n} items={arTestimonials} />

  <CTABand
    kicker="الخطوة التالية"
    heading="تعرف ما الذي لا يعمل. لكنك لست متأكدًا مما يجب بناؤه."
    subtext="أرسل السياق، ونقطة الاختناق، وما يعمل لديك الآن. سأخبرك من أين أبدأ، وهل أنا الشخص المناسب لبنائه."
    cta="احجز مكالمة"
    ctaHref="/ar/contact/#book-call"
    ctaSecondary="شاهد الأعمال"
    ctaSecondaryHref="#work"
  />
</Layout>
