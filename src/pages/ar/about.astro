---

<Layout
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  title="نبذة"
  description="مشغّل نمو يبني أنظمة إيراد أصيلة في الذكاء الاصطناعي لشركات B2B SaaS والتقنية. أربط CRM، وoutbound، والاستحواذ المدفوع، وSEO، وأتمتة الذكاء الاصطناعي في نموذج تشغيلي واحد."
  canonical="/ar/about/"
  ogImage="/og/pages/ar-about.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/about/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/about/' },
    { lang: 'x-default', href: 'https://wojciech.io/about/' },
  ]}
  schema={profileSchema}
>
  <!-- Hero -->
  <section class="relative pt-12 pb-8 md:pt-24 md:pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-office.webp" position="center 28%" opacity={0.14} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row gap-10 md:gap-14 items-start sm:items-center animate-fade-up mb-12">

        <!-- Portrait photo (gold-tinted glow for the AR theme) -->
        <div class="shrink-0 w-56 h-72 sm:w-64 sm:h-80 rounded-[var(--radius-card)] overflow-hidden shadow-[0_0_28px_rgba(212,175,55,0.12)] ring-1 ring-[var(--color-border)]">
          <img
            src="/images/wojciech-office-hq.webp"
            alt="فويتشيك لوشتشينسكي"
            class="w-full h-full object-cover object-[center_20%]"
            width="768"
            height="960"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <div class="max-w-xl">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
            <span class="obs-label-accent">نبذة</span>
          </div>
          <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-about">
            فويتشيك لوشتشينسكي
          </h1>
          <p class="text-[length:var(--text-lead)] text-[var(--color-text)] leading-relaxed mb-3">
            أبني أنظمة الإيرادات وأشغّلها. مشغّل لشركات B2B SaaS والتقنية.
          </p>
          <p class="text-[var(--color-text-muted)] leading-relaxed">
            أربط استراتيجية GTM، والتموضع، وSEO، والمحتوى، والاستحواذ المدفوع، وCRM،
            والتحليلات، والأتمتة، وسير عمل الذكاء الاصطناعي في نموذج تشغيلي واحد. كل ما
            تحت wojciech.io عمل أصلي: مكتوب، ومبني، ومُطلق، ومُشغّل بيدي.
          </p>
        </div>
      </div>

      <!-- Proof rail -->
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {proofPoints.map(({ label, value, detail }) => (
          <div class="obs-panel px-5 py-4 backdrop-blur-sm bg-[rgb(var(--color-surface-rgb)/0.72)]">
            <span class="obs-label-accent mb-2 block">{label}</span>
            <p class="text-base font-semibold text-[var(--color-text)]">{value}</p>
            <p class="mt-1 text-xs leading-relaxed text-[var(--color-text-muted)]">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What makes me atypical -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="ما الذي يميّزني"
        heading="أربط استراتيجية الإيراد، وسير عمل الذكاء الاصطناعي، والبرمجيات المُطلقة في نموذج تشغيلي واحد."
        maxWidth="max-w-3xl"
        class="mb-12"
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {traits.map(({ label, body }) => (
          <div class="obs-panel obs-glow p-7 card-lift">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center mb-5">
              <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold text-[var(--color-text)] mb-2">{label}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Press section intentionally omitted on /ar/: the available press is
       Polish-market (InfoShare PL, a Polish YouTube talk, a Polish article),
       which does not serve the Arabic audience. -->

  <!-- Timeline -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader eyebrow="الخبرة" heading="أين عملت." class="mb-10" />
      <div class="divide-y divide-[var(--color-border)] max-w-3xl">
        {timeline.map(({ period, role, company, href, description, contract, sector }, i) => (
          <div class:list={['flex flex-col sm:flex-row gap-4 py-7', i === 0 ? 'pt-0' : '']}>
            <div class="sm:w-32 shrink-0 pt-0.5">
              <p class:list={['text-xs font-mono text-[var(--color-text-dim)]', contract ? 'italic' : '']}>{period}</p>
              {contract && <span class="text-[9px] font-semibold uppercase tracking-wider text-[var(--color-text-dim)] opacity-60">تعاقد</span>}
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <p class="text-base font-semibold text-[var(--color-text)]">{role}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {href
                  ? <a href={href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors inline-flex items-center gap-1 group">
                      {company}
                      <svg class="w-3 h-3 opacity-40 group-hover:opacity-80 transition-opacity -scale-x-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  : <p class="text-sm font-medium text-[var(--color-text-muted)]">{company}</p>
                }
                {sector && (
                  <span class="text-[10px] font-medium text-[var(--color-accent)] bg-[var(--color-accent)]/8 border border-[var(--color-accent)]/15 rounded-full px-2.5 py-0.5">
                    {sector}
                  </span>
                )}
              </div>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-lg">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <div>
          <SectionHeader eyebrow="الأسئلة الشائعة" heading="أسئلة متكررة." class="mb-2" />
          <p class="text-[var(--color-text-muted)] mt-4 text-sm leading-relaxed max-w-sm">
            إن كنت تفكّر في العمل معي: هذه تغطّي كيف أتعاون، وما الذي تتوقعه، وهل المناسبة صحيحة.
          </p>
          <a
            href="/ar/meet/"
            class="btn-press inline-flex items-center gap-2 mt-8 border border-[var(--color-border-2)] text-[var(--color-text)] text-sm font-medium px-5 py-2.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
          >
            احجز مكالمة بدلًا من ذلك ←
          </a>
        </div>
        <div>
          <FAQ items={faq} />
        </div>
      </div>
    </div>
  </section>

  <!-- Working with me -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
        <SectionHeader
          eyebrow="العمل معي"
          heading="ما الذي تتوقعه."
          lead="أعمل بأفضل صورة في التعاونات حيث توجد مشكلة عمل حقيقية، لا تكليف غامض. المُخرَج دائمًا نظام، لا عرض شرائح."
        />
        <div class="space-y-4">
          {workItems.map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:-translate-x-0.5 transition-transform duration-150">←</span>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <SectionHeader
          eyebrow="التقنيات"
          heading="كيف أبني."
          lead="فئات التقنيات التي أعمل بها وما يتيحه كل منها."
          class="mb-0"
        />
        <a
          href="https://app.wojciech.io"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-xs font-medium text-[var(--color-text-dim)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          مساحة العمل الكاملة ←
        </a>
      </div>

      <div class="divide-y divide-[var(--color-border)] border-t border-[var(--color-border)]">
        {STACK.map((cat) => {
          const ar = stackAr[cat.name] ?? { name: cat.name, enables: cat.enables };
          return (
            <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] lg:grid-cols-[180px_1fr_2fr] gap-x-10 gap-y-1 py-4 items-baseline">
              <span class="obs-label-accent">{ar.name}</span>
              <p class="text-sm font-medium text-[var(--color-text)]" dir="ltr">{cat.items.map((i) => i.name).join(' · ')}</p>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{ar.enables}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <CTABand
    kicker="الخطوة التالية"
    heading="هذا أنا. ما الذي تبنيه؟"
    subtext="إن تضخّمت حزمة GTM لديك حتى صارت شيئًا لا يملكه أحد بالكامل، فهذا هو عملي. أرسل الفوضى."
    cta="احجز مكالمة"
    ctaHref="/ar/meet/"
    ctaSecondary="شاهد الأعمال"
    ctaSecondaryHref="/ar/work/"
  />
</Layout>
