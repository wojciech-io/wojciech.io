---
/* Arabic (RTL) contact page in the production layout. Same structure as
   ContactContent, Arabic copy, dir=rtl. The Cal.com inline calendar (CalInline)
   is the primary CTA, identical to every other locale — the booker adapts to
   the visitor's language and timezone. */
import Layout from '../../layouts/Layout.astro';
import CalInline from '../../components/ui/CalInline.astro';
import { SITE } from '../../data/site';

const goodFit = [
  'تدقيق نظام GTM أو إعادة بنائه',
  'تصميم سير عمل الذكاء الاصطناعي ودمجه',
  'مراجعة معمارية CRM أو RevOps',
  'تحديد نطاق منتج أو تطبيق (MVP)',
  'مراجعة سريعة للكود أو المعمارية',
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'احجز مكالمة · فويتشيك لوشتشينسكي',
  url: SITE.url + '/ar/contact/',
  description: 'مكالمة مدتها 30 دقيقة لتدقيق GTM، تصميم سير عمل الذكاء الاصطناعي، معمارية CRM، وتحديد نطاق المنتجات.',
  inLanguage: 'ar',
  mainEntity: {
    '@type': 'Person',
    name: 'فويتشيك لوشتشينسكي',
    url: SITE.url + '/',
    email: SITE.email,
    sameAs: [SITE.linkedin, SITE.github],
  },
};
---

<Layout
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  title="تواصل · احجز مكالمة"
  description="مكالمة مدتها 30 دقيقة لتدقيق GTM، تصميم سير عمل الذكاء الاصطناعي، معمارية CRM، وتحديد نطاق المنتجات. رابط مباشر للجدولة. ردّ خلال 24 ساعة."
  canonical="/ar/contact/"
  ogImage="/og/pages/ar-contact.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/contact/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/contact/' },
    { lang: 'x-default', href: 'https://wojciech.io/contact/' },
  ]}
  schema={contactSchema}
>
  {/* Same structure as every other locale: promise, then the calendar, then the
      qualifying detail. */}
  <section id="book-call" class="relative pt-10 pb-6 md:pt-14 md:pb-8">
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mb-2">
        <div class="max-w-3xl flex flex-col sm:flex-row sm:items-center gap-6 md:gap-8">
          <!-- Profile photo: the homepage hero shot, framed -->
          <img
            src="/images/wojciech-office-hq.webp"
            width="176"
            height="176"
            alt="فويتشيك لوشتشينسكي"
            loading="eager"
            decoding="async"
            class="w-28 h-28 md:w-36 md:h-36 rounded-2xl object-cover object-[center_22%] border border-[var(--color-border-2)] shadow-[var(--shadow-card)] shrink-0"
          />
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
              <span class="obs-label-accent">تواصل</span>
            </div>
            <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-contact">
              نبني النظام، نصلحه، أو نراجعه.
            </h1>
            <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
              احجز موعدًا لمكالمة مدتها 30 دقيقة. بلا عرض تقديمي ولا شرائح تمهيدية. نبدأ من نظامك أو مشكلتك مباشرة.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CalInline loadingLabel="جارٍ تحميل التقويم…" fallbackLabel="افتح تقويم الحجز" />

  <section class="pt-12 pb-14 md:pt-16 md:pb-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 md:grid-cols-3 md:gap-12 pt-10 border-t border-[var(--color-border)]">
        <div>
          <p class="obs-label-accent mb-4 block">مناسب لـ</p>
          <ul class="space-y-2.5">
            {goodFit.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[var(--color-text-muted)] leading-relaxed">
                <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="obs-label-accent mb-4 block">ما الذي تتوقعه</p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            ثلاثون دقيقة، ندخل فيها إلى صلب المشكلة. أحضر الوضع الحالي، وأين يتعثّر الأمر، وما هو قائم لديك بالفعل. تخرج بمعرفة من أين كنت سأبدأ، سواء عملنا معًا أو لا.
          </p>
        </div>

        <div>
          <p class="obs-label-accent mb-4 block">تفضّل الكتابة أولًا</p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
            أردّ خلال 24 ساعة في أيام العمل. أعمل من مدريد، والتقويم يعرض توقيتك المحلي.
          </p>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
          >
            <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            تواصل عبر LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
