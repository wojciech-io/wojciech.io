---
/* Arabic (RTL) GTM lens, via the shared LensShowcase template. */
import LensShowcase from '../../components/pages/LensShowcase.astro';

const build = [
  { title: 'معمارية المسار', body: 'الـ CRM والتواصل الصادر والمدفوع موصولة في نموذج تشغيل واحد. مصدر حقيقة واحد، لا أربع لوحات منفصلة.' },
  { title: 'RevOps والإسناد', body: 'مراحل دورة الحياة، والتوجيه، والتقارير التي تُظهر بالضبط أين تنكسر الإشارة.' },
  { title: 'تواصل صادر يصيب الهدف', body: 'تسلسلات واستهداف مبنية على إشارة ICP حقيقية، مُثراة ومخصّصة بالذكاء الاصطناعي. لا رشّ عشوائي.' },
];
---

<LensShowcase
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  canonical="/ar/gtm/"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/gtm/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/gtm/' },
    { lang: 'x-default', href: 'https://wojciech.io/gtm/' },
  ]}
  title="GTM"
  description="أنظمة دخول إلى السوق قائمة على الذكاء الاصطناعي: CRM، تواصل صادر، إعلانات مدفوعة، وRevOps موصولة في مسار واحد يمكنك الوثوق به."
  eyebrow="GTM"
  h1Primary="خط أنابيب يتراكم."
  h1Secondary="لا أربع لوحات."
  lead="الـ CRM، والتواصل الصادر، والإعلانات المدفوعة موصولة في نظام واحد. مصدر حقيقة واحد، مبني ومُشغَّل إلى أن يصمد المسار."
  metaLine="CRM · تواصل صادر · مدفوع · RevOps"
  buildEyebrow="ما الذي أبنيه"
  buildHeading="مبني ومُشغَّل، لا مُستشار فيه."
  build={build}
  pov="معظم مشاكل GTM ليست مشاكل استراتيجية، بل مشاكل سباكة. أنا أُصلح السباكة."
  ctaHeading="المسار يتسرّب في مكان لا تراه؟"
  ctaSubtext="أرسل الحزمة الحالية ونقطة الاختناق. سأخبرك أين تنكسر الإشارة ومن أين أبدأ."
  ctaKicker="الخطوة التالية"
  ctaLabel="احجز مكالمة"
  ctaHref="/ar/contact/#book-call"
  ctaSecondary="شاهد الأعمال"
  ctaSecondaryHref="/ar/work/"
/>
