---
/* Arabic (RTL) Growth lens, via the shared LensShowcase template. */
import LensShowcase from '../../components/pages/LensShowcase.astro';

const build = [
  { title: 'تجارب تُطلَق', body: 'قائمة مرتّبة بالأثر، تُشغَّل بإيقاع أسبوعي، وتُقاس بالإيراد.' },
  { title: 'تفعيل واحتفاظ', body: 'الحلقات التي تقرّر إن كان الاكتساب سيُسدّد ثمنه. تُكتشف، وتُجهَّز بالقياس، وتُصلَح.' },
  { title: 'دورة حياة تُشغّل نفسها', body: 'رسائل سلوكية مُحفَّزة يملكها النظام، لا شخص واحد وجدول بيانات.' },
];
---

<LensShowcase
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  canonical="/ar/growth/"
  ogImage="/og/pages/ar-growth.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/growth/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/growth/' },
    { lang: 'x-default', href: 'https://wojciech.io/growth/' },
  ]}
  title="النمو"
  description="النمو كنظام: تجارب، وتفعيل، واحتفاظ، وحلقات دورة حياة تُقاس بالإيراد، لا بمقاييس الغرور."
  eyebrow="النمو"
  h1Primary="تجارب"
  h1Secondary="تُطلَق فعلًا."
  lead="تفعيل، واحتفاظ، وحلقات دورة حياة، تُشغَّل أسبوعيًا وتُقاس بالإيراد. الحلقات التي تقرّر إن كان الاكتساب سيُسدّد ثمنه يومًا."
  metaLine="تجارب · تفعيل · احتفاظ · دورة حياة"
  buildEyebrow="ما الذي أبنيه"
  buildHeading="مبني ومُشغَّل، لا مُستشار فيه."
  build={build}
  pov="مقاييس الغرور تبدو كتقدّم. أنا أقيس تلك التي تُحرّك الإيراد."
  ctaHeading="تكتسب مستخدمين لا يُسدّدون ثمنهم أبدًا؟"
  ctaSubtext="أرسل قمعك وما جرّبته. سأخبرك أيّ حلقة تُصلِح أولًا."
  ctaKicker="الخطوة التالية"
  ctaLabel="احجز مكالمة"
  ctaHref="/ar/meet/"
  ctaSecondary="شاهد الأعمال"
  ctaSecondaryHref="/ar/work/"
/>
