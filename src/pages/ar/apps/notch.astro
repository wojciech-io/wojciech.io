---
/* Arabic (RTL) NotchCue product page. Mirrors /apps/notch/. Product name,
   file names and tech tags stay Latin as code artefacts (opcja B); prose,
   titles and labels are native Arabic. dir=rtl, gold accent via htmlLang. */
import Layout from '../../../layouts/Layout.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import { SITE } from '../../../data/site';

const features = [
  {
    title: 'شغّله عند الحاجة',
    body: 'يبقى المُلقّن مخفيًا حتى تحتاجه. أظهره باختصار لوحة المفاتيح قبل مكالمتك أو عرضك أو تسجيلك مباشرة.',
  },
  {
    title: 'قريب من الكاميرا',
    body: 'يظهر النص في منطقة النوتش، حيث تتجه عيناك أصلًا. انحراف أقل للنظر وأداء أكثر طبيعية.',
  },
  {
    title: 'إيقاع هادئ',
    body: 'اضبط سرعة التمرير على إيقاع صوتك. الأسطر القصيرة تلتقط بها الفكرة التالية بنظرة واحدة دون أن تفقد مكانك.',
  },
  {
    title: 'تمرير يستشعر الصوت',
    body: 'اختياريًا، يتحرك النص أثناء كلامك ويتوقف عند صمتك. مفيد عندما لا تسير المحادثة وفق النص المكتوب.',
  },
  {
    title: 'ملاحظات محلية',
    body: 'تبقى النصوص والإجابات ونقاط الحديث على جهاز Mac. بلا حساب مطلوب، وبلا رفع ملفات قبل كل مكالمة.',
  },
  {
    title: 'تخطيط قابل للضبط',
    body: 'غيّر حجم النص وعرض اللوحة وموضعها بما يناسب شاشتك ونظرك وأسلوبك في الكلام.',
  },
];

const steps = [
  {
    img: '/apps/notch/assets/notchcue-call-20260510.png',
    n: '1',
    title: 'اكتب نقاط حديثك',
    body: 'الصق نقاطًا قصيرة أو مقدمة أو أسئلة أو مقاطع من العرض. النص المكتوب بلغة محكية يعمل أفضل. تجنّب الفقرات الطويلة.',
  },
  {
    img: '/apps/notch/assets/notchcue-hero-20260510.png',
    n: '2',
    title: 'ضعه قرب الكاميرا',
    body: 'يجلس المُلقّن في النوتش، فلا تحتاج إلى النظر نحو زاوية الشاشة. اضبط الحجم والموضع والسرعة بما يناسب جهاز MacBook لديك.',
  },
  {
    img: '/apps/notch/assets/notchcue-desk-20260510.png',
    n: '3',
    title: 'أدر اجتماعك',
    body: 'لديك البنية قريبة منك وما زلت تبدو إنسانًا. من السهل استعادة الخيط بعد سؤال أو وقفة أو تغيير في الموضوع.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: SITE.url + '/ar/' },
    { '@type': 'ListItem', position: 2, name: 'NotchCue', item: SITE.url + '/ar/apps/notch/' },
  ],
};
---

<Layout
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  title="NotchCue"
  description="مُلقّن نصوص لنظام macOS يجلس في نوتش MacBook. تبقى نقاط حديثك قريبة من الكاميرا فيبقى أداؤك طبيعيًا."
  canonical="/ar/apps/notch/"
  ogImage="/apps/notch/assets/notchcue-hero-20260510.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/apps/notch/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/apps/notch/' },
    { lang: 'x-default', href: 'https://wojciech.io/apps/notch/' },
  ]}
  schema={[breadcrumbSchema]}
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <div class="pointer-events-none absolute left-1/2 top-[-200px] h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[var(--color-surface)] opacity-70 blur-[150px]" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32 text-center">
      <div class="animate-fade-up flex items-center justify-center gap-3 mb-8">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">تطبيق macOS</span>
      </div>

      <h1 class="animate-fade-up [animation-delay:60ms] text-[clamp(3rem,8vw,6rem)] font-semibold leading-[1.05] tracking-tight text-[var(--color-text)] max-w-[800px] mx-auto mb-7">
        ملاحظات تبقى<br>
        <span class="text-[var(--color-text-muted)]">قريبة من العدسة.</span>
      </h1>

      <p class="animate-fade-up [animation-delay:120ms] max-w-[34rem] mx-auto text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-10">
        يضع NotchCue نقاط حديثك حول نوتش كاميرا MacBook. يبقى أداؤك طبيعيًا، ويبقى التواصل البصري كما هو.
      </p>

      <div class="animate-fade-up [animation-delay:180ms] flex flex-wrap items-center justify-center gap-3">
        <a href="/apps/notch/downloads/NotchCue.dmg" class="btn-press inline-flex flex-col items-center h-auto rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-2.5 no-underline">
          <span class="text-sm font-semibold text-[var(--color-accent-text)] leading-tight">حمّل NotchCue</span>
          <span class="text-[10px] font-medium text-[var(--color-accent-text)] opacity-70 leading-tight" dir="ltr">DMG · macOS</span>
        </a>
        <a href="#how" class="inline-flex items-center h-11 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors">
          شاهد كيف يعمل
        </a>
      </div>

      <p class="animate-fade-up [animation-delay:240ms] mt-4 text-xs text-[var(--color-text-dim)]">
        يعمل محليًا على جهاز Mac. بلا حساب، بلا رفع ملفات، بلا متصفح.
      </p>
    </div>

    <div class="animate-fade-up [animation-delay:300ms] mx-auto max-w-4xl px-6 pb-16">
      <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
        <img src="/apps/notch/assets/notchcue-hero-20260510.png" alt="مُلقّن NotchCue في منطقة نوتش MacBook أثناء مكالمة فيديو" class="w-full h-auto block" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="border-b border-[var(--color-border)] py-6">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-[var(--color-border)]">
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">انحراف أقل للنظر</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">التلميحات قرب الكاميرا، لا في أسفل الشاشة</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">أداء هادئ</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">تعرف ما يأتي لاحقًا دون البحث في الملاحظات</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">محلي بالكامل</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">تبقى الملاحظات على جهاز Mac، بلا حساب مطلوب</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">المشكلة</p>
        <h2 class="text-fluid-xl font-semibold text-[var(--color-text)] leading-snug mb-4">الملاحظات تكسر التواصل البصري.</h2>
        <p class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
          سواء كانت شاشة ثانية أو نصًا مطبوعًا أو تطبيق ملاحظات عائمًا، لحظة انحراف عينيك عن الكاميرا يشعر بها الجمهور. يتراجع الحضور، ويبدو الأداء وكأنه محفوظ.
        </p>
      </div>
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">الحل</p>
        <h2 class="text-fluid-xl font-semibold text-[var(--color-text)] leading-snug mb-4">التلميحات تعيش بجوار العدسة.</h2>
        <p class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
          يضع NotchCue طبقة تمرير بسيطة فوق الكاميرا مباشرة، في منطقة نوتش MacBook. تقرأ باتجاه العدسة لا بعيدًا عنها. تبقى البنية، ويبقى التواصل البصري.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">كيف يعمل</p>
      <h2 class="reveal-up text-fluid-2xl font-semibold text-[var(--color-text)] leading-snug mb-12 max-w-lg">
        حضّر مرة واحدة، ثم أدر اجتماعك بهدوء.
      </h2>
      <div class="grid md:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {steps.map((s) => (
          <article class="reveal-up bg-[var(--color-surface)] flex flex-col">
            <div class="overflow-hidden border-b border-[var(--color-border)]">
              <img src={s.img} alt={s.title} class="w-full h-48 object-cover object-top" loading="lazy" />
            </div>
            <div class="p-6 flex-1 flex flex-col gap-2">
              <div class="mb-2 h-px w-8 bg-[var(--color-accent-cta)]"></div>
              <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">الخطوة {s.n}</span>
              <h3 class="text-sm font-semibold text-[var(--color-text)]">{s.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo video -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">في المكالمات</p>
          <h2 class="reveal-up text-fluid-2xl font-semibold text-[var(--color-text)] leading-snug mb-4">
            يبدو جزءًا من الشاشة، لا نافذة ملاحظات ثانية.
          </h2>
          <p class="reveal-up text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
            صُمم NotchCue للمكالمات الحقيقية: خفيّ، سريع التشغيل، ومقروء بما يكفي لالتقاط الفكرة التالية دون مسح مستند كامل.
          </p>
        </div>
        <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
          <video autoplay muted loop playsinline preload="metadata" poster="/apps/notch/assets/notchcue-hero-20260510.png" class="w-full h-auto block">
            <source src="/apps/notch/assets/notchcue-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="reveal-up text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)] mb-8">ماذا يفعل</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {features.map((f) => (
          <article class="reveal-up bg-[var(--color-surface)] p-6">
            <div class="mb-4 h-px w-8 bg-[var(--color-accent-cta)]"></div>
            <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2">{f.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Built by -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-wrap items-center justify-between gap-6">
      <div class="reveal-up">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-2">من بناء</p>
        <a href="/ar/" class="group flex items-center gap-2 no-underline">
          <span class="text-base font-semibold text-[var(--color-text)] group-hover:text-[var(--color-text-muted)] transition-colors" dir="ltr">Wojciech Luszczynski</span>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="opacity-40 -scale-x-100"><path d="M6 3h7m0 0v7m0-7L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="reveal-up flex flex-wrap gap-2">
        {['Swift', 'Codex', 'AI-built', 'macOS native'].map((tag) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium text-[var(--color-text-muted)]" dir="ltr">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-[clamp(4rem,8vw,6rem)]">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <img src="/apps/notch/assets/notchcue-icon.png" alt="NotchCue" class="reveal-up w-16 h-16 mx-auto mb-6 rounded-2xl" />
      <h2 class="reveal-up text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.05] tracking-tight text-[var(--color-text)] mb-5">
        جرّبه في<br><span class="text-[var(--color-text-muted)]">مكالمتك التالية.</span>
      </h2>
      <p class="reveal-up text-base leading-relaxed text-[var(--color-text-muted)] mb-8 max-w-sm mx-auto">
        ابدأ بملاحظة قصيرة: مقدمة وثلاث نقاط وخاتمة واحدة. بعد دقائق قليلة سترى إن كان يساعدك على الثبات أمام الكاميرا وإنهاء أفكارك بوضوح.
      </p>
      <div class="reveal-up flex flex-wrap items-center justify-center gap-3">
        <a href="/apps/notch/downloads/NotchCue.dmg" class="btn-press inline-flex flex-col items-center rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-8 py-3 no-underline">
          <span class="text-sm font-semibold text-[var(--color-accent-text)] leading-tight">حمّل NotchCue</span>
          <span class="text-[10px] font-medium text-[var(--color-accent-text)] opacity-70 leading-tight" dir="ltr">NotchCue.dmg / macOS 14+</span>
        </a>
        <a href="mailto:hello@wojciech.io?subject=NotchCue" class="inline-flex items-center h-11 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors">
          أرسل ملاحظاتك
        </a>
      </div>
    </div>
  </section>

  <CTABand
    kicker="الخطوة التالية"
    heading="تبني أدوات لمكتبك أنت أيضًا؟"
    subtext="بدأ NotchCue كفكرة لحاجة شخصية. إن كنت تُدخل الذكاء الاصطناعي في طريقة عملك الفعلية، يسعدني تبادل الملاحظات."
    cta="احجز مكالمة"
    ctaHref="/ar/contact/"
    ctaSecondary="شاهد الأعمال"
    ctaSecondaryHref="/ar/work/"
  />

</Layout>
