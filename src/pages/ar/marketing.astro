---
/* Arabic (RTL) Marketing lens, via the shared LensShowcase template. */
import LensShowcase from '../../components/pages/LensShowcase.astro';
import WebsitePortfolio from '../../components/pages/WebsitePortfolio.astro';

const build = [
  { title: 'تموضع يَعَضّ', body: 'جملة واحدة يكرّرها المشتري لك. وبقية الموقع تتدرّج نحوها.' },
  { title: 'طلب، لا انطباعات', body: 'محتوى وقنوات مُهندَسة لإنتاج مسار يمكنك تتبّعه فعلًا.' },
  { title: 'علامة تتراكم', body: 'وجهة نظر تُنشر باتساق، فيتذكّرك السوق بين دورات الشراء.' },
];

const portfolio = [
  {
    name: 'CIRYAM',
    url: 'https://ciryam.eu',
    displayUrl: 'ciryam.eu',
    industry: 'موسيقى',
    blurb: 'الموقع الرسمي لفرقة روك بولندية: مواعيد الجولات، الإصدارات، الـ press kit، ومشغّل مدمج. طلبات الحجز تصل إلى مكان واحد بدل أن تتبعثر في صناديق البريد.',
    image: '/images/portfolio/ciryam.webp',
    alt: 'الصفحة الرئيسية لموقع ciryam.eu، فرقة روك بولندية، واجهة داكنة مع صورة الفرقة',
  },
  {
    name: 'AN Projekt',
    url: 'https://anprojekt.com.pl',
    displayUrl: 'anprojekt.com.pl',
    industry: 'تصميم داخلي',
    blurb: 'موقع استوديو لمصمّمة ديكور داخلي: معرض لأعمال مُنجَزة، باقات خدمة واضحة، ومسار هادئ من النظرة الأولى إلى الاستشارة الأولى.',
    image: '/images/portfolio/anprojekt.webp',
    alt: 'الصفحة الرئيسية لموقع anprojekt.com.pl، استوديو تصميم داخلي، صورة غرفة معيشة فاتحة',
  },
  {
    name: 'Piotr Sobczyk',
    url: 'https://sobczyk.io',
    displayUrl: 'sobczyk.io',
    industry: 'خدمات B2B',
    blurb: 'موقع شخصي لـ Head of Digital بدوام جزئي. العرض والعملية والتسعير واضحة من البداية، فتبدأ أول مكالمة وقد قطعت نصف الطريق نحو الاتفاق.',
    image: '/images/portfolio/sobczyk.webp',
    alt: 'الصفحة الرئيسية لموقع sobczyk.io، Head of Digital Marketing بدوام جزئي، واجهة داكنة بلمسات صفراء',
  },
];
---

<LensShowcase
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  canonical="/ar/marketing/"
  ogImage="/og/pages/ar-marketing.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/marketing/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/marketing/' },
    { lang: 'x-default', href: 'https://wojciech.io/marketing/' },
  ]}
  title="التسويق"
  description="تسويق B2B مبني لإنتاج مسار صفقات: تموضع، وطلب، وعلامة يمكنك تتبّعها حتى الإيراد."
  eyebrow="التسويق"
  h1Primary="طلب،"
  h1Secondary="لا انطباعات."
  lead="تموضع، ومحتوى، وعلامة مُهندَسة لإنتاج مسار يمكنك تتبّعه. مبنية لتعمل، لا لتجلس في عرض تقديمي."
  metaLine="تموضع · طلب · محتوى · علامة"
  buildEyebrow="ما الذي أبنيه"
  buildHeading="مبني ومُشغَّل، لا مُستشار فيه."
  build={build}
  pov="التسويق الذي لا يمكن تتبّعه إلى المسار زينة. أنا أبني النوع القابل للتتبّع."
  ctaHeading="التسويق مشغول لكن المسار ثابت؟"
  ctaSubtext="أرسل ما تُشغّله الآن. سأخبرك ما هو زينة وما الذي يُحرّك المسار فعلًا."
  ctaKicker="الخطوة التالية"
  ctaLabel="احجز مكالمة"
  ctaHref="/ar/contact/#book-call"
  ctaSecondary="شاهد الأعمال"
  ctaSecondaryHref="/ar/work/"
>
  <WebsitePortfolio
    eyebrow="مواقع أطلقتها"
    heading="مبنية ومُطلَقة، عبر صناعات مختلفة."
    lead="التسويق يحتاج موقعًا يُحمَّل بسرعة ويجعل العرض واضحًا. ثلاثة صمّمتُها وبنيتُها، في ثلاث صناعات مختلفة تمامًا."
    items={portfolio}
    visitLabel="زيارة الموقع"
  />
</LensShowcase>
