---
/* Arabic (RTL) Marketing lens, via the shared LensShowcase template. */
import LensShowcase from '../../components/pages/LensShowcase.astro';

const build = [
  { title: 'تموضع يَعَضّ', body: 'جملة واحدة يكرّرها المشتري لك. وبقية الموقع تتدرّج نحوها.' },
  { title: 'طلب، لا انطباعات', body: 'محتوى وقنوات مُهندَسة لإنتاج مسار يمكنك تتبّعه فعلًا.' },
  { title: 'علامة تتراكم', body: 'وجهة نظر تُنشر باتساق، فيتذكّرك السوق بين دورات الشراء.' },
];
---

<LensShowcase
  htmlLang="ar"
  dir="rtl"
  ogLocale="ar_SA"
  canonical="/ar/marketing/"
  ogImage="/og/pages/ar-marketing.png"
  alternates={[
    { lang: 'en', href: 'https://wojciech.io/marketing/' },
    { lang: 'ar', href: 'https://wojciech.io/ar/marketing/' },
    { lang: 'x-default', href: 'https://wojciech.io/marketing/' },
  ]}
  title="التسويق"
  description="تسويق B2B مبني لإنتاج مسار صفقات: تموضع، وطلب، وعلامة يمكنك تتبّعها حتى الإيراد."
  eyebrow="التسويق"
  h1Primary="طلب،"
  h1Secondary="لا انطباعات."
  lead="تموضع، ومحتوى، وعلامة مُهندَسة لإنتاج مسار يمكنك تتبّعه. مبنية لتعمل، لا لتجلس في عرض تقديمي."
  metaLine="تموضع · طلب · محتوى · علامة"
  buildEyebrow="ما الذي أبنيه"
  buildHeading="مبني ومُشغَّل، لا مُستشار فيه."
  build={build}
  pov="التسويق الذي لا يمكن تتبّعه إلى المسار زينة. أنا أبني النوع القابل للتتبّع."
  ctaHeading="التسويق مشغول لكن المسار ثابت؟"
  ctaSubtext="أرسل ما تُشغّله الآن. سأخبرك ما هو زينة وما الذي يُحرّك المسار فعلًا."
  ctaKicker="الخطوة التالية"
  ctaLabel="احجز مكالمة"
  ctaHref="/ar/contact/#book-call"
  ctaSecondary="شاهد الأعمال"
  ctaSecondaryHref="/ar/work/"
/>
