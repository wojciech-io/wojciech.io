---
/* Standalone Arabic (RTL) CV. Mirrors CvDocument.astro section-for-section but
   is fully standalone (ar is intentionally NOT in SiteLocale/CvLang, so it does
   not flow through the [locale]/cv system). Proper nouns — company, school,
   tool and certification names — stay Latin (opcja B); role titles, bullets,
   degrees, skills and languages are native Arabic. Western numerals kept,
   consistent with the rest of /ar/. Gold accent, IBM Plex Sans Arabic. */

const presentLabel = 'الآن';

const experience = [
  {
    period: '2025 –\nالآن',
    role: 'رئيس التسويق',
    company: 'WebWave / WeNet Group',
    bullets: [
      'قيادة التسويق والنمو عالميًا لمنشئ مواقع no-code مدعوم بالذكاء الاصطناعي',
      'استراتيجية GTM، ورسائل تجارية، ومحرّك نمو قائم على البيانات',
      'ملكية المسار الكامل: SEO، ومحتوى، وإعلانات مدفوعة، وأتمتة، ودورة الحياة',
    ],
  },
  {
    period: '2024 –\n2025',
    role: 'رئيس النمو وتطوير الويب',
    company: 'Symfonia',
    bullets: [
      'زيادة الزيارات العضوية بنسبة 40% عبر SEO وتحسينات تقنية',
      'زيادة توليد العملاء المحتملين بنسبة 30% بصفحات هبوط عالية التحويل واختبارات A/B',
      'زيادة زيارات المدوّنة بنسبة 50% عبر استراتيجيات محتوى قائمة على الأتمتة',
      'تحسين سرعة الموقع بنسبة 25%، مع تجربة استخدام وتفاعل أفضل',
      'ربط تدفّقات عمل التسويق والمنتج وتطوير الويب، وتقليل احتكاك التسليم',
    ],
  },
  {
    period: '2020 –\n2024',
    role: 'رئيس النمو العالمي',
    company: 'SentiOne',
    bullets: [
      'بناء GTM لـ B2B SaaS عبر أوروبا والمملكة المتحدة والولايات المتحدة والإمارات وأمريكا اللاتينية',
      'قفزة 50% في زيارات الموقع عبر SEO وإعادة التصميم واستراتيجية المحتوى',
      'تسريع اكتساب العملاء بنسبة 80% عبر اتصالات دقيقة الاستهداف',
      'زيادة العملاء المحتملين للمبيعات بنسبة 20% عبر تعاون استراتيجي مع فرق المبيعات',
      'رفع التعرّف على العلامة بنسبة 60% عبر استراتيجيات عالمية مُصمَّمة لكل سوق',
    ],
  },
  {
    period: '2019 –\n2020',
    role: 'رئيس تسويق دورة الحياة',
    company: 'GetResponse',
    bullets: [
      'رفع تفاعل العملاء والإيراد بنسبة 30% عبر تسويق دورة حياة يقوده الـ CRM',
      'تطبيق CRM لرفع التحويل بنسبة 25% عبر رؤى العملاء والتقسيم',
      'قيادة اختبارات A/B حقّقت زيادة 20% في معدّلات التحويل',
      'تنسيق حملات عالمية بنفاذٍ ناجح إلى أسواق الولايات المتحدة وأمريكا اللاتينية والاتحاد الأوروبي',
    ],
  },
  {
    period: 'عقد',
    contract: true,
    role: 'مدير الذكاء الاصطناعي والابتكار · مدير تسويق بدوام جزئي · رئيس التسويق',
    company: 'Gi Group Holding · Tekhuset · Lilla House Digital',
    bullets: [
      'تحويل تدفّقات العمل بالذكاء الاصطناعي وتوحيد أنظمة ATS في Gi Group (أكثر من 2000 موظف)',
      'استكشاف مشاريع الواقع المعزّز / الميتافيرس وتخطيط التنفيذ',
      'تحسين النمو وSEO واختبارات A/B في Tekhuset',
      'تسويق رقمي وحملات إيراد في Lilla House Digital',
    ],
  },
  {
    period: '2018 –\n2019',
    role: 'رئيس القسم الرقمي',
    company: 'Marquard Media Group',
    bullets: [
      'قيادة الاستراتيجية الرقمية لـ 9 بوّابات بفريق من 21 شخصًا عبر أسواق الاتحاد الأوروبي',
      'إطلاق تطبيق محمول وسّع الوصول في B2C وB2B',
      'تحسين SEO وPPC وUX/UI ومسارات التحويل',
      'تطوير خرائط طريق للمنتج متوافقة مع اتجاهات السوق',
    ],
  },
  {
    period: '2015 –\n2018',
    role: 'رئيس الاتصالات التسويقية',
    company: 'City of Łódź Office',
    bullets: [
      'تجاوز أهداف الاتصال التسويقي بنسبة 25% ضمن قيود الميزانية',
      'تجاوز أهداف التسويق بنسبة 30% عبر التخطيط والتنفيذ الاستراتيجي',
      'تأمين أكثر من 50 ظهورًا إعلاميًا عبر قنوات البثّ والمطبوع والرقمي',
      'ارتفاع 15% في الكفاءة التشغيلية عبر مبادرات تكامل الفريق',
    ],
  },
  {
    period: '2010 –\n2015',
    role: 'مدير العلاقات العامة',
    company: 'City of Łódź Office',
    bullets: [
      'نمو 20% في جمهور وسائل التواصل عبر قيادة الفريق واستراتيجية العلامة',
      'قفزة 40% في التغطية الإعلامية عبر إنتاج محتوى جذّاب',
      'التزام 95% بمؤشّرات حملات العلاقات العامة؛ ونسبة نجاح 95% في تنفيذ المشاريع',
      'خمس شراكات استراتيجية عزّزت العلامة والتفاعل المجتمعي',
    ],
  },
];

const skills = [
  'معمارية الإيراد', 'أنظمة GTM', 'تدفّقات الذكاء الاصطناعي', 'B2B SaaS', 'استراتيجية النمو',
  'SEO', 'CRO', 'CRM', 'التواصل الصادر', 'تسويق دورة الحياة', 'PPC', 'UX / UI',
  'تحليل البيانات', 'القيادة', 'إدارة المشاريع', 'إدارة العلامة', 'مراقبة الإعلام', 'اتصالات الأزمات',
];

const tools = [
  'Claude', 'Claude Code', 'ChatGPT', 'Perplexity', 'NotebookLM',
  'n8n', 'Make', 'Zapier', 'Clay',
  'HubSpot', 'Salesforce', 'Klaviyo', 'Intercom',
  'GA4', 'Mixpanel', 'PostHog', 'Looker Studio', 'Hotjar',
  'Ahrefs', 'SEMrush', 'Brand24',
  'Google Ads', 'Linear', 'Figma', 'Notion', 'Cursor',
];

const education = [
  { degree: 'ماجستير تنفيذي في إدارة الأعمال (Executive MBA)', school: 'Collegium Humanum', year: '2021' },
  { degree: 'ماجستير في الصحافة والاتصال الاجتماعي', school: 'University of Łódź', year: '2021 – 2022' },
  { degree: 'دراسات عليا · العلاقات العامة', school: 'Warsaw School of Economics', year: '2016 – 2017' },
  { degree: 'بكالوريوس في العلاقات الدولية', school: 'University of Łódź', year: '2007 – 2010' },
];

const languages = [
  { name: 'البولندية', level: 'لغة أم' },
  { name: 'الإنجليزية', level: 'لغة أم' },
  { name: 'الألمانية', level: 'أساسي' },
  { name: 'الفرنسية', level: 'أساسي' },
];

const certifications = [
  { name: 'GA4 Advanced Academy', issuer: 'Google' },
  { name: 'Fundamentals of Digital Marketing', issuer: 'Google' },
  { name: 'Growth-Driven Design Academy', issuer: 'HubSpot' },
  { name: 'Inbound Marketing Academy', issuer: 'HubSpot' },
  { name: 'Bing Ads Accredited Professional', issuer: 'Microsoft' },
  { name: 'Advanced Growth Series', issuer: 'Reforge' },
  { name: 'Content Marketing & SEO', issuer: 'SEMrush' },
];

const localizePeriod = (period: string) => period.replace('present', presentLabel);
const metaTitle = 'فويتشيك لوشتشينسكي · السيرة الذاتية';
const metaDescription = 'السيرة الذاتية لفويتشيك لوشتشينسكي، مهندس GTM ومشغّل نمو. أنظمة إيراد قائمة على الذكاء الاصطناعي لشركات B2B SaaS. 20 عامًا في التسويق، 10 أعوام في نمو B2B SaaS.';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://wojciech.io/ar/cv/" />
  <link rel="alternate" hreflang="en" href="https://wojciech.io/cv/" />
  <link rel="alternate" hreflang="ar" href="https://wojciech.io/ar/cv/" />
  <link rel="alternate" hreflang="x-default" href="https://wojciech.io/cv/" />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content="https://wojciech.io/ar/cv/" />
  <meta property="og:type" content="profile" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:image" content="https://wojciech.io/og/pages/ar-cv.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content="https://wojciech.io/og/pages/ar-cv.png" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0c" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f5ee" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=7" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=7" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=7" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=7" />
  <link rel="preload" href="/fonts/IBMPlexSansArabic-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/IBMPlexSansArabic-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/IBMPlexSansArabic-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    @font-face {
      font-family: 'IBM Plex Sans Arabic'; font-style: normal; font-weight: 400;
      font-display: swap; src: url('/fonts/IBMPlexSansArabic-400.woff2') format('woff2');
    }
    @font-face {
      font-family: 'IBM Plex Sans Arabic'; font-style: normal; font-weight: 600;
      font-display: swap; src: url('/fonts/IBMPlexSansArabic-600.woff2') format('woff2');
    }
    @font-face {
      font-family: 'IBM Plex Sans Arabic'; font-style: normal; font-weight: 700;
      font-display: swap; src: url('/fonts/IBMPlexSansArabic-700.woff2') format('woff2');
    }

    :root {
      --color-bg:        #0c0c0c;
      --color-surface:   #171717;
      --color-surface-2: #1e1e1e;
      --color-border:    #2a2a2a;
      --color-border-2:  #383838;
      --color-text:      #f0f0f0;
      --color-text-muted:#a0a0a0;
      --color-text-dim:  #5a5a5a;
      /* /ar/ premium gold accent instead of lime. */
      --color-accent:    #d4af37;
      --color-accent-hi: #e6c25a;
      --color-accent-lo: #2a2515;
      --font-sans:       'IBM Plex Sans Arabic', system-ui, sans-serif;
      --font-mono:       'Geist Mono', monospace;
      --radius-card:     12px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    .page { max-width: 900px; margin: 0 auto; padding: 48px 40px 64px; }

    .cv-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 28px;
      align-items: center;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 36px;
    }
    @media (max-width: 720px) {
      .cv-header { grid-template-columns: 1fr; gap: 18px; }
      .cv-avatar { width: 88px; height: 88px; }
    }
    .cv-avatar {
      width: 112px; height: 112px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      background: var(--color-surface-2);
    }

    .cv-wordmark {
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--color-text-dim); margin-bottom: 6px;
      direction: ltr; text-align: start;
    }
    .cv-wordmark span { color: var(--color-accent); }

    .cv-name { font-size: 36px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; color: var(--color-text); margin-bottom: 10px; }
    .cv-tagline { font-size: 13px; color: var(--color-text-muted); font-weight: 400; }

    .cv-contact { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; padding-top: 4px; }
    .cv-contact a, .cv-contact span { font-size: 12px; color: var(--color-text-muted); font-family: var(--font-mono); direction: ltr; transition: color 0.15s; }
    .cv-contact a:hover { color: var(--color-accent-hi); }

    .cv-body { display: grid; grid-template-columns: 1fr 260px; gap: 0 40px; }

    .section-label {
      font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--color-text-dim); margin-bottom: 16px; padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
    }

    .exp-section { margin-bottom: 32px; }
    .exp-item { display: grid; grid-template-columns: 72px 1fr; gap: 0 16px; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
    .exp-item:last-child { border-bottom: none; }
    .exp-period { font-family: var(--font-mono); font-size: 10px; color: var(--color-text-dim); padding-top: 2px; line-height: 1.4; white-space: pre-line; direction: ltr; text-align: start; }
    .exp-period.contract { font-style: italic; }
    .exp-role { font-size: 13px; font-weight: 600; color: var(--color-text); margin-bottom: 1px; }
    .exp-company { font-size: 11px; font-weight: 500; color: var(--color-accent); margin-bottom: 6px; direction: ltr; text-align: start; }
    .exp-company.contract { color: var(--color-text-muted); }
    .exp-bullets { list-style: none; display: flex; flex-direction: column; gap: 3px; }
    .exp-bullets li { font-size: 12px; color: var(--color-text-muted); padding-right: 14px; position: relative; line-height: 1.6; }
    .exp-bullets li::before { content: '←'; position: absolute; right: 0; color: var(--color-accent); font-size: 10px; top: 2px; }

    .sidebar-block { margin-bottom: 28px; }
    .chips { display: flex; flex-wrap: wrap; gap: 5px; }
    .chip { font-size: 10px; font-weight: 500; padding: 3px 8px; border-radius: 4px; border: 1px solid var(--color-border-2); background: var(--color-surface); color: var(--color-text-muted); }
    .chip.ltr { direction: ltr; }

    .edu-item { margin-bottom: 12px; }
    .edu-degree { font-size: 12px; font-weight: 600; color: var(--color-text); margin-bottom: 1px; }
    .edu-school { font-size: 11px; color: var(--color-text-muted); margin-bottom: 1px; direction: ltr; text-align: start; }
    .edu-year { font-size: 10px; font-family: var(--font-mono); color: var(--color-text-dim); direction: ltr; text-align: start; }

    .lang-item { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid var(--color-border); font-size: 12px; }
    .lang-item:last-child { border-bottom: none; }
    .lang-name { color: var(--color-text); font-weight: 500; }
    .lang-level { color: var(--color-text-dim); font-size: 11px; }

    .cert-item { font-size: 11px; color: var(--color-text-muted); padding: 4px 0; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; gap: 8px; direction: ltr; }
    .cert-item:last-child { border-bottom: none; }
    .cert-issuer { font-size: 10px; color: var(--color-text-dim); font-family: var(--font-mono); }

    @media print {
      html, body { background: #0c0c0c !important; color: #f0f0f0 !important; }
      .page { padding: 24px 28px 40px; max-width: 100%; }
      .cv-name { font-size: 28px; }
      .exp-item { break-inside: avoid; }
      .sidebar-block { break-inside: avoid; }
    }

    .print-bar { position: fixed; bottom: 24px; left: 24px; z-index: 100; display: flex; gap: 10px; }
    .print-btn { background: var(--color-accent); color: #0c0c0c; font-family: var(--font-sans); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; }
    .print-btn:hover { background: var(--color-accent-hi); }
    @media print { .print-bar { display: none; } }
  </style>
</head>
<body>

<div class="page">

  <header class="cv-header">
    <img class="cv-avatar" src="/images/wojciech-avatar-384.webp" srcset="/images/wojciech-avatar-384.webp 384w, /images/wojciech-avatar-768.webp 768w" sizes="112px" alt="فويتشيك لوشتشينسكي" width="112" height="112" loading="eager" />
    <div>
      <p class="cv-wordmark">wojciech<span>.io</span> · <a href="https://app.wojciech.io" target="_blank" style="font-weight:400;opacity:0.55;font-size:0.72em;">interactive version</a></p>
      <h1 class="cv-name">Wojciech<br />Łuszczyński</h1>
      <p class="cv-tagline">مشغّل نمو · مهندس GTM · باني أنظمة قائمة على الذكاء الاصطناعي</p>
    </div>
    <div class="cv-contact">
      <a href="mailto:hello@wojciech.io">hello@wojciech.io</a>
      <a href="https://wojciech.io/ar/contact/" target="_blank">wojciech.io/ar/contact</a>
      <a href="https://wojciech.io/ar/" target="_blank">wojciech.io/ar</a>
      <a href="https://www.linkedin.com/in/wojciech-luszczynski/" target="_blank">linkedin.com/in/wojciech-luszczynski</a>
      <span>عن بُعد · منفتح على الانتقال</span>
    </div>
  </header>

  <div class="cv-body">

    <main>
      <div class="exp-section">
        <p class="section-label">الخبرة</p>

        {experience.map((exp) => (
          <div class="exp-item">
            <span class={`exp-period${exp.contract ? ' contract' : ''}`}>{localizePeriod(exp.period)}</span>
            <div>
              <p class="exp-role">{exp.role}</p>
              <p class={`exp-company${exp.contract ? ' contract' : ''}`}>{exp.company}</p>
              <ul class="exp-bullets">
                {exp.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </main>

    <aside class="sidebar">

      <div class="sidebar-block">
        <p class="section-label">المهارات الأساسية</p>
        <div class="chips">
          {skills.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>

      <div class="sidebar-block">
        <p class="section-label">الأدوات والمنصّات</p>
        <div class="chips">
          {tools.map((toolName) => <span class="chip ltr">{toolName}</span>)}
        </div>
      </div>

      <div class="sidebar-block">
        <p class="section-label">التعليم</p>
        {education.map((e) => (
          <div class="edu-item">
            <p class="edu-degree">{e.degree}</p>
            <p class="edu-school">{e.school}</p>
            <p class="edu-year">{e.year}</p>
          </div>
        ))}
      </div>

      <div class="sidebar-block">
        <p class="section-label">اللغات</p>
        {languages.map((l) => (
          <div class="lang-item">
            <span class="lang-name">{l.name}</span>
            <span class="lang-level">{l.level}</span>
          </div>
        ))}
      </div>

      <div class="sidebar-block">
        <p class="section-label">الشهادات</p>
        {certifications.map((c) => (
          <div class="cert-item">
            <span>{c.name}</span>
            <span class="cert-issuer">{c.issuer}</span>
          </div>
        ))}
      </div>

    </aside>
  </div>
</div>

<div class="print-bar">
  <button class="print-btn" onclick="window.print()">احفظ كـ PDF ←</button>
</div>

</body>
</html>
