---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';

/* Brand icons are dropped into public/images/stack/icons/{slug}.svg (see
   docs/stack-icons-brief.md). They're inlined so they tint with the theme.
   Anything without a file falls back to a clean text-only chip. */
const iconDir = path.join(process.cwd(), 'public/images/stack/icons');
function iconSvg(slug?: string): string | null {
  if (!slug) return null;
  try {
    const raw = fs.readFileSync(path.join(iconDir, `${slug}.svg`), 'utf8');
    return raw.replace(/^\s*<svg\b/, '<svg class="h-full w-full" aria-hidden="true"');
  } catch {
    return null;
  }
}

type Tool = { name: string; slug?: string };

// ── Deploy flow (workflow diagram, top) ──────────────────────────────────
const flow: { stage: string; lead: Tool; note: string }[] = [
  { stage: 'Source',   lead: { name: 'GitHub', slug: 'github' },              note: 'Monorepo, branch-protected main' },
  { stage: 'CI gate',  lead: { name: 'GitHub Actions', slug: 'githubactions' }, note: 'Vitest · Playwright · Semgrep · CodeQL' },
  { stage: 'Build',    lead: { name: 'Astro', slug: 'astro' },                note: 'Static + Pages Functions' },
  { stage: 'Deploy',   lead: { name: 'Cloudflare Pages', slug: 'cloudflarepages' }, note: 'Wrangler → 7 surfaces, only on green CI' },
  { stage: 'Edge',     lead: { name: 'Cloudflare', slug: 'cloudflare' },       note: 'CDN · WAF · rate limiting' },
];

// ── Layers (architecture, below) ─────────────────────────────────────────
const layers: { title: string; body: string; tools: Tool[] }[] = [
  {
    title: 'Architecture',
    body: 'npm-workspaces monorepo. Astro on Cloudflare Pages — seven surfaces, seven Pages projects. Shared token, UI, and MDX packages.',
    tools: [
      { name: 'Astro', slug: 'astro' },
      { name: 'MDX', slug: 'mdx' },
      { name: 'npm workspaces', slug: 'npm' },
      { name: 'TypeScript', slug: 'typescript' },
    ],
  },
  {
    title: 'Frontend',
    body: 'Tailwind CSS 4 driven by CSS custom-property tokens. Geist for type. Lenis + Motion for motion. Pagefind for static search.',
    tools: [
      { name: 'Tailwind CSS', slug: 'tailwindcss' },
      { name: 'Vite', slug: 'vite' },
      { name: 'Geist' },
      { name: 'Motion' },
      { name: 'Pagefind' },
    ],
  },
  {
    title: 'Infra',
    body: 'Cloudflare Pages Functions for gated surfaces. Workers for the growthhub cron. Terraform manages Pages projects and domains. Node 24 in CI.',
    tools: [
      { name: 'Cloudflare Workers', slug: 'cloudflareworkers' },
      { name: 'Terraform', slug: 'terraform' },
      { name: 'Node.js 24', slug: 'nodedotjs' },
    ],
  },
  {
    title: 'Content & i18n',
    body: 'Astro content collections for insights, work, and testimonials. Eight languages across CV and SEO surfaces, seven fully translated locale homepages on top of EN.',
    tools: [
      { name: 'Astro collections', slug: 'astro' },
      { name: 'MDX', slug: 'mdx' },
      { name: '8 locales' },
    ],
  },
  {
    title: 'Analytics',
    body: 'Cloudflare Web Analytics runs anonymously by default. Everything else loads only after explicit consent, all EU-resident.',
    tools: [
      { name: 'GA4', slug: 'googleanalytics' },
      { name: 'Mixpanel', slug: 'mixpanel' },
      { name: 'PostHog', slug: 'posthog' },
      { name: 'Sentry', slug: 'sentry' },
    ],
  },
  {
    title: 'Testing',
    body: 'Vitest for units and coverage. Playwright across Chromium + WebKit for smoke, SEO, a11y, and broken-link checks. Daily smoke against production.',
    tools: [
      { name: 'Vitest', slug: 'vitest' },
      { name: 'Playwright', slug: 'playwright' },
      { name: 'Lighthouse CI', slug: 'lighthouse' },
    ],
  },
  {
    title: 'CI/CD',
    body: 'CI on every push and PR. Deploy runs only on CI success via workflow_run, shipping site and subdomains in parallel through Wrangler. Commitlint enforced.',
    tools: [
      { name: 'GitHub Actions', slug: 'githubactions' },
      { name: 'Wrangler', slug: 'cloudflare' },
      { name: 'Commitlint' },
    ],
  },
  {
    title: 'Security',
    body: 'Branch protection with required checks. Strict CSP, HSTS preload, XFO DENY. Auth gates use HMAC-SHA256 signed cookies with timing-safe compares and per-IP rate limiting.',
    tools: [
      { name: 'Semgrep', slug: 'semgrep' },
      { name: 'CodeQL', slug: 'codeql' },
      { name: 'gitleaks' },
      { name: 'CSP · HSTS' },
    ],
  },
  {
    title: 'Resilience',
    body: 'Azure Static Web Apps holds a weekly cold standby. Failover is operator-triggered, auto-detects health, then flips DNS via the Cloudflare API. Rollback is a non-destructive git revert.',
    tools: [
      { name: 'Azure SWA', slug: 'microsoftazure' },
      { name: 'Cloudflare DNS', slug: 'cloudflare' },
      { name: 'BetterStack' },
    ],
  },
  {
    title: 'Working method',
    body: 'Claude Code implements. Codex reviews. Strategy and go/no-go stay human. Merge once docs and code agree.',
    tools: [
      { name: 'Claude Code', slug: 'anthropic' },
      { name: 'Codex', slug: 'openai' },
    ],
  },
];

const stats = [
  { value: '7', label: 'surfaces deployed' },
  { value: '8', label: 'languages shipped' },
  { value: '524', label: 'automated tests' },
  { value: '10', label: 'stack layers' },
];
---

<Layout
  title="Production Stack"
  description="The real stack behind wojciech.io and its subdomains. Astro, Cloudflare, Terraform, Vitest, Playwright, signed cookies, and a manual failover plan that has actually been tested."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="animate-fade-up flex items-center gap-3 mb-6">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">Production stack</span>
      </div>
      <h1 class="animate-fade-up [animation-delay:60ms] text-[length:var(--text-hero)] font-semibold leading-[1.02] tracking-tight text-[var(--color-text)] max-w-[900px] mb-6">
        What this site is actually built on.
      </h1>
      <p class="animate-fade-up [animation-delay:120ms] max-w-3xl text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
        Verified from the repo, not from memory. Every layer below is in production today across wojciech.io and its subdomains. If a tool is on this page, it pays rent.
      </p>
    </div>
  </section>

  <!-- Deploy flow: the workflow, end to end -->
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="flex items-center gap-3 mb-8">
        <span class="obs-label-accent">Push to production</span>
      </div>

      <div class="flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-0">
        {flow.map((step, i) => {
          const svg = iconSvg(step.lead.slug);
          return (
            <>
              <div class="flex-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
                <p class="obs-label text-[10px] tracking-[0.16em] mb-3">{String(i + 1).padStart(2, '0')} · {step.stage}</p>
                <div class="flex items-center gap-2.5 mb-2">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-1.5 text-[var(--color-text)] shrink-0">
                    {svg ? <Fragment set:html={svg} /> : <span class="text-[10px] font-semibold">{step.lead.name.slice(0, 2)}</span>}
                  </span>
                  <span class="text-sm font-semibold text-[var(--color-text)] leading-tight">{step.lead.name}</span>
                </div>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{step.note}</p>
              </div>
              {i < flow.length - 1 && (
                <div class="flex items-center justify-center py-1 lg:px-2" aria-hidden="true">
                  <svg class="h-4 w-4 rotate-90 text-[var(--color-text-dim)] lg:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
              )}
            </>
          );
        })}
      </div>
      <p class="mt-4 text-xs text-[var(--color-text-dim)]">Deploy only fires on green CI (workflow_run gate). No green, no ship.</p>
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-b border-[var(--color-border)] py-6">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-[var(--color-border)]">
        {stats.map((s, i) => (
          <div class="reveal-up px-6 py-3 flex flex-col gap-0.5" data-reveal-index={i}>
            <strong class="text-fluid-2xl font-semibold text-[var(--color-text)] tabular-nums">{s.value}</strong>
            <span class="text-xs text-[var(--color-text-muted)]">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Layers: the stack, top to bottom, with tool icons -->
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <div class="flex items-center gap-3 mb-10">
        <span class="obs-label-accent">The layers</span>
      </div>

      <div class="grid gap-4 md:gap-5">
        {layers.map((layer, idx) => (
          <article class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-7 grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:items-center md:gap-10" data-reveal-index={idx % 4}>
            <div>
              <div class="flex items-baseline gap-3 mb-2">
                <span class="obs-label text-[10px] tracking-[0.16em] text-[var(--color-text-dim)]">{String(idx + 1).padStart(2, '0')}</span>
                <h2 class="text-fluid-lg font-semibold text-[var(--color-text)] leading-tight tracking-tight">{layer.title}</h2>
              </div>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{layer.body}</p>
            </div>

            <div class="flex flex-wrap gap-2">
              {layer.tools.map((tool) => {
                const svg = iconSvg(tool.slug);
                return (
                  <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] py-1.5 pl-2 pr-3.5">
                    <span class="flex h-5 w-5 items-center justify-center text-[var(--color-text)] shrink-0">
                      {svg
                        ? <Fragment set:html={svg} />
                        : <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-cta)]" aria-hidden="true" />}
                    </span>
                    <span class="text-[13px] font-medium text-[var(--color-text)] whitespace-nowrap">{tool.name}</span>
                  </span>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    heading="Want to see a piece of this in action?"
    subtext="If something on the page is interesting in context of what you are building, write me and we will look at it together."
    cta="Get in touch"
    ctaHref="/contact/"
    ctaSecondary="Read insights"
    ctaSecondaryHref="/insights/"
  />
</Layout>
