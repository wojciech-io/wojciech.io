---
import Layout from '../../layouts/Layout.astro';
import NowContent from '../../components/pages/NowContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="Now"
  description="What Wojciech Łuszczyński is focused on right now — building, reading, thinking."
>
  <NowContent />
</Layout>
