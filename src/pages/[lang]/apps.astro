---
import Layout from '../../layouts/Layout.astro';
import AppsContent from '../../components/pages/AppsContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="Apps"
  description="Products built and shipped by Wojciech Łuszczyński: Notch, Subscribe, and the full app portfolio."
>
  <AppsContent />
</Layout>
