---
import Layout from '../../layouts/Layout.astro';
import AiSystemsContent from '../../components/pages/AiSystemsContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="AI Systems"
  description="AI-native workflows, GTM agents, and operating leverage: how Wojciech builds with AI in practice."
>
  <AiSystemsContent />
</Layout>
