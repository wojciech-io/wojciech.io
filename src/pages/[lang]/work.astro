---
import Layout from '../../layouts/Layout.astro';
import WorkContent from '../../components/pages/WorkContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="Work"
  description="Selected systems, case studies, and growth outcomes. The proof architecture of Wojciech Łuszczyński."
>
  <WorkContent />
</Layout>
