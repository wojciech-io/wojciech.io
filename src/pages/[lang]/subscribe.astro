---
import Layout from '../../layouts/Layout.astro';
import SubscribeContent from '../../components/pages/SubscribeContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="Subscribe"
  description="Get weekly notes on AI systems, GTM architecture, and what I'm building, straight to your inbox."
>
  <SubscribeContent />
</Layout>
