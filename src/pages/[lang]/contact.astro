---
import Layout from '../../layouts/Layout.astro';
import ContactContent from '../../components/pages/ContactContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="Contact"
  description="Get in touch with Wojciech Łuszczyński — growth operator, GTM architect, AI-native builder."
>
  <ContactContent />
</Layout>
