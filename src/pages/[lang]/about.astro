---
import Layout from '../../layouts/Layout.astro';
import AboutContent from '../../components/pages/AboutContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  initialLang={lang}
  title="About"
  description="Wojciech Łuszczyński. Growth operator, GTM architect, AI-native builder. The full operator profile."
>
  <AboutContent />
</Layout>
