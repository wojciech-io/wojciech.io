---
import Layout from '../../layouts/Layout.astro';
import PageBackdrop from '../../components/ui/PageBackdrop.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

const ghDemo = 'https://gh.wojciech.io/demo';
const ghApp = 'https://gh.wojciech.io';

const features = [
  {
    title: 'Weekly review',
    body: 'Headline metrics, akwizycja 14d, źródła ruchu, lejek marketingowy, pipeline sprzedaży i segmenty ICP w jednym widoku.',
  },
  {
    title: 'Pipeline snapshot',
    body: 'Top leady, scoring, stage breakdown. Bez logowania do CRM-a po każdy raport.',
  },
  {
    title: 'Paid channels',
    body: 'CAC, ROAS, share of spend per channel. Operator-grade, nie marketingowy slajd.',
  },
  {
    title: 'Real data lub demo',
    body: 'Public demo na syntetycznych danych. Real-data wpada po połączeniu GA4 / Pipedrive przez D1.',
  },
];
---

<Layout
  title="GrowthHub"
  description="Operator-grade growth dashboard dla B2B SaaS: metryki, pipeline, ICP segments. Demo bez logowania."
>
  <section class="relative pt-12 pb-8 md:pt-24 md:pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">
        <a href="/work/" class="hover:text-[var(--color-accent-hi)]">Work</a> · GrowthHub
      </p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Growth dashboard dla operatorów B2B SaaS.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed">
        Jedna powierzchnia: akwizycja, pipeline, paid, ICP. Bez logowania do pięciu narzędzi co poniedziałek. Public demo dostępne bez konta.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={ghDemo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90"
        >
          Zobacz demo
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href="/contact/#book-call"
          data-cal-link="wojciech-luszczynski/30min"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]"
        >
          Postaw to u siebie
        </a>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Co jest w środku"
        heading="Cztery widoki, jeden poniedziałek."
        lead="GrowthHub łączy dane z GA4, Pipedrive i kanałów paid. D1 jako warstwa pośrednia, dashboard jako miejsce decyzji."
      />
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        {features.map((f) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">{f.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pełna aplikacja</p>
        <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
          Demo bez logowania, real-data po sync.
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          Demo działa publicznie. Wersja produkcyjna spina GA4, Pipedrive i kanały paid przez Cloudflare D1.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={ghApp} target="_blank" rel="noopener noreferrer" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          gh.wojciech.io
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
