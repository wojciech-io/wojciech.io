---
import Layout from '../../layouts/Layout.astro';
import PageBackdrop from '../../components/ui/PageBackdrop.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { SITE } from '../../data/site';

const academyUrl = 'https://academy.wojciech.io';

const series = [
  {
    n: '1',
    title: 'AI jako narzędzie operatora',
    meta: '12 odcinków · ~5h audio',
    body: 'Wybór modelu pod zadanie, koszt tokenów, granica między demo a produkcją.',
  },
  {
    n: '2',
    title: 'Outbound jak system, nie spam',
    meta: '12 odcinków · ~6h audio',
    body: 'ICP → SQL quality. Enrichment, sygnały zakupowe, kwalifikacja fit, personalizacja bez SDR-a.',
  },
  {
    n: '3',
    title: 'Content jako infrastruktura',
    meta: '12 odcinków · ~5h audio',
    body: 'Pipeline research → draft → publikacja → loop SEO/social/email. AI w środku, człowiek na końcu.',
  },
  {
    n: '4',
    title: 'Operating system dla GTM',
    meta: '12 odcinków · ~6h audio',
    body: 'Dashboardy, scoring, automatyzacje, agenty MCP, rytmy ownership. AI jako codzienna praktyka teamu.',
  },
];
---

<Layout
  title="Academy"
  description="Program wdrożenia AI dla zespołów GTM: 36 odcinków o tym, jak używać AI w marketingu, sprzedaży i pracy founderów B2B."
>
  <section class="relative pt-12 pb-8 md:pt-24 md:pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">
        <a href="/apps/" class="hover:text-[var(--color-accent-hi)]">Apps</a> · Academy
      </p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Naucz zespół AI od praktyka.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed">
        36 krótkich odcinków o tym, jak używać AI w marketingu, sprzedaży i pracy founderów B2B. Nie nazwy narzędzi. Procesy: research, scoring, outbound, content, dashboardy.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={academyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90"
        >
          Otwórz Academy
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href="/contact/#book-call"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]"
        >
          Porozmawiaj o wdrożeniu
        </a>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Program"
        heading="Cztery serie, jeden operacyjny system."
        lead="Każda seria układa konkretny kawałek pracy GTM. Razem składają się w jeden system, który zostaje w zespole."
      />
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        {series.map((s) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase mb-3">Seria {s.n} · {s.meta}</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">{s.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Wersja pełna</p>
        <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
          Pełna platforma żyje na academy.wojciech.io.
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          Tu jest brief. Tam odcinki, próbki audio, cohort, ranking modeli i program w całości.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={academyUrl} target="_blank" rel="noopener noreferrer" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          academy.wojciech.io
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
