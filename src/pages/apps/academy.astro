---
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/ui/CTABand.astro';

const proof = [
  { n: '20', unit: 'lat', label: 'marketingu i digitalu' },
  { n: '10', unit: 'lat', label: 'B2B SaaS growth' },
  { n: '10', unit: 'lat', label: 'GTM i revenue ops' },
  { n: '200+', unit: '', label: 'aplikacji i systemów' },
];

const workflow = [
  { tag: '01', title: 'Wybierasz model', body: 'Nie "najlepszy model na rynku", tylko właściwy model do zadania. Inaczej research, inaczej kod, inaczej outbound.' },
  { tag: '02', title: 'Układasz workflow', body: 'Prompt nie jest strategią. Łączysz źródła danych, model, decyzje człowieka i miejsce, gdzie wynik trafia dalej.' },
  { tag: '03', title: 'Wdrażasz w stacku', body: 'Claude, Clay, Pipedrive, n8n, Notion, D1. Pracujemy na narzędziach, które da się zostawić zespołowi.' },
  { tag: '04', title: 'Mierzysz efekt', body: 'Mniej zachwytu nad outputem, więcej pytań: czy szybciej mamy SQL, lepszy brief, krótszy research, mniej ręcznej roboty.' },
];

const series = [
  {
    n: '1', title: 'AI jako narzędzie operatora',
    meta: '12 odcinków',
    body: 'Od mental modelu po wybór modeli: kiedy Claude vs GPT vs lokalny, jak nie palić tokenów, gdzie kończy się demo, a zaczyna produkcja.',
    chips: ['Claude', 'GPT', 'Mental models', 'Cost ops'],
  },
  {
    n: '2', title: 'Outbound jak system, nie spam',
    meta: '12 odcinków',
    body: 'ICP do SQL quality. System, który znajduje właściwe firmy, wzbogaca dane, rozpoznaje sygnały zakupowe, kwalifikuje fit i pisze personalizacje bez SDR-a.',
    chips: ['Clay', 'Pipedrive', 'Signal stack', 'ICP'],
  },
  {
    n: '3', title: 'Content jako infrastruktura',
    meta: '12 odcinków',
    body: 'Treść nie jako kalendarz publikacji, ale jako asset dystrybucji i zaufania. Pipeline od research przez draft po publikację i loop SEO/social/email.',
    chips: ['LLM workflows', 'SEO', 'Distribution', 'Repurposing'],
  },
  {
    n: '4', title: 'Operating system dla GTM',
    meta: '12 odcinków',
    body: 'Spinanie wszystkiego w jeden operacyjny system: dashboardy z D1, scoring, automatyzacje, agenty MCP, ownership rytmów.',
    chips: ['MCP agents', 'Dashboards', 'Scoring', 'Team rhythm'],
  },
];

const pricing = [
  { plan: 'Dla Ciebie', price: 'Cennik na zapytanie', body: 'Dostęp do programu, Vault i certyfikat. Dla osoby, która chce poukładać własny warsztat.', status: 'soon' },
  { plan: 'Dla zespołu', price: 'Cennik na zapytanie', body: 'Ten sam język pracy dla marketingu, sprzedaży i founderów. Z wdrożeniem, nie samym dostępem.', status: 'soon' },
  { plan: 'Cohort live', price: '2 900 zł / os.', body: '6 tygodni live, case-work i praca na prawdziwych procesach uczestników.', status: 'waitlist' },
];
---

<Layout
  htmlLang="pl"
  ogLocale="pl_PL"
  title="Akademia AI"
  description="Program wdrożenia AI dla zespołów GTM: 36 odcinków o tym, jak używać AI w marketingu, sprzedaży i pracy founderów B2B."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <div class="pointer-events-none absolute left-1/2 top-[-200px] h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[var(--color-surface)] opacity-70 blur-[150px]" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="animate-fade-up flex items-center gap-3 mb-8">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">Program AI dla GTM</span>
      </div>

      <h1 class="animate-fade-up t-display [animation-delay:60ms] text-[var(--color-text)] max-w-[800px] mb-7">
        Naucz zespół AI od praktyka.<br>
        <span class="text-[var(--color-text-muted)]">Nie od slajdów.</span>
      </h1>

      <p class="t-lead animate-fade-up [animation-delay:120ms] max-w-[38rem] text-[var(--color-text-muted)] mb-10">
        36 krótkich odcinków o tym, jak używać AI w marketingu, sprzedaży i pracy founderów B2B. Nie uczysz się nazw narzędzi. Składasz procesy: research, scoring, outbound, content, dashboardy.
      </p>

      <div class="animate-fade-up [animation-delay:180ms] flex flex-wrap gap-3">
        <a href="#program" class="t-button btn-press inline-flex items-center h-12 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-8 text-[var(--color-accent-text)] no-underline">
          Zobacz program
        </a>
        <a href="mailto:hello@wojciech.io?subject=Academy" class="t-button inline-flex items-center h-12 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors">
          Porozmawiaj o wdrożeniu
        </a>
      </div>

      <!-- Proof strip -->
      <div class="animate-fade-up [animation-delay:240ms] mt-12 grid grid-cols-2 sm:grid-cols-4 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {proof.map(({ n, unit, label }) => (
          <div class="bg-[var(--color-surface)] px-5 py-4 text-center">
            <p class="text-2xl font-bold text-[var(--color-text)]">{n} {unit}</p>
            <p class="t-caption text-[var(--color-text-dim)] mt-0.5">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="t-label reveal-up text-[var(--color-text-dim)] mb-3">System pracy</p>
      <h2 class="reveal-up t-h2 text-[var(--color-text)] mb-4 max-w-2xl">
        Nie chodzi o to, żeby znać więcej narzędzi. Chodzi o to, żeby przestać robić AI na wyczucie.
      </h2>
      <p class="t-small reveal-up text-[var(--color-text-muted)] mb-10 max-w-2xl">
        Program prowadzi od wyboru modelu do procesów, które ktoś w firmie może powtarzać. Każdy blok kończy się artefaktem, nie inspiracją do zapisania w Notion.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {workflow.map(({ tag, title, body }) => (
          <article class="reveal-up bg-[var(--color-surface)] p-6">
            <span class="t-label text-[var(--color-accent)] mb-3 block">Krok {tag}</span>
            <h3 class="t-small font-semibold text-[var(--color-text)] mb-2">{title}</h3>
            <p class="t-small text-[var(--color-text-muted)]">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Program -->
  <section id="program" class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="t-label reveal-up text-[var(--color-text-dim)] mb-3">Program</p>
      <h2 class="reveal-up t-h2 text-[var(--color-text)] mb-4">4 serie. 36 odcinków. Zero waty.</h2>
      <p class="t-small reveal-up text-[var(--color-text-muted)] mb-10 max-w-2xl">
        Możesz przerobić jedną serię albo cały program. W każdym module jest audio, quiz i materiał do użycia od razu po odcinku.
      </p>

      <div class="grid md:grid-cols-2 gap-5">
        {series.map((s) => (
          <article class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-8">
            <div class="flex items-start gap-4 mb-4">
              <span class="t-small shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold">{s.n}</span>
              <div>
                <h3 class="t-body font-semibold text-[var(--color-text)]">{s.title}</h3>
                <p class="t-caption text-[var(--color-text-dim)] mt-0.5">Seria {s.n} / {s.meta}</p>
              </div>
            </div>
            <p class="t-small text-[var(--color-text-muted)] mb-4">{s.body}</p>
            <div class="flex flex-wrap gap-1.5">
              {s.chips.map(c => (
                <span class="t-caption rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-0.5 text-[var(--color-text-muted)]">{c}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing: soon state, no Stripe -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="t-label reveal-up text-[var(--color-text-dim)] mb-3">Dostęp</p>
      <h2 class="reveal-up t-h2 text-[var(--color-text)] mb-4">
        Najpierw sprawdzasz format. Potem wybierasz dostęp.
      </h2>
      <p class="t-small reveal-up text-[var(--color-text-muted)] mb-10 max-w-2xl">
        Dla jednej osoby i zespołu cennik dobieram do zakresu. Cohort live ma cenę otwartą, bo to konkretna grupa i konkretna praca na procesach uczestników.
      </p>

      <div class="grid sm:grid-cols-3 gap-5">
        {pricing.map((p) => (
          <div class:list={[
            'reveal-up rounded-[var(--radius-card)] border bg-[var(--color-surface)] p-6',
            p.status === 'waitlist' ? 'border-[var(--color-accent)]/30' : 'border-dashed border-[var(--color-border-2)]',
          ]}>
            <p class="t-label text-[var(--color-accent)] mb-3">{p.plan}</p>
            <h3 class="text-xl font-semibold text-[var(--color-text)] mb-2">{p.price}</h3>
            <p class="t-small text-[var(--color-text-muted)] mb-5">{p.body}</p>
            {p.status === 'waitlist' ? (
              <a href="mailto:hello@wojciech.io?subject=Academy Cohort" class="t-button btn-press inline-flex items-center h-10 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 text-[var(--color-accent-text)] no-underline">
                Zapisz się na listę
              </a>
            ) : (
              <span class="t-label inline-flex items-center gap-2 rounded-full border border-dashed border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-1.5 text-[var(--color-text-muted)]">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
                Niedługo
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Instructor -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-wrap items-center justify-between gap-6">
      <div class="reveal-up max-w-xl">
        <p class="t-label text-[var(--color-text-dim)] mb-3">Prowadzący</p>
        <h2 class="t-h3 text-[var(--color-text)] mb-2">Wojciech Łuszczyński</h2>
        <p class="t-small text-[var(--color-text-muted)]">
          20 lat w marketingu i digitalu, 10 w B2B SaaS growth. Buduje systemy revenue, łączy CRM, outbound, paid i AI workflows w jeden model operacyjny. Nie teoretyk, operator.
        </p>
      </div>
      <div class="reveal-up shrink-0">
        <img src="/images/wojciech-avatar-2026-384.webp" alt="Wojciech Łuszczyński" width="96" height="96" loading="lazy" class="w-24 h-24 rounded-full border border-[var(--color-border)] object-cover" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-[clamp(4rem,8vw,6rem)]">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="reveal-up t-h2 text-[var(--color-text)] mb-5">
        Jeśli po pierwszym odcinku nie czujesz konkretu, nie kupuj.
      </h2>
      <p class="t-body reveal-up text-[var(--color-text-muted)] mb-8 max-w-lg mx-auto">
        To ma być roboczy program dla ludzi, którzy muszą dowieźć marketing, sprzedaż albo content. Nie kolekcja ciekawostek o AI.
      </p>
      <div class="reveal-up">
        <a href="mailto:hello@wojciech.io?subject=Academy" class="t-button btn-press inline-flex items-center h-12 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-8 text-[var(--color-accent-text)] no-underline">
          Napisz o wdrożeniu
        </a>
      </div>
    </div>
  </section>

  <CTABand
    kicker="Następny krok"
    heading="Wolisz najpierw porozmawiać?"
    subtext="Napisz, co próbujesz dowieźć w marketingu albo sprzedaży i gdzie się zacina. Powiem, od czego bym zaczął."
    cta="Umów rozmowę"
    ctaHref="/pl/contact/"
    ctaSecondary="Zobacz stack"
    ctaSecondaryHref="/pl/stack/"
  />

</Layout>
