---
import Layout from '../../layouts/Layout.astro';
import PageBackdrop from '../../components/ui/PageBackdrop.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { SITE } from '../../data/site';

const notchUrl = SITE.notchUrl;

const useCases = [
  {
    n: '1',
    title: 'Live calls and demos',
    meta: 'Customer calls · investor pitches',
    body: 'Cue cards sit a centimetre below the camera. You stay on-script without dropping eye contact, no second monitor and no fake "I just remembered this" pause.',
  },
  {
    n: '2',
    title: 'Recorded videos',
    meta: 'YouTube · Loom · sales recordings',
    body: 'Read your script while looking at the lens. The camera sees focus, not the typical scrolling teleprompter dance from one side of the screen to the other.',
  },
  {
    n: '3',
    title: 'Presentations',
    meta: 'Webinars · workshops · panels',
    body: 'Speaker notes follow your beat without window-switching. Slides stay full-screen, prompts stay where your eyes already are.',
  },
  {
    n: '4',
    title: 'Repeatable scripts',
    meta: 'Onboarding · discovery · QBR',
    body: 'Save scripts for the calls you run every week. Open the right one, run it, ship the call. Less remembering, more delivery.',
  },
];
---

<Layout
  title="Notch — macOS teleprompter that lives in the camera notch"
  description="Native macOS teleprompter that puts your prompts around the MacBook camera notch. Stay on-script without losing eye contact during calls, demos, and recordings."
>
  <section class="relative pt-12 pb-8 md:pt-24 md:pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">
        <a href="/apps/" class="hover:text-[var(--color-accent-hi)]">Apps</a> · Notch
      </p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Read the line. Look at the lens.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed">
        Native macOS teleprompter that lives in the MacBook camera notch. Your prompts sit where the camera already looks — so you stay on-script without breaking eye contact.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={notchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90"
        >
          Get Notch for macOS
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href="/contact/#book-call"
          class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]"
        >
          Talk about a custom build
        </a>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Where it earns its place"
        heading="Four moments where the notch beats a second screen."
        lead="Same script. Same delivery. The difference is where your eyes are pointing while you read it."
      />
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        {useCases.map((u) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase mb-3">{u.n} · {u.meta}</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">{u.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{u.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Download</p>
        <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
          The native app lives at notch.wojciech.io.
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          Apple silicon, dark and light, signed and notarized. The product page handles the download.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={notchUrl} target="_blank" rel="noopener noreferrer" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          notch.wojciech.io
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
