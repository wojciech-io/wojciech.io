---
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/ui/CTABand.astro';

const features = [
  {
    icon: '⌘',
    title: 'Start when you need it',
    title_pl: 'Wlacz kiedy potrzebujesz',
    title_it: 'Avvialo quando ne hai bisogno',
    body: 'The prompter stays hidden until you need it. Show it with a keyboard shortcut right before your call, demo, or recording.',
    body_pl: 'Prompter pozostaje ukryty, dopoki go nie potrzebujesz. Wywolaj go skrotem klawiszowym tuz przed rozmowa, demo lub nagraniem.',
    body_it: 'Il prompter rimane nascosto finche non ne hai bisogno. Mostralo con una scorciatoia da tastiera subito prima della chiamata, demo o registrazione.',
  },
  {
    icon: '◉',
    title: 'Close to the camera',
    title_pl: 'Blisko kamery',
    title_it: 'Vicino alla fotocamera',
    body: 'Text appears in the notch area, where your eyes already point. Less visible drift, more natural delivery.',
    body_pl: 'Tekst pojawia sie w obszarze notcha: tam, gdzie i tak kierujesz wzrok. Mniej widoczne odchylenia, bardziej naturalne wypowiedzi.',
    body_it: "Il testo appare nell'area del notch, dove i tuoi occhi gia guardano. Meno deriva visibile, consegna piu naturale.",
  },
  {
    icon: '≋',
    title: 'Calm pacing',
    title_pl: 'Spokojne tempo',
    title_it: 'Ritmo tranquillo',
    body: 'Set scroll speed to match your voice. Short lines let you grab the next thought at a glance without losing your place.',
    body_pl: 'Ustaw predkosc przewijania dopasowana do swojego glosu. Krotkie linijki pozwalaja uchwycic kolejna mysl jednym spojrzeniem bez gubienia miejsca.',
    body_it: 'Imposta la velocita di scorrimento in base alla tua voce. Le righe brevi ti permettono di cogliere il pensiero successivo con uno sguardo senza perdere il filo.',
  },
  {
    icon: '◌',
    title: 'Voice-aware scrolling',
    title_pl: 'Przewijanie reagujace na glos',
    title_it: 'Scorrimento sensibile alla voce',
    body: "Optionally, the text moves while you speak and pauses when you stop. Useful when the conversation doesn't follow the script.",
    body_pl: 'Opcjonalnie tekst przesuwa sie, gdy mowisz, i zatrzymuje, gdy milczysz. Przydatne, gdy rozmowa odbiega od scenariusza.',
    body_it: 'Facoltativamente, il testo si muove mentre parli e si ferma quando smetti. Utile quando la conversazione non segue lo script.',
  },
  {
    icon: '▣',
    title: 'Local notes',
    title_pl: 'Lokalne notatki',
    title_it: 'Note locali',
    body: 'Scripts, answers, and talking points stay on your Mac. No account required, no uploads before every call.',
    body_pl: 'Scenariusze, odpowiedzi i punkty do omowienia pozostaja na Twoim Macu. Bez konta, bez przesylania przed kazda rozmowa.',
    body_it: 'Script, risposte e punti chiave rimangono sul tuo Mac. Nessun account richiesto, nessun caricamento prima di ogni chiamata.',
  },
  {
    icon: '☉',
    title: 'Adjustable layout',
    title_pl: 'Regulowany uklad',
    title_it: 'Layout regolabile',
    body: 'Change text size, panel width, and position to fit your screen, your eyesight, and your speaking style.',
    body_pl: 'Zmien rozmiar tekstu, szerokosc panelu i jego pozycje, aby dopasowac do ekranu, wzroku i stylu mowienia.',
    body_it: 'Cambia dimensione del testo, larghezza del pannello e posizione per adattarli al tuo schermo, alla tua vista e al tuo stile di parlare.',
  },
];

const steps = [
  {
    img: '/apps/notch/assets/notchcue-call-20260510.png',
    n: '1',
    title: 'Write your talking points',
    title_pl: 'Wpisz swoje punkty do omowienia',
    title_it: 'Scrivi i tuoi punti chiave',
    body: 'Paste short bullets, an intro, questions, or offer fragments. Spoken-language text works best. Skip long paragraphs.',
    body_pl: 'Wklej krotkie punkty, wstep, pytania lub fragmenty oferty. Tekst pisany jezykiem mowionym dziala najlepiej. Unikaj dlugich akapitow.',
    body_it: "Incolla brevi bullet, un'introduzione, domande o frammenti di offerta. Il testo in linguaggio parlato funziona meglio. Evita paragrafi lunghi.",
  },
  {
    img: '/apps/notch/assets/notchcue-hero-20260510.png',
    n: '2',
    title: 'Position it near the camera',
    title_pl: 'Umiesc go blisko kamery',
    title_it: 'Posizionalo vicino alla fotocamera',
    body: "The prompter sits in the notch, so you don't have to look to the corner of the screen. Adjust size, position and speed to your MacBook.",
    body_pl: 'Prompter siedzi w notchu, wiec nie musisz patrzec w rog ekranu. Dostosuj rozmiar, pozycje i predkosc do swojego MacBooka.',
    body_it: "Il prompter si trova nel notch, quindi non devi guardare l'angolo dello schermo. Regola dimensione, posizione e velocita al tuo MacBook.",
  },
  {
    img: '/apps/notch/assets/notchcue-desk-20260510.png',
    n: '3',
    title: 'Run your meeting',
    title_pl: 'Poprowadz swoje spotkanie',
    title_it: 'Conduci la tua riunione',
    body: 'You have structure close by but still sound like a person. Easy to recover after a question, a pause, or a topic change.',
    body_pl: 'Masz strukture pod reka, ale nadal brzmisz naturalnie. Latwo wroc do tematu po pytaniu, przerwie lub zmianie watku.',
    body_it: 'Hai la struttura vicina ma suoni ancora come una persona. Facile recuperare dopo una domanda, una pausa o un cambio di argomento.',
  },
];
---

<Layout
  title="NotchCue"
  description="A macOS teleprompter that sits in the MacBook notch. Talking points stay close to the camera so your delivery stays natural."
  ogImage="/apps/notch/assets/notchcue-hero-20260510.png"
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <div class="pointer-events-none absolute left-1/2 top-[-200px] h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[var(--color-surface)] opacity-70 blur-[150px]" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32 text-center">
      <div class="animate-fade-up flex items-center gap-3 mb-8">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">macOS app</span>
      </div>

      <h1 class="animate-fade-up [animation-delay:60ms] text-[clamp(3rem,8vw,6rem)] font-semibold leading-[0.92] tracking-tight text-[var(--color-text)] max-w-[800px] mx-auto mb-7">
        Notes that stay<br>
        <span class="text-[var(--color-text-muted)]">close to the lens.</span>
      </h1>

      <p class="animate-fade-up [animation-delay:120ms] max-w-[34rem] mx-auto text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-10">
        NotchCue puts your talking points around the MacBook camera notch. Your delivery stays natural. Eye contact stays intact.
      </p>

      <div class="animate-fade-up [animation-delay:180ms] flex flex-wrap items-center justify-center gap-3">
        <a href="/apps/notch/downloads/NotchCue.dmg" class="btn-press inline-flex flex-col items-center h-auto rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-2.5 no-underline">
          <span class="text-sm font-semibold text-[var(--color-accent-text)] leading-tight">Download NotchCue</span>
          <span class="text-[10px] font-medium text-[var(--color-accent-text)] opacity-70 leading-tight">DMG for macOS</span>
        </a>
        <a href="#how" class="inline-flex items-center h-11 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors">
          See how it works
        </a>
      </div>

      <p class="animate-fade-up [animation-delay:240ms] mt-4 text-xs text-[var(--color-text-dim)]">
        Runs locally on your Mac. No account, no uploads, no browser required.
      </p>
    </div>

    <div class="animate-fade-up [animation-delay:300ms] mx-auto max-w-4xl px-6 pb-16">
      <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
        <img src="/apps/notch/assets/notchcue-hero-20260510.png" alt="NotchCue teleprompter in the MacBook notch area during a video call" class="w-full h-auto block" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="border-b border-[var(--color-border)] py-6">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-[var(--color-border)]">
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">Less eye drift</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">prompts are close to the camera, not at the bottom of the screen</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">Calm delivery</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">know what comes next without searching through notes</span>
        </div>
        <div class="reveal-up px-6 py-4 flex flex-col gap-0.5">
          <strong class="text-sm font-semibold text-[var(--color-text)]">Fully local</strong>
          <span class="text-xs text-[var(--color-text-muted)] leading-relaxed">notes stay on your Mac, no account required</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">The problem</p>
        <h2 class="text-fluid-xl font-semibold text-[var(--color-text)] leading-snug mb-4">Notes break eye contact.</h2>
        <p class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
          Whether it's a second monitor, a printed script, or a floating notes app, the moment your eyes drift from the camera, the audience feels it. Presence drops. Delivery sounds rehearsed.
        </p>
      </div>
      <div class="reveal-up bg-[var(--color-surface)] p-8 md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">The fix</p>
        <h2 class="text-fluid-xl font-semibold text-[var(--color-text)] leading-snug mb-4">Prompts live next to the lens.</h2>
        <p class="text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
          NotchCue places a minimal scrolling overlay directly above the camera, in the MacBook notch area. You read toward the lens, not away from it. Structure stays, eye contact stays.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">How it works</p>
      <h2 class="reveal-up text-fluid-2xl font-semibold text-[var(--color-text)] leading-snug mb-12 max-w-lg">
        Prepare once, then run your meeting calmly.
      </h2>
      <div class="grid md:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {steps.map((s) => (
          <article class="reveal-up bg-[var(--color-surface)] flex flex-col">
            <div class="overflow-hidden border-b border-[var(--color-border)]">
              <img src={s.img} alt={s.title} class="w-full h-48 object-cover object-top" loading="lazy" />
            </div>
            <div class="p-6 flex-1 flex flex-col gap-2">
              <div class="mb-2 h-px w-8 bg-[var(--color-accent-cta)]"></div>
              <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Step {s.n}</span>
              <h3 class="text-sm font-semibold text-[var(--color-text)]">{s.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo video -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="reveal-up text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-3">On calls</p>
          <h2 class="reveal-up text-fluid-2xl font-semibold text-[var(--color-text)] leading-snug mb-4">
            Looks like part of the screen, not a second notes window.
          </h2>
          <p class="reveal-up text-sm md:text-base leading-relaxed text-[var(--color-text-muted)]">
            NotchCue is designed for real calls: discreet, fast to launch, readable enough to catch the next thought without scanning a full document.
          </p>
        </div>
        <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] overflow-hidden shadow-[var(--shadow-card)]">
          <video autoplay muted loop playsinline preload="metadata" poster="/apps/notch/assets/notchcue-hero-20260510.png" class="w-full h-auto block">
            <source src="/apps/notch/assets/notchcue-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6">
      <p class="reveal-up text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)] mb-8">What it does</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border)] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
        {features.map((f) => (
          <article class="reveal-up bg-[var(--color-surface)] p-6">
            <div class="mb-4 h-px w-8 bg-[var(--color-accent-cta)]"></div>
            <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2">{f.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Built by -->
  <section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-wrap items-center justify-between gap-6">
      <div class="reveal-up">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)] mb-2">Built by</p>
        <a href="/" class="group flex items-center gap-2 no-underline">
          <span class="text-base font-semibold text-[var(--color-text)] group-hover:text-[var(--color-text-muted)] transition-colors">Wojciech Luszczynski</span>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="opacity-40"><path d="M6 3h7m0 0v7m0-7L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="reveal-up flex flex-wrap gap-2">
        {['Swift', 'Codex', 'AI-built', 'macOS native'].map((tag) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium text-[var(--color-text-muted)]">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-[clamp(4rem,8vw,6rem)]">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <img src="/apps/notch/assets/notchcue-icon.png" alt="NotchCue" class="reveal-up w-16 h-16 mx-auto mb-6 rounded-2xl" />
      <h2 class="reveal-up text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[0.95] tracking-tight text-[var(--color-text)] mb-5">
        Try it on your<br><span class="text-[var(--color-text-muted)]">next call.</span>
      </h2>
      <p class="reveal-up text-base leading-relaxed text-[var(--color-text-muted)] mb-8 max-w-sm mx-auto">
        Start with a short note: intro, three bullets, one close. After a few minutes you'll see if it helps you hold the camera and finish thoughts cleanly.
      </p>
      <div class="reveal-up flex flex-wrap items-center justify-center gap-3">
        <a href="/apps/notch/downloads/NotchCue.dmg" class="btn-press inline-flex flex-col items-center rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-8 py-3 no-underline">
          <span class="text-sm font-semibold text-[var(--color-accent-text)] leading-tight">Download NotchCue</span>
          <span class="text-[10px] font-medium text-[var(--color-accent-text)] opacity-70 leading-tight">NotchCue.dmg / macOS 14+</span>
        </a>
        <a href="mailto:hello@wojciech.io?subject=NotchCue early access" class="inline-flex items-center h-11 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-6 text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] hover:border-[var(--color-border)] transition-colors">
          Send feedback
        </a>
      </div>
    </div>
  </section>

  <CTABand
    heading="Building tools for your own desk too?"
    subtext="NotchCue started as a personal itch. If you are wiring AI into how you actually work, I am happy to compare notes."
    cta="Book a call"
    ctaHref="/contact/"
    ctaSecondary="See the work"
    ctaSecondaryHref="/work/"
  />

</Layout>
