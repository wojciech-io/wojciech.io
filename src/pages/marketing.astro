---
import LensShowcase from '../components/pages/LensShowcase.astro';
import WebsitePortfolio from '../components/pages/WebsitePortfolio.astro';
import { localizedPageAlternates } from '../data/localizedPages';

const build = [
  { title: 'Positioning that bites', body: 'One sentence a buyer repeats back to you. The rest of the site ladders to it.' },
  { title: 'Demand, not impressions', body: 'Content and channels engineered to produce pipeline you can actually trace.' },
  { title: 'Brand that compounds', body: 'A point of view shipped consistently, so the market remembers you between buying cycles.' },
];

const portfolio = [
  {
    name: 'CIRYAM',
    url: 'https://ciryam.eu',
    displayUrl: 'ciryam.eu',
    industry: 'Music',
    blurb: 'Official site for a Polish rock band: tour dates, releases, press kit, and a built-in player. Booking enquiries land in one place instead of scattered across inboxes.',
    image: '/images/portfolio/ciryam.webp',
    alt: 'Homepage of ciryam.eu, a Polish rock band site, dark hero with the band photo',
  },
  {
    name: 'AN Projekt',
    url: 'https://anprojekt.com.pl',
    displayUrl: 'anprojekt.com.pl',
    industry: 'Interior design',
    blurb: 'Studio site for an interior designer: a portfolio of finished interiors, clear service tiers, and a calm path from first look to first consultation.',
    image: '/images/portfolio/anprojekt.webp',
    alt: 'Homepage of anprojekt.com.pl, an interior design studio, bright living-room render',
  },
  {
    name: 'Piotr Sobczyk',
    url: 'https://sobczyk.io',
    displayUrl: 'sobczyk.io',
    industry: 'B2B services',
    blurb: 'Personal site for a fractional Head of Digital. The offer, the process, and the pricing made obvious up front, so the first call starts halfway to a yes.',
    image: '/images/portfolio/sobczyk.webp',
    alt: 'Homepage of sobczyk.io, a fractional Head of Digital Marketing, dark hero with yellow accents',
  },
];
---

<LensShowcase
  title="Marketing"
  description="B2B marketing built to produce pipeline: positioning, demand, and brand you can trace to revenue."
  eyebrow="Marketing"
  h1Primary="Demand,"
  h1Secondary="not impressions."
  lead="Positioning, content, and brand engineered to produce pipeline you can trace. Built to run, not to sit in a deck."
  metaLine="positioning · demand · content · brand"
  heroImage="/images/lens/marketing-hero.webp"
  ogImage="/og/pages/marketing.png"
  alternates={localizedPageAlternates('marketing')}
  build={build}
  pov="Marketing that cannot be traced to pipeline is decoration. I build the traceable kind."
  ctaHeading="Marketing busy but pipeline flat?"
  ctaSubtext="Send what you are running now. I will tell you what is decoration and what would actually move pipeline."
>
  <WebsitePortfolio
    eyebrow="Sites I've shipped"
    heading="Built and shipped, across industries."
    lead="Marketing needs a site that loads fast and makes the offer obvious. Three I designed and built, in three very different industries."
    items={portfolio}
    visitLabel="Visit site"
  />
</LensShowcase>
