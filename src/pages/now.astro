---
import Layout from '../layouts/Layout.astro';
import NowContent from '../components/pages/NowContent.astro';
import { SITE } from '../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Now', item: SITE.url + '/now/' },
  ],
};
const nowPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Now · What I\'m Working On',
  url: SITE.url + '/now/',
  description: 'What Wojciech Łuszczyński is focused on right now: systems being built, clients being served, reading, and thinking.',
  dateModified: '2026-05-26',
  author: {
    '@type': 'Person',
    name: 'Wojciech Łuszczyński',
    url: SITE.url + '/',
  },
  about: { '@type': 'Person', name: 'Wojciech Łuszczyński' },
};
---

<Layout
  title="Now · wojciech.io"
  description="What Wojciech Łuszczyński is focused on right now: systems being built, clients being served, reading, and thinking."
  ogImage="/og/pages/now.png"
  schema={[breadcrumbSchema, nowPageSchema]}
>
  <NowContent />
</Layout>
