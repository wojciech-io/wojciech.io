---
import Layout from '../layouts/Layout.astro';
import NowContent from '../components/pages/NowContent.astro';
import { SITE } from '../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Now', item: SITE.url + '/now/' },
  ],
};
---

<Layout
  title="Now · What I'm Working On"
  description="What Wojciech Łuszczyński is focused on right now: systems being built, clients being served, reading, and thinking."
  ogImage="/og/pages/now.png"
  schema={breadcrumbSchema}
>
  <NowContent />
</Layout>
