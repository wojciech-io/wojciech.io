---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import { SITE } from '../data/site';

const lastUpdated = '2026-05-17';
---

<Layout
  title="Now"
  description="What Wojciech Łuszczyński is focused on right now — building, reading, thinking."
>

  <!-- Header -->
  <section class="pt-20 pb-12 border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-6">
      <p data-en="Now" data-pl="Teraz" data-it="Ora" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Now</p>
      <h1 data-en="What I'm doing right now." data-pl="Co robię w tej chwili." data-it="Cosa sto facendo adesso." class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5">
        What I'm doing right now.
      </h1>
      <p data-en="A snapshot of what I'm building, exploring, and thinking about. Updated when something changes." data-pl="Migawka tego, co buduję, eksploruję i o czym myślę. Aktualizowana gdy coś się zmienia." data-it="Una fotografia di cio che sto costruendo, esplorando e pensando. Aggiornata quando qualcosa cambia." class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-xl">
        A snapshot of what I'm building, exploring, and thinking about. Updated when something changes.
      </p>
      <p class="mt-4 text-xs text-[var(--color-text-dim)]"><span data-en="Last updated:" data-pl="Ostatnia aktualizacja:" data-it="Ultimo aggiornamento:">Last updated:</span> {lastUpdated}</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-6 space-y-14">

      <!-- Building -->
      <div>
        <p data-en="Building" data-pl="Buduję" data-it="Sto costruendo" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-5">Building</p>
        <div class="space-y-6">
          <div class="border-l-2 border-[var(--color-accent)]/30 pl-5">
            <h2 data-en="wojciech.io as a working operating system" data-pl="wojciech.io jako roboczy system operacyjny" data-it="wojciech.io come sistema operativo funzionante" class="text-base font-semibold text-[var(--color-text)] mb-1">wojciech.io as a working operating system</h2>
            <p data-en="Turning the portfolio into a live proof-of-work: case studies for shipped apps, AI GTM tools that are documented in public, and insights that show how the systems actually work, not just that they exist." data-pl="Zmieniam portfolio w żywy dowód pracy: studia przypadków dla wdrożonych aplikacji, narzędzia AI GTM udokumentowane publicznie i artykuły pokazujące, jak systemy naprawdę działają, nie tylko że istnieją." data-it="Trasformo il portfolio in una prova di lavoro live: casi studio per app realizzate, strumenti AI GTM documentati pubblicamente e articoli che mostrano come i sistemi funzionano davvero, non solo che esistono." class="text-sm text-[var(--color-text-muted)] leading-relaxed">
              Turning the portfolio into a live proof-of-work: case studies for shipped apps, AI GTM tools that are documented in public, and insights that show how the systems actually work, not just that they exist.
            </p>
          </div>
          <div class="border-l-2 border-[var(--color-border-2)] pl-5">
            <h2 class="text-base font-semibold text-[var(--color-text)] mb-1">GTM Agent Starter Pack</h2>
            <p data-en="Iterating on the Claude Code agent system for B2B outbound. Refining ICP scoring, extending the skills layer, and documenting the architecture for operators who want the system without the SaaS wrapper." data-pl="Iteracja na systemie agentów Claude Code dla outbound B2B. Udoskonalanie scoringu ICP, rozszerzanie warstwy umiejętności i dokumentowanie architektury dla operatorów, którzy chcą systemu bez wrapera SaaS." data-it="Iterazione sul sistema di agenti Claude Code per outbound B2B. Raffinamento dello scoring ICP, estensione del layer di competenze e documentazione dell'architettura per gli operatori che vogliono il sistema senza il wrapper SaaS." class="text-sm text-[var(--color-text-muted)] leading-relaxed">
              Iterating on the Claude Code agent system for B2B outbound. Refining ICP scoring, extending the skills layer, and documenting the architecture for operators who want the system without the SaaS wrapper.
            </p>
          </div>
          <div class="border-l-2 border-[var(--color-border-2)] pl-5">
            <h2 data-en="Case studies for Relora, Ads Assistant, Akademia AI" data-pl="Studia przypadków dla Relora, Ads Assistant, Akademia AI" data-it="Casi studio per Relora, Ads Assistant, Akademia AI" class="text-base font-semibold text-[var(--color-text)] mb-1">Case studies for Relora, Ads Assistant, Akademia AI</h2>
            <p data-en="Writing the full build-and-deploy stories for each product — the problem, the system design, the stack decisions, and what it proved." data-pl="Piszę pełne historii budowania i wdrażania dla każdego produktu: problem, projekt systemu, decyzje dotyczące stosu i co udowodniły." data-it="Scrivo le storie complete di costruzione e deployment per ogni prodotto: il problema, il design del sistema, le scelte dello stack e cosa hanno dimostrato." class="text-sm text-[var(--color-text-muted)] leading-relaxed">
              Writing the full build-and-deploy stories for each product — the problem, the system design, the stack decisions, and what it proved.
            </p>
          </div>
        </div>
      </div>

      <!-- Thinking about -->
      <div>
        <p data-en="Thinking about" data-pl="Myślę o" data-it="Sto pensando a" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-5">Thinking about</p>
        <div class="space-y-5 text-sm text-[var(--color-text-muted)] leading-relaxed">
          <p>
            <span data-en="AI won't fix weak GTM." data-pl="AI nie naprawia słabego GTM." data-it="L'AI non aggiusta un GTM debole." class="font-semibold text-[var(--color-text)]">AI won't fix weak GTM.</span><span data-en=" It will only make the chaos faster. Most B2B companies adding AI to their marketing don't have a capability problem — they have a clarity problem. Unclear ICP, weak positioning, undefined conversion logic. AI amplifies whatever's there, good or bad." data-pl=" Tylko przyspieszy chaos. Większość firm B2B dodających AI do marketingu nie ma problemu z możliwościami — ma problem z klarownością. Niejasny ICP, słabe pozycjonowanie, niezdefiniowana logika konwersji. AI wzmacnia to, co jest, dobre lub złe." data-it=" Rendera solo il caos piu veloce. La maggior parte delle aziende B2B che aggiungono AI al loro marketing non hanno un problema di capacita - hanno un problema di chiarezza. ICP poco chiaro, posizionamento debole, logica di conversione indefinita. L'AI amplifica cio che c'e, buono o cattivo."> It will only make the chaos faster. Most B2B companies adding AI to their marketing don't have a capability problem — they have a clarity problem. Unclear ICP, weak positioning, undefined conversion logic. AI amplifies whatever's there, good or bad.</span>
          </p>
          <p>
            <span data-en="Content is not a publishing calendar." data-pl="Treści to nie kalendarz publikacji." data-it="I contenuti non sono un calendario editoriale." class="font-semibold text-[var(--color-text)]">Content is not a publishing calendar.</span><span data-en=" It's a compounding distribution and trust asset. The companies winning with content right now are the ones who treat it as infrastructure, not as a social media obligation." data-pl=" To nawarstwiający się zasób dystrybucji i zaufania. Firmy wygrywające teraz z treściami traktują je jak infrastrukturę, nie jak obowiązek mediów społecznościowych." data-it=" Sono un asset di distribuzione e fiducia cumulativo. Le aziende che vincono con i contenuti ora sono quelle che li trattano come infrastruttura, non come un obbligo sui social media."> It's a compounding distribution and trust asset. The companies winning with content right now are the ones who treat it as infrastructure, not as a social media obligation.</span>
          </p>
          <p>
            <span data-en="The best GTM work is boring to describe and obvious in results." data-pl="Najlepsza praca GTM jest nudna w opisie i oczywista w wynikach." data-it="Il miglior lavoro GTM e noioso da descrivere e ovvio nei risultati." class="font-semibold text-[var(--color-text)]">The best GTM work is boring to describe and obvious in results.</span><span data-en=" Nobody wants to hear about the CRM operating model you built. But it's the thing that's actually compounding." data-pl=" Nikt nie chce słuchać o modelu operacyjnym CRM, który zbudowałeś. Ale to jest rzecz, która naprawdę się nawarstwia." data-it=" Nessuno vuole sentire del modello operativo CRM che hai costruito. Ma e la cosa che si sta davvero accumulando."> Nobody wants to hear about the CRM operating model you built. But it's the thing that's actually compounding.</span>
          </p>
        </div>
      </div>

      <!-- Exploring -->
      <div>
        <p data-en="Exploring" data-pl="Eksploruję" data-it="Sto esplorando" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-5">Exploring</p>
        <div class="space-y-4">
          {[
            { label: 'MCP tooling for GTM workflows', labelPl: 'Narzędzia MCP dla workflow GTM', labelIt: 'Strumenti MCP per workflow GTM', note: 'Extending Claude Code agents with custom MCP servers for CRM, research, and content operations.', notePl: 'Rozszerzam agenty Claude Code o własne serwery MCP do CRM, badania i operacji treściowych.', noteIt: 'Estendo gli agenti Claude Code con server MCP personalizzati per CRM, ricerca e operazioni di contenuto.' },
            { label: 'Audio-first learning formats', labelPl: 'Formaty uczenia audio-first', labelIt: 'Formati di apprendimento audio-first', note: 'Testing completion and retention patterns on Akademia AI: what structure works when you remove the visual layer.', notePl: 'Testowanie wzorców ukończenia i retencji na Akademii AI: jaka struktura działa, gdy usuniesz warstwę wizualną.', noteIt: "Test sui pattern di completamento e retention su Akademia AI: quale struttura funziona quando rimuovi il layer visuale." },
            { label: 'Personal brand as a distribution system', labelPl: 'Marka osobista jako system dystrybucji', labelIt: 'Personal brand come sistema di distribuzione', note: 'Building in public as a compounding acquisition channel, not for vanity metrics, but as a testbed for GTM hypotheses.', notePl: 'Budowanie w publicznym jako nawarstwiający się kanał pozyskiwania, nie dla próżnych metryk, ale jako poligon hipotez GTM.', noteIt: 'Costruire in pubblico come canale di acquisizione cumulativo, non per vanity metrics, ma come banco di prova per ipotesi GTM.' },
          ].map(({ label, labelPl, labelIt, note, notePl, noteIt }) => (
            <div class="flex gap-4">
              <span class="mt-1 shrink-0 w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
              <div>
                <p data-en={label} data-pl={labelPl} data-it={labelIt} class="text-sm font-medium text-[var(--color-text)]">{label}</p>
                <p data-en={note} data-pl={notePl} data-it={noteIt} class="text-sm text-[var(--color-text-muted)] leading-relaxed">{note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Not doing -->
      <div>
        <p data-en="Not doing right now" data-pl="Czego teraz nie robię" data-it="Non sto facendo" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-5">Not doing right now</p>
        <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
          <li class="flex gap-3"><span class="text-[var(--color-text-dim)] shrink-0">-</span> <span data-en="Pure branding or PR mandates without commercial architecture" data-pl="Czyste mandaty brandingowe lub PR bez architektury komercyjnej" data-it="Mandati puri di branding o PR senza architettura commerciale">Pure branding or PR mandates without commercial architecture</span></li>
          <li class="flex gap-3"><span class="text-[var(--color-text-dim)] shrink-0">-</span> <span data-en="Pre-product companies without a defined ICP" data-pl="Firmy przed produktem bez zdefiniowanego ICP" data-it="Aziende pre-prodotto senza un ICP definito">Pre-product companies without a defined ICP</span></li>
          <li class="flex gap-3"><span class="text-[var(--color-text-dim)] shrink-0">-</span> <span data-en="Strategy-only engagements that don't ship anything" data-pl="Projekty tylko strategiczne, które nic nie wdrażają" data-it="Progetti solo strategici che non realizzano nulla">Strategy-only engagements that don't ship anything</span></li>
        </ul>
      </div>

      <!-- Follow -->
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p data-en="Follow what I'm shipping" data-pl="Sledz co wdrazam" data-it="Segui cosa sto realizzando" class="text-sm font-semibold text-[var(--color-text)] mb-1">Follow what I'm shipping</p>
          <p data-en="New articles and systems — when they're ready, not on a schedule." data-pl="Nowe artykuły i systemy — gdy są gotowe, nie według harmonogramu." data-it="Nuovi articoli e sistemi - quando sono pronti, non secondo un programma." class="text-sm text-[var(--color-text-muted)]">New articles and systems — when they're ready, not on a schedule.</p>
        </div>
        <a
          href="/subscribe"
          data-en="Subscribe"
          data-pl="Subskrybuj"
          data-it="Iscriviti"
          class="shrink-0 inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm"
        >
          Subscribe
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- Inspired by nownownow.com -->
  <section class="py-8 border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-xs text-[var(--color-text-dim)]">
        This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-text)] transition-colors">/now page</a> — a snapshot of what I'm doing at this point in time.
      </p>
    </div>
  </section>

  <CTABand />

</Layout>
