---
import Layout from '../../layouts/Layout.astro';

// Manage-a-booking page reached from the confirmation email link
// (/meet/cancel?id=..&token=..). It previews the booking (GET /api/cancel),
// then cancels on an explicit button click (POST /api/cancel). English only:
// it is a transactional page behind a signed link, not indexed content.
---

<Layout
  title="Manage your booking"
  description="Cancel a booking with Wojciech Łuszczyński."
  noindex
>
  <section class="relative pt-16 pb-24 md:pt-20 md:pb-28">
    <div class="mx-auto max-w-md px-6">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">Manage your booking</span>
      </div>

      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-7">
        <!-- Loading -->
        <p id="cx-loading" class="text-sm text-[var(--color-text-muted)]">Loading your booking…</p>

        <!-- Not found / bad link -->
        <div id="cx-error" hidden>
          <p class="text-base font-semibold text-[var(--color-text)] mb-1">Booking not found.</p>
          <p class="text-sm text-[var(--color-text-muted)]">This link is invalid, or the booking was already cancelled.</p>
          <a href="/meet/" class="mt-5 inline-flex text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors">Book a new call →</a>
        </div>

        <!-- Confirm cancel -->
        <div id="cx-confirm" hidden>
          <p class="obs-label-accent mb-3 block">Your booking</p>
          <p id="cx-detail" class="text-lg font-semibold text-[var(--color-text)] leading-snug mb-1"></p>
          <p id="cx-when" class="text-sm text-[var(--color-text-muted)] mb-6"></p>
          <p id="cx-cancel-error" role="alert" hidden class="text-sm text-red-600 dark:text-red-400 mb-4"></p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button id="cx-cancel-btn" type="button"
              class="inline-flex items-center justify-center rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-5 py-3 text-sm font-semibold text-[var(--color-text)] transition-colors hover:border-red-500/60 hover:text-red-600 dark:hover:text-red-400 disabled:opacity-40">
              Cancel this booking
            </button>
            <a href="/meet/" class="inline-flex items-center justify-center px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
              Keep it
            </a>
          </div>
        </div>

        <!-- Cancelled -->
        <div id="cx-done" hidden class="text-center py-4">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-border-2)] bg-[var(--color-surface-2)]">
            <svg class="w-6 h-6 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <p class="text-lg font-semibold text-[var(--color-text)] mb-1">Booking cancelled.</p>
          <p class="text-sm text-[var(--color-text-muted)] mb-5">The time is freed up. Attendees have been notified.</p>
          <a href="/meet/" class="inline-flex text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors">Book a new time →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const params = new URLSearchParams(location.search);
    const id = params.get('id') || '';
    const token = params.get('token') || '';
    const locale = document.documentElement.lang || 'en';
    const fmt = new Intl.DateTimeFormat(locale, {
      weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',
    });

    const show = (el) => { $(el).hidden = false; };
    const hide = (el) => { $(el).hidden = true; };

    function fail() { hide('cx-loading'); show('cx-error'); }

    if (!id || !token) { fail(); return; }

    fetch('/api/cancel?id=' + encodeURIComponent(id) + '&token=' + encodeURIComponent(token), {
      headers: { accept: 'application/json' },
    })
      .then((r) => r.json())
      .then((data) => {
        if (!data.ok || !data.booking) return fail();
        hide('cx-loading');
        if (data.booking.status === 'cancelled') { show('cx-done'); return; }
        $('cx-detail').textContent = data.booking.name + ' · ' + data.booking.minutes + ' min';
        $('cx-when').textContent = fmt.format(new Date(data.booking.start));
        show('cx-confirm');
      })
      .catch(fail);

    $('cx-cancel-btn').addEventListener('click', async () => {
      const btn = $('cx-cancel-btn');
      const err = $('cx-cancel-error');
      err.hidden = true;
      btn.disabled = true; btn.textContent = 'Cancelling…';
      try {
        const res = await fetch('/api/cancel', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, token }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Could not cancel. Please try again.');
        hide('cx-confirm'); show('cx-done');
      } catch (ex) {
        err.textContent = ex.message; err.hidden = false;
        btn.disabled = false; btn.textContent = 'Cancel this booking';
      }
    });
  })();
</script>
