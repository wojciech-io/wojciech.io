---
import LensShowcase from '../components/pages/LensShowcase.astro';
import LensWork from '../components/pages/LensWork.astro';
import { localizedPageAlternates } from '../data/localizedPages';

const build = [
  { title: 'Pipeline architecture', body: 'CRM, outbound, and paid connected into one operating model. One source of truth, not four disconnected dashboards.' },
  { title: 'RevOps and attribution', body: 'Lifecycle stages, routing, and reporting that show exactly where the signal breaks.' },
  { title: 'Outbound that lands', body: 'Sequences and targeting built on real ICP signal, enriched and personalised with AI. Not spray.' },
];
const faq = [
  { question: "What does a GTM audit actually cover?", answer: "The CRM data model, lifecycle stages, routing, attribution and the outbound stack. I trace one real deal end to end and show you the exact point where the signal drops." },
  { question: "How fast do I see something?", answer: "The diagnosis lands in the first two weeks. Fixes ship as they are ready, not as one release at the end." },
  { question: "Do you work with companies under 2M ARR?", answer: "Rarely. Below that the bottleneck is usually the offer, not the plumbing, and rebuilding GTM systems is the wrong place to spend." },
  { question: "Do you hand it over or run it?", answer: "Both work. I build it, run it until the numbers hold, then hand it over with the documentation." },
];
---

<LensShowcase
  title="GTM"
  description="AI-native go-to-market systems: CRM, outbound, paid, and RevOps wired into one pipeline you can trust."
  eyebrow="GTM"
  h1Primary="Pipeline that compounds."
  h1Secondary="Not four dashboards."
  lead="CRM, outbound, and paid wired into one system. One source of truth, built and run until the pipeline holds."
  metaLine="CRM · outbound · paid · RevOps"
  heroImage="/images/lens/gtm-hero.webp"
  ogImage="/og/pages/gtm.png"
  alternates={localizedPageAlternates('gtm')}
  build={build}
  pov="Most GTM problems are not strategy problems. They are plumbing problems. I fix the plumbing."
  ctaHeading="Pipeline leaking somewhere you cannot see?"
  faq={faq}
  ctaSubtext="Send the current stack and the bottleneck. I will tell you where the signal breaks and where I would start."
>
  <LensWork
    eyebrow="GTM in production"
    heading="Built and running, not slideware."
    lead="GTM systems and tools I designed, shipped, and still operate. Each one links to the live build or the breakdown."
    ids={['ad-assistant', 'gtm-starter-pack', 'outbound-intelligence-system']}
    viewLabel="View project"
  />
</LensShowcase>
