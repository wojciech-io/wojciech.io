---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import HeroSection from '../components/home/HeroSection.astro';
import MetricsStrip from '../components/home/MetricsStrip.astro';
import ThreeLenses from '../components/home/ThreeLenses.astro';
import HowIWork from '../components/home/HowIWork.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import AILeverage from '../components/home/AILeverage.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import InsightsPreview from '../components/home/InsightsPreview.astro';
import BrandLogos from '../components/ui/BrandLogos.astro';
import { homeAlternates } from '../data/locales';
---

<Layout
  title="Wojciech Łuszczyński · AI-native GTM operator"
  description="Build AI-native revenue systems for B2B SaaS. Fractional GTM architect connecting CRM, outbound, paid acquisition, and AI workflows into one operating model."
  ogImage="/og/pages/home.png"
  alternates={homeAlternates}
  preloadImage="/images/wojciech-office-hq.webp"
>
  <div class="scroll-progress" aria-hidden="true"></div>
  <HeroSection />
  <MetricsStrip />
  <section class="border-b border-[var(--color-border)] py-10 md:py-12">
    <div class="mx-auto max-w-6xl px-6">
      <p class="obs-label-accent mb-7 text-center sm:text-left">Operated at</p>
      <BrandLogos variant="marquee" />
    </div>
  </section>
  <ThreeLenses />
  <HowIWork />
  <ProjectsSection />
  <AILeverage />
  <TestimonialsSection />
  <InsightsPreview />
  <CTABand
    heading="Know what is broken. Not sure what to build."
    subtext="Send the context, the bottleneck, and what already runs. I will tell you where I would start, and whether I am the right person to build it."
    ctaSecondary="See the work"
    ctaSecondaryHref="/work/"
  />
</Layout>
