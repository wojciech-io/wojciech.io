---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import TestimonialSlider from '../components/ui/TestimonialSlider.astro';

const projects = [
  {
    cover: 'ads-ai' as const,
    title: 'AdsAI / Ad Assistant',
    description: 'One AI-native ad workflow: brief, generate, score, iterate, and prepare variants for deployment. Built as an operator tool, not a separate agency workflow.',
    tags: ['AI', 'Ads', 'GTM', 'Operator tooling'],
    href: 'https://app.wojciech.io/apps',
    external: true,
  },
  {
    cover: 'gtm-pack' as const,
    title: 'Claude Code GTM Agent Starter Pack',
    description: 'Open-source starter pack for building AI GTM agents with Claude Code. Designed for growth operators who want to ship AI-native workflows without starting from scratch.',
    tags: ['Claude Code', 'AI', 'GTM', 'Open source'],
    href: 'https://github.com/wojciechluszczynski/gtm-agent-repo',
    external: true,
  },
  {
    cover: 'notch' as const,
    title: 'Notch',
    description: 'Native macOS teleprompter app built with Codex and Xcode. Lives in the camera notch. Keeps notes visible, scrolls automatically, makes you sound natural on calls and demos.',
    tags: ['macOS', 'Swift', 'Codex', 'AI-built'],
    href: 'https://notch.wojciech.io',
    external: true,
  },
  {
    cover: 'kamperownia' as const,
    title: 'Kamperownia Booking Engine',
    description: 'Custom booking and availability system for a campervan rental business. Replaced manual coordination with a structured self-serve flow. Payment and availability logic included.',
    tags: ['Product', 'Booking', 'Web app'],
    href: 'https://app.wojciech.io/apps',
    external: true,
  },
  {
    cover: 'ai-adoption' as const,
    title: 'AI Adoption Framework',
    description: 'Designed an AI adoption framework for a B2B SaaS. Translated AI capabilities into practical operator workflows across growth, marketing, and product.',
    tags: ['AI adoption', 'Growth', 'B2B SaaS', 'Ops'],
    href: '/work',
    external: false,
  },
  {
    cover: 'growth-system' as const,
    title: 'B2B SaaS Growth System',
    description: 'Full Q1/Q2 growth architecture: ICP refinement, outbound system, CRM operating model, SEO foundation, CRO layer. Built as one integrated system, not a set of campaigns.',
    tags: ['B2B SaaS', 'GTM', 'CRM', 'SEO', 'CRO'],
    href: '/work',
    external: false,
  },
];

const testimonials = [
  {
    quote: "Wojciech is passionate and knowledgeable about digital marketing and all that it entails but very much in tune with the broader marketing and sales challenges. Wojtek contributed to defining and delivering several digital marketing initiatives that helped with customer retention and building a sales pipeline.",
    name: "Robert Sikorski",
    role: "Head of Marketing",
    company: "GetResponse",
  },
  {
    quote: "Wojciech is a man of particular tasks, for whom an obstacle is another challenge. He learned quickly, often exceeded expectations, and was able to carry out several tasks at the same time. Competent, helpful, but at the same time specific and tenacious.",
    name: "Dariusz Gołębiewski",
    role: "Director",
    company: "mBank SA",
  },
  {
    quote: "I've been working with Wojciech for several months now. The cooperation goes smoothly, and we always know what we're responsible for. I recommend Wojciech as a good coworker and business partner.",
    name: "Mike Zoladkowski",
    role: "Founder",
    company: "Type2Sell",
  },
];
---

<Layout>

  <!-- ─── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="relative pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden">
    <!-- Grid -->
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-20" aria-hidden="true" />
    <!-- Animated glow -->
    <div class="animate-glow-breathe pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[var(--color-accent-lo)] blur-[160px] rounded-full" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-16 items-center">

        <!-- Left: text -->
        <div class="animate-fade-up text-center lg:text-left">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 rounded-[var(--radius-badge)] px-3 py-1 mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse-dot"></span>
            <span class="text-xs font-medium text-[var(--color-accent)]">Available for new projects · B2B SaaS</span>
          </div>

          <!-- Headline -->
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] font-bold leading-[1.06] tracking-tight mb-6 text-balance">
            <span class="text-[var(--color-text)]">I build revenue systems</span><br />
            <span class="text-[var(--color-text-muted)]">that compound.</span>
          </h1>

          <!-- Sub-copy -->
          <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-snug mb-10 max-w-xl mx-auto lg:mx-0">
            Working product. Broken pipeline. I design the revenue system, build it, and ship the tools it needs to run.
          </p>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-4">
            <a
              href="/work"
              class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors"
            >
              See the work
            </a>
            <a
              href="https://cal.com/wojciech-luszczynski"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text)] font-medium px-7 py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
            >
              Book a call
            </a>
          </div>
          <p class="text-xs text-[var(--color-text-dim)]">Responds within 24 hours</p>

        </div>

        <!-- Right: portrait photo -->
        <div class="hidden lg:block relative animate-scale-in" style="animation-delay: 120ms">
          <!-- Glow behind photo -->
          <div class="absolute -inset-8 bg-[var(--color-accent-lo)]/15 blur-[60px] rounded-full animate-glow-breathe" aria-hidden="true" />
          <!-- Photo card -->
          <div class="relative rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
            <img
              src="/images/wojciech-hero.webp"
              alt="Wojciech Łuszczyński"
              width="400"
              height="480"
              loading="eager"
              decoding="async"
              class="w-full h-[480px] object-cover object-[center_top]"
            />
            <!-- Bottom fade into page -->
            <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[var(--color-bg)] to-transparent" />
            <!-- Subtle vignette sides -->
            <div class="absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-[var(--color-bg)]/30 to-transparent" />
            <div class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-[var(--color-bg)]/30 to-transparent" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── 2. HOW I WORK ───────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">How I work</p>
        <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight max-w-xl">
          <span class="text-[var(--color-text)]">Not a consultant. An operator.</span><br />
          <span class="text-[var(--color-text-muted)]">I stay until it runs.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { step: '01', title: 'Diagnose', body: 'Revenue architecture audit: pipeline, CRM, GTM motions, attribution. I map where the signal breaks before touching anything.' },
          { step: '02', title: 'Design', body: 'System design: what connects to what, what gets measured, what gets automated, and in what order it gets built.' },
          { step: '03', title: 'Implement', body: 'I build it: sequences, dashboards, CRM operating model, tooling. Or I embed with your team and build alongside them.' },
          { step: '04', title: 'Ship the gap', body: "When the right tool doesn't exist, I write it. AI agents, custom apps, MCP workflows. The system gets what it needs." },
        ].map(({ step, title, body }) => (
          <div class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-accent)]/30 group">
            <p class="text-xs font-mono text-[var(--color-accent)] mb-5">{step}</p>
            <h3 class="text-base font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-accent-hi)] transition-colors">{title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 5. PROJECTS ────────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">

      <!-- Header -->
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Selected work</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight">
            <span class="text-[var(--color-text)]">Projects that shipped.</span><br />
            <span class="text-[var(--color-text-muted)]">Systems that still run.</span>
          </h2>
        </div>
        <a href="/work" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors hidden sm:block shrink-0 ml-4">
          All work →
        </a>
      </div>

      <!-- Featured project: split view (Ayro-style) -->
      <a
        href={projects[0].external ? projects[0].href : projects[0].href}
        target={projects[0].external ? '_blank' : undefined}
        rel={projects[0].external ? 'noopener noreferrer' : undefined}
        class="group block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/30 transition-colors mb-5"
      >
        <div class="grid md:grid-cols-2 min-h-[320px]">
          <!-- Left: cover visual -->
          <div class="relative bg-[var(--color-surface-2)] overflow-hidden">
            <div class="absolute inset-0" style="background-image: radial-gradient(circle, #EBFF0014 1px, transparent 1px); background-size: 28px 28px;" />
            <!-- AdsAI SVG illustration -->
            <svg viewBox="0 0 480 320" class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- orbit rings -->
              <circle cx="240" cy="160" r="90"  fill="none" stroke="#EBFF00" stroke-width="0.5" opacity="0.15"/>
              <circle cx="240" cy="160" r="60"  fill="none" stroke="#EBFF00" stroke-width="0.5" opacity="0.2"/>
              <circle cx="240" cy="160" r="30"  fill="none" stroke="#EBFF00" stroke-width="1"   opacity="0.3"/>
              <!-- center -->
              <circle cx="240" cy="160" r="14" fill="#EBFF00" opacity="0.9"/>
              <text x="240" y="165" font-family="monospace" font-size="10" fill="#0c0c0c" text-anchor="middle" font-weight="bold">AI</text>
              <!-- satellites -->
              <circle cx="240" cy="70"  r="7" fill="#EBFF00" opacity="0.5"/>
              <circle cx="315" cy="205" r="7" fill="#EBFF00" opacity="0.5"/>
              <circle cx="165" cy="205" r="7" fill="#EBFF00" opacity="0.5"/>
              <!-- labels -->
              <text x="240" y="55"  font-family="monospace" font-size="9" fill="#EBFF00" opacity="0.6" text-anchor="middle">BRIEF</text>
              <text x="328" y="218" font-family="monospace" font-size="9" fill="#EBFF00" opacity="0.6" text-anchor="middle">SCORE</text>
              <text x="152" y="218" font-family="monospace" font-size="9" fill="#EBFF00" opacity="0.6" text-anchor="middle">ITERATE</text>
              <!-- connecting lines -->
              <line x1="240" y1="146" x2="240" y2="77"  stroke="#EBFF00" stroke-width="0.5" opacity="0.3"/>
              <line x1="240" y1="174" x2="309" y2="200" stroke="#EBFF00" stroke-width="0.5" opacity="0.3"/>
              <line x1="240" y1="174" x2="171" y2="200" stroke="#EBFF00" stroke-width="0.5" opacity="0.3"/>
              <!-- lightning bolt -->
              <path d="M237 148 L232 162 L239 162 L234 176 L248 158 L241 158 L246 148z" fill="#EBFF00" opacity="0.8"/>
            </svg>
          </div>
          <!-- Right: content -->
          <div class="p-8 md:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-6">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21a48.25 48.25 0 01-8.135-.687c-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest">Featured</span>
              </div>
              <h3 class="text-xl md:text-2xl font-semibold text-[var(--color-text)] leading-snug mb-4 group-hover:text-[var(--color-accent-hi)] transition-colors">
                {projects[0].title}
              </h3>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
                {projects[0].description}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {projects[0].tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded border border-[var(--color-border-2)] text-[var(--color-text-dim)] bg-[var(--color-surface-2)]">{tag}</span>
                ))}
              </div>
            </div>
            <div class="mt-8 pt-6 border-t border-[var(--color-border)]">
              <span class="text-sm font-medium text-[var(--color-accent-hi)] group-hover:text-[var(--color-text)] transition-colors">
                {projects[0].external ? 'View project ↗' : 'See case study →'}
              </span>
            </div>
          </div>
        </div>
      </a>

      <!-- Remaining projects: 3-column grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {projects.slice(1).map((p) => (
          <ProjectCard
            cover={p.cover}
            title={p.title}
            description={p.description}
            tags={p.tags}
            href={p.href}
            external={p.external}
          />
        ))}

        <!-- 6th slot: CTA card -->
        <a
          href="https://cal.com/wojciech-luszczynski"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 p-8 card-lift hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-accent)]/8 transition-colors"
        >
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-5">Work with me</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] leading-snug mb-3 group-hover:text-[var(--color-accent-hi)] transition-colors">
              Have a revenue problem worth solving?
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-snug">
              Book a 30-minute call. We figure out what's broken and whether it's worth working together.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] group-hover:text-[var(--color-accent-hi)] transition-colors">
            Book a call →
          </div>
        </a>
      </div>

    </div>
  </section>

  <!-- ─── 7. AI LEVERAGE ──────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">AI systems</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight mb-5">
            <span class="text-[var(--color-text)]">AI in the architecture.</span><br />
            <span class="text-[var(--color-text-muted)]">Not bolted on at the end.</span>
          </h2>
          <p class="text-sm text-[var(--color-text-muted)] leading-snug mb-4">
            Not for faster copy. For a different operating model. AI goes into prospecting, enrichment,
            sequencing, and scoring. The whole motion runs faster. Not just one task on the list.
          </p>
          <a href="/ai-systems" class="text-sm text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors font-medium">
            How I build with AI →
          </a>
        </div>
        <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 space-y-1 card-lift hover:border-[var(--color-accent)]/30">
          {[
            { label: 'Ad creation loop', before: 'Days', after: 'Minutes' },
            { label: 'CRM enrichment', before: 'Manual / BDR time', after: 'Automated' },
            { label: 'SEO brief → draft', before: 'Week', after: 'Hours' },
            { label: 'Outbound sequencing', before: 'Templates', after: 'AI-personalised' },
          ].map(({ label, before, after }) => (
            <div class="flex items-center justify-between py-3.5 border-b border-[var(--color-border)] last:border-0 group">
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{label}</p>
              <div class="flex items-center gap-3 text-xs shrink-0 ml-4">
                <span class="text-[var(--color-text-dim)] line-through">{before}</span>
                <span class="text-[var(--color-accent)] font-semibold">{after}</span>
              </div>
            </div>
          ))}
          <a href="/ai-systems" class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors pt-4">
            See all AI systems →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 8. TESTIMONIALS ─────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Testimonials</p>
        <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight">
          <span class="text-[var(--color-text)]">What it's like</span><br />
          <span class="text-[var(--color-text-muted)]">to work with me.</span>
        </h2>
      </div>
      <TestimonialSlider testimonials={testimonials} />
    </div>
  </section>

  <!-- ─── 9. INSIGHTS ──────────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">

      <!-- Editorial header: large title left, description right -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Writing</p>
          <h2 class="text-4xl md:text-5xl font-semibold leading-tight tracking-tight text-[var(--color-text)]">
            Operator notes.
          </h2>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] max-w-xs leading-relaxed md:text-right">
          Practical writing on AI GTM systems, agent tooling, and revenue architecture.
          No thought leadership. No LinkedIn reposts.
        </p>
      </div>

      <!-- Featured article: horizontal split card -->
      <a
        href="/insights/claude-code-vs-clay"
        class="group block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/30 transition-colors"
      >
        <div class="grid md:grid-cols-2">

          <!-- Left: visual / terminal illustration -->
          <div class="relative min-h-[220px] md:min-h-0 bg-[var(--color-surface-2)] overflow-hidden">
            <div class="absolute inset-0" style="background-image: radial-gradient(circle, #EBFF0012 1px, transparent 1px); background-size: 28px 28px;" />
            <svg viewBox="0 0 560 360" class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- terminal window -->
              <rect x="40" y="36" width="340" height="200" rx="8" fill="#111111" stroke="#2a2a2a" stroke-width="1"/>
              <rect x="40" y="36" width="340" height="30" rx="8" fill="#1a1a1a"/>
              <rect x="40" y="52" width="340" height="14" fill="#1a1a1a"/>
              <circle cx="58" cy="51" r="5" fill="#ef4444" opacity="0.5"/>
              <circle cx="75" cy="51" r="5" fill="#eab308" opacity="0.5"/>
              <circle cx="92" cy="51" r="5" fill="#22c55e" opacity="0.5"/>
              <text x="130" y="55" font-family="monospace" font-size="10" fill="#555">gtm-agent — claude code</text>
              <!-- terminal lines -->
              <text x="58" y="90"  font-family="monospace" font-size="11" fill="#EBFF00" opacity="0.7">$ claude run outbound --client kadromierz</text>
              <text x="58" y="113" font-family="monospace" font-size="10" fill="#555">▸ Loading operator identity (CLAUDE.md)...</text>
              <text x="58" y="132" font-family="monospace" font-size="10" fill="#555">▸ Reading client memory: kadromierz.md</text>
              <text x="58" y="151" font-family="monospace" font-size="10" fill="#555">▸ Fetching ICP signal, 340 prospects...</text>
              <text x="58" y="170" font-family="monospace" font-size="10" fill="#22c55e" opacity="0.8">✓ 18 high-fit leads enriched and scored</text>
              <text x="58" y="189" font-family="monospace" font-size="10" fill="#22c55e" opacity="0.8">✓ Sequences staged in HubSpot</text>
              <text x="58" y="212" font-family="monospace" font-size="10" fill="#333">Cost: </text>
              <text x="88" y="212" font-family="monospace" font-size="10" fill="#EBFF00" opacity="0.7">$3.40</text>
              <text x="120" y="212" font-family="monospace" font-size="10" fill="#333"> · Time: </text>
