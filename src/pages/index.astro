---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import TestimonialSlider from '../components/ui/TestimonialSlider.astro';

const projects = [
  {
    cover: 'relora' as const,
    title: 'Relora',
    description: 'A relationship operating system for local-government property teams. One place for contacts, owner context, communication status, and next actions.',
    tags: ['AI workflow', 'CRM-lite', 'Ops dashboard'],
    href: 'https://relora-jet.vercel.app/',
    screenshot: '/images/work/relora-preview.jpg',
    problem: 'Important owner conversations lived across inboxes, notes, and memory.',
    system: 'Contacts, relationships, briefs, status, and follow-up in one operator view.',
    artifact: 'Live demo app with dashboard, relation map, and task flow.',
    outcome: 'Manual relationship tracking becomes a structured operating queue.',
    external: true,
  },
  {
    cover: 'ads-ai' as const,
    title: 'AdsAI / Ad Assistant',
    description: 'An AI-native Google Ads cockpit: spend, ROAS, ICP fit, campaign priorities, and next-best actions in one workspace.',
    tags: ['AI', 'Ads', 'GTM', 'Operator tooling'],
    href: 'https://ads-assistant-three.vercel.app/',
    screenshot: '/images/work/ads-assistant-preview.jpg',
    problem: 'Ad optimization work was split between reports, intuition, and repeated checks.',
    system: 'Budget, ICP, ROAS, alerts, and actions are pulled into one decision loop.',
    artifact: 'Live dashboard with campaign priorities and optimization queue.',
    outcome: 'Operator sees what to pause, analyze, or optimize without hunting through reports.',
    external: true,
  },
  {
    cover: 'kamperownia' as const,
    title: 'Camper Rental Booking Engine',
    description: 'A self-serve camper rental site for browsing vehicles, checking dates, and moving from interest to reservation quickly.',
    tags: ['Product', 'Booking', 'Web app'],
    href: 'https://camper-rental-weld.vercel.app/',
    screenshot: '/images/work/kamperownia-preview.jpg',
    problem: 'Rental demand needed a clearer path from browsing to booking.',
    system: 'Inventory, dates, offer framing, and reservation CTA in one front-end flow.',
    artifact: 'Responsive booking website with vehicle cards and search entry point.',
    outcome: 'A manual inquiry motion becomes a productized booking experience.',
    external: true,
  },
  {
    cover: 'notch' as const,
    title: 'NotchCue',
    description: 'A macOS teleprompter concept for calls, demos, and recordings. Keeps notes close to the camera so delivery stays natural.',
    tags: ['macOS', 'Swift', 'AI-built'],
    href: 'https://notch.wojciech.io/',
    screenshot: '/images/work/notch-preview.jpg',
    problem: 'Notes sit away from the camera, which breaks eye contact during calls and demos.',
    system: 'Prompts live around the MacBook notch with a focused reading surface.',
    artifact: 'Product site and app concept built around the camera area.',
    outcome: 'Speakers keep structure without sounding like they are reading.',
    external: true,
  },
];

const testimonials = [
  {
    quote: "Wojciech is passionate and knowledgeable about digital marketing and all that it entails but very much in tune with the broader marketing and sales challenges. Wojtek contributed to defining and delivering several digital marketing initiatives that helped with customer retention and building a sales pipeline.",
    name: "Robert Sikorski",
    role: "Head of Marketing",
    company: "GetResponse",
    linkedin: "https://www.linkedin.com/in/robert-sikorski-getresponse/",
    avatar: "https://unavatar.io/linkedin/robert-sikorski-getresponse",
    avatar: undefined,
  },
  {
    quote: "Wojciech is a man of particular tasks, for whom an obstacle is another challenge. He learned quickly, often exceeded expectations, and was able to carry out several tasks at the same time. Competent, helpful, but at the same time specific and tenacious.",
    name: "Dariusz Gołębiewski",
    role: "Director",
    company: "mBank SA",
    linkedin: "https://pl.linkedin.com/in/dariusz-go%C5%82%C4%99biewski-he-him-412371120",
    avatar: "https://unavatar.io/linkedin/dariusz-go%C5%82%C4%99biewski-he-him-412371120",
  },
  {
    quote: "I've been working with Wojciech for several months now. The cooperation goes smoothly, and we always know what we're responsible for. I recommend Wojciech as a good coworker and business partner.",
    name: "Mike Zoladkowski",
    role: "Founder",
    company: "Type2Sell",
    linkedin: "https://ca.linkedin.com/in/mikezoladkowski",
    avatar: "https://unavatar.io/linkedin/mikezoladkowski",
  },
];
---

<Layout>

  <!-- ─── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="min-height: 620px;">
    <!-- Subtle grid -->
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
    <!-- Neutral depth behind text -->
    <div class="pointer-events-none absolute left-[-160px] top-[-180px] h-[520px] w-[640px] rounded-full bg-[var(--color-surface)] blur-[150px] opacity-70" aria-hidden="true" />

    <!-- Photo: desktop only, right half, absolute -->
    <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-[46%] overflow-hidden" aria-hidden="true">
      <img
        src="/images/wojciech-hero.webp"
        alt=""
        width="920"
        height="1380"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-top"
      />
      <!-- Left fade overlay: blends photo into dark background -->
      <div class="absolute inset-y-0 left-0 w-[30%] pointer-events-none" style="background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);" />
      <!-- Bottom fade overlay -->
      <div class="absolute inset-x-0 bottom-0 h-[18%] pointer-events-none" style="background: linear-gradient(to top, var(--color-bg) 0%, transparent 100%);" />
      <!-- Proof rail -->
      <div class="absolute bottom-10 left-8 z-10 w-[min(420px,calc(100%-4rem))] overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-glass)] shadow-[var(--shadow-card)] backdrop-blur-md">
        <div class="grid grid-cols-3 divide-x divide-[var(--color-border)]">
          <div class="px-4 py-3.5">
            <p data-en="Status" data-pl="Status" data-it="Stato" class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Status</p>
            <p data-en="Available" data-pl="Dostępny" data-it="Disponibile" class="mt-1 text-sm font-semibold text-[var(--color-text)]">Available</p>
            <p class="text-[11px] text-[var(--color-text-muted)]">Fractional</p>
          </div>
          <div class="px-4 py-3.5">
            <p data-en="Markets" data-pl="Rynki" data-it="Mercati" class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Markets</p>
            <p class="mt-1 text-sm font-semibold text-[var(--color-text)]">EU / UK / US</p>
            <p data-en="plus LATAM" data-pl="plus LATAM" data-it="piu LATAM" class="text-[11px] text-[var(--color-text-muted)]">plus LATAM</p>
          </div>
          <div class="px-4 py-3.5">
            <p data-en="Mode" data-pl="Tryb" data-it="Modalita" class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Mode</p>
            <p data-en="Strategy" data-pl="Strategia" data-it="Strategia" class="mt-1 text-sm font-semibold text-[var(--color-text)]">Strategy</p>
            <p data-en="Build / ship" data-pl="Build / ship" data-it="Build / ship" class="text-[11px] text-[var(--color-text-muted)]">Build / ship</p>
          </div>
        </div>
      </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6">

      <!-- Text: left column, constrained width so photo shows on right -->
      <div class="animate-fade-up flex flex-col justify-center py-24 lg:py-32 lg:max-w-[54%]">

        <!-- Badge -->
        <div class="inline-flex self-start items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-glass)] px-3.5 py-2 mb-8 shadow-[var(--shadow-card)] backdrop-blur">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_14px_rgb(235_255_0/0.55)]"></span>
          <span data-en="GTM Architect · Growth Operator" data-pl="GTM Architect · Growth Operator" data-it="GTM Architect · Growth Operator" class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text)]">GTM Architect · Growth Operator</span>
        </div>

        <!-- Mobile: avatar -->
        <div class="lg:hidden flex items-center gap-3 mb-8">
          <img
            src="/images/wojciech-avatar-384.webp"
            alt="Wojciech Łuszczyński"
            width="56"
            height="56"
            loading="eager"
            decoding="async"
            class="w-14 h-14 rounded-full object-cover border border-[var(--color-accent)]/35 shrink-0"
          />
          <div>
            <p class="text-sm font-semibold text-[var(--color-text)]">Wojciech Łuszczyński</p>
            <p class="text-xs text-[var(--color-text-muted)]">GTM Architect · Growth Operator</p>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="text-[2rem] sm:text-4xl md:text-5xl lg:text-[3.8rem] font-bold leading-[1.08] tracking-tight mb-6">
          <span data-en="I build revenue systems." data-pl="Buduję systemy przychodowe." data-it="Costruisco sistemi di revenue." class="text-[var(--color-text)]">I build revenue systems.</span><br class="hidden md:block" /> <span data-en="Then I stay until they work." data-pl="Zostaję, aż działają." data-it="Resto finché funzionano." class="text-[var(--color-text-muted)]">Then I stay until they work.</span>
        </h1>

        <!-- Sub-copy -->
        <p data-en="Most B2B companies don't have a traffic problem — they have a system problem. Twenty years inside marketing and growth teams showed me the same gap everywhere: great traffic with a leaky CRM, AI in the deck but Excel in the actual work. I rebuild it as one operating model — GTM, CRM, automation and AI as a single machine — and I don't leave when it gets hard." data-pl="Większość firm B2B nie ma problemu z ruchem — ma problem z systemem. Dwadzieścia lat wewnątrz zespołów marketingu i growth pokazało mi tę samą lukę wszędzie: dobry ruch i dziurawy CRM, AI w prezentacjach i Excel w prawdziwej robocie. Przebudowuję to na jeden model operacyjny — GTM, CRM, automatyzacja i AI jako jedna maszyna — i nie odpuszczam, gdy robi się trudno." data-it="La maggior parte delle aziende B2B non ha un problema di traffico — ha un problema di sistema. Vent'anni nei team marketing e growth mi hanno mostrato la stessa lacuna ovunque: traffico ottimo con CRM bucato, AI nelle presentazioni ed Excel nel lavoro vero. Lo ricostruisco come un unico modello operativo: GTM, CRM, automazione e AI come una sola macchina. E non mollo quando si fa dura." class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-lg">
          Most B2B companies don't have a traffic problem — they have a system problem. Twenty years inside marketing and growth teams showed me the same gap everywhere: great traffic with a leaky CRM, AI in the deck but Excel in the actual work. I rebuild it as one operating model — GTM, CRM, automation and AI as a single machine — and I don't leave when it gets hard.
        </p>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-3 mb-5">
          <a
            href="/work"
            data-en="See the work"
            data-pl="Zobacz projekty"
            data-it="Guarda i progetti"
            class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors"
          >
            See the work
          </a>
          <a
            href="/subscribe"
            data-en="Get the newsletter"
            data-pl="Zapisz się na newsletter"
            data-it="Iscriviti alla newsletter"
            class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[var(--color-text)] font-medium px-7 py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
          >
            Get the newsletter
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── METRICS STRIP ─────────────────────────────────────────── -->
  <section class="relative bg-[var(--color-surface-2)]">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border)] to-transparent" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-[var(--color-border)]">
        {[
          { value: '20', label: 'years marketing & digital', labelPl: 'lat marketing i digital', labelIt: 'anni marketing & digital' },
          { value: '10', label: 'years B2B SaaS', labelPl: 'lat B2B SaaS', labelIt: 'anni B2B SaaS' },
          { value: '10', label: 'years GTM', labelPl: 'lat GTM', labelIt: 'anni GTM' },
          { value: '3×', label: 'avg. pipeline lift', labelPl: 'średni wzrost pipeline', labelIt: 'media crescita pipeline' },
        ].map(({ value, label, labelPl, labelIt }) => (
          <div class="flex flex-col items-center py-8 px-4 text-center">
            <p class="text-3xl font-bold text-[var(--color-text)] mb-1">{value}</p>
            <p data-en={label} data-pl={labelPl} data-it={labelIt} class="text-xs text-[var(--color-text-dim)] uppercase tracking-widest">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── 2. HOW I WORK ───────────────────────────────────────────── -->
  <section class="relative py-[var(--space-section)] bg-[var(--color-bg)] overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent" aria-hidden="true"></div>
    <!-- Subtle dot texture -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,var(--color-border)_1px,transparent_1px)] bg-[size:36px_36px] opacity-[0.35]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4 flex items-center gap-2.5"><span class="inline-block w-2 h-2 rounded-sm bg-[var(--color-accent)] rotate-45 opacity-80" aria-hidden="true"></span><span data-en="How I work" data-pl="Jak pracuję" data-it="Come lavoro">How I work</span></p>
        <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight max-w-xl">
          <span data-en="Not a consultant. An operator." data-pl="Nie konsultant. Operator." data-it="Non un consulente. Un operatore." class="text-[var(--color-text)]">Not a consultant. An operator.</span><br />
          <span data-en="I stay until it runs." data-pl="Zostaję, aż działa." data-it="Resto finche funziona." class="text-[var(--color-text-muted)]">I stay until it runs.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { step: '01', title: 'Diagnose', body: 'Revenue architecture audit: pipeline, CRM, GTM motions, attribution. I map where the signal breaks before touching anything.', titlePl: 'Diagnoza', bodyPl: 'Audyt architektury przychodów: pipeline, CRM, motywy GTM, atrybucja. Mapuję, gdzie sygnał się urywa, zanim coś dotknę.', titleIt: 'Diagnosi', bodyIt: "Audit dell'architettura di revenue: pipeline, CRM, GTM motion, attribuzione. Mappo dove il segnale si interrompe prima di toccare qualcosa." },
          { step: '02', title: 'Design', body: 'System design: what connects to what, what gets measured, what gets automated, and in what order it gets built.', titlePl: 'Projekt', bodyPl: 'Projekt systemu: co się z czym łączy, co się mierzy, co się automatyzuje i w jakiej kolejności się buduje.', titleIt: 'Progettazione', bodyIt: 'Progetto del sistema: cosa si collega a cosa, cosa si misura, cosa si automatizza e in quale ordine si costruisce.' },
          { step: '03', title: 'Implement', body: 'I build it: sequences, dashboards, CRM operating model, tooling. Or I embed with your team and build alongside them.', titlePl: 'Implementacja', bodyPl: 'Buduję: sekwencje, dashboardy, model operacyjny CRM, narzędzia. Albo wchodzę w twój zespół i buduję razem z nimi.', titleIt: 'Implementazione', bodyIt: 'Lo costruisco: sequenze, dashboard, modello operativo CRM, strumenti. Oppure mi integro nel tuo team e costruisco insieme a loro.' },
          { step: '04', title: 'Ship the gap', body: "When the right tool doesn't exist, I write it. AI agents, custom apps, MCP workflows. The system gets what it needs.", titlePl: 'Luka produktowa', bodyPl: 'Gdy właściwego narzędzia nie ma, piszę je. Agenty AI, własne aplikacje, workflow MCP. System dostaje to, czego potrzebuje.', titleIt: 'Colma il vuoto', bodyIt: "Quando lo strumento giusto non esiste, lo scrivo. Agenti AI, app personalizzate, workflow MCP. Il sistema ottiene cio di cui ha bisogno." },
        ].map(({ step, title, body, titlePl, bodyPl, titleIt, bodyIt }) => (
          <div class="reveal-up relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-accent)]/30 group">
            <span class="pointer-events-none absolute -right-2 -top-4 text-[7rem] font-bold leading-none select-none text-[var(--color-border)] opacity-60 group-hover:opacity-90 transition-opacity">{step}</span>
            <p class="relative text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-5">{step}</p>
            <h3 data-en={title} data-pl={titlePl} data-it={titleIt} class="relative text-base font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-accent-hi)] transition-colors">{title}</h3>
            <p data-en={body} data-pl={bodyPl} data-it={bodyIt} class="relative text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 5. PROJECTS ────────────────────────────────────────────── -->
  <section class="relative py-[var(--space-section)] bg-[var(--color-surface-2)]">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-6">

      <!-- Header -->
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4 flex items-center gap-2.5"><span class="inline-block w-2 h-2 rounded-sm bg-[var(--color-accent)] rotate-45 opacity-80" aria-hidden="true"></span><span data-en="Selected work" data-pl="Wybrane projekty" data-it="Lavori selezionati">Selected work</span></p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-[1.15] tracking-tight">
            <span data-en="Projects that shipped." data-pl="Projekty, które wyszły." data-it="Progetti realizzati." class="text-[var(--color-text)]">Projects that shipped.</span><br />
            <span data-en="Systems that still run." data-pl="Systemy, które działają." data-it="Sistemi ancora attivi." class="text-[var(--color-text-muted)]">Systems that still run.</span>
          </h2>
        </div>
        <a href="/work" data-en="All work →" data-pl="Wszystkie projekty →" data-it="Tutti i progetti →" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors hidden sm:block shrink-0 ml-4">
          All work →
        </a>
      </div>

      <!-- Featured project: proof-led split view -->
      <a
        href={projects[0].external ? projects[0].href : projects[0].href}
        target={projects[0].external ? '_blank' : undefined}
        rel={projects[0].external ? 'noopener noreferrer' : undefined}
        class="group block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/30 transition-colors mb-5"
      >
        <div class="grid min-h-[360px] lg:grid-cols-2">
          <!-- Left: real artifact -->
          <div class="artifact-stage relative min-h-[260px] overflow-hidden p-5 md:p-8">
            <div class="artifact-shot h-full min-h-[220px] overflow-hidden rounded-[14px] bg-[var(--color-surface)] transition-transform duration-500 group-hover:scale-[1.012]">
              <img
                src={projects[0].screenshot}
                alt={`${projects[0].title} product screenshot`}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top"
              />
            </div>
            <div class="artifact-fade absolute inset-x-0 bottom-0 h-2/5" aria-hidden="true"></div>
            <div class="artifact-label absolute left-5 top-5 inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-[10px] font-semibold backdrop-blur-md">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
              Live product artifact
            </div>
          </div>

          <!-- Right: content -->
          <div class="p-8 md:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-6">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21a48.25 48.25 0 01-8.135-.687c-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span data-en="Featured" data-pl="Wyróżniony" data-it="In evidenza" class="text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest">Featured</span>
              </div>
              <h3 class="text-xl md:text-2xl font-semibold text-[var(--color-text)] leading-snug mb-4 group-hover:text-[var(--color-accent-hi)] transition-colors">
                {projects[0].title}
              </h3>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
                {projects[0].description}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {projects[0].tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded-full border font-medium bg-[var(--color-surface-2)] text-[var(--color-text-muted)] border-[var(--color-border)]">{tag}</span>
                ))}
              </div>
              <dl class="mt-7 grid gap-4 border-t border-[var(--color-border)] pt-6">
                {[
                  [{ en: 'Problem', pl: 'Problem', it: 'Problema' }, projects[0].problem],
                  [{ en: 'System', pl: 'System', it: 'Sistema' }, projects[0].system],
                  [{ en: 'Artifact', pl: 'Artefakt', it: 'Artefatto' }, projects[0].artifact],
                  [{ en: 'Outcome', pl: 'Wynik', it: 'Risultato' }, projects[0].outcome],
                ].map(([label, value]) => (
                  <div class="grid grid-cols-[88px_1fr] gap-4">
                    <dt data-en={label.en} data-pl={label.pl} data-it={label.it} class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">{label.en}</dt>
                    <dd class="text-sm leading-snug text-[var(--color-text-muted)]">{value}</dd>
                  </div>
