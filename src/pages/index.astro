---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import HeroSection from '../components/home/HeroSection.astro';
import MetricsStrip from '../components/home/MetricsStrip.astro';
import HowIWork from '../components/home/HowIWork.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import AILeverage from '../components/home/AILeverage.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import InsightsPreview from '../components/home/InsightsPreview.astro';
---


<Layout
  title="Wojciech Łuszczyński · AI-native GTM operator"
  description="Build AI-native revenue systems for B2B SaaS. Fractional GTM architect connecting CRM, outbound, paid acquisition, and AI workflows into one operating model."
>
  <HeroSection />
  <MetricsStrip />
  <HowIWork />
  <ProjectsSection />
  <AILeverage />
  <TestimonialsSection />
  <InsightsPreview />
  <CTABand />
</Layout>

<script>
  // Lenis smooth scroll — desktop/trackpad only, destroys on View Transitions navigation
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;

  function initLenis() {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    lenis = new Lenis({ duration: 1.15, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
    function raf(time: number) { lenis!.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
  }

  initLenis();
  document.addEventListener('astro:page-load', () => { lenis?.destroy(); lenis = null; initLenis(); });
  document.addEventListener('astro:before-preparation', () => { lenis?.destroy(); lenis = null; });
</script>
