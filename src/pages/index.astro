---
// The home page. Its markup, styles and scripts are the static preview at
// public/revolution/index.html (still served, noindex, at /revolution/); this
// page turns that file into the real `/` at build time, so a change to the
// preview reaches `/` without copying. See lib/revolutionHome.ts for exactly
// what is adjusted (absolute paths and links, CTA tracking attributes) and what
// RevolutionLayout adds (SEO head, consent, analytics).
import RevolutionLayout from '../layouts/RevolutionLayout.astro';
import previewHtml from '../../public/revolution/index.html?raw';
import { buildRevolutionHome } from '../lib/revolutionHome';
import { homeAlternates } from '../data/locales';
import { espressoSchema } from '../data/espressoSchema';

const { headHtml, bodyHtml } = buildRevolutionHome(previewHtml, homeAlternates);
---

<RevolutionLayout
  title="Wojciech Luszczynski · AI-native GTM operator"
  description="Build AI-native revenue systems for B2B SaaS. Fractional GTM architect connecting CRM, outbound, paid acquisition, and AI workflows into one operating model."
  ogImage="/og/pages/home.png"
  alternates={homeAlternates}
  schema={espressoSchema('en')}
  headHtml={headHtml}
  bodyHtml={bodyHtml}
/>
