---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/ui/CTABand.astro';
import HeroSection from '../components/home/HeroSection.astro';
import MetricsStrip from '../components/home/MetricsStrip.astro';
import HowIWork from '../components/home/HowIWork.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
