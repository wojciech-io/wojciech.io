---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTABand from '../components/ui/CTABand.astro';
import ProofCard from '../components/ui/ProofCard.astro';
import TestimonialSlider from '../components/ui/TestimonialSlider.astro';

const featuredWork = (await getCollection('work', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const testimonials = [
  {
    quote: "Wojciech is passionate and knowledgeable about digital marketing and all that it entails but very much in tune with the broader marketing and sales challenges. Wojtek contributed to defining and delivering several digital marketing initiatives that helped with customer retention and building a sales pipeline.",
    name: "Robert Sikorski",
    role: "Head of Marketing",
    company: "GetResponse",
  },
  {
    quote: "Wojciech is a man of particular tasks, for whom an obstacle is another challenge. He learned quickly, often exceeded expectations, and was able to carry out several tasks at the same time. Competent, helpful, but at the same time specific and tenacious.",
    name: "Dariusz Gołębiewski",
    role: "Director",
    company: "mBank SA",
  },
  {
    quote: "I've been working with Wojciech for several months now. The cooperation goes smoothly, and we always know what we're responsible for. I recommend Wojciech as a good coworker and business partner.",
    name: "Mike Zoladkowski",
    role: "Founder",
    company: "Type2Sell",
  },
];
---

<Layout>

  <!-- ─── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="relative pt-24 pb-16 md:pt-32 md:pb-20 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-20" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col lg:flex-row gap-16 items-center">

        <!-- Text -->
        <div class="flex-1 max-w-xl animate-fade-up">
          <div class="inline-flex items-center gap-2 border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 rounded-[var(--radius-badge)] px-3 py-1 mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse-dot"></span>
            <span class="text-xs font-medium text-[var(--color-accent)]">Growth operator · AI-native builder</span>
          </div>

          <h1 class="text-5xl md:text-[4.25rem] font-semibold leading-[1.05] tracking-tight mb-6">
            <span class="text-[var(--color-text)]">I build revenue systems</span><br />
            <span class="text-[var(--color-text-muted)]">that compound.</span>
          </h1>

          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-md mb-10">
            GTM architecture, growth systems, AI workflows — and the missing
            product layer. Built and shipped, not just scoped.
          </p>

          <div class="flex flex-wrap gap-3 mb-12">
            <a
              href="/work"
              class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors"
            >
              See the work
            </a>
            <a
              href="https://cal.com/wojciech-luszczynski"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text)] font-medium px-7 py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
            >
              Book a call
            </a>
          </div>

          <!-- Social proof micro -->
          <div class="flex flex-wrap gap-x-8 gap-y-4 border-t border-[var(--color-border)] pt-8">
            {[
              { value: '10+', label: 'Years in GTM & growth' },
              { value: '5', label: 'Enterprise clients' },
              { value: '4+', label: 'AI apps shipped' },
            ].map(({ value, label }) => (
              <div>
                <p class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">{value}</p>
                <p class="text-xs text-[var(--color-text-dim)] mt-0.5">{label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Photo in styled container -->
        <div class="shrink-0 relative animate-scale-in hidden lg:block" style="animation-delay: 120ms">
          <!-- Gradient blobs behind photo -->
          <div class="pointer-events-none absolute -top-12 -left-12 w-72 h-72 rounded-full bg-[var(--color-accent)]/12 blur-[80px]" aria-hidden="true" />
          <div class="pointer-events-none absolute -bottom-12 -right-12 w-80 h-80 rounded-full bg-blue-500/8 blur-[100px]" aria-hidden="true" />
          <div class="pointer-events-none absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-emerald-500/6 blur-[80px]" aria-hidden="true" />

          <!-- Photo card -->
          <div class="relative w-[380px] rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]">
            <img
              src="/images/wojciech.jpg"
              alt="Wojciech Łuszczyński"
              width="380"
              height="500"
              class="w-full h-[500px] object-cover object-top"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <!-- Subtle bottom fade -->
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)]/30 via-transparent to-transparent" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── 2. TRUSTED BY ───────────────────────────────────────────── -->
  <section class="py-10 border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-10">
        <p class="text-[10px] font-semibold tracking-[0.18em] uppercase text-[var(--color-text-dim)] shrink-0">Trusted by</p>
        <div class="flex flex-wrap gap-x-8 gap-y-2">
          {['GetResponse', 'SentiOne', 'Qi Group / WebWave', 'Symfonia', 'Marquard Media'].map((name) => (
            <span class="text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">{name}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM FRAMING ──────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">The problem</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-tight tracking-tight">
            <span class="text-[var(--color-text)]">Growth breaks when</span><br />
            <span class="text-[var(--color-text-muted)]">the system is fragmented.</span>
          </h2>
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed text-lg">
          Most growth stalls because the pieces don't connect: the CRM doesn't feed the playbook,
          the playbook doesn't match the pipeline, and the pipeline data isn't trusted.
          I fix the architecture, not just the symptoms.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 4. HOW I WORK ───────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">How I work</p>
        <h2 class="text-3xl md:text-4xl font-semibold leading-tight tracking-tight">
          <span class="text-[var(--color-text)]">Diagnose. Design.</span><br />
          <span class="text-[var(--color-text-muted)]">Implement. Instrument.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 stagger">
        {[
          { step: '01', title: 'Diagnose', body: 'Audit the revenue architecture, pipeline, CRM, GTM motions, and where the signal breaks.' },
          { step: '02', title: 'Design', body: 'Map the system: what connects to what, what gets measured, what gets automated.' },
          { step: '03', title: 'Implement', body: 'Build it — ops, tooling, copy, sequences, dashboards — or work alongside the team doing it.' },
          { step: '04', title: 'Ship the gap', body: "If the right tool doesn't exist, I build it. AI workflows, custom apps, operator tooling." },
        ].map(({ step, title, body }) => (
          <div class="animate-fade-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-accent)]/30 group">
            <p class="text-xs font-mono text-[var(--color-accent)] mb-5">{step}</p>
            <h3 class="text-base font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-accent-hi)] transition-colors">{title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 5. PROOF CLUSTERS ───────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Proof architecture</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-tight tracking-tight">
            <span class="text-[var(--color-text)]">Three clusters.</span><br />
            <span class="text-[var(--color-text-muted)]">One coherent story.</span>
          </h2>
        </div>
        <a href="/work" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors hidden sm:block shrink-0 ml-4">
          All work →
        </a>
      </div>
      <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-5">

        <!-- AI-native GTM -->
        <a href="/work#ai-gtm" class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col">
          <div class="relative w-full aspect-[4/3] bg-[var(--color-surface-2)] overflow-hidden shrink-0">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:28px_28px] opacity-30" aria-hidden="true" />
            <svg viewBox="0 0 400 300" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
              <line x1="100" y1="150" x2="185" y2="100" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="100" y1="150" x2="185" y2="200" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="185" y1="100" x2="280" y2="80" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="185" y1="100" x2="280" y2="150" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="185" y1="200" x2="280" y2="150" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="185" y1="200" x2="280" y2="230" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="280" y1="150" x2="355" y2="115" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <line x1="280" y1="150" x2="355" y2="195" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <circle cx="100" cy="150" r="14" fill="none" stroke="#EBFF00" stroke-width="1.5" stroke-opacity="0.9"/>
              <circle cx="100" cy="150" r="5" fill="#EBFF00" fill-opacity="0.8"/>
              <circle cx="185" cy="100" r="9" fill="none" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.6"/>
              <circle cx="185" cy="100" r="3" fill="#EBFF00" fill-opacity="0.5"/>
              <circle cx="185" cy="200" r="9" fill="none" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.6"/>
              <circle cx="185" cy="200" r="3" fill="#EBFF00" fill-opacity="0.5"/>
              <circle cx="280" cy="150" r="18" fill="none" stroke="#EBFF00" stroke-width="2"/>
              <circle cx="280" cy="150" r="7" fill="#EBFF00" fill-opacity="0.9"/>
              <circle cx="280" cy="80" r="7" fill="none" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.4"/>
              <circle cx="280" cy="230" r="7" fill="none" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.4"/>
              <circle cx="355" cy="115" r="5" fill="none" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
              <circle cx="355" cy="195" r="5" fill="none" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.3"/>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/60 to-transparent" />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase mb-3">AI · Builder</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150 leading-snug">AI-native GTM systems</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 flex-1">AdsAI, Ad Assistant, Claude Code GTM Starter Pack, Notch macOS app — practical AI that ships and runs.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              Explore
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Growth architecture -->
        <a href="/work#growth-architecture" class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col">
          <div class="relative w-full aspect-[4/3] bg-[var(--color-surface-2)] overflow-hidden shrink-0">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:28px_28px] opacity-30" aria-hidden="true" />
            <svg viewBox="0 0 400 300" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
              <rect x="55" y="215" width="42" height="55" rx="3" fill="#EBFF00" fill-opacity="0.08" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.3"/>
              <rect x="117" y="185" width="42" height="85" rx="3" fill="#EBFF00" fill-opacity="0.1" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.38"/>
              <rect x="179" y="148" width="42" height="122" rx="3" fill="#EBFF00" fill-opacity="0.13" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.48"/>
              <rect x="241" y="108" width="42" height="162" rx="3" fill="#EBFF00" fill-opacity="0.17" stroke="#EBFF00" stroke-width="1.5" stroke-opacity="0.6"/>
              <rect x="303" y="62" width="42" height="208" rx="3" fill="#EBFF00" fill-opacity="0.22" stroke="#EBFF00" stroke-width="2" stroke-opacity="0.85"/>
              <polyline points="76,210 138,180 200,143 262,103 324,57" stroke="#EBFF00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="76" cy="210" r="4" fill="#EBFF00" fill-opacity="0.7"/>
              <circle cx="138" cy="180" r="4" fill="#EBFF00" fill-opacity="0.75"/>
              <circle cx="200" cy="143" r="4" fill="#EBFF00" fill-opacity="0.85"/>
              <circle cx="262" cy="103" r="4" fill="#EBFF00" fill-opacity="0.9"/>
              <circle cx="324" cy="57" r="6" fill="#EBFF00"/>
              <line x1="35" y1="272" x2="365" y2="272" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.2"/>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/60 to-transparent" />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase mb-3">Growth · GTM</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150 leading-snug">Growth architecture in practice</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 flex-1">CRO, SEO, CRM, outbound, winback — operating models that connect the pipeline, not campaigns that fill the calendar.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              Explore
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Products shipped -->
        <a href="/work#products-shipped" class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col">
          <div class="relative w-full aspect-[4/3] bg-[var(--color-surface-2)] overflow-hidden shrink-0">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:28px_28px] opacity-30" aria-hidden="true" />
            <svg viewBox="0 0 400 300" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
              <rect x="55" y="70" width="260" height="175" rx="10" fill="none" stroke="#EBFF00" stroke-width="0.75" stroke-opacity="0.18"/>
              <rect x="75" y="90" width="240" height="155" rx="8" fill="none" stroke="#EBFF00" stroke-width="1" stroke-opacity="0.32"/>
              <rect x="95" y="108" width="220" height="137" rx="7" fill="#EBFF00" fill-opacity="0.04" stroke="#EBFF00" stroke-width="1.5" stroke-opacity="0.85"/>
              <rect x="95" y="108" width="220" height="28" rx="7" fill="#EBFF00" fill-opacity="0.12"/>
              <circle cx="113" cy="122" r="5" fill="#EBFF00" fill-opacity="0.7"/>
              <circle cx="128" cy="122" r="5" fill="#EBFF00" fill-opacity="0.38"/>
              <circle cx="143" cy="122" r="5" fill="#EBFF00" fill-opacity="0.18"/>
              <rect x="111" y="152" width="115" height="7" rx="3.5" fill="#EBFF00" fill-opacity="0.35"/>
              <rect x="111" y="167" width="160" height="5" rx="2.5" fill="#EBFF00" fill-opacity="0.16"/>
              <rect x="111" y="179" width="135" height="5" rx="2.5" fill="#EBFF00" fill-opacity="0.16"/>
              <rect x="111" y="191" width="105" height="5" rx="2.5" fill="#EBFF00" fill-opacity="0.1"/>
              <rect x="111" y="214" width="72" height="22" rx="11" fill="#EBFF00" fill-opacity="0.88"/>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/60 to-transparent" />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase mb-3">Product · Execution</p>
            <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150 leading-snug">Products actually shipped</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 flex-1">Kamperownia booking engine, Działka+, Paczka+, Resume+ — real products with real users, not side-project demos.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              Explore
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ─── 6. SELECTED WORK ────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Selected work</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-tight tracking-tight">
            <span class="text-[var(--color-text)]">Flagship proof.</span><br />
            <span class="text-[var(--color-text-muted)]">Real companies, real results.</span>
          </h2>
        </div>
        <a href="/work" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors hidden sm:block shrink-0 ml-4">
          View all →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {featuredWork.map((item) => (
          <ProofCard
            title={item.data.title}
            description={item.data.description}
            tags={item.data.tags}
            metrics={item.data.metrics}
            href={item.data.href}
            image={item.data.image}
            icon={item.data.icon}
            featured={item.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 7. AI LEVERAGE ──────────────────────────────────────────── -->
  <section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">AI systems</p>
          <h2 class="text-3xl md:text-4xl font-semibold leading-tight tracking-tight mb-5">
            <span class="text-[var(--color-text)]">AI changes the operating leverage.</span><br />
            <span class="text-[var(--color-text-muted)]">Not just the output.</span>
          </h2>
          <p class="text-[var(--color-text-muted)] leading-relaxed">
            I use AI to redesign how growth systems are built, instrumented, and iterated.
            The whole stack moves faster — not just one task in the queue.
          </p>
        </div>
        <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 space-y-1 card-lift hover:border-[var(--color-accent)]/30">
          {[
            { label: 'Ad creation loop', before: 'Days', after: 'Minutes' },
