---
import Layout from '../layouts/Layout.astro';
import SubscribeContent from '../components/pages/SubscribeContent.astro';
import { SITE } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsletterPublication',
  name: 'AI Espresso',
  url: SITE.url + '/subscribe/',
  description: 'Short operator notes on AI systems, GTM architecture, and what ships. Under 3 minutes per issue. Free.',
  inLanguage: 'en',
  publisher: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: SITE.url + '/' },
};
---

<Layout
  title="AI Espresso"
  description="Short operator notes on AI systems, GTM architecture, and what ships. Free. Under 3 minutes, every weekday morning."
  ogImage="/og/pages/subscribe.png"
  schema={schema}
  preloadImage="/images/wojciech-hero-warm.webp"
>
  <SubscribeContent />
</Layout>
