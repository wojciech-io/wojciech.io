---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Subscribe"
  description="Get weekly notes on AI systems, GTM architecture, and what I'm building — straight to your inbox."
  canonical="https://wojciech.io/subscribe"
>

  <!-- Hero section -->
  <section class="relative pt-24 pb-20 border-b border-[var(--color-border)] overflow-hidden">
    <!-- Grid bg -->
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-15" aria-hidden="true" />
    <!-- Glow -->
    <div class="pointer-events-none absolute -top-32 left-1/3 w-[500px] h-[400px] bg-[var(--color-accent-lo)]/15 blur-[120px] rounded-full" aria-hidden="true" />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">

        <!-- Left: hero copy -->
        <div class="animate-fade-up">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)]/25 bg-[var(--color-accent)]/8 px-3.5 py-1.5 text-xs font-semibold text-[var(--color-accent)] mb-6 tracking-wide uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse-dot inline-block"></span>
            Weekly newsletter
          </div>

          <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-6">
            Notes on what I <span class="text-[var(--color-accent)]">ship</span>
          </h1>

          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
            Weekly digest of AI systems I'm building, GTM experiments that worked (and those that didn't), and tools worth knowing about.
          </p>

          <!-- Pills -->
          <div class="flex flex-wrap gap-2">
            {['AI systems', 'GTM architecture', 'Build in public', 'Operator tools', 'What I shipped'].map((pill) => (
              <span class="rounded-full border border-[var(--color-border-2)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[var(--color-text-muted)]">{pill}</span>
            ))}
          </div>
        </div>

        <!-- Right: subscribe card -->
        <div class="animate-fade-up" style="animation-delay:120ms">
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8">
            <h2 class="text-lg font-semibold text-[var(--color-text)] mb-2">Get the notes</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-6">No spam. No filler. Unsubscribe anytime.</p>

            <form id="subscribe-form" class="space-y-4" novalidate>
              <div>
                <label for="sub-name" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Your name</label>
                <input
                  type="text"
                  id="sub-name"
                  name="name"
                  autocomplete="given-name"
                  placeholder="Jan"
                  class="w-full rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors"
                />
              </div>
              <div>
                <label for="sub-email" class="block text-xs font-medium text-[var(--color-text-muted)] mb-2">Email <span class="text-[var(--color-accent)]">*</span></label>
                <input
                  type="email"
                  id="sub-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="jan@example.com"
                  class="w-full rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] text-[var(--color-text)] text-sm px-4 py-2.5 placeholder:text-[var(--color-text-dim)] focus:outline-none focus:border-[var(--color-accent)]/60 focus:ring-1 focus:ring-[var(--color-accent)]/30 transition-colors"
                />
              </div>
              <button
                type="submit"
                id="sub-btn"
                class="btn-press w-full bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm"
              >
                Subscribe →
              </button>
              <p id="sub-status" class="text-xs text-center text-[var(--color-text-dim)] hidden"></p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Feature cards -->
  <section class="py-16 border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-3 gap-5 stagger">

        <!-- Card 1: AI systems -->
        <div class="card-lift rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 animate-fade-up">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/8 border border-[var(--color-accent)]/15 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2">AI systems</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Real builds — agents, workflows, operator tools. What worked, what broke, what I'd do differently.
          </p>
        </div>

        <!-- Card 2: GTM architecture -->
        <div class="card-lift rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 animate-fade-up">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/8 border border-[var(--color-accent)]/15 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2">GTM architecture</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Revenue systems, outbound models, growth loops. Structured thinking for operators building in the field.
          </p>
        </div>

        <!-- Card 3: Build in public -->
        <div class="card-lift rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 animate-fade-up">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/8 border border-[var(--color-accent)]/15 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2">Building in public</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Honest progress updates on apps, tools, and side projects — shipped fast, iterated openly.
          </p>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const status = document.getElementById('sub-status') as HTMLElement;
  const btn = document.getElementById('sub-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const emailInput = form.querySelector('#sub-email') as HTMLInputElement;
    if (!emailInput.value || !emailInput.validity.valid) {
      status.textContent = 'Please enter a valid email address.';
      status.className = 'text-xs text-center text-red-400 block';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Subscribing...';
    status.classList.add('hidden');

    try {
      const data = {
        email: emailInput.value.trim(),
        name: (form.querySelector('#sub-name') as HTMLInputElement)?.value?.trim() || '',
      };

      const res = await fetch('https://subscribe.wojciech.io/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        btn.textContent = 'Subscribed ✓';
        btn.classList.replace('bg-[var(--color-accent)]', 'bg-green-600');
        btn.classList.replace('hover:bg-[var(--color-accent-hi)]', 'hover:bg-green-500');
        status.textContent = "You're in. First issue lands next week.";
        status.className = 'text-xs text-center text-[var(--color-text-muted)] block';
      } else {
        const json = await res.json().catch(() => ({}));
        throw new Error((json as any)?.error || 'Failed');
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.textContent = 'Subscribe →';
      status.textContent = err?.message === 'Failed' ? 'Something went wrong. Try again.' : (err?.message || 'Something went wrong.');
      status.className = 'text-xs text-center text-red-400 block';
    }
  });
</script>
