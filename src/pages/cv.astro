---
// CV page — styled identically to wojciech.io
// Print to PDF: Cmd+P → Save as PDF, margins: None, background graphics: ON
import '../styles/global.css';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wojciech Łuszczyński — CV</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://wojciech.io/cv" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── tokens (inline for print isolation) ──────────────── */
    :root {
      --color-bg:        #0c0c0c;
      --color-surface:   #171717;
      --color-surface-2: #1e1e1e;
      --color-border:    #2a2a2a;
      --color-border-2:  #383838;
      --color-text:      #f0f0f0;
      --color-text-muted:#a0a0a0;
      --color-text-dim:  #5a5a5a;
      --color-accent:    #EBFF00;
      --color-accent-hi: #f5ff4d;
      --color-accent-lo: #2a2a2a;
      --font-sans:       'Geist', system-ui, sans-serif;
      --font-mono:       'Geist Mono', monospace;
      --radius-card:     12px;
    }

    /* ── base ──────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    /* ── layout ────────────────────────────────────────────── */
    .page {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 40px 64px;
    }

    /* ── header ────────────────────────────────────────────── */
    .cv-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 28px;
      align-items: center;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 36px;
    }
    @media (max-width: 720px) {
      .cv-header { grid-template-columns: 1fr; gap: 18px; }
      .cv-avatar { width: 88px; height: 88px; }
    }
    .cv-avatar {
      width: 112px; height: 112px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      background: var(--color-surface-2);
    }

    .cv-wordmark {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin-bottom: 6px;
    }
    .cv-wordmark span { color: var(--color-accent); }

    .cv-name {
      font-size: 36px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--color-text);
      margin-bottom: 10px;
    }

    .cv-tagline {
      font-size: 13px;
      color: var(--color-text-muted);
      font-weight: 400;
      letter-spacing: 0.03em;
    }

    .cv-contact {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-end;
      padding-top: 4px;
    }

    .cv-contact a, .cv-contact span {
      font-size: 12px;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      transition: color 0.15s;
    }
    .cv-contact a:hover { color: var(--color-accent-hi); }

    /* ── two-column body ───────────────────────────────────── */
    .cv-body {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 0 40px;
    }

    /* ── section label ─────────────────────────────────────── */
    .section-label {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
    }

    /* ── experience ────────────────────────────────────────── */
    .exp-section { margin-bottom: 32px; }

    .exp-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 0 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--color-border);
    }
    .exp-item:last-child { border-bottom: none; }

    .exp-period {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-text-dim);
      padding-top: 2px;
      line-height: 1.4;
    }
    .exp-period.contract { font-style: italic; color: var(--color-text-dim); }

    .exp-role {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 1px;
    }

    .exp-company {
      font-size: 11px;
      font-weight: 500;
      color: var(--color-accent);
      margin-bottom: 6px;
    }
    .exp-company.contract { color: var(--color-text-muted); }

    .exp-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .exp-bullets li {
      font-size: 12px;
      color: var(--color-text-muted);
      padding-left: 12px;
      position: relative;
      line-height: 1.5;
    }
    .exp-bullets li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-size: 10px;
      top: 1px;
    }

    /* ── sidebar ───────────────────────────────────────────── */
    .sidebar { }

    .sidebar-block { margin-bottom: 28px; }

    /* ── skills chips ──────────────────────────────────────── */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .chip {
      font-size: 10px;
      font-weight: 500;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid var(--color-border-2);
      background: var(--color-surface);
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
    }
    .chip.accent {
      border-color: var(--color-accent-lo);
      background: var(--color-accent-lo);
      color: var(--color-accent-hi);
    }

    /* ── education ─────────────────────────────────────────── */
    .edu-item { margin-bottom: 12px; }
    .edu-degree {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 1px;
    }
    .edu-school {
      font-size: 11px;
      color: var(--color-text-muted);
      margin-bottom: 1px;
    }
    .edu-year {
      font-size: 10px;
      font-family: var(--font-mono);
      color: var(--color-text-dim);
    }

    /* ── lang ──────────────────────────────────────────────── */
    .lang-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 12px;
    }
    .lang-item:last-child { border-bottom: none; }
    .lang-name { color: var(--color-text); font-weight: 500; }
    .lang-level { color: var(--color-text-dim); font-size: 11px; font-family: var(--font-mono); }

    /* ── certifications ────────────────────────────────────── */
    .cert-item {
      font-size: 11px;
      color: var(--color-text-muted);
      padding: 4px 0;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .cert-item:last-child { border-bottom: none; }
    .cert-issuer {
      font-size: 10px;
      color: var(--color-text-dim);
      font-family: var(--font-mono);
    }

    /* ── print ─────────────────────────────────────────────── */
    @media print {
      html, body { background: #0c0c0c !important; color: #f0f0f0 !important; }
      .page { padding: 24px 28px 40px; max-width: 100%; }
      .cv-name { font-size: 28px; }
      .exp-item { break-inside: avoid; }
      .sidebar-block { break-inside: avoid; }
    }

    /* ── screen-only print button ──────────────────────────── */
    .print-bar {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 100;
      display: flex;
      gap: 10px;
    }
    .print-btn {
      background: var(--color-accent);
      color: #0c0c0c;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      letter-spacing: -0.01em;
    }
    .print-btn:hover { background: var(--color-accent-hi); }
    @media print { .print-bar { display: none; } }
  </style>
</head>
<body>

<div class="page">

  <!-- ── Header ───────────────────────────────────────────── -->
  <header class="cv-header">
    <img class="cv-avatar" src="/images/wojciech-avatar-384.webp" srcset="/images/wojciech-avatar-384.webp 384w, /images/wojciech-avatar-768.webp 768w" sizes="112px" alt="Wojciech Łuszczyński" width="112" height="112" loading="eager" />
    <div>
      <p class="cv-wordmark">wojciech<span>.io</span> · <a href="https://app.wojciech.io" target="_blank" style="font-weight:400;opacity:0.55;font-size:0.72em;">interactive version</a></p>
      <h1 class="cv-name">Wojciech<br />Łuszczyński</h1>
      <p class="cv-tagline">Growth operator · GTM architect · AI-native builder</p>
    </div>
    <div class="cv-contact">
      <a href="mailto:hello@wojciech.io">hello@wojciech.io</a>
      <a href="tel:+48504498146">+48 504 498 146</a>
      <a href="https://wojciech.io" target="_blank">wojciech.io</a>
      <a href="https://www.linkedin.com/in/wojciech-luszczynski/" target="_blank">linkedin.com/in/wojciech-luszczynski</a>
      <span>Remote · Open to relocation</span>
    </div>
  </header>

  <!-- ── Body ─────────────────────────────────────────────── -->
  <div class="cv-body">

    <!-- ── Left: Experience ────────────────────────────────── -->
    <main>

      <div class="exp-section">
        <p class="section-label">Experience</p>

        <!-- WebWave -->
        <div class="exp-item">
          <span class="exp-period">2025 –<br />present</span>
          <div>
            <p class="exp-role">Head of Marketing</p>
            <p class="exp-company">WebWave / WeNet Group</p>
            <ul class="exp-bullets">
              <li>Leading global marketing and growth for an AI-powered no-code website builder</li>
              <li>GTM strategy, commercial messaging, and data-driven growth engine</li>
              <li>Full-funnel ownership: SEO, content, paid, automation, and lifecycle</li>
            </ul>
          </div>
        </div>

        <!-- Symfonia -->
        <div class="exp-item">
          <span class="exp-period">2024 –<br />2025</span>
          <div>
            <p class="exp-role">Head of Growth & Web Development</p>
            <p class="exp-company">Symfonia</p>
            <ul class="exp-bullets">
              <li>Increased organic traffic by 40% through SEO and technical improvements</li>
              <li>Increased lead generation by 30% with high-converting landing pages and A/B testing</li>
              <li>Grew blog traffic by 50% through automation-driven content strategies</li>
              <li>Optimised website speed by 25%, enhancing user experience and engagement</li>
              <li>Streamlined workflows integrating marketing, product, and web development</li>
            </ul>
          </div>
        </div>

        <!-- SentiOne -->
        <div class="exp-item">
          <span class="exp-period">2020 –<br />2024</span>
          <div>
            <p class="exp-role">Global Head of Growth</p>
            <p class="exp-company">SentiOne</p>
            <ul class="exp-bullets">
              <li>Built B2B SaaS GTM across Europe, UK, US, UAE, and LATAM</li>
              <li>50% surge in website traffic via SEO, redesign, and content strategy</li>
              <li>Accelerated customer acquisition by 80% using precision-targeted communications</li>
              <li>20% lift in sales leads through strategic collaboration with sales teams</li>
              <li>Amplified brand recognition by 60% through tailored global strategies</li>
            </ul>
          </div>
        </div>

        <!-- GetResponse -->
        <div class="exp-item">
          <span class="exp-period">2019 –<br />2020</span>
          <div>
            <p class="exp-role">Head of Lifecycle Marketing</p>
            <p class="exp-company">GetResponse</p>
            <ul class="exp-bullets">
              <li>Elevated customer engagement and revenue by 30% through CRM-led lifecycle marketing</li>
              <li>Implemented CRM for 25% conversion uplift via customer insights and segmentation</li>
              <li>Led A/B tests achieving a 20% increase in conversion rates</li>
              <li>Orchestrated global campaigns with successful market penetration in US, LATAM, EU</li>
            </ul>
          </div>
        </div>

        <!-- Contract block -->
        <div class="exp-item">
          <span class="exp-period contract">Contract</span>
          <div>
            <p class="exp-role">AI & Innovation Manager · Fractional CMO · Head of Marketing</p>
            <p class="exp-company contract">Gi Group Holding · Tekhuset · Lilla House Digital</p>
            <ul class="exp-bullets">
              <li>AI-driven workflow transformation and ATS unification at Gi Group (2k+ employees)</li>
              <li>AR / metaverse project exploration and action planning</li>
              <li>Growth, SEO, and A/B testing optimisation at Tekhuset</li>
              <li>Digital marketing and revenue campaigns at Lilla House Digital</li>
            </ul>
          </div>
        </div>

        <!-- Marquard -->
        <div class="exp-item">
          <span class="exp-period">2018 –<br />2019</span>
          <div>
            <p class="exp-role">Head of Digital</p>
            <p class="exp-company">Marquard Media Group</p>
            <ul class="exp-bullets">
              <li>Led digital strategy for 9 portals with a 21-person team across EU markets</li>
              <li>Launched a mobile app expanding B2C and B2B reach</li>
              <li>Optimised SEO, PPC, UX/UI, and conversion funnels</li>
              <li>Developed product roadmaps aligned with market trends</li>
            </ul>
          </div>
        </div>

        <!-- City of Łódź — Head of Mktg Comms -->
        <div class="exp-item">
          <span class="exp-period">2015 –<br />2018</span>
          <div>
            <p class="exp-role">Head of Marketing Communications</p>
            <p class="exp-company">City of Łódź Office</p>
            <ul class="exp-bullets">
              <li>Surpassed marketing communication goals by 25% within budget constraints</li>
              <li>Exceeded marketing targets by 30% through strategic planning and execution</li>
              <li>Secured 50+ media placements across broadcast, print, and digital channels</li>
              <li>15% rise in operational efficiency through team integration initiatives</li>
            </ul>
          </div>
        </div>

        <!-- City of Łódź — PR Manager -->
        <div class="exp-item">
          <span class="exp-period">2010 –<br />2015</span>
          <div>
            <p class="exp-role">PR Manager</p>
            <p class="exp-company">City of Łódź Office</p>
            <ul class="exp-bullets">
              <li>20% growth in social media audience through team leadership and brand strategy</li>
              <li>40% spike in media coverage through engaging content production</li>
              <li>95% adherence to PR campaign KPIs; 95% success rate in project execution</li>
              <li>Five strategic partnerships boosting brand and community engagement</li>
            </ul>
          </div>
        </div>

      </div>
    </main>

    <!-- ── Right: Sidebar ──────────────────────────────────── -->
    <aside class="sidebar">

      <!-- Key skills -->
      <div class="sidebar-block">
        <p class="section-label">Key skills</p>
        <div class="chips">
          {[
            'Revenue architecture',
            'GTM systems',
            'AI workflows',
            'B2B SaaS',
            'Growth strategy',
            'SEO',
            'CRO',
            'CRM',
            'Outbound',
            'Lifecycle marketing',
            'PPC',
            'UX / UI',
            'Data analysis',
            'Leadership',
            'Project management',
            'Brand management',
            'Media monitoring',
            'Crisis comms',
          ].map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>

      <!-- Tools -->
      <div class="sidebar-block">
        <p class="section-label">Tools & platforms</p>
        <div class="chips">
          {[
            'HubSpot', 'Salesforce', 'Klaviyo', 'Intercom',
            'GA4', 'Looker Studio', 'Mixpanel', 'Hotjar', 'VWO',
            'Ahrefs', 'SEMrush', 'Brand24', 'Brandwatch', 'Meltwater',
            'Google Ads', 'Figma', 'Notion', 'Jira', 'Zapier',
            'Claude', 'Jasper', 'Make',
          ].map((t) => <span class="chip">{t}</span>)}
        </div>
      </div>

      <!-- Education -->
      <div class="sidebar-block">
        <p class="section-label">Education</p>

        <div class="edu-item">
          <p class="edu-degree">Executive MBA</p>
          <p class="edu-school">Collegium Humanum</p>
          <p class="edu-year">2021</p>
        </div>

        <div class="edu-item">
          <p class="edu-degree">MSc Journalism & Social Comms</p>
          <p class="edu-school">University of Łódź</p>
          <p class="edu-year">2021 – 2022</p>
        </div>

        <div class="edu-item">
          <p class="edu-degree">Post-graduate — Public Relations</p>
          <p class="edu-school">Warsaw School of Economics</p>
          <p class="edu-year">2016 – 2017</p>
        </div>

        <div class="edu-item">
          <p class="edu-degree">BSc International Relations</p>
          <p class="edu-school">University of Łódź</p>
          <p class="edu-year">2007 – 2010</p>
        </div>
      </div>

      <!-- Languages -->
      <div class="sidebar-block">
        <p class="section-label">Languages</p>
        <div class="lang-item"><span class="lang-name">Polish</span><span class="lang-level">Native</span></div>
        <div class="lang-item"><span class="lang-name">English</span><span class="lang-level">Native</span></div>
        <div class="lang-item"><span class="lang-name">German</span><span class="lang-level">Basic</span></div>
        <div class="lang-item"><span class="lang-name">French</span><span class="lang-level">Basic</span></div>
      </div>

      <!-- Certifications -->
      <div class="sidebar-block">
        <p class="section-label">Certifications</p>
        {[
          ['GA4 Advanced Academy', 'Google'],
          ['Fundamentals of Digital Marketing', 'Google'],
          ['Growth-Driven Design Academy', 'HubSpot'],
          ['Inbound Marketing Academy', 'HubSpot'],
          ['Bing Ads Accredited Professional', 'Microsoft'],
          ['Advanced Growth Series', 'Reforge'],
          ['Content Marketing & SEO', 'SEMrush'],
          ['PPC Automation Academy', 'SEMrush'],
          ['Elements of AI Certificate', 'Univ. Helsinki'],
        ].map(([cert, issuer]) => (
          <div class="cert-item">
            <span>{cert}</span>
            <span class="cert-issuer">{issuer}</span>
          </div>
        ))}
      </div>

    </aside>
  </div>
</div>

<!-- Print button (screen only) -->
<div class="print-bar">
  <button class="print-btn" onclick="window.print()">Save as PDF →</button>
</div>

</body>
</html>
