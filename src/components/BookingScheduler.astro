---
// Shared scheduler island used by /meet (en) and /[locale]/meet (7 locales).
// Markup + styling are identical to the approved EN mockup; only the language
// layer is data-driven. Intl formats month/day/time/timezone from the page
// locale on the client; the ~30 chrome labels + meeting-type copy come from
// data/meet.ts. Availability + booking are served by /api/availability and
// /api/book (language-neutral: UTC + owner timezone).
import { MEETING_TYPES } from '../data/booking';
import { getMeetCopy } from '../data/meet';
import { localizedHome } from '../data/locales';
import type { SiteLocale } from '../data/locale-codes';

interface Props {
  lang: SiteLocale;
  /** Hide the built-in hero (eyebrow/H1/lead) when the host page has its own. */
  hideHero?: boolean;
}

const { lang, hideHero = false } = Astro.props;
const S = getMeetCopy(lang);

// BCP-47 tag for server-side Intl (weekday headers). Client Intl reads
// document.documentElement.lang, which Layout sets to this same value.
const bcp47 = lang === 'en' ? 'en' : localizedHome[lang].htmlLang;

// Localized meeting cards: ids/durations/featured stay in booking.ts; the
// display name + desc come from the locale copy table.
const meetingTypes = MEETING_TYPES.map((m) => ({
  id: m.id,
  minutes: m.minutes,
  featured: m.featured ?? false,
  name: S.types[m.id].name,
  desc: S.types[m.id].desc,
}));
const featured = meetingTypes.find((m) => m.featured) ?? meetingTypes[0];

// Monday-first short weekday names, localized (2024-01-01 was a Monday).
const weekdayFmt = new Intl.DateTimeFormat(bcp47, { weekday: 'short' });
const weekdays = Array.from({ length: 7 }, (_, i) => weekdayFmt.format(new Date(2024, 0, 1 + i)));

// Client-facing strings passed into the inline script via define:vars.
const clientStrings = {
  tzLabel: S.tzLabel,
  tzLocal: S.tzLocal,
  selectDay: S.selectDay,
  loading: S.loading,
  loadingAvail: S.loadingAvail,
  loadError: S.loadError,
  genericError: S.genericError,
  summaryEmpty: S.summaryEmpty,
  summaryPickTime: S.summaryPickTime,
  confirm: S.confirm,
  booking: S.booking,
};
const initial = { type: featured.id, minutes: featured.minutes, typeName: featured.name };
---

<section class="relative pt-10 pb-14 md:pt-14 md:pb-20 overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Hero (omitted when the host page supplies its own) -->
    {!hideHero && (
      <div class="max-w-2xl mb-10 md:mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{S.eyebrow}</span>
        </div>
        <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">
          {S.h1}
        </h1>
        <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
          {S.lead}
        </p>
      </div>
    )}
    <div id="reschedule-note" hidden
      class="max-w-2xl mb-8 rounded-[var(--radius-card)] border border-[var(--color-accent-cta)] bg-[var(--color-surface-2)] px-4 py-3 text-sm text-[var(--color-text)]">
      You're rescheduling an existing booking. Pick a new time and your old slot is freed automatically.
    </div>

    <!-- Step 1: meeting type -->
    <p class="obs-label-accent mb-3 block">1 · {S.step1}</p>
    <div class="grid gap-4 md:grid-cols-3 mb-10 md:mb-12" role="radiogroup" aria-label={S.step1}>
      {meetingTypes.map((m) => (
        <button
          type="button"
          role="radio"
          aria-checked={m.id === featured.id ? 'true' : 'false'}
          data-meeting={m.id}
          data-minutes={m.minutes}
          data-name={m.name}
          class="meeting-card group text-left rounded-[var(--radius-card)] border p-5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-cta)]"
        >
          <div class="flex items-center justify-between gap-3 mb-2">
            <span class="font-semibold text-[var(--color-text)]">{m.name}</span>
            <span class="shrink-0 rounded-full border border-[var(--color-border-2)] px-2.5 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">{m.minutes} min</span>
          </div>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{m.desc}</p>
        </button>
      ))}
    </div>

    <!-- Step 2 + 3: date/time + details -->
    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <!-- Calendar + slots -->
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 md:p-6">
        <div class="flex items-center justify-between gap-3 mb-5">
          <p class="obs-label-accent block">2 · {S.step2}</p>
          <label class="flex items-center gap-1.5 shrink-0" title={S.tzLabel}>
            <svg class="w-3.5 h-3.5 text-[var(--color-text-dim)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18" stroke-linecap="round"/>
            </svg>
            <span class="sr-only">{S.tzLabel}</span>
            <select id="tz-select"
              class="max-w-[150px] sm:max-w-[190px] truncate rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 font-mono text-xs text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent-cta)]"></select>
          </label>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <!-- Month grid -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <button type="button" id="cal-prev" aria-label="Previous month" class="cal-nav">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <span id="cal-month" class="text-sm font-semibold text-[var(--color-text)]"></span>
              <button type="button" id="cal-next" aria-label="Next month" class="cal-nav">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="grid grid-cols-7 gap-1 mb-1 text-center font-mono text-[10px] uppercase tracking-wider text-[var(--color-text-dim)]">
              {weekdays.map((w) => (<span>{w}</span>))}
            </div>
            <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>
          </div>

          <!-- Slots -->
          <div>
            <p id="slots-label" class="text-sm font-semibold text-[var(--color-text)] mb-3">{S.selectDay}</p>
            <div id="slots" class="flex flex-col gap-2 max-h-[280px] overflow-y-auto pr-1"></div>
          </div>
        </div>
      </div>

      <!-- Details / summary -->
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 md:p-6">
        <p class="obs-label-accent mb-4 block">3 · {S.step3}</p>

        <div id="summary" class="mb-5 rounded-[var(--radius-card)] border border-dashed border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-4 py-3 text-sm text-[var(--color-text-muted)]">
          {S.summaryEmpty}
        </div>

        <form id="book-form" class="flex flex-col gap-3" novalidate>
          <!-- Honeypot: hidden from humans, catches bots. -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-[var(--color-text-muted)]">{S.name}</span>
            <input required name="name" type="text" autocomplete="name" class="field" placeholder={S.namePh} />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-[var(--color-text-muted)]">{S.email}</span>
            <input required name="email" type="email" autocomplete="email" class="field" placeholder={S.emailPh} />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-[var(--color-text-muted)]">{S.company} <span class="text-[var(--color-text-dim)]">{S.optional}</span></span>
            <input name="company" type="text" autocomplete="organization" class="field" placeholder={S.companyPh} />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-[var(--color-text-muted)]">{S.notesQ} <span class="text-[var(--color-text-dim)]">{S.optional}</span></span>
            <textarea name="notes" rows="3" class="field resize-none" placeholder={S.notesPh}></textarea>
          </label>
          <p id="form-error" role="alert" hidden class="text-sm text-red-600 dark:text-red-400"></p>
          <button id="confirm-btn" type="submit" disabled
            class="mt-1 inline-flex items-center justify-center rounded-[var(--radius-card)] bg-[var(--color-accent-cta)] px-6 py-3 font-semibold text-[var(--color-accent-text)] transition-opacity disabled:opacity-40 disabled:cursor-not-allowed hover:opacity-90">
            {S.confirm}
          </button>
          <p class="text-center font-mono text-xs text-[var(--color-text-dim)]">
            {S.trust}
          </p>
        </form>

        <!-- Success state (hidden until confirmed) -->
        <div id="success" hidden class="text-center py-6">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-accent-cta)]">
            <svg class="w-6 h-6 text-[var(--color-accent-text)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12l5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <p class="text-lg font-semibold text-[var(--color-text)] mb-1">{S.successTitle}</p>
          <p id="success-detail" class="text-sm text-[var(--color-text-muted)]"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .meeting-card { background: var(--color-surface); border-color: var(--color-border); }
  .meeting-card:hover { border-color: var(--color-border-2); background: var(--color-surface-2); }
  .meeting-card[aria-checked='true'] {
    border-color: var(--color-accent-cta);
    box-shadow: inset 0 0 0 1px var(--color-accent-cta);
    background: var(--color-surface);
  }
  .cal-nav {
    display: inline-flex; align-items: center; justify-content: center;
    height: 2rem; width: 2rem; border-radius: 0.375rem;
    color: var(--color-text-muted); transition: background-color .15s, color .15s;
  }
  .cal-nav:hover:not(:disabled) { background: var(--color-surface-2); color: var(--color-text); }
  .cal-nav:disabled { opacity: 0.3; cursor: default; }
  .cal-day {
    aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center;
    border-radius: 0.375rem; font-size: 0.8125rem; font-variant-numeric: tabular-nums;
    color: var(--color-text); transition: background-color .12s, color .12s;
  }
  .cal-day[data-available='1'] { cursor: pointer; font-weight: 600; }
  .cal-day[data-available='1']:hover { background: var(--color-surface-2); }
  .cal-day[data-available='0'] { color: var(--color-text-dim); opacity: 0.45; }
  .cal-day[aria-selected='true'] { background: var(--color-accent-cta); color: var(--color-accent-text); font-weight: 700; }
  .slot {
    text-align: center; border: 1px solid var(--color-border);
    border-radius: 0.375rem; padding: 0.5rem 0.75rem; font-family: var(--font-mono, monospace);
    font-size: 0.8125rem; color: var(--color-text); cursor: pointer;
    transition: border-color .12s, background-color .12s;
  }
  .slot:hover { border-color: var(--color-accent-cta); }
  .slot[aria-selected='true'] { background: var(--color-accent-cta); color: var(--color-accent-text); border-color: var(--color-accent-cta); font-weight: 600; }
  .field {
    border: 1px solid var(--color-border); border-radius: 0.375rem;
    background: var(--color-bg); padding: 0.5rem 0.75rem; color: var(--color-text); font-size: 0.875rem;
  }
  .field:focus { outline: none; border-color: var(--color-accent-cta); }
  .field::placeholder { color: var(--color-text-dim); }
</style>

<script define:vars={{ S: clientStrings, INITIAL: initial }}>
  (() => {
    const FORM_LOADED = Date.now();
    const locale = document.documentElement.lang || 'en';
    const $ = (id) => document.getElementById(id);
    const pad = (n) => String(n).padStart(2, '0');

    // Intl does the i18n heavy lifting: month/day names + slot times localise to
    // the page locale and the visitor's own timezone with no translation table.
    let tz = 'UTC';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (_) {}
    // Month header + day header format wall dates (local Date objects), so they
    // stay timezone-neutral. Slot instants follow the chosen timezone below.
    const fmtMonth = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
    const fmtDay = new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric' });
    let fmtTime, fmtSummary, keyFmt;
    function buildTzFormatters() {
      fmtTime = new Intl.DateTimeFormat(locale, { timeZone: tz, hour: '2-digit', minute: '2-digit' });
      fmtSummary = new Intl.DateTimeFormat(locale, { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      keyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' });
    }
    buildTzFormatters();

    // Timezone picker: every slot is a UTC instant, so switching zone just
    // re-buckets and re-renders. Full IANA list where supported; short fallback.
    const tzSel = $('tz-select');
    let zones;
    try { zones = Intl.supportedValuesOf('timeZone'); } catch (_) {
      zones = ['UTC', 'Europe/Warsaw', 'Europe/London', 'Europe/Berlin', 'America/New_York', 'America/Chicago', 'America/Los_Angeles', 'America/Sao_Paulo', 'Asia/Dubai', 'Asia/Kolkata', 'Asia/Singapore', 'Asia/Tokyo', 'Australia/Sydney'];
    }
    if (!zones.includes(tz)) zones = [tz].concat(zones);
    tzSel.innerHTML = zones.map((z) => '<option value="' + z + '">' + z.replace(/_/g, ' ') + '</option>').join('');
    tzSel.value = tz;
    tzSel.addEventListener('change', () => { tz = tzSel.value; buildTzFormatters(); applyTz(); });

    // Reschedule mode: reached from the manage-booking link
    // (/meet/?reschedule=<id>&token=<token>). Booking then moves that booking
    // to the new slot instead of creating a fresh one.
    const _p = new URLSearchParams(location.search);
    const rescheduleId = _p.get('reschedule') || '';
    const rescheduleToken = _p.get('token') || '';
    const isReschedule = Boolean(rescheduleId && rescheduleToken);
    if (isReschedule) { const n = $('reschedule-note'); if (n) n.hidden = false; }

    const state = { type: INITIAL.type, minutes: INITIAL.minutes, typeName: INITIAL.typeName, dateKey: null, slotIso: null };
    const byDay = new Map(); // wall-date YYYY-MM-DD -> [utc iso, ...]
    let allSlots = []; // raw UTC ISO slots, kept so a timezone switch can re-bucket
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let view = new Date(today.getFullYear(), today.getMonth(), 1);

    // Calendar cells carry their own wall date; slots bucket by their wall date
    // in the chosen timezone. Both are YYYY-MM-DD strings, so they line up.
    const localKey = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const slotKey = (iso) => keyFmt.format(new Date(iso));

    function rebucket() {
      byDay.clear();
      for (const iso of allSlots) {
        const key = slotKey(iso);
        if (!byDay.has(key)) byDay.set(key, []);
        byDay.get(key).push(iso);
      }
    }
    // After a timezone change: re-bucket, drop the current selection, redraw.
    function applyTz() {
      rebucket();
      state.dateKey = null; state.slotIso = null;
      $('slots').innerHTML = '';
      $('slots-label').textContent = S.selectDay;
      renderCalendar();
      updateSummary();
    }

    async function loadAvailability() {
      byDay.clear(); state.dateKey = null; state.slotIso = null;
      $('slots-label').textContent = S.loading;
      $('slots').innerHTML = '<p class="text-sm text-[var(--color-text-dim)]">' + S.loadingAvail + '</p>';
      try {
        const res = await fetch('/api/availability?type=' + encodeURIComponent(state.type), {
          headers: { accept: 'application/json' },
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'unavailable');
        allSlots = data.slots || [];
        rebucket();
        // Open on the month of the first slot, in the chosen timezone.
        const firstKey = allSlots[0] ? slotKey(allSlots[0]) : null;
        if (firstKey) {
          const p = firstKey.split('-');
          view = new Date(Number(p[0]), Number(p[1]) - 1, 1);
        } else {
          view = new Date(today.getFullYear(), today.getMonth(), 1);
        }
        $('slots-label').textContent = S.selectDay;
        $('slots').innerHTML = '';
        renderCalendar();
      } catch (_) {
        $('slots-label').textContent = S.selectDay;
        $('slots').innerHTML = '<p class="text-sm text-[var(--color-text-dim)]">' + S.loadError + '</p>';
      }
      updateSummary();
    }

    function renderCalendar() {
      $('cal-month').textContent = fmtMonth.format(view);
      const grid = $('cal-grid');
      grid.innerHTML = '';
      const startPad = (new Date(view.getFullYear(), view.getMonth(), 1).getDay() + 6) % 7;
      const daysInMonth = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let i = 0; i < startPad; i++) grid.appendChild(document.createElement('span'));
      for (let day = 1; day <= daysInMonth; day++) {
        const d = new Date(view.getFullYear(), view.getMonth(), day);
        const key = localKey(d);
        const ok = byDay.has(key);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cal-day';
        cell.textContent = String(day);
        cell.dataset.available = ok ? '1' : '0';
        cell.dataset.key = key;
        if (!ok) cell.disabled = true;
        if (state.dateKey === key) cell.setAttribute('aria-selected', 'true');
        if (ok) cell.addEventListener('click', () => selectDay(d, key, cell));
        grid.appendChild(cell);
      }
      const atStart = view.getFullYear() === today.getFullYear() && view.getMonth() === today.getMonth();
      $('cal-prev').disabled = atStart;
    }

    function selectDay(d, key, cell) {
      state.dateKey = key; state.slotIso = null;
      document.querySelectorAll('.cal-day[aria-selected="true"]').forEach((c) => c.removeAttribute('aria-selected'));
      cell.setAttribute('aria-selected', 'true');
      $('slots-label').textContent = fmtDay.format(d);
      const wrap = $('slots');
      wrap.innerHTML = '';
      for (const iso of byDay.get(key) || []) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'slot'; b.dataset.iso = iso;
        b.textContent = fmtTime.format(new Date(iso));
        b.addEventListener('click', () => {
          state.slotIso = iso;
          document.querySelectorAll('.slot[aria-selected="true"]').forEach((s) => s.removeAttribute('aria-selected'));
          b.setAttribute('aria-selected', 'true');
          updateSummary();
        });
        wrap.appendChild(b);
      }
      updateSummary();
    }

    function updateSummary() {
      const el = $('summary');
      const btn = $('confirm-btn');
      if (state.slotIso) {
        el.innerHTML = '<span class="text-[var(--color-text)] font-semibold">' + state.typeName + '</span> · ' +
          state.minutes + ' min<br>' + fmtSummary.format(new Date(state.slotIso));
        btn.disabled = false;
      } else {
        el.textContent = state.dateKey ? S.summaryPickTime : S.summaryEmpty;
        btn.disabled = true;
      }
    }

    // Meeting type selection → reload availability for that duration.
    document.querySelectorAll('[data-meeting]').forEach((card) => {
      card.addEventListener('click', () => {
        document.querySelectorAll('[data-meeting]').forEach((c) => c.setAttribute('aria-checked', 'false'));
        card.setAttribute('aria-checked', 'true');
        state.type = card.dataset.meeting;
        state.minutes = Number(card.dataset.minutes);
        state.typeName = card.dataset.name;
        loadAvailability();
      });
    });

    $('cal-prev').addEventListener('click', () => { view.setMonth(view.getMonth() - 1); renderCalendar(); });
    $('cal-next').addEventListener('click', () => { view.setMonth(view.getMonth() + 1); renderCalendar(); });

    $('book-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('form-error'); err.hidden = true;
      if (!state.slotIso) return;
      const form = e.currentTarget;
      const btn = $('confirm-btn');
      btn.disabled = true; btn.textContent = S.booking;
      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            meetingType: state.type,
            start: state.slotIso,
            name: form.name.value,
            email: form.email.value,
            company: form.company.value,
            notes: form.notes.value,
            website: form.website.value,
            elapsed: Date.now() - FORM_LOADED,
            ...(isReschedule ? { rescheduleId, rescheduleToken } : {}),
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (res.status === 409) { await loadAvailability(); }
          throw new Error(data.error || S.genericError);
        }
        form.hidden = true;
        $('success').hidden = false;
        $('success-detail').innerHTML = state.typeName + ' · ' + state.minutes + ' min<br>' + fmtSummary.format(new Date(state.slotIso));
      } catch (ex) {
        err.textContent = ex.message; err.hidden = false;
        btn.disabled = false; btn.textContent = S.confirm;
      }
    });

    loadAvailability();
  })();
</script>
