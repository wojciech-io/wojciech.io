---
import { SITE } from '../../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Wojciech Łuszczyński, growth operator, GTM architect, AI-native builder.',
  canonical,
  ogImage = '/og-default.png',
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  schema,
} = Astro.props;

const siteTitle = SITE.nameDisplay;
// Shorter brand suffix keeps SERP titles closer to Google's ~60ch
// truncation point; the full author name still lives in og:site_name and
// the Person JSON-LD, so brand signal isn't lost.
const fullTitle = title ? `${title} · wojciech.io` : siteTitle;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

// --- hreflang + og:locale (trilingual: EN at root, PL/IT under /pl, /it) ----
// Only pages that exist in all three locales get alternates; EN-only pages
// (privacy, 404, insights) emit none. Paths keep the site's trailing slash.
const OG_LOCALE: Record<string, string> = { en: 'en_US', pl: 'pl_PL', it: 'it_IT' };
// Localized in all three locales. The insights INDEX is localized
// (/pl/insights/, /it/insights/); individual articles /insights/<slug>/ are
// EN-only, so they are intentionally absent here.
const LOCALIZED_PATHS = new Set([
  '/', '/about/', '/ai-systems/', '/apps/', '/contact/',
  '/cv/', '/now/', '/resources/', '/subscribe/', '/work/', '/insights/',
]);
const _seg = Astro.url.pathname.split('/').filter(Boolean);
const curLang = _seg[0] === 'pl' || _seg[0] === 'it' ? _seg[0] : 'en';
const _baseSeg = curLang === 'en' ? _seg : _seg.slice(1);
const basePath = _baseSeg.length ? `/${_baseSeg.join('/')}/` : '/';
const isLocalized = LOCALIZED_PATHS.has(basePath);
const altURL = (l: string) =>
  l === 'en' ? `${SITE.url}${basePath}` : `${SITE.url}/${l}${basePath}`;
const shouldNoindex = noindex || import.meta.env.PUBLIC_SITE_NOINDEX === 'true';
const publishedISO = publishedAt ? new Date(publishedAt).toISOString() : undefined;
const updatedISO = updatedAt ? new Date(updatedAt).toISOString() : undefined;
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Wojciech Łuszczyński',
    alternateName: 'Wojtek Luszczynski',
    url: SITE.url + '/',
    image: SITE.url + '/images/wojciech-avatar-384.webp',
    jobTitle: 'GTM Architect & Growth Operator',
    description: 'GTM Architect and Growth Operator building AI-native revenue systems for B2B SaaS. Connects marketing strategy, SEO, content, paid acquisition, CRM, automation and AI workflows into one operating model. Creator of Relora, Ads Assistant, Akademia AI, and the GTM Agent Starter Pack.',
    knowsAbout: [
      'Growth marketing',
      'GTM architecture',
      'Performance marketing',
      'Marketing automation',
      'AI-native revenue systems',
      'B2B SaaS growth',
      'Revenue operations',
      'CRM architecture',
      'Outbound automation',
      'Paid acquisition',
      'Analytics',
      'Brand communication',
      'AI agent workflows',
      'ICP scoring',
    ],
    sameAs: [
      SITE.linkedin,
      SITE.twitter.replace('twitter.com', 'x.com'),
      SITE.github,
      SITE.substack,
      SITE.medium,
      'https://app.wojciech.io',
    ],
    workExample: [
      { '@type': 'SoftwareApplication', name: 'NotchCue', url: SITE.notchUrl, applicationCategory: 'Productivity', operatingSystem: 'macOS' },
      { '@type': 'SoftwareApplication', name: 'Relora', applicationCategory: 'BusinessApplication' },
      { '@type': 'SoftwareApplication', name: 'Ads Assistant', applicationCategory: 'BusinessApplication' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteTitle,
    url: SITE.url + '/',
    author: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: SITE.url + '/' },
  },
];
const pageSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaItems = [...baseSchema, ...pageSchema];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

{isLocalized && (
  <>
    <link rel="alternate" hreflang="en" href={altURL('en')} />
    <link rel="alternate" hreflang="pl" href={altURL('pl')} />
    <link rel="alternate" hreflang="it" href={altURL('it')} />
    <link rel="alternate" hreflang="x-default" href={altURL('en')} />
  </>
)}

{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={OG_LOCALE[curLang]} />
{isLocalized && ['en', 'pl', 'it'].filter((l) => l !== curLang).map((l) => (
  <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
))}
<meta property="og:site_name" content={siteTitle} />
{publishedISO && <meta property="article:published_time" content={publishedISO} />}
{updatedISO && <meta property="article:modified_time" content={updatedISO} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

{
  schemaItems.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png?v=3" />
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />

<script is:inline>
  (() => {
    const root = document.documentElement;
    const stored = localStorage.getItem('theme');
    const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    const theme = stored === 'light' || stored === 'dark' ? stored : preferred;
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
  })();
</script>
