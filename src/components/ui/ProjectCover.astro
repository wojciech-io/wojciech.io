        <text x="158" y="101" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Council</text>
        <rect x="280" y="89" width="62" height="14" rx="2" fill="#22c55e" opacity="0.1"/>
        <text x="286" y="100" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#22c55e">Brief sent</text>
        <text x="376" y="101" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Warm</text>
        {/* Row 4 — Cold */}
        <rect x="0" y="114" width="460" height="26" rx="3" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <circle cx="12" cy="127" r="5" fill="#374151" opacity="0.7"/>
        <text x="24" y="131" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Patel, S.</text>
        <text x="158" y="131" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">Indirect</text>
        <rect x="280" y="119" width="40" height="14" rx="2" fill="#374151" opacity="0.7"/>
        <text x="286" y="130" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">Cold</text>
        <text x="376" y="131" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">Research</text>
        {/* Row 5 — skeleton */}
        <rect x="0" y="144" width="460" height="26" rx="3" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1" opacity="0.45"/>
        <rect x="6" y="153" width="72" height="8" rx="2" fill="#1a1a1a"/>
        <rect x="154" y="153" width="52" height="8" rx="2" fill="#1a1a1a"/>
        <rect x="277" y="153" width="44" height="8" rx="2" fill="#1a1a1a"/>
        {/* Footer */}
        <text x="0" y="186" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#374151">4 active contacts</text>
        <text x="126" y="186" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00"> · 2 need action</text>
        <text x="256" y="186" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#374151"> · 1 brief due</text>
      </svg>
    )}

    <!-- ── ADS-AI: terminal + ROAS bar chart ── -->
    {cover === 'ads-ai' && (
