---
export type ProjectCoverType = 'ads-ai' | 'gtm-pack' | 'notch' | 'kamperownia' | 'ai-adoption' | 'growth-system' | 'mini-apps' | 'relora';

interface Props {
  cover: ProjectCoverType;
}

const { cover } = Astro.props;

const tagLabel: Record<ProjectCoverType, string> = {
  relora:          'CRM-lite',
  'ads-ai':        'ads intelligence',
  notch:           'macOS app',
  kamperownia:     'booking flow',
  'gtm-pack':      'agent repo',
  'ai-adoption':   'AI adoption',
  'growth-system': 'GTM system',
  'mini-apps':     'product lab',
};

const caption: Record<ProjectCoverType, string> = {
  relora:          'contacts · relationships · briefs · next actions',
  'ads-ai':        'google ads · ROAS · ICP fit · operator decisions',
  notch:           'macOS · camera-line teleprompter · Swift',
  kamperownia:     'browse · select · book · self-serve',
  'gtm-pack':      'claude code · MCP tools · outbound at operator cost',
  'ai-adoption':   'AI workflow · adoption playbook',
  'growth-system': 'GTM architecture · revenue system',
  'mini-apps':     'product lab · shipped and running',
};
---

<div class="relative w-full h-full min-h-[140px] bg-[#0c0c0c] overflow-hidden" aria-hidden="true">
  <!-- Dot grid -->
  <div class="absolute inset-0 pointer-events-none [background-image:radial-gradient(circle,rgba(235,255,0,0.055)_1px,transparent_1px)] [background-size:24px_24px]" />
  <!-- Lime glow -->
  <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_25%_65%,rgba(235,255,0,0.065),transparent_55%)]" />

  <!-- Top-left brand mark -->
  <div class="absolute top-3.5 left-4 flex items-center gap-1.5 z-10">
    <span class="w-[5px] h-[5px] rounded-full bg-[#ebff00] shrink-0" />
    <span class="font-mono text-[9px] text-[#ebff00] tracking-[0.04em]">wojciech.io</span>
  </div>

  <!-- Product type tag -->
  <div class="absolute top-3.5 right-4 z-10">
    <span class="font-mono text-[9px] text-[#4b5563] border border-[rgba(75,85,99,0.25)] rounded-[3px] px-[5px] py-[2px] tracking-[0.03em]">
      {tagLabel[cover]}
    </span>
  </div>

  <!-- Centered SVG illustration -->
  <div class="absolute inset-0 flex items-center justify-center z-10 pt-7 pb-5 px-4">

    <!-- ── RELORA: CRM contact table ── -->
    {cover === 'relora' && (
      <svg viewBox="0 0 460 190" xmlns="http://www.w3.org/2000/svg" class="w-full max-h-full">
        {/* Column header */}
        <rect x="0" y="0" width="460" height="20" rx="3" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <text x="20" y="13" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151" font-weight="600" letter-spacing="0.08em">CONTACT</text>
        <text x="158" y="13" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151" font-weight="600" letter-spacing="0.08em">RELATIONSHIP</text>
        <text x="282" y="13" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151" font-weight="600" letter-spacing="0.08em">STATUS</text>
        <text x="376" y="13" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151" font-weight="600" letter-spacing="0.08em">NEXT</text>
        {/* Row 1 — Active */}
        <rect x="0" y="24" width="460" height="26" rx="3" fill="#111111" stroke="#1e1e1e" stroke-width="1"/>
        <circle cx="12" cy="37" r="5" fill="#EBFF00" opacity="0.85"/>
        <text x="24" y="41" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#e5e7eb">Davies, J.</text>
        <text x="158" y="41" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Direct owner</text>
        <rect x="280" y="29" width="54" height="14" rx="2" fill="#EBFF00" opacity="0.1"/>
        <text x="286" y="40" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">Active</text>
        <text x="376" y="41" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Brief call</text>
        {/* Row 2 — Follow-up */}
        <rect x="0" y="54" width="460" height="26" rx="3" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <circle cx="12" cy="67" r="5" fill="#6b7280" opacity="0.5"/>
        <text x="24" y="71" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#9ca3af">Wilson, C.</text>
        <text x="158" y="71" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Referred</text>
        <rect x="280" y="59" width="64" height="14" rx="2" fill="#f59e0b" opacity="0.1"/>
        <text x="286" y="70" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#f59e0b">Follow-up</text>
        <text x="376" y="71" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">Email</text>
        {/* Row 3 — Brief sent */}
        <rect x="0" y="84" width="460" height="26" rx="3" fill="#111111" stroke="#1e1e1e" stroke-width="1"/>
        <circle cx="12" cy="97" r="5" fill="#4b5563" opacity="0.6"/>
