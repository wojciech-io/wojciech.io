        <text x="357" y="46" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">7</text>
        <text x="380" y="46" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">8</text>
        {/* Week 2: 9–15 (selected) */}
        <rect x="237" y="50" width="18" height="14" rx="2" fill="#EBFF00" opacity="0.14"/>
        <text x="242" y="61" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">9</text>
        <rect x="260" y="50" width="18" height="14" rx="2" fill="#EBFF00" opacity="0.14"/>
        <text x="264" y="61" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">10</text>
        <rect x="283" y="50" width="18" height="14" rx="2" fill="#EBFF00" opacity="0.14"/>
