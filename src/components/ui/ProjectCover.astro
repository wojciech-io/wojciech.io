        {/* Form fields */}
        <rect x="8" y="122" width="202" height="16" rx="3" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <text x="14" y="133" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#4b5563">Check-in:</text>
        <text x="74" y="133" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#6b7280">Jun 9, 2025</text>
        <rect x="8" y="142" width="202" height="16" rx="3" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <text x="14" y="153" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#4b5563">Check-out:</text>
        <text x="78" y="153" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#6b7280">Jun 15, 2025</text>
        {/* CTA */}
        <rect x="8" y="163" width="202" height="20" rx="4" fill="#EBFF00" opacity="0.92"/>
        <text x="109" y="176" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#080d1a" font-weight="700">Reserve Now &#8594;</text>
