        <text x="14" y="40" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#9ca3af">$ ads-ai analyze --live</text>
        <text x="14" y="55" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">▸ Loading campaign data...</text>
        <text x="14" y="69" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#22c55e">✓ 18 campaigns synced</text>
        {/* Metrics block */}
        <text x="14" y="89" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">ROAS</text>
        <text x="55" y="89" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">4.2x</text>
        <text x="88" y="89" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#22c55e">&#8593; +8%</text>
        <text x="14" y="103" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">ICP fit</text>
        <text x="61" y="103" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">78%</text>
        <text x="90" y="103" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#6b7280">qualified</text>
        <text x="14" y="117" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">Spend</text>
        <text x="62" y="117" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#9ca3af">$1,240</text>
        {/* Alerts */}
        <text x="14" y="137" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#f59e0b">&#9888; 3 campaigns flagged</text>
        <text x="14" y="151" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#22c55e">&#10003; 2 paused · -$340</text>
        {/* Next action row */}
        <rect x="8" y="163" width="256" height="18" rx="3" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
        <text x="14" y="175" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">Next →</text>
        <text x="55" y="175" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">pause Generic · check Brand</text>
        {/* Right panel */}
        <rect x="282" y="0" width="178" height="190" rx="6" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <text x="371" y="17" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151" letter-spacing="0.08em">ROAS BY CAMPAIGN</text>
        <line x1="282" y1="22" x2="460" y2="22" stroke="#1a1a1a" stroke-width="1"/>
        {/* Bar: Brand 5.2x */}
        <text x="296" y="38" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#6b7280">Brand</text>
        <rect x="296" y="42" width="148" height="8" rx="2" fill="#1e1e1e"/>
        <rect x="296" y="42" width="148" height="8" rx="2" fill="#EBFF00" opacity="0.75"/>
        <text x="450" y="50" text-anchor="end" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#EBFF00">5.2x</text>
        {/* Bar: Retarget 4.8x */}
        <text x="296" y="66" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#6b7280">Retarget</text>
        <rect x="296" y="70" width="148" height="8" rx="2" fill="#1e1e1e"/>
        <rect x="296" y="70" width="136" height="8" rx="2" fill="#EBFF00" opacity="0.5"/>
        <text x="450" y="78" text-anchor="end" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#9ca3af">4.8x</text>
        {/* Bar: Competitor 3.1x */}
        <text x="296" y="94" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#4b5563">Competitor</text>
        <rect x="296" y="98" width="148" height="8" rx="2" fill="#1e1e1e"/>
        <rect x="296" y="98" width="88" height="8" rx="2" fill="#6b7280" opacity="0.45"/>
        <text x="450" y="106" text-anchor="end" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#4b5563">3.1x</text>
        {/* Bar: Generic 1.8x */}
        <text x="296" y="122" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#4b5563">Generic</text>
        <rect x="296" y="126" width="148" height="8" rx="2" fill="#1e1e1e"/>
        <rect x="296" y="126" width="50" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
        <text x="450" y="134" text-anchor="end" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#ef4444">1.8x</text>
        {/* Average */}
        <rect x="288" y="152" width="164" height="22" rx="3" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <text x="370" y="166" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#9ca3af">avg ROAS:&#160;</text>
        <text x="406" y="166" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#EBFF00">4.2x</text>
      </svg>
    )}

    <!-- ── KAMPEROWNIA: vehicle card + booking calendar ── -->
    {cover === 'kamperownia' && (
      <svg viewBox="0 0 460 190" xmlns="http://www.w3.org/2000/svg" class="w-full max-h-full">
        {/* Vehicle card */}
        <rect x="0" y="0" width="218" height="190" rx="6" fill="#111111" stroke="#2a2a2a" stroke-width="1"/>
        {/* Silhouette area */}
        <rect x="8" y="8" width="202" height="82" rx="4" fill="#0f0f0f"/>
        {/* Van body */}
        <rect x="22" y="22" width="162" height="44" rx="5" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
