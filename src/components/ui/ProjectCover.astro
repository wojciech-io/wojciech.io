        <text x="264" y="28" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151">Tu</text>
        <text x="287" y="28" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151">We</text>
        <text x="310" y="28" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151">Th</text>
        <text x="333" y="28" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151">Fr</text>
