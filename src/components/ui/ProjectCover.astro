        <text x="379" y="28" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="8" fill="#374151">Su</text>
        <line x1="232" y1="32" x2="456" y2="32" stroke="#1e1e1e" stroke-width="1"/>
        {/* Week 1: 2–8 */}
        <text x="242" y="46" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">2</text>
        <text x="265" y="46" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">3</text>
