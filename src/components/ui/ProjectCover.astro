        <rect x="0" y="0" width="272" height="24" rx="6" fill="#161616"/>
        <rect x="0" y="14" width="272" height="10" rx="0" fill="#161616"/>
        <circle cx="16" cy="12" r="4" fill="#ef4444" opacity="0.65"/>
        <circle cx="29" cy="12" r="4" fill="#f59e0b" opacity="0.65"/>
        <circle cx="42" cy="12" r="4" fill="#22c55e" opacity="0.65"/>
