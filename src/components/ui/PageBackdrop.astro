---
interface Props {
  src: string;
  position?: string;
  opacity?: number;
  eager?: boolean;
}

const {
  src,
  position = 'center',
  opacity = 0.1,
} = Astro.props;
---

<div
  class="absolute inset-0 hidden bg-cover bg-center saturate-[0.82] md:block"
  style={`background-image: url('${src}'); background-position: ${position}; opacity: ${opacity};`}
  aria-hidden="true"
/>
<div
  class="absolute inset-0 hidden bg-gradient-to-b from-[var(--color-bg)]/62 via-[var(--color-bg)]/84 to-[var(--color-bg)] md:block"
  aria-hidden="true"
/>
