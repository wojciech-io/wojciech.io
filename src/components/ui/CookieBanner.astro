---
// Analytics consent banner
// - Compact single-line design, slides up from the bottom
// - Stores choice in localStorage as 'cookie-consent' = 'accepted' | 'declined'
// - On accept: fires initAfterConsent() which initialises GA4 + PostHog
// - On decline: fires optOut() so PostHog stays in opt-out mode
// - Copy localized per current path (UI strings in src/data/uiStrings.ts)

import { getUiStringsForPath, getLocaleFromPath } from '../../data/uiStrings';

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
// /privacy/ exists in EN and AR only; other locales fall back to the EN page.
const privacyHref = getLocaleFromPath(pathname) === 'ar' ? '/ar/privacy/' : '/privacy/';
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-300 ease-out"
  role="dialog"
  aria-label="Analytics consent"
  aria-live="polite"
>
  <div class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-3 sm:flex-row sm:items-center sm:gap-6">

      <!-- Text -->
      <p class="flex-1 text-xs text-[var(--color-text-muted)] leading-relaxed">
        {t.cookie.bannerText}
        <a href={privacyHref} class="ml-1 text-[var(--color-accent)] hover:text-[var(--color-accent-hi)] underline underline-offset-2 whitespace-nowrap">{t.cookie.privacyPolicy}</a>
      </p>

      <!-- Actions -->
      <div class="flex shrink-0 items-center gap-2">
        <button
          id="cookie-decline"
          class="text-xs text-[var(--color-text-dim)] hover:text-[var(--color-text)] transition-colors px-3 py-1.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-surface-2)]"
        >
          {t.cookie.reject}
        </button>
        <button
          id="cookie-accept"
          class="btn-press text-xs font-semibold px-4 py-1.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          {t.cookie.accept}
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  const COOKIE_KEY = 'cookie-consent';
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const acceptBtn = document.getElementById('cookie-accept') as HTMLButtonElement;
  const declineBtn = document.getElementById('cookie-decline') as HTMLButtonElement;

  async function initAnalytics() {
    const { initAfterConsent } = await import('../../utils/analytics');
    initAfterConsent();
  }

  function hideBanner() {
    banner.classList.add('translate-y-full');
    banner.classList.remove('translate-y-0');
  }

  function showBanner() {
    // Small delay so it slides in after page has settled
    setTimeout(() => {
      banner.classList.remove('translate-y-full');
      banner.classList.add('translate-y-0');
    }, 1000);
  }

  const consent = localStorage.getItem(COOKIE_KEY);

  if (consent === 'accepted') {
    initAnalytics();
  } else if (!consent) {
    showBanner();
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'accepted');
    hideBanner();
    initAnalytics();
    window.dispatchEvent(new Event('analytics-consent-accepted'));
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'declined');
    hideBanner();
  });
</script>
