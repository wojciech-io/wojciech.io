---
// Cookie consent banner — stores choice in localStorage, shown once
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 hidden"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] px-5 py-4 shadow-[0_-4px_32px_0_rgb(0,0,0,0.4)]">
      <div class="flex items-start gap-3 flex-1">
        <svg class="w-5 h-5 text-[var(--color-accent)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
        </svg>
        <p class="text-sm text-[var(--color-text-muted)]">
          We use <span class="text-[var(--color-text)]">Cloudflare Analytics</span> to understand site usage — no tracking cookies, no profiling.
          <a href="/privacy" class="text-[var(--color-accent)] hover:text-[var(--color-accent-hi)] underline underline-offset-2 ml-1">Privacy policy</a>
        </p>
      </div>
      <div class="flex gap-2 shrink-0 w-full sm:w-auto">
        <button
          id="cookie-decline"
          class="flex-1 sm:flex-none text-xs font-medium px-4 py-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] text-[var(--color-text-muted)] hover:border-[var(--color-border)] hover:text-[var(--color-text)] transition-colors"
        >
          Decline
        </button>
        <button
          id="cookie-accept"
          class="btn-press flex-1 sm:flex-none text-xs font-semibold px-4 py-2 rounded-[var(--radius-btn)] bg-[var(--color-accent)] text-[var(--color-accent-text)] hover:bg-[var(--color-accent-hi)] transition-colors"
        >
          Accept
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const COOKIE_KEY = 'cookie-consent';
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const acceptBtn = document.getElementById('cookie-accept') as HTMLButtonElement;
  const declineBtn = document.getElementById('cookie-decline') as HTMLButtonElement;

  function hideBanner() {
    banner.classList.add('hidden');
  }

  function showBanner() {
    banner.classList.remove('hidden');
  }

  const consent = localStorage.getItem(COOKIE_KEY);
  if (!consent) {
    // Small delay so it doesn't flash immediately on load
    setTimeout(showBanner, 800);
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'accepted');
    hideBanner();
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'declined');
    hideBanner();
  });
</script>
