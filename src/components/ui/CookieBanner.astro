---
// Analytics consent banner
// - One ink bar at the bottom, centred on the max-w-6xl content grid (text left,
//   buttons right); bottom sheet on phones; reject and accept carry equal weight
// - Stores choice in localStorage as 'cookie-consent' = 'accepted' | 'declined'
// - On accept: fires initAfterConsent() which initialises GA4 + PostHog
// - On decline: fires optOut() so PostHog stays in opt-out mode
// - Copy localized per current path (UI strings in src/data/uiStrings.ts)

import { getUiStringsForPath, getLocaleFromPath } from '../../data/uiStrings';

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
// /privacy/ exists in EN and AR only; other locales fall back to the EN page.
const privacyHref = getLocaleFromPath(pathname) === 'ar' ? '/ar/privacy/' : '/privacy/';
---

<div
  id="cookie-banner"
  class="cookie-card pointer-events-none fixed inset-x-4 bottom-4 z-50 sm:inset-x-0 sm:bottom-6"
  data-state="hidden"
  role="dialog"
  aria-label="Analytics consent"
  aria-live="polite"
>
  <div class="mx-auto sm:max-w-6xl sm:px-6">
  <div class="pointer-events-auto relative flex flex-col gap-5 overflow-hidden rounded-[calc(var(--radius-card)*1.5)] border border-[var(--color-ink-border)] bg-[var(--color-ink)] p-5 text-[var(--color-ink-text)] shadow-[0_24px_60px_-20px_rgb(0_0_0_/_0.55)] sm:flex-row sm:items-center sm:gap-8 sm:px-6 sm:py-4">
    <div class="flex items-start gap-4 sm:flex-1 sm:items-center">
      <!-- The cover-art motif in miniature: three quiet bars and one that moved. -->
      <svg class="mt-1 h-9 w-9 shrink-0 sm:mt-0" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <rect x="3" y="14" width="5" height="19" rx="1.5" fill="currentColor" opacity=".28" />
        <rect x="11" y="10" width="5" height="23" rx="1.5" fill="currentColor" opacity=".28" />
        <rect x="19" y="16" width="5" height="17" rx="1.5" fill="currentColor" opacity=".28" />
        <rect x="27" y="3" width="5" height="30" rx="1.5" fill="var(--color-accent-cta)" />
      </svg>
      <p class="t-small text-[var(--color-ink-muted)]">
        {t.cookie.bannerText}{' '}<a href={privacyHref} class="whitespace-nowrap text-[var(--color-ink-text)] underline underline-offset-2 hover:text-[var(--color-accent-cta)]">{t.cookie.privacyPolicy}</a>
      </p>
    </div>
    <div class="grid grid-cols-2 gap-2 sm:flex sm:shrink-0">
      <button
        id="cookie-decline"
        class="t-button btn-press whitespace-nowrap rounded-[var(--radius-btn)] border border-[var(--color-ink-border)] px-2 py-3 sm:px-4 text-[var(--color-ink-text)] transition-colors hover:border-[var(--color-ink-text)]"
      >
        {t.cookie.reject}
      </button>
      <button
        id="cookie-accept"
        class="t-button btn-press whitespace-nowrap rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-2 py-3 sm:px-4 text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
      >
        {t.cookie.accept}
      </button>
    </div>
  </div>
  </div>
</div>

<style>
  .cookie-card {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s ease;
  }
  .cookie-card[data-state='hidden'] {
    transform: translateY(calc(100% + 2rem));
    opacity: 0;
    pointer-events: none;
  }
  .cookie-card[data-state='shown'] {
    transform: none;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-card { transition: none; }
  }
</style>

<script>
  const COOKIE_KEY = 'cookie-consent';
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const acceptBtn = document.getElementById('cookie-accept') as HTMLButtonElement;
  const declineBtn = document.getElementById('cookie-decline') as HTMLButtonElement;

  async function initAnalytics() {
    const { initAfterConsent } = await import('../../utils/analytics');
    initAfterConsent();
  }

  function hideBanner() {
    banner.dataset.state = 'hidden';
  }

  function showBanner() {
    // Small delay so it slides in after page has settled
    setTimeout(() => {
      banner.dataset.state = 'shown';
    }, 1000);
  }

  const consent = localStorage.getItem(COOKIE_KEY);

  if (consent === 'accepted') {
    initAnalytics();
  } else if (!consent) {
    showBanner();
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'accepted');
    hideBanner();
    initAnalytics();
    window.dispatchEvent(new Event('analytics-consent-accepted'));
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'declined');
    hideBanner();
  });
</script>
