---
interface Props {
  src?: string;
  alt?: string;
  size?: 'md' | 'lg' | 'xl';
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt = 'Wojciech Łuszczyński',
  size = 'lg',
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;

const sizes = {
  md: { className: 'w-24 h-24', pixels: 96 },
  lg: { className: 'w-36 h-36', pixels: 144 },
  xl: { className: 'w-48 h-48', pixels: 192 },
};

const sizeConfig = sizes[size];
const avatarSrcSet = src === '/images/wojciech.jpg'
  ? '/images/wojciech-avatar-2026-384.webp 384w, /images/wojciech-avatar-2026-768.webp 768w'
  : undefined;
---

<div class:list={['relative rounded-full shrink-0 p-[1.5px] [background:conic-gradient(from_135deg,#EBFF00_0%,#404040_40%,#2a2a2a_60%,#EBFF00_100%)] shadow-[0_0_28px_rgba(235,255,0,0.12)]', sizeConfig.className]}>
  <div class="rounded-full overflow-hidden w-full h-full bg-[var(--color-surface-2)]">
    {src ? (
      <img
        src={src}
        srcset={avatarSrcSet}
        sizes={`${sizeConfig.pixels}px`}
        width={sizeConfig.pixels}
        height={sizeConfig.pixels}
        alt={alt}
        class="w-full h-full object-cover"
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-[var(--color-surface-2)]">
        <span class="text-4xl font-bold text-[var(--color-accent)]">W</span>
      </div>
    )}
  </div>
</div>
