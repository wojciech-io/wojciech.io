---
interface Props {
  src?: string;
  alt?: string;
  size?: 'md' | 'lg' | 'xl';
}

const { src, alt = 'Wojciech Łuszczyński', size = 'lg' } = Astro.props;

const sizes = {
  md: 'w-24 h-24',
  lg: 'w-36 h-36',
  xl: 'w-48 h-48',
};
---

<div class:list={['relative rounded-full p-[3px] shrink-0', sizes[size]]}
     style="background: var(--color-accent);">
  <div class="rounded-full overflow-hidden w-full h-full bg-[var(--color-surface-2)]">
    {src ? (
      <img src={src} alt={alt} class="w-full h-full object-cover" loading="eager" />
    ) : (
      <!-- Placeholder until image is added to public/images/wojciech.jpg -->
      <div class="w-full h-full flex items-center justify-center bg-[var(--color-surface-2)]">
        <span class="text-4xl font-bold text-[var(--color-accent)]">W</span>
      </div>
    )}
  </div>
</div>
