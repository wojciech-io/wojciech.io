---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover: 'ads-ai' | 'gtm-pack' | 'notch' | 'kamperownia' | 'ai-adoption' | 'growth-system';
  external?: boolean;
}
const { title, description, tags, href, cover, external = false } = Astro.props;

// Common SVG constants
const G = '#EBFF00';
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="group flex flex-col rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40"
>
  <!-- Cover -->
  <div class="relative w-full aspect-video bg-[var(--color-surface-2)] overflow-hidden shrink-0">
    <!-- Dot grid -->
    <div
      class="pointer-events-none absolute inset-0"
      style={`background-image: radial-gradient(circle, #EBFF0018 1px, transparent 1px); background-size: 28px 28px;`}
      aria-hidden="true"
    />

    <!-- Per-project illustration -->
    {cover === 'ads-ai' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* Orbit ring */}
        <circle cx="240" cy="135" r="90" stroke={G} stroke-opacity="0.12" stroke-width="1" stroke-dasharray="4 8"/>
        {/* Inner ring */}
        <circle cx="240" cy="135" r="54" stroke={G} stroke-opacity="0.18" stroke-width="1" stroke-dasharray="2 6"/>
        {/* 4 orbit nodes */}
        <circle cx="240" cy="45" r="8" fill={G} fill-opacity="0.9"/>
        <circle cx="330" cy="135" r="8" fill={G} fill-opacity="0.6"/>
        <circle cx="240" cy="225" r="8" fill={G} fill-opacity="0.5"/>
        <circle cx="150" cy="135" r="8" fill={G} fill-opacity="0.7"/>
        {/* Connector spokes */}
        <line x1="240" y1="53" x2="240" y2="81" stroke={G} stroke-opacity="0.25" stroke-width="1"/>
        <line x1="322" y1="135" x2="294" y2="135" stroke={G} stroke-opacity="0.25" stroke-width="1"/>
        <line x1="240" y1="217" x2="240" y2="189" stroke={G} stroke-opacity="0.25" stroke-width="1"/>
        <line x1="158" y1="135" x2="186" y2="135" stroke={G} stroke-opacity="0.25" stroke-width="1"/>
        {/* Center: lightning/spark */}
        <polygon points="245,115 233,133 241,133 235,155 252,131 243,131" fill={G} fill-opacity="0.92"/>
        {/* Bar chart top-left */}
        <rect x="40" y="185" width="14" height="40" rx="2" fill={G} fill-opacity="0.08" stroke={G} stroke-width="0.75" stroke-opacity="0.3"/>
        <rect x="60" y="165" width="14" height="60" rx="2" fill={G} fill-opacity="0.12" stroke={G} stroke-width="0.75" stroke-opacity="0.4"/>
        <rect x="80" y="148" width="14" height="77" rx="2" fill={G} fill-opacity="0.18" stroke={G} stroke-width="0.75" stroke-opacity="0.5"/>
        <rect x="100" y="132" width="14" height="93" rx="2" fill={G} fill-opacity="0.22" stroke={G} stroke-width="1" stroke-opacity="0.65"/>
        {/* Ad card top-right */}
        <rect x="360" y="55" width="75" height="48" rx="4" fill={G} fill-opacity="0.05" stroke={G} stroke-width="0.75" stroke-opacity="0.35"/>
        <rect x="368" y="63" width="36" height="6" rx="3" fill={G} fill-opacity="0.35"/>
        <rect x="368" y="74" width="55" height="4" rx="2" fill={G} fill-opacity="0.18"/>
        <rect x="368" y="83" width="42" height="4" rx="2" fill={G} fill-opacity="0.15"/>
        {/* Small stars rating */}
        <circle cx="375" cy="160" r="3" fill={G} fill-opacity="0.6"/>
        <circle cx="385" cy="160" r="3" fill={G} fill-opacity="0.6"/>
        <circle cx="395" cy="160" r="3" fill={G} fill-opacity="0.6"/>
        <circle cx="405" cy="160" r="3" fill={G} fill-opacity="0.6"/>
        <circle cx="415" cy="160" r="3" fill={G} fill-opacity="0.3"/>
      </svg>
    )}

    {cover === 'gtm-pack' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* Terminal frame */}
        <rect x="40" y="60" width="165" height="150" rx="6" fill={G} fill-opacity="0.04" stroke={G} stroke-width="1" stroke-opacity="0.5"/>
        {/* Title bar */}
        <rect x="40" y="60" width="165" height="22" rx="6" fill={G} fill-opacity="0.1"/>
        <circle cx="56" cy="71" r="4" fill={G} fill-opacity="0.7"/>
        <circle cx="70" cy="71" r="4" fill={G} fill-opacity="0.4"/>
        <circle cx="84" cy="71" r="4" fill={G} fill-opacity="0.2"/>
        {/* Code lines */}
        <rect x="54" y="94" width="20" height="4" rx="2" fill={G} fill-opacity="0.5"/>
        <rect x="80" y="94" width="65" height="4" rx="2" fill={G} fill-opacity="0.25"/>
        <rect x="54" y="107" width="14" height="4" rx="2" fill={G} fill-opacity="0.4"/>
        <rect x="74" y="107" width="82" height="4" rx="2" fill={G} fill-opacity="0.2"/>
        <rect x="54" y="120" width="20" height="4" rx="2" fill={G} fill-opacity="0.35"/>
        <rect x="80" y="120" width="48" height="4" rx="2" fill={G} fill-opacity="0.18"/>
        <rect x="54" y="133" width="95" height="4" rx="2" fill={G} fill-opacity="0.22"/>
        <rect x="54" y="146" width="14" height="4" rx="2" fill={G} fill-opacity="0.5"/>
        <rect x="74" y="146" width="72" height="4" rx="2" fill={G} fill-opacity="0.2"/>
        {/* Cursor blink */}
        <rect x="54" y="163" width="8" height="12" rx="1" fill={G} fill-opacity="0.7"/>
        {/* Branch lines from terminal */}
        <line x1="205" y1="95" x2="270" y2="95" stroke={G} stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 5"/>
        <line x1="205" y1="135" x2="270" y2="135" stroke={G} stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 5"/>
        <line x1="205" y1="185" x2="270" y2="185" stroke={G} stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 5"/>
        <line x1="270" y1="95" x2="270" y2="185" stroke={G} stroke-opacity="0.2" stroke-width="1"/>
        {/* 3 agent nodes */}
        <rect x="275" y="77" width="120" height="36" rx="5" fill={G} fill-opacity="0.07" stroke={G} stroke-width="1" stroke-opacity="0.55"/>
        <circle cx="291" cy="95" r="7" fill={G} fill-opacity="0.2" stroke={G} stroke-width="0.75" stroke-opacity="0.5"/>
        <rect x="305" y="90" width="70" height="5" rx="2.5" fill={G} fill-opacity="0.4"/>
        <rect x="305" y="99" width="50" height="4" rx="2" fill={G} fill-opacity="0.2"/>
        <rect x="275" y="117" width="120" height="36" rx="5" fill={G} fill-opacity="0.07" stroke={G} stroke-width="1" stroke-opacity="0.55"/>
        <circle cx="291" cy="135" r="7" fill={G} fill-opacity="0.2" stroke={G} stroke-width="0.75" stroke-opacity="0.5"/>
        <rect x="305" y="130" width="55" height="5" rx="2.5" fill={G} fill-opacity="0.4"/>
        <rect x="305" y="139" width="80" height="4" rx="2" fill={G} fill-opacity="0.2"/>
        <rect x="275" y="167" width="120" height="36" rx="5" fill={G} fill-opacity="0.07" stroke={G} stroke-width="1" stroke-opacity="0.55"/>
        <circle cx="291" cy="185" r="7" fill={G} fill-opacity="0.2" stroke={G} stroke-width="0.75" stroke-opacity="0.5"/>
        <rect x="305" y="180" width="65" height="5" rx="2.5" fill={G} fill-opacity="0.4"/>
        <rect x="305" y="189" width="45" height="4" rx="2" fill={G} fill-opacity="0.2"/>
      </svg>
    )}

    {cover === 'notch' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* MacBook screen outer */}
        <rect x="80" y="30" width="320" height="200" rx="10" fill={G} fill-opacity="0.04" stroke={G} stroke-width="1" stroke-opacity="0.35"/>
        {/* Screen inner bezel */}
        <rect x="90" y="40" width="300" height="180" rx="7" fill={G} fill-opacity="0.06" stroke={G} stroke-width="0.75" stroke-opacity="0.2"/>
        {/* Notch pill */}
        <rect x="196" y="30" width="88" height="22" rx="11" fill="rgba(12,12,12,0.95)" stroke={G} stroke-width="1.5" stroke-opacity="0.8"/>
        {/* Notch glow */}
        <ellipse cx="240" cy="36" rx="44" ry="8" fill={G} fill-opacity="0.12"/>
        {/* Camera dot in notch */}
        <circle cx="240" cy="41" r="3" fill={G} fill-opacity="0.5"/>
        {/* Teleprompter lines */}
        <rect x="120" y="80" width="240" height="6" rx="3" fill={G} fill-opacity="0.35"/>
        <rect x="120" y="97" width="220" height="6" rx="3" fill={G} fill-opacity="0.28"/>
        <rect x="120" y="114" width="240" height="6" rx="3" fill={G} fill-opacity="0.35"/>
        <rect x="120" y="131" width="200" height="6" rx="3" fill={G} fill-opacity="0.25"/>
        <rect x="120" y="148" width="235" height="6" rx="3" fill={G} fill-opacity="0.32"/>
        <rect x="120" y="165" width="190" height="6" rx="3" fill={G} fill-opacity="0.22"/>
        {/* Progress indicator */}
        <rect x="120" y="192" width="240" height="3" rx="1.5" fill={G} fill-opacity="0.1"/>
        <rect x="120" y="192" width="96" height="3" rx="1.5" fill={G} fill-opacity="0.7"/>
        {/* Laptop base hint */}
        <rect x="60" y="230" width="360" height="6" rx="3" fill={G} fill-opacity="0.06" stroke={G} stroke-width="0.5" stroke-opacity="0.15"/>
      </svg>
    )}

    {cover === 'kamperownia' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* Calendar card */}
        <rect x="80" y="35" width="220" height="200" rx="8" fill={G} fill-opacity="0.04" stroke={G} stroke-width="1" stroke-opacity="0.4"/>
        {/* Calendar header */}
        <rect x="80" y="35" width="220" height="36" rx="8" fill={G} fill-opacity="0.1"/>
        <rect x="96" y="48" width="60" height="6" rx="3" fill={G} fill-opacity="0.6"/>
        {/* Nav arrows */}
        <path d="M258 53 l-8 0 M254 49 l-4 4 4 4" stroke={G} stroke-opacity="0.5" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M270 53 l8 0 M274 49 l4 4-4 4" stroke={G} stroke-opacity="0.5" stroke-width="1.5" stroke-linecap="round"/>
        {/* Day headers row */}
        {[0,1,2,3,4,5,6].map((i) => (
          <rect x={96 + i * 27} y="82" width="16" height="4" rx="2" fill={G} fill-opacity="0.25"/>
        ))}
        {/* Calendar grid: 5 rows × 7 cols */}
        {(() => {
          const booked = [2,5,9,10,16,17,23,28];
          const cells = [];
          for (let row = 0; row < 5; row++) {
            for (let col = 0; col < 7; col++) {
              const idx = row * 7 + col;
              const x = 96 + col * 27;
              const y = 97 + row * 26;
              const isBooked = booked.includes(idx);
              cells.push(
                isBooked
                  ? <rect x={x} y={y} width="16" height="16" rx="4" fill={G} fill-opacity="0.75"/>
                  : <rect x={x} y={y} width="16" height="16" rx="4" fill="none" stroke={G} stroke-opacity="0.2" stroke-width="0.75"/>
              );
            }
          }
          return cells;
        })()}
        {/* Booking card overlay */}
        <rect x="245" y="120" width="155" height="95" rx="8" fill="rgba(23,23,23,0.95)" stroke={G} stroke-width="1" stroke-opacity="0.55"/>
        <rect x="259" y="133" width="85" height="6" rx="3" fill={G} fill-opacity="0.5"/>
        <rect x="259" y="145" width="115" height="4" rx="2" fill={G} fill-opacity="0.2"/>
        <rect x="259" y="155" width="95" height="4" rx="2" fill={G} fill-opacity="0.18"/>
        <rect x="259" y="170" width="105" height="22" rx="5" fill={G} fill-opacity="0.85"/>
        <rect x="282" y="178" width="60" height="5" rx="2.5" fill="rgba(12,12,12,0.9)"/>
      </svg>
    )}

    {cover === 'ai-adoption' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* Central node */}
        <circle cx="240" cy="135" r="28" fill={G} fill-opacity="0.1" stroke={G} stroke-width="1.5" stroke-opacity="0.8"/>
        <circle cx="240" cy="135" r="18" fill={G} fill-opacity="0.15"/>
        <circle cx="240" cy="135" r="8" fill={G} fill-opacity="0.9"/>
        {/* 6 satellite positions: top, TR, BR, bot, BL, TL */}
        {[
          [240, 42],   // top
          [340, 80],   // TR
          [340, 190],  // BR
          [240, 228],  // bottom
          [140, 190],  // BL
          [140, 80],   // TL
        ].map(([cx, cy], i) => (
          <>
            <line x1="240" y1="135" x2={cx} y2={cy} stroke={G} stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 5"/>
            <circle cx={cx} cy={cy} r={12} fill={G} fill-opacity={0.06 + i * 0.01} stroke={G} stroke-width="1" stroke-opacity={0.35 + i * 0.05}/>
            <circle cx={cx} cy={cy} r={5} fill={G} fill-opacity={0.5 + i * 0.05}/>
          </>
        ))}
        {/* Secondary connections */}
        <line x1="340" y1="80" x2="340" y2="190" stroke={G} stroke-opacity="0.1" stroke-width="0.75" stroke-dasharray="2 8"/>
        <line x1="140" y1="80" x2="140" y2="190" stroke={G} stroke-opacity="0.1" stroke-width="0.75" stroke-dasharray="2 8"/>
        <line x1="240" y1="42" x2="340" y2="80" stroke={G} stroke-opacity="0.08" stroke-width="0.75" stroke-dasharray="2 8"/>
        <line x1="240" y1="228" x2="140" y2="190" stroke={G} stroke-opacity="0.08" stroke-width="0.75" stroke-dasharray="2 8"/>
        {/* Outer orbit */}
        <circle cx="240" cy="135" r="110" stroke={G} stroke-opacity="0.06" stroke-width="1" stroke-dasharray="1 12"/>
      </svg>
    )}

    {cover === 'growth-system' && (
      <svg viewBox="0 0 480 270" fill="none" class="absolute inset-0 w-full h-full" aria-hidden="true">
        {/* 5 pipeline stage bars */}
        {[
          { x: 55,  h: 55,  o: 0.08 },
          { x: 125, h: 85,  o: 0.11 },
          { x: 195, h: 118, o: 0.15 },
          { x: 265, h: 152, o: 0.19 },
          { x: 335, h: 185, o: 0.24 },
        ].map(({ x, h, o }) => (
          <rect x={x} y={220 - h} width="55" height={h} rx="4" fill={G} fill-opacity={o} stroke={G} stroke-width="1" stroke-opacity={o * 3.5}/>
        ))}
        {/* Trend line over bars */}
        <polyline
          points="82,162 152,132 222,99 292,65 362,32"
          stroke={G} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        />
        {/* Dots on trend line */}
        {[[82,162],[152,132],[222,99],[292,65],[362,32]].map(([cx,cy]) => (
          <circle cx={cx} cy={cy} r="5" fill={G} fill-opacity="0.85"/>
        ))}
        {/* Stage labels (small rectangles below) */}
        {[55,125,195,265,335].map((x) => (
          <rect x={x + 6} y="228" width="43" height="5" rx="2.5" fill={G} fill-opacity="0.2"/>
        ))}
        {/* Baseline */}
        <line x1="40" y1="220" x2="410" y2="220" stroke={G} stroke-opacity="0.15" stroke-width="0.75"/>
        {/* Top label bar */}
        <rect x="55" y="18" width="90" height="7" rx="3.5" fill={G} fill-opacity="0.35"/>
        <rect x="155" y="18" width="60" height="7" rx="3.5" fill={G} fill-opacity="0.2"/>
      </svg>
    )}

    <!-- Bottom gradient fade -->
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)] via-transparent to-transparent opacity-70" />
  </div>

  <!-- Card body -->
  <div class="p-5 flex-1 flex flex-col">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {tags.slice(0, 3).map((tag) => (
        <span class="text-[10px] font-medium px-2 py-0.5 rounded-full border border-[var(--color-border-2)] text-[var(--color-text-dim)]">{tag}</span>
      ))}
    </div>
    <!-- Title -->
    <h3 class="text-base font-semibold text-[var(--color-text)] leading-snug mb-2 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">
      {title}
    </h3>
    <!-- Description -->
    <p class="text-xs text-[var(--color-text-muted)] leading-relaxed flex-1 mb-4">{description}</p>
    <!-- CTA -->
    <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
      {external ? 'View project' : 'Explore'}
      <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
