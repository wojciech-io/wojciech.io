---
type CoverType = 'ads-ai' | 'gtm-pack' | 'notch' | 'kamperownia' | 'ai-adoption' | 'growth-system' | 'mini-apps' | 'relora';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover?: CoverType;
  screenshot?: string;
  problem?: string;
  system?: string;
  artifact?: string;
  outcome?: string;
  external?: boolean;
}

const {
  title,
  description,
  tags,
  href,
  cover = 'growth-system',
  screenshot,
  problem,
  system,
  artifact,
  outcome,
  external = false,
} = Astro.props;

const coverLabels: Record<CoverType, string> = {
  'ads-ai': 'Ads intelligence',
  'gtm-pack': 'Agent repo',
  notch: 'macOS app',
  kamperownia: 'Booking flow',
  'ai-adoption': 'AI adoption',
  'growth-system': 'GTM system',
  'mini-apps': 'Product lab',
  relora: 'Operating system',
};

const proof = [
  { label: 'Problem', value: problem },
  { label: 'System', value: system },
  { label: 'Artifact', value: artifact },
  { label: 'Outcome', value: outcome },
].filter((item) => item.value);
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="group flex min-h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-lift hover:border-[var(--color-accent)]/40"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-surface-2)]">
    {screenshot ? (
      <img
        src={screenshot}
        alt={`${title} product screenshot`}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.025]"
      />
    ) : (
      <div class="absolute inset-0">
        <div
          class="absolute inset-0 opacity-80"
          style="background-image: radial-gradient(circle, #EBFF0018 1px, transparent 1px); background-size: 28px 28px;"
          aria-hidden="true"
        />
        <div class="absolute left-7 top-7 flex h-16 w-16 items-center justify-center rounded-2xl border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/10">
          <span class="font-mono text-lg font-semibold text-[var(--color-accent)]">{title.charAt(0)}</span>
        </div>
      </div>
    )}

    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[var(--color-surface)] via-[var(--color-surface)]/60 to-transparent" aria-hidden="true"></div>

    <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-[rgb(12_12_12/0.72)] px-3 py-1.5 text-[11px] font-medium text-[var(--color-text)] backdrop-blur-md">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
      {coverLabels[cover]}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span class="rounded-full border border-[var(--color-border-2)] px-2 py-0.5 text-[10px] font-medium text-[var(--color-text-dim)]">{tag}</span>
      ))}
    </div>

    <h3 class="mb-2 text-base font-semibold leading-snug text-[var(--color-text)] transition-colors duration-150 group-hover:text-[var(--color-accent-hi)]">
      {title}
    </h3>

    <p class="mb-5 flex-1 text-xs leading-relaxed text-[var(--color-text-muted)]">{description}</p>

    {proof.length > 0 && (
      <dl class="mb-5 grid gap-3 border-t border-[var(--color-border)] pt-4">
        {proof.slice(0, 3).map(({ label, value }) => (
          <div class="grid grid-cols-[76px_1fr] gap-3">
            <dt class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">{label}</dt>
            <dd class="text-xs leading-snug text-[var(--color-text-muted)]">{value}</dd>
          </div>
        ))}
      </dl>
    )}

    <span class="mt-auto flex items-center gap-1 text-xs font-medium text-[var(--color-text-dim)] transition-colors duration-150 group-hover:text-[var(--color-accent)]">
      {external ? 'View project' : 'Explore'}
      <svg class="h-3 w-3 transition-transform duration-150 group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
