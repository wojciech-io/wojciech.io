---
import ProjectCover, { type ProjectCoverType } from './ProjectCover.astro';
import Icon from './Icon.astro';
type CoverType = ProjectCoverType;
type Cluster = 'ai-gtm' | 'growth-architecture' | 'products-shipped';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover?: CoverType;
  screenshot?: string;
  /** object-position for the screenshot crop; some covers frame a face near
      the top and get decapitated by the default centre crop. */
  screenshotPosition?: string;
  icon?: string;
  cluster?: Cluster;
  problem?: string;
  system?: string;
  /** First card in the first cluster: it is the LCP element on /work/, and
   *  lazy-loading it delayed the largest paint. Everything below the fold
   *  stays lazy. */
  priority?: boolean;
  artifact?: string;
  outcome?: string;
  external?: boolean;
  revealIndex?: number;
  labels?: {
    problem?: string;
    system?: string;
    artifact?: string;
    outcome?: string;
    viewProject?: string;
    explore?: string;
  };
}

const {
  title,
  description,
  tags,
  href,
  cover = 'growth-system',
  screenshot,
  screenshotPosition = 'object-center',
  problem,
  system,
  artifact,
  outcome,
  external = false,
  revealIndex,
  labels = {},
  priority = false,
} = Astro.props;

const proof = [
  { label: labels.problem ?? 'Problem', value: problem },
  { label: labels.system ?? 'System', value: system },
  { label: labels.artifact ?? 'Artifact', value: artifact },
  { label: labels.outcome ?? 'Outcome', value: outcome },
].filter((item) => item.value);

const ctaLabel = external ? (labels.viewProject ?? 'View project') : (labels.explore ?? 'Explore');

/* Measured on production rather than derived from the classes, because the
 * declared values were not what the page renders. At 375px the card is 297px
 * wide, which is 79vw and not the 92vw this used to claim: the difference is
 * exactly enough to push a phone from the 640px file up to the 960px one.
 * Above 1280px the grid produces two card widths, 322px and 510px, so the
 * larger is declared. The smaller cards then take one rung more than they
 * need, which is the safe direction: a browser picking a file up is invisible,
 * one picking a file down renders the card soft. */
const PROJECT_CARD_SIZES = '(max-width: 767px) 79vw, (max-width: 1279px) 46vw, 510px';
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...(revealIndex !== undefined ? { 'data-reveal-index': revealIndex } : {})}
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-hover',
    revealIndex !== undefined && 'reveal-scale',
  ]}
>
  <div class="artifact-stage relative aspect-[16/9] overflow-hidden p-3.5">
    <div class="absolute inset-3.5 overflow-hidden rounded-[14px] transition-transform duration-500 group-hover:scale-[1.012]">
      {screenshot
        ? <img src={screenshot} srcset={screenshot?.startsWith("/images/work/") ? `${screenshot.replace(/\.webp$/, "")}-640w.webp 640w, ${screenshot.replace(/\.webp$/, "")}-960w.webp 960w, ${screenshot} 1456w` : undefined} sizes={PROJECT_CARD_SIZES} alt="" width="1456" height="1088" loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} decoding="async" class:list={['h-full w-full object-cover', screenshotPosition]} />
        : <ProjectCover cover={cover} />}
    </div>
    {!screenshot && <div class="artifact-fade absolute inset-x-0 bottom-0 h-2/5" aria-hidden="true"></div>}
  </div>

  <div class="flex flex-1 flex-col p-5 pt-4">
    <div class="mb-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
      {tags.slice(0, 3).map((tag) => (
        <span class="t-label text-[var(--color-text-dim)] [&:not(:first-child)]:before:content-['·'] [&:not(:first-child)]:before:mr-2.5 [&:not(:first-child)]:before:text-[var(--color-border)]">{tag}</span>
      ))}
    </div>

    <h3 class="t-body mb-2 font-semibold text-[var(--color-text)] transition-colors duration-150 group-hover:text-[var(--color-accent-hi)]">
      {title}
    </h3>

    <p class="t-caption mb-5 line-clamp-3 text-[var(--color-text-muted)]">{description}</p>

    {proof.length > 0 && (
      <dl class="mb-5 grid gap-3 border-t border-[var(--color-border)] pt-4">
        {proof.slice(0, 3).map(({ label, value }) => (
          <div class="grid grid-cols-[76px_1fr] gap-3">
            <dt class="t-label text-[var(--color-text-dim)]">{label}</dt>
            <dd class="t-caption line-clamp-2 text-[var(--color-text-muted)]">{value}</dd>
          </div>
        ))}
      </dl>
    )}

    <span class="t-caption mt-auto flex items-center gap-1 text-[var(--color-text-dim)] transition-colors duration-150 group-hover:text-[var(--color-accent)]">
      {ctaLabel}
      <Icon name="arrow-right" class="h-3 w-3 transition-transform duration-150 group-hover:translate-x-1 rtl-flip-x" />
    </span>
  </div>
</a>
