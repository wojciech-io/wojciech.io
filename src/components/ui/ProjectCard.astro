---
import ProjectCover, { type ProjectCoverType } from './ProjectCover.astro';
type CoverType = ProjectCoverType;
type Cluster = 'ai-gtm' | 'growth-architecture' | 'products-shipped';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover?: CoverType;
  screenshot?: string;
  icon?: string;
  cluster?: Cluster;
  problem?: string;
  system?: string;
  artifact?: string;
  outcome?: string;
  external?: boolean;
  revealIndex?: number;
  labels?: {
    problem?: string;
    system?: string;
    artifact?: string;
    outcome?: string;
    viewProject?: string;
    explore?: string;
  };
}

const {
  title,
  description,
  tags,
  href,
  cover = 'growth-system',
  problem,
  system,
  artifact,
  outcome,
  external = false,
  revealIndex,
  labels = {},
} = Astro.props;

const proof = [
  { label: labels.problem ?? 'Problem', value: problem },
  { label: labels.system ?? 'System', value: system },
  { label: labels.artifact ?? 'Artifact', value: artifact },
  { label: labels.outcome ?? 'Outcome', value: outcome },
].filter((item) => item.value);

const ctaLabel = external ? (labels.viewProject ?? 'View project') : (labels.explore ?? 'Explore');
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...(revealIndex !== undefined ? { 'data-reveal-index': revealIndex } : {})}
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-hover',
    revealIndex !== undefined && 'reveal-scale',
  ]}
>
  <div class="artifact-stage relative aspect-[16/9] overflow-hidden p-3.5">
    <div class="absolute inset-3.5 overflow-hidden rounded-[14px] transition-transform duration-500 group-hover:scale-[1.012]">
      <ProjectCover cover={cover} />
    </div>
    <div class="artifact-fade absolute inset-x-0 bottom-0 h-2/5" aria-hidden="true"></div>
  </div>

  <div class="flex flex-1 flex-col p-5 pt-4">
    <div class="mb-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
      {tags.slice(0, 3).map((tag) => (
        <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-dim)] [&:not(:first-child)]:before:content-['·'] [&:not(:first-child)]:before:mr-2.5 [&:not(:first-child)]:before:text-[var(--color-border)]">{tag}</span>
      ))}
    </div>

    <h3 class="mb-2 text-base font-semibold leading-snug text-[var(--color-text)] transition-colors duration-150 group-hover:text-[var(--color-accent-hi)]">
      {title}
    </h3>

    <p class="mb-5 line-clamp-3 text-xs leading-relaxed text-[var(--color-text-muted)]">{description}</p>

    {proof.length > 0 && (
      <dl class="mb-5 grid gap-3 border-t border-[var(--color-border)] pt-4">
        {proof.slice(0, 3).map(({ label, value }) => (
          <div class="grid grid-cols-[76px_1fr] gap-3">
            <dt class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">{label}</dt>
            <dd class="line-clamp-2 text-xs leading-snug text-[var(--color-text-muted)]">{value}</dd>
          </div>
        ))}
      </dl>
    )}

    <span class="mt-auto flex items-center gap-1 text-xs font-medium text-[var(--color-text-dim)] transition-colors duration-150 group-hover:text-[var(--color-accent)]">
      {ctaLabel}
      <svg class="h-3 w-3 transition-transform duration-150 group-hover:translate-x-1 rtl-flip-x" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
