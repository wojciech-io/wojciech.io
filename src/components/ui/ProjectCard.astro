---
import ProjectCover, { type ProjectCoverType } from './ProjectCover.astro';
type CoverType = ProjectCoverType;
type Cluster = 'ai-gtm' | 'growth-architecture' | 'products-shipped';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover?: CoverType;
  screenshot?: string;
  icon?: string;
  cluster?: Cluster;
  problem?: string;
  system?: string;
  artifact?: string;
  outcome?: string;
  external?: boolean;
  revealIndex?: number;
}

const {
  title,
  description,
  tags,
  href,
  cover = 'growth-system',
  problem,
  system,
  artifact,
  outcome,
  external = false,
  revealIndex,
} = Astro.props;

const tagColor = (_tag: string) => 'obs-mono border-[var(--color-border)] bg-transparent text-[var(--color-text-dim)]';

const proof = [
  { label: 'Problem', value: problem },
  { label: 'System', value: system },
  { label: 'Artifact', value: artifact },
  { label: 'Outcome', value: outcome },
].filter((item) => item.value);
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...(revealIndex !== undefined ? { 'data-reveal-index': revealIndex } : {})}
  class:list={[
    'group flex h-full flex-col overflow-hidden obs-panel obs-glow card-lift',
    revealIndex !== undefined && 'reveal-up',
  ]}
>
  <div class="artifact-stage relative aspect-[16/9] overflow-hidden p-3.5">
    <div class="absolute inset-3.5 overflow-hidden rounded-[14px] transition-transform duration-500 group-hover:scale-[1.012]">
      <ProjectCover cover={cover} />
    </div>
    <div class="artifact-fade absolute inset-x-0 bottom-0 h-2/5" aria-hidden="true"></div>
  </div>

  <div class="flex flex-1 flex-col p-5 pt-4">
    <div class="mb-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span class={`rounded-full border px-2 py-0.5 text-xs font-medium ${tagColor(tag)}`}>{tag}</span>
      ))}
    </div>

    <h3 class="mb-2 text-base font-semibold leading-snug text-[var(--color-text)] transition-colors duration-150 group-hover:text-[var(--color-accent-hi)]">
      {title}
    </h3>

    <p class="mb-5 line-clamp-3 text-xs leading-relaxed text-[var(--color-text-muted)]">{description}</p>

    {proof.length > 0 && (
      <dl class="mb-5 grid gap-3 border-t border-[var(--color-border)] pt-4">
        {proof.slice(0, 3).map(({ label, value }) => (
          <div class="grid grid-cols-[76px_1fr] gap-3">
            <dt class="obs-label">{label}</dt>
            <dd class="line-clamp-2 text-xs leading-snug text-[var(--color-text-muted)]">{value}</dd>
          </div>
        ))}
      </dl>
    )}

    <span class="mt-auto flex items-center gap-1 text-xs font-medium text-[var(--color-text-dim)] transition-colors duration-150 group-hover:text-[var(--color-accent)]">
      {external ? 'View project' : 'Explore'}
      <svg class="h-3 w-3 transition-transform duration-150 group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
