---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
  linkedin?: string;
  avatar?: string;
}
interface Props {
  /** All testimonials, rendered as one continuous animated marquee. */
  items: Testimonial[];
}
const { items } = Astro.props;
// Duplicate the set so the track can loop seamlessly (translateX -50%).
const loop = [...items, ...items];
---

{items.length > 0 && (
  <div class="relative overflow-hidden" id="testimonial-ticker" aria-label="Testimonials">
    {/* Edge fades so cards dissolve in/out rather than hard-cutting at the rails */}
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 md:w-24 [background:linear-gradient(to_right,var(--color-surface),transparent)]"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 md:w-24 [background:linear-gradient(to_left,var(--color-surface),transparent)]"></div>

    <div class="testimonial-ticker-track flex gap-5" style="will-change: transform;">
      {loop.map((t) => (
        <figure class="shrink-0 w-[300px] sm:w-[340px] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg)] p-5 flex flex-col">
          <span class="[font-family:var(--font-sans)] text-3xl font-semibold leading-[0.4] text-[var(--color-accent)] mb-3 select-none" aria-hidden="true">&ldquo;</span>

          <blockquote class="text-sm text-[var(--color-text)] leading-relaxed mb-4 line-clamp-4">
            {t.quote}
          </blockquote>

          <figcaption class="flex items-center gap-3 mt-auto pt-4 border-t border-[var(--color-border)]">
            <a
              href={t.linkedin ?? undefined}
              target={t.linkedin ? '_blank' : undefined}
              rel={t.linkedin ? 'noopener noreferrer' : undefined}
              aria-label={t.linkedin ? `${t.name} on LinkedIn` : undefined}
              class:list={['w-8 h-8 rounded-[var(--radius-sm)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] flex items-center justify-center overflow-hidden shrink-0', t.linkedin && 'hover:border-[var(--color-text)] transition-colors']}
            >
              {t.avatar ? (
                <img src={t.avatar} alt={t.name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              ) : (
                <span class="font-mono text-xs font-semibold text-[var(--color-text-muted)]">{t.name.charAt(0)}</span>
              )}
            </a>
            <div class="min-w-0">
              {t.linkedin ? (
                <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="block truncate font-mono text-xs font-semibold uppercase tracking-[0.04em] text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">{t.name}</a>
              ) : (
                <p class="truncate font-mono text-xs font-semibold uppercase tracking-[0.04em] text-[var(--color-text)]">{t.name}</p>
              )}
              <p class="truncate font-mono text-[10px] uppercase tracking-[0.06em] text-[var(--color-text-dim)] mt-1">{t.role} · {t.company}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
)}

<style>
  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .testimonial-ticker-track {
    width: max-content;
    animation: ticker-scroll 60s linear infinite;
  }
  #testimonial-ticker:hover .testimonial-ticker-track,
  #testimonial-ticker:focus-within .testimonial-ticker-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonial-ticker-track {
      animation: none;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
