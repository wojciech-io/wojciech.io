---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
  linkedin?: string;
  avatar?: string;
}
interface Props {
  /** All testimonials, rendered as a contained masonry grid (no marquee, no
      edge-slicing). Cards sit fully inside the column — nothing is cut off. */
  items: Testimonial[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <div dir="ltr" aria-label="Testimonials" class="testimonial-masonry">
    {items.map((t) => (
      <figure dir="auto" class="testimonial-card break-inside-avoid rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg)] p-6 flex flex-col">
        <blockquote class="text-[15px] sm:text-base text-[var(--color-text)] leading-relaxed mb-5">
          &ldquo;{t.quote}&rdquo;
        </blockquote>

        <figcaption class="flex items-center justify-between gap-3 mt-auto pt-4 border-t border-[var(--color-border)]">
          <div class="min-w-0">
            <p class="truncate font-mono text-xs font-semibold uppercase tracking-[0.04em] text-[var(--color-text-muted)]">{t.name}</p>
            <p class="truncate font-mono text-[10px] uppercase tracking-[0.06em] text-[var(--color-text-dim)] mt-1">{t.role} · {t.company}</p>
          </div>
          {t.linkedin && (
            <a
              href={t.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t.name} on LinkedIn`}
              class="shrink-0 text-[var(--color-text-dim)] hover:text-[var(--color-accent)] transition-colors"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
        </figcaption>
      </figure>
    ))}
  </div>
)}

<style>
  /* Contained masonry: cards flow into 1/2/3 columns by viewport, each card
     fully visible with no slicing at the rails and no edge fade. Columns keep
     variable-height quote cards tight (no row-alignment gaps). */
  .testimonial-masonry {
    column-gap: 1.25rem;
    columns: 1;
  }
  @media (min-width: 640px) {
    .testimonial-masonry { columns: 2; }
  }
  @media (min-width: 1024px) {
    .testimonial-masonry { columns: 3; }
  }
  .testimonial-card {
    margin-bottom: 1.25rem;
    break-inside: avoid;
  }
</style>
