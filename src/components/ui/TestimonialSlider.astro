---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
---

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
  {testimonials.map((t) => (
    <figure class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 flex flex-col card-lift hover:border-[var(--color-accent)]/30">
      <!-- Decorative quote mark -->
      <svg
        class="w-7 h-7 text-[var(--color-accent)] mb-5 shrink-0 opacity-75"
        viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"
      >
        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
      </svg>

      <!-- Stars -->
      <div class="flex gap-0.5 mb-5" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-3.5 h-3.5 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
          </svg>
        ))}
      </div>

      <!-- Quote -->
      <blockquote class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6 flex-1 group-hover:text-[var(--color-text)] transition-colors duration-200">
        &ldquo;{t.quote}&rdquo;
      </blockquote>

      <!-- Author -->
      <figcaption class="flex items-center gap-3 pt-5 border-t border-[var(--color-border)]">
        <div class="w-9 h-9 rounded-full bg-[var(--color-accent)] flex items-center justify-center shrink-0">
          <span class="text-xs font-bold text-[var(--color-accent-text)]">{t.name.charAt(0)}</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
          <p class="text-xs text-[var(--color-text-dim)]">{t.role} · {t.company}</p>
        </div>
      </figcaption>
    </figure>
  ))}
</div>
