---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
  linkedin?: string;
  avatar?: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
---

<div class="relative w-full" id="testimonial-slider">

  <!-- Track wrapper -->
  <div class="testimonial-viewport overflow-hidden">
    <div
      class="testimonial-track flex gap-5 transition-transform duration-500 ease-out"
      style="will-change: transform;"
    >
      {testimonials.map((t) => (
        <figure class="testimonial-card shrink-0 w-[86%] sm:w-[64%] lg:w-[46%] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 flex flex-col">

          <!-- Stars -->
          <div class="flex gap-1 mb-5" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-3.5 h-3.5 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
              </svg>
            ))}
          </div>

          <blockquote class="text-sm md:text-base font-medium text-[var(--color-text)] leading-relaxed flex-1 mb-6">
            &ldquo;{t.quote}&rdquo;
          </blockquote>

          <figcaption class="flex items-center gap-3 mt-auto pt-5 border-t border-[var(--color-border)]">
            <div class="w-9 h-9 rounded-full bg-[var(--color-accent)] flex items-center justify-center overflow-hidden shrink-0">
              {t.avatar ? (
                <img src={t.avatar} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              ) : (
                <span class="text-xs font-bold text-[var(--color-accent-text)]">{t.name.charAt(0)}</span>
              )}
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <p class="truncate text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
                {t.linkedin && (
                  <a
                    href={t.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.name} on LinkedIn`}
                    class="grid h-5 w-5 shrink-0 place-items-center rounded-[var(--radius-sm)] border border-[var(--color-border)] text-[var(--color-text-dim)] transition-colors hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]"
                  >
                    <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
              <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{t.role} · {t.company}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <!-- Controls -->
  <div class="flex items-center justify-between mt-8 pt-6 border-t border-[var(--color-border)]">

    <!-- Dots -->
    <div class="flex gap-2" role="tablist" aria-label="Testimonials">
      {testimonials.map((_, i) => (
        <button
          class:list={[
            'testimonial-dot h-1 rounded-full transition-all duration-300',
            i === 0 ? 'w-6 bg-[var(--color-accent)]' : 'w-2 bg-[var(--color-border-2)]',
          ]}
          data-index={i}
          aria-label={`Testimonial ${i + 1}`}
          role="tab"
        />
      ))}
    </div>

    <!-- Arrows -->
    <div class="flex gap-2">
      <button id="testimonial-prev" aria-label="Previous" class="w-8 h-8 rounded-full border border-[var(--color-border-2)] flex items-center justify-center text-[var(--color-text-dim)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent)] transition-colors">
        <svg viewBox="0 0 16 16" fill="none" class="w-3.5 h-3.5" aria-hidden="true">
          <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button id="testimonial-next" aria-label="Next" class="w-8 h-8 rounded-full border border-[var(--color-border-2)] flex items-center justify-center text-[var(--color-text-dim)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent)] transition-colors">
        <svg viewBox="0 0 16 16" fill="none" class="w-3.5 h-3.5" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const slider = document.getElementById('testimonial-slider');
  if (slider) {
    const viewport = slider.querySelector<HTMLElement>('.testimonial-viewport')!;
    const track  = slider.querySelector<HTMLElement>('.testimonial-track')!;
    const cards  = Array.from(slider.querySelectorAll<HTMLElement>('.testimonial-card'));
    const dots   = Array.from(slider.querySelectorAll<HTMLButtonElement>('.testimonial-dot'));
    const prev   = document.getElementById('testimonial-prev');
    const next   = document.getElementById('testimonial-next');
    let current  = 0;
    let timer: ReturnType<typeof setInterval>;

    function getMaxIndex() {
      if (!cards.length) return 0;
      const card = cards[0];
      const gap = 20;
      const step = card.offsetWidth + gap;
      const maxOffset = Math.max(0, track.scrollWidth - viewport.offsetWidth);
      return Math.max(0, Math.ceil(maxOffset / step));
    }

    function slide(idx: number) {
      const max = getMaxIndex();
      current = Math.max(0, Math.min(idx, max));

      const card = cards[0];
      const gap = 20; // gap-5 = 20px
      const maxOffset = Math.max(0, track.scrollWidth - viewport.offsetWidth);
      const offset = Math.min(current * (card.offsetWidth + gap), maxOffset);
      track.style.transform = `translateX(-${offset}px)`;

      dots.forEach((d, i) => {
        d.hidden = i > max;
        const active = i === current;
        d.classList.toggle('w-6', active);
        d.classList.toggle('w-2', !active);
        d.classList.toggle('bg-[var(--color-accent)]', active);
        d.classList.toggle('bg-[var(--color-border-2)]', !active);
      });
    }

    function startTimer() {
      clearInterval(timer);
      timer = setInterval(() => {
        const max = getMaxIndex();
        slide(current >= max ? 0 : current + 1);
      }, 5000);
    }

    prev?.addEventListener('click', () => { slide(current - 1); startTimer(); });
    next?.addEventListener('click', () => { slide(current + 1); startTimer(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { slide(i); startTimer(); }));

    window.addEventListener('resize', () => slide(current));
    slide(0);
    startTimer();
  }
</script>
