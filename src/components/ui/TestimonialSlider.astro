---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
const [featured, ...rest] = testimonials;
---

<div class="grid md:grid-cols-2 gap-6 items-stretch">

  <!-- LEFT: large featured testimonial -->
  {featured && (
    <figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 md:p-10 flex flex-col">
      <!-- Stars -->
      <div class="flex gap-1 mb-6" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
          </svg>
        ))}
      </div>
      <!-- Large quote -->
      <blockquote class="text-xl md:text-2xl font-medium text-[var(--color-text)] leading-relaxed mb-8 flex-1">
        &ldquo;{featured.quote}&rdquo;
      </blockquote>
      <!-- Author -->
      <figcaption class="flex items-center gap-4 pt-6 border-t border-[var(--color-border)]">
        <div class="w-10 h-10 rounded-full bg-[var(--color-accent)] flex items-center justify-center shrink-0">
          <span class="text-sm font-bold text-[var(--color-accent-text)]">{featured.name.charAt(0)}</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)]">{featured.name}</p>
          <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{featured.role} · {featured.company}</p>
        </div>
      </figcaption>
    </figure>
  )}

  <!-- RIGHT: compact cards stack -->
  <div class="flex flex-col gap-5">
    {rest.map((t) => (
      <figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex-1">
        <!-- Author row at top -->
        <figcaption class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border-2)] flex items-center justify-center shrink-0">
            <span class="text-xs font-bold text-[var(--color-text-muted)]">{t.name.charAt(0)}</span>
          </div>
          <div>
            <p class="text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
            <p class="text-xs text-[var(--color-text-dim)]">{t.role} · {t.company}</p>
          </div>
          <!-- Stars pushed right -->
          <div class="flex gap-0.5 ml-auto" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-3 h-3 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
              </svg>
            ))}
          </div>
        </figcaption>
        <blockquote class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          &ldquo;{t.quote}&rdquo;
        </blockquote>
      </figure>
    ))}
  </div>

</div>
