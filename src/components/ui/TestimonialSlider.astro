---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
  linkedin?: string;
  avatar?: string;
}
interface Props {
  hero: Testimonial[];
  secondary: Testimonial[];
}
const { hero, secondary } = Astro.props;
---

<div class="space-y-10">

  {/* ── Hero: 3 prominent cards ── */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {hero.map((t, i) => (
      <figure
        class="reveal-up rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 flex flex-col h-full"
        {...(i === 0 ? { 'data-reveal-index': 1 } : {})}
      >
        <div class="flex gap-1 mb-5" role="img" aria-label="5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-3.5 h-3.5 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
            </svg>
          ))}
        </div>

        <blockquote class="text-sm md:text-base font-medium text-[var(--color-text)] leading-relaxed flex-1 mb-6">
          &ldquo;{t.quote}&rdquo;
        </blockquote>

        <figcaption class="flex items-center gap-3 mt-auto pt-5 border-t border-[var(--color-border)]">
          <a
            href={t.linkedin ?? undefined}
            target={t.linkedin ? '_blank' : undefined}
            rel={t.linkedin ? 'noopener noreferrer' : undefined}
            aria-label={t.linkedin ? `${t.name} on LinkedIn` : undefined}
            class:list={['w-9 h-9 rounded-full bg-[var(--color-accent)] flex items-center justify-center overflow-hidden shrink-0', t.linkedin && 'hover:opacity-80 transition-opacity']}
          >
            {t.avatar ? (
              <img src={t.avatar} alt={t.name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            ) : (
              <span class="text-xs font-bold text-[var(--color-accent-text)]">{t.name.charAt(0)}</span>
            )}
          </a>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              {t.linkedin ? (
                <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="truncate text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">{t.name}</a>
              ) : (
                <p class="truncate text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
              )}
              {t.linkedin && (
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.name} on LinkedIn`}
                  class="grid h-5 w-5 shrink-0 place-items-center rounded-[var(--radius-sm)] border border-[var(--color-border)] text-[var(--color-text-dim)] transition-colors hover:border-[var(--color-border-2)] hover:text-[var(--color-text)]"
                >
                  <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </div>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{t.role} · {t.company}</p>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>

  {/* ── Secondary: single-row auto-scrolling ticker ── */}
  {secondary.length > 0 && (
    <div class="relative overflow-hidden" id="testimonial-ticker" aria-label="More testimonials">
      <div class="testimonial-ticker-track flex gap-5" style="will-change: transform;">
        {/* Duplicate set for seamless loop */}
        {[...secondary, ...secondary].map((t) => (
          <figure class="shrink-0 w-[340px] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 flex flex-col">
            <blockquote class="text-sm font-medium text-[var(--color-text)] leading-relaxed flex-1 mb-4">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption class="flex items-center gap-3 pt-4 border-t border-[var(--color-border)]">
              <a
                href={t.linkedin ?? undefined}
                target={t.linkedin ? '_blank' : undefined}
                rel={t.linkedin ? 'noopener noreferrer' : undefined}
                aria-label={t.linkedin ? `${t.name} on LinkedIn` : undefined}
                class:list={['w-8 h-8 rounded-full bg-[var(--color-accent)] flex items-center justify-center overflow-hidden shrink-0', t.linkedin && 'hover:opacity-80 transition-opacity']}
              >
                {t.avatar ? (
                  <img src={t.avatar} alt={t.name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                ) : (
                  <span class="text-xs font-bold text-[var(--color-accent-text)]">{t.name.charAt(0)}</span>
                )}
              </a>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  {t.linkedin ? (
                    <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="truncate text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">{t.name}</a>
                  ) : (
                    <p class="truncate text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
                  )}
                </div>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{t.role} · {t.company}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .testimonial-ticker-track {
    animation: ticker-scroll 30s linear infinite;
  }
  #testimonial-ticker:hover .testimonial-ticker-track,
  #testimonial-ticker:focus-within .testimonial-ticker-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonial-ticker-track {
      animation: none;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
