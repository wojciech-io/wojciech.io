---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
const [featured, ...rest] = testimonials;
---

<div class="grid md:grid-cols-2 gap-6 items-start">

  <!-- Left: large featured testimonial -->
  {featured && (
    <figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 md:p-10 card-lift hover:border-[var(--color-border-2)] h-full flex flex-col">
      <!-- Stars -->
      <div class="flex gap-1 mb-6" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
          </svg>
        ))}
      </div>
      <!-- Quote -->
      <blockquote class="text-lg md:text-xl text-[var(--color-text)] leading-relaxed mb-8 flex-1">
        "{featured.quote}"
      </blockquote>
      <!-- Author -->
      <figcaption class="flex items-center gap-4 pt-6 border-t border-[var(--color-border)]">
        <div class="w-11 h-11 rounded-full bg-[var(--color-accent)] flex items-center justify-center shrink-0">
          <span class="text-sm font-bold text-[var(--color-accent-text)]">{featured.name.charAt(0)}</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)]">{featured.name}</p>
          <p class="text-xs text-[var(--color-text-muted)]">{featured.role} · {featured.company}</p>
        </div>
      </figcaption>
    </figure>
  )}

  <!-- Right: stacked smaller cards -->
  <div class="flex flex-col gap-6">
    {rest.map((t) => (
      <figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 card-lift hover:border-[var(--color-border-2)]">
        <div class="flex gap-1 mb-4" aria-label="5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-3.5 h-3.5 text-[var(--color-accent)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1l1.9 3.9L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1-3-2.9 4.1-.7L8 1z"/>
            </svg>
          ))}
        </div>
        <blockquote class="text-sm text-[var(--color-text)] leading-relaxed mb-5">
          "{t.quote}"
        </blockquote>
        <figcaption class="flex items-center gap-3 pt-4 border-t border-[var(--color-border)]">
          <div class="w-8 h-8 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border-2)] flex items-center justify-center shrink-0">
            <span class="text-xs font-bold text-[var(--color-text-muted)]">{t.name.charAt(0)}</span>
          </div>
          <div>
            <p class="text-xs font-semibold text-[var(--color-text)]">{t.name}</p>
            <p class="text-xs text-[var(--color-text-dim)]">{t.role} · {t.company}</p>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>

</div>
