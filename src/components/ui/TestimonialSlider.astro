---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
---

<div class="relative" id="testimonial-slider">
  <!-- Track -->
  <div
    id="slider-track"
    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-6 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    aria-live="polite"
  >
    {testimonials.map((t, i) => (
      <div
        class="snap-center shrink-0 w-full"
        role="group"
        aria-label={`Testimonial ${i + 1} of ${testimonials.length}`}
      >
        <figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 md:p-10 h-full card-lift hover:border-[var(--color-border-2)]">
          <svg class="w-8 h-8 text-[var(--color-accent)] mb-6 opacity-80" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
          </svg>
          <blockquote class="text-base md:text-lg text-[var(--color-text)] leading-relaxed mb-8 max-w-2xl">
            "{t.quote}"
          </blockquote>
          <figcaption class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-[var(--color-accent)] flex items-center justify-center shrink-0">
              <span class="text-sm font-bold text-[var(--color-accent-text)]">{t.name.charAt(0)}</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-text)]">{t.name}</p>
              <p class="text-xs text-[var(--color-text-muted)]">{t.role} · {t.company}</p>
            </div>
          </figcaption>
        </figure>
      </div>
    ))}
  </div>

  <!-- Controls -->
  <div class="flex items-center justify-between mt-8">
    <!-- Dots -->
    <div class="flex gap-2" id="slider-dots" role="tablist" aria-label="Testimonials">
      {testimonials.map((t, i) => (
        <button
          class="dot h-1.5 rounded-full transition-all duration-300 bg-[var(--color-border-2)] w-6 data-[active]:bg-[var(--color-accent)] data-[active]:w-8"
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`${t.name} testimonial`}
        />
      ))}
    </div>
    <!-- Prev / Next -->
    <div class="flex gap-2">
      <button
        id="slider-prev"
        aria-label="Previous testimonial"
        class="w-10 h-10 rounded-full border border-[var(--color-border-2)] bg-[var(--color-surface)] flex items-center justify-center text-[var(--color-text-muted)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent)] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        id="slider-next"
        aria-label="Next testimonial"
        class="w-10 h-10 rounded-full border border-[var(--color-border-2)] bg-[var(--color-surface)] flex items-center justify-center text-[var(--color-text-muted)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent)] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const track = document.getElementById('slider-track') as HTMLElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('#slider-dots .dot');
  const prevBtn = document.getElementById('slider-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('slider-next') as HTMLButtonElement;
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = Math.max(0, Math.min(index, total - 1));
    const slideWidth = track.scrollWidth / total;
    track.scrollTo({ left: slideWidth * current, behavior: 'smooth' });
    dots.forEach((d, i) => {
      d.dataset.active = i === current ? '' : undefined as any;
      if (i === current) d.removeAttribute('data-active');
      d.setAttribute('aria-selected', i === current ? 'true' : 'false');
    });
    dots[current].dataset.active = '';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === total - 1;
  }

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

  // Auto-advance every 6 seconds
  let timer = setInterval(() => goTo((current + 1) % total), 6000);
  track.addEventListener('pointerenter', () => clearInterval(timer));
  track.addEventListener('pointerleave', () => {
    timer = setInterval(() => goTo((current + 1) % total), 6000);
  });

  // Sync dots on manual scroll
  track.addEventListener('scrollend', () => {
    const slideWidth = track.scrollWidth / total;
    const idx = Math.round(track.scrollLeft / slideWidth);
    if (idx !== current) goTo(idx);
  });

  // Init
  goTo(0);
</script>
