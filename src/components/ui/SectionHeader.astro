---
interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  align?: 'left' | 'center';
  maxWidth?: string;
  class?: string;
}

const { eyebrow, heading, lead, align = 'left', maxWidth = 'max-w-2xl', class: className } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={[maxWidth, alignClass, className]}>
  {eyebrow && (
    <p class="obs-label-accent block mb-3">
      {eyebrow}
    </p>
  )}
  <h2 class="t-h2 text-[var(--color-text)]">
    {heading}
  </h2>
  {lead && (
    <p class="t-lead mt-4 text-[var(--color-text-muted)]">
      {lead}
    </p>
  )}
</div>
