---
interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  align?: 'left' | 'center';
  maxWidth?: string;
  class?: string;
}

const { eyebrow, heading, lead, align = 'left', maxWidth = 'max-w-2xl', class: className } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={[maxWidth, alignClass, className]}>
  {eyebrow && (
    <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">
      {eyebrow}
    </p>
  )}
  <h2 class="text-[length:var(--text-h2)] font-semibold text-[var(--color-text)] leading-tight tracking-tight">
    {heading}
  </h2>
  {lead && (
    <p class="mt-4 text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
      {lead}
    </p>
  )}
</div>
