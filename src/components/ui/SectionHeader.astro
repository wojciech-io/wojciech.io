---
interface Props {
  eyebrow?: string;
  eyebrowPl?: string;
  eyebrowIt?: string;
  heading: string;
  headingPl?: string;
  headingIt?: string;
  lead?: string;
  leadPl?: string;
  leadIt?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, eyebrowPl, eyebrowIt, heading, headingPl, headingIt, lead, leadPl, leadIt, align = 'left', class: className } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={['max-w-2xl', alignClass, className]}>
  {eyebrow && (
    <p data-en={eyebrow} data-pl={eyebrowPl ?? eyebrow} data-it={eyebrowIt ?? eyebrow} class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">
      {eyebrow}
    </p>
  )}
  <h2 data-en={heading} data-pl={headingPl ?? heading} data-it={headingIt ?? heading} class="text-3xl md:text-4xl font-semibold text-[var(--color-text)] leading-tight tracking-tight">
    {heading}
  </h2>
  {lead && (
    <p data-en={lead} data-pl={leadPl ?? lead} data-it={leadIt ?? lead} class="mt-4 text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
      {lead}
    </p>
  )}
</div>
