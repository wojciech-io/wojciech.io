---
interface Props {
  coverType?: 'terminal' | 'builder' | 'default';
  tags?: string[];
  title?: string;
}

const { coverType = 'default', tags = [], title = '' } = Astro.props;

const captions: Record<string, string> = {
  terminal: 'GTM agent · Claude Code · outbound at operator cost',
  builder: 'Astro · Cloudflare Pages · agentic deployment flow',
  default: 'wojciech.io · insights',
};
const caption = captions[coverType];
---

<div
  class="article-cover w-full relative overflow-hidden flex items-center justify-center bg-[#0c0c0c] min-h-[320px]"
  aria-hidden="true"
>
  <!-- Dot grid -->
  <div
    class="absolute inset-0 pointer-events-none [background-image:radial-gradient(circle,rgba(235,255,0,0.06)_1px,transparent_1px)] [background-size:28px_28px]"
  />
  <!-- Lime glow -->
  <div
    class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_20%_50%,rgba(235,255,0,0.07),transparent_60%)]"
  />

  <!-- Top-left brand mark -->
  <div class="absolute top-5 left-6 flex items-center gap-2 z-10">
    <span class="w-[7px] h-[7px] rounded-full bg-[#ebff00] inline-block shrink-0"></span>
    <span class="font-mono text-[11px] text-[#ebff00] tracking-[0.04em]">wojciech.io</span>
  </div>

  <!-- Top-right tags -->
  {tags.length > 0 && (
    <div class="absolute top-5 right-6 flex flex-wrap justify-end gap-1.5 z-10 max-w-[60%]">
      {tags.map((tag) => (
        <span class="font-mono text-[10px] text-[#6b7280] border border-[rgba(107,114,128,0.35)] rounded-[3px] px-[7px] py-[2px] tracking-[0.03em]">
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- SVG illustration (centered) -->
  <div class="relative z-10 w-full flex items-center justify-center px-4 md:px-8 max-w-[900px]">
    {coverType === 'terminal' && (
      <svg
        viewBox="0 0 760 300"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full max-h-[280px]"
        role="img"
        aria-label="GTM Agent terminal illustration"
      >
        <!-- Terminal window -->
        <rect x="10" y="10" width="455" height="280" rx="8" fill="#111111" stroke="#2a2a2a" stroke-width="1"/>
        <!-- Traffic lights -->
        <circle cx="32" cy="34" r="6" fill="#ef4444"/>
        <circle cx="52" cy="34" r="6" fill="#f59e0b"/>
        <circle cx="72" cy="34" r="6" fill="#22c55e"/>
        <!-- Terminal title -->
        <text x="240" y="38" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">gtm-agent — claude code</text>
        <!-- Divider -->
        <line x1="10" y1="52" x2="465" y2="52" stroke="#1e1e1e" stroke-width="1"/>
        <!-- Terminal content -->
        <text x="30" y="78" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#9ca3af">$ claude run outbound --target b2b-saas</text>
        <text x="30" y="102" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">▸ Loading operator identity (CLAUDE.md)...</text>
        <text x="30" y="122" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">▸ Reading ICP signal: icp-profile.md</text>
        <text x="30" y="142" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">▸ Fetching ICP signal, 340 prospects...</text>
        <text x="30" y="166" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#22c55e">✓ 18 high-fit leads enriched and scored</text>
        <text x="30" y="186" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#22c55e">✓ Sequences staged in HubSpot</text>
        <text x="30" y="216" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Cost:</text>
        <text x="60" y="216" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#EBFF00">$3.40</text>
        <text x="106" y="216" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">· Time:</text>
        <text x="160" y="216" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#9ca3af">4m 12s</text>

        <!-- VS separator -->
        <text x="497" y="155" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="13" fill="#374151" font-weight="bold">vs.</text>

        <!-- Clay comparison panel -->
        <rect x="520" y="10" width="230" height="280" rx="8" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <text x="635" y="38" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">Clay / tool stack</text>
        <line x1="520" y1="52" x2="750" y2="52" stroke="#1a1a1a" stroke-width="1"/>
        <text x="540" y="82" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Plan:</text>
        <text x="585" y="82" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">$300 / mo</text>
        <text x="540" y="106" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Setup:</text>
        <text x="592" y="106" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">manual</text>
        <text x="540" y="130" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Enrichment:</text>
        <text x="540" y="148" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">credit-based</text>
        <text x="540" y="176" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Flexibility:</text>
        <text x="540" y="194" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">workflow lock-in</text>
        <text x="540" y="222" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Operator memory:</text>
        <text x="540" y="240" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">none</text>
        <!-- Cost highlight -->
        <rect x="530" y="255" width="210" height="26" rx="4" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
        <text x="635" y="272" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">~100× more expensive per run</text>
      </svg>
    )}

    {coverType === 'builder' && (
      <svg
        viewBox="0 0 760 300"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full max-h-[280px]"
        role="img"
        aria-label="Astro Cloudflare deployment flow illustration"
      >
        <!-- Box 1: Codex / Claude Code -->
        <rect x="30" y="90" width="180" height="90" rx="6" fill="#111111" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="30" y="90" width="180" height="28" rx="6" fill="#161616"/>
        <rect x="30" y="108" width="180" height="10" rx="0" fill="#161616"/>
        <circle cx="52" cy="104" r="5" fill="#EBFF00" opacity="0.8"/>
        <text x="65" y="108" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#9ca3af">Codex / Claude Code</text>
        <text x="50" y="138" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#6b7280">ai code agent</text>
        <text x="50" y="156" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#4b5563">patch → commit</text>
        <text x="50" y="172" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#EBFF00">● active</text>

        <!-- Arrow 1 -->
        <line x1="212" y1="135" x2="270" y2="135" stroke="#EBFF00" stroke-width="1.5" stroke-dasharray="4 3"/>
        <polygon points="270,130 280,135 270,140" fill="#EBFF00"/>
        <text x="237" y="126" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">push</text>

        <!-- Box 2: GitHub main -->
        <rect x="282" y="90" width="180" height="90" rx="6" fill="#111111" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="282" y="90" width="180" height="28" rx="6" fill="#161616"/>
        <rect x="282" y="108" width="180" height="10" rx="0" fill="#161616"/>
        <circle cx="304" cy="104" r="5" fill="#6b7280" opacity="0.6"/>
        <text x="317" y="108" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#9ca3af">GitHub · main</text>
        <text x="302" y="138" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#6b7280">version control</text>
        <text x="302" y="156" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#4b5563">branch → PR → merge</text>
        <text x="302" y="172" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#6b7280">● trigger on merge</text>

        <!-- Arrow 2 -->
        <line x1="464" y1="135" x2="522" y2="135" stroke="#EBFF00" stroke-width="1.5" stroke-dasharray="4 3"/>
        <polygon points="522,130 532,135 522,140" fill="#EBFF00"/>
        <text x="490" y="126" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" fill="#4b5563">deploy</text>

        <!-- Box 3: Cloudflare Pages -->
        <rect x="534" y="90" width="196" height="90" rx="6" fill="#111111" stroke="#EBFF00" stroke-width="1" opacity="0.8"/>
        <rect x="534" y="90" width="196" height="28" rx="6" fill="#161616"/>
        <rect x="534" y="108" width="196" height="10" rx="0" fill="#161616"/>
        <circle cx="556" cy="104" r="5" fill="#EBFF00"/>
        <text x="569" y="108" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#EBFF00">Cloudflare Pages</text>
        <text x="554" y="138" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#6b7280">edge · global CDN</text>
        <text x="554" y="156" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#4b5563">static · fast · verified</text>
        <text x="554" y="172" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10" fill="#EBFF00">● live in ~30s</text>

        <!-- Live badge -->
        <rect x="228" y="222" width="304" height="36" rx="6" fill="#0f0f0f" stroke="#EBFF00" stroke-width="1" opacity="0.5"/>
        <circle cx="254" cy="240" r="5" fill="#22c55e"/>
        <text x="268" y="245" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#9ca3af">wojciech.io</text>
        <text x="348" y="245" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">·</text>
        <text x="362" y="245" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#6b7280">wojciech-io.pages.dev</text>

        <!-- Astro label -->
        <text x="380" y="52" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" fill="#4b5563">Astro SSG · zero JS by default · Tailwind CSS</text>
        <line x1="150" y1="62" x2="610" y2="62" stroke="#1e1e1e" stroke-width="1"/>
      </svg>
    )}

    {coverType === 'default' && (
      <svg
        viewBox="0 0 760 300"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full max-h-[280px]"
        role="img"
        aria-label="Abstract network diagram"
      >
        <!-- Network nodes -->
        <!-- Central node -->
        <circle cx="380" cy="150" r="18" fill="#0f0f0f" stroke="#EBFF00" stroke-width="1.5"/>
        <circle cx="380" cy="150" r="6" fill="#EBFF00"/>

        <!-- Outer nodes -->
        <circle cx="200" cy="80" r="12" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="200" cy="80" r="4" fill="#4b5563"/>

        <circle cx="560" cy="80" r="12" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="560" cy="80" r="4" fill="#4b5563"/>

        <circle cx="160" cy="200" r="12" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="160" cy="200" r="4" fill="#374151"/>

        <circle cx="600" cy="200" r="12" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="600" cy="200" r="4" fill="#374151"/>

        <circle cx="380" cy="50" r="10" fill="#0f0f0f" stroke="#EBFF00" stroke-width="1" opacity="0.5"/>
        <circle cx="380" cy="50" r="3" fill="#EBFF00" opacity="0.5"/>

        <circle cx="380" cy="250" r="10" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="380" cy="250" r="3" fill="#374151"/>

        <!-- Connections from center -->
        <line x1="380" y1="150" x2="200" y2="80" stroke="#EBFF00" stroke-width="1" opacity="0.3"/>
        <line x1="380" y1="150" x2="560" y2="80" stroke="#EBFF00" stroke-width="1" opacity="0.2"/>
        <line x1="380" y1="150" x2="160" y2="200" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="380" y1="150" x2="600" y2="200" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="380" y1="150" x2="380" y2="50" stroke="#EBFF00" stroke-width="1" opacity="0.4"/>
        <line x1="380" y1="150" x2="380" y2="250" stroke="#2a2a2a" stroke-width="1"/>

        <!-- Cross connections -->
        <line x1="200" y1="80" x2="380" y2="50" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="560" y1="80" x2="380" y2="50" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="160" y1="200" x2="380" y2="250" stroke="#1e1e1e" stroke-width="1"/>
        <line x1="600" y1="200" x2="380" y2="250" stroke="#1e1e1e" stroke-width="1"/>

        <!-- Small satellite nodes -->
        <circle cx="100" cy="130" r="7" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <circle cx="660" cy="130" r="7" fill="#0f0f0f" stroke="#1e1e1e" stroke-width="1"/>
        <line x1="100" y1="130" x2="160" y2="200" stroke="#1e1e1e" stroke-width="1"/>
        <line x1="660" y1="130" x2="600" y2="200" stroke="#1e1e1e" stroke-width="1"/>
        <line x1="100" y1="130" x2="200" y2="80" stroke="#1e1e1e" stroke-width="1"/>
        <line x1="660" y1="130" x2="560" y2="80" stroke="#1e1e1e" stroke-width="1"/>
      </svg>
    )}
  </div>

  <!-- Bottom-left caption -->
  <div class="absolute bottom-4 left-6 z-10">
    <span class="font-mono text-[10px] text-[#374151] tracking-[0.04em]">
      {caption}
    </span>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    .article-cover {
      min-height: 220px !important;
    }
  }
</style>
