---
import { getLocaleFromPath } from '../../data/uiStrings';
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const className = Astro.props.class ?? '';
const isAr = getLocaleFromPath(Astro.url.pathname) === 'ar';
---

<button
  type="button"
  class:list={[
    'theme-toggle btn-press relative inline-flex items-center rounded-[var(--radius-btn)] p-0',
    className,
  ]}
  data-theme-toggle
  aria-label={isAr ? 'تبديل المظهر الفاتح والداكن' : 'Toggle light and dark theme'}
  aria-pressed="false"
>
  <span class="theme-toggle__thumb" aria-hidden="true"></span>
  <span class="theme-toggle__label theme-toggle__label--light" aria-hidden="true">
    <Icon name="sun" class="h-3 w-3" />
  </span>
  <span class="theme-toggle__label theme-toggle__label--dark" aria-hidden="true">
    <Icon name="moon" class="h-3 w-3" />
  </span>
</button>

<script>
  const root = document.documentElement;
  const toggles = () => document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function setTheme(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    localStorage.setItem('theme', theme);
    toggles().forEach((toggle) => {
      toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
    });
  }

  const initial = root.dataset.theme === 'dark' ? 'dark' : 'light';
  toggles().forEach((toggle) => {
    toggle.setAttribute('aria-pressed', initial === 'dark' ? 'true' : 'false');
  });

  if (!root.dataset.themeToggleReady) {
    root.dataset.themeToggleReady = 'true';
    document.addEventListener('click', (event) => {
      const toggle = (event.target as HTMLElement).closest('[data-theme-toggle]');
      if (!toggle) return;
      setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  }
</script>
