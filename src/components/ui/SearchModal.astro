---
---

<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  class="fixed inset-0 z-[200] hidden items-start justify-center px-4 pt-[12vh]"
>
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-2xl overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg)] shadow-2xl">
    <!-- Header bar -->
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-4 py-3">
      <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Search</span>
      <div class="flex items-center gap-3">
        <kbd class="hidden sm:inline-flex items-center gap-1 rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-1.5 py-0.5 text-[10px] font-semibold text-[var(--color-text-dim)]">
          <span>esc</span>
        </kbd>
        <button
          id="search-close"
          aria-label="Close search"
          class="flex h-7 w-7 items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-text)]"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Loading state -->
    <div id="search-loading" class="hidden flex-col items-center justify-center gap-3 px-5 py-10">
      <div class="h-5 w-5 animate-spin rounded-full border-2 border-[var(--color-border-2)] border-t-[var(--color-accent)]"></div>
      <p class="text-xs text-[var(--color-text-dim)]">Loading search&hellip;</p>
    </div>

    <!-- Dev notice (build first) -->
    <p
      id="search-dev-note"
      class="hidden border-b border-[var(--color-border)] px-5 py-3 text-sm text-[var(--color-text-muted)]"
    >
      Search available after build. Run <code class="text-xs">npm run build</code> to index.
    </p>

    <!-- Error state (prod only) -->
    <p
      id="search-error"
      class="hidden px-5 py-6 text-sm text-[var(--color-text-muted)]"
    >
      Search index unavailable. Try refreshing the page.
    </p>

    <div id="pagefind-ui-root"></div>
  </div>
</div>

<script>
  let pagefindLoaded = false;
  let previousFocus: HTMLElement | null = null;

  function ensurePagefindStyles() {
    if (document.querySelector('link[href="/search/pagefind-ui.css"]')) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/search/pagefind-ui.css';
    document.head.append(link);
  }

  function showDevNotice() {
    document.getElementById('search-dev-note')?.classList.remove('hidden');
  }

  function showError() {
    document.getElementById('search-error')?.classList.remove('hidden');
  }

  function setLoading(on: boolean) {
    const el = document.getElementById('search-loading');
    if (!el) return;
    if (on) {
      el.classList.remove('hidden');
      el.classList.add('flex');
    } else {
      el.classList.add('hidden');
      el.classList.remove('flex');
    }
  }

  async function loadPagefind() {
    if (pagefindLoaded) return;
    pagefindLoaded = true;
    ensurePagefindStyles();
    setLoading(true);

    try {
      await new Promise<void>((resolve, reject) => {
        if (document.querySelector('script[data-pagefind-ui]')) { resolve(); return; }
        const s = document.createElement('script');
        s.src = '/search/pagefind-ui.js';
        s.dataset.pagefindUi = '1';
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('pagefind-ui.js failed to load'));
        document.head.appendChild(s);
      });
      const PagefindUI = (window as Window & { PagefindUI?: new (opts: Record<string, unknown>) => unknown }).PagefindUI;
      if (!PagefindUI) throw new Error('PagefindUI unavailable');
      new PagefindUI({
        element: '#pagefind-ui-root',
        bundlePath: '/search/',
        showSubResults: true,
        resetStyles: false,
      });
    } catch {
      pagefindLoaded = false;
      setLoading(false);
      if (window.location.hostname.includes('localhost')) {
        showDevNotice();
      } else {
        showError();
      }
      return;
    }

    setLoading(false);
  }

  // Returns all keyboard-focusable elements inside the modal panel (not backdrop).
  function focusableInModal(): HTMLElement[] {
    const panel = document.querySelector<HTMLElement>('#search-modal > div:not(#search-backdrop)');
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => el.offsetParent !== null); // visible only
  }

  function getSearchInput(): HTMLInputElement | null {
    return document.querySelector<HTMLInputElement>('#pagefind-ui-root input[type="text"]');
  }

  function getResultLinks(): HTMLAnchorElement[] {
    return Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#pagefind-ui-root a.pagefind-ui__result-link'),
    );
  }

  function handleModalKeydown(e: KeyboardEvent) {
    const modal = document.getElementById('search-modal');
    if (!modal || modal.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeSearch();
      return;
    }

    // Focus trap: Tab / Shift+Tab cycles within the modal panel.
    if (e.key === 'Tab') {
      const focusable = focusableInModal();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
      return;
    }

    // Arrow key navigation: Down moves from input → first result, then through results.
    // Up moves back up the list, from first result → input.
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      const input = getSearchInput();
      const results = getResultLinks();
      if (!results.length) return;

      const active = document.activeElement;
      const idx = results.indexOf(active as HTMLAnchorElement);

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (active === input || idx < 0) {
          results[0].focus();
        } else if (idx < results.length - 1) {
          results[idx + 1].focus();
        }
      } else {
        e.preventDefault();
        if (idx === 0) {
          input?.focus();
        } else if (idx > 0) {
          results[idx - 1].focus();
        }
      }
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;

    previousFocus = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    void loadPagefind().then(() => {
      const input = getSearchInput();
      input?.focus();
    });
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    previousFocus?.focus();
    previousFocus = null;
  }

  function wireHandlers() {
    document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);
    document.getElementById('search-close')?.addEventListener('click', closeSearch);
    // Modal-scoped keydown for focus trap + arrow nav (attached to document so it fires
    // regardless of which element inside the modal has focus).
    document.removeEventListener('keydown', handleModalKeydown);
    document.addEventListener('keydown', handleModalKeydown);
  }

  wireHandlers();

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      const modal = document.getElementById('search-modal');
      if (!modal) return;
      modal.classList.contains('hidden') ? openSearch() : closeSearch();
    }
  });

  (window as Window & { openSearch?: () => void }).openSearch = openSearch;

  document.addEventListener('astro:page-load', () => {
    wireHandlers();
    (window as Window & { openSearch?: () => void }).openSearch = openSearch;
  });
</script>
