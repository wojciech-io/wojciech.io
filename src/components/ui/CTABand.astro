---
import { accentHeading } from '../../lib/editorial';
interface Props {
  heading?: string;
  subtext?: string;
  cta?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  kicker?: string;
  // When set, renders a bottom/top-anchored portrait on the right (lg+ only).
  // Use a transparent cut-out so it blends into the panel; head stays anchored
  // to the top so it is never cropped.
  portrait?: string;
  portraitAlt?: string;
}
const {
  kicker = 'Next step',
  heading = 'Have a system worth fixing?',
  subtext = 'Send the context, the current bottleneck, and what already exists. I will tell you where I would start.',
  cta = 'Book a call',
  ctaHref = '/contact/#book-call',
  ctaSecondary = 'See the work',
  ctaSecondaryHref = '/work/',
  portrait,
  portraitAlt = 'Wojciech Łuszczyński',
} = Astro.props;
const ctaIsExternal = ctaHref.startsWith('http');
const secondaryIsExternal = ctaSecondaryHref.startsWith('http');
// Booking CTAs open the compact Cal.com popup in place; href stays as fallback.
const ctaIsBooking = ctaHref.includes('#book-call') || ctaHref.includes('cal.com');
const headingLines = heading.split('\n');
const hasPortrait = Boolean(portrait);
---

<section class="bg-[var(--color-bg)] py-14 md:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div
      class:list={[
        'relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-card)]',
        hasPortrait && 'lg:grid lg:grid-cols-[1fr_minmax(0,300px)] lg:items-stretch',
      ]}
    >
      <!-- On-brand glow: faint lime in light, near-invisible in dark. Behind content.
           radial-gradient instead of filter:blur — same look, no GPU paint cost. -->
      <div
        class="pointer-events-none absolute -left-32 -top-32 h-80 w-80 rounded-full opacity-70"
        style="background:radial-gradient(closest-side, var(--color-accent-lo), transparent 72%)"
        aria-hidden="true"
      >
      </div>

      <div class="relative px-6 py-10 md:px-10 md:py-12">
        <div class="flex items-center gap-3 mb-3">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{kicker}</span>
        </div>
        <h2 class="text-2xl font-normal leading-[1.12] tracking-[-0.015em] text-[var(--color-text)] md:text-3xl">
          {headingLines.map((line, index) => {
            const last = index === headingLines.length - 1;
            // On the last line, accent the terminal mark (locale-aware: . ? ! 。).
            // The accent span sits flush against the lead text (no inter-span
            // whitespace) so there is no gap before the mark, e.g. "...か。".
            const { lead, mark } = accentHeading(line);
            return last ? (
              <span class="text-[var(--color-text)]">{lead}<span class="text-[var(--color-accent-cta)]" aria-hidden="true">{mark}</span></span>
            ) : (
              <><span class="text-[var(--color-text)]">{line}</span><br /></>
            );
          })}
        </h2>

        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          {subtext}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={ctaHref}
            {...(ctaIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(ctaIsBooking ? { 'data-cal-link': 'wojciech-luszczynski/30min' } : {})}
            class="btn-press obs-mono inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
            data-mp-cta={cta}
            data-mp-location="cta_band"
          >
            <span>{cta}</span>
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href={ctaSecondaryHref}
            {...(secondaryIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="btn-press obs-mono inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-xs font-medium uppercase tracking-wider text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-text)] hover:text-[var(--color-text)]"
          >
            {ctaSecondary}
          </a>
        </div>
      </div>

      {hasPortrait && (
        <div
          class="relative hidden min-h-[300px] self-stretch bg-cover bg-[position:center_top] bg-no-repeat lg:block"
          style={`background-image:url('${portrait}')`}
          role="img"
          aria-label={portraitAlt}
        >
          <!-- Soft fade where the cut-out meets the panel floor. -->
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[var(--color-surface)] to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
      )}
    </div>
  </div>
</section>
