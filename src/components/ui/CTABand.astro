---
import { getLocaleFromPath } from '../../data/uiStrings';
import { personName } from '../../data/site';
import { accentHeading } from '../../lib/editorial';
import Icon from './Icon.astro';
import { CAL_BOOKING_LINK } from '../../data/site';
interface Props {
  heading?: string;
  subtext?: string;
  cta?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  kicker?: string;
  portraitCaption?: string;
}
const {
  kicker = 'Next step',
  portraitCaption = 'AI-native revenue operator',
  heading = 'Have a system worth fixing?',
  subtext = 'Send the context, the current bottleneck, and what already exists. I will tell you where I would start.',
  cta = 'Book a call',
  ctaHref = '/contact/',
  // Secondary (outline) is the soft ask: the newsletter, routed to the
  // dedicated /subscribe page. Booking stays the primary money CTA. This is
  // why the footer's inline signup band drops out under a CTA band — the
  // newsletter invite already lives here, in context, ranked below the call.
  ctaSecondary = 'Read AI Espresso',
  ctaSecondaryHref = '/subscribe/',
} = Astro.props;
const ctaIsExternal = ctaHref.startsWith('http');
const secondaryIsExternal = ctaSecondaryHref.startsWith('http');
// When this band's primary CTA is the booking ask (any locale's /contact/),
// open the Cal.com scheduler in place instead of making the visitor navigate.
// The href stays intact as the fallback for a blocked embed.
const ctaIsBooking = !ctaIsExternal && ctaHref.replace(/\/$/, '').endsWith('/contact');
const headingLines = heading.split('\n');
---

<section class="cta-band page-ask bg-[var(--color-bg)] py-14 md:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="cta-ink relative overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-ink)] text-[var(--color-ink-text)]">
      <div class="relative grid items-center gap-10 px-6 py-12 md:px-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
        <div class="max-w-2xl">
          <div class="mb-5 flex items-center gap-3">
            <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
            <span class="t-label text-[var(--color-accent-cta)]">{kicker}</span>
          </div>
          <h2 class="t-h2 text-[var(--color-ink-text)]">
            {headingLines.map((line, index) => {
              const last = index === headingLines.length - 1;
              // On the last line, accent the terminal mark (locale-aware: . ? ! 。),
              // flush against the text so there is no gap before it.
              const { lead, mark } = accentHeading(line);
              return last ? (
                <span>{lead}<span class="text-[var(--color-accent-cta)]" aria-hidden="true">{mark}</span></span>
              ) : (
                <><span>{line}</span><br /></>
              );
            })}
          </h2>
          <p class="t-lead mt-4 max-w-xl text-[var(--color-ink-muted)]">{subtext}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={ctaHref}
              {...(ctaIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(ctaIsBooking ? { 'data-cal-link': CAL_BOOKING_LINK } : {})}
              class="t-button btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3.5 text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
              data-mp-cta={cta}
              data-mp-location="cta_band"
            >
              <span>{cta}</span>
              <Icon name="arrow-right" class="rtl-flip-x h-[13px] w-[13px]" />
            </a>
            <a
              href={ctaSecondaryHref}
              {...(secondaryIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="t-button btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-ink-border)] px-6 py-3.5 text-[var(--color-ink-text)] transition-colors hover:border-[var(--color-ink-text)]"
            >
              {ctaSecondary}
            </a>
          </div>
        </div>

        <!-- Who picks up: a face next to the ask. Hidden below lg, where the
             band is already a full screen of text and buttons. -->
        <figure class="hidden lg:flex flex-col items-center gap-4 text-center">
          <img
            src="/images/wojciech-avatar-2026-384.webp"
            alt=""
            width="176"
            height="176"
            loading="lazy"
            decoding="async"
            class="h-44 w-44 rounded-full object-cover object-top ring-1 ring-[var(--color-ink-border)] outline outline-8 outline-[color-mix(in_srgb,var(--color-accent-cta)_14%,transparent)]"
          />
          <figcaption>
            <span class="t-small block font-semibold text-[var(--color-ink-text)]">{personName(getLocaleFromPath(Astro.url.pathname))}</span>
            <span class="t-label mt-1 block text-[var(--color-ink-muted)]">{portraitCaption}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

