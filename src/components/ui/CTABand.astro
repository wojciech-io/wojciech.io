---
interface Props {
  heading?: string;
  subtext?: string;
  cta?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
}
const {
  heading = 'Build a revenue system\nthat compounds.',
  subtext = 'Book a call or send a message. I respond within 24 hours.',
  cta = 'Book a call',
  ctaHref = 'https://cal.com/wojciech-luszczynski',
  ctaSecondary = 'See the work',
  ctaSecondaryHref = '/work',
} = Astro.props;
---

<section class="border-t border-[var(--color-border)] py-28 md:py-36 text-center relative overflow-hidden">
  <!-- Subtle accent glow — large, centered, very soft -->
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center"
    aria-hidden="true"
  >
    <div class="w-[600px] h-[300px] bg-[var(--color-accent-lo)]/8 blur-[120px] rounded-full"></div>
  </div>

  <div class="relative mx-auto max-w-3xl px-6">
    <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.06] tracking-tight mb-5">
      <span class="text-[var(--color-text)]">Build a revenue system</span><br />
      <span class="text-[var(--color-text-muted)]">that compounds.</span>
    </h2>

    <p class="text-base md:text-lg text-[var(--color-text-dim)] mb-10 max-w-sm mx-auto leading-relaxed">
      {subtext}
    </p>

    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-8 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm"
      >
        {cta}
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href={ctaSecondaryHref}
        class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text-muted)] font-medium px-8 py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-border)] hover:text-[var(--color-text)] transition-colors text-sm"
      >
        {ctaSecondary}
      </a>
    </div>
  </div>
</section>
