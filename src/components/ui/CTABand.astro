---
interface Props {
  heading?: string;
  subtext?: string;
  cta?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  kicker?: string;
}
const {
  kicker = '// Next step',
  heading = 'Have a system worth fixing?',
  subtext = 'Send the context, the current bottleneck, and what already exists. I will tell you where I would start.',
  cta = 'Book a call',
  ctaHref = '/contact/#book-call',
  ctaSecondary = 'See the work',
  ctaSecondaryHref = '/work/',
} = Astro.props;
const ctaIsExternal = ctaHref.startsWith('http');
const secondaryIsExternal = ctaSecondaryHref.startsWith('http');
const headingLines = heading.split('\n');
---

<section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
    <div class="max-w-2xl">
      <span class="obs-label-accent mb-3 block">{kicker}</span>
      <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
        {headingLines.map((line, index) => (
          <>
            <span class={index > 0 ? 'heading-accent' : ''}>{line}</span>
            {index < headingLines.length - 1 && <br />}
          </>
        ))}
      </h2>

      <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
        {subtext}
      </p>
    </div>

    <div class="flex flex-wrap gap-3 md:justify-end">
      <a
        href={ctaHref}
        {...(ctaIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        class="btn-press obs-mono inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
        data-mp-cta={cta}
        data-mp-location="cta_band"
      >
        <span>{cta}</span>
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href={ctaSecondaryHref}
        {...(secondaryIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        class="btn-press obs-mono inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-xs font-medium uppercase tracking-wider text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-text)] hover:text-[var(--color-text)]"
      >
        {ctaSecondary}
      </a>
    </div>
  </div>
</section>
