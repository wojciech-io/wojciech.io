---
interface Props {
  heading?: string;
  subtext?: string;
  cta?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
}
const {
  heading = 'Ready to build a revenue system that compounds?',
  subtext = 'Book a call or send a message. I respond within 24 hours.',
  cta = 'Book a call',
  ctaHref = 'https://cal.com/wojciech-luszczynski',
  ctaSecondary = 'See the work',
  ctaSecondaryHref = '/work',
} = Astro.props;
---

<section class="py-[var(--space-section)] border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-6">
    <div class="relative text-center rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] overflow-hidden px-8 py-20 md:py-28">

      <!-- Accent glow -->
      <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[420px] bg-[var(--color-accent-lo)]/18 blur-[130px] rounded-full" aria-hidden="true" />
      <!-- Grid pattern -->
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-10" aria-hidden="true" />
      <!-- Corner accents -->
      <div class="pointer-events-none absolute top-0 left-0 w-32 h-32 border-t-2 border-l-2 border-[var(--color-accent)]/20 rounded-tl-[var(--radius-card)]" aria-hidden="true" />
      <div class="pointer-events-none absolute bottom-0 right-0 w-32 h-32 border-b-2 border-r-2 border-[var(--color-accent)]/20 rounded-br-[var(--radius-card)]" aria-hidden="true" />

      <div class="relative">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)] mb-5">Let's build it</p>
        <h2 class="text-4xl md:text-6xl font-semibold text-[var(--color-text)] leading-[1.08] tracking-tight mb-6 max-w-3xl mx-auto">
          {heading}
        </h2>
        <p class="text-lg text-[var(--color-text-muted)] mb-10 max-w-md mx-auto leading-relaxed">
          {subtext}
        </p>
        <div class="flex flex-wrap gap-4 justify-center items-center">
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-8 py-4 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm"
          >
            {cta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href={ctaSecondaryHref}
            class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text)] font-medium px-8 py-4 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors text-sm"
          >
            {ctaSecondary}
          </a>
        </div>
        <p class="text-xs text-[var(--color-text-dim)] mt-6">No commitment. Responds within 24 hours.</p>
      </div>

    </div>
  </div>
</section>
