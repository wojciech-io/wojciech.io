---
interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  tags?: string[];
  metrics?: Metric[];
  href?: string;
  cluster?: string;
  featured?: boolean;
}

const { title, description, tags = [], metrics = [], href, featured = false } = Astro.props;
---

<div class:list={[
  'group relative rounded-[var(--radius-card)] border bg-[var(--color-surface)] p-8 transition-all duration-200',
  featured
    ? 'border-[var(--color-accent)]/30 hover:border-[var(--color-accent)]/60'
    : 'border-[var(--color-border)] hover:border-[var(--color-border-2)]',
  'hover:shadow-[var(--shadow-card-hover)]',
]}>

  {/* Tags */}
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-5">
      {tags.map((tag) => (
        <span class="inline-flex items-center text-xs font-medium px-3 py-1 rounded-[var(--radius-badge)] border border-[var(--color-border-2)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">
          {tag}
        </span>
      ))}
    </div>
  )}

  {/* Title */}
  <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 leading-snug">
    {href ? (
      <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent-hi)] transition-colors after:absolute after:inset-0">
        {title}
      </a>
    ) : title}
  </h3>

  {/* Description */}
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">{description}</p>

  {/* Metrics */}
  {metrics.length > 0 && (
    <div class="flex flex-wrap gap-4 pt-5 border-t border-[var(--color-border)]">
      {metrics.map(({ label, value }) => (
        <div>
          <p class="text-lg font-semibold text-[var(--color-accent)]">{value}</p>
          <p class="text-xs text-[var(--color-text-dim)]">{label}</p>
        </div>
      ))}
    </div>
  )}

</div>
