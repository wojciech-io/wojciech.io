---
interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  tags?: string[];
  metrics?: Metric[];
  href?: string;
  cluster?: string;
  featured?: boolean;
}

const { title, description, tags = [], metrics = [], href, featured = false } = Astro.props;
---

<div class:list={[
  'group relative rounded-[var(--radius-card)] border bg-[var(--color-surface)] p-8 card-lift',
  featured
    ? 'border-[var(--color-accent)]/30 hover:border-[var(--color-accent)]/60'
    : 'border-[var(--color-border)] hover:border-[var(--color-border-2)]',
]}>

  {/* Tags */}
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-5">
      {tags.map((tag) => (
        <span class="inline-flex items-center text-xs font-medium px-3 py-1 rounded-[var(--radius-badge)] border border-[var(--color-border-2)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)] transition-colors group-hover:border-[var(--color-border-2)]">
          {tag}
        </span>
      ))}
    </div>
  )}

  {/* Title */}
  <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">
    {href ? (
      <a href={href} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
        {title}
      </a>
    ) : title}
  </h3>

  {/* Description */}
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">{description}</p>

  {/* Arrow if has link */}
  {href && (
    <div class="flex items-center gap-1.5 text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 mb-2">
      <span>View</span>
      <svg class="w-3 h-3 translate-x-0 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  )}

  {/* Metrics */}
  {metrics.length > 0 && (
    <div class="flex flex-wrap gap-4 pt-5 border-t border-[var(--color-border)]">
      {metrics.map(({ label, value }) => (
        <div>
          <p class="text-lg font-semibold text-[var(--color-accent)]">{value}</p>
          <p class="text-xs text-[var(--color-text-dim)]">{label}</p>
        </div>
      ))}
    </div>
  )}

</div>
