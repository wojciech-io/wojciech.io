---
interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  titlePl?: string;
  titleIt?: string;
  description: string;
  descriptionPl?: string;
  descriptionIt?: string;
  tags?: string[];
  metrics?: Metric[];
  href?: string;
  image?: string;
  icon?: string;
  cluster?: string;
  featured?: boolean;
}

const { title, titlePl, titleIt, description, descriptionPl, descriptionIt, tags = [], metrics = [], href, image, icon, featured = false } = Astro.props;
---

<div class:list={[
  'group relative rounded-[var(--radius-card)] border bg-[var(--color-surface)] overflow-hidden card-lift',
  featured
    ? 'border-[var(--color-accent)]/30 hover:border-[var(--color-accent)]/60'
    : 'border-[var(--color-border)] hover:border-[var(--color-border-2)]',
]}>

  {/* Visual header — screenshot or icon area */}
  {image ? (
    <div class="relative w-full aspect-[4/3] overflow-hidden bg-[var(--color-surface-2)]">
      <img
        src={image}
        alt={title}
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/60 via-transparent to-transparent" />
    </div>
  ) : icon ? (
    <div class="relative w-full aspect-[4/3] bg-[var(--color-surface-2)] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:28px_28px] opacity-30" aria-hidden="true" />
      <div class="absolute inset-0 bg-radial-[at_50%_100%] from-[var(--color-accent-lo)]/20 to-transparent" aria-hidden="true" />
      <div class="relative z-10 w-14 h-14 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border-2)] flex items-center justify-center shadow-lg group-hover:border-[var(--color-accent)]/40 transition-colors duration-300">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-7 h-7 text-[var(--color-accent)]"
          aria-hidden="true"
        >
          <path d={icon} />
        </svg>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/50 to-transparent" />
    </div>
  ) : null}

  {/* Card body */}
  <div class="p-7">

    {/* Tags */}
    {tags.length > 0 && (
      <p class="text-xs text-[var(--color-text-dim)] mb-3 leading-relaxed">
        {tags.join(' · ')}
      </p>
    )}

    {/* Title */}
    <h3 class="text-base font-semibold text-[var(--color-text)] mb-2 leading-snug group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">
      {href ? (
        <a href={href} target="_blank" rel="noopener noreferrer" data-en={title} data-pl={titlePl ?? title} data-it={titleIt ?? title} class="after:absolute after:inset-0">
          {title}
        </a>
      ) : (
        <span data-en={title} data-pl={titlePl ?? title} data-it={titleIt ?? title}>{title}</span>
      )}
    </h3>

    {/* Description */}
    <p data-en={description} data-pl={descriptionPl ?? description} data-it={descriptionIt ?? description} class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5">{description}</p>

    {/* Arrow if has link */}
    {href && (
      <div class="flex items-center gap-1.5 text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150">
        <span data-en="View" data-pl="Zobacz" data-it="Vedi">View</span>
        <svg class="w-3 h-3 translate-x-0 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    )}

    {/* Metrics */}
    {metrics.length > 0 && (
      <div class="flex flex-wrap gap-4 pt-5 border-t border-[var(--color-border)]">
        {metrics.map(({ label, value }) => (
          <div>
            <p class="text-lg font-semibold text-[var(--color-accent)]">{value}</p>
            <p class="text-xs text-[var(--color-text-dim)]">{label}</p>
          </div>
        ))}
      </div>
    )}

  </div>
</div>
