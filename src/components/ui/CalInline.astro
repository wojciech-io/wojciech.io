---
// Inline Cal.com booking calendar in a styled card.
//
// CalEmbed (global, mounted once in Layout) finds the [data-cal-inline] element,
// loads embed.js, mounts the calendar into it, and keeps theme + brand colour in
// sync with the site. This component only supplies the styled container and a
// loading state; it holds no script of its own.
interface Props {
  /** Cal.com public link: "username/event-slug". */
  calLink?: string;
  /** Localized "loading" line, shown until the calendar iframe mounts over it. */
  loadingLabel?: string;
  /** Localized label for the fallback link shown if the embed never mounts. */
  fallbackLabel?: string;
  minHeight?: string;
  /** false when the page already provides the container (e.g. a two-column layout). */
  contained?: boolean;
}

import { CAL_BOOKING_LINK } from '../../data/site';

const {
  calLink = CAL_BOOKING_LINK,
  loadingLabel = 'Loading the calendar…',
  fallbackLabel = 'Open the booking calendar',
  minHeight = '580px',
  contained = true,
} = Astro.props as Props;

// Contained: the component supplies the site container (max-w-6xl px-6) so it
// lines up with the header and the copy. Uncontained: the page already owns the
// grid (two-column contact layout) and this just fills its cell.
const wrapClass = contained ? 'relative mx-auto max-w-6xl px-6' : 'relative';
---

<div class={wrapClass}>
  {/* No border or surface here: Cal renders its own card, and wrapping it in a
      second one produced a visible box-in-a-box. */}
  <div class="cal-shell relative" style={`min-height:${minHeight}`}>
    {/* Loading state sits behind the calendar; Cal's iframe covers it on mount.
        If the embed never mounts (blocked script, offline, content blocker),
        the script below swaps the spinner for a real link so the visitor is
        never stranded watching it spin. */}
    <div class="cal-loading pointer-events-none absolute inset-0 z-0 flex flex-col items-center justify-center gap-3 px-6 text-center text-sm text-[var(--color-text-muted)]">
      <span class="cal-spinner" aria-hidden="true"></span>
      <span class="cal-loading-label">{loadingLabel}</span>
      <a
        href={`https://cal.com/${calLink}`}
        class="cal-fallback pointer-events-auto inline-flex items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3 font-semibold text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-cta-hi)]"
        target="_blank"
        rel="noopener noreferrer"
      >{fallbackLabel}</a>
      {/* No JS: the embed can never mount, so lead with the link right away. */}
      <noscript>
        <style>.cal-spinner,.cal-loading-label{display:none}.cal-fallback{display:inline-flex}</style>
      </noscript>
    </div>
    <div data-cal-inline={calLink} class="relative z-[1]" style={`width:100%;min-height:${minHeight};overflow:auto`}></div>
  </div>
</div>

<script is:inline>
  /* Reveal the fallback link if no calendar iframe shows up. Runs per shell so
     it works on every locale's contact page, and re-arms after a ClientRouter
     navigation. Kept inline and dependency-free: this is the safety net for the
     exact case where third-party scripts are not running. */
  (() => {
    const TIMEOUT_MS = 8000;
    const arm = () => {
      document.querySelectorAll('.cal-shell:not([data-cal-watched])').forEach((shell) => {
        shell.setAttribute('data-cal-watched', '1');
        const host = shell.querySelector('[data-cal-inline]');
        if (!host) return;
        const settle = () => {
          if (host.querySelector('iframe')) {
            shell.setAttribute('data-cal-state', 'ready');
            return true;
          }
          return false;
        };
        if (settle()) return;
        const obs = new MutationObserver(() => {
          if (settle()) obs.disconnect();
        });
        obs.observe(host, { childList: true, subtree: true });
        setTimeout(() => {
          if (!settle()) shell.setAttribute('data-cal-state', 'failed');
          obs.disconnect();
        }, TIMEOUT_MS);
      });
    };
    arm();
    document.addEventListener('astro:page-load', arm);
  })();
</script>

<style>
  /* Default (embed loading or mounted): spinner shows, fallback link hidden. */
  .cal-fallback {
    display: none;
  }
  /* Embed failed to mount: drop the spinner, offer the real booking link. */
  .cal-shell[data-cal-state='failed'] .cal-spinner {
    display: none;
  }
  .cal-shell[data-cal-state='failed'] .cal-fallback {
    display: inline-flex;
  }
  .cal-spinner {
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent-cta);
    animation: cal-spin 0.7s linear infinite;
  }
  @keyframes cal-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cal-spinner {
      animation: none;
      border-top-color: var(--color-border);
    }
  }
</style>
