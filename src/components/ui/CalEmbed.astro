---
// Cal.com scheduler wiring, site-wide.
//
// Two surfaces:
//  - [data-cal-link="user/event"]  → compact popup scheduler, opens in place.
//  - [data-cal-inline="user/event"] → full inline calendar (contact pages).
//
// embed.js stays off the critical path: it loads on first pointer/focus intent
// on a trigger, or immediately when an inline container is on the page. Until
// it loads, every trigger's href fallback (cal.com or /contact/) still works,
// so a blocked script never strands the visitor.
//
// Layout stays month_view everywhere. Cal ignores the layout parameter below
// 768px and renders its own mobile view regardless, and on desktop column_view
// adds a second day-column panel beside the grid rather than replacing it.
// Verified against the embed URL directly at both widths on 2026-08-11.
// Shortening the mobile calendar has to come from the event's availability in
// the Cal dashboard, not from this flag.
const CAL_ORIGIN = 'https://app.cal.com';
---

<script is:inline define:vars={{ CAL_ORIGIN }}>
  (() => {
    let booted = false;
    const theme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

    const boot = () => {
      if (booted) return;
      booted = true;
      /* Official Cal.com embed loader (queues calls until embed.js arrives). */
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, CAL_ORIGIN + '/embed/embed.js', 'init');
      window.Cal('init', { origin: CAL_ORIGIN });
      window.Cal('ui', {
        theme: theme(),
        styles: { branding: { brandColor: '#ebff00' } },
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
    };

    const mountInline = () => {
      const el = document.querySelector('[data-cal-inline]:not([data-cal-mounted])');
      if (!el) return;
      el.setAttribute('data-cal-mounted', '1');
      boot();
      window.Cal('inline', {
        elementOrSelector: '[data-cal-mounted]',
        calLink: el.getAttribute('data-cal-inline'),
        config: { theme: theme() },
      });
    };

    /* Popup triggers: warm embed.js on first intent so the modal opens fast.
       pointerover bubbles, focusin covers keyboard users, touchstart mobile. */
    const warm = (e) => {
      if (e.target && e.target.closest && e.target.closest('[data-cal-link]')) boot();
    };
    document.addEventListener('pointerover', warm, { passive: true });
    document.addEventListener('touchstart', warm, { passive: true });
    document.addEventListener('focusin', warm);

    /* Open the scheduler explicitly. embed.js does bind [data-cal-link] itself,
       but that binding swallows the click without opening the modal, so the
       call is made here instead. Calls made before embed.js finishes are queued
       by the loader and replay on arrival, so a cold click still works.
       If no modal shows up (script blocked, offline), fall back to the href,
       which points at the contact page and its inline calendar. */
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // let new-tab through
      const trigger = e.target && e.target.closest && e.target.closest('[data-cal-link]');
      if (!trigger) return;

      e.preventDefault();
      boot();
      window.Cal('modal', {
        calLink: trigger.getAttribute('data-cal-link'),
        config: { theme: theme() },
      });

      const href = trigger.getAttribute('href');
      if (!href) return;
      setTimeout(() => {
        if (!document.querySelector('cal-modal-box')) window.location.href = href;
      }, 3500);
    });

    mountInline();
    /* ClientRouter swaps the DOM on navigation; re-mount if a contact page arrives. */
    document.addEventListener('astro:page-load', mountInline);
  })();
</script>
