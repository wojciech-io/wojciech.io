---
interface Props {
  quote: string;
  name: string;
  role: string;
  company?: string;
}

const { quote, name, role, company } = Astro.props;
---

<figure class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 flex flex-col gap-6">
  <blockquote>
    <p class="text-[var(--color-text-muted)] leading-relaxed text-sm">
      "{quote}"
    </p>
  </blockquote>
  <figcaption class="flex items-center gap-3 mt-auto">
    <div class="w-8 h-8 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border-2)] flex items-center justify-center shrink-0">
      <span class="text-xs font-semibold text-[var(--color-accent)]">{name[0]}</span>
    </div>
    <div>
      <p class="text-sm font-semibold text-[var(--color-text)]">{name}</p>
      <p class="text-xs text-[var(--color-text-dim)]">{role}{company ? `, ${company}` : ''}</p>
    </div>
  </figcaption>
</figure>
