---
import type { SectionStrings } from '../../data/locales';
import { accentHeading } from '../../lib/editorial';
import { getLocaleFromPath } from '../../data/uiStrings';

interface Props {
  i18n?: SectionStrings['ai'];
}

const { i18n } = Astro.props;
// Only the Arabic homepage has a localized AI Systems page; every other locale
// keeps linking to the canonical English page (no regression).
const systemsHref = getLocaleFromPath(Astro.url.pathname) === 'ar' ? '/ar/ai-systems/' : '/ai-systems/';
const defaultRows = [
  { label: 'Ad creation loop',    before: 'Days',              after: 'Minutes'         },
  { label: 'CRM enrichment',      before: 'Manual / BDR time', after: 'Automated'       },
  { label: 'SEO brief → draft',   before: 'Week',              after: 'Hours'           },
  { label: 'Outbound sequencing', before: 'Templates',         after: 'AI-personalised' },
];
const t = {
  eyebrow: i18n?.eyebrow ?? 'AI systems',
  title: i18n?.title ?? 'AI in the architecture.',
  titleSecondary: i18n?.titleSecondary ?? 'Not bolted on at the end.',
  link: i18n?.link ?? 'How I build with AI →',
  stackLabel: i18n?.stackLabel ?? 'Tech stack',
  body: i18n?.body ?? 'Not for faster copy. For a different operating model. AI goes into prospecting, enrichment, sequencing, and scoring. The whole motion runs faster. Not just one task on the list.',
  allSystemsLink: i18n?.allSystemsLink ?? 'See all AI systems →',
  stackStatus: i18n?.stackStatus ?? 'operator stack · always running',
  bridgeStatus: i18n?.bridgeStatus ?? 'MCP bridge · live',
  activeLabel: i18n?.activeLabel ?? 'active',
};
const rows = i18n?.rows ?? defaultRows;

// Product names are universal; roles are localized by index.
// `core` = AI core (accent + live ping); the rest is supporting infra (quiet).
const stack = [
  { name: 'Claude Code',  role: 'agent core',      core: true  },
  { name: 'MCP',          role: 'tool bridge',     core: true  },
  { name: 'HubSpot',      role: 'CRM + sequences', core: false },
  { name: 'Google Ads',   role: 'paid acquisition',core: false },
  { name: 'Cloudflare',   role: 'edge + workers',  core: false },
  { name: 'Astro',        role: 'site layer',      core: false },
];
const roles = i18n?.roles ?? stack.map((s) => s.role);
---

<section class="relative py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">

      <!-- Left: copy + before/after table -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.eyebrow}</span>
        </div>
        <h2 class="reveal-blur text-[length:var(--text-h2)] font-normal leading-[1.12] tracking-[-0.015em] mb-5">
          <span class="text-[var(--color-text)]">{t.title}</span><br />
          <span class="text-[var(--color-text)]">{accentHeading(t.titleSecondary).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.titleSecondary).mark}</span>
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-snug mb-4">
          {t.body}
        </p>
        <a href={systemsHref} class="text-sm text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors font-medium mb-8 inline-block">
          {t.link}
        </a>

        <!-- Before / After as a transformation: the old way struck out, a dashed
             accent arrow (same motif as the newsletter delivery thread), and the
             new state as an accent chip. Reads as change, not a table. -->
        <div class="xform-ledger">
          {rows.map(({ label, before, after }, index) => (
            <div class="xform-row reveal-up group" data-reveal-index={index + 1}>
              <p class="xform-label">{label}</p>
              <div class="xform-track">
                <span class="xform-before">{before}</span>
                <span class="xform-arrow" aria-hidden="true">
                  <svg width="26" height="10" viewBox="0 0 26 10" fill="none">
                    <path d="M0 5h20M17 1.5 21.5 5 17 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2.5 2.5"/>
                  </svg>
                </span>
                <span class="xform-after">{after}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: animated tech stack -->
      <div class="reveal-right">
        <span class="obs-label mb-4 block">{t.stackLabel}</span>
        <div class="obs-panel overflow-hidden">
          <!-- Stack header: single live marker + mono status (no terminal chrome) -->
          <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-text-dim)]">{t.stackStatus}</span>
          </div>

          <!-- Stack items -->
          <div class="divide-y divide-[var(--color-border)]">
            {stack.map(({ name, core }, i) => (
              <div
                class="stack-item group flex items-center gap-4 px-5 py-3.5 hover:bg-[var(--color-surface-2)] transition-colors duration-150"
                style={`--delay: ${i * 80}ms`}
              >
                <!-- Status dot: accent + live ping for AI core, quiet dim for infra -->
                <span
                  class="relative flex h-2 w-2 shrink-0"
                  aria-hidden="true"
                >
                  {core && (
                    <span
                      class="absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-50 animate-ping"
                      style={`animation-delay: ${i * 200}ms; animation-duration: 2.4s;`}
                    ></span>
                  )}
                  <span
                    class={`relative inline-flex h-2 w-2 rounded-full ${core ? 'bg-[var(--color-accent)]' : 'bg-[var(--color-text-dim)]'}`}
                  ></span>
                </span>

                <!-- Tool name -->
                <span class="font-mono text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors min-w-[108px]">
                  {name}
                </span>

                <!-- Role -->
                <span class="font-mono text-xs text-[var(--color-text-dim)] group-hover:text-[var(--color-text-muted)] transition-colors flex-1">
                  {roles[i]}
                </span>

                <!-- Status indicator -->
                <span class="font-mono text-[10px] text-[var(--color-text-dim)] shrink-0">{t.activeLabel}</span>
              </div>
            ))}
          </div>

          <!-- Animated connection line at bottom -->
          <div class="px-5 py-3 border-t border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-[var(--color-border)] relative overflow-hidden">
                <div class="data-flow absolute inset-y-0 w-16 bg-gradient-to-r from-transparent via-[var(--color-accent)]/60 to-transparent"></div>
              </div>
              <span class="font-mono text-[10px] text-[var(--color-text-dim)] shrink-0">{t.bridgeStatus}</span>
              <div class="flex-1 h-px bg-[var(--color-border)] relative overflow-hidden">
                <div class="data-flow absolute inset-y-0 w-16 bg-gradient-to-r from-transparent via-[var(--color-accent)]/60 to-transparent" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
        </div>

        <a href={systemsHref} class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-text-dim)] hover:text-[var(--color-accent)] transition-colors">
          {t.allSystemsLink}
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* Before → after transformation ledger. */
  .xform-ledger { border-top: 1px solid var(--color-border); }
  .xform-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .xform-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }
  .xform-row:hover .xform-label { color: var(--color-text); }
  .xform-track {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }
  .xform-before {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-text-dim) 60%, transparent);
    white-space: nowrap;
  }
  .xform-arrow { color: color-mix(in srgb, var(--color-accent-cta) 70%, var(--color-border)); display: inline-flex; }
  .xform-after {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-hi);
    background: color-mix(in srgb, var(--color-accent-cta) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 34%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .xform-row:hover .xform-after {
    background: color-mix(in srgb, var(--color-accent-cta) 22%, transparent);
  }

  @keyframes data-flow {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(600%); }
  }

  .data-flow {
    animation: data-flow 2.2s ease-in-out infinite;
  }

  .stack-item {
    opacity: 0;
    transform: translateY(6px);
    animation: stack-reveal 0.4s ease forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes stack-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .data-flow {
      animation: none;
    }
    .animate-ping {
      animation: none;
    }
  }
</style>
