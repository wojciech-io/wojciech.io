---
const rows = [
  { label: 'Ad creation loop',   before: 'Days',            after: 'Minutes'         },
  { label: 'CRM enrichment',     before: 'Manual / BDR time', after: 'Automated'     },
  { label: 'SEO brief → draft',  before: 'Week',            after: 'Hours'           },
  { label: 'Outbound sequencing', before: 'Templates',      after: 'AI-personalised' },
];
---

<section class="relative py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4 flex items-center gap-2.5">
          <span class="inline-block w-2 h-2 rounded-sm bg-[var(--color-accent)] rotate-45 opacity-80" aria-hidden="true"></span>
          <span>AI systems</span>
        </p>
        <h2 class="reveal-up text-[length:var(--text-h2)] font-semibold leading-[1.15] tracking-tight mb-5" data-reveal-index="0">
          <span class="text-[var(--color-text)]">AI in the architecture.</span><br />
          <span class="text-[var(--color-text-muted)]">Not bolted on at the end.</span>
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-snug mb-4">
          Not for faster copy. For a different operating model. AI goes into prospecting, enrichment,
          sequencing, and scoring. The whole motion runs faster. Not just one task on the list.
        </p>
        <a href="/ai-systems/" class="text-sm text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors font-medium">
          How I build with AI →
        </a>
      </div>
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 space-y-1 card-lift hover:border-[var(--color-accent)]/30">
        {rows.map(({ label, before, after }, index) => (
          <div class="reveal-up flex items-center justify-between py-3.5 border-b border-[var(--color-border)] last:border-0 group" data-reveal-index={index + 1}>
            <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{label}</p>
            <div class="flex items-center gap-3 text-xs shrink-0 ml-4">
              <span class="text-[var(--color-text-dim)] line-through">{before}</span>
              <span class="text-[var(--color-accent)] font-semibold">{after}</span>
            </div>
          </div>
        ))}
        <a href="/ai-systems/" class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors pt-4">
          See all AI systems →
        </a>
      </div>
    </div>
  </div>
</section>
