---
import type { SectionStrings } from '../../data/locales';

interface Props {
  i18n?: SectionStrings['ai'];
}

const { i18n } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'AI systems',
  title: i18n?.title ?? 'AI in the architecture.',
  titleSecondary: i18n?.titleSecondary ?? 'Not bolted on at the end.',
  link: i18n?.link ?? 'How I build with AI →',
  stackLabel: i18n?.stackLabel ?? 'Tech stack',
};

const rows = [
  { label: 'Ad creation loop',    before: 'Days',              after: 'Minutes'         },
  { label: 'CRM enrichment',      before: 'Manual / BDR time', after: 'Automated'       },
  { label: 'SEO brief → draft',   before: 'Week',              after: 'Hours'           },
  { label: 'Outbound sequencing', before: 'Templates',         after: 'AI-personalised' },
];

const stack = [
  { name: 'Claude Code',  role: 'agent core',      dot: '#EBFF00' },
  { name: 'MCP',          role: 'tool bridge',     dot: '#EBFF00' },
  { name: 'HubSpot',      role: 'CRM + sequences', dot: '#f97316' },
  { name: 'Google Ads',   role: 'paid acquisition',dot: '#60a5fa' },
  { name: 'Cloudflare',   role: 'edge + workers',  dot: '#f59e0b' },
  { name: 'Astro',        role: 'site layer',      dot: '#a78bfa' },
];
---

<section class="relative py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">

      <!-- Left: copy + before/after table -->
      <div>
        <span class="obs-label-accent mb-4 block">// {t.eyebrow}</span>
        <h2 class="reveal-blur text-[length:var(--text-h2)] font-semibold leading-[1.15] tracking-tight mb-5">
          <span class="text-[var(--color-text)]">{t.title}</span><br />
          <span class="heading-accent">{t.titleSecondary}</span>
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-snug mb-4">
          Not for faster copy. For a different operating model. AI goes into prospecting, enrichment,
          sequencing, and scoring. The whole motion runs faster. Not just one task on the list.
        </p>
        <a href="/ai-systems/" class="text-sm text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors font-medium mb-8 inline-block">
          {t.link}
        </a>

        <!-- Before / After table -->
        <div class="obs-panel p-6 space-y-1 card-lift">
          {rows.map(({ label, before, after }, index) => (
            <div class="reveal-up flex items-center justify-between py-3 border-b border-[var(--color-border)] last:border-0 group" data-reveal-index={index + 1}>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{label}</p>
              <div class="flex items-center gap-3 text-xs shrink-0 ml-4">
                <span class="text-[var(--color-text-dim)] line-through">{before}</span>
                <span class="text-[var(--color-accent)] font-semibold">{after}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: animated tech stack -->
      <div class="reveal-right">
        <span class="obs-label mb-4 block">{t.stackLabel}</span>
        <div class="obs-panel overflow-hidden">
          <!-- Stack header terminal bar -->
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ef4444]/60"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#f59e0b]/60"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-success)]/70"></span>
            <span class="ml-2 font-mono text-[10px] text-[var(--color-text-dim)]">operator stack · always running</span>
          </div>

          <!-- Stack items -->
          <div class="divide-y divide-[var(--color-border)]">
            {stack.map(({ name, role, dot }, i) => (
              <div
                class="stack-item group flex items-center gap-4 px-5 py-3.5 hover:bg-[var(--color-surface-2)] transition-colors duration-150"
                style={`--delay: ${i * 80}ms`}
              >
                <!-- Animated dot -->
                <span
                  class="relative flex h-2 w-2 shrink-0"
                  aria-hidden="true"
                >
                  <span
                    class="absolute inline-flex h-full w-full rounded-full opacity-60 animate-ping"
                    style={`background-color: ${dot}; animation-delay: ${i * 200}ms; animation-duration: 2.4s;`}
                  ></span>
                  <span
                    class="relative inline-flex h-2 w-2 rounded-full"
                    style={`background-color: ${dot};`}
                  ></span>
                </span>

                <!-- Tool name -->
                <span class="font-mono text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors min-w-[108px]">
                  {name}
                </span>

                <!-- Role -->
                <span class="font-mono text-xs text-[var(--color-text-dim)] group-hover:text-[var(--color-text-muted)] transition-colors flex-1">
                  {role}
                </span>

                <!-- Status indicator -->
                <span class="font-mono text-[10px] text-[var(--color-success)] shrink-0">active</span>
              </div>
            ))}
          </div>

          <!-- Animated connection line at bottom -->
          <div class="px-5 py-3 border-t border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-[var(--color-border)] relative overflow-hidden">
                <div class="data-flow absolute inset-y-0 w-16 bg-gradient-to-r from-transparent via-[var(--color-accent)]/60 to-transparent"></div>
              </div>
              <span class="font-mono text-[10px] text-[var(--color-text-dim)] shrink-0">MCP bridge · live</span>
              <div class="flex-1 h-px bg-[var(--color-border)] relative overflow-hidden">
                <div class="data-flow absolute inset-y-0 w-16 bg-gradient-to-r from-transparent via-[var(--color-accent)]/60 to-transparent" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
        </div>

        <a href="/ai-systems/" class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-text-dim)] hover:text-[var(--color-accent)] transition-colors">
          See all AI systems →
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes data-flow {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(600%); }
  }

  .data-flow {
    animation: data-flow 2.2s ease-in-out infinite;
  }

  .stack-item {
    opacity: 0;
    transform: translateY(6px);
    animation: stack-reveal 0.4s ease forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes stack-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .data-flow {
      animation: none;
    }
    .animate-ping {
      animation: none;
    }
  }
</style>
