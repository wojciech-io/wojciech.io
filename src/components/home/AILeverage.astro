---
import type { SectionStrings } from '../../data/locales';
import { accentHeading } from '../../lib/editorial';
import { getLocaleFromPath } from '../../data/uiStrings';

interface Props {
  i18n?: SectionStrings['ai'];
}

const { i18n } = Astro.props;
// Only the Arabic homepage has a localized AI Systems page; every other locale
// keeps linking to the canonical English page (no regression).
const systemsHref = getLocaleFromPath(Astro.url.pathname) === 'ar' ? '/ar/ai-systems/' : '/ai-systems/';
const defaultRows = [
  { label: 'Ad creation loop',    before: 'Days',              after: 'Minutes'         },
  { label: 'CRM enrichment',      before: 'Manual / BDR time', after: 'Automated'       },
  { label: 'SEO brief → draft',   before: 'Week',              after: 'Hours'           },
  { label: 'Outbound sequencing', before: 'Templates',         after: 'AI-personalised' },
];
const t = {
  eyebrow: i18n?.eyebrow ?? 'AI systems',
  title: i18n?.title ?? 'AI in the architecture.',
  titleSecondary: i18n?.titleSecondary ?? 'Not bolted on at the end.',
  link: i18n?.link ?? 'How I build with AI →',
  stackLabel: i18n?.stackLabel ?? 'Tech stack',
  body: i18n?.body ?? 'Not for faster copy. For a different operating model. AI goes into prospecting, enrichment, sequencing, and scoring. The whole motion runs faster. Not just one task on the list.',
  allSystemsLink: i18n?.allSystemsLink ?? 'See all AI systems →',
};
const rows = i18n?.rows ?? defaultRows;

// Product names are universal; roles are localized by index.
// `core` = AI core (accent + live ping); the rest is supporting infra (quiet).
const stack = [
  { name: 'Claude Code',  role: 'agent core',      core: true  },
  { name: 'MCP',          role: 'tool bridge',     core: true  },
  { name: 'HubSpot',      role: 'CRM + sequences', core: false },
  { name: 'Google Ads',   role: 'paid acquisition',core: false },
  { name: 'Cloudflare',   role: 'edge + workers',  core: false },
  { name: 'Astro',        role: 'site layer',      core: false },
];
const roles = i18n?.roles ?? stack.map((s) => s.role);
---

<section class="relative border-t border-[var(--color-border)] py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">

      <!-- Left: copy + before/after table -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.eyebrow}</span>
        </div>
        <h2 class="reveal-blur t-h2 mb-5">
          <span class="text-[var(--color-text)]">{t.title}</span><br />
          <span class="text-[var(--color-text)]">{accentHeading(t.titleSecondary).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.titleSecondary).mark}</span>
        </h2>
        <p class="t-small text-[var(--color-text-muted)] mb-4">
          {t.body}
        </p>
        <a href={systemsHref} class="t-small text-[var(--color-accent-hi)] hover:text-[var(--color-text)] transition-colors mb-8 inline-block">
          {t.link}
        </a>

        <!-- Before → after ledger. Columns are fixed so every arrow and every
             chip sits at the same x; below 30rem of column width (tablet two-up,
             phones) each row wraps to label on top, change underneath, instead
             of squeezing the middle column until "before" runs under the chip. -->
        <div class="xform-ledger">
          {rows.map(({ label, before, after }, index) => (
            <div class="xform-row reveal-up" data-reveal-index={index + 1}>
              <p class="xform-label t-small">{label}</p>
              <p class="xform-before t-data"><s>{before}</s><span class="xform-arrow" aria-hidden="true">→</span></p>
              <p class="xform-after"><span class="t-label">{after}</span></p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: the stack, name and role only -->
      <div class="reveal-scale">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.stackLabel}</span>
        </div>
        <ul class="obs-panel divide-y divide-[var(--color-border)] overflow-hidden">
          {stack.map(({ name, core }, i) => (
            <li class="flex items-center gap-4 px-5 py-4">
              <span
                class={`h-2 w-2 shrink-0 rounded-full ${core ? 'bg-[var(--color-accent-cta)] ring-4 ring-[color-mix(in_srgb,var(--color-accent-cta)_22%,transparent)]' : 'bg-[var(--color-border-2)]'}`}
                aria-hidden="true"
              ></span>
              <span class="t-data font-semibold text-[var(--color-text)] w-32 shrink-0">{name}</span>
              <span class="t-small text-[var(--color-text-muted)]">{roles[i]}</span>
            </li>
          ))}
        </ul>

        <a href={systemsHref} class="t-small mt-4 inline-flex items-center gap-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          {t.allSystemsLink}
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .xform-ledger {
    container-type: inline-size;
    border-top: 1px solid var(--color-border);
  }
  .xform-row {
    display: grid;
    grid-template-columns: max-content max-content;
    justify-content: start;
    grid-template-areas:
      'label label'
      'before after';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.375rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .xform-label { grid-area: label; color: var(--color-text); }
  .xform-before {
    grid-area: before;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-dim);
  }
  .xform-before s {
    text-decoration-color: color-mix(in srgb, var(--color-text-dim) 70%, transparent);
  }
  .xform-arrow { color: var(--color-accent-hi); font-family: var(--font-sans); }
  .xform-after { grid-area: after; justify-self: start; }
  .xform-after span {
    display: inline-block;
    color: var(--color-accent-hi);
    background: color-mix(in srgb, var(--color-accent-cta) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 38%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }

  /* Wide column: one line per row, fixed columns for before and after. */
  @container (min-width: 30rem) {
    .xform-row {
      grid-template-columns: minmax(0, 1fr) 10.5rem 9.5rem;
      justify-content: stretch;
      grid-template-areas: 'label before after';
      row-gap: 0;
    }
  }
</style>
