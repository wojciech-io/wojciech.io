---
import type { SectionStrings } from '../../data/locales';
import { accentHeading } from '../../lib/editorial';
import { getLocaleFromPath } from '../../data/uiStrings';

interface Props {
  i18n?: SectionStrings['ai'];
}

const { i18n } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
// Only the Arabic homepage has a localized AI Systems page; every other locale
// keeps linking to the canonical English page (no regression).
const systemsHref = locale === 'ar' ? '/ar/ai-systems/' : '/ai-systems/';
const insightsBase = locale === 'pl' ? '/pl/insights' : '/insights';

const t = {
  eyebrow: i18n?.eyebrow ?? 'AI systems',
  title: i18n?.title ?? 'AI in the architecture.',
  titleSecondary: i18n?.titleSecondary ?? 'Not bolted on at the end.',
  link: i18n?.link ?? 'How I build with AI →',
  stackLabel: i18n?.stackLabel ?? 'Tech stack',
  body: i18n?.body ?? 'Not for faster copy. For a different operating model. AI goes into prospecting, enrichment, sequencing, and scoring. The whole motion runs faster. Not just one task on the list.',
  allSystemsLink: i18n?.allSystemsLink ?? 'See all AI systems →',
};

/* Three systems that actually run, each behind its own page. Names, numbers and
   product words carry the meaning, so every locale gets the same three cards
   without a sentence that would need translating (and without falling back to
   English copy inside a localized page). */
const systems = [
  { name: 'GTM agent',  fact: '$2 / run',       meta: 'Claude Code · MCP · HubSpot', href: `${insightsBase}/how-to-build-gtm-ai-agent-outbound-crm/` },
  { name: 'GrowthHub',  fact: 'live demo',      meta: 'Pipedrive · Cloudflare',      href: 'https://gh.wojciech.io/demo/', external: true },
  { name: 'NotchCue',   fact: 'macOS · Swift',  meta: 'Codex · Xcode',               href: '/apps/notch/' },
];

// The stack reads as one quiet line: product names, nothing else.
const stack = ['Claude Code', 'MCP', 'HubSpot', 'Google Ads', 'Cloudflare', 'Astro'];
---

<section class="relative border-t border-[var(--color-border)] py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-6">

    <div class="flex items-center gap-3 mb-4">
      <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
      <span class="obs-label-accent">{t.eyebrow}</span>
    </div>

    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-16">
      <h2 class="reveal-blur t-h2 max-w-xl">
        <span class="text-[var(--color-text)]">{t.title}</span><br />
        <span class="text-[var(--color-text)]">{accentHeading(t.titleSecondary).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.titleSecondary).mark}</span>
      </h2>
      <div class="max-w-md md:pb-1">
        <p class="t-small text-[var(--color-text-muted)] mb-3">{t.body}</p>
        <a href={systemsHref} class="t-small inline-block text-[var(--color-accent-hi)] transition-colors hover:text-[var(--color-text)]">
          {t.link}
        </a>
      </div>
    </div>

    <!-- Three systems, each behind its own page -->
    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {systems.map(({ name, fact, meta, href, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class="group flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 card-hover no-underline"
        >
          <span class="t-body font-semibold text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">{name}</span>
          <span class="t-h3 text-[var(--color-accent-hi)]">{fact}</span>
          <span class="t-data mt-auto text-[var(--color-text-dim)]">{meta}</span>
        </a>
      ))}
    </div>

    <!-- The stack: one quiet line, no dots, no roles -->
    <div class="mt-8 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
      <p class="t-data text-[var(--color-text-dim)]">
        <span class="obs-label">{t.stackLabel}</span>
        <span class="ml-3 text-[var(--color-text-muted)]">{stack.join(' · ')}</span>
      </p>
      <a href={systemsHref} class="t-small whitespace-nowrap text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]">
        {t.allSystemsLink}
      </a>
    </div>

  </div>
</section>
