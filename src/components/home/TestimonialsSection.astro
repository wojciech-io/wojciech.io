---
import { getCollection } from 'astro:content';
import TestimonialSlider from '../ui/TestimonialSlider.astro';

interface Props {
  i18n?: { eyebrow: string; title: string; titleSecondary: string };
}

const { i18n } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'Testimonials',
  title: i18n?.title ?? 'What it\'s like',
  titleSecondary: i18n?.titleSecondary ?? 'to work with me.',
};

const testimonialsCollection = await getCollection('testimonials', ({ data }) => data.featured && !data.draft);
const sorted = testimonialsCollection.sort((a, b) => a.data.order - b.data.order);

const toCard = (t: typeof sorted[number]) => ({
  quote: t.data.quote,
  name: t.data.author,
  role: t.data.role,
  company: t.data.company,
  linkedin: t.data.href,
  avatar: t.data.avatar,
});

const heroTestimonials = sorted.filter((t) => t.data.hero).map(toCard);
const secondaryTestimonials = sorted.filter((t) => !t.data.hero).map(toCard);
---

<section class="py-[var(--space-section)] bg-[var(--color-surface)] border-t border-[var(--color-border)] section-fade">
  <div class="mx-auto max-w-6xl px-6">
    <div class="relative mb-12">
      <span class="pointer-events-none absolute -top-6 left-0 text-[8rem] font-bold leading-none select-none text-[var(--color-text)] opacity-[0.03]" aria-hidden="true">"</span>
      <span class="relative obs-label-accent mb-4 block">// {t.eyebrow}</span>
      <h2 class="reveal-up relative text-[length:var(--text-h2)] font-semibold leading-[1.15] tracking-tight" data-reveal-index="0">
        <span class="text-[var(--color-text)]">{t.title}</span><br />
        <span class="heading-accent">{t.titleSecondary}</span>
      </h2>
    </div>
    <TestimonialSlider hero={heroTestimonials} secondary={secondaryTestimonials} />
  </div>
</section>
