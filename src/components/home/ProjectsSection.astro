---
import ProjectCard from '../ui/ProjectCard.astro';
import ProjectCover from '../ui/ProjectCover.astro';
import Icon from '../ui/Icon.astro';
import { projectChrome, type SectionStrings } from '../../data/locales';
import type { SiteLocale } from '../../data/locale-codes';
import { accentHeading } from '../../lib/editorial';

type ProjectItem = {
  cover: 'relora' | 'ads-ai' | 'kamperownia' | 'notch';
  title: string;
  description: string;
  tags: string[];
  href: string;
  problem: string;
  system: string;
  artifact: string;
  outcome: string;
  external: boolean;
  screenshot?: string;
};

interface Props {
  i18n?: SectionStrings['work'];
  locale?: SiteLocale;
  /** Override the default (English) project list, e.g. for the Arabic page. */
  projects?: ProjectItem[];
  /** Override chrome labels (Problem/System/…), e.g. for locales not in projectChrome. */
  chrome?: (typeof projectChrome)['en'];
}

const { i18n, locale = 'en', projects: projectsProp, chrome: chromeProp } = Astro.props;
const chrome = chromeProp ?? projectChrome[locale];
const cardLabels = {
  problem: chrome.problem,
  system: chrome.system,
  artifact: chrome.artifact,
  outcome: chrome.outcome,
  viewProject: chrome.viewProject,
  explore: chrome.explore,
};
const t = {
  eyebrow: i18n?.eyebrow ?? 'Selected work',
  title: i18n?.title ?? 'Projects that shipped.',
  titleSecondary: i18n?.titleSecondary ?? 'Systems that still run.',
  allLink: i18n?.allLink ?? 'All work →',
  ctaEyebrow: i18n?.ctaEyebrow ?? 'Work with me',
  ctaHeading: i18n?.ctaHeading ?? 'Have a revenue problem worth solving?',
  ctaBody: i18n?.ctaBody ?? 'Book a 30-minute call. We figure out what\'s broken and whether it\'s worth working together.',
  ctaLink: i18n?.ctaLink ?? 'Book a call →',
};

const defaultProjects: ProjectItem[] = [
  {
    cover: 'relora' as const,
    screenshot: '/images/work/relora.webp',
    title: 'Relora',
    description: 'A relationship operating system for local-government property teams. One place for contacts, owner context, communication status, and next actions.',
    tags: ['AI workflow', 'CRM-lite', 'Ops dashboard'],
    href: 'https://relora-jet.vercel.app/',
    problem: 'Important owner conversations lived across inboxes, notes, and memory.',
    system: 'Contacts, relationships, briefs, status, and follow-up in one operator view.',
    artifact: 'Live demo app with dashboard, relation map, and task flow.',
    outcome: 'Manual relationship tracking becomes a structured operating queue.',
    external: true,
  },
  {
    cover: 'ads-ai' as const,
    screenshot: '/images/work/ad-assistant.webp',
    title: 'AdsAI / Ad Assistant',
    description: 'An AI-native Google Ads cockpit: spend, ROAS, ICP fit, campaign priorities, and next-best actions in one workspace.',
    tags: ['AI', 'Ads', 'GTM', 'Operator tooling'],
    href: 'https://ads-assistant-three.vercel.app/',
    problem: 'Ad optimization work was split between reports, intuition, and repeated checks.',
    system: 'Budget, ICP, ROAS, alerts, and actions are pulled into one decision loop.',
    artifact: 'Live dashboard with campaign priorities and optimization queue.',
    outcome: 'Operator sees what to pause, analyze, or optimize without hunting through reports.',
    external: true,
  },
  {
    cover: 'kamperownia' as const,
    screenshot: '/images/work/kamperownia.webp',
    title: 'Camper Rental Booking Engine',
    description: 'A self-serve camper rental site for browsing vehicles, checking dates, and moving from interest to reservation quickly.',
    tags: ['Product', 'Booking', 'Web app'],
    href: 'https://camper-rental-weld.vercel.app/',
    problem: 'Rental demand needed a clearer path from browsing to booking.',
    system: 'Inventory, dates, offer framing, and reservation CTA in one front-end flow.',
    artifact: 'Responsive booking website with vehicle cards and search entry point.',
    outcome: 'A manual inquiry motion becomes a productized booking experience.',
    external: true,
  },
  {
    cover: 'notch' as const,
    screenshot: '/images/work/notch.webp',
    title: 'NotchCue',
    description: 'A macOS teleprompter concept for calls, demos, and recordings. Keeps notes close to the camera so delivery stays natural.',
    tags: ['macOS', 'Swift', 'AI-built'],
    href: '/apps/notch/',
    problem: 'Notes sit away from the camera, which breaks eye contact during calls and demos.',
    system: 'Prompts live around the MacBook notch with a focused reading surface.',
    artifact: 'Product site and app concept built around the camera area.',
    outcome: 'Speakers keep structure without sounding like they are reading.',
    external: false,
  },
];

const projects = projectsProp ?? defaultProjects;
const featured = projects[0];
const rest = projects.slice(1);
---

<section id="work" class="relative py-[var(--space-section)] bg-[var(--color-surface-2)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Header -->
    <div class="reveal-up flex items-end justify-between mb-12 ed-rule pt-6" data-reveal-index="0">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.eyebrow}</span>
        </div>
        <h2 class="text-[length:var(--text-h2)] font-normal leading-[1.12] tracking-[-0.015em]">
          <span class="text-[var(--color-text)]">{t.title}</span><br />
          <span class="text-[var(--color-text)]">{accentHeading(t.titleSecondary).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.titleSecondary).mark}</span>
        </h2>
      </div>
      <a href="/work/" class="obs-label-accent hover:text-[var(--color-text)] transition-colors hidden sm:block shrink-0 ml-4">
        {t.allLink}
      </a>
    </div>

    <!-- Featured project: proof-led split view -->
    <a
      href={featured.href}
      target={featured.external ? '_blank' : undefined}
      rel={featured.external ? 'noopener noreferrer' : undefined}
      class="reveal-scale group block obs-panel obs-glow overflow-hidden card-lift mb-5"
    >
      <div class="grid min-h-[360px] lg:grid-cols-2">
        <!-- Left: generated cover -->
        <div class="artifact-stage relative min-h-[260px] overflow-hidden p-5 md:p-8">
          <div class="h-full min-h-[220px] overflow-hidden rounded-[14px] transition-transform duration-500 group-hover:scale-[1.012]">
            {featured.screenshot
              ? <img src={featured.screenshot} alt="" width="1456" height="1088" loading="lazy" decoding="async" class="h-full w-full object-cover object-center" />
              : <ProjectCover cover={featured.cover} />}
          </div>
          {!featured.screenshot && <div class="artifact-fade absolute inset-x-0 bottom-0 h-2/5" aria-hidden="true"></div>}
        </div>

        <!-- Right: content -->
        <div class="p-8 md:p-10 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-6">
              <svg viewBox="0 0 24 24" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21a48.25 48.25 0 01-8.135-.687c-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="obs-label-accent">{chrome.featured}</span>
            </div>
            <h3 class="text-fluid-xl font-semibold text-[var(--color-text)] leading-snug mb-4 group-hover:text-[var(--color-accent-hi)] transition-colors">
              {featured.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
              {featured.description}
            </p>
            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
              {featured.tags.map((tag) => (
                <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-dim)] [&:not(:first-child)]:before:content-['·'] [&:not(:first-child)]:before:mr-2.5 [&:not(:first-child)]:before:text-[var(--color-border)]">{tag}</span>
              ))}
            </div>
            <dl class="mt-7 grid gap-4 border-t border-[var(--color-border)] pt-6">
              {[
                [chrome.problem, featured.problem],
                [chrome.system,  featured.system],
                [chrome.artifact, featured.artifact],
                [chrome.outcome, featured.outcome],
              ].map(([label, value]) => (
                <div class="grid grid-cols-[88px_1fr] gap-4">
                  <dt class="obs-label">{label}</dt>
                  <dd class="text-sm leading-snug text-[var(--color-text-muted)]">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="mt-8 pt-6 border-t border-[var(--color-border)]">
            <span class="text-sm font-medium text-[var(--color-accent-hi)] group-hover:text-[var(--color-text)] transition-colors">
              {featured.external ? `${chrome.viewProject} ↗` : `${chrome.caseStudy} →`}
            </span>
          </div>
        </div>
      </div>
    </a>

    <!-- Remaining projects: 3-column grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {rest.map((p, index) => (
        <div class={index >= 2 ? 'hidden sm:block' : ''}>
          <ProjectCard
            cover={p.cover}
            title={p.title}
            description={p.description}
            tags={p.tags}
            href={p.href}
            screenshot={p.screenshot}
            problem={p.problem}
            system={p.system}
            artifact={p.artifact}
            outcome={p.outcome}
            external={p.external}
            labels={cardLabels}
            revealIndex={index + 1}
          />
        </div>
      ))}

      <!-- CTA card -->
      <a
        href="/contact/#book-call"
        data-cal-link="wojciech-luszczynski/30min"
        class="group flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 p-8 card-lift hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-accent)]/8 transition-colors sm:col-span-2 lg:col-span-3 lg:flex-row lg:items-end lg:gap-8"
      >
        <div class="max-w-xl">
          <span class="obs-label-accent mb-5 block">{t.ctaEyebrow}</span>
          <h3 class="text-lg font-semibold text-[var(--color-text)] leading-snug mb-3 group-hover:text-[var(--color-accent-hi)] transition-colors">
            {t.ctaHeading}
          </h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-snug">
            {t.ctaBody}
          </p>
        </div>
        <div class="btn-press obs-mono mt-8 inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] transition-colors group-hover:bg-[var(--color-accent-cta-hi)] lg:mt-0 lg:self-auto">
          <span>{t.ctaLink.replace(' →', '').replace(' ←', '')}</span>
          <Icon name="arrow-right" class="rtl-flip-x h-[13px] w-[13px]" />
        </div>
      </a>
    </div>

  </div>
</section>
