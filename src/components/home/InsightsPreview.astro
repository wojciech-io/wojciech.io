---
import { getCollection } from 'astro:content';
import { insightSlug, isLocalePost, sortInsights } from '../../lib/insights';
import ArticleCover from '../ui/ArticleCover.astro';
import type { SectionStrings } from '../../data/locales';

interface Props {
  i18n?: SectionStrings['writing'];
}

const { i18n } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'Writing',
  title: i18n?.title ?? 'Operator notes.',
  allLink: i18n?.allLink ?? 'All writing →',
  readLink: i18n?.readLink ?? 'Read →',
  ctaBody: i18n?.ctaBody ?? 'New notes on AI systems, GTM architecture, and shipped products, published as they are ready.',
};

const posts = (await getCollection('insights', isLocalePost('en')))
  .sort(sortInsights)
  .slice(0, 3);
---

<section class="relative py-[var(--space-section)] bg-gradient-to-b from-[var(--color-bg)] to-[var(--color-surface-2)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="reveal-up flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-reveal-index="0">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4 flex items-center gap-2.5">
          <span class="inline-block w-2 h-2 rounded-sm bg-[var(--color-accent)] rotate-45 opacity-80" aria-hidden="true"></span>
          <span>{t.eyebrow}</span>
        </p>
        <h2 class="text-[length:var(--text-h2)] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
          {t.title}
        </h2>
      </div>
      <p class="text-sm text-[var(--color-text-muted)] max-w-sm leading-relaxed md:text-right">
        Practical writing on AI GTM systems, agent tooling, portfolio builds, and case studies from shipped apps.
      </p>
    </div>

    <!-- Featured first article (large card) -->
    {posts[0] && (
      <a
        href={`/insights/${insightSlug(posts[0])}/`}
        class="reveal-up group block mb-8 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift"
        data-reveal-index="0"
      >
        <div class="grid md:grid-cols-[1.2fr_1fr] gap-0">
          <div class="relative aspect-[16/9] md:aspect-auto overflow-hidden bg-[#0c0c0c]">
            {posts[0].data.coverImage ? (
              <img
                src={posts[0].data.coverImage}
                alt={`Cover: ${posts[0].data.title}`}
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <ArticleCover coverType={posts[0].data.coverType} compact />
            )}
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-accent)]">
                {posts[0].data.category ?? 'Insight'}
              </span>
              <span class="text-xs text-[var(--color-text-dim)]">
                {new Date(posts[0].data.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 class="text-xl md:text-2xl font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors mb-3">
              {posts[0].data.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 line-clamp-3">
              {posts[0].data.description}
            </p>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent-hi)] transition-colors">
              {t.readLink}
            </span>
          </div>
        </div>
      </a>
    )}

    <!-- Two smaller cards -->
    <div class="grid sm:grid-cols-2 gap-6">
      {posts.slice(1).map((post, index) => (
        <a
          href={`/insights/${insightSlug(post)}/`}
          class="reveal-up group block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift"
          data-reveal-index={index + 1}
        >
          <div class="relative aspect-[16/9] overflow-hidden bg-[#0c0c0c]">
            {post.data.coverImage ? (
              <img
                src={post.data.coverImage}
                alt={`Cover: ${post.data.title}`}
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <ArticleCover coverType={post.data.coverType} compact />
            )}
          </div>
          <div class="p-5">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-accent)]">
                {post.data.category ?? 'Insight'}
              </span>
              <span class="text-xs text-[var(--color-text-dim)]">
                {new Date(post.data.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 class="text-base font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors mb-2">
              {post.data.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2 mb-4">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {(post.data.tags ?? []).slice(0, 3).map((tag: string) => (
                <span class="text-[10px] px-2 py-0.5 rounded-full border bg-[var(--color-glass)] text-[var(--color-text-dim)] border-[var(--color-border)]">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="mt-10 pt-8 border-t border-[var(--color-border)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <p class="text-sm text-[var(--color-text-muted)]">
        {t.ctaBody}
      </p>
      <a
        href="/insights/"
        class="btn-press inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] bg-[var(--color-accent-cta)] rounded-[var(--radius-btn)] px-6 py-2.5 hover:opacity-90 transition-opacity whitespace-nowrap"
      >
        {t.allLink}
      </a>
    </div>

  </div>
</section>
