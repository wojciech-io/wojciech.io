---
import { getCollection } from 'astro:content';
import { insightSlug, isLocalePost, sortInsights } from '../../lib/insights';
import ArticleCover from '../ui/ArticleCover.astro';
import type { SectionStrings } from '../../data/locales';

interface Props {
  i18n?: SectionStrings['writing'];
}

const { i18n } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'Writing',
  title: i18n?.title ?? 'Operator notes.',
  allLink: i18n?.allLink ?? 'All writing →',
  readLink: i18n?.readLink ?? 'Read →',
  ctaBody: i18n?.ctaBody ?? 'New notes on AI systems, GTM architecture, and shipped products, published as they are ready.',
};

const posts = (await getCollection('insights', isLocalePost('en')))
  .sort(sortInsights)
  .slice(0, 5);
---

<section class="relative py-[var(--space-section)]">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="reveal-up flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10" data-reveal-index="0">
      <div>
        <span class="obs-label-accent mb-4 block">// {t.eyebrow.toLowerCase()}</span>
        <h2 class="text-[length:var(--text-h2)] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
          {t.title}
        </h2>
      </div>
      <a
        href="/insights/"
        class="obs-mono text-xs font-medium uppercase tracking-wider text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      >
        {t.allLink}
      </a>
    </div>

    <!-- Featured article -->
    {posts[0] && (
      <a
        href={`/insights/${insightSlug(posts[0])}/`}
        class="reveal-up group block mb-6 obs-panel obs-glow overflow-hidden card-lift"
        data-reveal-index="0"
      >
        <div class="grid md:grid-cols-[1.2fr_1fr] gap-0">
          <div class="relative aspect-[16/9] md:aspect-auto overflow-hidden bg-[var(--color-surface-2)]">
            {posts[0].data.coverImage ? (
              <img
                src={posts[0].data.coverImage}
                alt={`Cover: ${posts[0].data.title}`}
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            ) : (
              <ArticleCover coverType={posts[0].data.coverType} compact />
            )}
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="obs-label-accent">{posts[0].data.category ?? 'Insight'}</span>
              <span class="obs-mono text-[10px] text-[var(--color-text-dim)]">
                {new Date(posts[0].data.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 class="text-xl md:text-2xl font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors mb-3">
              {posts[0].data.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 line-clamp-3">
              {posts[0].data.description}
            </p>
            <span class="obs-mono text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent-hi)] transition-colors">
              {t.readLink}
            </span>
          </div>
        </div>
      </a>
    )}

    <!-- Log-table entries -->
    <div class="obs-panel overflow-hidden divide-y divide-[var(--color-border)]">
      {posts.slice(1).map((post) => (
        <a
          href={`/insights/${insightSlug(post)}/`}
          class="reveal-up group flex items-center gap-4 px-5 py-4 hover:bg-[var(--color-surface-2)] transition-colors"
        >
          <span class="obs-mono text-[10px] text-[var(--color-text-dim)] shrink-0 w-20 hidden sm:block">
            {new Date(post.data.publishedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}
          </span>
          <span class="obs-mono text-[10px] font-medium text-[var(--color-accent-label)] uppercase shrink-0 w-16 hidden md:block">
            {post.data.category ?? 'note'}
          </span>
          <span class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors flex-1 truncate">
            {post.data.title}
          </span>
          <div class="hidden lg:flex flex-wrap gap-1.5 shrink-0">
            {(post.data.tags ?? []).slice(0, 2).map((tag: string) => (
              <span class="obs-mono text-[9px] px-2 py-0.5 rounded border text-[var(--color-text-dim)] border-[var(--color-border)] bg-transparent">{tag}</span>
            ))}
          </div>
          <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors shrink-0 opacity-0 group-hover:opacity-100" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- Footer -->
    <div class="mt-8 flex items-center justify-between">
      <p class="text-sm text-[var(--color-text-muted)] max-w-md">
        {t.ctaBody}
      </p>
      <a
        href="https://subscribe.wojciech.io"
        class="btn-press obs-mono text-xs font-bold uppercase tracking-wider text-[var(--color-accent-text)] bg-[var(--color-accent-cta)] rounded-[var(--radius-btn)] px-5 py-2.5 hover:bg-[var(--color-accent-cta-hi)] transition-colors whitespace-nowrap hidden sm:inline-flex"
      >
        Subscribe
      </a>
    </div>

  </div>
</section>
