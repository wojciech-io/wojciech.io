---
import { getCollection } from 'astro:content';
import { insightSlug, isLocalePost, readTime, sortInsights, type InsightLocale } from '../../lib/insights';
import PosterFeatured from '../insights/PosterFeatured.astro';
import PosterCard from '../insights/PosterCard.astro';
import type { SectionStrings } from '../../data/locales';
import { accentHeading } from '../../lib/editorial';

interface Props {
  i18n?: SectionStrings['writing'];
  locale?: InsightLocale;
}

const { i18n, locale = 'en' } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'Writing',
  title: i18n?.title ?? 'Operator notes.',
  allLink: i18n?.allLink ?? 'All writing →',
  readLink: i18n?.readLink ?? 'Read →',
};

const insightsBase = locale === 'pl' ? '/pl/insights' : '/insights';
const posts = (await getCollection('insights', isLocalePost(locale)))
  .sort(sortInsights)
  .slice(0, 5);
// Same poster system as the /insights index: one featured poster, then cards.
const formatDate = (date: Date) =>
  date.toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const readLabel = t.readLink.replace(/\s*[→←]\s*$/, '');
const latestLabel = locale === 'pl' ? 'Najnowszy' : 'Latest';
---

<section class="relative py-[var(--space-section)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="reveal-up flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10" data-reveal-index="0">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.eyebrow}</span>
        </div>
        <h2 class="t-h2 text-[var(--color-text)]">
          <span>{accentHeading(t.title).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.title).mark}</span>
        </h2>
      </div>
      <a
        href={`${insightsBase}/`}
        class="t-data text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      >
        {t.allLink}
      </a>
    </div>

    {posts[0] && (
      <PosterFeatured
        href={`${insightsBase}/${insightSlug(posts[0])}/`}
        title={posts[0].data.title}
        description={posts[0].data.description}
        categoryLabel={posts[0].data.category ?? 'Insight'}
        categoryKey={posts[0].data.category ?? ''}
        date={formatDate(posts[0].data.publishedAt)}
        read={readTime(posts[0].body, locale)}
        featuredLabel={latestLabel}
        readLabel={readLabel}
      />
    )}

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {posts.slice(1).map((post, i) => (
        <PosterCard
          href={`${insightsBase}/${insightSlug(post)}/`}
          title={post.data.title}
          categoryLabel={post.data.category ?? 'Insight'}
          categoryKey={post.data.category ?? ''}
          date={formatDate(post.data.publishedAt)}
          read={readTime(post.body, locale)}
          index={i + 2}
          cover={post.data.coverImage}
        />
      ))}
    </div>

  </div>
</section>
