---
import { getCollection } from 'astro:content';
import { insightSlug, isLocalePost, sortInsights, type InsightLocale } from '../../lib/insights';
import ArticleCover from '../ui/ArticleCover.astro';
import type { SectionStrings } from '../../data/locales';
import { accentHeading } from '../../lib/editorial';

interface Props {
  i18n?: SectionStrings['writing'];
  locale?: InsightLocale;
}

const { i18n, locale = 'en' } = Astro.props;
const t = {
  eyebrow: i18n?.eyebrow ?? 'Writing',
  title: i18n?.title ?? 'Operator notes.',
  allLink: i18n?.allLink ?? 'All writing →',
  readLink: i18n?.readLink ?? 'Read →',
  ctaBody: i18n?.ctaBody ?? 'New notes on AI systems, GTM architecture, and shipped products, published as they are ready.',
};

const insightsBase = locale === 'pl' ? '/pl/insights' : '/insights';
const posts = (await getCollection('insights', isLocalePost(locale)))
  .sort(sortInsights)
  .slice(0, 5);
---

<section class="relative py-[var(--space-section)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="reveal-up flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10" data-reveal-index="0">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{t.eyebrow}</span>
        </div>
        <h2 class="text-[length:var(--text-h2)] font-normal leading-[1.12] tracking-[-0.015em] text-[var(--color-text)]">
          <span>{accentHeading(t.title).lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{accentHeading(t.title).mark}</span>
        </h2>
      </div>
      <a
        href={`${insightsBase}/`}
        class="obs-mono text-xs font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      >
        {t.allLink}
      </a>
    </div>

    <!-- Featured first article -->
    {posts[0] && (
      <a
        href={`${insightsBase}/${insightSlug(posts[0])}/`}
        class="reveal-up group block mb-6 obs-panel obs-glow overflow-hidden card-lift"
        data-reveal-index="0"
      >
        <div class="grid md:grid-cols-[1.2fr_1fr] gap-0">
          <div class="relative aspect-[16/9] md:aspect-auto overflow-hidden bg-[var(--color-surface-2)]">
            {posts[0].data.coverImage ? (
              <img
                src={posts[0].data.coverImage}
                alt={`Cover: ${posts[0].data.title}`}
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <ArticleCover coverType={posts[0].data.coverType} compact />
            )}
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="obs-badge">{posts[0].data.category ?? 'Insight'}</span>
              <span class="obs-mono text-[10px] text-[var(--color-text-dim)]">
                {new Date(posts[0].data.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 class="text-fluid-xl font-semibold leading-snug text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors mb-3">
              {posts[0].data.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-5 line-clamp-3">
              {posts[0].data.description}
            </p>
            <span class="obs-mono text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent-hi)] transition-colors">
              {t.readLink}
            </span>
          </div>
        </div>
      </a>
    )}

    <!-- Log: flat editorial ledger (hairline rows, flush to the column) -->
    <div class="border-t border-[var(--color-border)]">
      <div class="hidden sm:grid grid-cols-[100px_1fr_120px_40px] gap-4 py-2.5 border-b border-[var(--color-border)]">
        <span class="obs-label">date</span>
        <span class="obs-label">title</span>
        <span class="obs-label">category</span>
        <span></span>
      </div>
      {posts.slice(1).map((post, index) => (
        <a
          href={`${insightsBase}/${insightSlug(post)}/`}
          class="reveal-up group grid sm:grid-cols-[100px_1fr_120px_40px] gap-2 sm:gap-4 py-3.5 border-b border-[var(--color-border)] transition-colors"
          data-reveal-index={index + 1}
        >
          <span class="obs-mono text-xs text-[var(--color-text-dim)] self-center">
            {new Date(post.data.publishedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}
          </span>
          <span class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors self-center">
            {post.data.title}
          </span>
          <span class="hidden sm:block self-center">
            <span class="obs-badge">{post.data.category ?? 'Insight'}</span>
          </span>
          <span class="hidden sm:flex items-center justify-end text-[var(--color-text-dim)] group-hover:text-[var(--color-accent-hi)] transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </span>
        </a>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <p class="text-sm text-[var(--color-text-muted)]">{t.ctaBody}</p>
      <a
        href={`${insightsBase}/`}
        class="btn-press obs-mono inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-text)] bg-[var(--color-accent-cta)] rounded-[var(--radius-btn)] px-6 py-2.5 hover:bg-[var(--color-accent-cta-hi)] transition-colors whitespace-nowrap"
      >
        {t.allLink}
      </a>
    </div>

  </div>
</section>
