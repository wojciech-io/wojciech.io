---
const nodes = [
  {
    id: 'diagnose',
    step: '01',
    label: 'Diagnose',
    meta: 'Pipeline signal',
    value: 'Leak map',
    detail: 'ICP, source quality, CRM hygiene, attribution, and sales motion get mapped before any tools change.',
  },
  {
    id: 'enrich',
    step: '02',
    label: 'Enrich',
    meta: 'Accounts + context',
    value: '247 inputs',
    detail: 'Prospects, keywords, category signals, CRM fields, and intent cues become one usable operating layer.',
  },
  {
    id: 'sequence',
    step: '03',
    label: 'Sequence',
    meta: 'Outbound + content',
    value: '12 high fit',
    detail: 'Messaging, offers, and follow-up paths are generated against the system, not from a blank prompt.',
  },
  {
    id: 'crm',
    step: '04',
    label: 'CRM',
    meta: 'Execution layer',
    value: 'Synced',
    detail: 'The model ends inside the workflow: CRM updates, tasks, dashboards, and next actions.',
  },
];
---

<div class="hero-system animate-scale-in [animation-delay:120ms]" aria-label="Interactive revenue system canvas">
  <div class="hero-system__topbar">
    <div>
      <p class="hero-system__eyebrow">Operating model</p>
      <p class="hero-system__title">Revenue system canvas</p>
    </div>
    <div class="hero-system__run">
      <span class="hero-system__run-dot"></span>
      Live map
    </div>
  </div>

  <div class="hero-system__stage">
    <svg class="hero-system__wires" viewBox="0 0 520 360" aria-hidden="true">
      <path class="hero-system__wire hero-system__wire--a" d="M124 95 C210 38 326 42 400 104" />
      <path class="hero-system__wire hero-system__wire--b" d="M405 112 C474 176 454 272 356 303" />
      <path class="hero-system__wire hero-system__wire--c" d="M340 304 C238 338 126 292 96 202" />
      <path class="hero-system__wire hero-system__wire--d" d="M96 186 C70 142 82 112 124 95" />
      <path class="hero-system__wire hero-system__wire--pulse" d="M124 95 C210 38 326 42 400 104 C474 176 454 272 356 303 C238 338 126 292 96 202 C70 142 82 112 124 95" />
    </svg>

    <div class="hero-system__operator">
      <div class="hero-system__portrait">
        <img
          src="/images/wojciech-cutout.webp"
          alt="Wojciech Łuszczyński"
          width="2048"
          height="1366"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-system__operator-copy">
        <span>Operator</span>
        <strong>builds the missing layer</strong>
      </div>
    </div>

    {nodes.map((node, index) => (
      <button
        class={`hero-system__node hero-system__node--${node.id} ${index === 0 ? 'is-active' : ''}`}
        type="button"
        data-system-node={node.id}
        data-label={node.label}
        data-meta={node.meta}
        data-value={node.value}
        data-detail={node.detail}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span>{node.step}</span>
        <strong>{node.label}</strong>
      </button>
    ))}
  </div>

  <div class="hero-system__inspector" aria-live="polite">
    <div>
      <p class="hero-system__inspector-kicker" data-system-meta>{nodes[0].meta}</p>
      <h2 data-system-label>{nodes[0].label}</h2>
      <p data-system-detail>{nodes[0].detail}</p>
    </div>
    <div class="hero-system__metric">
      <span data-system-value>{nodes[0].value}</span>
      <small>current layer</small>
    </div>
  </div>

  <div class="hero-system__footer" aria-label="Revenue system outputs">
    <span>ICP signal</span>
    <span>CRM model</span>
    <span>AI workflow</span>
  </div>
</div>

<script>
  const canvases = document.querySelectorAll('.hero-system');

  canvases.forEach((canvas) => {
    const nodes = Array.from(canvas.querySelectorAll<HTMLButtonElement>('[data-system-node]'));
    const label = canvas.querySelector<HTMLElement>('[data-system-label]');
    const meta = canvas.querySelector<HTMLElement>('[data-system-meta]');
    const detail = canvas.querySelector<HTMLElement>('[data-system-detail]');
    const value = canvas.querySelector<HTMLElement>('[data-system-value]');

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        nodes.forEach((item) => {
          item.classList.remove('is-active');
          item.setAttribute('aria-pressed', 'false');
        });

        node.classList.add('is-active');
        node.setAttribute('aria-pressed', 'true');

        if (label) label.textContent = node.dataset.label || '';
        if (meta) meta.textContent = node.dataset.meta || '';
        if (detail) detail.textContent = node.dataset.detail || '';
        if (value) value.textContent = node.dataset.value || '';
      });
    });
  });
</script>

<style>
  .hero-system {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-border-2) 72%, transparent);
    border-radius: var(--radius-card);
    background:
      radial-gradient(circle at 50% 18%, rgb(235 255 0 / 0.12), transparent 32%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.015)),
      var(--color-surface);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.36);
  }

  .hero-system::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
  }

  .hero-system__topbar,
  .hero-system__inspector,
  .hero-system__footer {
    position: relative;
    z-index: 2;
  }

  .hero-system__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    background: rgb(12 12 12 / 0.36);
    backdrop-filter: blur(14px);
  }

  .hero-system__eyebrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-system__title {
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-system__run {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 28%, transparent);
    border-radius: var(--radius-badge);
    padding: 0.38rem 0.62rem;
    color: var(--color-accent-hi);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    background: rgb(235 255 0 / 0.055);
  }

  .hero-system__run-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 18px rgb(235 255 0 / 0.65);
  }

  .hero-system__stage {
    position: relative;
    min-height: 360px;
  }

  .hero-system__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-system__wire {
    fill: none;
    stroke: rgb(235 255 0 / 0.2);
    stroke-width: 1.2;
  }

  .hero-system__wire--pulse {
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 32 520;
    filter: drop-shadow(0 0 14px rgb(235 255 0 / 0.36));
    animation: system-flow 6s linear infinite;
  }

  .hero-system__operator {
    position: absolute;
    left: 50%;
    top: 48%;
    width: 190px;
    transform: translate(-50%, -50%);
  }

  .hero-system__portrait {
    position: relative;
    height: 210px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-accent) 28%, var(--color-border));
    border-radius: 18px;
    background: linear-gradient(180deg, rgb(235 255 0 / 0.08), rgb(12 12 12 / 0.5));
  }

  .hero-system__portrait::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 44%;
    background: linear-gradient(to top, var(--color-surface), transparent);
  }

  .hero-system__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.96) contrast(1.04);
  }

  .hero-system__operator-copy {
    margin: -1.55rem auto 0;
    width: calc(100% - 1.5rem);
    position: relative;
    z-index: 2;
    border: 1px solid color-mix(in oklab, var(--color-border-2) 80%, transparent);
    border-radius: 14px;
    padding: 0.62rem 0.72rem;
    background: rgb(12 12 12 / 0.82);
    backdrop-filter: blur(12px);
  }

  .hero-system__operator-copy span {
    display: block;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-system__operator-copy strong {
    display: block;
    color: var(--color-text);
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .hero-system__node {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.18rem;
    min-width: 112px;
    border: 1px solid var(--color-border-2);
    border-radius: 16px;
    padding: 0.76rem 0.82rem;
    color: var(--color-text-muted);
    text-align: left;
    background: rgb(12 12 12 / 0.74);
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.22);
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
  }

  .hero-system__node:hover,
  .hero-system__node:focus-visible,
  .hero-system__node.is-active {
    border-color: color-mix(in oklab, var(--color-accent) 70%, transparent);
    color: var(--color-text);
    background: rgb(235 255 0 / 0.075);
    transform: translateY(-2px);
  }

  .hero-system__node span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .hero-system__node strong {
    font-size: 0.86rem;
    line-height: 1.05;
  }

  .hero-system__node--diagnose { left: 1.15rem; top: 2rem; }
  .hero-system__node--enrich { right: 1.15rem; top: 2.5rem; }
  .hero-system__node--sequence { right: 1.35rem; bottom: 2.2rem; }
  .hero-system__node--crm { left: 1.15rem; bottom: 2.4rem; }

  .hero-system__inspector {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: end;
    margin: 0 1rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 1rem;
    background: rgb(12 12 12 / 0.78);
    backdrop-filter: blur(16px);
  }

  .hero-system__inspector-kicker {
    margin-bottom: 0.28rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-system__inspector h2 {
    color: var(--color-text);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-system__inspector p:not(.hero-system__inspector-kicker) {
    margin-top: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .hero-system__metric {
    min-width: 92px;
    border-radius: 14px;
    padding: 0.72rem;
    text-align: right;
    background: rgb(235 255 0 / 0.07);
  }

  .hero-system__metric span,
  .hero-system__metric small {
    display: block;
  }

  .hero-system__metric span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }

  .hero-system__metric small {
    color: var(--color-text-dim);
    font-size: 0.65rem;
  }

  .hero-system__footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    background: rgb(12 12 12 / 0.38);
  }

  .hero-system__footer span {
    padding: 0.78rem 0.5rem;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: center;
  }

  .hero-system__footer span + span {
    border-left: 1px solid var(--color-border);
  }

  @keyframes system-flow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -552; }
  }

  @media (max-width: 1023px) {
    .hero-system {
      max-width: 620px;
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    .hero-system__topbar {
      padding: 0.85rem;
    }

    .hero-system__title {
      font-size: 0.88rem;
    }

    .hero-system__stage {
      min-height: 330px;
    }

    .hero-system__operator {
      width: 146px;
      top: 48%;
    }

    .hero-system__portrait {
      height: 165px;
      border-radius: 16px;
    }

    .hero-system__operator-copy {
      display: none;
    }

    .hero-system__node {
      min-width: 96px;
      border-radius: 14px;
      padding: 0.58rem 0.62rem;
    }

    .hero-system__node strong {
      font-size: 0.74rem;
    }

    .hero-system__node--diagnose { left: 0.75rem; top: 1.2rem; }
    .hero-system__node--enrich { right: 0.75rem; top: 1.45rem; }
    .hero-system__node--sequence { right: 0.8rem; bottom: 1.35rem; }
    .hero-system__node--crm { left: 0.75rem; bottom: 1.55rem; }

    .hero-system__inspector {
      grid-template-columns: 1fr;
      margin: 0 0.75rem 0.75rem;
      padding: 0.85rem;
    }

    .hero-system__metric {
      display: none;
    }

    .hero-system__footer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-system__wire--pulse {
      animation: none;
    }
  }
</style>
