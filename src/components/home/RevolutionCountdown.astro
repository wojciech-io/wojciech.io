---
import { getLocaleFromPath } from '../../data/uiStrings';
import { COUNTDOWN_COPY, COUNTDOWN_TARGET, COUNTDOWN_FROM } from '../../data/countdown';

/* Teaser band at the very top of the homepage hero: one plain sentence, the
   date, and a big live clock. Says nothing about what changes. Opaque, full
   width, hairline below (DESIGN.md: rules, not boxes). Hides itself after the
   date. */
const locale = getLocaleFromPath(Astro.url.pathname);
const c = COUNTDOWN_COPY[locale] ?? COUNTDOWN_COPY.en;
const units = [
  { k: 'd', label: c.d },
  { k: 'h', label: c.h },
  { k: 'm', label: c.m },
  { k: 's', label: c.s },
];
---

<section class="rv" data-countdown={COUNTDOWN_TARGET} data-countdown-from={COUNTDOWN_FROM} aria-label={`${c.label}: ${c.date}`}>
  <div class="rv-grid" aria-hidden="true"></div>
  <div class="rv-aura" aria-hidden="true"></div>
  <div class="rv-in">
    <div class="rv-copy">
      <p class="rv-kick"><span class="rv-dot" aria-hidden="true"></span>{c.label} · {c.date}</p>
      <h2 class="rv-title t-h2">{c.title}<span class="rv-mark" aria-hidden="true">.</span></h2>
      <p class="rv-sub">{c.sub}</p>
    </div>
    <p class="sr-only" role="timer" aria-live="off">{c.sr}</p>
    <dl class="rv-clock" aria-hidden="true">
      {units.map((u, i) => (
        <>
          {i > 0 && <span class="rv-sep">:</span>}
          <div class="rv-cell" data-unit={u.k}>
            <dd data-cd={u.k}>--</dd>
            <dt>{u.label}</dt>
          </div>
        </>
      ))}
    </dl>
  </div>
  <div class="rv-bar" aria-hidden="true"><i data-cd-bar></i></div>
  <div class="rv-marq" aria-hidden="true"><div class="rv-track">{[0, 1].map(() => (<span>{Array.from({ length: 6 }).map(() => (<><b>24.11</b><em>{c.title}</em></>))}</span>))}</div></div>
</section>

<script>
  import { COUNTDOWN_TARGET, COUNTDOWN_FROM } from '../../data/countdown';

  let timer = 0;
  const pad = (n: number) => String(n).padStart(2, '0');

  const initCountdown = () => {
    window.clearInterval(timer);
    const roots = document.querySelectorAll<HTMLElement>('[data-countdown]');
    if (!roots.length) return;
    const end = new Date(COUNTDOWN_TARGET).getTime();
    const tick = () => {
      const left = end - Date.now();
      if (left <= 0) {
        window.clearInterval(timer);
        roots.forEach((el) => { el.style.display = 'none'; });
        return;
      }
      const s = Math.floor(left / 1000);
      const vals: Record<string, string> = {
        d: pad(Math.floor(s / 86400)),
        h: pad(Math.floor((s % 86400) / 3600)),
        m: pad(Math.floor((s % 3600) / 60)),
        s: pad(s % 60),
      };
      document.querySelectorAll<HTMLElement>('[data-cd]').forEach((el) => {
        el.textContent = vals[el.dataset.cd ?? 'd'];
      });
      const from = new Date(COUNTDOWN_FROM).getTime();
      const done = Math.min(1, Math.max(0, (Date.now() - from) / (end - from)));
      document.querySelectorAll<HTMLElement>('[data-cd-bar]').forEach((el) => { el.style.transform = `scaleX(${done})`; });
    };
    tick();
    timer = window.setInterval(tick, 1000);
  };
  initCountdown();
  document.addEventListener('astro:page-load', initCountdown);
</script>

<style>
  /* A poster band: always ink, in both themes. Grid and a lime aura for depth,
     a thin progress line, and a slow ticker of the date. */
  .rv {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-text);
    border-bottom: 1px solid var(--color-ink-border);
  }
  .rv-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(244 243 239 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(244 243 239 / 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 80% 120% at 85% 40%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 80% 120% at 85% 40%, #000 20%, transparent 80%);
  }
  .rv-aura {
    position: absolute;
    right: -10%;
    top: -60%;
    width: 60%;
    height: 220%;
    background: radial-gradient(closest-side, rgb(235 255 0 / 0.17), transparent);
    pointer-events: none;
  }
  .rv-in {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.9rem 1.5rem 2rem;
  }
  .rv-kick {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-cta);
  }
  .rv-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent-cta);
    box-shadow: 0 0 12px rgb(235 255 0 / 0.7);
    animation: rv-pulse 2.4s ease-in-out infinite;
  }
  .rv-title {
    margin: 0.7rem 0 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.8rem, 4.4vw, 2.9rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-ink-text);
  }
  .rv-mark {
    color: var(--color-accent-cta);
  }
  .rv-sub {
    margin: 0;
    max-width: 28rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .rv-clock {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4rem;
    margin: 0;
  }
  .rv-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .rv-cell dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(2.3rem, 11.5vw, 5.4rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-text);
  }
  .rv-cell[data-unit='s'] dd {
    font-weight: 500;
    color: var(--color-accent-cta);
    text-shadow: 0 0 30px rgb(235 255 0 / 0.4);
  }
  .rv-cell dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .rv-sep {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: clamp(2.3rem, 11.5vw, 5.4rem);
    line-height: 0.95;
    color: rgb(244 243 239 / 0.28);
  }
  .rv-bar {
    position: relative;
    height: 2px;
    background: var(--color-ink-border);
  }
  .rv-bar i {
    position: absolute;
    inset: 0;
    background: var(--color-accent-cta);
    box-shadow: 0 0 12px rgb(235 255 0 / 0.6);
    transform: scaleX(0);
    transform-origin: left;
  }
  .rv-marq {
    position: relative;
    overflow: hidden;
    padding: 0.7rem 0;
    white-space: nowrap;
    border-top: 1px solid var(--color-ink-border);
    background: rgb(244 243 239 / 0.025);
  }
  .rv-track {
    display: inline-flex;
    animation: rv-slide 46s linear infinite;
  }
  .rv-track span {
    display: inline-flex;
    flex: none;
  }
  .rv-track b,
  .rv-track em {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-style: normal;
    padding-right: 2.2rem;
  }
  .rv-track b {
    font-weight: 500;
    color: var(--color-accent-cta);
  }
  .rv-track em {
    color: var(--color-ink-muted);
  }
  @media (min-width: 900px) {
    .rv-in {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      padding-top: 2.4rem;
      padding-bottom: 2.5rem;
    }
    .rv-copy {
      flex: 1 1 auto;
      min-width: 27rem;
    }
    .rv-title {
      font-size: clamp(2rem, 3.2vw, 2.6rem);
      white-space: nowrap;
    }
    .rv-clock {
      justify-content: flex-end;
      gap: 0.9rem;
    }
    .rv-cell dd,
    .rv-sep {
      font-size: clamp(3rem, 5.2vw, 4.7rem);
    }
  }
  @keyframes rv-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  @keyframes rv-slide {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-dot,
    .rv-track { animation: none; }
  }
</style>
