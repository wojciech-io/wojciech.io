---
import { getLocaleFromPath } from '../../data/uiStrings';
import { COUNTDOWN_COPY, COUNTDOWN_TARGET } from '../../data/countdown';

/* Hero teaser: a live countdown to the date, one lime mark, no hint of what
   changes. Rules and mono numerals, no box (DESIGN.md). It hides itself once
   the date has passed. */
const locale = getLocaleFromPath(Astro.url.pathname);
const c = COUNTDOWN_COPY[locale] ?? COUNTDOWN_COPY.en;
const units = [
  { k: 'd', label: c.d },
  { k: 'h', label: c.h },
  { k: 'm', label: c.m },
  { k: 's', label: c.s },
];
---

<div class="reveal-up rv max-w-lg" data-reveal-index="3" data-countdown={COUNTDOWN_TARGET}>
  <div class="rv-head">
    <span class="rv-dot" aria-hidden="true"></span>
    <span class="obs-label-accent">{c.label} · {c.date}</span>
  </div>
  <p class="rv-title">{c.title}<span class="rv-mark" aria-hidden="true">.</span></p>
  <p class="sr-only" role="timer" aria-live="off" data-cd-sr>{c.sr}</p>
  <dl class="rv-grid" aria-hidden="true">
    {units.map((u) => (
      <div class="rv-cell">
        <dt>{u.label}</dt>
        <dd data-cd={u.k}>--</dd>
      </div>
    ))}
  </dl>
</div>

<script>
  import { COUNTDOWN_TARGET } from '../../data/countdown';

  let timer = 0;
  const pad = (n: number) => String(n).padStart(2, '0');

  const initCountdown = () => {
    window.clearInterval(timer);
    const roots = document.querySelectorAll<HTMLElement>('[data-countdown]');
    if (!roots.length) return;
    const end = new Date(COUNTDOWN_TARGET).getTime();
    const tick = () => {
      const left = end - Date.now();
      if (left <= 0) {
        window.clearInterval(timer);
        document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => { el.style.display = 'none'; });
        return;
      }
      const s = Math.floor(left / 1000);
      const vals: Record<string, string> = {
        d: String(Math.floor(s / 86400)),
        h: pad(Math.floor((s % 86400) / 3600)),
        m: pad(Math.floor((s % 3600) / 60)),
        s: pad(s % 60),
      };
      document.querySelectorAll<HTMLElement>('[data-cd]').forEach((el) => {
        el.textContent = vals[el.dataset.cd ?? 'd'];
      });
    };
    tick();
    timer = window.setInterval(tick, 1000);
  };
  initCountdown();
  document.addEventListener('astro:page-load', initCountdown);
</script>

<style>
  .rv {
    border-top: 1px solid var(--color-border);
    padding-top: 1.1rem;
  }
  .rv-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .rv-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent-cta);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-cta) 60%, transparent);
    animation: rv-pulse 2.4s ease-in-out infinite;
  }
  .rv-title {
    margin: 0.55rem 0 0.9rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-text);
  }
  .rv-mark {
    color: var(--color-accent-cta);
  }
  .rv-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .rv-cell {
    padding: 0 0.9rem;
    border-left: 1px solid var(--color-border);
  }
  .rv-cell:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .rv-cell dt {
    order: 2;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .rv-cell dd {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 4.6vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .rv-cell {
    display: flex;
    flex-direction: column;
  }
  @keyframes rv-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-dot { animation: none; }
  }
</style>
