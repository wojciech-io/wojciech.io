---
/* Editorial metrics strip. Numerals render in Geist at display weight (tabular
   lining figures) — safe in every locale because digits are shared across
   languages; the labels stay in mono. Prop-driven so EN and localized homepages
   render identically. Defaults carry the English copy. */
interface Metric { value: string; label: string }
interface Props { metrics?: Metric[]; indexLabel?: string }

const {
  metrics = [
    { value: '20', label: 'years marketing & digital' },
    { value: '10', label: 'years B2B SaaS' },
    { value: '10', label: 'years GTM' },
    { value: '3×', label: 'avg. pipeline lift' },
  ],
  indexLabel = '',
} = Astro.props as Props;
---

<section class="relative section-fade py-10 md:py-14">
  <div class="mx-auto max-w-6xl px-6">
    {indexLabel && (
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label">{indexLabel}</span>
      </div>
    )}
    <!-- One card per metric: same radius/border/surface language as the rest of
         the site, an accent tick on top of each so the row reads as four
         deliberate proof points instead of one flat rectangle. -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
      {metrics.map(({ value, label }, index) => {
        const match = value.match(/^(\d+)(.*)$/);
        const isNumeric = match !== null;
        return (
          <div class="reveal-up flex flex-col rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-hover py-7 px-6" data-reveal-index={index}>
            <span class="mb-5 h-1 w-8 rounded-full bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
            <p
              class:list={['ed-serif text-5xl md:text-6xl text-[var(--color-text)] mb-2', isNumeric && 'metric-count']}
              {...(isNumeric ? { 'data-target': match[1], 'data-suffix': match[2] } : {})}
            >{value}</p>
            <p class="obs-label leading-snug">{label}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
