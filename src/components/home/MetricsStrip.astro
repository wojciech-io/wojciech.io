---
const metrics = [
  { value: 20, suffix: '', label: 'years marketing & digital' },
  { value: 10, suffix: '', label: 'years B2B SaaS' },
  { value: 10, suffix: '', label: 'years GTM' },
  { value: 3, suffix: '×', label: 'avg. pipeline lift' },
];
---

<section class="relative section-fade bg-[var(--color-surface-2)]">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-[var(--color-border)]">
      {metrics.map(({ value, suffix, label }, index) => (
        <div class="reveal-up flex flex-col items-center py-8 px-4 text-center" data-reveal-index={index}>
          <p class="text-3xl font-bold text-[var(--color-text)] mb-1">
            <span class="metric-count" data-target={value} data-suffix={suffix}>{value}{suffix}</span>
          </p>
          <p class="text-xs text-[var(--color-text-dim)] uppercase tracking-widest">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
