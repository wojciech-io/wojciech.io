---
---

<section class="relative overflow-hidden min-h-[480px] md:min-h-[580px] lg:min-h-[620px]">
  <!-- Subtle grid -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_340px] gap-8 lg:gap-16 items-center py-10 md:py-20 lg:py-28">

      <!-- Left: content -->
      <div class="flex flex-col justify-center lg:max-w-[560px]">

        <!-- Eyebrow -->
        <div class="inline-flex self-start items-center gap-2 mb-6 md:mb-8">
          <span class="obs-status-dot"></span>
          <span class="obs-label-accent">// GTM architect &middot; AI systems builder</span>
        </div>

        <!-- Mobile: avatar -->
        <div class="lg:hidden flex items-center gap-3 mb-5 md:mb-8">
          <img
            src="/images/wojciech-avatar-384.webp"
            alt="Wojciech Łuszczyński"
            width="56"
            height="56"
            loading="eager"
            decoding="async"
            class="w-14 h-14 rounded-full object-cover border border-[var(--color-border-2)] shrink-0"
          />
          <div>
            <p class="obs-mono text-sm font-semibold text-[var(--color-text)]">Wojciech Łuszczyński</p>
            <p class="text-xs text-[var(--color-text-muted)]">Fractional operator</p>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="reveal-up text-[length:var(--text-hero)] font-bold leading-[1.08] tracking-tight mb-4 md:mb-6" data-reveal-index="0" transition:name="page-title-home">
          <span class="text-[var(--color-text)]">I build revenue systems.</span><br class="hidden md:block" /> <span class="heading-accent">Then I run them.</span>
        </h1>

        <!-- Sub-copy -->
        <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 md:mb-10 max-w-lg" data-reveal-index="1">
          GTM, CRM, AI workflows, automation: one operating model. I build the connections that are missing, instrument everything, and stay until it compounds.
        </p>

        <!-- Buttons -->
        <div class="reveal-up flex flex-wrap gap-3 mb-5" data-reveal-index="2">
          <a
            href="/work/"
            class="btn-press obs-mono inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] text-xs font-semibold uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
          >
            See the work
          </a>
          <a
            href="https://subscribe.wojciech.io"
            class="btn-press obs-mono inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-transparent text-[var(--color-text)] text-xs font-medium uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-text)] transition-colors"
          >
            Get the newsletter
          </a>
        </div>
      </div>

      <!-- Right: status panel (desktop only) -->
      <div class="hidden lg:block">
        <div class="obs-panel obs-glow p-5 space-y-4">
          <div class="flex items-center justify-between mb-3">
            <span class="obs-label">System status</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="obs-status-dot"></span>
              <span class="obs-mono text-[10px] font-medium text-[var(--color-success)]">Operational</span>
            </span>
          </div>

          <div class="space-y-3">
            <div class="flex items-center justify-between py-1 border-b border-[var(--color-border)]">
              <span class="obs-label">surfaces</span>
              <span class="obs-mono text-sm font-semibold text-[var(--color-text)]">7</span>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-[var(--color-border)]">
              <span class="obs-label">languages</span>
              <span class="obs-mono text-sm font-semibold text-[var(--color-text)]">8</span>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-[var(--color-border)]">
              <span class="obs-label">articles</span>
              <span class="obs-mono text-sm font-semibold text-[var(--color-text)]">19</span>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-[var(--color-border)]">
              <span class="obs-label">uptime</span>
              <span class="obs-mono text-sm font-semibold text-[var(--color-accent-label)]">99.98%</span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="obs-label">stack</span>
              <span class="obs-mono text-xs text-[var(--color-text-muted)]">Astro + CF Pages</span>
            </div>
          </div>

          <!-- Progress bar -->
          <div class="mt-3">
            <div class="flex items-center justify-between mb-1">
              <span class="obs-label">pipeline coverage</span>
              <span class="obs-mono text-[10px] text-[var(--color-text-muted)]">3.2x</span>
            </div>
            <div class="h-1 bg-[var(--color-surface-2)] rounded-full overflow-hidden">
              <div class="h-full bg-[var(--color-accent-cta)] rounded-full" style="width: 82%"></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
