---
---

<section class="relative overflow-hidden min-h-[480px] md:min-h-[580px] lg:min-h-[620px]">
  <!-- Subtle grid -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
  <!-- Neutral depth behind text -->
  <div class="pointer-events-none absolute left-[-160px] top-[-180px] h-[520px] w-[640px] rounded-full bg-[var(--color-surface)] blur-[150px] opacity-70" aria-hidden="true" />

  <!-- Photo: desktop only, right half, absolute -->
  <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-[46%] overflow-hidden" aria-hidden="true">
    <img
      src="/images/wojciech-office.webp"
      alt=""
      width="900"
      height="1085"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-[center_8%]"
    />
    <!-- Left fade overlay — wider to soften photo-text boundary -->
    <div class="absolute inset-y-0 left-0 w-[42%] pointer-events-none [background:linear-gradient(to_right,var(--color-bg)_0%,var(--color-bg)_15%,transparent_100%)]" />
    <!-- Bottom fade overlay -->
    <div class="absolute inset-x-0 bottom-0 h-[22%] pointer-events-none [background:linear-gradient(to_top,var(--color-bg)_0%,transparent_100%)]" />
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="flex flex-col justify-center py-10 md:py-20 lg:py-32 md:max-w-[560px] lg:max-w-[54%]">

      <!-- Badge -->
      <div class="inline-flex self-start items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-glass)] px-3.5 py-2 mb-5 md:mb-8 shadow-[var(--shadow-card)] backdrop-blur">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_14px_rgb(235_255_0/0.55)]"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-text)]">GTM Architect · Growth Operator</span>
      </div>

      <!-- Mobile: avatar -->
      <div class="lg:hidden flex items-center gap-3 mb-5 md:mb-8">
        <img
          src="/images/wojciech-avatar-384.webp"
          alt="Wojciech Łuszczyński"
          width="56"
          height="56"
          loading="eager"
          decoding="async"
          class="w-14 h-14 rounded-full object-cover border border-[var(--color-accent)]/35 shrink-0"
        />
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)]">Wojciech Łuszczyński</p>
          <p class="text-xs text-[var(--color-text-muted)]">GTM Architect · Growth Operator</p>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="reveal-up text-[length:var(--text-hero)] font-bold leading-[1.08] tracking-tight mb-4 md:mb-6" data-reveal-index="0" transition:name="page-title-home">
        <span class="text-[var(--color-text)]">I build revenue systems.</span><br class="hidden md:block" /> <span class="text-[var(--color-text-muted)]">Then I run them.</span>
      </h1>

      <!-- Sub-copy -->
      <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 md:mb-10 max-w-lg" data-reveal-index="1">
        GTM, CRM, AI workflows, automation: one operating model. I build the connections that are missing, instrument everything, and stay until it compounds.
      </p>

      <!-- Buttons -->
      <div class="reveal-up flex flex-wrap gap-3 mb-5" data-reveal-index="2">
        <a
          href="/work/"
          class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] text-sm sm:text-base font-semibold px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          See the work
        </a>
        <a
          href="/subscribe/"
          class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[var(--color-text)] text-sm sm:text-base font-medium px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
        >
          Get the newsletter
        </a>
      </div>

    </div>
  </div>
</section>
