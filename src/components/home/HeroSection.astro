---
/* Editorial photo-cover hero (direction B). Prop-driven so the English homepage
   and every localized homepage render the same layout — only the copy differs.
   Defaults carry the English copy, so `<HeroSection />` (the EN page) works with
   no props.

   Typography: the headline is Geist Light at display scale (the site is a
   two-typeface system — Geist sans + Geist Mono, no serif). The cover layout
   and framed photo carry the editorial character, not the typeface. */
import { accentHeading } from '../../lib/editorial';

interface CtaLink {
  label: string;
  href: string;
  /** optional data-* attributes (e.g. Cal.com booking hooks) */
  attrs?: Record<string, string>;
}

interface Props {
  eyebrow?: string;
  h1Primary?: string;
  h1Secondary?: string;
  lead?: string;
  primaryCta?: CtaLink;
  secondaryCta?: CtaLink;
  /** mono positioning line under the hairline (NOT a fabricated metric) */
  metaLine?: string;
  name?: string;
}

const {
  eyebrow = 'AI-native revenue operator',
  h1Primary = 'I build revenue systems.',
  h1Secondary = 'Then I run them.',
  lead = 'Twenty years across GTM, marketing, and growth. I wire them into one AI-native operating model, build what is missing, and stay until it runs.',
  primaryCta = { label: 'See the work', href: '/work/' },
  secondaryCta = { label: 'Get the newsletter', href: 'https://subscribe.wojciech.io' },
  metaLine = 'GTM · marketing · growth × AI',
  name = 'Wojciech Łuszczyński',
} = Astro.props as Props;

/* Accent the terminal mark of the second line (locale-aware: . ? 。). */
const h2 = accentHeading(h1Secondary);
const photo = '/images/wojciech-office-hq.webp';
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_minmax(340px,42%)] gap-10 lg:gap-14 items-stretch lg:min-h-[640px]">

      <!-- Left: editorial type column -->
      <div class="flex flex-col justify-center py-12 md:py-16 lg:py-28">

        <!-- Mobile: framed photo banner (the photo is the point in this direction) -->
        <div class="lg:hidden relative mb-8 aspect-[16/10] overflow-hidden rounded-[var(--radius-card)]">
          <img
            src={photo}
            alt={name}
            width="1200"
            height="750"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[center_28%]"
          />
          <div class="absolute inset-3 border border-[rgb(255_255_255_/_0.35)] mix-blend-overlay pointer-events-none"></div>
          <div class="absolute left-4 bottom-3">
            <span class="obs-mono text-[10px] uppercase tracking-[0.2em] text-white/90 [text-shadow:0_1px_8px_rgb(0_0_0/0.6)]">{name}</span>
          </div>
        </div>

        <!-- Eyebrow: editorial accent tick + label -->
        <div class="flex items-center gap-3 mb-7 md:mb-9">
          <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{eyebrow}</span>
        </div>

        <!-- Headline: Geist Light display, second line anchors the accent mark -->
        <h1
          class="ed-display reveal-up text-[length:clamp(2.6rem,5.4vw+0.5rem,4.9rem)] mb-5 md:mb-7"
          data-reveal-index="0"
          transition:name="page-title-home"
        >
          <span class="text-[var(--color-text)]">{h1Primary}</span><br />
          <span class="ed-line-2 text-[var(--color-text)]">{h2.lead}</span><span class="hero-dot text-[var(--color-accent-cta)]" aria-hidden="true">{h2.mark}</span>
        </h1>

        <!-- Sub-copy (stays sans for full multilingual coverage) -->
        <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 md:mb-9 max-w-md" data-reveal-index="1">
          {lead}
        </p>

        <!-- Buttons -->
        <div class="reveal-up flex flex-wrap gap-3 mb-8" data-reveal-index="2">
          <a
            href={primaryCta.href}
            class="btn-press obs-mono inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] text-xs font-semibold uppercase tracking-wider px-6 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
          >
            {primaryCta.label}
          </a>
          <a
            href={secondaryCta.href}
            class="btn-press obs-mono inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[var(--color-text)] text-xs font-medium uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-text)] transition-colors"
            {...secondaryCta.attrs}
          >
            {secondaryCta.label}
          </a>
        </div>

        <!-- Editorial meta strip: hairline + mono positioning kicker -->
        <div class="reveal-up ed-rule pt-4 max-w-md" data-reveal-index="3">
          <span class="obs-label text-[10px] tracking-[0.18em] leading-snug">{metaLine}</span>
        </div>
      </div>

      <!-- Right: full-bleed framed colour photo (desktop only) -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <div
          class="absolute inset-0 bg-cover bg-no-repeat bg-[position:center_25%]"
          style={`background-image:url('${photo}')`}
        ></div>
        <!-- Left fade blends the photo into the type column on both themes -->
        <div class="absolute inset-y-0 left-0 w-[22%] pointer-events-none [background:linear-gradient(to_right,var(--color-bg)_0%,transparent_100%)]"></div>
        <!-- Editorial hairline frame -->
        <div class="absolute inset-6 border border-[rgb(255_255_255_/_0.4)] mix-blend-overlay pointer-events-none"></div>
        <div class="absolute left-8 bottom-7">
          <span class="obs-mono text-[10px] uppercase tracking-[0.2em] text-white/90 [text-shadow:0_1px_10px_rgb(0_0_0/0.65)]">{name}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Accent period: a soft glow in the accent colour. */
  .hero-dot {
    font-family: var(--font-sans);
    font-weight: 500;
    text-shadow: 0 0 22px color-mix(in srgb, var(--color-accent-cta) 55%, transparent);
  }

  /* Eyebrow tick draws itself in on load. */
  .hero-tick {
    animation: hero-draw 0.9s 0.15s ease both;
  }

  @keyframes hero-draw {
    from { width: 0; }
    to   { width: 2.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tick { animation: none; }
  }
</style>
