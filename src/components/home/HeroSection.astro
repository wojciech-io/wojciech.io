---
---

<section class="relative overflow-hidden min-h-[520px] md:min-h-[600px] lg:min-h-[680px]">
  <!-- Grid overlay -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />

  <!-- Glow orb -->
  <div class="pointer-events-none absolute left-1/2 -translate-x-1/2 -top-32 h-[480px] w-[600px] rounded-full bg-[rgb(235_255_0/0.06)] blur-[120px] animate-glow-breathe" aria-hidden="true" />

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_380px] gap-10 lg:gap-16 items-center py-10 md:py-20 lg:py-28">

      <!-- Left: copy -->
      <div class="flex flex-col">
        <!-- System label -->
        <div class="reveal-up flex items-center gap-2.5 mb-6 md:mb-8" data-reveal-index="0">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] shadow-[0_0_10px_rgb(34_197_94/0.6)] animate-pulse-dot"></span>
          <span class="obs-label-accent">// system online</span>
        </div>

        <!-- Headline -->
        <h1 class="reveal-up text-[length:var(--text-hero)] font-bold leading-[1.06] tracking-tight mb-5 md:mb-7" data-reveal-index="1" transition:name="page-title-home">
          <span class="text-[var(--color-text)]">I build revenue</span><br />
          <span class="text-[var(--color-text)]">systems.</span>
          <span class="heading-accent"> Then I run them.</span>
        </h1>

        <!-- Sub-copy -->
        <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-8 md:mb-10 max-w-lg" data-reveal-index="2">
          GTM, CRM, AI workflows, automation: one operating model. I build the connections that are missing, instrument everything, and stay until it compounds.
        </p>

        <!-- Buttons -->
        <div class="reveal-up flex flex-wrap gap-3" data-reveal-index="3">
          <a
            href="/work/"
            class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] obs-mono text-xs font-bold uppercase tracking-wider px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
          >
            See the work
          </a>
          <a
            href="https://subscribe.wojciech.io"
            class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-transparent text-[var(--color-text)] obs-mono text-xs font-medium uppercase tracking-wider px-6 py-3 rounded-[var(--radius-btn)] hover:border-[var(--color-text-dim)] transition-colors"
          >
            Get the newsletter
          </a>
        </div>
      </div>

      <!-- Right: status panel (desktop) -->
      <div class="reveal-up hidden lg:block" data-reveal-index="2">
        <div class="obs-panel p-5 space-y-4">
          <div class="flex items-center justify-between mb-1">
            <span class="obs-label">// operator status</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] shadow-[0_0_8px_rgb(34_197_94/0.5)]"></span>
          </div>

          <div class="space-y-3">
            <div class="flex justify-between items-baseline">
              <span class="obs-label">Pipeline coverage</span>
              <span class="obs-mono text-sm font-bold text-[var(--color-text)]">3.2x</span>
            </div>
            <div class="h-1 rounded-full bg-[var(--color-surface-2)] overflow-hidden">
              <div class="h-full rounded-full bg-[var(--color-accent-cta)] w-[82%]"></div>
            </div>
          </div>

          <div class="obs-divider"></div>

          <div class="space-y-2.5">
            <div class="flex justify-between items-baseline">
              <span class="obs-label">Systems built</span>
              <span class="obs-mono text-sm font-medium text-[var(--color-text)]">47</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="obs-label">Active automations</span>
              <span class="obs-mono text-sm font-medium text-[var(--color-text)]">120+</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="obs-label">Revenue influenced</span>
              <span class="obs-mono text-sm font-medium text-[var(--color-text)]">$84M</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="obs-label">Avg engagement</span>
              <span class="obs-mono text-sm font-medium text-[var(--color-text)]">14 mo</span>
            </div>
          </div>

          <div class="obs-divider"></div>

          <div class="flex items-center gap-2">
            <span class="obs-label">Last deploy</span>
            <span class="obs-mono text-[10px] text-[var(--color-text-dim)]" id="hero-last-deploy">loading...</span>
          </div>
        </div>
      </div>

      <!-- Mobile: compact stats row -->
      <div class="lg:hidden reveal-up" data-reveal-index="3">
        <div class="grid grid-cols-2 gap-3">
          <div class="obs-panel p-3.5 text-center">
            <span class="obs-mono text-lg font-bold text-[var(--color-text)]">47</span>
            <span class="block obs-label mt-0.5">Systems</span>
          </div>
          <div class="obs-panel p-3.5 text-center">
            <span class="obs-mono text-lg font-bold text-[var(--color-text)]">$84M</span>
            <span class="block obs-label mt-0.5">Revenue</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function updateLastDeploy() {
    const el = document.getElementById('hero-last-deploy');
    if (!el) return;
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    el.textContent = `${now.toISOString().slice(0,10)} ${h}:${m} UTC`;
  }
  updateLastDeploy();
  document.addEventListener('astro:page-load', updateLastDeploy);
</script>
