---
/* Editorial hero. Prop-driven so the English homepage and every localized
   homepage render the exact same layout — only the copy differs. Defaults
   carry the English copy, so `<HeroSection />` (the EN page) works with no props.

   Two-typeface system: Geist sans + Geist Mono. All copy and numerals render
   in Geist, which covers PL diacritics and JP. */
import { accentHeading } from '../../lib/editorial';

interface CtaLink {
  label: string;
  href: string;
  /** optional data-* attributes (e.g. Cal.com booking hooks) */
  attrs?: Record<string, string>;
}

interface Props {
  eyebrow?: string;
  h1Primary?: string;
  h1Secondary?: string;
  lead?: string;
  primaryCta?: CtaLink;
  secondaryCta?: CtaLink;
  /** mono positioning line under the hairline (NOT a fabricated metric) */
  metaLine?: string;
  name?: string;
}

const {
  eyebrow = 'AI-native revenue operator',
  h1Primary = 'I build revenue systems.',
  h1Secondary = 'Then I run them.',
  lead = 'Twenty years across GTM, marketing, and growth. I wire them into one AI-native operating model, build what is missing, and stay until it runs.',
  primaryCta = { label: 'See the work', href: '/work/' },
  secondaryCta = { label: 'Get the newsletter', href: '/subscribe/' },
  metaLine = 'GTM · marketing · growth × AI',
  name = 'Wojciech Łuszczyński',
} = Astro.props as Props;

/* The editorial accent mark is rendered by its own span; the helper splits the
   copy's terminal punctuation so it gets the accent color (locale-aware: . ? 。). */
const h2 = accentHeading(h1Secondary);
---

<section class="relative overflow-hidden min-h-[480px] md:min-h-[580px] lg:min-h-[620px]">
  <!-- Grid: faint, radially masked so it dissolves into the page (depth, not a flat sheet) -->
  <div class="hero-grid pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:44px_44px]" aria-hidden="true" />
  <!-- Lime aura: colour + depth behind the headline (static — no per-frame repaint) -->
  <div class="hero-aura pointer-events-none absolute left-[-120px] top-[-150px] h-[480px] w-[580px] rounded-full" aria-hidden="true" />
  <!-- Neutral depth, kept subtle under the aura -->
  <div class="pointer-events-none absolute left-[-160px] top-[-180px] h-[520px] w-[640px] rounded-full bg-[var(--color-surface)] blur-[150px] opacity-50" aria-hidden="true" />

  <!-- Photo: desktop only, right half, absolute. Decorative (aria-hidden), lg+ only.
       Delivered as a CSS background so a display:none element never fetches it,
       keeping the hero image off the mobile critical path. -->
  <div
    class="hero-photo-side hidden lg:block absolute right-0 top-0 bottom-0 w-[62%] overflow-hidden bg-[url('/images/wojciech-hero-warm.webp')] bg-cover bg-no-repeat bg-[position:center_22%]"
    aria-hidden="true"
  >
    <!-- The photo renders 1:1 (no filters, no baked-in fades): every blend into
         the page is painted here in CSS so the source file never needs another
         generator pass. Scrim first (settles the warm shot on the dark theme),
         then eased edge fades in the page background colour. -->
    <div class="hero-photo-scrim absolute inset-0 pointer-events-none" />
    <div class="hero-photo-fade absolute inset-y-0 left-0 w-[60%] pointer-events-none" />
    <div class="absolute inset-x-0 bottom-0 h-[18%] pointer-events-none [background:linear-gradient(to_top,var(--color-bg)_0%,transparent_100%)]" />
    <div class="absolute inset-x-0 top-0 h-[16%] pointer-events-none [background:linear-gradient(to_bottom,var(--color-bg)_0%,transparent_100%)]" />
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="flex flex-col justify-center py-10 md:py-20 lg:py-32 md:max-w-[560px] lg:max-w-[48%]">

      <!-- Mobile: compact identity. Small photo WITH background, a supporting
           detail rather than a centerpiece. -->
      <div class="lg:hidden flex items-center gap-3 mb-7">
        <img
          src="/images/wojciech-thumb.webp"
          alt={name}
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          class="w-16 h-16 rounded-xl object-cover border border-[var(--color-border-2)] shrink-0"
        />
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)] leading-tight">{name}</p>
          <span class="obs-label-accent">{eyebrow}</span>
        </div>
      </div>

      <!-- Desktop: eyebrow with editorial accent tick (photo lives on the right half) -->
      <div class="hidden lg:flex items-center gap-3 mb-8">
        <span class="hero-tick h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">{eyebrow}</span>
      </div>

      <!-- Headline: large, regular weight (editorial), accent period -->
      <h1 class="reveal-up text-[length:clamp(2.4rem,6vw+0.5rem,4.4rem)] font-normal leading-[1.02] tracking-[-0.03em] mb-4 md:mb-6" data-reveal-index="0" transition:name="page-title-home">
        <span class="text-[var(--color-text)]">{h1Primary}</span><br class="hidden md:block" />
        <span class="text-[var(--color-text)]">{h2.lead}</span><span class="hero-dot text-[var(--color-accent-cta)]" aria-hidden="true">{h2.mark}</span>
      </h1>

      <!-- Sub-copy (stays sans for full multilingual coverage) -->
      <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 md:mb-9 max-w-lg" data-reveal-index="1">
        {lead}
      </p>

      <!-- Buttons -->
      <div class="reveal-up flex flex-wrap gap-3 mb-8" data-reveal-index="2">
        <a
          href={primaryCta.href}
          class="btn-press obs-mono inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] text-xs font-semibold uppercase tracking-wider px-6 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="btn-press obs-mono inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[var(--color-text)] text-xs font-medium uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-text)] transition-colors"
          {...secondaryCta.attrs}
        >
          {secondaryCta.label}
        </a>
      </div>

      <!-- Editorial meta strip: hairline + mono positioning kicker -->
      <div class="reveal-up ed-rule pt-4 max-w-lg" data-reveal-index="3">
        <span class="obs-label text-[10px] tracking-[0.18em] leading-snug">{metaLine}</span>
      </div>

    </div>
  </div>
</section>

<style>
  /* Grid dissolves toward the edges so it reads as depth, not a flat sheet. */
  .hero-grid {
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
  }

  /* Lime aura: subtle colour wash + depth behind the headline. Static — a
     blurred element animated per frame forces a full re-raster of the blur and
     janks scroll, so it is painted once. Opacity is theme-scoped (a hint on the
     light page, more presence on the dark one). */
  .hero-aura {
    background: radial-gradient(circle, var(--color-accent-cta) 0%, transparent 68%);
    opacity: 0.08;
    filter: blur(60px);
  }
  :global(:root[data-theme='dark']) .hero-aura {
    opacity: 0.16;
  }

  /* Accent period: a soft glow in the accent colour. */
  .hero-dot {
    font-family: var(--font-sans);
    font-weight: 600;
    text-shadow: 0 0 22px color-mix(in srgb, var(--color-accent-cta) 55%, transparent);
  }

  /* Eyebrow tick draws itself in on load. */
  .hero-tick {
    animation: hero-draw 0.9s 0.15s ease both;
  }

  @keyframes hero-draw {
    from { width: 0; }
    to   { width: 2.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tick { animation: none; }
  }

  /* Photo renders unfiltered: the shot is already graded, and any filter or
     re-generation pass costs face fidelity. Blending is overlay-only. */

  /* Left fade: eased multi-stop ramp (solid page colour near the text, long
     soft tail over the photo) — a plain linear ramp reads as a milky wash. */
  .hero-photo-fade {
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 88%, transparent) 26%,
      color-mix(in srgb, var(--color-bg) 48%, transparent) 56%,
      color-mix(in srgb, var(--color-bg) 14%, transparent) 80%,
      transparent 100%
    );
  }

  /* Dark theme: a light page-colour scrim settles the warm interior into the
     near-black page without touching contrast on the face. */
  .hero-photo-scrim {
    background: color-mix(in srgb, var(--color-bg) 24%, transparent);
    opacity: 0;
  }
  :global(:root[data-theme='dark']) .hero-photo-scrim {
    opacity: 1;
  }
</style>
