---
---

<section class="relative overflow-hidden min-h-[480px] md:min-h-[580px] lg:min-h-[620px]">
  <!-- Subtle grid -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
  <!-- Neutral depth behind text -->
  <div class="pointer-events-none absolute left-[-160px] top-[-180px] h-[520px] w-[640px] rounded-full bg-[var(--color-surface)] blur-[150px] opacity-70" aria-hidden="true" />

  <!-- Photo: desktop only, right half, absolute.
       Decorative (aria-hidden), shown only at lg+. Delivered as a CSS
       background, not an <img>: a background-image on a display:none element
       is never fetched, whereas an <img src> downloads even when hidden. A
       <picture media> source does not help because Chrome's preload scanner
       fetches the srcset before evaluating the media query. This keeps the
       248KB hero off the mobile critical path entirely. -->
  <div
    class="hidden lg:block absolute right-0 top-0 bottom-0 w-[52%] overflow-hidden bg-[url('/images/wojciech-office-hq.webp')] bg-cover bg-no-repeat bg-[position:center_30%]"
    aria-hidden="true"
  >
    <!-- Left fade overlay -->
    <div class="absolute inset-y-0 left-0 w-[28%] pointer-events-none [background:linear-gradient(to_right,var(--color-bg)_0%,transparent_100%)]" />
    <!-- Bottom fade overlay -->
    <div class="absolute inset-x-0 bottom-0 h-[14%] pointer-events-none [background:linear-gradient(to_top,var(--color-bg)_0%,transparent_100%)]" />
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="flex flex-col justify-center py-10 md:py-20 lg:py-32 md:max-w-[560px] lg:max-w-[48%]">

      <!-- Mobile: compact identity. Small photo WITH background, to the side,
           a supporting detail rather than a centerpiece. -->
      <div class="lg:hidden flex items-center gap-3 mb-6">
        <img
          src="/images/wojciech-thumb.webp"
          alt="Wojciech Łuszczyński"
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          class="w-16 h-16 rounded-xl object-cover border border-[var(--color-border-2)] shrink-0"
        />
        <div>
          <p class="text-sm font-semibold text-[var(--color-text)] leading-tight">Wojciech Łuszczyński</p>
          <span class="obs-label-accent">Fractional GTM operator</span>
        </div>
      </div>

      <!-- Desktop: eyebrow (photo lives on the right half) -->
      <div class="hidden lg:inline-flex self-start items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-glass)] px-3.5 py-2 mb-8 shadow-[var(--shadow-card)] backdrop-blur">
        <span class="obs-status-dot"></span>
        <span class="obs-label-accent">Fractional GTM operator</span>
      </div>

      <!-- Headline -->
      <h1 class="reveal-up text-[length:var(--text-hero)] font-bold leading-[1.08] tracking-tight mb-4 md:mb-6" data-reveal-index="0" transition:name="page-title-home">
        <span class="text-[var(--color-text)]">I build revenue systems.</span><br class="hidden md:block" /> <span class="heading-accent">Then I run them.</span>
      </h1>

      <!-- Sub-copy -->
      <p class="reveal-up text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 md:mb-10 max-w-lg" data-reveal-index="1">
        GTM, CRM, and AI workflows in one operating model. I build what's missing and stay until it runs.
      </p>

      <!-- Buttons -->
      <div class="reveal-up flex flex-wrap gap-3 mb-5" data-reveal-index="2">
        <a
          href="/work/"
          class="btn-press obs-mono inline-flex items-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] text-xs font-semibold uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          See the work
        </a>
        <a
          href="https://subscribe.wojciech.io"
          class="btn-press obs-mono inline-flex items-center gap-2 border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[var(--color-text)] text-xs font-medium uppercase tracking-wider px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-[var(--radius-btn)] hover:border-[var(--color-text)] transition-colors"
        >
          Get the newsletter
        </a>
      </div>

    </div>
  </div>
</section>
