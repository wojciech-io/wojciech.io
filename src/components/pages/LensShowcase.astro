---
/* Shared showcase template for the three lenses (/gtm, /marketing, /growth).
   Same skeleton, different copy: hero promise → what I build → spiky POV → CTA.
   No fabricated metrics: proof links to /work case studies. v1 scaffold, copy
   expands as real case studies get wired per lens. */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../ui/CTABand.astro';
import FAQ from '../ui/FAQ.astro';
import { accentHeading } from '../../lib/editorial';

interface BuildItem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1Primary: string;
  h1Secondary: string;
  lead: string;
  metaLine: string;
  build: BuildItem[];
  buildEyebrow?: string;
  buildHeading?: string;
  /** Desktop-only hero image, greyed into the right side behind the copy.
      Per-lens; falls back to no image (text-only hero) when omitted. */
  heroImage?: string;
  /** Optional hero loop, path without extension, resolving .webm + .mp4 in
      /public/media. Replaces the desktop backdrop image only: mobile keeps
      the still, because a hero video is the wrong thing to autoplay on a
      phone connection and the poster is already the same frame. */
  heroVideo?: string;
  /** Poster for the loop. The lens hero image is a different scene, so using
      it here would flash the wrong picture before the first frame paints. */
  heroVideoPoster?: string;
  pov: string;
  ctaHeading: string;
  ctaSubtext: string;
  /** Locale / SEO — default to the canonical English page. */
  htmlLang?: string;
  dir?: 'ltr' | 'rtl';
  ogLocale?: string;
  canonical?: string;
  ogImage?: string;
  alternates?: { lang: string; href: string }[];
  /** CTA band labels + targets, localized per page. */
  ctaKicker?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  /** Questions people actually ask before booking. Rendered for readers and
   *  emitted as FAQPage, which is the form answer engines quote. */
  faq?: Array<{ question: string; answer: string }>;
  faqHeading?: string;
}

const {
  title,
  description,
  eyebrow,
  h1Primary,
  h1Secondary,
  lead,
  metaLine,
  build,
  buildEyebrow = 'What I build',
  buildHeading = 'Built and run, not advised.',
  heroImage,
  heroVideo,
  heroVideoPoster,
  pov,
  ctaHeading,
  ctaSubtext,
  ctaKicker,
  htmlLang = 'en',
  dir = 'ltr',
  ogLocale,
  canonical,
  ogImage,
  alternates,
  ctaLabel = 'Book a call',
  ctaHref = '/contact/',
  // Secondary (outline) = the newsletter, to /subscribe. Booking is primary.
  ctaSecondary = 'Read AI Espresso',
  ctaSecondaryHref = '/subscribe/',
  faq,
  faqHeading = 'Questions people ask first',
} = Astro.props as Props;

// These pages describe an offering but carried only the site-wide Person and
// WebSite blocks, so an answer engine had nothing telling it what is on sale.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  serviceType: title,
  areaServed: 'Worldwide',
  provider: { '@type': 'Person', name: 'Wojciech Luszczynski', url: 'https://wojciech.io/' },
};

const h2 = accentHeading(h1Secondary);
const bh = accentHeading(buildHeading);

// Only render the greyed hero backdrop once the file actually exists in public/.
// Keeps the hero clean (text-only) until the generated image is dropped in —
// no empty placeholder rectangle in the meantime.
const heroImageReady =
  !!heroImage && fs.existsSync(path.join(process.cwd(), 'public', heroImage));
// Both encodings have to be on disk. A half-present pair would render a video
// element that plays in one browser and shows a blank box in another, which is
// worse than the still it replaced.
const heroVideoReady =
  !!heroVideo &&
  ['webm', 'mp4'].every((ext) =>
    fs.existsSync(path.join(process.cwd(), 'public', `${heroVideo}.${ext}`)),
  );
---

<Layout
  title={title}
  description={description}
  htmlLang={htmlLang}
  dir={dir}
  ogLocale={ogLocale}
  canonical={canonical}
  ogImage={ogImage}
  alternates={alternates}
  schema={serviceSchema}
>
  <section class="relative overflow-hidden flex items-center min-h-[440px] md:min-h-[500px] lg:min-h-[560px]">
    <div class="hero-grid pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:44px_44px]" aria-hidden="true"></div>

    {/* Hero backdrop: desktop only, right side. Blended like the homepage hero:
        the image layer carries the desaturation/dim, and the edge fades are
        separate siblings painting the page colour at full strength, so nothing
        reads as a rectangle over the page. Decorative. */}
    {heroImageReady && (
      <div class="lens-hero-photo hidden lg:block absolute right-0 top-0 bottom-0 w-[56%] overflow-hidden" aria-hidden="true">
        {heroVideoReady ? (
          /* Same deferral the home hero uses: no source until a script has
             checked the breakpoint, reduced motion and the connection. The
             first version of this shipped an autoplaying element inside a
             `hidden lg:block` wrapper, and a phone still pulled 148KB of webm
             for a video it never displayed. `preload="none"` does not save
             you there, because autoplay overrides it.

             No opacity-0 here, unlike the home hero: that one fades a loop in
             over a photo layer underneath, and this element has nothing
             behind it. The poster is the loop's own first frame, so a viewer
             whose link or motion settings suppress the video sees that frame
             instead of an empty right half. */
          <video
            class="lens-loop lens-hero-img absolute inset-0 h-full w-full object-cover object-center"
            data-src-webm={`${heroVideo}.webm`}
            data-src={`${heroVideo}.mp4`}
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            tabindex="-1"
            poster={heroVideoPoster ?? heroImage}
          ></video>
        ) : (
          <div class="lens-hero-img absolute inset-0 bg-cover bg-no-repeat bg-center" style={`background-image: url('${heroImage}')`}></div>
        )}
        <div class="lens-hero-scrim absolute inset-0 pointer-events-none"></div>
        <div class="lens-hero-fade absolute inset-y-0 left-0 w-[62%] pointer-events-none"></div>
        <div class="absolute inset-x-0 bottom-0 h-[20%] pointer-events-none [background:linear-gradient(to_top,var(--color-bg)_0%,transparent_100%)]"></div>
        <div class="absolute inset-x-0 top-0 h-[16%] pointer-events-none [background:linear-gradient(to_bottom,var(--color-bg)_0%,transparent_100%)]"></div>
      </div>
    )}

    <div class="relative w-full mx-auto max-w-6xl px-6 py-14 md:py-16">
      <div class="max-w-2xl">
        {/* Mobile: a real, well-fitted hero image (desktop keeps the right-half
            backdrop above). Framed to the column, blended at the base. */}
        {heroImageReady && (
          <div class="lg:hidden relative mb-7">
            <img
              src={heroImage}
              alt=""
              width="1200"
              height="750"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-[16/10] object-cover object-center rounded-2xl border border-[var(--color-border-2)]"
            />
            <div class="absolute inset-x-0 bottom-0 h-1/4 rounded-b-2xl pointer-events-none [background:linear-gradient(to_top,color-mix(in_srgb,var(--color-bg)_70%,transparent),transparent)]" aria-hidden="true"></div>
          </div>
        )}
        <div class="flex items-center gap-3 mb-6">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{eyebrow}</span>
        </div>
        <h1 class="t-display mb-5">
          <span class="text-[var(--color-text)]">{h1Primary}</span>{' '}
          <span class="text-[var(--color-text)]">{h2.lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{h2.mark}</span>
        </h1>
        <p class="t-lead text-[var(--color-text-muted)] mb-7 max-w-xl">
          {lead}
        </p>
        <div class="ed-rule pt-4 max-w-xl">
          <span class="obs-label">{metaLine}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="relative border-t border-[var(--color-border)] py-[var(--space-section)] bg-[var(--color-bg)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">{buildEyebrow}</span>
      </div>
      <h2 class="t-h2 mb-10 max-w-2xl">
        <span class="text-[var(--color-text)]">{bh.lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{bh.mark}</span>
      </h2>

      <div class="grid gap-4 md:grid-cols-3 md:gap-6">
        {build.map((item, index) => (
          <div class="reveal-up obs-panel p-6" data-reveal-index={index + 1}>
            <h3 class="t-body text-[var(--color-text)] mb-2">{item.title}</h3>
            <p class="t-small text-[var(--color-text-muted)]">{item.body}</p>
          </div>
        ))}
      </div>

      <blockquote class="mt-12 border-s-2 border-[var(--color-accent-cta)] ps-5 max-w-2xl">
        <p class="t-lead md:text-xl text-[var(--color-text)]">{pov}</p>
      </blockquote>
    </div>
  </section>

  {faq && faq.length > 0 && (
    <section class="py-14 md:py-20 border-t border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-6">
        <p class="obs-label-accent mb-6 block">{faqHeading}</p>
        <FAQ items={faq} />
      </div>
    </section>
  )}

  <slot />

  <CTABand
    kicker={ctaKicker}
    heading={ctaHeading}
    subtext={ctaSubtext}
    cta={ctaLabel}
    ctaHref={ctaHref}
    ctaSecondary={ctaSecondary}
    ctaSecondaryHref={ctaSecondaryHref}
  />
</Layout>

<style>
  /* Backdrop image layer ONLY carries the desaturation + dim, so the quiet-
     backdrop look never bleeds into the edge fades. The fades below are
     siblings, not children, so they paint the page colour at full strength and
     the image dissolves into the page instead of sitting as a rectangle. */
  .lens-hero-img {
    filter: none;
    opacity: 1;
  }
  :global(:root[data-theme='dark']) .lens-hero-img {
    /* Full colour; a touch of dim only so the image settles into the near-black
       page. The left fade + scrim below carry the blend, not desaturation. */
    filter: none;
    opacity: 0.82;
  }

  /* Left fade: same eased multi-stop ramp as the homepage hero (solid page
     colour near the copy, long soft tail over the image) — a plain linear ramp
     reads as a milky band. */
  .lens-hero-fade {
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 88%, transparent) 26%,
      color-mix(in srgb, var(--color-bg) 48%, transparent) 56%,
      color-mix(in srgb, var(--color-bg) 14%, transparent) 80%,
      transparent 100%
    );
  }

  /* Dark theme: a light page-colour scrim settles the image into the near-black
     page. Off in light, where the cream page needs no scrim. */
  .lens-hero-scrim {
    background: color-mix(in srgb, var(--color-bg) 24%, transparent);
    opacity: 0;
  }
  :global(:root[data-theme='dark']) .lens-hero-scrim {
    opacity: 1;
  }
</style>

<script>
  const startLensLoop = () => {
    const video = document.querySelector<HTMLVideoElement>('.lens-loop');
    if (!video?.dataset.src || video.src) return;
    const desktop = window.matchMedia('(min-width: 1024px)').matches;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string; downlink?: number };
    }).connection;
    const slowLink = Boolean(
      conn?.saveData ||
        (conn?.effectiveType && conn.effectiveType !== '4g') ||
        (typeof conn?.downlink === 'number' && conn.downlink > 0 && conn.downlink < 5),
    );
    if (!desktop || calm || slowLink) return;
    const webm = video.dataset.srcWebm && video.canPlayType('video/webm') === 'probably';
    video.src = webm ? video.dataset.srcWebm! : video.dataset.src;
    video.play().catch(() => {});
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && video.paused) video.play().catch(() => {});
    });
  };
  if (document.readyState === 'complete') startLensLoop();
  else window.addEventListener('load', startLensLoop, { once: true });
  document.addEventListener('astro:page-load', startLensLoop);
</script>
