---
/* Shared showcase template for the three lenses (/gtm, /marketing, /growth).
   Same skeleton, different copy: hero promise → what I build → spiky POV → CTA.
   No fabricated metrics: proof links to /work case studies. v1 scaffold, copy
   expands as real case studies get wired per lens. */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../ui/CTABand.astro';
import { accentHeading } from '../../lib/editorial';

interface BuildItem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1Primary: string;
  h1Secondary: string;
  lead: string;
  metaLine: string;
  build: BuildItem[];
  buildEyebrow?: string;
  buildHeading?: string;
  /** Desktop-only hero image, greyed into the right side behind the copy.
      Per-lens; falls back to no image (text-only hero) when omitted. */
  heroImage?: string;
  pov: string;
  ctaHeading: string;
  ctaSubtext: string;
  /** Locale / SEO — default to the canonical English page. */
  htmlLang?: string;
  dir?: 'ltr' | 'rtl';
  ogLocale?: string;
  canonical?: string;
  ogImage?: string;
  alternates?: { lang: string; href: string }[];
  /** CTA band labels + targets, localized per page. */
  ctaKicker?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
}

const {
  title,
  description,
  eyebrow,
  h1Primary,
  h1Secondary,
  lead,
  metaLine,
  build,
  buildEyebrow = 'What I build',
  buildHeading = 'Built and run, not advised.',
  heroImage,
  pov,
  ctaHeading,
  ctaSubtext,
  ctaKicker,
  htmlLang = 'en',
  dir = 'ltr',
  ogLocale,
  canonical,
  ogImage,
  alternates,
  ctaLabel = 'Book a call',
  ctaHref = '/contact/#book-call',
  ctaSecondary = 'See the work',
  ctaSecondaryHref = '/work/',
} = Astro.props as Props;

const h2 = accentHeading(h1Secondary);
const bh = accentHeading(buildHeading);

// Only render the greyed hero backdrop once the file actually exists in public/.
// Keeps the hero clean (text-only) until the generated image is dropped in —
// no empty placeholder rectangle in the meantime.
const heroImageReady =
  !!heroImage && fs.existsSync(path.join(process.cwd(), 'public', heroImage));
---

<Layout
  title={title}
  description={description}
  htmlLang={htmlLang}
  dir={dir}
  ogLocale={ogLocale}
  canonical={canonical}
  ogImage={ogImage}
  alternates={alternates}
>
  <section class="relative overflow-hidden">
    <div class="hero-grid pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:44px_44px]" aria-hidden="true"></div>

    {heroImageReady && (
      <!-- Greyed hero image: desktop only, right side, desaturated + faded into
           the page so the headline copy stays readable over it. Decorative. -->
      <div
        class="lens-hero-photo hidden lg:block absolute right-0 top-0 bottom-0 w-[52%] overflow-hidden"
        aria-hidden="true"
      >
        <!-- The grayscale filter lives on THIS inner layer only. Filtering the
             container would recolour the overlay gradients too, so their
             "solid page colour" stops render a slightly different tint than
             the real page background — a thin visible seam at the edge. -->
        <div
          class="lens-photo-img absolute inset-0 bg-cover bg-no-repeat bg-center"
          style={`background-image: url('${heroImage}')`}
        ></div>
        <!-- Scrim first (dims the photo at FULL overlay opacity — dimming via
             container opacity would make the edge fades translucent too and
             leave the photo's left edge visible as a contour), then the same
             eased multi-stop left fade as the homepage hero. -->
        <div class="lens-photo-scrim absolute inset-0 pointer-events-none"></div>
        <div class="lens-photo-fade absolute inset-y-0 left-0 w-[70%] pointer-events-none"></div>
        <div class="absolute inset-x-0 bottom-0 h-[20%] pointer-events-none [background:linear-gradient(to_top,var(--color-bg)_0%,transparent_100%)]"></div>
        <div class="absolute inset-x-0 top-0 h-[16%] pointer-events-none [background:linear-gradient(to_bottom,var(--color-bg)_0%,transparent_100%)]"></div>
      </div>
    )}

    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-24">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
          <span class="obs-label-accent">{eyebrow}</span>
        </div>
        <h1 class="text-[length:clamp(2.2rem,5vw+0.5rem,3.6rem)] font-normal leading-[1.05] tracking-[-0.03em] mb-5">
          <span class="text-[var(--color-text)]">{h1Primary}</span>{' '}
          <span class="text-[var(--color-text)]">{h2.lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{h2.mark}</span>
        </h1>
        <p class="text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-7 max-w-xl">
          {lead}
        </p>
        <div class="ed-rule pt-4 max-w-xl">
          <span class="obs-label text-[10px] tracking-[0.18em] leading-snug">{metaLine}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-[var(--space-section)] bg-[var(--color-bg)]">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">{buildEyebrow}</span>
      </div>
      <h2 class="text-[length:var(--text-h2)] font-normal leading-[1.12] tracking-[-0.015em] mb-10 max-w-2xl">
        <span class="text-[var(--color-text)]">{bh.lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{bh.mark}</span>
      </h2>

      <div class="grid gap-4 md:grid-cols-3 md:gap-6">
        {build.map((item, index) => (
          <div class="reveal-up obs-panel p-6" data-reveal-index={index + 1}>
            <h3 class="text-base font-medium text-[var(--color-text)] mb-2">{item.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>

      <blockquote class="mt-12 border-s-2 border-[var(--color-accent-cta)] ps-5 max-w-2xl">
        <p class="text-lg md:text-xl font-normal leading-snug text-[var(--color-text)]">{pov}</p>
      </blockquote>
    </div>
  </section>

  <slot />

  <CTABand
    kicker={ctaKicker}
    heading={ctaHeading}
    subtext={ctaSubtext}
    cta={ctaLabel}
    ctaHref={ctaHref}
    ctaSecondary={ctaSecondary}
    ctaSecondaryHref={ctaSecondaryHref}
  />
</Layout>

<style>
  /* Grid dissolves toward the edges (same mask as the homepage hero). Without
     it the grid renders full-strength and gets cut hard at the photo's left
     edge — the visible contour. HeroSection's scoped styles don't reach here,
     so the rule must live in this component too. */
  .hero-grid {
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 75% at 28% 32%, #000 38%, transparent 100%);
  }

  /* Greyed hero image: desaturated backdrop behind the headline. The filter
     sits on the image layer ONLY — on the container it would recolour the
     overlay gradients and their solid page-colour stops would no longer match
     the page background (thin seam at the edge). Dimming lives in the scrim,
     not in opacity, for the same reason. */
  .lens-photo-img {
    filter: grayscale(0.9) contrast(0.98) brightness(1.05);
  }
  :global(:root[data-theme='dark']) .lens-photo-img {
    filter: grayscale(0.85);
  }

  /* Page-colour scrim at full overlay opacity: same visual weight as the old
     0.5 / 0.28 container opacity, without weakening the fades. */
  .lens-photo-scrim {
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }
  :global(:root[data-theme='dark']) .lens-photo-scrim {
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
  }

  /* Left fade: the homepage hero's eased multi-stop ramp — solid page colour
     at the photo's left edge, long soft tail over the image. */
  .lens-photo-fade {
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 88%, transparent) 26%,
      color-mix(in srgb, var(--color-bg) 48%, transparent) 56%,
      color-mix(in srgb, var(--color-bg) 14%, transparent) 80%,
      transparent 100%
    );
  }
</style>
