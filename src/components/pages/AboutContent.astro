---
import CTABand from '../ui/CTABand.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import PageBackdrop from '../ui/PageBackdrop.astro';
import FAQ from '../ui/FAQ.astro';
import Icon from '../ui/Icon.astro';
import { cvData } from '../../data/cv';

// Press + video. Both cards use covers generated for the articles rather than
// a YouTube still and an icon band: the still was low-resolution letterboxed
// 4:3 and the icon card carried no image at all, so the pair never matched.
const pressIconName: Record<string, string> = { play: 'play', article: 'file-text' };
const pressLinks = [
  {
    href: 'https://www.youtube.com/watch?v=UWJN-DwqDbE',
    source: 'YouTube · Talk',
    title: 'InfoShare 2023: AI systems, GTM, and shipped products',
    detail: 'On stage with Bartosz Baziński on building products that solve real problems.',
    label: 'Watch on YouTube',
    icon: 'play',
    thumb: '/images/insights/ai-production-stack.webp',
  },
  {
    href: 'https://mamstartup.pl/czy-mozna-budowac-globalny-startup-w-czasie-deglobalizacji/',
    source: 'MamStartup · Article + Podcast',
    title: 'Czy można budować globalny startup w czasie deglobalizacji?',
    detail: 'Feature interview and podcast on global product thinking, AI adoption, and growth systems.',
    label: 'Read the article',
    icon: 'article',
    thumb: '/images/insights/gpt-5-6-vs-claude-5-desk-v1.webp',
  },
];

/* Roles come from src/data/cv.ts, the same array the eight /cv pages render.
   This page used to keep its own list, and the two drifted until they
   described different careers: /about said "Independent operator" while the CV
   said Head of Marketing somewhere else. One source now, and the bullets bring
   the numbers with them.

   Only presentation lives here. A brand mark, a link, a sector label and any
   sub-brands are how a role looks on this page, not what the role was, so they
   are keyed by company rather than pushed into the CV data. */
const PRESENTATION: Record<string, { logo?: string; href?: string; sector?: string; brands?: string[] }> = {
  'CodiLime':             { logo: '/images/logos/codilime.svg',        href: 'https://codilime.com',          sector: 'B2B technology services · SaaS GTM model' },
  'WebWave':              { logo: '/images/logos/webwave.svg',         href: 'https://webwave.me',            sector: 'AI SaaS website builder' },
  'Symfonia':             { logo: '/images/logos/symfonia.webp',       href: 'https://symfonia.pl',           sector: 'ERP / business software · web growth' },
  'Tekhuset':             {                                            href: 'https://tekhuset.no',           sector: 'Nordic ecommerce · DTC · performance', brands: ['iviSkin', 'Neatsvor'] },
  'SentiOne':             { logo: '/images/logos/sentione.png',        href: 'https://sentione.com',          sector: 'B2B SaaS · AI social listening and conversational AI' },
  'GetResponse':          { logo: '/images/logos/getresponse.svg?v=2', href: 'https://getresponse.com',       sector: 'Email · marketing automation · global SaaS' },
  'Gi Group Holding':     { logo: '/images/logos/gigroup.png',         href: 'https://gigroupholding.com',    sector: 'HR tech · enterprise AI' },
  'Marquard Media Group': { logo: '/images/logos/marquard.svg',        href: 'https://www.marquardgroup.com', sector: 'Media group · nine portal digital portfolio', brands: ['Cosmopolitan', 'Esquire', "Harper's Bazaar", 'Joy', 'Playboy'] },
  'Lilla House Digital':  { logo: '/images/logos/lhdigital.svg',       href: 'https://lhdigital.pl',          sector: 'SEO · paid · social · content' },
  'City of \u0141\u00f3d\u017a Office':  { logo: '/images/logos/lodz.png',            href: 'https://lodz.pl',               sector: 'Brand · PR · campaigns' },
  'mBank':                {                                            href: 'https://www.mbank.pl',          sector: 'B2C finance · banking · product acquisition' },
  'LCDNiKP':              {                                            href: 'https://wckp.lodz.pl',          sector: 'Education · web design · internet services' },
};

const timeline = cvData.experience.map((entry) => ({
  // The CV renders "present" separately so it can be localised, and wraps the
  // range over two lines to fit its column. Neither applies here.
  period: entry.period.replace(/\n/g, ' '),
  role: entry.role.en,
  company: entry.company,
  bullets: entry.bullets.en,
  contract: entry.contract ?? false,
  ...PRESENTATION[entry.company],
}));

/* The CV's own SELECTED IMPACT block. What stood here before was four cards
   reading Role / Focus / Practice / Proof, and the last one said "Built and
   shipped: products, workflows, case studies, and writing", which is a
   sentence that survives being said about anybody. These are numbers with a
   named company attached, so they can be checked and they cannot be recycled. */
const impact = [
  {
    value: '+200%',
    label: 'pipeline',
    detail: 'from AI-native targeting, outbound, CRM intelligence and revenue cadence',
  },
  {
    value: '+80%',
    label: 'new customers · SentiOne',
    detail: 'through lifecycle experiments and funnel governance',
  },
  {
    value: '+60% / +50%',
    label: 'brand recognition · organic traffic',
    detail: 'via SEO systems, category content and AEO',
  },
  {
    value: '+30% / +25%',
    label: 'Symfonia leads · Tekhuset conversion',
    detail: 'through CRO, analytics and checkout work',
  },
];

const engagements = [
  { en: 'Revenue architecture audit and redesign' },
  { en: 'GTM system build or rebuild' },
  { en: 'AI workflow design and implementation' },
  { en: 'CRM, SEO, CRO and outbound operating models' },
  { en: 'Missing product layer, built and shipped' },
  { en: 'Growth team operating cadence and dashboards' },
];

const faq = [
  {
    question: 'What kind of companies do you work with?',
    answer: 'B2B SaaS companies, typically Series A–C, with 15–200 people. The common thread: they have a working product and a pipeline problem. Something in the revenue architecture is broken or missing. Not a good fit for pre-product or consumer.',
  },
  {
    question: 'Do you work as a fractional leader or on project basis?',
    answer: 'Both, depending on the scope. For deep system builds (CRM overhaul, outbound motion, AI workflow design) I prefer a defined project with a clear output. For ongoing operating cadence or embedded GTM work I can do fractional. Happy to talk through what makes sense for your situation.',
  },
  {
    question: 'What does an engagement actually look like?',
    answer: 'Starts with a revenue architecture audit: I map what\'s connected, what\'s broken, and where the signal is lost. Then we agree on the system to build or fix, I build it (sometimes alongside your team), and instrument it so you can run it without me.',
  },
  {
    question: 'Can you just help with AI tooling without the GTM layer?',
    answer: 'Yes, I can scope a standalone AI workflow design and implementation engagement. Most of my AI work is practical: agent stacks, MCP tooling, CRM automation, AI-assisted sequences. Not strategy decks.',
  },
  {
    question: 'How long does a typical project take?',
    answer: 'A focused system build (e.g. outbound motion + CRM operating model) runs 6–10 weeks. A full revenue architecture rebuild is 3–4 months. Smaller scopes (AI workflow design, audit only) can be 2–3 weeks.',
  },
];
---

<!-- Hero -->
<section class="relative pt-12 pb-12 md:pt-24 md:pb-20 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-office.webp" position="center 28%" opacity={0.12} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      {/* Text-only hero, the same shape every other top-level page uses. The
          stock portrait that sat beside this said nothing the copy does not
          say better, and on a phone it pushed the first sentence most of a
          screen down. The office shot stays as the 12% backdrop. */}
      <div class="max-w-3xl animate-fade-up mb-12 md:mb-14">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
            <span class="obs-label-accent">About</span>
          </div>
          <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-about">
            Wojciech Łuszczyński
          </h1>
          <p class="text-[length:var(--text-lead)] text-[var(--color-text)] leading-relaxed mb-3">
            I build revenue systems and run them. Operator for B2B SaaS and technology companies.
          </p>
          <p class="text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
            I connect GTM strategy, positioning, SEO, content, paid acquisition, CRM,
            analytics, automation, and AI workflows into one operating model. Everything
            under wojciech.io is original work: written, built, shipped, and operated by me.
          </p>
        </div>
      </div>

      {/* Numbers first, and each one names where it happened. A number with a
          company on it is checkable; "built and shipped" is not. */}
      <div class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-4">
        {impact.map(({ label, value, detail }) => (
          <div class="bg-[rgb(var(--color-surface-rgb)/0.86)] px-5 py-6 backdrop-blur-sm">
            <p class="text-[length:clamp(1.5rem,1.4vw+1.1rem,2rem)] font-semibold leading-none tracking-tight text-[var(--color-text)]">{value}</p>
            <p class="mt-2.5 text-sm font-medium leading-snug text-[var(--color-text)]">{label}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-[var(--color-text-muted)]">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience: one collapsible row per role, straight from the CV -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Experience"
        heading="Where I've operated."
        lead="Every role collapsed to the company and the years. Open one to see what the work actually was."
        class="mb-10"
      />

      {/* Native <details>, no JavaScript. Each brand mark now sits on the role
          it belongs to instead of in a flat wall above the timeline, where
          thirteen unrelated logos read as a pile and wrapped into a block of
          their own on a phone. The media and commerce marks travel with the
          roles that earned them, as `brands` inside the open panel. */}
      <div class="max-w-4xl divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        {timeline.map(({ period, role, company, logo, brands, href, bullets, contract, sector }, i) => (
          <details class="role group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center gap-4 py-5 transition-colors hover:bg-[var(--color-surface)]/60">
              {/* Fixed box so rows line up whether or not a mark exists. It
                  narrows on a phone: at 104px the logo column was taking a
                  third of a 375px screen and squeezing the role title, which
                  is the line people actually scan. */}
              <span class="flex h-8 w-[76px] shrink-0 items-center sm:w-[104px]">
                {logo
                  ? <img src={logo} alt="" width="104" height="28" loading="lazy" decoding="async" class="role-logo max-h-6 w-auto max-w-full sm:max-h-7" />
                  : <span class="text-xs font-semibold leading-tight text-[var(--color-text)] sm:text-sm">{company}</span>
                }
              </span>

              <span class="min-w-0 flex-1">
                {/* Wraps rather than truncates. "Head of Growth & Web D…" tells
                    the reader nothing, and the row can afford two lines. */}
                <span class="block text-sm font-semibold leading-snug text-[var(--color-text)] sm:text-base">{role}</span>
                <span class="mt-0.5 block text-xs text-[var(--color-text-dim)]">
                  {logo && <span class="font-normal text-[var(--color-text-muted)]">{company} · </span>}
                  <span class:list={[contract ? 'italic' : '']}>{period}</span>
                  {contract && <span class="obs-label ml-2 text-[10px] opacity-70">Contract</span>}
                </span>
              </span>

              {/* The rotation is on this wrapper, not on the icon itself.
                  Tailwind's group-open: utility produced no transform here,
                  and a scoped rule cannot reach the <svg> because that element
                  belongs to Icon.astro, not to this template. A span this
                  template owns sidesteps both. */}
              <span class="role-chevron flex shrink-0 text-[var(--color-text-dim)]">
                <Icon name="chevron-down" class="h-4 w-4" />
              </span>
            </summary>

            <div class="pb-6 pl-0 sm:pl-[120px] -mt-1">
              {/* Bullets, not a paragraph. The CV carries the numbers per
                  role, and a wall of prose buries them. */}
              <ul class="m-0 max-w-2xl list-none space-y-2 p-0">
                {bullets.map((line) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-[var(--color-text-muted)]">
                    <span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-3 flex flex-wrap items-center gap-2">
                {sector && (
                  <span class="rounded-full border border-[var(--color-accent)]/15 bg-[var(--color-accent)]/8 px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent)]">
                    {sector}
                  </span>
                )}
                {brands?.map((brand) => (
                  <span class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs font-medium text-[var(--color-text-dim)]">
                    {brand}
                  </span>
                ))}
                {href && (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link inline-flex items-center gap-1 text-xs font-medium text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-accent-hi)]"
                  >
                    {company}
                    <Icon name="external-link" class="h-3 w-3 opacity-40 transition-opacity group-hover/link:opacity-80" />
                  </a>
                )}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Press + video -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Featured in"
        heading="Press and video."
        class="mb-10"
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {pressLinks.map(({ href, source, title, detail, label, icon, thumb }, index) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal-index={index + 1}
            class="reveal-up group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] card-hover"
          >
            {thumb ? (
              /* 16:9 still with a play badge over it. The card without a
                 thumbnail gets a matching band instead of a shorter card, so
                 the pair stays the same height on one row. */
              <span class="relative block aspect-video overflow-hidden bg-[var(--color-bg)]">
                <img
                  src={thumb}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                />
                <span class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent" aria-hidden="true"></span>
                {/* Play badge only on the video. The article got one too when
                    both cards gained a cover, which promised a player that is
                    not there. */}
                <span class="absolute bottom-3 left-3 inline-flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent)] text-black shadow-lg">
                  <Icon name={icon === 'play' ? 'play' : (pressIconName[icon] ?? 'file-text')} class="h-4 w-4" />
                </span>
              </span>
            ) : (
              <span class="relative flex aspect-video items-center justify-center overflow-hidden bg-[linear-gradient(135deg,var(--color-surface),var(--color-bg))]">
                <span class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:28px_28px] opacity-60" aria-hidden="true"></span>
                <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-[var(--radius-badge)] border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/10 text-[var(--color-accent-hi)] transition-colors group-hover:border-[var(--color-accent)]/50 group-hover:bg-[var(--color-accent)]/20">
                  <Icon name={pressIconName[icon] ?? 'file-text'} class="h-5 w-5" />
                </span>
              </span>
            )}

            <div class="min-w-0 flex-1 p-5">
              <span class="obs-label-accent mb-1.5 block">{source}</span>
              <h3 class="text-sm font-semibold leading-snug text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">{title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-[var(--color-text-muted)]">{detail}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-[var(--color-text-dim)] transition-colors group-hover:text-[var(--color-accent-hi)]">
                {label}
                <Icon name="arrow-right" class="h-3 w-3 transition-transform duration-150 group-hover:translate-x-0.5 rtl-flip-x" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Working with me + FAQ: the conversion act, on one band -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <SectionHeader
            eyebrow="Working with me"
            heading="What you can expect."
            lead="I work best where there's a real business problem, not a vague mandate. The output is always a system, not a deck."
            class="mb-8"
          />
          <div class="space-y-3">
            {engagements.map(({ en }) => (
              <div class="flex items-start gap-3 group">
                <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
                <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{en}</p>
              </div>
            ))}
          </div>
          <a
            href="/contact/"
            class="btn-press inline-flex items-center gap-2 mt-8 border border-[var(--color-border-2)] text-[var(--color-text)] text-sm font-medium px-5 py-2.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
          >
            Book a call →
          </a>
        </div>
        <div>
          <span class="obs-label-accent mb-5 block">Common questions</span>
          <FAQ items={faq} />
        </div>
      </div>
    </div>
  </section>

<style>
  /* Kill the native disclosure triangle in both engines; the chevron in the
     summary is the affordance. ::-webkit-details-marker is still needed for
     Safari, which ignores list-style on <summary>. */
  .role > summary::-webkit-details-marker {
    display: none;
  }
  .role > summary::marker {
    content: '';
  }
  .role > summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: var(--radius-btn);
  }

  /* Same monochrome silhouette the marquee uses, so mixed brand colours read
     as one set and stay legible in both themes. */
  .role-logo {
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
    opacity: 0.55;
    transition: opacity 0.15s ease;
  }
  :root[data-theme='dark'] .role-logo {
    filter: brightness(0) invert(1);
    opacity: 0.6;
  }
  .role > summary:hover .role-logo,
  .role[open] .role-logo {
    opacity: 0.9;
  }

  /* The standalone `rotate` property, not `transform`. Something further up
     the cascade already resolves `transform` on this span to the identity
     matrix, which silently swallowed a `transform: rotate(180deg)` here.
     `rotate` composes independently and is not affected by it. */
  /* The chevron does not flip, deliberately. Rotating it on [open] applies
     correctly to the row the server renders open and then refuses to apply to
     any row toggled in the browser: the computed value settles at 0deg on
     click, through both `transform` and the standalone `rotate` property, with
     the selector verified as matching. A chevron that turns on one row and not
     the others is worse than one that never turns, so it stays put and the
     open panel itself is the state cue. */
  .role-chevron {
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }
  .role > summary:hover .role-chevron,
  .role[open] .role-chevron {
    opacity: 1;
  }
</style>

{/* Ends on a full stop, not a question mark: the band renders the closing
    punctuation in accent yellow, and a lone floating "?" read as a rendering
    fault rather than a flourish. Copy is the ask itself, not a joke about
    having just read a CV. */}
<CTABand
  heading="Tell me what is not converting."
  subtext="If the GTM stack has grown into something nobody fully owns, that is the work. Bring the current state and the number you need to move."
  ctaSecondary="See the work"
  ctaSecondaryHref="/work/"
/>
