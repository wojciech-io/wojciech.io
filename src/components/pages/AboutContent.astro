---
import AvatarRing from '../ui/AvatarRing.astro';
import CTABand from '../ui/CTABand.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import PageBackdrop from '../ui/PageBackdrop.astro';
import FAQ from '../ui/FAQ.astro';
import { STACK } from '../../data/stack';

const timeline = [
  {
    period: 'Now',
    role: 'Independent operator',
    company: 'wojciech.io',
    description: 'Building the public portfolio, app workspace, case studies, and AI-native GTM tools as one operating system across wojciech.io and app.wojciech.io.',
    contract: false,
  },
  {
    period: 'Oct 2025 – Mar 2026',
    role: 'Fractional GTM & Growth Lead',
    company: 'CodiLime',
    href: 'https://codilime.com',
    description: 'End-to-end GTM execution: AI-driven growth loops across content, SEO, paid and lifecycle; lead magnets, conversion assets, and revenue-linked measurement.',
    contract: true,
  },
  {
    period: 'May – Oct 2025',
    role: 'Fractional Head of Marketing',
    company: 'WebWave',
    href: 'https://webwave.me',
    description: 'Fractional marketing leadership for an AI-powered website builder: GTM, positioning, commercial messaging, paid, SEO, and growth cadence.',
    contract: true,
  },
  {
    period: '2024 – Oct 2025',
    role: 'Head of Growth & Web Development',
    company: 'Symfonia',
    href: 'https://symfonia.pl',
    description: 'Growth, web development, UX/CRO, migration, SEO, lead generation, and integrated campaigns for a large-scale business software brand.',
    contract: false,
  },
  {
    period: 'Oct 2023 – Dec 2024',
    role: 'Chief Marketing Officer',
    company: 'Tekhuset AS',
    href: 'https://tekhuset.no',
    description: 'Marketing strategy across Norway, Denmark, and Sweden. Led SEO and CRO for e-commerce brands, achieving top-3 rankings in Nordic markets and a 25% uplift in conversion rates.',
    contract: false,
  },
  {
    period: 'Oct 2020 – Jun 2024',
    role: 'Global Head of Growth & Retention',
    company: 'SentiOne',
    href: 'https://sentione.com',
    description: 'Built and scaled B2B SaaS growth and retention across Europe, UK, US, and LATAM: demand generation, enterprise GTM, lifecycle, and deal-cycle acceleration.',
    contract: false,
  },
  {
    period: '2022',
    role: 'Global AI & Innovation Manager',
    company: 'Gi Group Holding',
    href: 'https://gigroupholding.com',
    description: 'Project work on AI initiatives, digital process mapping, and innovation roadmap alignment across multiple business units.',
    contract: true,
  },
  {
    period: 'Oct 2019 – Oct 2020',
    role: 'Head of Lifecycle Marketing',
    company: 'GetResponse',
    href: 'https://getresponse.com',
    description: 'Lifecycle marketing, CRM, segmentation, A/B testing, conversion optimisation, and customer engagement programs for a global SaaS product.',
    contract: false,
  },
  {
    period: '2018 – 2019',
    role: 'Head of Digital',
    company: 'Marquard Group',
    href: 'https://www.marquardgroup.com',
    description: 'Digital strategy, SEO, UX, PPC, and multi-brand publishing growth across a 9-portal media portfolio.',
    contract: false,
  },
  {
    period: '2018',
    role: 'Head of Marketing',
    company: 'Lilla House Digital',
    href: 'https://lhdigital.pl',
    description: 'Full-stack digital marketing: SEO, PPC, email, social, and conversion optimisation. Built and ran campaigns across multiple channels independently.',
    contract: true,
  },
  {
    period: '2010 – 2018',
    role: 'Head of MarComm / Sr PR Manager / PR Manager',
    company: 'City of Łódź Office',
    href: 'https://lodz.pl',
    description: 'Eight-year communications track across PR, senior PR, and MarComm leadership: media relations, public campaigns, crisis communication, and city-wide messaging.',
    contract: false,
  },
];

const traits = [
  {
    label: 'Operator, not advisor',
    body: 'I build and run the systems myself. Scope, then ship, then stay in until it works. If the right tool doesn\'t exist, I write it.',
  },
  {
    label: 'AI-native by practice',
    body: 'Not a prompt engineer. I redesign the architecture of growth systems using AI: how they\'re built, iterated, and operated at scale.',
  },
  {
    label: 'Builder with business context',
    body: 'I can move from revenue strategy to a working product in the same engagement. That range is rare, and I maintain it deliberately.',
  },
  {
    label: 'Systems over sprints',
    body: 'Compounding returns, not quarterly campaigns. Every engagement ends with something that keeps working after I\'m gone.',
  },
];

const proofPoints = [
  {
    label: 'Role',
    value: 'GTM architect',
    detail: 'Growth operator and AI-native builder',
  },
  {
    label: 'Focus',
    value: 'Revenue systems',
    detail: 'For B2B SaaS and technology companies',
  },
  {
    label: 'Practice',
    value: '20 years',
    detail: '10 B2B SaaS · 10 GTM · Europe, UK, US, LATAM',
  },
  {
    label: 'Proof',
    value: 'Built and shipped',
    detail: 'Products, workflows, case studies, and writing',
  },
];

const faq = [
  {
    question: 'What kind of companies do you work with?',
    answer: 'B2B SaaS companies, typically Series A–C, with 15–200 people. The common thread: they have a working product and a pipeline problem. Something in the revenue architecture is broken or missing. Not a good fit for pre-product or consumer.',
  },
  {
    question: 'Do you work as a fractional leader or on project basis?',
    answer: 'Both, depending on the scope. For deep system builds (CRM overhaul, outbound motion, AI workflow design) I prefer a defined project with a clear output. For ongoing operating cadence or embedded GTM work I can do fractional. Happy to talk through what makes sense for your situation.',
  },
  {
    question: 'What does an engagement actually look like?',
    answer: 'Starts with a revenue architecture audit: I map what\'s connected, what\'s broken, and where the signal is lost. Then we agree on the system to build or fix, I build it (sometimes alongside your team), and instrument it so you can run it without me.',
  },
  {
    question: 'Can you just help with AI tooling without the GTM layer?',
    answer: 'Yes, I can scope a standalone AI workflow design and implementation engagement. Most of my AI work is practical: agent stacks, MCP tooling, CRM automation, AI-assisted sequences. Not strategy decks.',
  },
  {
    question: 'How long does a typical project take?',
    answer: 'A focused system build (e.g. outbound motion + CRM operating model) runs 6–10 weeks. A full revenue architecture rebuild is 3–4 months. Smaller scopes (AI workflow design, audit only) can be 2–3 weeks.',
  },
];
---

<!-- Hero -->
<section class="relative pt-24 pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-stage.webp" position="center 38%" opacity={0.09} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row gap-10 md:gap-14 items-start sm:items-center animate-fade-up mb-12">
        <AvatarRing src="/images/wojciech-hero.webp" size="xl" loading="eager" />
        <div class="max-w-xl">
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">About</p>
          <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">
            Wojciech Łuszczyński
          </h1>
          <p class="text-lg md:text-xl text-[var(--color-text)] leading-relaxed mb-3">
            I build the revenue system, then stay until it runs. Operator for B2B SaaS and technology companies.
          </p>
          <p class="text-[var(--color-text-muted)] leading-relaxed">
            I connect GTM strategy, positioning, SEO, content, paid acquisition, CRM,
            analytics, automation, and AI workflows into one operating model. Everything
            under wojciech.io is original work: written, built, shipped, and operated by me.
          </p>
        </div>
      </div>

      <!-- Proof rail -->
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {proofPoints.map(({ label, value, detail }) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[rgb(var(--color-surface-rgb)/0.72)] px-5 py-4 backdrop-blur-sm">
            <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--color-accent)]">{label}</p>
            <p class="text-base font-semibold text-[var(--color-text)]">{value}</p>
            <p class="mt-1 text-xs leading-relaxed text-[var(--color-text-muted)]">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What makes me atypical -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="What makes me different"
        heading="I connect revenue strategy, AI workflows, and shipped software into one operating model."
        class="mb-12"
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {traits.map(({ label, body }) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-border-2)]">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 flex items-center justify-center mb-5">
              <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold text-[var(--color-text)] mb-2">{label}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Speaking photo band -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-2 gap-4 md:gap-6">
      <div class="relative h-72 md:h-96 rounded-[var(--radius-card)] bg-[var(--color-surface-2)] overflow-hidden">
        <img
          src="/images/wojciech-stage.webp"
          alt="Wojciech Łuszczyński speaking on stage at Infoshare"
          class="absolute inset-0 w-full h-full object-cover object-[center_20%] opacity-90"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[var(--color-bg)]/60 rounded-[var(--radius-card)]" />
      </div>
      <div class="relative h-72 md:h-96 rounded-[var(--radius-card)] bg-[var(--color-surface-2)] overflow-hidden">
        <img
          src="/images/wojciech-infoshare.webp"
          alt="Wojciech Łuszczyński presenting at Infoshare conference"
          class="absolute inset-0 w-full h-full object-cover object-[center_30%] opacity-80"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-[var(--color-bg)]/80" />
        <!-- Overlay label -->
        <div class="absolute bottom-6 right-6">
          <p class="text-xs font-mono text-[var(--color-text-dim)]">Infoshare · AI stage</p>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader eyebrow="Experience" heading="Where I've operated." class="mb-10" />
      <div class="divide-y divide-[var(--color-border)] max-w-3xl">
        {timeline.map(({ period, role, company, href, description, contract }, i) => (
          <div class:list={['flex flex-col sm:flex-row gap-4 py-7', i === 0 ? 'pt-0' : '']}>
            <div class="sm:w-32 shrink-0 pt-0.5">
              <p class:list={['text-xs font-mono text-[var(--color-text-dim)]', contract ? 'italic' : '']}>{period}</p>
            </div>
            <div>
              <p class="text-base font-semibold text-[var(--color-text)] mb-0.5">{role}</p>
              {href
                ? <a href={href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors mb-2 inline-flex items-center gap-1 group">
                    {company}
                    <svg class="w-3 h-3 opacity-40 group-hover:opacity-80 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                : <p class="text-sm font-medium text-[var(--color-text-muted)] mb-2">{company}</p>
              }
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-lg">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ: moved up, visible before "working with me" -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <div>
          <SectionHeader eyebrow="FAQ" heading="Common questions." class="mb-2" />
          <p class="text-[var(--color-text-muted)] mt-4 text-sm leading-relaxed max-w-sm">
            If you're considering working with me: these cover how I engage, what to expect, and whether it's the right fit.
          </p>
          <a
            href="/contact/#book-call"
            class="btn-press inline-flex items-center gap-2 mt-8 border border-[var(--color-border-2)] text-[var(--color-text)] text-sm font-medium px-5 py-2.5 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)] transition-colors"
          >
            Book a call instead →
          </a>
        </div>
        <div>
          <FAQ items={faq} />
        </div>
      </div>
    </div>
  </section>

  <!-- Working with me -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
        <SectionHeader
          eyebrow="Working with me"
          heading="What you can expect."
          lead="I work best in engagements where there's a real business problem, not a vague mandate. The output is always a system, not a deck."
        />
        <div class="space-y-4">
          {[
            { en: 'Revenue architecture audit and redesign', pl: 'Audyt i przeprojektowanie architektury przychodów', it: 'Audit e riprogettazione dell\'architettura di revenue' },
            { en: 'GTM system build or rebuild', pl: 'Budowa lub przebudowa systemu GTM', it: 'Costruzione o ricostruzione del sistema GTM' },
            { en: 'AI workflow design and implementation', pl: 'Projekt i implementacja workflow AI', it: 'Progettazione e implementazione workflow AI' },
            { en: 'CRM, SEO, CRO and outbound operating models', pl: 'Modele operacyjne CRM, SEO, CRO i outbound', it: 'Modelli operativi CRM, SEO, CRO e outbound' },
            { en: 'Missing product layer, built and shipped', pl: 'Brakująca warstwa produktowa, zbudowana i wdrożona', it: 'Strato prodotto mancante, costruito e lanciato' },
            { en: 'Growth team operating cadence and dashboards', pl: 'Rytm operacyjny i dashboardy dla teamu wzrostu', it: 'Ritmo operativo e dashboard per il team di crescita' },
          ].map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item.en}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <SectionHeader
          eyebrow="Stack"
          heading="How I build."
          lead="Technology categories I work with and what each one makes possible."
          class="mb-0"
        />
        <a
          href="https://app.wojciech.io"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-xs font-medium text-[var(--color-text-dim)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          Full workspace →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {STACK.map((cat) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 card-lift hover:border-[var(--color-border-2)]">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-3">{cat.name}</p>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {cat.items.map((item) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-0.5 text-[11px] font-medium text-[var(--color-text-muted)]">
                  {item.icon
                    ? <img src={`https://cdn.simpleicons.org/${item.icon}/${item.iconColor}`} width="11" height="11" loading="lazy" alt="" aria-hidden="true" onerror="this.style.display='none'" />
                    : item.letterMark
                      ? <span class="text-[9px] font-bold text-[var(--color-accent)] leading-none">{item.letterMark}</span>
                      : null
                  }
                  {item.name}
                </span>
              ))}
            </div>
            <p class="text-[11px] leading-relaxed text-[var(--color-text-dim)]">{cat.enables}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

<CTABand />
