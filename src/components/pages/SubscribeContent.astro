              <span style="display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-hi); background: color-mix(in srgb, var(--color-accent-cta) 16%, transparent); border-radius: 999px; padding: 3px 8px; margin-right: 0.5rem; vertical-align: middle;">{item.tag}</span>
              <span style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); vertical-align: middle;">{item.title}</span>
              <span style="display: block; font-size: 0.8125rem; line-height: 1.5; color: var(--color-text-muted); margin-top: 0.25rem;">{item.lead}</span>
            </span>
            <time datetime={item.date} style="font-size: 0.75rem; font-weight: 500; color: var(--color-text-dim); white-space: nowrap;">{shortDate(item.date)}</time>
          </li>
        ))}
      </ul>

      <!-- Closing CTA banner: the last stop after scanning the archive. The
           same inverted espresso panel as the sign-up band, so every
           subscribe moment on the page speaks one visual language. -->
      <div class="closing-banner">
        <div class="closing-aura" aria-hidden="true"></div>
        <div style="position: relative; min-width: 0;">
          <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
            <span class="closing-tick" aria-hidden="true"></span>
            <span style="font-family: var(--font-mono); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-accent-cta);">Tomorrow's issue</span>
          </div>
          <p style="margin: 0 0 0.375rem; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: -0.02em; color: var(--band-text);">Read tomorrow's issue before your first meeting.</p>
          <p style="margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--band-muted);">One email a day, under three minutes, free. Currently <span style="color: var(--band-text); font-weight: 600;">{totalIssues} issues</span> in. A full day of signal, one sip.</p>
        </div>
        <a href="#subscribe" class="sub-cta btn-press obs-mono" style="position: relative; display: inline-flex; align-items: center; height: 3rem; border-radius: var(--radius-btn); background: var(--color-accent-cta); padding: 0 1.75rem; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-accent-text); text-decoration: none; white-space: nowrap; transition: background-color 0.15s; flex-shrink: 0;">
          Subscribe free →
        </a>
      </div>
    </div>
  </section>

</div>

<script>
  // Wired via astro:page-load, NOT at module top level: with the ClientRouter
  // (view transitions) this module runs once per session, so a top-level
  // getElementById would bind the handler to a DOM that gets swapped away —
  // navigate away and back and the form would submit natively as a GET.
  // astro:page-load fires on first load AND after every client-side swap.
  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  if (!form || form.dataset.wired === '1') return;
  form.dataset.wired = '1';
  const status = document.getElementById('sub-status') as HTMLElement;
  const btn = document.getElementById('sub-btn') as HTMLButtonElement;
  const emailInput = document.getElementById('sub-email') as HTMLInputElement;
  const consentInput = document.getElementById('sub-consent') as HTMLInputElement;
  const honeypot = document.getElementById('sub-website') as HTMLInputElement;

  // Confirmation link landed: the band becomes the "you're in" moment.
  if (new URLSearchParams(location.search).get('confirmed') === '1') {
    form.style.display = 'none';
    document.getElementById('subscribe')?.classList.add('is-done');
    (document.getElementById('confirmed-state') as HTMLElement).style.display = 'flex';
    history.replaceState({}, '', location.pathname + '#subscribe');
    document.getElementById('subscribe')?.scrollIntoView({ block: 'center' });
  }

  // Bot timing signal: real people do not submit within two seconds of load.
  const loadedAt = Date.now();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim().toLowerCase();
    if (!email || !emailInput.validity.valid) {
      status.textContent = 'Please enter a valid email address.';
      status.style.color = '#f87171';
      emailInput.focus();
      return;
    }
    if (!consentInput.checked) {
      status.textContent = 'Please tick the consent box. It is required to send you the newsletter.';
      status.style.color = '#f87171';
      consentInput.focus();
      return;
    }
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.textContent = 'Sending...';
    status.textContent = '';
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          consent: true,
          website: honeypot?.value || '',
          elapsed: Date.now() - loadedAt,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('subscribe')?.classList.add('is-done');
        (document.getElementById('pending-email') as HTMLElement).textContent = email;
        (document.getElementById('pending-state') as HTMLElement).style.display = 'flex';
      } else {
        throw new Error((data as any)?.error || 'Failed');
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      btn.textContent = 'Subscribe free →';
      status.textContent = err?.message === 'Failed' ? 'Something went wrong. Try again.' : (err?.message || 'Something went wrong.');
      status.style.color = '#f87171';
    }
  });
  });
</script>

