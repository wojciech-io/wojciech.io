---
// Subscribe page content: single source for /subscribe and /[lang]/subscribe.
---

<section class="subscribe-page relative overflow-hidden border-b border-[var(--color-border)]">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true" />
  <div class="pointer-events-none absolute left-1/2 top-[-220px] h-[520px] w-[720px] -translate-x-1/2 rounded-full bg-[var(--color-accent)]/10 blur-[150px]" aria-hidden="true" />

  <div class="relative mx-auto grid min-h-[calc(100dvh-154px)] max-w-6xl items-center gap-8 px-6 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(380px,0.72fr)] lg:py-20">
    <div class="max-w-2xl animate-fade-up">
      <div class="mb-7 inline-flex items-center gap-2 rounded-[var(--radius-badge)] border border-[var(--color-border)] bg-[var(--color-glass)] px-3 py-1.5 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_18px_rgb(235_255_0/0.55)]"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--color-text-muted)]">AI Espresso</span>
      </div>

      <h1
        class="max-w-[760px] text-[clamp(2.7rem,7vw,5.8rem)] font-semibold leading-[0.94] tracking-tight text-[var(--color-text)]"
      >
        Notes for people who ship.
      </h1>

      <p
        class="mt-7 max-w-xl text-base leading-relaxed text-[var(--color-text-muted)] md:text-lg"
      >
        A short operator note on AI systems, GTM architecture, automation, and software workflows. Practical, written from the builds, and sent from hello@wojciech.io.
      </p>

      <div class="mt-9 flex flex-wrap gap-2" aria-label="Newsletter details">
        {[
          { en: 'Free',                 pl: 'Bezpłatnie',                 it: 'Gratis' },
          { en: 'Under 3 minutes',      pl: 'Poniżej 3 minut',            it: 'Sotto 3 minuti' },
          { en: 'No surprise sequences',pl: 'Zero ukrytych sekwencji',    it: 'Niente sequenze a sorpresa' },
          { en: 'Unsubscribe anytime',  pl: 'Wypisujesz się kiedy chcesz',it: 'Disiscriviti quando vuoi' },
        ].map((p) => (
          <span class="rounded-[var(--radius-badge)] border border-[var(--color-border-2)] bg-[var(--color-surface)]/70 px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)]">{p.en}</span>
        ))}
      </div>
    </div>

    <aside class="animate-fade-up [animation-delay:100ms] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)]/92 p-5 shadow-[var(--shadow-card)] backdrop-blur md:p-7" aria-label="Subscribe to AI Espresso">
      <div class="mb-6 border-b border-[var(--color-border)] pb-5">
        <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--color-text-dim)]">Subscribe</p>
        <h2 class="text-2xl font-semibold leading-tight text-[var(--color-text)]">Get the next issue</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
          Confirm your email once. No name needed.
        </p>
      </div>

      <form id="subscribe-form" class="space-y-4" novalidate>
        <div>
          <label for="sub-email" class="mb-2 block text-xs font-medium text-[var(--color-text-muted)]">Email address</label>
          <input
            type="email"
            id="sub-email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@company.com"
            class="h-12 w-full rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-4 text-sm font-medium text-[var(--color-text)] outline-none transition-colors placeholder:text-[var(--color-text-dim)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/15"
          />
        </div>

        <div>
          <label for="sub-email-confirm" class="mb-2 block text-xs font-medium text-[var(--color-text-muted)]">Confirm email address</label>
          <input
            type="email"
            id="sub-email-confirm"
            name="email-confirm"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@company.com"
            class="h-12 w-full rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-surface-2)] px-4 text-sm font-medium text-[var(--color-text)] outline-none transition-colors placeholder:text-[var(--color-text-dim)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/15"
          />
        </div>

        <button
          type="submit"
          id="sub-btn"
          class="btn-press mt-2 inline-flex h-12 w-full items-center justify-center rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Subscribe free →
        </button>

        <p id="sub-status" class="min-h-5 text-center text-xs text-[var(--color-text-dim)]" role="status" aria-live="polite"></p>
      </form>

      <p class="mt-4 text-xs leading-relaxed text-[var(--color-text-dim)]">
        By subscribing, you agree to receive email notes from <a class="font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)]" href="mailto:hello@wojciech.io">hello@wojciech.io</a>.
      </p>
    </aside>
  </div>
</section>

<section class="border-b border-[var(--color-border)] py-[var(--space-section)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-[0.72fr_1.28fr]">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-text-dim)]">Inside the notes</p>
    <div class="grid gap-3 md:grid-cols-3">
      {[
        {
          en_t: 'AI systems', pl_t: 'Systemy AI', it_t: 'Sistemi AI',
          en_b: 'Agents, automations, product workflows, and what survives real usage.',
          pl_b: 'Agenci, automatyzacje, workflow produktowe: i co przeżywa realne użycie.',
          it_b: "Agenti, automazioni, workflow di prodotto: e cosa sopravvive all'uso reale.",
        },
        {
          en_t: 'GTM architecture', pl_t: 'Architektura GTM', it_t: 'Architettura GTM',
          en_b: 'Revenue systems, messaging, growth loops, outbound, and operating cadence.',
          pl_b: 'Systemy przychodowe, messaging, growth loopy, outbound i rytm operacyjny.',
          it_b: 'Sistemi di revenue, messaging, growth loop, outbound e ritmo operativo.',
        },
        {
          en_t: 'Build log', pl_t: 'Dziennik buildów', it_t: 'Diario di build',
          en_b: 'What shipped across wojciech.io, app.wojciech.io, and the tools around them.',
          pl_b: 'Co wdrożyłem na wojciech.io, app.wojciech.io i w narzędziach wokół nich.',
          it_b: "Cosa è stato rilasciato su wojciech.io, app.wojciech.io e negli strumenti intorno.",
        },
      ].map((c) => (
        <article class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <div class="mb-4 h-px w-10 bg-[var(--color-accent)]"></div>
          <h3 class="text-sm font-semibold text-[var(--color-text)]">{c.en_t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{c.en_b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  type Lang = 'en' | 'pl' | 'it';
  const t: Record<Lang, Record<string, string>> = {
    en: {
      invalid:     'Please enter a valid email address.',
      mismatch:    'Email confirmation does not match.',
      subscribing: 'Subscribing...',
      subscribed:  'Subscribed',
      success:     "You're in. Check your inbox if confirmation is required.",
      failGeneric: 'Something went wrong. Try again.',
      failShort:   'Something went wrong.',
      defaultBtn:  'Subscribe free →',
    },
    pl: {
      invalid:     'Wpisz poprawny adres email.',
      mismatch:    'Potwierdzenie nie zgadza się.',
      subscribing: 'Zapisuję...',
      subscribed:  'Zapisany',
      success:     'Jesteś w środku. Sprawdź skrzynkę, jeśli wymagane jest potwierdzenie.',
      failGeneric: 'Coś poszło nie tak. Spróbuj ponownie.',
      failShort:   'Coś poszło nie tak.',
      defaultBtn:  'Zapisz się bezpłatnie →',
    },
    it: {
      invalid:     'Inserisci un indirizzo email valido.',
      mismatch:    'La conferma email non corrisponde.',
      subscribing: 'Iscrizione in corso...',
      subscribed:  'Iscritto',
      success:     'Sei dentro. Controlla la casella se serve conferma.',
      failGeneric: 'Qualcosa è andato storto. Riprova.',
      failShort:   'Qualcosa è andato storto.',
      defaultBtn:  'Iscriviti gratis →',
    },
  };
  const getLang = (): Lang => 'en';

  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const status = document.getElementById('sub-status') as HTMLElement;
  const btn = document.getElementById('sub-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = t[getLang()];

    const emailInput = form.querySelector('#sub-email') as HTMLInputElement;
    const emailConfirmInput = form.querySelector('#sub-email-confirm') as HTMLInputElement;
    const email = emailInput.value.trim().toLowerCase();
    const emailConfirm = emailConfirmInput.value.trim().toLowerCase();

    if (!emailInput.value || !emailInput.validity.valid) {
      status.textContent = msg.invalid;
      status.className = 'min-h-5 text-center text-xs text-red-400';
      emailInput.focus();
      return;
    }

    if (!emailConfirmInput.value || !emailConfirmInput.validity.valid || email !== emailConfirm) {
      status.textContent = msg.mismatch;
      status.className = 'min-h-5 text-center text-xs text-red-400';
      emailConfirmInput.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = msg.subscribing;
    status.textContent = '';
    status.className = 'min-h-5 text-center text-xs text-[var(--color-text-dim)]';

    try {
      const data = { email };

      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        btn.textContent = msg.subscribed;
        btn.classList.add('bg-[var(--color-success)]');
        status.textContent = msg.success;
        status.className = 'min-h-5 text-center text-xs text-[var(--color-text-muted)]';
      } else {
        const json = await res.json().catch(() => ({}));
        throw new Error((json as any)?.error || 'Failed');
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.textContent = msg.defaultBtn;
      status.textContent = err?.message === 'Failed' ? msg.failGeneric : (err?.message || msg.failShort);
      status.className = 'min-h-5 text-center text-xs text-red-400';
    }
  });
</script>
