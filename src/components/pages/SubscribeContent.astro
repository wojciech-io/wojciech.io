  </section>

</div>

<script>
  if (new URLSearchParams(location.search).get('confirmed') === '1') {
    (document.getElementById('subscribe-form') as HTMLElement).style.display = 'none';
    (document.getElementById('confirmed-state') as HTMLElement).style.display = 'block';
    history.replaceState({}, '', location.pathname);
  }

  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const status = document.getElementById('sub-status') as HTMLElement;
  const btn = document.getElementById('sub-btn') as HTMLButtonElement;
  const emailInput = document.getElementById('sub-email') as HTMLInputElement;

  emailInput?.addEventListener('focus', () => {
    emailInput.style.borderColor = 'var(--color-accent-cta)';
    emailInput.style.boxShadow = '0 0 0 2px rgb(235 255 0 / 0.15)';
  });
  emailInput?.addEventListener('blur', () => {
    emailInput.style.borderColor = 'var(--color-border-2)';
    emailInput.style.boxShadow = 'none';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim().toLowerCase();
    if (!email || !emailInput.validity.valid) {
      status.textContent = 'Please enter a valid email address.';
      status.style.color = '#f87171';
      emailInput.focus();
      return;
    }
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.textContent = 'Sending...';
    status.textContent = '';
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.style.display = 'none';
        const confirmed = document.getElementById('confirmed-state') as HTMLElement;
        confirmed.style.display = 'block';
      } else {
        throw new Error((data as any)?.error || 'Failed');
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      btn.textContent = "Get tomorrow's issue →";
      status.textContent = err?.message === 'Failed' ? 'Something went wrong. Try again.' : (err?.message || 'Something went wrong.');
      status.style.color = '#f87171';
    }
  });
</script>

