---
import SectionHeader from '../ui/SectionHeader.astro';
import ProofCard from '../ui/ProofCard.astro';
import CTABand from '../ui/CTABand.astro';
import PageBackdrop from '../ui/PageBackdrop.astro';
import LiveEmbed from '../ui/LiveEmbed.astro';

const principles = [
  {
    n: '01',
    title: 'Fix the system first',
    titlePl: 'Najpierw napraw system',
    titleIt: 'Prima sistema il sistema',
    body: 'AI doesn\'t fix a broken GTM. If the pipeline leaks at qualification, AI-personalized sequences still go nowhere. I design the system first, then find where AI creates real leverage.',
    bodyPl: 'AI nie naprawi zepsutego GTM. Jeśli pipeline przecieka na kwalifikacji, sekwencje spersonalizowane przez AI i tak prowadzą donikąd. Najpierw projektuję system, potem szukam, gdzie AI daje realną dźwignię.',
    bodyIt: 'L\'AI non aggiusta un GTM rotto. Se la pipeline perde alla qualifica, le sequenze personalizzate dall\'AI non portano comunque da nessuna parte. Prima progetto il sistema, poi trovo dove l\'AI crea leva reale.',
  },
  {
    n: '02',
    title: 'Operator-grade, not demo-grade',
    titlePl: 'Klasa operatorska, nie demo',
    titleIt: 'Da operatore, non da demo',
    body: 'Generic AI wrappers don\'t survive contact with real work. I build tools that are instrumented, specific to the workflow, and used in production, not shown in a slide deck.',
    bodyPl: 'Generyczne nakładki na AI nie przetrwają kontaktu z prawdziwą pracą. Buduję narzędzia oprzyrządowane, dopasowane do workflow i używane w produkcji — nie pokazywane na slajdach.',
    bodyIt: 'I wrapper generici di AI non sopravvivono al contatto con il lavoro reale. Costruisco strumenti misurabili, specifici per il workflow e usati in produzione, non mostrati in una presentazione.',
  },
  {
    n: '03',
    title: 'Compounding, not one-shots',
    titlePl: 'Kumulacja, nie jednorazówki',
    titleIt: 'Compounding, non una tantum',
    body: 'The goal is a workflow that gets faster and smarter over time. Not a prompt that impresses once, breaks on the second run, and gets abandoned after two weeks.',
    bodyPl: 'Celem jest workflow, który z czasem staje się szybszy i mądrzejszy. Nie prompt, który zachwyca raz, psuje się przy drugim uruchomieniu i zostaje porzucony po dwóch tygodniach.',
    bodyIt: 'L\'obiettivo è un workflow che diventa più veloce e intelligente nel tempo. Non un prompt che impressiona una volta, si rompe al secondo utilizzo e viene abbandonato dopo due settimane.',
  },
  {
    n: '04',
    title: 'Every loop is measured',
    titlePl: 'Każda pętla jest mierzona',
    titleIt: 'Ogni ciclo è misurato',
    body: 'AI workflows without feedback loops don\'t improve — they drift. Every system I build has measurement baked in, so you know what\'s working, what\'s not, and what to change.',
    bodyPl: 'Workflow AI bez pętli sprzężenia zwrotnego nie poprawiają się — dryfują. Każdy system, który buduję, ma wbudowany pomiar, więc wiesz, co działa, co nie i co zmienić.',
    bodyIt: 'I workflow AI senza cicli di feedback non migliorano: vanno alla deriva. Ogni sistema che costruisco ha la misurazione integrata, così sai cosa funziona, cosa no e cosa cambiare.',
  },
];

const tools = [
  {
    title: 'AdsAI / Ad Assistant',
    description: 'One full ad lifecycle in AI: brief → generate → score → iterate → prepare variants for deployment. Built for GTM operators, not agency workflows.',
    descriptionPl: 'Pełny cykl życia reklamy w AI: brief → generowanie → ocena → iteracja → przygotowanie wariantów do wdrożenia. Zbudowane dla operatorów GTM, nie dla workflow agencyjnych.',
    descriptionIt: 'Un intero ciclo di vita dell\'annuncio in AI: brief → genera → valuta → itera → prepara le varianti per il deployment. Costruito per operatori GTM, non per workflow di agenzia.',
    tags: ['Ads', 'LLMs', 'GTM'],
  },
  {
    title: 'Claude Code GTM Agent Starter Pack',
    description: 'Open-source foundation for building GTM agents with Claude Code. Designed so operators can ship without starting from scratch.',
    descriptionPl: 'Otwartoźródłowy fundament do budowy agentów GTM z Claude Code. Zaprojektowany tak, by operatorzy mogli wdrażać bez zaczynania od zera.',
    descriptionIt: 'Base open-source per costruire agenti GTM con Claude Code. Progettata perché gli operatori possano lanciare senza partire da zero.',
    tags: ['Claude Code', 'Agents', 'Open source'],
    href: 'https://github.com/wojciechluszczynski/gtm-agent-repo',
  },
  {
    title: 'Notch, native macOS app',
    titlePl: 'Notch, natywna aplikacja macOS',
    titleIt: 'Notch, app macOS nativa',
    description: 'Built with Codex and Xcode. Proof that AI-assisted development covers native apps, not just web, extending the operator\'s reach beyond the browser.',
    descriptionPl: 'Zbudowane z Codeksem i Xcode. Dowód, że programowanie wspierane przez AI obejmuje aplikacje natywne, nie tylko web — i rozszerza zasięg operatora poza przeglądarkę.',
    descriptionIt: 'Costruito con Codex e Xcode. La prova che lo sviluppo assistito dall\'AI copre le app native, non solo il web, estendendo il raggio d\'azione dell\'operatore oltre il browser.',
    tags: ['macOS', 'Swift', 'Codex'],
    href: 'https://notch.wojciech.io',
  },
  {
    title: 'AI Adoption playbook for B2B SaaS',
    titlePl: 'Playbook adopcji AI dla B2B SaaS',
    titleIt: 'Playbook di adozione AI per B2B SaaS',
    description: 'Internal framework for compounding AI adoption across a B2B SaaS company: from growth and marketing through to product and ops.',
    descriptionPl: 'Wewnętrzny framework kumulującej się adopcji AI w firmie B2B SaaS: od wzrostu i marketingu po produkt i operacje.',
    descriptionIt: 'Framework interno per un\'adozione dell\'AI responsabile e cumulativa in un\'azienda B2B SaaS: dalla crescita e dal marketing fino al prodotto e alle operazioni.',
    tags: ['AI adoption', 'Framework', 'B2B SaaS'],
  },
  {
    title: 'CRM + outbound AI workflows',
    titlePl: 'Workflow AI dla CRM i outbound',
    titleIt: 'Workflow AI per CRM e outbound',
    description: 'Prospecting, sequencing, scoring, and CRM enrichment, redesigned with AI in the loop to cut manual work and improve signal quality.',
    descriptionPl: 'Prospecting, sekwencjonowanie, scoring i wzbogacanie CRM, przeprojektowane z AI w pętli, by ograniczyć pracę ręczną i poprawić jakość sygnału.',
    descriptionIt: 'Prospecting, sequencing, scoring e arricchimento del CRM, riprogettati con l\'AI nel loop per ridurre il lavoro manuale e migliorare la qualità del segnale.',
    tags: ['CRM', 'Outbound', 'AI'],
  },
  {
    title: 'SEO + content AI workflows',
    titlePl: 'Workflow AI dla SEO i treści',
    titleIt: 'Workflow AI per SEO e contenuti',
    description: 'From keyword research and brief generation to programmatic content scoring. Built to scale content production without scaling headcount.',
    descriptionPl: 'Od badania słów kluczowych i generowania briefów po programatyczny scoring treści. Zbudowane, by skalować produkcję treści bez skalowania zespołu.',
    descriptionIt: 'Dalla ricerca di keyword e generazione di brief fino allo scoring programmatico dei contenuti. Costruito per scalare la produzione di contenuti senza aumentare il team.',
    tags: ['SEO', 'Content', 'AI'],
  },
];

const stackItems = [
  { label: 'Reasoning', labelPl: 'Rozumowanie', labelIt: 'Ragionamento', tools: ['Claude Opus', 'GPT-4o', 'Gemini'] },
  { label: 'Coding & agents', labelPl: 'Kod i agenci', labelIt: 'Codice e agenti', tools: ['Claude Code', 'Cursor', 'Codex'] },
  { label: 'Automation', labelPl: 'Automatyzacja', labelIt: 'Automazione', tools: ['Make', 'n8n', 'Zapier'] },
  { label: 'Analytics', labelPl: 'Analityka', labelIt: 'Analisi', tools: ['Amplitude', 'Mixpanel', 'Looker'] },
  { label: 'CRM', labelPl: 'CRM', labelIt: 'CRM', tools: ['HubSpot', 'Salesforce', 'Pipedrive'] },
  { label: 'Enrichment', labelPl: 'Wzbogacanie danych', labelIt: 'Arricchimento dati', tools: ['Ahrefs', 'Brandwatch', 'SimilarWeb'] },
];
---

  <!-- Hero with terminal mockup -->
  <section class="relative pt-24 pb-20 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/wojciech-speaking.webp" position="center 35%" opacity={0.075} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">

        <!-- Left: text -->
        <div class="flex-1 max-w-xl animate-fade-up">
          <p data-en="AI Systems" data-pl="Systemy AI" data-it="Sistemi AI" class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">AI Systems</p>
          <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-5">
            <span data-en="AI in the architecture." data-pl="AI w architekturze." data-it="L'AI nell'architettura.">AI in the architecture.</span><br class="hidden md:block" />
            <span data-en="Not bolted on at the end." data-pl="Nie doklejone na końcu." data-it="Non appiccicata alla fine." class="text-[var(--color-text-muted)]">Not bolted on at the end.</span>
          </h1>
          <p data-en="Most teams add AI to tasks. I add it to systems. The difference is whether you get a faster copywriter or a different operating model: one that compounds, self-corrects, and runs without a human in every loop." data-pl="Większość zespołów dodaje AI do zadań. Ja dodaję je do systemów. Różnica polega na tym, czy dostajesz szybszego copywritera, czy inny model działania — taki, który się kumuluje, sam się koryguje i działa bez człowieka w każdej pętli." data-it="La maggior parte dei team aggiunge l'AI alle singole attività. Io la inserisco nei sistemi. La differenza è tra un copywriter più veloce e un modello operativo diverso: uno che accumula vantaggio, si autocorregge e gira senza un umano in ogni loop." class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
            Most teams add AI to tasks. I add it to systems.
            The difference is whether you get a faster copywriter or a different operating model: one that compounds, self-corrects, and runs without a human in every loop.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#principles" data-en="How I think about AI" data-pl="Jak myślę o AI" data-it="Come penso all'AI" class="btn-press inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-semibold px-6 py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-hi)] transition-colors text-sm">
              How I think about AI
            </a>
            <a href="#tools" data-en="What I've built" data-pl="Co zbudowałem" data-it="Cosa ho costruito" class="btn-press inline-flex items-center gap-2 border border-[var(--color-border-2)] text-[var(--color-text)] font-medium px-6 py-3 rounded-[var(--radius-btn)] hover:border-[var(--color-accent)]/50 transition-colors text-sm">
              What I've built
            </a>
          </div>
        </div>

        <!-- Right: terminal mockup -->
        <div class="w-full lg:w-[460px] shrink-0 animate-scale-in" style="animation-delay: 150ms">
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] overflow-hidden shadow-2xl">
            <!-- Terminal title bar -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
              <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
              <span class="ml-3 text-xs text-[var(--color-text-dim)] font-mono">gtm-agent — claude-code</span>
            </div>
            <!-- Terminal body -->
            <div class="p-5 font-mono text-xs space-y-2 leading-relaxed">
              <p><span class="text-[var(--color-accent)]">$ </span><span class="text-[var(--color-text)]">claude run gtm-agent --client acme-saas</span></p>
              <p class="text-[var(--color-text-dim)]">▸ Loading CLAUDE.md operator identity...</p>
              <p class="text-[var(--color-text-dim)]">▸ Connecting MCP tools (Ahrefs, HubSpot, LinkedIn)...</p>
              <p class="text-[var(--color-text-dim)]">▸ Reading client memory: <span class="text-[var(--color-text-muted)]">acme-saas.md</span></p>
              <p class="text-[var(--color-text-dim)]">▸ Fetching ICP signal for 247 prospects...</p>
              <p class="text-[var(--color-text-dim)]">▸ Scoring leads against ICP matrix...</p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">12 high-fit leads enriched</span></p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">Sequences drafted and staged in HubSpot</span></p>
              <p><span class="text-green-400/80">✓ </span><span class="text-[var(--color-text)]">Memory file updated with new signals</span></p>
              <p class="pt-1 border-t border-[var(--color-border)] text-[var(--color-text-dim)] mt-2">
                Cost: <span class="text-[var(--color-accent)]">$3.40</span> · Time: <span class="text-[var(--color-accent)]">4m 12s</span>
              </p>
              <p><span class="text-[var(--color-accent)]">$ </span><span class="animate-pulse text-[var(--color-text)]">_</span></p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Principles -->
  <section id="principles" class="scroll-mt-20 py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="How I think about AI"
        eyebrowPl="Jak myślę o AI"
        eyebrowIt="Come penso all'AI"
        heading="Four principles."
        headingPl="Cztery zasady."
        headingIt="Quattro principi."
        class="mb-12"
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {principles.map(({ n, title, titlePl, titleIt, body, bodyPl, bodyIt }) => (
          <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 card-lift hover:border-[var(--color-border-2)] group">
            <span class="pointer-events-none select-none absolute -right-2 -top-4 text-[7rem] font-bold leading-none text-[var(--color-border)] opacity-60 group-hover:opacity-90 transition-opacity">{n}</span>
            <p class="relative text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-5">{n}</p>
            <h3 data-en={title} data-pl={titlePl} data-it={titleIt} class="relative text-base font-semibold text-[var(--color-text)] mb-2">{title}</h3>
            <p data-en={body} data-pl={bodyPl} data-it={bodyIt} class="relative text-sm text-[var(--color-text-muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Operating loop diagram -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="The operating loop"
        eyebrowPl="Pętla operacyjna"
        eyebrowIt="Il ciclo operativo"
        heading="Where AI sits in the system."
        headingPl="Gdzie AI siedzi w systemie."
        headingIt="Dove l'AI si colloca nel sistema."
        lead="Not a task assistant bolted on at the end. AI runs the enrichment, scoring and execution; the operator owns the decision; every loop is measured and feeds the next."
        leadPl="Nie asystent doklejony na końcu. AI prowadzi wzbogacanie, scoring i egzekucję; operator trzyma decyzję; każda pętla jest mierzona i zasila następną."
        leadIt="Non un assistente appiccicato alla fine. L'AI gestisce arricchimento, scoring ed esecuzione; l'operatore tiene la decisione; ogni ciclo è misurato e alimenta il successivo."
        class="mb-10"
      />

      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-8 overflow-x-auto">
        <svg viewBox="0 0 1000 300" role="img" class="w-full min-w-[760px] h-auto"
          aria-label="GTM operating loop: signals, enrichment, ICP scoring, operator decision, execution, measurement, feeding back to signals">
          <defs>
            <marker id="ai-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3.2" orient="auto">
              <path d="M0,0 L7,3.2 L0,6.4 Z" fill="var(--color-text-dim)" />
            </marker>
          </defs>

          {[
            { x: 20,  en: 'Signals', pl: 'Sygnały', it: 'Segnali', sub: 'GA4 · intent · CRM', kind: 'data' },
            { x: 180, en: 'Enrich', pl: 'Wzbogacanie', it: 'Arricchimento', sub: 'firmo · tech · people', kind: 'ai' },
            { x: 340, en: 'Score · ICP', pl: 'Scoring · ICP', it: 'Scoring · ICP', sub: '0–100 fit', kind: 'ai' },
            { x: 500, en: 'Decide', pl: 'Decyzja', it: 'Decisione', sub: 'operator owns this', subPl: 'tu decyduje operator', subIt: 'decide l\'operatore', kind: 'human' },
            { x: 660, en: 'Act', pl: 'Działanie', it: 'Azione', sub: 'outbound · content · ads', kind: 'ai' },
            { x: 820, en: 'Measure', pl: 'Pomiar', it: 'Misura', sub: 'dashboards · D1', kind: 'data' },
          ].map((node, i) => (
            <>
              {i < 5 && (
                <line x1={node.x + 160} y1="120" x2={node.x + 160 + 20} y2="120"
                  stroke="var(--color-text-dim)" stroke-width="1.5" marker-end="url(#ai-arrow)" />
              )}
              <g>
                <rect x={node.x} y="80" width="160" height="80" rx="14"
                  fill="var(--color-surface-2)"
                  stroke={node.kind === 'human' ? 'var(--color-accent)' : 'var(--color-border-2)'}
                  stroke-width={node.kind === 'human' ? '2' : '1'} />
                {node.kind === 'ai' && (
                  <text x={node.x + 146} y="100" text-anchor="end"
                    font-family="ui-monospace, monospace" font-size="10" font-weight="700"
                    fill="var(--color-accent)">AI</text>
                )}
                {node.kind === 'human' && (
                  <text x={node.x + 150} y="100" text-anchor="end"
                    font-size="10" font-weight="700" fill="var(--color-accent)"
                    data-en="HUMAN" data-pl="CZŁOWIEK" data-it="UMANO">HUMAN</text>
                )}
                <text x={node.x + 14} y="128" font-family="var(--font-sans, system-ui)" font-size="16"
                  font-weight="700" fill="var(--color-text)"
                  data-en={node.en} data-pl={node.pl} data-it={node.it}>{node.en}</text>
                <text x={node.x + 14} y="146" font-size="10.5" fill="var(--color-text-dim)"
                  data-en={node.sub} data-pl={node.subPl ?? node.sub} data-it={node.subIt ?? node.sub}>{node.sub}</text>
              </g>
            </>
          ))}

          <!-- feedback loop: Measure -> Signals -->
          <path d="M 900 160 L 900 250 L 100 250 L 100 160"
            fill="none" stroke="var(--color-accent)" stroke-width="1.5"
            stroke-dasharray="5 5" marker-end="url(#ai-arrow)" opacity="0.7" />
          <text x="500" y="244" text-anchor="middle" font-size="11.5" font-weight="600"
            fill="var(--color-accent)"
            data-en="Compounding loop — every cycle is measured and feeds the next"
            data-pl="Pętla kumulacji — każdy cykl jest mierzony i zasila następny"
            data-it="Ciclo cumulativo — ogni giro è misurato e alimenta il successivo">Compounding loop — every cycle is measured and feeds the next</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Tech stack"
        eyebrowPl="Stack technologiczny"
        eyebrowIt="Stack tecnologico"
        heading="Tools I actually use."
        headingPl="Narzędzia, których naprawdę używam."
        headingIt="Strumenti che uso davvero."
        class="mb-10"
      />
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {stackItems.map(({ label, labelPl, labelIt, tools: t }) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <p data-en={label} data-pl={labelPl} data-it={labelIt} class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">{label}</p>
            <div class="flex flex-wrap gap-2">
              {t.map((tool) => (
                <span class="text-xs px-2.5 py-0.5 rounded-[var(--radius-badge)] border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface-2)]">{tool}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools built -->
  <section id="tools" class="scroll-mt-20 py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="What I've built"
        eyebrowPl="Co zbudowałem"
        eyebrowIt="Cosa ho costruito"
        heading="AI workflows and tools in production."
        headingPl="Workflow i narzędzia AI w produkcji."
        headingIt="Workflow e strumenti AI in produzione."
        class="mb-12"
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map(({ title, titlePl, titleIt, description, descriptionPl, descriptionIt, tags, href }) => (
          <ProofCard
            title={title}
            titlePl={titlePl}
            titleIt={titleIt}
            description={description}
            descriptionPl={descriptionPl}
            descriptionIt={descriptionIt}
            tags={tags}
            href={href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Live demo -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        eyebrow="Live demo"
        eyebrowPl="Demo na żywo"
        eyebrowIt="Demo live"
        heading="A shipped AI tool, running here."
        headingPl="Wdrożone narzędzie AI — działa tutaj."
        headingIt="Uno strumento AI reale, in funzione qui."
        lead="AdsAI — an AI-native Google Ads cockpit: spend, ROAS, ICP fit and next-best actions in one workspace. Load it inline, or open it in a new tab."
        leadPl="AdsAI — kokpit Google Ads w wersji AI-native: wydatki, ROAS, dopasowanie ICP i kolejne ruchy w jednym miejscu. Załaduj go w stronie albo otwórz w nowej karcie."
        leadIt="AdsAI — un cockpit Google Ads AI-native: spesa, ROAS, fit ICP e prossime azioni in un unico spazio. Caricalo qui o aprilo in una nuova scheda."
        class="mb-10"
      />
      <LiveEmbed
        src="https://ads-assistant-three.vercel.app/"
        screenshot="/images/work/ads-assistant.png"
        alt="AdsAI — AI-native Google Ads cockpit"
      />
    </div>
  </section>

  <!-- Working together -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <SectionHeader
          eyebrow="Work with me"
          eyebrowPl="Współpraca"
          eyebrowIt="Lavora con me"
          heading="If you want AI in your GTM stack, done right."
          headingPl="Jeśli chcesz AI w swoim stacku GTM, zrobione dobrze."
