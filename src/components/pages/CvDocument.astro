---
// CV document. Content is sourced from src/data/cv.ts so localized CV pages
// stay in lock-step. Update the data file, not the markup, when editing copy.
// Print to PDF: Cmd+P → Save as PDF, margins: None, background graphics: ON
import '../../styles/global.css';
import '../../styles/tokens.css';
import { cvData, cvLanguageNames, cvPathForLang, cvSeoLang, type CvLang } from '../../data/cv';

interface Props {
  lang: CvLang;
}

const { lang } = Astro.props;
const t = cvData;
const localizePeriod = (period: string) => period.replace('present', t.presentLabel[lang]);
const canonicalPath = cvPathForLang(lang);
const canonicalUrl = `https://wojciech.io${canonicalPath}`;
const alternates = cvSeoLang.map((alternateLang) => ({
  lang: alternateLang === 'pl' ? 'pl' : alternateLang === 'en' ? 'en' : cvLanguageNames[alternateLang].hreflang,
  href: `https://wojciech.io${cvPathForLang(alternateLang)}`,
}));
---

<!doctype html>
<html lang={cvLanguageNames[lang].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{t.meta.title[lang]}</title>
  <meta name="description" content={t.meta.description[lang]} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href="https://wojciech.io/cv/" />
  {alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
  ))}
  <meta property="og:title" content={t.meta.title[lang]} />
  <meta property="og:description" content={t.meta.description[lang]} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="profile" />
  <meta property="og:image" content="https://wojciech.io/og-default.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={t.meta.title[lang]} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={t.meta.title[lang]} />
  <meta name="twitter:description" content={t.meta.description[lang]} />
  <meta name="twitter:image" content="https://wojciech.io/og-default.png" />
  <meta name="twitter:image:alt" content={t.meta.title[lang]} />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0c" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f5ee" />
  <!-- Favicon: same set as main site -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=6" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=6" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=6" />
  <!-- Self-hosted Geist (no CDN, CSP blocks external fonts) -->
  <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Geist-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Geist-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    /* ── tokens (inline for print isolation) ──────────────── */
    :root {
      --color-bg:        #0c0c0c;
      --color-surface:   #171717;
      --color-surface-2: #1e1e1e;
      --color-border:    #2a2a2a;
      --color-border-2:  #383838;
      --color-text:      #f0f0f0;
      --color-text-muted:#a0a0a0;
      --color-text-dim:  #5a5a5a;
      --color-accent:    #EBFF00;
      --color-accent-hi: #f5ff4d;
      --color-accent-lo: #2a2a2a;
      --font-sans:       'Geist', system-ui, sans-serif;
      --font-mono:       'Geist Mono', monospace;
      --radius-card:     12px;
    }

    /* ── base ──────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    /* ── layout ────────────────────────────────────────────── */
    .page {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 40px 64px;
    }

    /* ── header ────────────────────────────────────────────── */
    .cv-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 28px;
      align-items: center;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 36px;
    }
    @media (max-width: 720px) {
      .cv-header { grid-template-columns: 1fr; gap: 18px; }
      .cv-avatar { width: 88px; height: 88px; }
    }
    .cv-avatar {
      width: 112px; height: 112px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      background: var(--color-surface-2);
    }

    .cv-wordmark {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin-bottom: 6px;
    }
    .cv-wordmark span { color: var(--color-accent); }

    .cv-name {
      font-size: 36px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--color-text);
      margin-bottom: 10px;
    }

    .cv-tagline {
      font-size: 13px;
      color: var(--color-text-muted);
      font-weight: 400;
      letter-spacing: 0.03em;
    }

    .cv-contact {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-end;
      padding-top: 4px;
    }

    .cv-contact a, .cv-contact span {
      font-size: 12px;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      transition: color 0.15s;
    }
    .cv-contact a:hover { color: var(--color-accent-hi); }

    /* ── two-column body ───────────────────────────────────── */
    .cv-body {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 0 40px;
    }

    /* ── section label ─────────────────────────────────────── */
    .section-label {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
    }

    /* ── experience ────────────────────────────────────────── */
    .exp-section { margin-bottom: 32px; }

    .exp-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 0 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--color-border);
    }
    .exp-item:last-child { border-bottom: none; }

    .exp-period {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-text-dim);
      padding-top: 2px;
      line-height: 1.4;
      white-space: pre-line;
    }
    .exp-period.contract { font-style: italic; color: var(--color-text-dim); }

    .exp-role {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 1px;
    }

    .exp-company {
      font-size: 11px;
      font-weight: 500;
      color: var(--color-accent);
      margin-bottom: 6px;
    }
    .exp-company.contract { color: var(--color-text-muted); }

    .exp-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .exp-bullets li {
      font-size: 12px;
      color: var(--color-text-muted);
      padding-left: 12px;
      position: relative;
      line-height: 1.5;
    }
    .exp-bullets li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-size: 10px;
      top: 1px;
    }

    /* ── sidebar ───────────────────────────────────────────── */
    .sidebar { }

    .sidebar-block { margin-bottom: 28px; }

    /* ── skills chips ──────────────────────────────────────── */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .chip {
      font-size: 10px;
      font-weight: 500;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid var(--color-border-2);
      background: var(--color-surface);
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
    }
    .chip.accent {
      border-color: var(--color-accent-lo);
      background: var(--color-accent-lo);
      color: var(--color-accent-hi);
    }

    /* ── education ─────────────────────────────────────────── */
    .edu-item { margin-bottom: 12px; }
    .edu-degree {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 1px;
    }
    .edu-school {
      font-size: 11px;
      color: var(--color-text-muted);
      margin-bottom: 1px;
    }
    .edu-year {
      font-size: 10px;
      font-family: var(--font-mono);
      color: var(--color-text-dim);
    }

    /* ── lang ──────────────────────────────────────────────── */
    .lang-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 12px;
    }
    .lang-item:last-child { border-bottom: none; }
    .lang-name { color: var(--color-text); font-weight: 500; }
    .lang-level { color: var(--color-text-dim); font-size: 11px; font-family: var(--font-mono); }

    /* ── certifications ────────────────────────────────────── */
    .cert-item {
      font-size: 11px;
      color: var(--color-text-muted);
      padding: 4px 0;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .cert-item:last-child { border-bottom: none; }
    .cert-issuer {
      font-size: 10px;
      color: var(--color-text-dim);
      font-family: var(--font-mono);
    }

    /* ── print ─────────────────────────────────────────────── */
    @media print {
      html, body { background: #0c0c0c !important; color: #f0f0f0 !important; }
      .page { padding: 24px 28px 40px; max-width: 100%; }
      .cv-name { font-size: 28px; }
      .exp-item { break-inside: avoid; }
      .sidebar-block { break-inside: avoid; }
    }

    /* ── screen-only print button ──────────────────────────── */
    .print-bar {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 100;
      display: flex;
      gap: 10px;
    }
    .print-btn {
      background: var(--color-accent);
      color: #0c0c0c;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      letter-spacing: -0.01em;
    }
    .print-btn:hover { background: var(--color-accent-hi); }
    @media print { .print-bar { display: none; } }
  </style>
</head>
<body>

<div class="page">

  <!-- ── Header ───────────────────────────────────────────── -->
  <header class="cv-header">
    <img class="cv-avatar" src="/images/wojciech-avatar-384.webp" srcset="/images/wojciech-avatar-384.webp 384w, /images/wojciech-avatar-768.webp 768w" sizes="112px" alt="Wojciech Łuszczyński" width="112" height="112" loading="eager" />
    <div>
      <p class="cv-wordmark">wojciech<span>.io</span> · <a href="https://app.wojciech.io" target="_blank" style="font-weight:400;opacity:0.55;font-size:0.72em;">{t.header.interactiveVersion[lang]}</a></p>
      <h1 class="cv-name">Wojciech<br />Łuszczyński</h1>
      <p class="cv-tagline">{t.header.tagline[lang]}</p>
    </div>
    <div class="cv-contact">
      <a href="mailto:hello@wojciech.io">hello@wojciech.io</a>
      <a href="https://wojciech.io/contact/" target="_blank">wojciech.io/contact</a>
      <a href="https://wojciech.io" target="_blank">wojciech.io</a>
      <a href="https://www.linkedin.com/in/wojciech-luszczynski/" target="_blank">linkedin.com/in/wojciech-luszczynski</a>
      <span>{t.header.openToRelocation[lang]}</span>
    </div>
  </header>

  <!-- ── Body ─────────────────────────────────────────────── -->
  <div class="cv-body">

    <!-- ── Left: Experience ────────────────────────────────── -->
    <main>
      <div class="exp-section">
        <p class="section-label">{t.sections.experience[lang]}</p>

        {t.experience.map((exp) => (
          <div class="exp-item">
            <span class={`exp-period${exp.contract ? ' contract' : ''}`}>
              {exp.contract ? t.contractLabel[lang] : localizePeriod(exp.period)}
            </span>
            <div>
              <p class="exp-role">{exp.role[lang]}</p>
              <p class={`exp-company${exp.contract ? ' contract' : ''}`}>{exp.company}</p>
              <ul class="exp-bullets">
                {exp.bullets[lang].map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- ── Right: Sidebar ──────────────────────────────────── -->
    <aside class="sidebar">

      <div class="sidebar-block">
        <p class="section-label">{t.sections.keySkills[lang]}</p>
        <div class="chips">
          {t.skills[lang].map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>

      <div class="sidebar-block">
        <p class="section-label">{t.sections.tools[lang]}</p>
        <div class="chips">
          {t.tools.map((toolName) => <span class="chip">{toolName}</span>)}
        </div>
      </div>

      <div class="sidebar-block">
        <p class="section-label">{t.sections.education[lang]}</p>
        {t.education.map((e) => (
          <div class="edu-item">
            <p class="edu-degree">{e.degree[lang]}</p>
            <p class="edu-school">{e.school}</p>
            <p class="edu-year">{e.year}</p>
          </div>
        ))}
      </div>

      <div class="sidebar-block">
        <p class="section-label">{t.sections.languages[lang]}</p>
        {t.languages.map((l) => (
          <div class="lang-item">
            <span class="lang-name">{l.name[lang]}</span>
            <span class="lang-level">{l.level[lang]}</span>
          </div>
        ))}
      </div>

      <div class="sidebar-block">
        <p class="section-label">{t.sections.certifications[lang]}</p>
        {t.certifications.map((c) => (
          <div class="cert-item">
            <span>{c.name}</span>
            <span class="cert-issuer">{c.issuer}</span>
          </div>
        ))}
      </div>

    </aside>
  </div>
</div>

<!-- Print button (screen only) -->
<div class="print-bar">
  <button class="print-btn" onclick="window.print()">{t.printButton[lang]}</button>
</div>

</body>
</html>
