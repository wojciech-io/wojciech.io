---
import SectionHeader from '../ui/SectionHeader.astro';
import PageBackdrop from '../ui/PageBackdrop.astro';
import { SITE } from '../../data/site';
---


  <!-- Hero -->
  <section class="relative pt-12 pb-8 md:pt-24 md:pb-16 border-b border-[var(--color-border)] overflow-hidden">
    <PageBackdrop src="/images/office-bg.jpg" position="center 44%" opacity={0.08} eager />

    <div class="relative mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-4">Apps</p>
      <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4 max-w-2xl">
        Shipped, not scoped.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-xl leading-relaxed">
        Tools I built because the right one didn't exist. Native apps, web utilities, and a newsletter for operators who build revenue systems.
      </p>
    </div>
  </section>

  <!-- App cards -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        <!-- Academy -->
        <a
          href="/apps/academy/"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_50%_60%,rgba(235,255,0,0.07)_0%,transparent_70%)]"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="14" y="14" width="92" height="52" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="22" y="22" width="76" height="3" rx="1.5" fill="currentColor" opacity="0.25"/>
              <rect x="22" y="31" width="58" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
              <rect x="22" y="40" width="68" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
              <circle cx="60" cy="56" r="6" fill="#EBFF00" opacity="0.9"/>
              <path d="M57 53l6 3-6 3z" fill="#0a0a0a"/>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Program · AI dla GTM</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Academy</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">AI od praktyka, nie od slajdów.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">36 odcinków o AI w marketingu, sprzedaży i pracy founderów B2B. Procesy, nie nazwy narzędzi.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              wojciech.io/apps/academy
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- GrowthHub -->
        <a
          href="/apps/growthhub/"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_50%_60%,rgba(235,255,0,0.07)_0%,transparent_70%)]"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="14" width="96" height="52" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <path d="M20 54 L36 44 L52 50 L72 30 L92 38 L100 26" stroke="#EBFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" fill="none"/>
              <circle cx="36" cy="44" r="2" fill="#EBFF00"/>
              <circle cx="72" cy="30" r="2" fill="#EBFF00"/>
              <circle cx="100" cy="26" r="2" fill="#EBFF00"/>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Dashboard · B2B SaaS</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">GrowthHub</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Growth dashboard dla operatorów.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Akwizycja, pipeline, paid, ICP w jednym widoku. Public demo bez logowania. Real-data po GA4/Pipedrive sync.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              wojciech.io/apps/growthhub
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Notch -->
        <a
          href={SITE.notchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <!-- Thumbnail -->
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_50%_60%,rgba(235,255,0,0.07)_0%,transparent_70%)]"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="8" y="8" width="104" height="64" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="42" y="8" width="36" height="14" rx="0 0 5 5" fill="var(--color-surface-2)" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="60" cy="16" r="3" fill="#EBFF00" opacity="0.9"/>
              <rect x="20" y="32" width="80" height="3" rx="1.5" fill="currentColor" opacity="0.25"/>
              <rect x="20" y="41" width="56" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
              <rect x="20" y="50" width="68" height="3" rx="1.5" fill="currentColor" opacity="0.18"/>
            </svg>
          </div>
          <!-- Body -->
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">macOS · Swift · Native</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Notch</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Teleprompter for the notch.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Native macOS app that keeps your notes close to the camera during calls, demos, and recordings. Prompts sit in the notch area so you stay on-script without breaking eye contact.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              notch.wojciech.io
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- Subscribe -->
        <a
          href="/subscribe/"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_50%_60%,rgba(235,255,0,0.07)_0%,transparent_70%)]"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="18" width="96" height="60" rx="5" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <path d="M12 26l48 28 48-28" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <circle cx="88" cy="22" r="8" fill="#EBFF00" opacity="0.9"/>
              <text x="88" y="26" text-anchor="middle" font-size="9" font-weight="700" fill="#0a0a0a">3</text>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Newsletter · GTM · AI</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-success)]/10 text-[var(--color-success)] border border-[var(--color-success)]/25">Live</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">Subscribe</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Newsletter built for operators.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">GTM, AI, and growth systems from the operator stack. Practical content, no filler. For people who build and run revenue systems.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              wojciech.io/subscribe
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

        <!-- App portfolio -->
        <a
          href={`${SITE.appUrl}/apps`}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden card-lift hover:border-[var(--color-accent)]/40 flex flex-col"
        >
          <div class="w-full aspect-[4/3] rounded-t-[var(--radius-card)] flex items-center justify-center shrink-0 relative overflow-hidden bg-[var(--color-surface-2)]">
            <div class="absolute inset-0 pointer-events-none [background:radial-gradient(ellipse_at_50%_60%,rgba(235,255,0,0.07)_0%,transparent_70%)]"></div>
            <svg viewBox="0 0 120 80" fill="none" class="w-40 text-[var(--color-text-muted)]">
              <rect x="12" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="8" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="12" y="44" width="44" height="30" rx="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="64" y="44" width="44" height="30" rx="4" fill="#EBFF00" fill-opacity="0.12" stroke="#EBFF00" stroke-width="1.5" opacity="0.8"/>
              <path d="M78 59l5 5 9-9" stroke="#EBFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
            </svg>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-medium text-[var(--color-accent)] tracking-widest uppercase">Web · Mobile · Utilities</p>
              <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] text-[var(--color-text-muted)] border border-[var(--color-border)]">Growing</span>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">App portfolio</h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Every tool I've shipped.</p>
            <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-5 flex-1">Działka+, Paczka+, Resume+, and more. Small focused apps built to solve a specific problem. The full catalogue lives at app.wojciech.io.</p>
            <span class="text-xs font-medium text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors duration-150 flex items-center gap-1">
              app.wojciech.io/apps
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-150" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- What I build and why -->
  <section class="py-[var(--space-section)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <SectionHeader
          eyebrow="The operator approach"
          heading="If the tool doesn't exist, I ship it."
          lead="Every app here started as a gap in my own workflow. I build what's missing, instrument it, and make it available. Operator-grade, not demo-grade."
        />
        <div class="space-y-5 pt-2">
          {[
            { en: 'Built with production constraints, not showcase polish', pl: 'Zbudowane z ograniczeniami produkcyjnymi, nie połyskiem showcase', it: 'Costruite con vincoli di produzione, non con lucidatura da showcase' },
            { en: 'Native where native matters: Swift for macOS, not Electron', pl: 'Natywne gdy natywność ma znaczenie: Swift dla macOS, nie Electron', it: 'Native dove il nativo conta: Swift per macOS, non Electron' },
            { en: 'Designed to solve exactly one problem well', pl: 'Zaprojektowane, by dobrze rozwiązać dokładnie jeden problem', it: 'Progettate per risolvere bene un solo problema' },
            { en: 'Shipped when good, iterated after. Not after a 6-month roadmap.', pl: 'Wdrożone gdy dobre, iterowane później. Nie po 6-miesięcznym roadmapie.', it: 'Lanciate quando sono pronte, iterate dopo. Non dopo una roadmap di sei mesi.' },
          ].map((item) => (
            <div class="flex items-start gap-3 group">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              <p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text)] transition-colors duration-150">{item.en}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 relative overflow-hidden bg-[var(--color-surface)]">
    <div class="pointer-events-none absolute inset-0 [background:radial-gradient(ellipse_at_20%_50%,rgba(235,255,0,0.04)_0%,transparent_60%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/40 to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Next step</p>
        <h2 class="text-2xl font-semibold leading-[1.12] tracking-tight text-[var(--color-text)] md:text-3xl">
          Need the full app workspace?
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)]">
          The canonical catalogue, CV, stack, and contact flows live in the app workspace. This page is the public bridge from wojciech.io.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={SITE.appUrl} target="_blank" rel="noopener noreferrer" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:opacity-90">
          Open app workspace
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/contact/#book-call" class="btn-press inline-flex items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text)]">
          Book a call
        </a>
      </div>
    </div>
  </section>
