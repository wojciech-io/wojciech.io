---
import PageBackdrop from '../ui/PageBackdrop.astro';
import { SITE } from '../../data/site';

const contactLinks = [
  {
    label: 'Book a 30-min call',
    meta: 'Google Meet · Europe/Berlin',
    href: SITE.cal,
    external: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>`,
    primary: true,
  },
  {
    label: 'LinkedIn',
    meta: `linkedin.com/in/${SITE.linkedinHandle}`,
    href: SITE.linkedin,
    external: true,
    icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    iconFill: true,
  },
];
---

<section class="relative pt-16 pb-16 border-b border-[var(--color-border)] overflow-hidden">
  <PageBackdrop src="/images/wojciech-infoshare.webp" position="center 42%" opacity={0.075} eager />

  <div class="relative mx-auto max-w-4xl px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Left: context -->
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Contact</p>
        <h1 class="text-4xl font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4">
          Build, fix, or review the system.
        </h1>
        <p class="text-base text-[var(--color-text-muted)] leading-relaxed mb-8">
          Use this for apps, GTM, automation, audits, or a fast review. Share the goal, current state, and useful links. I respond within 24h.
        </p>

        <div class="space-y-3">
          {contactLinks.map(({ label, meta, href, external, icon, iconFill, primary }) => (
            <a
              href={href}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class:list={[
                'flex items-center gap-3 rounded-[var(--radius-card)] border px-4 py-3.5 transition-colors group',
                primary
                  ? 'border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 hover:border-[var(--color-accent)]/60 hover:bg-[var(--color-accent)]/10'
                  : 'border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)]/40',
              ]}
            >
              <div class:list={[
                'w-9 h-9 rounded-lg flex items-center justify-center shrink-0',
                primary
                  ? 'bg-[var(--color-accent)]/15 border border-[var(--color-accent)]/30'
                  : 'bg-[var(--color-surface-2)] border border-[var(--color-border)]',
              ]}>
                <svg
                  class="w-5 h-5 text-[var(--color-accent)]"
                  viewBox="0 0 24 24"
                  fill={iconFill ? 'currentColor' : 'none'}
                  stroke={iconFill ? 'none' : 'currentColor'}
                  stroke-width={iconFill ? undefined : '1.5'}
                  aria-hidden="true"
                  set:html={icon}
                />
              </div>
              <div class="flex-1 min-w-0">
                <p class:list={[
                  'text-sm font-semibold transition-colors',
                  primary ? 'text-[var(--color-accent-hi)]' : 'text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)]',
                ]}>{label}</p>
                <p class="text-xs text-[var(--color-text-dim)] truncate">{meta}</p>
              </div>
              <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] group-hover:translate-x-0.5 transition-all duration-150 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: what to expect -->
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
        <div class="px-6 py-5">
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">What to expect</p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            The call is 30 minutes. No pitch deck, no intro slides. We start from your current system or problem and work out where the bottleneck is. You leave with a concrete next step.
          </p>
        </div>
        <div class="px-6 py-5">
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-dim)] mb-3">Good fit for</p>
          <ul class="space-y-2">
            {[
              'GTM system audit or rebuild',
              'AI workflow design and integration',
              'CRM or RevOps architecture review',
              'Product or app MVP scoping',
              'Quick code or architecture review',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[var(--color-text-muted)]">
                <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-0.5" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="px-6 py-5">
          <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-text-dim)] mb-2">Response time</p>
          <p class="text-sm text-[var(--color-text-muted)]">Within 24h on weekdays. Timezone: Europe/Berlin.</p>
        </div>
      </div>

    </div>
  </div>
</section>
