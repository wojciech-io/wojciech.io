---
import PageBackdrop from '../ui/PageBackdrop.astro';
import { SITE } from '../../data/site';

const calUrl = 'https://cal.com/wojciech-luszczynski/30min';
---

<!-- Hero: booking is the primary CTA -->
<section id="book-call" class="relative pt-10 pb-10 md:pt-14 md:pb-12 overflow-hidden">
  <PageBackdrop src="/images/wojciech-infoshare.webp" position="center 42%" opacity={0.075} eager />

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <p class="obs-label-accent mb-4 block">// Contact</p>
    <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-contact">
      Build, fix, or review the system.
    </h1>
    <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto mb-8">
      Pick a slot for a 30-minute call. No pitch deck, no intro slides. We start from your system or problem.
    </p>
  </div>

  <!-- Embedded scheduler: the calendar IS the CTA on this page. -->
  <div class="relative mx-auto max-w-5xl px-6">
    <div
      data-cal-inline="wojciech-luszczynski/30min"
      class="min-h-[620px] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden"
    ></div>
    <p class="mt-4 text-center text-sm text-[var(--color-text-muted)]">
      Calendar not loading?
      <a
        href={calUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
        data-mp-cta="Book 30 minutes"
        data-mp-location="contact_hero_fallback"
      >Open the booking page →</a>
    </p>
  </div>
</section>

<!-- Contact form -->
<section class="relative py-12 md:py-16 border-t border-b border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-2xl px-6">
    <p class="obs-label-accent mb-3 block">// Or send a message</p>
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
      Send the context, the bottleneck, and the current stack. I reply within 24h on weekdays.
    </p>
    <form id="contact-form" class="space-y-5">
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="contact-name" class="block text-xs font-semibold tracking-widest uppercase text-[var(--color-text-dim)] mb-2">Name</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            autocomplete="name"
            class="w-full rounded-[var(--radius-input)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-dim)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="contact-email" class="block text-xs font-semibold tracking-widest uppercase text-[var(--color-text-dim)] mb-2">Email</label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            autocomplete="email"
            class="w-full rounded-[var(--radius-input)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-dim)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
            placeholder="you@company.com"
          />
        </div>
      </div>
      <div>
        <label for="contact-context" class="block text-xs font-semibold tracking-widest uppercase text-[var(--color-text-dim)] mb-2">What are you working on?</label>
        <textarea
          id="contact-context"
          name="message"
          required
          rows={5}
          class="w-full rounded-[var(--radius-input)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-dim)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-1 focus:ring-[var(--color-accent)] transition-colors resize-y"
          placeholder="The goal, the current state, the stack. Whatever helps me understand the problem."
        ></textarea>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <button
          type="submit"
          class="btn-press inline-flex items-center justify-center gap-2 bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold px-7 py-3.5 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        >
          Send message
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <span id="form-status" class="text-sm text-[var(--color-text-muted)] hidden"></span>
      </div>
    </form>
  </div>
</section>

<!-- Context: what to expect, good fit, alternative -->
<section class="py-12 md:py-16 border-b border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid md:grid-cols-3 gap-8 md:gap-10">
      <div>
        <p class="obs-label-accent mb-3 block">// What to expect</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          I reply within 24h on weekdays. If the problem is a fit, we set up a 30-minute call. No pitch deck, no intro slides. We start from your system or problem.
        </p>
      </div>
      <div>
        <p class="obs-label-accent mb-3 block">// Good fit for</p>
        <ul class="space-y-2">
          {[
            'GTM system audit or rebuild',
            'AI workflow design and integration',
            'CRM or RevOps architecture review',
            'Product or app MVP scoping',
            'Quick code or architecture review',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-[var(--color-text-muted)]">
              <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="obs-label-accent mb-3 block">// Alternative</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
          Prefer a direct message? Connect on LinkedIn. Timezone: Europe/Berlin.
        </p>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Reach out on LinkedIn
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-3 inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
          {SITE.email}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') as string;
    const email = data.get('email') as string;
    const message = data.get('message') as string;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, message }),
      });

      if (res.ok) {
        status.textContent = 'Message sent. I will reply within 24h.';
        status.classList.remove('hidden', 'text-red-500');
        status.classList.add('text-[var(--color-success)]');
        form.reset();
      } else {
        throw new Error('send failed');
      }
    } catch {
      const subject = encodeURIComponent(`Contact from ${name}`);
      const body = encodeURIComponent(`${message}\n\n---\nFrom: ${name} (${email})`);
      window.location.href = `mailto:hello@wojciech.io?subject=${subject}&body=${body}`;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
