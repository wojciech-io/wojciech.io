---
import PageBackdrop from '../ui/PageBackdrop.astro';
import { SITE } from '../../data/site';

const contactLinks = [
  {
    label: 'Book a 30-min call',
    meta: 'Google Meet · Europe/Berlin',
    href: SITE.cal,
    external: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>`,
    primary: true,
  },
  {
    label: 'LinkedIn',
    meta: `linkedin.com/in/${SITE.linkedinHandle}`,
    href: SITE.linkedin,
    external: true,
    icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    iconFill: true,
  },
];
---

<section id="book-call" class="relative pt-10 pb-8 md:pt-14 md:pb-10 overflow-hidden">
  <PageBackdrop src="/images/wojciech-infoshare.webp" position="center 42%" opacity={0.075} eager />

  <div class="relative mx-auto max-w-5xl px-6 text-center">
    <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Contact</p>
    <h1 class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4" transition:name="page-title-contact">
      Build, fix, or review the system.
    </h1>
    <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto">
      30-minute call. Share the goal, current state, and useful links. Pick a slot below or reach me on
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--color-text)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-2 hover:text-[var(--color-accent-hi)]">LinkedIn</a>.
    </p>
  </div>
</section>

<!-- Cal.com inline calendar — primary booking surface -->
<section class="relative pb-12 md:pb-16 border-b border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-5xl px-6">
    <div
      id="cal-inline"
      class="rounded-[var(--radius-card)] overflow-hidden border border-[var(--color-border)]"
      style="min-height:760px;"
    ></div>
  </div>
</section>

<!-- Context: what to expect, good fit for, response time -->
<section class="py-12 md:py-16 border-b border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid md:grid-cols-3 gap-8 md:gap-10">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">What to expect</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          30 minutes. No pitch deck, no intro slides. We start from your current system or problem and find where the bottleneck is. You leave with a concrete next step.
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Good fit for</p>
        <ul class="space-y-2">
          {[
            'GTM system audit or rebuild',
            'AI workflow design and integration',
            'CRM or RevOps architecture review',
            'Product or app MVP scoping',
            'Quick code or architecture review',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-[var(--color-text-muted)]">
              <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-accent)] mb-3">Response time</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
          Within 24h on weekdays. Timezone: Europe/Berlin.
        </p>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Reach out on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function(C,A,L){
    let p=function(a,ar){a.q.push(ar);};
    let d=C.document;
    C.Cal=C.Cal||function(){
      let cal=C.Cal;let ar=arguments;
      if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true;}
      if(ar[0]===L){const api=function(){p(api,arguments);};const namespace=ar[1];api.q=api.q||[];
        if(typeof namespace==="string"){cal.ns[namespace]=cal.ns[namespace]||api;p(cal.ns[namespace],ar);p(cal,["-",namespace,cal.ns[namespace]]);}
        else p(cal,ar);return;}
      p(cal,ar);
    };
  })(window,"https://app.cal.com/embed/embed.js","init");

  const getSiteTheme = () =>
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

  const calUiConfig = (theme) => ({
    theme,
    styles: { branding: { brandColor: '#EBFF00' } },
    cssVarsPerTheme: {
      light: {
        'cal-brand': '#EBFF00',
        'cal-brand-emphasis': '#D4E600',
        'cal-brand-text': '#0C0C0C',
        'cal-bg': '#f8f5ee',
        'cal-bg-emphasis': '#f1eee7',
        'cal-bg-muted': '#ebe8df',
        'cal-border': '#DFDBD1',
        'cal-border-emphasis': '#CEC8BB',
        'cal-text': '#171717',
        'cal-text-emphasis': '#0C0C0C',
        'cal-text-muted': '#66645F',
      },
      dark: {
        'cal-brand': '#EBFF00',
        'cal-brand-emphasis': '#F5FF66',
        'cal-brand-text': '#0C0C0C',
        'cal-bg': '#171717',
        'cal-bg-emphasis': '#222222',
        'cal-bg-muted': '#0C0C0C',
        'cal-border': '#2A2A2A',
        'cal-border-emphasis': '#3A3A3A',
        'cal-text': '#F2F2F2',
        'cal-text-emphasis': '#FFFFFF',
        'cal-text-muted': '#888888',
      },
    },
    hideEventTypeDetails: false,
    layout: 'month_view',
  });

  Cal('init', { origin: 'https://cal.com' });
  Cal('inline', {
    elementOrSelector: '#cal-inline',
    calLink: 'wojciech-luszczynski/30min',
    config: { layout: 'month_view', theme: getSiteTheme() },
  });
  Cal('ui', calUiConfig(getSiteTheme()));

  const themeObserver = new MutationObserver(() => {
    Cal('ui', calUiConfig(getSiteTheme()));
  });
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
