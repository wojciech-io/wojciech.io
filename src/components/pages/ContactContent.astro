---
import { SITE } from '../../data/site';
import CalInline from '../ui/CalInline.astro';

/* Booking page.
 *
 * The page has one job: get the right person onto the calendar. So the order is
 * promise, then action, then the qualifying detail. Earlier revisions put a
 * second column of copy beside the headline, which pushed the calendar into
 * third place and left the list reading as filler dropped into empty space.
 *
 * The calendar is a dense three-panel widget roughly 1100px wide. Nothing sits
 * beside it: anything that did would either squeeze it into its narrow layout
 * or compete with it. Supporting copy goes underneath, after the ask.
 */

const goodFit = [
  'GTM system audit or rebuild',
  'AI workflow design and integration',
  'CRM or RevOps architecture review',
  'Product or app MVP scoping',
  'Quick code or architecture review',
];
---

<section id="book-call" class="relative pt-10 pb-6 md:pt-14 md:pb-8">
  <!-- Promise: short enough that the calendar stays in view under it. Duration
       and meeting type are left to Cal's own panel rather than repeated here. -->
  <div class="relative mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        <span class="obs-label-accent">Contact</span>
      </div>
      <h1
        class="text-[length:var(--text-h1)] font-semibold text-[var(--color-text)] leading-tight tracking-tight mb-4"
        transition:name="page-title-contact"
      >
        Build, fix, or review the system.
      </h1>
      <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Pick a slot below. No pitch deck, no intro slides. We start from your system or the problem.
      </p>
    </div>
  </div>
</section>

<!-- The action itself. -->
<CalInline loadingLabel="Loading the calendar…" />

<!-- Qualifying detail, after the ask rather than in front of it. -->
<section class="pt-12 pb-14 md:pt-16 md:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 md:grid-cols-3 md:gap-12 pt-10 border-t border-[var(--color-border)]">
      <div>
        <p class="obs-label-accent mb-4 block">Good fit for</p>
        <ul class="space-y-2.5">
          {goodFit.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-[var(--color-text-muted)] leading-relaxed">
              <svg class="w-3.5 h-3.5 text-[var(--color-accent)] shrink-0 mt-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="obs-label-accent mb-4 block">What to expect</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Thirty minutes, straight into the problem. Bring the current state, the bottleneck and
          what already exists. You leave with where I would start, whether or not we work together.
        </p>
      </div>

      <div>
        <p class="obs-label-accent mb-4 block">Prefer to write first</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
          I reply within 24h on weekdays. I work from Madrid; the calendar shows your local time.
        </p>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Message me on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
