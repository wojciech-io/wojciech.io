---
/* Selected-work band for the lens pages (/gtm, /growth). Pulls real case studies
   from the work collection by id and renders them with the shared ProjectCard, so
   each lens shows concrete examples with working links instead of ending on copy.
   Injected into LensShowcase's <slot />. */
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';
import { accentHeading } from '../../lib/editorial';

type CoverType = 'ads-ai' | 'gtm-pack' | 'notch' | 'kamperownia' | 'ai-adoption' | 'growth-system' | 'mini-apps' | 'relora';

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  /** Work entry ids, in display order. */
  ids: string[];
  /** External link label on the cards (e.g. "View live"). */
  viewLabel?: string;
}

const { eyebrow, heading, lead, ids, viewLabel = 'View project' } = Astro.props as Props;

const coverMap: Record<string, CoverType> = {
  relora: 'relora',
  'ad-assistant': 'ads-ai',
  'gtm-starter-pack': 'gtm-pack',
  notch: 'notch',
  kamperownia: 'kamperownia',
  'mini-apps': 'mini-apps',
  'outbound-intelligence-system': 'gtm-pack',
  growthhub: 'growth-system',
};

const all = await getCollection('work', ({ data }) => !data.draft);
const byId = new Map(all.map((w) => [w.id, w]));
const items = ids.map((id) => byId.get(id)).filter(Boolean) as typeof all;

const h = accentHeading(heading);
---

<section class="relative py-[var(--space-section)] bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border-2)] to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="h-px w-9 bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
      <span class="obs-label-accent">{eyebrow}</span>
    </div>
    <h2 class="text-[length:var(--text-h2)] font-normal leading-[1.12] tracking-[-0.015em] mb-4 max-w-2xl">
      <span class="text-[var(--color-text)]">{h.lead}</span><span class="text-[var(--color-accent-cta)]" aria-hidden="true">{h.mark}</span>
    </h2>
    <p class="text-[length:var(--text-lead)] text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-xl">{lead}</p>

    <div class="grid gap-4 md:grid-cols-3 md:gap-6">
      {items.map((item, index) => (
        <ProjectCard
          title={item.data.title}
          description={item.data.description}
          tags={item.data.tags ?? []}
          href={item.data.href ?? '/work/'}
          cover={coverMap[item.id] ?? 'gtm-pack'}
          problem={item.data.problem}
          system={item.data.system}
          artifact={item.data.artifact}
          outcome={item.data.outcome}
          external={!!item.data.href && item.data.href.startsWith('http')}
          revealIndex={index + 1}
          labels={{ viewProject: viewLabel }}
        />
      ))}
    </div>
  </div>
</section>
