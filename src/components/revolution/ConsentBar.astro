---
// Analytics consent bar for the standalone home page (built from the
// /revolution/ preview). Same contract and behaviour as components/ui/CookieBanner.astro
// (see utils/consent-banner.ts), but dressed in the preview's own tokens: that
// page does not load the site's Tailwind sheet, so the Tailwind classes of the
// site banner would render unstyled here. The text comes from the same UI
// strings, so there is no new copy.
import { getUiStringsForPath } from '../../data/uiStrings';

const t = getUiStringsForPath(Astro.url.pathname);
---

<div
  id="cookie-banner"
  class="cnb"
  data-state="hidden"
  role="dialog"
  aria-label="Analytics consent"
  aria-live="polite"
>
  <div class="cnb__in">
    <p class="cnb__t">
      {t.cookie.bannerText}{' '}<a href="/privacy/">{t.cookie.privacyPolicy}</a>
    </p>
    <div class="cnb__b">
      <button id="cookie-decline" class="cnb__no" type="button">{t.cookie.reject}</button>
      <button id="cookie-accept" class="cnb__yes" type="button">{t.cookie.accept}</button>
    </div>
  </div>
</div>

<style is:global>
  /* A compact pill that follows the colour mode: paper with an olive accent in
     light, raised ink with lime in dark. Bottom left on wide screens, a slim
     strip on phones. Radius 16 for the pill, 10 for controls, 44 px targets. */
  .cnb {
    --cnb-bg: #f5f6ee;
    --cnb-fg: #23261b;
    --cnb-mute: #565c49;
    --cnb-line: rgb(40 44 32 / 0.14);
    --cnb-accent: #4d5c00;
    --cnb-on-accent: #f5f6ee;
    --cnb-shadow: 0 22px 44px -22px rgb(40 44 32 / 0.5), 0 6px 14px -8px rgb(40 44 32 / 0.3);
    position: fixed;
    inset: auto 0 0 0;
    z-index: 95;
    padding: 0 24px 24px;
    pointer-events: none;
    font-family: var(--sans, ui-sans-serif, system-ui, sans-serif);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s ease, visibility 0s;
  }
  html[data-mode='dark'] .cnb {
    --cnb-bg: #20241a;
    --cnb-fg: #f4f4ed;
    --cnb-mute: #b6baa8;
    --cnb-line: rgb(210 255 0 / 0.18);
    --cnb-accent: #d2ff00;
    --cnb-on-accent: #1c1f16;
    --cnb-shadow: 0 26px 50px -22px #000, inset 0 1px 0 rgb(255 255 255 / 0.05);
  }
  .cnb[data-state='hidden'] {
    transform: translateY(calc(100% + 24px));
    opacity: 0;
    visibility: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s ease, visibility 0s 0.35s;
  }
  .cnb__in {
    pointer-events: auto;
    width: fit-content;
    max-width: min(100%, 720px);
    display: flex;
    align-items: center;
    gap: 8px 24px;
    padding: 12px 12px 12px 20px;
    border-radius: 16px;
    background: var(--cnb-bg);
    color: var(--cnb-fg);
    box-shadow: 0 0 0 1px var(--cnb-line), var(--cnb-shadow);
  }
  .cnb__t {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--cnb-mute);
  }
  .cnb__t a {
    color: var(--cnb-fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .cnb__b {
    display: flex;
    flex: none;
    gap: 4px;
  }
  .cnb button {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font: 600 14px/1 var(--sans, ui-sans-serif, system-ui, sans-serif);
    white-space: nowrap;
    cursor: pointer;
  }
  .cnb__no {
    border: 0;
    background: transparent;
    color: var(--cnb-fg);
  }
  .cnb__no:hover {
    background: rgb(128 128 110 / 0.14);
  }
  .cnb__yes {
    border: 0;
    background: var(--cnb-accent);
    color: var(--cnb-on-accent);
  }
  .cnb a:focus-visible,
  .cnb button:focus-visible {
    outline: 2px solid var(--cnb-accent);
    outline-offset: 2px;
  }
  @media (max-width: 640px) {
    .cnb {
      padding: 0 12px 12px;
    }
    .cnb__in {
      width: auto;
      max-width: none;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 14px 14px 12px;
      border-radius: 16px;
    }
    .cnb__b {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 8px;
    }
    .cnb__no {
      box-shadow: inset 0 0 0 1px var(--cnb-line);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cnb,
    .cnb[data-state='hidden'] {
      transition: none;
    }
  }
</style>

<script>
  import { initConsentBanner } from '../../utils/consent-banner';

  initConsentBanner();
</script>
