---
// MDX component: highlighted callout box for key lessons.
// Usage:
//   <KeyTakeaway>One to three sentence takeaway goes here.</KeyTakeaway>
//   <KeyTakeaway icon="warning">Watch out for this gotcha.</KeyTakeaway>
//
// icon options: 'info' | 'warning' | 'tip' | 'check'

interface Props {
  icon?: 'info' | 'warning' | 'tip' | 'check';
  title?: string;
}

const { icon = 'info', title } = Astro.props;

const configs = {
  info: {
    label: title ?? 'Key takeaway',
    borderColor: 'var(--color-accent)',
    iconPath: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  warning: {
    label: title ?? 'Watch out',
    borderColor: '#f97316',
    iconPath: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
  },
  tip: {
    label: title ?? 'Tip',
    borderColor: 'var(--color-accent)',
    iconPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  check: {
    label: title ?? 'Confirmed',
    borderColor: 'var(--color-success)',
    iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
} as const;

const cfg = configs[icon];
---

<aside
  class="kt-block"
  data-icon={icon}
  role="note"
  aria-label={cfg.label}
  style={`--kt-accent: ${cfg.borderColor};`}
>
  <header class="kt-header">
    <span class="kt-icon" aria-hidden="true">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d={cfg.iconPath} />
      </svg>
    </span>
    <span class="kt-label">{cfg.label}</span>
  </header>
  <div class="kt-body">
    <slot />
  </div>
</aside>

<style>
  .kt-block {
    margin-block: 1.75rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--kt-accent, var(--color-accent));
    background: var(--color-accent-lo);
    overflow: hidden;
  }

  .kt-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.125rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--kt-accent, var(--color-accent)) 7%, var(--color-surface));
  }

  .kt-icon {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--kt-accent, var(--color-accent)) 14%, transparent);
    color: var(--kt-accent, var(--color-accent));
    flex-shrink: 0;
  }

  .kt-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .kt-body {
    padding: 0.875rem 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .kt-body :global(> *:last-child) {
    margin-bottom: 0;
  }

  .kt-body :global(p) {
    margin-block: 0.5rem;
  }

  .kt-body :global(p:first-child) {
    margin-top: 0;
  }

  .kt-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
