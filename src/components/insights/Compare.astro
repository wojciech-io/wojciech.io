---
interface Props {
  labelA: string;
  labelB: string;
  tagA?: string;
  tagB?: string;
}

const { labelA, labelB, tagA, tagB } = Astro.props;
---

<div class="compare">
  <section class="compare__col">
    <header class="compare__head">
      <h4 class="compare__label">{labelA}</h4>
      {tagA && <span class="compare__tag">{tagA}</span>}
    </header>
    <div class="compare__body"><slot name="a" /></div>
  </section>
  <section class="compare__col">
    <header class="compare__head">
      <h4 class="compare__label">{labelB}</h4>
      {tagB && <span class="compare__tag">{tagB}</span>}
    </header>
    <div class="compare__body"><slot name="b" /></div>
  </section>
</div>

<style>
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-block: 1.75rem;
  }
  @media (max-width: 600px) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
  .compare__col {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
    padding: 1.125rem 1.25rem;
  }
  .compare__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .compare__label {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .compare__tag {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .compare__body :global(> *:first-child) {
    margin-top: 0;
  }
  .compare__body :global(> *:last-child) {
    margin-bottom: 0;
  }
  .compare__body :global(p) {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-block: 0.5rem;
  }
  .compare__body :global(ul) {
    margin-block: 0.5rem;
    padding-left: 1.125rem;
    list-style-type: disc;
  }
  .compare__body :global(li) {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-block: 0.3125rem;
  }
</style>
