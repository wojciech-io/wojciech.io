---
interface Props {
  labelA: string;
  labelB: string;
  tagA?: string;
  tagB?: string;
  /** Color-code cols: left=muted(before), right=accent(after). Default true. */
  colorCode?: boolean;
  caption?: string;
}

const { labelA, labelB, tagA, tagB, colorCode = true, caption } = Astro.props;
---

<figure class="my-8 not-prose">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

    <!-- Column A: Before / baseline -->
    <section class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface-2)] overflow-hidden">
      <header class:list={[
        'flex items-center justify-between gap-2 px-4 py-3 border-b border-[var(--color-border)]',
        colorCode ? 'bg-[var(--color-surface)]' : 'bg-[var(--color-surface)]',
      ]}>
        <p class="font-semibold text-sm text-[var(--color-text-muted)]">{labelA}</p>
        {tagA && (
          <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-dim)] border border-[var(--color-border)] rounded px-1.5 py-0.5">
            {tagA}
          </span>
        )}
      </header>
      <div class="px-4 py-4 text-sm leading-relaxed text-[var(--color-text-muted)] [&>p]:my-2 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0 [&>ul]:my-2 [&>ul]:pl-4 [&>ul]:list-disc [&>li]:my-1.5">
        <slot name="a" />
      </div>
    </section>

    <!-- Column B: After / improved -->
    <section class:list={[
      'rounded-[var(--radius-card)] border overflow-hidden',
      colorCode
        ? 'border-[color-mix(in_srgb,var(--color-accent)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_4%,var(--color-surface-2))]'
        : 'border-[var(--color-border)] bg-[var(--color-surface-2)]',
    ]}>
      <header class:list={[
        'flex items-center justify-between gap-2 px-4 py-3 border-b',
        colorCode
          ? 'border-[color-mix(in_srgb,var(--color-accent)_25%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_6%,var(--color-surface))]'
          : 'border-[var(--color-border)] bg-[var(--color-surface)]',
      ]}>
        <p class:list={[
          'font-semibold text-sm',
          colorCode ? 'text-[var(--color-text)]' : 'text-[var(--color-text-muted)]',
        ]}>{labelB}</p>
        {tagB && (
          <span class:list={[
            'text-[10px] font-bold uppercase tracking-wider border rounded px-1.5 py-0.5',
            colorCode
              ? 'text-[var(--color-accent-hi)] border-[color-mix(in_srgb,var(--color-accent)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)]'
              : 'text-[var(--color-text-dim)] border-[var(--color-border)]',
          ]}>
            {tagB}
          </span>
        )}
      </header>
      <div class="px-4 py-4 text-sm leading-relaxed text-[var(--color-text-muted)] [&>p]:my-2 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0 [&>ul]:my-2 [&>ul]:pl-4 [&>ul]:list-disc [&>li]:my-1.5">
        <slot name="b" />
      </div>
    </section>

  </div>
  {caption && (
    <figcaption class="mt-3 text-center text-xs text-[var(--color-text-dim)]">{caption}</figcaption>
  )}
</figure>
