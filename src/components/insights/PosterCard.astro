---
// Poster-wall grid card for the /insights index. Presentational: the page
// computes href/date/read and passes display strings. `categoryKey` stays the
// English category value so filter logic and the theme map keep working; the
// visible label (`categoryLabel`) can be localised.
import { getPoster } from '../../lib/insightsPoster';

interface Props {
  href: string;
  title: string;
  categoryLabel: string;
  categoryKey?: string;
  date: string;
  read: string;
  index: number;
  arrowFlip?: boolean;
  /** Article cover art. Falls back to the generated poster when absent. */
  cover?: string;
}

const { href, title, categoryLabel, categoryKey = '', date, read, index, arrowFlip = false, cover } = Astro.props;
const t = getPoster(categoryKey);
---

<a
  href={href}
  class="js-article group relative flex aspect-[4/5] flex-col justify-between overflow-hidden rounded-[calc(var(--radius-card)*1.6)] border border-[var(--color-border)] p-6 transition-all duration-300 hover:-translate-y-1"
  data-category={categoryKey}
  style={`background:radial-gradient(80% 60% at 0% 0%, ${t.accent}1f 0%, transparent 55%), ${t.grad}`}
>
  {cover ? (
    /* The article's own cover art. 22 of these existed in public/images and
       nothing rendered them: the field was in the schema and in the
       frontmatter, and no component ever read it. The covers are light, and
       this card sets white text, so the scrim below is what keeps the title
       readable rather than a nicety. */
    <>
      <img
        src={cover}
        alt=""
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/10"></div>
    </>
  ) : (
    <div class="pointer-events-none absolute inset-0" style="background-image:linear-gradient(var(--color-grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-grid-line) 1px,transparent 1px);background-size:32px 32px;opacity:0.3"></div>
  )}
  <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" style={`background:radial-gradient(70% 50% at 100% 100%, ${t.accent}26 0%, transparent 60%)`}></div>

  <div class="relative flex items-center justify-between">
    <span
      class="inline-flex min-h-[24px] items-center gap-2 py-1.5 -my-1.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-white/70"
      data-filter-cat={categoryKey}
      role="button"
      tabindex="0"
      aria-label={`Filter by ${categoryLabel}`}
    >
      <span class="h-1.5 w-1.5 rounded-full" style={`background:${t.accent}`}></span>{categoryLabel}
    </span>
    <span class="font-mono text-[13px] tabular-nums text-white/25">{String(index).padStart(2, '0')}</span>
  </div>

  <div class="relative">
    <h3 dir="auto" class="text-balance text-[length:clamp(1.15rem,1vw+0.9rem,1.5rem)] font-semibold leading-[1.12] tracking-tight text-white line-clamp-4">
      {title}
    </h3>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center gap-x-2 text-[12px] text-white/50">
        <time>{date}</time><span aria-hidden="true">·</span><span>{read}</span>
      </div>
      <span class={`flex h-8 w-8 items-center justify-center rounded-full border border-white/15 text-white/70 transition-all duration-300 group-hover:border-white/40 group-hover:bg-white/5 ${arrowFlip ? 'rtl-flip-x' : ''}`}>
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </div>
</a>
