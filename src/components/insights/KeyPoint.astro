---
interface Props {
  title?: string;
  items?: string[];
  type?: 'takeaway' | 'warning' | 'result';
}

const { title, items = [], type = 'takeaway' } = Astro.props;

const config = {
  takeaway: { label: title ?? 'Key takeaway', icon: '→', accent: 'var(--color-accent)' },
  warning:  { label: title ?? 'Watch out',    icon: '!',  accent: '#f97316' },
  result:   { label: title ?? 'Result',       icon: '✓',  accent: 'var(--color-accent)' },
};

const c = config[type];
---

<div class="keypoint" data-type={type}>
  <div class="keypoint__header">
    <span class="keypoint__icon" aria-hidden="true">{c.icon}</span>
    <span class="keypoint__label">{c.label}</span>
  </div>
  {items.length > 0 ? (
    <ul class="keypoint__list">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  ) : (
    <div class="keypoint__body"><slot /></div>
  )}
</div>

<style>
  .keypoint {
    margin-block: 1.75rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    overflow: hidden;
  }

  .keypoint__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .keypoint__icon {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    font-size: 0.6875rem;
    font-weight: 800;
    background: color-mix(in srgb, var(--accent-color, var(--color-accent)) 12%, transparent);
    color: var(--accent-color, var(--color-accent));
    flex-shrink: 0;
  }

  .keypoint[data-type='warning'] .keypoint__icon {
    --accent-color: #f97316;
  }

  .keypoint__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .keypoint__list {
    list-style: none;
    margin: 0;
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .keypoint__list > :global(li) {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .keypoint__list > :global(li)::before {
    content: '·';
    color: var(--color-accent);
    font-weight: 800;
    flex-shrink: 0;
  }

  .keypoint__body {
    padding: 0.875rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .keypoint__body :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
