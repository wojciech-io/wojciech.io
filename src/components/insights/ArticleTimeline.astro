---
interface TimelineItem {
  date: string;
  title: string;
  body?: string;
  tag?: string;
  highlight?: boolean;
}

interface Props {
  items: TimelineItem[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<div class="atimeline">
  <ol class="atimeline__list">
    {items.map(({ date, title, body, tag, highlight }) => (
      <li class:list={['atimeline__item', highlight && 'atimeline__item--highlight']}>
        <div class="atimeline__dot" aria-hidden="true" />
        <div class="atimeline__content">
          <div class="atimeline__meta">
            <time class="atimeline__date">{date}</time>
            {tag && <span class="atimeline__tag">{tag}</span>}
          </div>
          <strong class="atimeline__title">{title}</strong>
          {body && <p class="atimeline__body">{body}</p>}
        </div>
      </li>
    ))}
  </ol>
  {caption && <p class="atimeline__caption">{caption}</p>}
</div>

<style>
  .atimeline {
    margin-block: 2rem;
  }

  .atimeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .atimeline__item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0 1rem;
    position: relative;
    padding-bottom: 1.5rem;
  }

  .atimeline__item:last-child {
    padding-bottom: 0;
  }

  .atimeline__item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.6875rem;
    top: 1.125rem;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .atimeline__dot {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-2);
    background: var(--color-surface);
    margin-top: 0.25rem;
    flex-shrink: 0;
    transition: border-color 0.15s;
  }

  .atimeline__item--highlight .atimeline__dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .atimeline__content {
    padding-bottom: 0.125rem;
  }

  .atimeline__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.25rem;
  }

  .atimeline__date {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  .atimeline__tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: 3px;
    padding: 0.125rem 0.375rem;
  }

  .atimeline__title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  .atimeline__body {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .atimeline__caption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-align: center;
  }
</style>
