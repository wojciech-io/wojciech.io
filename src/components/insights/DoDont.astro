---
interface Props {
  do?: string[];
  dont?: string[];
  doLabel?: string;
  dontLabel?: string;
}

const { do: doItems = [], dont = [], doLabel = 'Do', dontLabel = "Don't" } = Astro.props;
---

<div class="dodont">
  <div class="dodont-col dodont-do">
    <div class="dodont-header">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{doLabel}</span>
    </div>
    <ul>
      {doItems.map((item) => <li>{item}</li>)}
      <slot name="do" />
    </ul>
  </div>
  <div class="dodont-col dodont-dont">
    <div class="dodont-header">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{dontLabel}</span>
    </div>
    <ul>
      {dont.map((item) => <li>{item}</li>)}
      <slot name="dont" />
    </ul>
  </div>
</div>

<style>
  .dodont {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 2rem 0;
  }
  @media (min-width: 640px) {
    .dodont { grid-template-columns: 1fr 1fr; }
  }
  .dodont-col {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .dodont-header {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.875rem;
  }
  .dodont-do .dodont-header { color: var(--color-accent); }
  .dodont-dont .dodont-header { color: var(--color-text-muted); }
  .dodont-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .dodont-col :global(li) {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text);
    padding-left: 1rem;
    position: relative;
  }
  .dodont-col :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.625rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
  }
  .dodont-do :global(li)::before { background: var(--color-accent); }
  .dodont-dont :global(li)::before { background: var(--color-border-2); }
</style>
