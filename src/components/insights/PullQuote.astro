---
interface Props {
  quote?: string;
  source?: string;
  role?: string;
  href?: string;
}

const { quote, source, role, href } = Astro.props;
---

<figure class="pull-quote">
  <blockquote>
    {quote ? <p>{quote}</p> : <slot />}
  </blockquote>
  {source && (
    <figcaption>
      {href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">{source}</a>
      ) : (
        <span>{source}</span>
      )}
      {role && <span class="pull-quote__role">{role}</span>}
    </figcaption>
  )}
</figure>

<style>
  .pull-quote {
    position: relative;
    margin-block: 2.25rem;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 3px solid var(--color-accent);
  }

  .pull-quote::before {
    content: '"';
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-start: 1.25rem;
    color: var(--color-border-2);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  .pull-quote blockquote {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-text);
    font-style: normal;
  }

  .pull-quote blockquote :global(p) {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .pull-quote blockquote :global(p + p) {
    margin-top: 0.875rem;
  }

  .pull-quote figcaption {
    position: relative;
    z-index: 1;
    margin: 0.875rem 0 0;
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .pull-quote figcaption a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .pull-quote figcaption a:hover {
    color: var(--color-accent-hi);
  }

  .pull-quote__role::before {
    content: ' / ';
    color: var(--color-text-dim);
  }
</style>
