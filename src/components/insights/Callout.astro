---
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const config = {
  note: {
    accent: 'var(--color-text-muted)',
    label: 'Note',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>',
  },
  tip: {
    accent: 'var(--color-accent)',
    label: 'Tip',
    icon: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>',
  },
  warning: {
    accent: '#d97706',
    label: 'Warning',
    icon: '<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
  },
}[type];
---

<aside class="callout" data-type={type} style={`--callout-accent:${config.accent}`}>
  <span class="callout__icon" aria-hidden="true">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={config.icon} />
  </span>
  <div class="callout__body">
    <p class="callout__label">{title ?? config.label}</p>
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: 0.75rem;
    margin-block: 1.75rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--callout-accent);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .callout__icon {
    flex-shrink: 0;
    color: var(--callout-accent);
    line-height: 0;
    margin-top: 0.0625rem;
  }
  .callout__body {
    min-width: 0;
  }
  .callout__label {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--callout-accent);
  }
  .callout__body :global(> *:last-child) {
    margin-bottom: 0;
  }
  .callout__body :global(p) {
    margin-block: 0.375rem 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
</style>
