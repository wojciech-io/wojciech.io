---
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const config = {
  note: {
    label: 'Note',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>',
  },
  tip: {
    label: 'Tip',
    icon: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>',
  },
  warning: {
    label: 'Warning',
    icon: '<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
  },
}[type];
---

<aside class="callout" data-type={type}>
  <span class="callout__icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={config.icon} />
  </span>
  <div class="callout__body">
    <p class="callout__label">{title ?? config.label}</p>
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: 1rem;
    margin-block: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .callout__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .callout__body { min-width: 0; }
  .callout__label {
    margin: 0 0 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .callout__body :global(> *:last-child) { margin-bottom: 0; }
  .callout__body :global(p) {
    margin-block: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  /* tip: lime badge, dark icon on it */
  .callout[data-type='tip'] .callout__icon {
    background: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
    color: var(--color-accent-text);
  }
  .callout[data-type='tip'] .callout__label {
    color: var(--color-text);
  }

  /* warning: amber badge */
  .callout[data-type='warning'] .callout__icon {
    background: #fef3c7;
    border-color: #fde68a;
    color: #b45309;
  }
  .callout[data-type='warning'] .callout__label {
    color: #b45309;
  }

  /* dark mode adjustments */
  :global([data-theme='dark']) .callout[data-type='warning'] .callout__icon {
    background: #3a2c0a;
    border-color: #5a4410;
    color: #fbbf24;
  }
  :global([data-theme='dark']) .callout[data-type='warning'] .callout__label {
    color: #fbbf24;
  }
</style>
