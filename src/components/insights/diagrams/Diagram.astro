---
interface Props {
  caption?: string;
  direction?: 'row' | 'column';
  align?: 'start' | 'center' | 'stretch';
}

const { caption, direction = 'row', align = 'center' } = Astro.props;
---

<figure class="diagram" data-direction={direction}>
  <div class="diagram-canvas" style={`align-items:${align === 'stretch' ? 'stretch' : align === 'start' ? 'flex-start' : 'center'}`}>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 2rem 0;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .diagram-canvas {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .diagram[data-direction='column'] .diagram-canvas {
    flex-direction: column;
    align-items: stretch !important;
    gap: 0.25rem;
  }
  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Mobile — horizontal diagrams flip to column to keep readability */
  @media (max-width: 640px) {
    .diagram[data-direction='row'] .diagram-canvas {
      flex-direction: column;
      align-items: stretch !important;
      gap: 0.25rem;
    }
    .diagram[data-direction='row'] :global(.diagram-arrow) {
      transform: rotate(90deg);
      width: 1.5rem !important;
      min-width: 1.5rem !important;
      align-self: center;
    }
  }
</style>
