---
interface Metric {
  value: string;
  label: string;
  delta?: string;
  deltaPositive?: boolean;
}

interface Props {
  items: Metric[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<div class="metric-row">
  {items.map(({ value, label, delta, deltaPositive }) => (
    <div class="metric-row__item">
      <div class="metric-row__value">{value}</div>
      <div class="metric-row__label">{label}</div>
      {delta && (
        <div class:list={['metric-row__delta', deltaPositive === false && 'metric-row__delta--neg']}>
          {deltaPositive !== false ? '↑' : '↓'} {delta}
        </div>
      )}
    </div>
  ))}
  {caption && <p class="metric-row__caption">{caption}</p>}
</div>

<style>
  .metric-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    margin-block: 2rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-border);
    overflow: hidden;
  }

  .metric-row__item {
    padding: 1.25rem 1.5rem;
    background: var(--color-surface-2);
  }

  .metric-row__value {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .metric-row__label {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .metric-row__delta {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-accent) 80%, var(--color-text));
  }

  .metric-row__delta--neg {
    color: #f97316;
  }

  .metric-row__caption {
    grid-column: 1 / -1;
    padding: 0.5rem 1.5rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    text-align: center;
    margin: 0;
  }
</style>
