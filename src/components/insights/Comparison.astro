---
// MDX component: side-by-side comparison with array-based props.
// Usage:
//   <Comparison
//     left="Old approach"
//     right="New approach"
//     leftItems={["Manual, error-prone", "Slow to scale", "No observability"]}
//     rightItems={["Automated pipeline", "Scales with data volume", "Full audit trail"]}
//   />
// Renders a two-column grid with X markers on the left and checkmarks on the right.

interface Props {
  left: string;          // left column heading (the "before" / downside side)
  right: string;         // right column heading (the "after" / upside side)
  leftItems: string[];   // list of items for the left column
  rightItems: string[];  // list of items for the right column
  caption?: string;
}

const { left, right, leftItems, rightItems, caption } = Astro.props;
---

<figure class="comp-block">
  <div class="comp-grid">
    <!-- Left column -->
    <section class="comp-col comp-col--left" aria-label={left}>
      <header class="comp-header">
        <span class="comp-badge comp-badge--left" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="comp-heading">{left}</span>
      </header>
      <ul class="comp-list" role="list">
        {leftItems.map((item) => (
          <li class="comp-item comp-item--left">
            <span class="comp-icon comp-icon--left" aria-hidden="true">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none">
                <path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Right column -->
    <section class="comp-col comp-col--right" aria-label={right}>
      <header class="comp-header">
        <span class="comp-badge comp-badge--right" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 5l2.5 2.5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="comp-heading">{right}</span>
      </header>
      <ul class="comp-list" role="list">
        {rightItems.map((item) => (
          <li class="comp-item comp-item--right">
            <span class="comp-icon comp-icon--right" aria-hidden="true">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none">
                <path d="M1.5 5l2.5 2.5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
  {caption && <figcaption class="comp-caption">{caption}</figcaption>}
</figure>

<style>
  .comp-block {
    margin-block: 2rem;
  }

  .comp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

  @media (max-width: 560px) {
    .comp-grid {
      grid-template-columns: 1fr;
    }
  }

  .comp-col {
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }

  .comp-col--right {
    border-color: color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
  }

  .comp-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .comp-col--right .comp-header {
    border-bottom-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface-2));
  }

  .comp-badge {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .comp-badge--left {
    background: color-mix(in srgb, var(--color-text-dim) 14%, transparent);
    color: var(--color-text-dim);
  }

  .comp-badge--right {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .comp-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .comp-col--right .comp-heading {
    color: var(--color-text);
  }

  .comp-list {
    list-style: none;
    margin: 0;
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .comp-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .comp-icon {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .comp-icon--left {
    background: color-mix(in srgb, var(--color-text-dim) 10%, transparent);
    color: var(--color-text-dim);
  }

  .comp-icon--right {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .comp-caption {
    margin-top: 0.625rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }
</style>
