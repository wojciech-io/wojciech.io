---
/**
 * SlideLayout.astro
 * Standalone full-screen presentation layout.
 * Each child <section data-slide data-note="..."> is one slide.
 *
 * Usage:
 *   <SlideLayout title="My Deck" accent="#4f8ff7">
 *     <section data-slide data-note="Speaker note here">
 *       <h1>Title slide</h1>
 *     </section>
 *   </SlideLayout>
 */
interface Props {
  title: string;
  accent?: string;
}

const { title, accent = '#EBFF00' } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style is:global define:vars={{ accent }}>
    /* ── Fonts (self-hosted Geist, same as main site) ── */
    @font-face {
      font-family: 'Geist';
      src: url('/fonts/Geist-Regular.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('/fonts/Geist-Medium.woff2') format('woff2');
      font-weight: 500;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('/fonts/Geist-SemiBold.woff2') format('woff2');
      font-weight: 600;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('/fonts/Geist-Bold.woff2') format('woff2');
      font-weight: 700;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist Mono';
      src: url('/fonts/GeistMono-Regular.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
    }

    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }

    body {
      font-family: 'Geist', system-ui, -apple-system, sans-serif;
      background: #0a0a0a;
      color: #fafafa;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Slide viewport ── */
    .deck {
      position: relative;
      width: 100vw;
      height: 100vh;
    }

    [data-slide] {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 4rem 6rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }

    [data-slide].active {
      opacity: 1;
      pointer-events: auto;
    }

    /* ── Typography defaults ── */
    h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.1; text-align: center; letter-spacing: -0.025em; }
    h2 { font-size: clamp(1.8rem, 3.5vw, 3rem); font-weight: 600; line-height: 1.2; text-align: center; letter-spacing: -0.02em; }
    h3 { font-size: clamp(1.2rem, 2vw, 1.8rem); font-weight: 500; line-height: 1.3; }
    p, li { font-size: clamp(1rem, 1.6vw, 1.4rem); line-height: 1.6; color: #a1a1aa; max-width: 52ch; }
    ul, ol { list-style-position: inside; display: flex; flex-direction: column; gap: 0.75rem; }

    code {
      font-family: 'Geist Mono', monospace;
      font-size: 0.85em;
      background: rgba(255,255,255,0.08);
      padding: 0.15em 0.4em;
      border-radius: 4px;
    }

    /* ── Accent highlight ── */
    .accent { color: var(--accent); }
    .accent-bg { background: var(--accent); color: #0a0a0a; padding: 0.1em 0.4em; border-radius: 6px; }

    /* ── Grid layouts for content slides ── */
    .slide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; width: 100%; max-width: 64rem; align-items: center; }
    .slide-stack { display: flex; flex-direction: column; gap: 1.5rem; align-items: center; text-align: center; }

    /* ── Tag pills ── */
    .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
    .tag {
      font-size: 0.75rem;
      font-weight: 500;
      padding: 0.4em 0.9em;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 100px;
      color: #d4d4d8;
      white-space: nowrap;
      line-height: 1.4;
    }

    /* ── Navigation bar ── */
    .deck-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.5rem;
      background: rgba(10, 10, 10, 0.85);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,0.06);
      z-index: 10;
    }

    .deck-nav-buttons {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .deck-nav-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04);
      color: #a1a1aa;
      font-size: 1rem;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .deck-nav-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: rgba(255,255,255,0.06);
    }
    .deck-nav-btn:disabled {
      opacity: 0.25;
      cursor: default;
    }
    .deck-nav-btn:disabled:hover {
      border-color: rgba(255,255,255,0.1);
      color: #a1a1aa;
      background: rgba(255,255,255,0.04);
    }

    .counter {
      font-family: 'Geist Mono', monospace;
      font-size: 0.75rem;
      color: #52525b;
    }

    .deck-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s ease;
      z-index: 11;
    }

    /* ── Keyboard hint (hidden on touch) ── */
    .hint {
      font-size: 0.65rem;
      color: #3f3f46;
      display: none;
    }
    @media (hover: hover) {
      .hint { display: block; }
    }

    /* ── Notes panel ── */
    .notes {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(24, 24, 27, 0.95);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 1.5rem 2rem;
      transform: translateY(100%);
      transition: transform 0.3s ease;
      z-index: 20;
      max-height: 30vh;
      overflow-y: auto;
    }
    .notes.visible { transform: translateY(0); }
    .notes h4 {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #71717a;
      margin-bottom: 0.5rem;
    }
    .notes p {
      font-size: 0.95rem;
      color: #d4d4d8;
      line-height: 1.5;
    }

    /* ── Print / PDF export ── */
    @media print {
      .deck { position: static; }
      [data-slide] {
        position: relative;
        opacity: 1;
        pointer-events: auto;
        page-break-after: always;
        height: 100vh;
        width: 100vw;
      }
      .deck-nav, .deck-progress, .notes { display: none; }
    }
  </style>
</head>
<body>
  <div class="deck-progress" id="deck-progress" style="width: 0%"></div>

  <div class="deck">
    <slot />
  </div>

  <nav class="deck-nav" aria-label="Slide navigation">
    <div class="deck-nav-buttons">
      <button class="deck-nav-btn" id="btn-prev" aria-label="Previous slide" disabled>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="deck-nav-btn" id="btn-next" aria-label="Next slide">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="counter" id="slide-counter">1 / ?</div>
    <div class="hint">← → navigate · F fullscreen · N notes</div>
  </nav>

  <div class="notes" id="notes-panel">
    <h4>Speaker notes</h4>
    <p id="notes-content"></p>
  </div>

  <script src="./slide-runtime.client.ts"></script>
</body>
</html>
