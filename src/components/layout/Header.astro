---
import Nav, { links } from './Nav.astro';
import SearchModal from '../ui/SearchModal.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { localizedHomeList } from '../../data/locales';
import { localizedPageSlugs, type LocalizedPageSlug } from '../../data/localizedPages';

const segments = Astro.url.pathname.split('/').filter(Boolean);
const localeSegment = segments[0];
const currentLocale = localizedHomeList.find((locale) => locale.path === localeSegment);
const currentLanguageCode = currentLocale?.code ?? 'EN';
const currentPageSegment = currentLocale ? segments[1] : segments[0];
const localizedPage = localizedPageSlugs.includes(currentPageSegment as LocalizedPageSlug)
  ? currentPageSegment
  : '';
const languageOptions = [
  { code: 'EN', label: 'English', href: localizedPage ? `/${localizedPage}/` : '/' },
  ...localizedHomeList.map((locale) => ({
    code: locale.code,
    label: locale.label,
    href: localizedPage ? `/${locale.path}/${localizedPage}/` : `/${locale.path}/`,
  })),
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgb(var(--color-bg-rgb)/0.86)] backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-8">

    <!-- Wordmark -->
    <a
      href="/"
      class="inline-flex items-center gap-0 shrink-0 group"
      aria-label="wojciech.io, home"
      transition:name="site-wordmark"
    >
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)] transition-colors duration-150">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)] transition-colors duration-150">.io</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-8">
      <Nav />
      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="openSearch()"
          class="flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
          aria-label="Search (Cmd+K)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <ThemeToggle />
        <details class="relative">
          <summary class="lang-toggle-btn cursor-pointer list-none select-none" aria-label={`Language: ${currentLanguageCode}`}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span>{currentLanguageCode}</span>
          </summary>
          <div class="lang-dropdown absolute right-0 top-[calc(100%+8px)] z-50 min-w-36 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-1 shadow-[var(--shadow-card)]">
            {languageOptions.map((option) => (
              <a
                href={option.href}
                data-lang-switch={option.code}
                class:list={[
                  'lang-opt cursor-pointer',
                  option.code === currentLanguageCode && 'lang-opt--active',
                ]}
              >
                <span>{option.label}</span>
                <span class="lang-opt-code">{option.code}</span>
              </a>
            ))}
          </div>
        </details>
      </div>
      <a
        href="/contact/#book-call"
        class="btn-press shrink-0 inline-block min-w-40 text-center text-sm font-semibold px-4 py-1.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] hover:opacity-90 transition-colors"
        data-mp-cta="Book a call"
        data-mp-location="header"
      >
        Book a call
      </a>
    </div>

    <!-- Mobile: hamburger button -->
    <button
      id="mobile-nav-open"
      class="lg:hidden flex flex-col gap-[5px] justify-center items-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
    </button>

  </div>
  <SearchModal />
</header>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-[100] flex flex-col bg-[var(--color-bg)] transition-all duration-300 ease-out translate-x-full opacity-0 pointer-events-none lg:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-6 h-16 border-b border-[var(--color-border)] shrink-0">
    <a href="/" class="inline-flex items-center gap-0 group" onclick="closeMobileNav()" transition:name="site-wordmark-mobile">
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)]">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)]">.io</span>
    </a>
    <button
      id="mobile-nav-close"
      class="flex items-center justify-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Close navigation"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Nav links: large, full-height -->
  <nav class="flex-1 flex flex-col justify-center px-8" aria-label="Mobile navigation">
    <ul class="list-none m-0 p-0 space-y-1">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="mobile-nav-link group flex items-center justify-between py-4 border-b border-[var(--color-border)] text-2xl font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
          >
            {label}
            <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Bottom bar: search full-width, then theme + lang, then CTA -->
  <div class="px-8 pb-10 pt-6 border-t border-[var(--color-border)] shrink-0 space-y-3">
    <!-- Search -->
    <button
      id="mobile-search-btn"
      type="button"
      class="w-full flex items-center gap-2.5 rounded-[var(--radius-btn)] border border-[var(--color-border)] px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
      aria-label="Open search"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      Search
    </button>
    <!-- Theme toggle + language selector -->
    <div class="flex gap-3">
      <div class="flex-1">
        <ThemeToggle class="w-full" />
      </div>
      <details class="relative flex-1">
        <summary class="lang-toggle-btn w-full cursor-pointer list-none select-none justify-center" aria-label={`Language: ${currentLanguageCode}`}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{currentLanguageCode}</span>
        </summary>
        <div class="lang-dropdown absolute right-0 bottom-[calc(100%+8px)] z-50 min-w-40 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-1 shadow-[var(--shadow-card)]">
          {languageOptions.map((option) => (
            <a
              href={option.href}
              data-lang-switch={option.code}
              class:list={[
                'lang-opt cursor-pointer',
                option.code === currentLanguageCode && 'lang-opt--active',
              ]}
            >
              <span>{option.label}</span>
              <span class="lang-opt-code">{option.code}</span>
            </a>
          ))}
        </div>
      </details>
    </div>
    <!-- CTA -->
    <a
      href="/contact/#book-call"
      class="mobile-nav-link btn-press flex items-center justify-center gap-2 w-full bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold py-3.5 rounded-[var(--radius-btn)] hover:opacity-90 transition-opacity text-sm"
      data-mp-cta="Book a call"
      data-mp-location="mobile_nav"
    >
      Book a call
    </a>
  </div>
</div>

<script>
  // Re-runs after every View Transitions navigation so the new DOM elements
  // get fresh event listeners. Without this, hamburger stops working after
  // the first page change (elements are replaced but listeners aren't re-bound).
  function initMobileNav() {
    const overlay  = document.getElementById('mobile-nav-overlay');
    const openBtn  = document.getElementById('mobile-nav-open');
    const closeBtn = document.getElementById('mobile-nav-close');
    const searchBtn = document.getElementById('mobile-search-btn');
    if (!overlay || !openBtn || !closeBtn) return;

    const lines = openBtn.querySelectorAll<HTMLElement>('.hamburger-line');

    function openMobileNav() {
      overlay.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
      overlay.classList.add('translate-x-0', 'opacity-100');
      overlay.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      lines[1].style.opacity = '0';
      lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    }

    function closeMobileNav() {
      overlay.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
      overlay.classList.remove('translate-x-0', 'opacity-100');
      overlay.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lines[0].style.transform = '';
      lines[1].style.opacity = '';
      lines[2].style.transform = '';
    }

    // Expose so inline onclick="closeMobileNav()" on the wordmark link works
    (window as any).closeMobileNav = closeMobileNav;

    openBtn.addEventListener('click', openMobileNav);
    closeBtn.addEventListener('click', closeMobileNav);

    // Search button in overlay — close nav then open search modal
    searchBtn?.addEventListener('click', () => {
      closeMobileNav();
      (window as any).openSearch?.();
    });

    // Close when a nav link is followed
    overlay.querySelectorAll<HTMLElement>('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMobileNav);
    });
  }

  // One-time Escape key listener — persists across navigations (uses window ref)
  if (!document.documentElement.dataset.mobileNavEscapeReady) {
    document.documentElement.dataset.mobileNavEscapeReady = 'true';
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const btn = document.getElementById('mobile-nav-open');
      if (btn?.getAttribute('aria-expanded') === 'true') {
        (window as any).closeMobileNav?.();
      }
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>

<script>
  // Fix language switcher for localized insight article pages.
  // The server-side fallback only knows top-level slugs (e.g. /insights/), but each
  // article page emits <link rel="alternate" hreflang> tags with exact translated URLs.
  // We read those and update [data-lang-switch] anchors to point to the right article.
  const hreflangToCode: Record<string, string> = {
    en: 'EN', 'de-DE': 'DE', 'da-DK': 'DK', 'nb-NO': 'NO',
    'ja-JP': 'JP', 'it-IT': 'IT', 'es-ES': 'ES',
  };

  function applyAlternates() {
    const alternates = document.head.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]');
    if (!alternates.length) return;
    const map = new Map<string, string>();
    alternates.forEach((link) => {
      const code = hreflangToCode[link.hreflang];
      if (code) map.set(code, link.href);
    });
    if (!map.size) return;
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
      const code = a.dataset.langSwitch;
      if (code && map.has(code)) a.href = map.get(code)!;
    });
  }

  applyAlternates();
  document.addEventListener('astro:page-load', applyAlternates);
</script>
