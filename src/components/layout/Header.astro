---
import Nav from './Nav.astro';
import SearchModal from '../ui/SearchModal.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Icon from '../ui/Icon.astro';
import { localizedHomeList } from '../../data/locales';
import { localizedPageSlugs, type LocalizedPageSlug } from '../../data/localizedPages';
import { getPrimaryNavLinks, getUiStringsForPath, localizeHref, getLocaleFromPath } from '../../data/uiStrings';

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
const uiLocale = getLocaleFromPath(pathname);
const links = getPrimaryNavLinks(pathname);
const bookCallHref = localizeHref('/contact/', uiLocale) + '#book-call';

const segments = pathname.split('/').filter(Boolean);
const localeSegment = segments[0];
const currentLocale = localizedHomeList.find((locale) => locale.path === localeSegment);
// Arabic (ar) lives outside localizedHomeList (RTL, homepage only) but still
// needs to surface in the switcher and show as the active language.
const currentLanguageCode = localeSegment === 'ar' ? 'AR' : (currentLocale?.code ?? 'EN');
const currentPageSegment = currentLocale ? segments[1] : segments[0];
const localizedPage = localizedPageSlugs.includes(currentPageSegment as LocalizedPageSlug)
  ? currentPageSegment
  : '';
// Insights only exist in EN+PL; for other locales, the language switcher
// falls back to the locale home rather than emitting a 404.
const INSIGHT_LOCALES = new Set(['en', 'pl']);
const isInsightsPage = localizedPage === 'insights';
const languageOptions = [
  { code: 'EN', label: 'English', href: localizedPage ? `/${localizedPage}/` : '/' },
  ...localizedHomeList.map((locale) => {
    const hasLocalizedPage = localizedPage && (!isInsightsPage || INSIGHT_LOCALES.has(locale.path));
    return {
      code: locale.code,
      label: locale.label,
      href: hasLocalizedPage ? `/${locale.path}/${localizedPage}/` : `/${locale.path}/`,
    };
  }),
  // Arabic (RTL): homepage only for now, so always links to /ar/.
  { code: 'AR', label: 'العربية', href: '/ar/' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgb(var(--color-bg-rgb)/0.86)] backdrop-blur-md transform-gpu">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-8">

    <!-- Wordmark -->
    <a
      href="/"
      dir="ltr"
      class="wordmark-brand inline-flex items-center gap-0 shrink-0 group"
      aria-label="wojciech.io, home"
      transition:name="site-wordmark"
    >
      <span class="obs-mono text-sm font-semibold tracking-tight text-[var(--color-text)] transition-colors duration-150">wojciech</span><span class="obs-mono ml-0.5 inline-flex items-center justify-center h-5 w-5 rounded-[6px] bg-[var(--color-text)] dark:bg-[var(--color-accent-cta)] text-[8px] font-bold leading-none text-[var(--color-bg)] dark:text-[var(--color-accent-text)] transition-colors duration-150">.io</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-8">
      <Nav />
      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="openSearch()"
          class="inline-flex items-center justify-center h-8 w-8 rounded-[var(--radius-btn)] border border-[var(--color-border-2)] bg-[var(--color-surface)] text-[var(--color-text-dim)] shadow-[0_1px_3px_rgb(0_0_0/0.07)] transition-colors hover:text-[var(--color-text)] hover:border-[var(--color-border-2)]"
          aria-label={uiLocale === 'ar' ? 'بحث (Cmd+K)' : 'Search (Cmd+K)'}
        >
          <Icon name="search" class="h-[15px] w-[15px]" />
        </button>
        <ThemeToggle />
        <details class="relative">
          <summary class="lang-toggle-btn cursor-pointer list-none select-none" aria-label={`Language: ${currentLanguageCode}`}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span>{currentLanguageCode}</span>
          </summary>
          <div class="lang-dropdown absolute right-0 top-[calc(100%+8px)] z-50 min-w-36 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-1 shadow-[var(--shadow-card)]">
            {languageOptions.map((option) => (
              <a
                href={option.href}
                data-lang-switch={option.code}
                class:list={[
                  'lang-opt cursor-pointer',
                  option.code === currentLanguageCode && 'lang-opt--active',
                ]}
              >
                <span>{option.label}</span>
                <span class="lang-opt-code">{option.code}</span>
              </a>
            ))}
          </div>
        </details>
      </div>
      <a
        href={bookCallHref}
        class="btn-press shrink-0 inline-block min-w-40 text-center text-sm font-semibold px-4 py-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] hover:bg-[var(--color-accent-cta-hi)] transition-colors"
        data-cal-link="wojciech-luszczynski/30min"
        data-mp-cta="Book a call"
        data-mp-location="header"
      >
        {t.cta.bookCall}
      </a>
    </div>

    <!-- Mobile: hamburger button -->
    <button
      id="mobile-nav-open"
      class="lg:hidden flex flex-col gap-[5px] justify-center items-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label={uiLocale === 'ar' ? 'فتح التنقّل' : 'Open navigation'}
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
    </button>

  </div>
  <SearchModal />
</header>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-[100] flex flex-col bg-[var(--color-bg)] duration-300 ease-out translate-x-full opacity-0 pointer-events-none lg:hidden"
  style="transition-property: transform, opacity; will-change: transform, opacity;"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-6 h-16 border-b border-[var(--color-border)] shrink-0">
    <a href="/" dir="ltr" class="wordmark-brand inline-flex items-center gap-0 group" onclick="closeMobileNav()" transition:name="site-wordmark-mobile">
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)]">wojciech</span><span class="obs-mono ml-0.5 inline-flex items-center justify-center h-5 w-5 rounded-[6px] bg-[var(--color-accent-cta)] text-[8px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
    </a>
    <button
      id="mobile-nav-close"
      class="flex items-center justify-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label={uiLocale === 'ar' ? 'إغلاق التنقّل' : 'Close navigation'}
    >
      <Icon name="close" class="h-[18px] w-[18px]" />
    </button>
  </div>

  <!-- Nav links: large, full-height -->
  <nav class="flex-1 flex flex-col px-8 overflow-y-auto overscroll-contain" aria-label={uiLocale === 'ar' ? 'التنقّل على الجوال' : 'Mobile navigation'}>
    <ul class="list-none m-auto w-full p-0 space-y-1">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="mobile-nav-link group flex items-center justify-between py-4 border-b border-[var(--color-border)] text-2xl font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
          >
            {label}
            <Icon name="arrow-right" class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors rtl-flip-x" />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Bottom bar: search full-width, then theme + lang, then CTA -->
  <div class="px-8 pb-10 pt-6 border-t border-[var(--color-border)] shrink-0 space-y-3">
    <!-- Search -->
    <button
      id="mobile-search-btn"
      type="button"
      class="w-full flex items-center gap-2.5 rounded-[var(--radius-btn)] border border-[var(--color-border)] px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
      aria-label={uiLocale === 'ar' ? 'فتح البحث' : 'Open search'}
    >
      <Icon name="search" class="h-[15px] w-[15px]" />
      {uiLocale === 'ar' ? 'بحث' : 'Search'}
    </button>
    <!-- Theme toggle + language selector -->
    <div class="flex gap-3">
      <div class="flex-1">
        <ThemeToggle class="w-full" />
      </div>
      <details class="relative flex-1">
        <summary class="lang-toggle-btn w-full cursor-pointer list-none select-none justify-center" aria-label={`Language: ${currentLanguageCode}`}>
          <Icon name="globe" class="h-[13px] w-[13px]" />
          <span>{currentLanguageCode}</span>
        </summary>
        <div class="lang-dropdown absolute right-0 bottom-[calc(100%+8px)] z-50 min-w-40 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-1 shadow-[var(--shadow-card)]">
          {languageOptions.map((option) => (
            <a
              href={option.href}
              data-lang-switch={option.code}
              class:list={[
                'lang-opt cursor-pointer',
                option.code === currentLanguageCode && 'lang-opt--active',
              ]}
            >
              <span>{option.label}</span>
              <span class="lang-opt-code">{option.code}</span>
            </a>
          ))}
        </div>
      </details>
    </div>
    <!-- CTA -->
    <a
      href={bookCallHref}
      class="mobile-nav-link btn-press flex items-center justify-center gap-2 w-full bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold py-3 rounded-[var(--radius-btn)] hover:bg-[var(--color-accent-cta-hi)] transition-colors text-sm"
      data-cal-link="wojciech-luszczynski/30min"
      data-mp-cta="Book a call"
      data-mp-location="mobile_nav"
    >
      {t.cta.bookCall}
    </a>
  </div>
</div>

<script>
  // Re-runs after every View Transitions navigation so the new DOM elements
  // get fresh event listeners. Without this, hamburger stops working after
  // the first page change (elements are replaced but listeners aren't re-bound).
  function initMobileNav() {
    const overlay  = document.getElementById('mobile-nav-overlay');
    const openBtn  = document.getElementById('mobile-nav-open');
    const closeBtn = document.getElementById('mobile-nav-close');
    const searchBtn = document.getElementById('mobile-search-btn');
    if (!overlay || !openBtn || !closeBtn) return;

    const lines = openBtn.querySelectorAll<HTMLElement>('.hamburger-line');

    function openMobileNav() {
      overlay.style.transitionDuration = '';
      overlay.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
      overlay.classList.add('translate-x-0', 'opacity-100');
      overlay.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      lines[1].style.opacity = '0';
      lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    }

    function closeMobileNav() {
      overlay.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
      overlay.classList.remove('translate-x-0', 'opacity-100');
      overlay.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lines[0].style.transform = '';
      lines[1].style.opacity = '';
      lines[2].style.transform = '';
    }

    // Expose so inline onclick="closeMobileNav()" on the wordmark link works
    (window as any).closeMobileNav = closeMobileNav;

    openBtn.addEventListener('click', openMobileNav);
    closeBtn.addEventListener('click', closeMobileNav);

    // Search button in overlay: close nav, wait for transition to finish,
    // then open search modal. Without the delay, the nav overlay's
    // pointer-events-none hasn't kicked in yet and blocks touch input.
    searchBtn?.addEventListener('click', () => {
      closeMobileNav();
      setTimeout(() => (window as any).openSearch?.(), 320);
    });

    // Close when a nav link is followed. Close INSTANTLY (no 300ms slide) so the
    // full-screen overlay doesn't cover the incoming page mid view-transition —
    // that slide is what read as "delayed" and "doesn't jump to the top". Also
    // pin scroll to the top for in-page (hash-free) destinations.
    overlay.querySelectorAll<HTMLElement>('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        overlay.style.transitionDuration = '0ms';
        closeMobileNav();
        const href = link.getAttribute('href') || '';
        if (!href.includes('#')) window.scrollTo(0, 0);
      });
    });
  }

  // One-time Escape key listener, persists across navigations (uses window ref)
  if (!document.documentElement.dataset.mobileNavEscapeReady) {
    document.documentElement.dataset.mobileNavEscapeReady = 'true';
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const btn = document.getElementById('mobile-nav-open');
      if (btn?.getAttribute('aria-expanded') === 'true') {
        (window as any).closeMobileNav?.();
      }
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);

  // Safety net: if View Transition fires while mobile nav is open,
  // the overlay DOM gets destroyed but body.style.overflow persists.
  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
  });
</script>

<script>
  // Persist locale choice in a cookie so the middleware redirects on next visit.
  const LOCALE_CODE_TO_PATH: Record<string, string> = {
    EN: 'en', DE: 'de', DK: 'dk', NO: 'no', JP: 'jp', IT: 'it', ES: 'es', PL: 'pl', AR: 'ar',
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('[data-lang-switch]');
    if (!a) return;
    const locale = LOCALE_CODE_TO_PATH[a.dataset.langSwitch ?? ''];
    if (locale) {
      document.cookie = `locale_pref=${locale}; path=/; domain=wojciech.io; max-age=31536000; samesite=lax; secure`;
    }
  });

  // Fix language switcher for localized insight article pages.
  // The server-side fallback only knows top-level slugs (e.g. /insights/), but each
  // article page emits <link rel="alternate" hreflang> tags with exact translated URLs.
  // We read those and update [data-lang-switch] anchors to point to the right article.
  const hreflangToCode: Record<string, string> = {
    en: 'EN', pl: 'PL', 'de-DE': 'DE', 'da-DK': 'DK', 'nb-NO': 'NO',
    'ja-JP': 'JP', 'it-IT': 'IT', 'es-ES': 'ES',
  };

  function applyAlternates() {
    const alternates = document.head.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]');
    if (!alternates.length) return;
    const map = new Map<string, string>();
    alternates.forEach((link) => {
      const code = hreflangToCode[link.hreflang];
      if (code) map.set(code, link.href);
    });
    if (!map.size) return;
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
      const code = a.dataset.langSwitch;
      if (code && map.has(code)) a.href = map.get(code)!;
    });
  }

  applyAlternates();
  document.addEventListener('astro:page-load', applyAlternates);
</script>
