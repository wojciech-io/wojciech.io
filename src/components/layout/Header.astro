---
import Nav, { links } from './Nav.astro';
---

<header class="sticky top-0 z-50 bg-[var(--color-bg)]/90 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-8 border-b border-[var(--color-border)]">

    <!-- Wordmark -->
    <a
      href="/"
      class="inline-flex items-baseline gap-0 shrink-0 group"
      aria-label="wojciech.io, home"
    >
      <span class="text-sm font-semibold tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">wojciech</span><span class="text-sm font-semibold tracking-tight text-[var(--color-accent)] group-hover:text-[var(--color-accent-hi)] transition-colors duration-150">.io</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      <Nav />
      <a
        href="https://cal.com/wojciech-luszczynski"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press shrink-0 text-sm font-semibold px-4 py-1.5 rounded-[var(--radius-btn)] bg-[var(--color-accent)] text-[var(--color-accent-text)] hover:bg-[var(--color-accent-hi)] transition-colors"
      >
        Book a call
      </a>
    </div>

    <!-- Mobile nav -->
    <details class="nav-dropdown md:hidden relative">
      <summary
        class="flex items-center gap-2 cursor-pointer text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
        aria-label="Open navigation"
      >
        <!-- Hamburger icon -->
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="shrink-0">
          <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <!-- Chevron -->
        <svg class="chevron w-3.5 h-3.5 shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>

      <!-- Animated panel -->
      <div class="nav-panel absolute right-0 top-10 w-56">
        <nav
          class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-3 shadow-[0_8px_32px_0_rgb(0,0,0,0.4)]"
          aria-label="Mobile navigation"
        >
          <ul class="list-none m-0 p-0 space-y-1">
            {links.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  class="block rounded-[var(--radius-btn)] px-3 py-2 text-sm font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {label}
                </a>
              </li>
            ))}
            <li class="pt-2 border-t border-[var(--color-border)] mt-1">
              <a
                href="https://cal.com/wojciech-luszczynski"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-press block rounded-[var(--radius-btn)] bg-[var(--color-accent)] px-3 py-2 text-sm font-semibold text-[var(--color-accent-text)] text-center hover:bg-[var(--color-accent-hi)] transition-colors"
              >
                Book a call
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </details>

  </div>
</header>
