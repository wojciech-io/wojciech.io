---
import Nav, { links } from './Nav.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props { langPrefix?: string; }
const { langPrefix = '' } = Astro.props;
const home = langPrefix ? langPrefix + '/' : '/';
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgb(var(--color-bg-rgb)/0.86)] backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-8">

    <!-- Wordmark -->
    <a
      href={home}
      class="inline-flex items-center gap-0 shrink-0 group"
      aria-label="wojciech.io, home"
    >
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)] transition-colors duration-150">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)] transition-colors duration-150">.io</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      <Nav prefix={langPrefix} />
      <ThemeToggle />
      <!-- Language selector — flat trigger, flag dropdown -->
      <div class="relative" id="lang-dd">
        <button id="lang-trigger" aria-haspopup="listbox" aria-expanded="false"
          class="inline-flex items-center gap-1.5 h-8 px-1.5 rounded-[var(--radius-btn)] text-[11px] font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-150">
          <span id="lang-flag-current" class="inline-flex items-center">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
          </span>
          <span id="lang-code-current">EN</span>
          <svg id="lang-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="opacity-40 transition-transform duration-150"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div id="lang-menu" role="listbox" aria-label="Select language"
          class="hidden absolute right-0 top-[calc(100%+6px)] z-50 min-w-[9rem] overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-surface)] shadow-[0_8px_32px_rgb(0_0_0/0.18)] py-1 border border-[var(--color-border)]">
          <button onclick="switchLang('en')" data-lang-opt="en" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
            English
          </button>
          <button onclick="switchLang('pl')" data-lang-opt="pl" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>
            Polski
          </button>
          <button onclick="switchLang('it')" data-lang-opt="it" role="option"
            class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>
            Italiano
          </button>
          <div class="my-1 h-px bg-[var(--color-border)]" aria-hidden="true"></div>
          <div class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold opacity-35 cursor-not-allowed select-none">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="4.67" fill="#000"/><rect y="4.67" width="20" height="4.67" fill="#DD0000"/><rect y="9.33" width="20" height="4.67" fill="#FFCE00"/></svg>
            Deutsch <span class="ml-auto text-[9px] tracking-wide uppercase opacity-70">soon</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold opacity-35 cursor-not-allowed select-none">
            <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="14" fill="#C60B1E"/><rect y="3.5" width="20" height="7" fill="#FFC400"/></svg>
            Español <span class="ml-auto text-[9px] tracking-wide uppercase opacity-70">soon</span>
          </div>
        </div>
      </div>
      <a
        href={langPrefix + '/contact#book-call'}
        data-en="Book a call"
        data-pl="Umów rozmowę"
        data-it="Prenota una call"
        style="min-width:10rem;text-align:center"
        class="btn-press shrink-0 inline-block text-sm font-semibold px-4 py-1.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] hover:opacity-90 transition-colors"
      >
        Book a call
      </a>
    </div>

    <!-- Mobile: hamburger button -->
    <button
      id="mobile-nav-open"
      class="md:hidden flex flex-col gap-[5px] justify-center items-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
    </button>

  </div>
</header>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-[100] flex flex-col bg-[var(--color-bg)] transition-all duration-300 ease-out translate-x-full opacity-0 pointer-events-none md:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-6 h-16 border-b border-[var(--color-border)] shrink-0">
    <a href={home} class="inline-flex items-center gap-0 group" onclick="closeMobileNav()">
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)]">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)]">.io</span>
    </a>
    <button
      id="mobile-nav-close"
      class="flex items-center justify-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Close navigation"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Nav links — large, full-height -->
  <nav class="flex-1 flex flex-col justify-center px-8" aria-label="Mobile navigation">
    <ul class="list-none m-0 p-0 space-y-1">
      {links.map(({ label, href, external, pl, it }) => (
        <li>
          <a
            href={external ? href : langPrefix + href}
            data-en={label}
            data-pl={pl}
            data-it={it}
            class="mobile-nav-link group flex items-center justify-between py-4 border-b border-[var(--color-border)] text-2xl font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
            <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Bottom bar -->
  <div class="px-8 pb-10 pt-6 border-t border-[var(--color-border)] shrink-0 space-y-4">
    <ThemeToggle class="w-full" />
    <!-- Mobile language selector -->
    <div class="relative" id="lang-dd-mobile">
      <button id="lang-trigger-mobile" aria-haspopup="listbox" aria-expanded="false"
        class="w-full flex items-center gap-2 px-3 py-2.5 rounded-[var(--radius-btn)] text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
        <span id="lang-flag-mobile" class="inline-flex items-center">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
        </span>
        <span id="lang-label-mobile">English</span>
        <svg id="lang-chevron-mobile" width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="ml-auto opacity-40 transition-transform duration-150"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="lang-menu-mobile" role="listbox"
        class="hidden absolute bottom-[calc(100%+4px)] left-0 right-0 z-50 overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-surface)] shadow-[0_-8px_32px_rgb(0_0_0/0.18)] py-1 border border-[var(--color-border)]">
        <button onclick="switchLang('en')" data-lang-opt="en" role="option"
          class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>
          English
        </button>
        <button onclick="switchLang('pl')" data-lang-opt="pl" role="option"
          class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>
          Polski
        </button>
        <button onclick="switchLang('it')" data-lang-opt="it" role="option"
          class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>
          Italiano
        </button>
        <div class="my-1 h-px bg-[var(--color-border)]"></div>
        <div class="flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-35 cursor-not-allowed select-none">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="4.67" fill="#000"/><rect y="4.67" width="20" height="4.67" fill="#DD0000"/><rect y="9.33" width="20" height="4.67" fill="#FFCE00"/></svg>
          Deutsch <span class="ml-auto text-[10px] uppercase tracking-wide">soon</span>
        </div>
        <div class="flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-35 cursor-not-allowed select-none">
          <svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px] shrink-0"><rect width="20" height="14" fill="#C60B1E"/><rect y="3.5" width="20" height="7" fill="#FFC400"/></svg>
          Español <span class="ml-auto text-[10px] uppercase tracking-wide">soon</span>
        </div>
      </div>
    </div>
    <a
      href={langPrefix + '/contact#book-call'}
      data-en="Book a call"
      data-pl="Umów rozmowę"
      data-it="Prenota una call"
      class="mobile-nav-link btn-press flex items-center justify-center gap-2 w-full bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold py-3.5 rounded-[var(--radius-btn)] hover:opacity-90 transition-opacity text-sm"
    >
      Book a call
    </a>
  </div>
</div>

<script>
  const overlay  = document.getElementById('mobile-nav-overlay')!;
  const openBtn  = document.getElementById('mobile-nav-open')!;
  const closeBtn = document.getElementById('mobile-nav-close')!;
  const lines    = openBtn.querySelectorAll<HTMLElement>('.hamburger-line');

  function openMobileNav() {
    overlay.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
    overlay.classList.add('translate-x-0', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Animate to X
    lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
    lines[1].style.opacity = '0';
    lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
  }

  function closeMobileNav() {
    overlay.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
    overlay.classList.remove('translate-x-0', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    // Reset hamburger
    lines[0].style.transform = '';
    lines[1].style.opacity = '';
    lines[2].style.transform = '';
  }

  // Make closeMobileNav available globally for the wordmark link
  (window as any).closeMobileNav = closeMobileNav;

  // ── Language selector ──────────────────────────────────────────────
  const FLAG_SVGS: Record<string, string> = {
    en: `<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>`,
    pl: `<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>`,
    it: `<svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>`,
  };
  const FLAG_SVGS_LG: Record<string, string> = {
    en: `<svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="14" fill="#B22234"/><rect width="20" height="1.08" y="1.08" fill="white"/><rect width="20" height="1.08" y="3.23" fill="white"/><rect width="20" height="1.08" y="5.38" fill="white"/><rect width="20" height="1.08" y="7.54" fill="white"/><rect width="20" height="1.08" y="9.69" fill="white"/><rect width="20" height="1.08" y="11.85" fill="white"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>`,
    pl: `<svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="20" height="7" fill="white"/><rect y="7" width="20" height="7" fill="#DC143C"/></svg>`,
    it: `<svg width="22" height="16" viewBox="0 0 20 14" aria-hidden="true" class="block rounded-[2px]"><rect width="6.67" height="14" fill="#009246"/><rect x="6.67" width="6.67" height="14" fill="white"/><rect x="13.33" width="6.67" height="14" fill="#CE2B37"/></svg>`,
  };
  const LANG_LABELS: Record<string, { code: string; label: string }> = {
    en: { code: 'EN', label: 'English' },
    pl: { code: 'PL', label: 'Polski' },
    it: { code: 'IT', label: 'Italiano' },
  };

  function updateLangTrigger(lang: string) {
    const l = LANG_LABELS[lang] ?? LANG_LABELS['en'];
    const dFlag = document.getElementById('lang-flag-current');
    const dCode = document.getElementById('lang-code-current');
    const mFlag = document.getElementById('lang-flag-mobile');
    const mLabel = document.getElementById('lang-label-mobile');
    if (dFlag) dFlag.innerHTML = FLAG_SVGS[lang] ?? FLAG_SVGS['en'];
    if (dCode) dCode.textContent = l.code;
    if (mFlag) mFlag.innerHTML = FLAG_SVGS_LG[lang] ?? FLAG_SVGS_LG['en'];
    if (mLabel) mLabel.textContent = l.label;
    // Highlight active option
    document.querySelectorAll<HTMLElement>('[data-lang-opt]').forEach(el => {
      const active = el.dataset.langOpt === lang;
      el.classList.toggle('text-[var(--color-text)]', active);
      el.classList.toggle('bg-[var(--color-surface-2)]', active);
    });
  }

  function closeLangMenus() {
    ['lang-menu', 'lang-menu-mobile'].forEach(id => {
      document.getElementById(id)?.classList.add('hidden');
    });
    document.getElementById('lang-trigger')?.setAttribute('aria-expanded', 'false');
    document.getElementById('lang-trigger-mobile')?.setAttribute('aria-expanded', 'false');
    const chev = document.getElementById('lang-chevron');
    const chevM = document.getElementById('lang-chevron-mobile');
    if (chev) chev.style.transform = '';
    if (chevM) chevM.style.transform = '';
  }

  function toggleMenu(menuId: string, triggerId: string, chevronId: string) {
    const menu = document.getElementById(menuId)!;
    const isOpen = !menu.classList.contains('hidden');
    closeLangMenus();
    if (!isOpen) {
      menu.classList.remove('hidden');
      document.getElementById(triggerId)?.setAttribute('aria-expanded', 'true');
      const chev = document.getElementById(chevronId);
      if (chev) chev.style.transform = 'rotate(180deg)';
    }
  }

  document.getElementById('lang-trigger')?.addEventListener('click', e => {
    e.stopPropagation();
    toggleMenu('lang-menu', 'lang-trigger', 'lang-chevron');
  });
  document.getElementById('lang-trigger-mobile')?.addEventListener('click', e => {
    e.stopPropagation();
    toggleMenu('lang-menu-mobile', 'lang-trigger-mobile', 'lang-chevron-mobile');
  });
  document.addEventListener('click', closeLangMenus);

  // Language URL navigation
  (window as any).switchLang = function(lang: string) {
    const supportedLangs = ['en', 'pl', 'it'];
    if (!supportedLangs.includes(lang)) return;
    closeLangMenus();
    const currentPath = window.location.pathname;
    // Strip any existing lang prefix
    const basePath = currentPath.replace(/^\/(en|pl|it)(\/|$)/, '/') || '/';
    // EN pages live at root (/about), PL/IT get a prefix (/pl/about)
    const targetUrl = lang === 'en' ? basePath : `/${lang}${basePath}`;
    localStorage.setItem('wio_lang', lang);
    window.location.href = targetUrl;
  };

  // Init trigger display on page load
  const initLang = localStorage.getItem('wio_lang') ?? 'en';
  updateLangTrigger(initLang);

  openBtn.addEventListener('click', openMobileNav);
  closeBtn.addEventListener('click', closeMobileNav);

  // Close on nav link click (internal links only)
  overlay.querySelectorAll<HTMLElement>('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMobileNav);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openBtn.getAttribute('aria-expanded') === 'true') {
      closeMobileNav();
    }
  });
</script>
