---
import Nav, { links } from './Nav.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgb(var(--color-bg-rgb)/0.86)] backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-8">

    <!-- Wordmark -->
    <a
      href="/"
      class="inline-flex items-center gap-0 shrink-0 group"
      aria-label="wojciech.io, home"
    >
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)] transition-colors duration-150">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)] transition-colors duration-150">.io</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      <Nav />
      <ThemeToggle />
      <!-- Language dropdown -->
      <div class="relative" id="lang-dd-desktop">
        <button
          id="lang-dd-btn-desktop"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex items-center gap-1.5 rounded-[var(--radius-btn)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1.5 text-xs font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-2)] transition-colors duration-150"
        >
          <span id="lang-flag-desktop" class="text-sm leading-none">🇺🇸</span>
          <span id="lang-code-desktop">EN</span>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="opacity-50 transition-transform duration-150" id="lang-chevron-desktop">
            <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          id="lang-dd-menu-desktop"
          role="listbox"
          aria-label="Select language"
          class="lang-dd-menu absolute right-0 top-[calc(100%+6px)] z-50 hidden min-w-[7.5rem] overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_8px_24px_rgb(0_0_0/0.14)] py-1"
        >
          <button onclick="setLang('en')" data-lang="en" role="option" class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-sm">🇺🇸</span> EN</button>
          <button onclick="setLang('pl')" data-lang="pl" role="option" class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-sm">🇵🇱</span> PL</button>
          <button onclick="setLang('it')" data-lang="it" role="option" class="lang-opt w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-sm">🇮🇹</span> IT</button>
          <div class="my-1 h-px bg-[var(--color-border)]" aria-hidden="true"></div>
          <div class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold opacity-35 cursor-not-allowed select-none"><span class="text-sm">🇩🇪</span> DE <span class="ml-auto text-[9px] font-medium tracking-wide uppercase opacity-70">soon</span></div>
          <div class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold opacity-35 cursor-not-allowed select-none"><span class="text-sm">🇪🇸</span> ES <span class="ml-auto text-[9px] font-medium tracking-wide uppercase opacity-70">soon</span></div>
        </div>
      </div>
      <a
        href="/contact#book-call"
        data-en="Book a call"
        data-pl="Umów rozmowę"
        data-it="Prenota una call"
        class="btn-press shrink-0 text-sm font-semibold px-4 py-1.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] hover:opacity-90 transition-colors"
      >
        Book a call
      </a>
    </div>

    <!-- Mobile: hamburger button -->
    <button
      id="mobile-nav-open"
      class="md:hidden flex flex-col gap-[5px] justify-center items-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-[1.5px] bg-current rounded-full transition-all duration-300 origin-center"></span>
    </button>

  </div>
</header>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-[100] flex flex-col bg-[var(--color-bg)] transition-all duration-300 ease-out translate-x-full opacity-0 pointer-events-none md:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-6 h-16 border-b border-[var(--color-border)] shrink-0">
    <a href="/" class="inline-flex items-center gap-0 group" onclick="closeMobileNav()">
      <span class="text-sm font-bold tracking-tight text-[var(--color-text)]">wojciech</span><span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[11px] font-bold tracking-tight text-[var(--color-accent-text)]">.io</span>
    </a>
    <button
      id="mobile-nav-close"
      class="flex items-center justify-center w-10 h-10 -mr-2 rounded-[var(--radius-btn)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
      aria-label="Close navigation"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Nav links — large, full-height -->
  <nav class="flex-1 flex flex-col justify-center px-8" aria-label="Mobile navigation">
    <ul class="list-none m-0 p-0 space-y-1">
      {links.map(({ label, href, external, pl, it }) => (
        <li>
          <a
            href={href}
            data-en={label}
            data-pl={pl}
            data-it={it}
            class="mobile-nav-link group flex items-center justify-between py-4 border-b border-[var(--color-border)] text-2xl font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-hi)] transition-colors"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
            <svg class="w-4 h-4 text-[var(--color-text-dim)] group-hover:text-[var(--color-accent)] transition-colors" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Bottom bar -->
  <div class="px-8 pb-10 pt-6 border-t border-[var(--color-border)] shrink-0 space-y-4">
    <ThemeToggle class="w-full" />
    <!-- Mobile language dropdown -->
    <div class="relative" id="lang-dd-mobile">
      <button
        id="lang-dd-btn-mobile"
        aria-haspopup="listbox"
        aria-expanded="false"
        class="w-full flex items-center justify-between gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2.5 text-xs font-semibold text-[var(--color-text-muted)]"
      >
        <span class="flex items-center gap-2">
          <span id="lang-flag-mobile" class="text-base leading-none">🇺🇸</span>
          <span id="lang-code-mobile">English</span>
        </span>
        <svg width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="opacity-50" id="lang-chevron-mobile">
          <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div
        id="lang-dd-menu-mobile"
        role="listbox"
        class="lang-dd-menu hidden absolute bottom-[calc(100%+6px)] left-0 right-0 z-50 overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_-8px_24px_rgb(0_0_0/0.14)] py-1"
      >
        <button onclick="setLang('en')" data-lang="en" role="option" class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-base">🇺🇸</span> English</button>
        <button onclick="setLang('pl')" data-lang="pl" role="option" class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-base">🇵🇱</span> Polski</button>
        <button onclick="setLang('it')" data-lang="it" role="option" class="lang-opt w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-[var(--color-text-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)] transition-colors"><span class="text-base">🇮🇹</span> Italiano</button>
        <div class="my-1 h-px bg-[var(--color-border)]"></div>
        <div class="flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-35 cursor-not-allowed"><span class="text-base">🇩🇪</span> Deutsch <span class="ml-auto text-[9px] uppercase tracking-wide">soon</span></div>
        <div class="flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-35 cursor-not-allowed"><span class="text-base">🇪🇸</span> Español <span class="ml-auto text-[9px] uppercase tracking-wide">soon</span></div>
      </div>
    </div>
    <a
      href="/contact#book-call"
      data-en="Book a call"
      data-pl="Umów rozmowę"
      data-it="Prenota una call"
      class="mobile-nav-link btn-press flex items-center justify-center gap-2 w-full bg-[var(--color-accent-cta)] text-[var(--color-accent-text)] font-semibold py-3.5 rounded-[var(--radius-btn)] hover:opacity-90 transition-opacity text-sm"
    >
      Book a call
    </a>
  </div>
</div>

<script>
  const overlay  = document.getElementById('mobile-nav-overlay')!;
  const openBtn  = document.getElementById('mobile-nav-open')!;
  const closeBtn = document.getElementById('mobile-nav-close')!;
  const lines    = openBtn.querySelectorAll<HTMLElement>('.hamburger-line');

  function openMobileNav() {
    overlay.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
    overlay.classList.add('translate-x-0', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Animate to X
    lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
    lines[1].style.opacity = '0';
    lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
  }

  function closeMobileNav() {
    overlay.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
    overlay.classList.remove('translate-x-0', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    // Reset hamburger
    lines[0].style.transform = '';
    lines[1].style.opacity = '';
    lines[2].style.transform = '';
  }

  // Make closeMobileNav available globally for the wordmark link
  (window as any).closeMobileNav = closeMobileNav;

  // ── Language dropdown ──────────────────────────────────────────────
  const LANGS: Record<string, { flag: string; code: string; label: string }> = {
    en: { flag: '🇺🇸', code: 'EN', label: 'English' },
    pl: { flag: '🇵🇱', code: 'PL', label: 'Polski' },
    it: { flag: '🇮🇹', code: 'IT', label: 'Italiano' },
  };

  function updateLangDisplay(lang: string) {
    const l = LANGS[lang] ?? LANGS['en'];
    const dFlag = document.getElementById('lang-flag-desktop');
    const dCode = document.getElementById('lang-code-desktop');
    const mFlag = document.getElementById('lang-flag-mobile');
    const mCode = document.getElementById('lang-code-mobile');
    if (dFlag) dFlag.textContent = l.flag;
    if (dCode) dCode.textContent = l.code;
    if (mFlag) mFlag.textContent = l.flag;
    if (mCode) mCode.textContent = l.label;
    // Highlight active option
    document.querySelectorAll<HTMLButtonElement>('.lang-opt').forEach(btn => {
      const active = btn.dataset.lang === lang;
      btn.classList.toggle('text-[var(--color-text)]', active);
      btn.classList.toggle('bg-[var(--color-surface-2)]', active);
    });
  }

  function toggleDropdown(menuId: string, btnId: string, chevronId: string) {
    const menu = document.getElementById(menuId)!;
    const btn  = document.getElementById(btnId)!;
    const chev = document.getElementById(chevronId)!;
    const open = !menu.classList.contains('hidden');
    closeAllDropdowns();
    if (!open) {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      chev.style.transform = 'rotate(180deg)';
    }
  }

  function closeAllDropdowns() {
    document.querySelectorAll<HTMLElement>('.lang-dd-menu').forEach(m => m.classList.add('hidden'));
    ['lang-dd-btn-desktop','lang-dd-btn-mobile'].forEach(id => {
      document.getElementById(id)?.setAttribute('aria-expanded', 'false');
    });
    ['lang-chevron-desktop','lang-chevron-mobile'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.transform = '';
    });
  }

  document.getElementById('lang-dd-btn-desktop')?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDropdown('lang-dd-menu-desktop', 'lang-dd-btn-desktop', 'lang-chevron-desktop');
  });
  document.getElementById('lang-dd-btn-mobile')?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDropdown('lang-dd-menu-mobile', 'lang-dd-btn-mobile', 'lang-chevron-mobile');
  });
  document.addEventListener('click', closeAllDropdowns);

  // Hook into setLang to update display
  const _origSetLang = (window as any).setLang;
  (window as any).setLang = function(lang: string) {
    _origSetLang?.(lang);
    updateLangDisplay(lang);
    closeAllDropdowns();
  };

  // Init display on page load
  const initLang = localStorage.getItem('wio_lang') ?? 'en';
  updateLangDisplay(initLang);

  openBtn.addEventListener('click', openMobileNav);
  closeBtn.addEventListener('click', closeMobileNav);

  // Close on nav link click (internal links only)
  overlay.querySelectorAll<HTMLElement>('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMobileNav);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openBtn.getAttribute('aria-expanded') === 'true') {
      closeMobileNav();
    }
  });
</script>
