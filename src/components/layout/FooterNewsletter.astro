---
// The AI Espresso invite that ships with the footer on every page. Same
// inverted espresso panel language as the /subscribe sign-up band, compressed
// to a strip: pitch on the left, the joined field-and-button pill on the
// right, consent in small print. Posts to the same /api/subscribe endpoint
// with the same honeypot and timing signals.
//
// Kept EN and LTR on every locale: AI Espresso is an English product, and the
// band follows the same rule as other product artefacts on localized pages.
---

<div class="fnl-band" dir="ltr">
  <div class="fnl-aura" aria-hidden="true"></div>

  <div class="fnl-grid">
    <div class="fnl-pitch">
      <p class="fnl-kicker">
        <img src="/images/ai-espresso-cup.png" width="26" height="26" alt="" loading="lazy" style="border-radius: 8px; display: block;" />
        <span>AI Espresso · weekday mornings</span>
      </p>
      <p class="fnl-title">A day of AI, in one sip<span class="fnl-dot" aria-hidden="true">.</span></p>
      <p class="fnl-sub">The day's AI shifts, distilled to three minutes. Free, every weekday.</p>
    </div>

    <form id="fnl-form" class="fnl-form" novalidate>
      <div class="fnl-row">
        <label class="sr-only" for="fnl-email">Email address</label>
        <input
          type="email"
          id="fnl-email"
          name="email"
          class="fnl-input"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@company.com"
        />
        <button type="submit" id="fnl-btn" class="btn-press obs-mono fnl-btn">
          Subscribe →
        </button>
      </div>

      <!-- Honeypot: out of flow and out of assistive tech, still in the DOM
           for bots that fill every field. -->
      <div class="fnl-hp" aria-hidden="true">
        <label for="fnl-website">Leave this field empty</label>
        <input type="text" id="fnl-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <label class="fnl-consent" for="fnl-consent">
        <input type="checkbox" id="fnl-consent" name="consent" required />
        <span>
          I agree to receive the AI Espresso newsletter by email from Wojciech Łuszczyński and accept the
          <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy policy</a>. Unsubscribe anytime.
        </span>
      </label>

      <p id="fnl-status" class="fnl-status" role="status" aria-live="polite"></p>
    </form>

    <!-- Double opt-in: after submit the form column becomes this moment. -->
    <div id="fnl-pending" class="fnl-pending" style="display: none;">
      <span class="fnl-pending-badge" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-cta)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <p class="fnl-pending-title">One click left. Check your inbox.</p>
      <p class="fnl-pending-sub">We sent a confirmation link to <span id="fnl-pending-email"></span>.</p>
    </div>
  </div>
</div>

<script>
  // Wired via astro:page-load, not at module top level: with the ClientRouter
  // swapping page bodies, a top-level listener would bind once and die on the
  // first client-side navigation (the same failure the /subscribe form had).
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('fnl-form') as HTMLFormElement | null;
    if (!form || form.dataset.wired === '1') return;
    form.dataset.wired = '1';
    const status = document.getElementById('fnl-status') as HTMLElement;
    const btn = document.getElementById('fnl-btn') as HTMLButtonElement;
    const emailInput = document.getElementById('fnl-email') as HTMLInputElement;
    const consentInput = document.getElementById('fnl-consent') as HTMLInputElement;
    const honeypot = document.getElementById('fnl-website') as HTMLInputElement;

    // Bot timing signal: real people do not submit within two seconds of load.
    const loadedAt = Date.now();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim().toLowerCase();
      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please enter a valid email address.';
        status.style.color = '#f87171';
        emailInput.focus();
        return;
      }
      if (!consentInput.checked) {
        status.textContent = 'Please tick the consent box. It is required to send you the newsletter.';
        status.style.color = '#f87171';
        consentInput.focus();
        return;
      }
      btn.disabled = true;
      btn.style.opacity = '0.6';
      btn.textContent = 'Sending...';
      status.textContent = '';
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            consent: true,
            website: honeypot?.value || '',
            elapsed: Date.now() - loadedAt,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          form.style.display = 'none';
          (document.getElementById('fnl-pending-email') as HTMLElement).textContent = email;
          (document.getElementById('fnl-pending') as HTMLElement).style.display = 'block';
        } else {
          throw new Error((data as any)?.error || 'Failed');
        }
      } catch (err: any) {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.textContent = 'Subscribe →';
        status.textContent = err?.message === 'Failed' ? 'Something went wrong. Try again.' : (err?.message || 'Something went wrong.');
        status.style.color = '#f87171';
      }
    });
  });
</script>

<style>
  /* When the page already closes with a CTA band (24 pages do), the footer's
     newsletter band would stack a second big panel right under it. Drop the
     band there — the newsletter stays reachable via the footer's Subscribe
     link and /subscribe. Pages with no closing CTA still get the band. */
  :global(body:has(.cta-band)) .fnl-band { display: none; }

  /* The same fixed dark espresso palette as the /subscribe sign-up band, in
     both themes: it is coffee, and the lime CTA pops hardest on it. */
  .fnl-band {
    --band-bg: #17130e;
    --band-surface: rgb(255 255 255 / 0.07);
    --band-border: rgb(255 255 255 / 0.16);
    --band-text: #f5f3ec;
    --band-muted: rgb(245 243 236 / 0.68);
    position: relative;
    overflow: hidden;
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
    padding: clamp(2rem, 4.5vw, 3.25rem) clamp(1.5rem, 3.5vw, 3rem);
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 34%, #2b261d);
    background:
      radial-gradient(110% 180% at 10% -40%, color-mix(in srgb, var(--color-accent-cta) 13%, transparent) 0%, transparent 56%),
      radial-gradient(90% 130% at 100% 130%, rgb(120 90 40 / 0.16) 0%, transparent 60%),
      var(--band-bg);
  }
  .fnl-aura {
    position: absolute;
    left: -90px; top: -160px;
    width: 420px; height: 340px; border-radius: 9999px;
    background: radial-gradient(circle, var(--color-accent-cta) 0%, transparent 68%);
    opacity: 0.14; filter: blur(55px); pointer-events: none;
  }

  .fnl-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fnl-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 28rem); gap: clamp(2.5rem, 5vw, 4.5rem); }
  }

  .fnl-kicker {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-cta);
  }
  .fnl-title {
    margin: 0;
    font-size: clamp(1.625rem, 2.8vw, 2.375rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--band-text);
  }
  .fnl-dot {
    color: var(--color-accent-cta);
    text-shadow: 0 0 20px color-mix(in srgb, var(--color-accent-cta) 55%, transparent);
  }
  .fnl-sub {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--band-muted);
    max-width: 30rem;
  }

  /* One joined pill: field and button share a frame, focus lights the whole
     pill. Same construction as the /subscribe band. */
  .fnl-row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.3125rem;
    border-radius: calc(var(--radius-btn) + 5px);
    border: 1px solid var(--band-border);
    background: var(--band-surface);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .fnl-row:focus-within {
    border-color: color-mix(in srgb, var(--color-accent-cta) 65%, var(--band-border));
    box-shadow: 0 0 0 3px rgb(235 255 0 / 0.12);
  }
  /* Full-height tap target in both layouts. Font stays at 16px: anything
     smaller makes iOS Safari zoom into the field on focus, which reads as
     the input being cut off. */
  .fnl-input {
    flex: none;
    min-width: 0;
    width: 100%;
    height: 3.5rem;
    border: none;
    background: transparent;
    padding: 0 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--band-text);
    outline: none;
  }
  /* Horizontal pill from 560px up. flex: 1 belongs ONLY here: in the stacked
     column layout the main axis is vertical, so flex-basis: 0% would zero the
     field's height and collapse it to its text line. Must come after the base
     rule, or the base flex: none wins the cascade. */
  @media (min-width: 560px) {
    .fnl-row { flex-direction: row; }
    .fnl-input { flex: 1 1 0%; width: auto; }
  }
  .fnl-input::placeholder { color: rgb(245 243 236 / 0.42); }
  /* Autofill paints a light box by default, which blots out the field on the
     dark panel. Keep the fill dark and the text readable. */
  .fnl-input:-webkit-autofill,
  .fnl-input:-webkit-autofill:hover,
  .fnl-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #221c14 inset;
    -webkit-text-fill-color: var(--band-text);
    caret-color: var(--band-text);
    border-radius: var(--radius-btn);
  }
  .fnl-btn {
    height: 3.5rem;
    border-radius: var(--radius-btn);
    background: var(--color-accent-cta);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-text);
    border: none;
    cursor: pointer;
    padding: 0 1.25rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s, background-color 0.15s;
  }
  .fnl-btn:hover { background: var(--color-accent-cta-hi); }

  .fnl-hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .fnl-consent {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0.75rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--band-muted);
    cursor: pointer;
    text-align: left;
  }
  .fnl-consent a {
    color: var(--band-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .fnl-consent input[type='checkbox'] {
    appearance: none;
    -webkit-appearance: none;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1.5px solid rgb(245 243 236 / 0.35);
    background: rgb(255 255 255 / 0.06);
    display: inline-grid;
    place-content: center;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .fnl-consent input[type='checkbox']:hover { border-color: rgb(245 243 236 / 0.6); }
  .fnl-consent input[type='checkbox']:checked {
    background: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
  }
  .fnl-consent input[type='checkbox']:checked::before {
    content: '';
    width: 0.5625rem;
    height: 0.5625rem;
    background: #0c0c0c;
    clip-path: polygon(14% 46%, 0 62%, 40% 100%, 100% 20%, 84% 6%, 38% 68%);
  }
  .fnl-consent input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-accent-cta);
    outline-offset: 2px;
  }

  .fnl-status {
    min-height: 1rem;
    margin: 0.375rem 0 0;
    font-size: 0.75rem;
    color: var(--band-muted);
  }

  .fnl-pending { text-align: left; }
  .fnl-pending-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    border: 1px solid var(--band-border);
    background: var(--band-surface);
    margin-bottom: 0.625rem;
  }
  .fnl-pending-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--band-text);
  }
  .fnl-pending-sub {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--band-muted);
  }
  .fnl-pending-sub span { color: var(--band-text); font-weight: 600; }
</style>
