---
export const links = [
  { label: 'Work', href: '/work' },
  { label: 'AI', href: '/ai-systems' },
  { label: 'Apps', href: '/apps' },
  { label: 'Blog', href: '/insights' },
  { label: 'Contact', href: '/contact' },
  { label: 'About', href: '/about' },
];

const current = Astro.url.pathname;
---

<nav aria-label="Primary navigation">
  <ul class="flex items-center gap-6 list-none m-0 p-0">
    {links.map(({ label, href, external }) => {
      const isActive = !external && (href === '/' ? current === '/' : current.startsWith(href));
      return (
        <li>
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'nav-link text-sm font-medium tracking-wide transition-colors duration-150 pb-0.5',
              isActive
                ? 'text-[var(--color-text)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
            ]}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
