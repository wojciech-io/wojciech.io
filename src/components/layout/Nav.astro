---
export const links = [
  { label: 'Work',       href: '/work',       minWidth: '4rem'   },
  { label: 'AI Systems', href: '/ai-systems', minWidth: '5.5rem' },
  { label: 'Insights',   href: '/insights',   minWidth: '4rem'   },
  { label: 'Tools',      href: '/resources',  minWidth: '3rem'   },
  { label: 'About',      href: '/about',      minWidth: '4rem'   },
  { label: 'Contact',    href: '/contact',    minWidth: '4rem'   },
];

const current = Astro.url.pathname;
---

<nav aria-label="Primary navigation">
  <ul class="flex items-center gap-6 list-none m-0 p-0">
    {links.map(({ label, href, minWidth }) => {
      const isActive = href === '/' ? current === href : current.startsWith(href);
      return (
        <li>
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            style={`min-width:${minWidth};text-align:center`}
            class:list={[
              'nav-link inline-block text-sm font-medium tracking-wide transition-colors duration-150 pb-0.5',
              isActive
                ? 'text-[var(--color-text)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
            ]}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
