---
import { getCollection } from 'astro:content';
import { getPrimaryNavLinks, getLocaleFromPath } from '../../data/uiStrings';
import { compareLabels } from '../../lib/compare';

const current = Astro.url.pathname;
const links = getPrimaryNavLinks(current);
const locale = getLocaleFromPath(current);
const isAr = locale === 'ar';
const hub = compareLabels[locale as keyof typeof compareLabels] ?? compareLabels.en;

/**
 * The Insights item carries a submenu for the comparison hub. It opens on
 * hover and on keyboard focus through `group-hover` and `group-focus-within`,
 * with no script at all: the panel is in the DOM either way, the parent stays
 * a real link to the index, and a reader with JavaScript off loses nothing.
 *
 * The panel sits flush under the header with `pt-3` rather than `top-full
 * mt-3`, so the gap between the link and the panel is inside the hover target.
 * With a margin there, the menu closed as the pointer crossed the gap.
 *
 * Each row carries a line of copy and a count. Two bare links read as an
 * afterthought, and the counts are the part that actually sells the hub:
 * "26 comparisons" says what is behind the link in a way the label cannot.
 * They are counted from the collection so they cannot drift from what is
 * published.
 */
const postsForLocale = await getCollection(
  'insights',
  ({ data, id }) =>
    !data.draft && (locale === 'en' ? !/^[a-z]{2}\//.test(id) : id.startsWith(`${locale}/`))
);
const counts = [
  postsForLocale.length,
  postsForLocale.filter((p) => (p.data.models?.length ?? 0) > 0).length,
];
const notes = [hub.menuInsights, hub.menuCompare];

const isCurrent = (href: string) => (href === '/' ? current === href : current.startsWith(href));
---

<nav aria-label={isAr ? 'التنقّل الرئيسي' : 'Primary navigation'}>
  <ul class="flex items-center gap-6 list-none m-0 p-0">
    {links.map(({ label, href, minWidth, children }) => {
      // A parent counts as active when any of its own pages is open, so
      // /compare/ still lights up Insights in the bar.
      const isActive = isCurrent(href) || (children ?? []).some((c) => isCurrent(c.href));
      const linkClass = [
        'nav-link t-data inline-block transition-colors duration-150 pb-0.5',
        isActive
          ? 'text-[var(--color-text)]'
          : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
      ];

      if (!children?.length) {
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              style={`min-width:${minWidth};text-align:center`}
              class:list={linkClass}
            >
              {label}
            </a>
          </li>
        );
      }

      return (
        <li class="group relative">
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[...linkClass, 'inline-flex items-center gap-1']}
          >
            {label}
            <svg
              class="h-3 w-3 shrink-0 text-[var(--color-text-dim)] transition-transform duration-150 group-hover:translate-y-px group-focus-within:translate-y-px"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <ul class="list-none m-0 w-[21rem] rounded-[var(--radius-card)] border border-[var(--color-border-2)] bg-[var(--color-surface)] p-1.5 shadow-[0_8px_24px_rgb(0_0_0/0.10)]">
              {children.map((child, i) => {
                const active = isCurrent(child.href);
                // The hub is the reason this menu exists, so it reads as the
                // offer rather than the second row of a list.
                const featured = i === 1;
                return (
                  <li>
                    <a
                      href={child.href}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'group/row block rounded-[var(--radius-btn)] px-3 py-2.5 transition-colors duration-150',
                        active
                          ? 'bg-[var(--color-surface-2)]'
                          : 'hover:bg-[var(--color-surface-2)]',
                      ]}
                    >
                      <span class="flex items-baseline justify-between gap-3">
                        <span
                          class:list={[
                            't-data',
                            active || featured
                              ? 'text-[var(--color-text)]'
                              : 'text-[var(--color-text-muted)] group-hover/row:text-[var(--color-text)]',
                          ]}
                        >
                          {child.label}
                        </span>
                        <span
                          class:list={[
                            't-caption shrink-0 tabular-nums',
                            featured
                              ? 'rounded bg-[var(--color-accent-cta)] px-1.5 py-0.5 font-semibold text-[var(--color-accent-text)]'
                              : 'text-[var(--color-text-dim)]',
                          ]}
                        >
                          {counts[i]}
                        </span>
                      </span>
                      <span class="t-caption mt-0.5 block text-[var(--color-text-dim)]">
                        {notes[i]}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      );
    })}
  </ul>
</nav>
