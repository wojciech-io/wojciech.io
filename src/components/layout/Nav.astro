---
interface Props { prefix?: string; }
const { prefix = '' } = Astro.props;

export const links = [
  { label: 'Work',     href: '/work',       pl: 'Projekty',  it: 'Progetti',  minWidth: '4rem'   },
  { label: 'Apps',     href: '/apps',       pl: 'Aplikacje', it: 'App',       minWidth: '4.5rem' },
  { label: 'AI',       href: '/ai-systems', pl: 'AI',        it: 'AI',        minWidth: '1.25rem' },
  { label: 'Insights', href: '/insights',   pl: 'Artykuły',  it: 'Articoli',  minWidth: '4rem'   },
  { label: 'About',    href: '/about',      pl: 'O mnie',    it: 'Chi sono',  minWidth: '4rem'   },
  { label: 'Contact',  href: '/contact',    pl: 'Kontakt',   it: 'Contatti',  minWidth: '4rem'   },
];

const current = Astro.url.pathname;
---

<nav aria-label="Primary navigation">
  <ul class="flex items-center gap-6 list-none m-0 p-0">
    {links.map(({ label, href, external, pl, it, minWidth }) => {
      const dest = external ? href : prefix + href;
      const isActive = !external && (href === '/' ? current === dest + '/' || current === dest : current.startsWith(dest));
      return (
        <li>
          <a
            href={dest}
            data-en={label}
            data-pl={pl}
            data-it={it}
            aria-current={isActive ? 'page' : undefined}
            style={`min-width:${minWidth};text-align:center`}
            class:list={[
              'nav-link inline-block text-sm font-medium tracking-wide transition-colors duration-150 pb-0.5',
              isActive
                ? 'text-[var(--color-text)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
            ]}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
