---
// Site-wide strip above the sticky header: countdown to 25 November. Scrolls away,
// dismissible (localStorage). Hides itself once the date passes. Bump STORAGE_KEY for a new drop.
import { getLocaleFromPath } from '../../data/uiStrings';
import { COUNTDOWN_COPY } from '../../data/countdown';
import Icon from '../ui/Icon.astro';

const STORAGE_KEY = 'wio-anno-countdown-24-nov';
// The homepage carries the full countdown band, so the strip is for every other page.
const isHome = /^\/([a-z]{2}\/)?$/.test(Astro.url.pathname);
const locale = getLocaleFromPath(Astro.url.pathname);
const c = COUNTDOWN_COPY[locale] ?? COUNTDOWN_COPY.en;
const closeLabel = locale === 'pl' ? 'Zamknij' : locale === 'de' ? 'Schließen' : locale === 'es' ? 'Cerrar' : locale === 'it' ? 'Chiudi' : locale === 'jp' ? '閉じる' : locale === 'dk' ? 'Luk' : locale === 'no' ? 'Lukk' : locale === 'ar' ? 'إغلاق' : 'Dismiss';
---

{!isHome && (
<aside
  id="wio-announcement"
  data-anno-key={STORAGE_KEY}
  data-countdown-strip
  class="relative border-b border-[var(--color-border)] bg-[var(--color-surface-2)]"
  aria-label={c.label}
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="t-caption flex items-center justify-center gap-3 py-2 pr-8 text-center text-[var(--color-text-muted)]">
      <span class="inline-flex shrink-0 items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-cta)]" style="box-shadow:0 0 10px rgb(235 255 0 / 0.6);" aria-hidden="true"></span>
        <span class="t-label text-[var(--color-accent-hi)]">{c.date}</span>
      </span>
      <span>{c.strip}</span>
      <span class="hidden sm:inline font-semibold text-[var(--color-text)]" style="font-family:var(--font-mono);font-variant-numeric:tabular-nums;" data-cd-strip aria-hidden="true"></span>
    </div>
  </div>
  <button
    type="button"
    id="wio-announcement-close"
    class="t-button absolute right-3 top-1/2 -translate-y-1/2 grid h-6 w-6 place-items-center rounded-[var(--radius-btn)] text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]"
    aria-label={closeLabel}
  >
    <Icon name="close" class="h-3 w-3" />
  </button>
</aside>
)}

<script is:inline>
  // Hide synchronously if previously dismissed (runs during parse, before paint).
  (function () {
    try {
      var el = document.getElementById('wio-announcement');
      if (el && localStorage.getItem(el.dataset.annoKey || '') === '1') {
        el.style.display = 'none';
      }
    } catch (_) {}
  })();
</script>

<script>
  function initAnnouncement() {
    const el = document.getElementById('wio-announcement');
    const btn = document.getElementById('wio-announcement-close');
    if (!el || !btn) return;
    const key = el.dataset.annoKey || '';
    try {
      if (localStorage.getItem(key) === '1') { el.style.display = 'none'; return; }
    } catch (_) {}
    el.style.display = '';
    btn.addEventListener('click', () => {
      el.style.display = 'none';
      try { localStorage.setItem(key, '1'); } catch (_) {}
    });
  }
  initAnnouncement();
  document.addEventListener('astro:page-load', initAnnouncement);
</script>

<script>
  import { COUNTDOWN_TARGET } from '../../data/countdown';

  let stripTimer = 0;
  const initStripClock = () => {
    window.clearInterval(stripTimer);
    const strip = document.getElementById('wio-announcement');
    const out = strip?.querySelector<HTMLElement>('[data-cd-strip]');
    if (!strip || !out) return;
    const end = new Date(COUNTDOWN_TARGET).getTime();
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const left = end - Date.now();
      if (left <= 0) {
        window.clearInterval(stripTimer);
        strip.style.display = 'none';
        return;
      }
      const s = Math.floor(left / 1000);
      out.textContent = `${Math.floor(s / 86400)}d ${pad(Math.floor((s % 86400) / 3600))}h ${pad(Math.floor((s % 3600) / 60))}m ${pad(s % 60)}s`;
    };
    tick();
    stripTimer = window.setInterval(tick, 1000);
  };
  initStripClock();
  document.addEventListener('astro:page-load', initStripClock);
</script>
