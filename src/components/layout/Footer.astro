---
import { SITE } from '../../data/site';
import { getUiStringsForPath, getLocaleFromPath, localizeHref } from '../../data/uiStrings';

const year = new Date().getFullYear();

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
const locale = getLocaleFromPath(pathname);

const contactHref = localizeHref('/contact/', locale);

const nav = [
  { label: t.nav.work,       href: localizeHref('/work/',       locale), desc: 'Selected proof and case studies' },
  { label: t.nav.aiSystems,  href: localizeHref('/ai-systems/', locale), desc: 'Agents, workflows, and automation' },
  { label: t.nav.insights,   href: localizeHref('/insights/',   locale), desc: 'Writing on GTM, AI, and product' },
  { label: t.nav.tools,      href: '/resources/',                        desc: 'Free tools, templates, and starter packs' },
  { label: t.nav.about,      href: localizeHref('/about/',      locale), desc: 'Operator profile and background' },
  { label: 'Bites',          href: '/bites/',                            desc: 'Free Claude Code tools you can take and run' },
  { label: t.nav.contact,    href: contactHref,                          desc: 'Book a call or send a message' },
];

// Writing column lists individual EN articles + a "see all" entry. Article URLs
// stay canonical (EN) for now — only the "see all" link is locale-prefixed.
const writing = [
  { label: 'CRM-first AI adoption',      href: '/insights/crm-first-ai-adoption/',  desc: 'Why CRM hygiene beats prompt-first AI rollouts' },
  { label: 'Claude Code GTM Starter',    href: '/insights/claude-code-vs-clay/',    desc: 'Four-layer AI outbound system without enrichment tools' },
  { label: 'Claude Code in client GTM',  href: '/insights/claude-code-client-gtm/', desc: 'How I use Claude Code inside real client engagements' },
  { label: 'AI stack in production',     href: '/insights/ai-production-stack/',    desc: 'Every AI tool in active use: what earned its place' },
  { label: t.footer.allWriting,          href: localizeHref('/insights/', locale),  desc: 'AI GTM systems, agent tooling, operator playbooks' },
];

const network = [
  { label: 'Apps & workspace', href: SITE.appUrl,         desc: 'app.wojciech.io: apps, CV, stack' },
  { label: 'AI Espresso',      href: SITE.subscribeUrl,   desc: 'subscribe.wojciech.io: newsletter on AI and GTM' },
  { label: 'Audio AI course',  href: 'https://academy.wojciech.io', desc: 'academy.wojciech.io: audio-first AI course' },
  { label: 'NotchCue',         href: SITE.notchUrl,       desc: 'notch.wojciech.io: macOS teleprompter app' },
  { label: 'GrowthHub',        href: 'https://gh.wojciech.io', desc: 'gh.wojciech.io: operator demand & revenue dashboard' },
];

const connect = [
  {
    label: 'LinkedIn',
    href: SITE.linkedin,
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: SITE.github,
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: 'X / Twitter',
    href: SITE.twitter,
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    label: 'Substack',
    href: SITE.substack,
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  },
  {
    label: 'Subscribe',
    href: '/subscribe/',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  {
    label: 'RSS feed',
    href: '/rss.xml',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>`,
  },
];
---

<footer class="mt-auto w-full border-t border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto w-full max-w-6xl px-6">

    <!-- Main grid: 2-col on mobile, 4-col on sm, 5-col on lg -->
    <div class="py-10 sm:py-12">

      <!-- Brand row (full width on all breakpoints) -->
      <div class="mb-8 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-8 lg:hidden">
        <div>
          <a href="/" class="mb-3 inline-flex items-center gap-0 no-underline">
            <span class="text-base font-bold text-[var(--color-text)]">wojciech</span>
            <span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[10px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
          </a>
          <p class="text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            {t.footer.brandTagline}
          </p>
        </div>
        <a href={contactHref} class="self-start text-[12px] font-medium text-[var(--color-accent-hi)] underline underline-offset-2 hover:text-[var(--color-text)] transition-colors whitespace-nowrap">
          {t.footer.getInTouch}
        </a>
      </div>

      <!-- Desktop brand (hidden on mobile/tablet) + 4 nav columns -->
      <div class="hidden lg:grid lg:grid-cols-[180px_1fr_1.4fr_1fr_1fr] lg:gap-x-8 lg:items-start">

        <!-- Brand column (desktop only) -->
        <div>
          <a href="/" class="mb-4 inline-flex items-center gap-0 no-underline">
            <span class="text-base font-bold text-[var(--color-text)]">wojciech</span>
            <span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[10px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
          </a>
          <p class="mb-5 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            {t.footer.brandTagline}
          </p>
          <a href={contactHref} class="text-[11px] text-[var(--color-text-dim)] underline underline-offset-2 hover:text-[var(--color-text)] transition-colors">
            {t.footer.getInTouch}
          </a>
        </div>

        <!-- Pages -->
        <div>
          <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pages</p>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {nav.map(({ label, href, soon }) => (
              <li class="flex items-center gap-2">
                <a
                  href={soon ? undefined : href}
                  aria-disabled={soon ? 'true' : undefined}
                  class={`text-[13px] no-underline transition-colors ${soon ? 'text-[var(--color-text-dim)] pointer-events-none cursor-default' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
                >{label}</a>
                {soon && <span class="rounded px-1 py-px text-[9px] font-semibold uppercase tracking-wider bg-[var(--color-surface-2)] text-[var(--color-text)]">soon</span>}
              </li>
            ))}
          </ul>
        </div>

        <!-- Writing -->
        <div>
          <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Writing</p>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {writing.map(({ label, href }) => (
              <li>
                <a href={href} class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Network -->
        <div>
          <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Network</p>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {network.map(({ label, href, soon }) => (
              <li class="flex items-center gap-2">
                <a
                  href={soon ? undefined : href}
                  target={soon ? undefined : '_blank'}
                  rel={soon ? undefined : 'noopener noreferrer'}
                  aria-disabled={soon ? 'true' : undefined}
                  class={`text-[13px] no-underline transition-colors ${soon ? 'text-[var(--color-text-dim)] pointer-events-none cursor-default' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
                >{label}</a>
                {soon && <span class="rounded px-1 py-px text-[9px] font-semibold uppercase tracking-wider bg-[var(--color-surface-2)] text-[var(--color-text)]">soon</span>}
              </li>
            ))}
          </ul>
        </div>

        <!-- Connect -->
        <div>
          <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Connect</p>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {connect.map(({ label, href, icon }) => (
              <li>
                <a
                  href={href}
                  target={href.startsWith('http') ? '_blank' : undefined}
                  rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="flex items-center gap-2 text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
                >
                  <span class="shrink-0 opacity-60" set:html={icon} />
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Mobile / tablet nav: 2-column grid -->
      <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 lg:hidden">

        <!-- Pages -->
        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pages</p>
          <ul class="m-0 list-none space-y-2 p-0">
            {nav.map(({ label, href, soon }) => (
              <li class="flex items-center gap-1.5">
                <a
                  href={soon ? undefined : href}
                  aria-disabled={soon ? 'true' : undefined}
                  class={`text-[13px] no-underline transition-colors ${soon ? 'text-[var(--color-text-dim)] pointer-events-none cursor-default' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
                >{label}</a>
                {soon && <span class="rounded px-1 py-px text-[9px] font-semibold uppercase tracking-wider bg-[var(--color-surface-2)] text-[var(--color-text)]">soon</span>}
              </li>
            ))}
          </ul>
        </div>

        <!-- Connect -->
        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Connect</p>
          <ul class="m-0 list-none space-y-2 p-0">
            {connect.map(({ label, href, icon }) => (
              <li>
                <a
                  href={href}
                  target={href.startsWith('http') ? '_blank' : undefined}
                  rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="flex items-center gap-1.5 text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
                >
                  <span class="shrink-0 opacity-60" set:html={icon} />
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Writing -->
        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Writing</p>
          <ul class="m-0 list-none space-y-2 p-0">
            {writing.map(({ label, href }) => (
              <li>
                <a href={href} class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Network -->
        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Network</p>
          <ul class="m-0 list-none space-y-2 p-0">
            {network.map(({ label, href, soon }) => (
              <li class="flex items-center gap-1.5">
                <a
                  href={soon ? undefined : href}
                  target={soon ? undefined : '_blank'}
                  rel={soon ? undefined : 'noopener noreferrer'}
                  aria-disabled={soon ? 'true' : undefined}
                  class={`text-[13px] no-underline transition-colors ${soon ? 'text-[var(--color-text-dim)] pointer-events-none cursor-default' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
                >{label}</a>
                {soon && <span class="rounded px-1 py-px text-[9px] font-semibold uppercase tracking-wider bg-[var(--color-surface-2)] text-[var(--color-text)]">soon</span>}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-border)] py-4 text-[11px] text-[var(--color-text-dim)]">
      <p>© {year} Wojciech Łuszczyński · <a href="https://wojciech.io" class="hover:text-[var(--color-text)] transition-colors">wojciech.io</a></p>
      <p>{t.footer.bottomTagline}</p>
    </div>
  </div>
</footer>
