---
import { SITE } from '../../data/site';

const year = new Date().getFullYear();

const social = [
  {
    label: 'Website',
    pathD: 'M12 22a10 10 0 100-20 10 10 0 000 20zM2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z',
    href: SITE.url,
    fill: 'none',
  },
  {
    label: 'LinkedIn',
    pathD: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z',
    href: SITE.linkedin,
    fill: 'currentColor',
  },
  {
    label: 'GitHub',
    pathD: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22',
    href: SITE.github,
    fill: 'none',
  },
  {
    label: 'Twitter',
    pathD: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    href: SITE.twitter,
    fill: 'currentColor',
  },
  {
    label: 'Substack',
    pathD: 'M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z',
    href: SITE.substack,
    fill: 'currentColor',
  },
  {
    label: 'Medium',
    pathD: 'M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z',
    href: SITE.medium,
    fill: 'currentColor',
  },
];
---

<footer class="mt-auto w-full border-t border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-2.5 px-6 py-[18px]">
    <p class="flex-[1_1_320px] text-[11px] font-medium leading-none text-[var(--color-text-dim)]">
      © {year} <span class="font-bold text-[var(--color-text)]">wojciech</span><span class="ml-1 inline-flex items-center justify-center rounded-full bg-[var(--color-accent-cta)] w-[18px] h-[18px] text-[8px] font-bold text-[var(--color-accent-text)] translate-y-[1px]">AI</span>
    </p>

    <nav aria-label="Social links" class="max-[720px]:w-full">
      <ul class="m-0 ml-auto flex list-none flex-wrap items-center justify-end gap-1.5 p-0 max-[720px]:ml-0 max-[720px]:w-full max-[720px]:justify-between">
        {social.map(({ label, href, pathD, fill }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              title={label}
              class="grid h-7 w-7 place-items-center rounded-[7px] border border-[var(--color-border)] bg-[rgb(var(--color-surface-rgb)/0.55)] text-[var(--color-text-dim)] no-underline transition-colors hover:border-[var(--color-accent)]/35 hover:bg-[var(--color-accent)]/10 hover:text-[var(--color-text)]"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-[13px] w-[13px]"
                fill={fill}
                stroke={fill === 'none' ? 'currentColor' : undefined}
                stroke-width={fill === 'none' ? '2' : undefined}
                stroke-linecap={fill === 'none' ? 'round' : undefined}
                stroke-linejoin={fill === 'none' ? 'round' : undefined}
                aria-hidden="true"
              >
                <path d={pathD} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
