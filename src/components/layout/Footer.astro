---
const year = new Date().getFullYear();

const social = [
  {
    label: 'LinkedIn',
    pathD: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    href: 'https://linkedin.com/in/wojciechluszczynski',
  },
  {
    label: 'X / Twitter',
    pathD: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    href: 'https://x.com/wojciechluszcz',
  },
  {
    label: 'GitHub',
    pathD: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
    href: 'https://github.com/wojciechluszczynski',
  },
  {
    label: 'Medium',
    pathD: 'M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z',
    href: 'https://medium.com/@wluszczynski',
  },
  {
    label: 'Substack',
    pathD: 'M22.539 8.242H1.46V6.256h21.08v1.986zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v1.986h21.08V0z',
    href: 'https://substack.com/@wojciechluszczynski',
  },
];
---

<footer class="relative mt-auto overflow-hidden border-t border-[var(--color-border)]">
  <div class="pointer-events-none absolute -left-24 -top-24 h-[320px] w-[520px] rounded-full bg-[var(--color-accent-lo)]/10 blur-[120px]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-6 py-10">
    <div class="grid gap-10 border-b border-[var(--color-border)] pb-9 lg:grid-cols-[1fr_auto] lg:items-start">
      <div class="max-w-xl">
        <a href="/" class="group mb-4 inline-flex items-baseline gap-0">
          <span class="text-base font-semibold tracking-tight text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-hi)]">wojciech</span><span class="text-base font-semibold tracking-tight text-[var(--color-accent)] transition-colors group-hover:text-[var(--color-accent-hi)]">.io</span>
        </a>

        <p class="text-2xl font-semibold leading-tight tracking-tight md:text-3xl">
          <span class="text-[var(--color-text)]">Build revenue systems</span><br />
          <span class="text-[var(--color-text-muted)]">that compound.</span>
        </p>

        <p class="mt-4 max-w-md text-sm leading-relaxed text-[var(--color-text-muted)]">
          GTM strategy, AI-native workflows, and shipped product systems for B2B SaaS teams that need execution, not another deck.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {['15+ years B2B SaaS', 'EU / UK / US / LATAM', 'Strategy -> build -> ship'].map((item) => (
            <span class="rounded-full border border-[var(--color-border-2)] bg-[var(--color-surface)] px-3 py-1.5 text-[11px] font-medium text-[var(--color-text-muted)]">{item}</span>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact#book-call" class="btn-press rounded-[var(--radius-btn)] bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] transition-colors hover:bg-[var(--color-accent-hi)]">
            Book a call
          </a>
          <a href="/work" class="btn-press rounded-[var(--radius-btn)] border border-[var(--color-border-2)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)]/50 hover:text-[var(--color-accent-hi)]">
            See work
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-3 md:text-right lg:justify-items-end lg:gap-x-16">
        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pages</p>
          <ul class="space-y-1.5">
            <li><a href="/work" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Work</a></li>
            <li><a href="/ai-systems" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">AI Systems</a></li>
            <li><a href="/insights" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Insights</a></li>
            <li><a href="/about" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">About</a></li>
            <li><a href="/contact" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Contact</a></li>
            <li><a href="/subscribe" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Subscribe</a></li>
          </ul>
        </div>

        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Projects</p>
          <ul class="space-y-1.5">
            <li><a href="https://relora-jet.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Relora</a></li>
            <li><a href="https://ads-assistant-three.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">AdsAI</a></li>
            <li><a href="https://camper-rental-weld.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Kamperownia</a></li>
            <li><a href="https://notch.wojciech.io/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">NotchCue</a></li>
          </ul>
        </div>

        <div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Connect</p>
          <ul class="space-y-1.5">
            <li><a href="/contact#book-call" class="text-xs font-medium text-[var(--color-accent-hi)] transition-colors hover:text-[var(--color-text)]">Book a call -></a></li>
            <li><a href="https://linkedin.com/in/wojciechluszczynski" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">LinkedIn</a></li>
            <li><a href="https://x.com/wojciechluszcz" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">X / Twitter</a></li>
            <li><a href="https://medium.com/@wluszczynski" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Medium</a></li>
            <li><a href="https://substack.com/@wojciechluszczynski" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">Substack</a></li>
            <li><a href="https://github.com/wojciechluszczynski" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text)]">GitHub</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="grid gap-4 pt-6 md:grid-cols-[1fr_auto] md:items-center">
      <nav aria-label="Social links">
        <ul class="m-0 flex list-none flex-wrap items-center gap-4 p-0">
          {social.map(({ label, href, pathD }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="block text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-accent)]">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                  <path d={pathD} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-wrap items-center gap-5 text-xs text-[var(--color-text-dim)] md:justify-end">
        <span>© {year} Wojciech Łuszczyński</span>
        <a href="/privacy" class="transition-colors hover:text-[var(--color-text-muted)]">Privacy</a>
      </div>
    </div>
  </div>
</footer>
