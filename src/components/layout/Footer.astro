---
import { SITE } from '../../data/site';
import { getUiStringsForPath, getLocaleFromPath, localizeHref } from '../../data/uiStrings';
import FooterNewsletter from './FooterNewsletter.astro';

const year = new Date().getFullYear();

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
const locale = getLocaleFromPath(pathname);

// Legal links: PL gets its localized pages, every other locale falls back to
// the EN policies (both are noindex, single source of legal facts).
const isPL = locale === 'pl';
const privacyHref = isPL ? '/pl/privacy/' : '/privacy/';
const termsHref = isPL ? '/pl/regulamin/' : '/terms/';
const privacyLabel = isPL ? 'Prywatność' : 'Privacy';
const termsLabel = isPL ? 'Regulamin' : 'Terms';

// /subscribe has the full sign-up band above the fold; a second form in the
// footer there would compete with it.
const showNewsletter = !pathname.startsWith('/subscribe');

// Machine-readable identity for the newsletter, on every page. Search
// engines and LLMs get the what/who/where without parsing the band markup.
const espressoSchema = {
  '@context': 'https://schema.org',
  '@type': 'Periodical',
  name: 'AI Espresso',
  description:
    'A free daily newsletter by Wojciech Łuszczyński. Three stories on AI models, agents, and GTM systems every weekday morning, each with a why it matters, readable in three minutes.',
  url: SITE.url + '/subscribe/',
  inLanguage: 'en',
  publisher: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: SITE.url + '/' },
};

const contactHref = localizeHref('/contact/', locale);
const insightsHref = locale === 'pl' ? '/pl/insights/' : locale === 'ar' ? '/ar/insights/' : '/insights/';

const isAr = locale === 'ar';
const statusLabel = isAr ? 'حالة الأنظمة' : locale === 'pl' ? 'Status usług' : 'System status';

// Column headings (not part of UiStrings; localized inline). Three balanced
// columns replace the old Pages/Writing/Network split, where one column carried
// every nav link and the others ran short.
const isPl = locale === 'pl';
const col = {
  explore: isAr ? 'استكشف'  : isPl ? 'Oferta'   : 'Explore',
  site:    isAr ? 'الموقع'   : isPl ? 'Serwis'   : 'Site',
  writing: isAr ? 'المقالات' : isPl ? 'Artykuły' : 'Writing',
};

// GTM/Marketing/Growth lens pages are EN-only. Keep them out of the Arabic
// footer so the column reads fully native (mirrors the header nav, which
// already drops the lenses for non-EN locales).
const lensLinks = isAr ? [] : [
  { label: 'GTM',       href: '/gtm/' },
  { label: 'Marketing', href: '/marketing/' },
  { label: 'Growth',    href: '/growth/' },
];

// Explore: the offering — work plus the three lenses and the AI systems layer.
const explore = [
  { label: t.nav.work,      href: localizeHref('/work/',       locale) },
  ...lensLinks,
  { label: t.nav.aiSystems, href: localizeHref('/ai-systems/', locale) },
];

// Site: reference and utility pages.
const site = [
  { label: t.nav.insights, href: insightsHref },
  // AI Espresso lives at /subscribe. The footer band is an inline form that hides
  // on /subscribe itself, so without this link the page is unreachable from the footer.
  { label: isAr ? 'اشترك' : locale === 'pl' ? 'Subskrybuj' : 'Subscribe', href: '/subscribe/' },
  { label: t.nav.stack,    href: isAr ? '/ar/stack/'     : '/stack/' },
  { label: t.nav.tools,    href: isAr ? '/ar/resources/' : '/resources/' },
  { label: t.nav.about,    href: localizeHref('/about/',    locale) },
  { label: t.nav.contact,  href: contactHref },
];

// The app is the one external product worth a footer link. AI Espresso already
// owns the band above, and the /decks/stack walkthrough is retired now that
// /stack is a full page — so neither is duplicated here.
const appWorkspace = {
  label: isAr ? 'مساحة عمل التطبيق' : isPl ? 'Aplikacja' : 'App workspace',
  href: SITE.appUrl,
};

// PL articles live under /pl/insights/; AR article cards stay EN (per the AR
// content rule), so AR keeps the /insights/ URLs.
const writingBase = isPl ? '/pl/insights' : '/insights';

/* Article titles per locale, in the order of `writingSlugs` below.
 *
 * A nested ternary carried these while only PL and AR were translated; every
 * other locale silently fell through to English, so a German visitor read a
 * German footer with four English headlines in it. A table makes a missing
 * locale visible instead of hiding it behind a fallback.
 *
 * "AI", "GTM", "CRM" and "Claude Code" stay untranslated everywhere: that is
 * the convention the rest of the site already follows (the DE nav says
 * "AI-Systeme", IT "Sistemi AI", ES "Sistemas AI", JP "AIシステム"), and they
 * are how these things are known in each market.
 */
const writingTitles: Record<string, [string, string, string, string]> = {
  en: ['CRM-first AI adoption', 'Claude Code GTM Starter', 'Claude Code in client GTM', 'AI stack in production'],
  pl: ['Wdrażanie AI: CRM-first', 'GTM z Claude Code', 'Claude Code w GTM u klientów', 'Stos AI w produkcji'],
  de: ['AI-Einführung, CRM zuerst', 'Claude Code GTM Starter', 'Claude Code im Kunden-GTM', 'AI-Stack in Produktion'],
  dk: ['AI-adoption, CRM først', 'Claude Code GTM Starter', 'Claude Code i kunders GTM', 'AI-stak i produktion'],
  no: ['AI-adopsjon, CRM først', 'Claude Code GTM Starter', 'Claude Code i kunders GTM', 'AI-stack i produksjon'],
  jp: ['CRMファーストのAI導入', 'Claude Code GTMスターター', '顧客のGTMでのClaude Code', '本番環境のAIスタック'],
  it: ["Adozione dell'AI, prima il CRM", 'Claude Code GTM Starter', 'Claude Code nel GTM dei clienti', 'AI stack in produzione'],
  es: ['Adopción de AI, primero el CRM', 'Claude Code GTM Starter', 'Claude Code en el GTM de clientes', 'Stack de AI en producción'],
  ar: ['تبنّي الذكاء الاصطناعي بنهج CRM أولًا', 'الانطلاق في GTM مع Claude Code', 'Claude Code في GTM لدى العملاء', 'حزمة الذكاء الاصطناعي في الإنتاج'],
};

const writingSlugs = [
  'crm-first-ai-adoption',
  'claude-code-vs-clay',
  'claude-code-client-gtm',
  'ai-production-stack',
] as const;

const titles = writingTitles[locale] ?? writingTitles.en;
const writing = [
  ...writingSlugs.map((slug, i) => ({ label: titles[i], href: `${writingBase}/${slug}/` })),
  { label: t.footer.allWriting, href: insightsHref },
];

const connect = [
  {
    label: 'LinkedIn',
    href: SITE.linkedin,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: SITE.github,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: 'X',
    href: SITE.twitter,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    label: 'Substack',
    href: SITE.substack,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  },
  {
    label: 'RSS',
    href: '/rss.xml',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="6.75" cy="17.25" r="1.65" fill="currentColor"/><path d="M5.25 11.15C9.45 11.15 12.85 14.55 12.85 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5.25 5.25C12.7 5.25 18.75 11.3 18.75 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5.25 8.25C11.05 8.25 15.75 12.95 15.75 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".32"/></svg>`,
  },
];
---

<footer class="site-footer relative mt-auto w-full overflow-hidden bg-[var(--color-ink)] text-[var(--color-ink-text)]">
  <div class="footer-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="footer-glow pointer-events-none absolute -top-48 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-6">

    {showNewsletter && <FooterNewsletter />}

    <!-- Closing statement and the one ask -->
    <div class="flex flex-col gap-8 border-b border-[var(--color-ink-border)] py-14 md:flex-row md:items-end md:justify-between md:py-20">
      <p class="t-h2 max-w-2xl text-[var(--color-ink-text)]">{t.footer.brandTagline}</p>
      <div class="flex flex-wrap gap-3 md:shrink-0">
        <a
          href={contactHref}
          class="t-button btn-press inline-flex items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-6 py-3.5 text-[var(--color-accent-text)] no-underline transition-colors hover:bg-[var(--color-accent-cta-hi)]"
        >
          {t.footer.getInTouch}
        </a>
        <a
          href={appWorkspace.href}
          target="_blank"
          rel="noopener noreferrer"
          class="t-button btn-press inline-flex items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-ink-border)] px-6 py-3.5 text-[var(--color-ink-text)] no-underline transition-colors hover:border-[var(--color-ink-text)]"
        >
          {appWorkspace.label}
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="rtl-flip-x"><path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Brand and three link columns, one layout at every width -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:grid-cols-4 md:gap-x-10">
      <div class="col-span-2 md:col-span-1 flex flex-col gap-5">
        <a href="/" dir="ltr" class="wordmark-brand inline-flex items-center gap-0 self-start no-underline group">
          <span class="t-data font-semibold text-[var(--color-ink-text)]">wojciech</span>
          <span class="obs-mono ml-0.5 inline-flex h-5 w-5 items-center justify-center rounded-[6px] bg-[var(--color-accent-cta)] text-[8px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
        </a>
        <div class="-ml-2 flex items-center gap-1">
          {connect.map(({ label, href, icon }) => (
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={label}
              class="inline-flex h-9 w-9 items-center justify-center rounded-md text-[var(--color-ink-muted)] no-underline transition-colors hover:bg-[var(--color-ink-2)] hover:text-[var(--color-ink-text)]"
            >
              <span class="inline-flex items-center" set:html={icon} />
            </a>
          ))}
        </div>
      </div>

      {[
        { heading: col.explore, links: explore },
        { heading: col.site, links: site },
        { heading: col.writing, links: writing },
      ].map(({ heading, links }, i) => (
        <nav aria-label={heading} class={i === 2 ? 'col-span-2 md:col-span-1' : ''}>
          <p class="t-label mb-5 text-[var(--color-accent-cta)]">{heading}</p>
          <ul class="m-0 list-none space-y-3 p-0">
            {links.map(({ label, href }) => (
              <li>
                <a href={href} class="t-small text-[var(--color-ink-muted)] no-underline transition-colors hover:text-[var(--color-ink-text)]">{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col gap-3 border-t border-[var(--color-ink-border)] py-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <p class="t-caption whitespace-nowrap text-[var(--color-ink-muted)]">&copy; {year} Wojciech Łuszczyński</p>
        <nav class="t-caption flex items-center gap-x-5" aria-label={isPL ? 'Informacje prawne' : 'Legal'}>
          <a href={privacyHref} class="text-[var(--color-ink-muted)] no-underline transition-colors hover:text-[var(--color-ink-text)]">{privacyLabel}</a>
          <a href={termsHref} class="text-[var(--color-ink-muted)] no-underline transition-colors hover:text-[var(--color-ink-text)]">{termsLabel}</a>
        </nav>
      </div>
      <a href="/status/" class="t-caption inline-flex items-center gap-2 self-start text-[var(--color-ink-muted)] no-underline transition-colors hover:text-[var(--color-ink-text)] sm:self-auto">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-cta)]" aria-hidden="true"></span>
        {statusLabel}
      </a>
    </div>

    <!-- Oversized wordmark as the last thing on the page: identity, not links. -->
    <p class="footer-mark pointer-events-none select-none" dir="ltr" aria-hidden="true">wojciech.io</p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(espressoSchema)} />
</footer>

<style>
  .footer-grid {
    background-image:
      linear-gradient(to right, var(--color-ink-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-ink-border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
  }
  .footer-glow {
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent-cta) 12%, transparent), transparent 70%);
  }
  .footer-mark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(3.5rem, 15vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin: 0 0 -0.12em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-ink-border);
    text-align: center;
  }
</style>
