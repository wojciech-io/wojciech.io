---
import { SITE } from '../../data/site';

const year = new Date().getFullYear();

const nav = [
  { label: 'Work', href: '/work', desc: 'Selected proof and case studies' },
  { label: 'About', href: '/about', desc: 'Operator profile and background' },
  { label: 'AI Systems', href: '/ai-systems', desc: 'Agents, workflows, and automation' },
  { label: 'Insights', href: '/insights', desc: 'Writing on GTM, AI, and product' },
  { label: 'Contact', href: '/contact', desc: 'Book a call or send a message' },
];

const writing = [
  { label: 'GTM AI Agent', href: '/insights/how-to-build-gtm-ai-agent-outbound-crm', desc: 'Four-layer GTM AI agent for outbound and CRM' },
  { label: 'Framer to Astro Rebuild', href: '/insights/framer-to-astro-build-vs-buy-website-rebuild', desc: 'Build vs buy — migrating from Framer to Astro' },
  { label: 'Booking Engine Architecture', href: '/insights/how-to-build-booking-engine-product-architecture', desc: 'Product architecture for vertical markets' },
  { label: 'All writing →', href: '/insights', desc: '' },
];

const network = [
  { label: 'app.wojciech.io', href: SITE.appUrl, desc: 'Private app workspace — apps, CV, stack' },
  { label: 'subscribe.wojciech.io', href: SITE.subscribeUrl, desc: 'AI Espresso newsletter' },
  { label: 'academy.wojciech.io', href: 'https://academy.wojciech.io', desc: 'Audio-first AI course' },
  { label: 'notch.wojciech.io', href: SITE.notchUrl, desc: 'NotchCue — macOS teleprompter' },
];

const connect = [
  {
    label: 'LinkedIn',
    href: SITE.linkedin,
    desc: 'Wojciech Łuszczyński on LinkedIn',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: SITE.github,
    desc: 'Open-source work and repositories',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: 'X / Twitter',
    href: SITE.twitter,
    desc: 'Short-form notes and links',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    label: 'Substack',
    href: SITE.substack,
    desc: 'Newsletter archive',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  },
  {
    label: 'Subscribe',
    href: '/subscribe',
    desc: 'Operator notes from live builds',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
];
---

<footer class="mt-auto w-full border-t border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto w-full max-w-6xl px-6">

    <!-- Main columns -->
    <div class="grid grid-cols-1 gap-y-8 py-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-10 sm:py-12 md:grid-cols-[1.5fr_1fr_1.5fr_1fr_1fr] md:items-start">

      <!-- Brand column -->
      <div class="sm:col-span-2 md:col-span-1">
        <a href="/" class="mb-4 inline-flex items-center gap-0 no-underline">
          <span class="text-base font-bold text-[var(--color-text)]">wojciech</span>
          <span class="ml-0.5 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[10px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
        </a>
        <p data-en="Wojciech Łuszczyński, GTM architect and AI-native builder. I design and ship revenue systems for B2B SaaS and technology companies." data-pl="Wojciech Łuszczyński, architekt GTM i builder AI-native. Projektuję i wdrażam systemy przychodowe dla firm B2B SaaS i technologicznych." data-it="Wojciech Luszczynski, architetto GTM e builder AI-native. Progetto e realizzo sistemi di revenue per aziende B2B SaaS e tecnologiche." class="mb-5 max-w-[260px] text-[13px] leading-relaxed text-[var(--color-text-muted)]">
          Wojciech Łuszczyński, GTM architect and AI-native builder. I design and ship revenue systems for B2B SaaS and technology companies.
        </p>
        <p class="text-[11px] text-[var(--color-text-dim)]">
          <a href="/contact" data-en="Available for projects" data-pl="Dostępny do projektów" data-it="Disponibile per progetti" class="underline underline-offset-2 hover:text-[var(--color-text)] transition-colors">Available for projects</a>
        </p>
      </div>

      <!-- Pages -->
      <div>
        <p data-en="Pages" data-pl="Strony" data-it="Pagine" class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pages</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {nav.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc}
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Writing -->
      <div>
        <p data-en="Writing" data-pl="Artykuły" data-it="Articoli" class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Writing</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {writing.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc || undefined}
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Network -->
      <div>
        <p data-en="Network" data-pl="Ekosystem" data-it="Ecosistema" class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Network</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {network.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <p data-en="Connect" data-pl="Połącz się" data-it="Connettiti" class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Connect</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {connect.map(({ label, href, desc, icon }) => (
            <li>
              <a
                href={href}
                title={desc}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="flex items-center gap-2 text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                <span class="shrink-0 opacity-70" set:html={icon} />
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-border)] py-5 text-[11px] text-[var(--color-text-dim)]">
      <p>© {year} Wojciech Łuszczyński · <a href="https://wojciech.io" class="hover:text-[var(--color-text)] transition-colors">wojciech.io</a></p>
      <p data-en="GTM architect · AI-native builder" data-pl="Architekt GTM · Builder AI-native" data-it="Architetto GTM · Builder AI-native" class="text-right">
        GTM architect · AI-native builder
      </p>
    </div>
  </div>
</footer>
