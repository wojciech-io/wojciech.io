---
import { SITE } from '../../data/site';
import { getUiStringsForPath, getLocaleFromPath, localizeHref } from '../../data/uiStrings';
import FooterNewsletter from './FooterNewsletter.astro';

const year = new Date().getFullYear();

const pathname = Astro.url.pathname;
const t = getUiStringsForPath(pathname);
const locale = getLocaleFromPath(pathname);

// /subscribe has the full sign-up band above the fold; a second form in the
// footer there would compete with it.
const showNewsletter = !pathname.startsWith('/subscribe');

// Machine-readable identity for the newsletter, on every page. Search
// engines and LLMs get the what/who/where without parsing the band markup.
const espressoSchema = {
  '@context': 'https://schema.org',
  '@type': 'Periodical',
  name: 'AI Espresso',
  description:
    'A free daily newsletter by Wojciech Łuszczyński. Three stories on AI models, agents, and GTM systems every weekday morning, each with a why it matters, readable in three minutes.',
  url: SITE.url + '/subscribe/',
  inLanguage: 'en',
  publisher: { '@type': 'Person', name: 'Wojciech Łuszczyński', url: SITE.url + '/' },
};

const contactHref = localizeHref('/contact/', locale);
const insightsHref = locale === 'pl' ? '/pl/insights/' : locale === 'ar' ? '/ar/insights/' : '/insights/';

const isAr = locale === 'ar';

// Column headings (not part of UiStrings; localized inline).
const col = {
  pages:   isAr ? 'الصفحات' : 'Pages',
  writing: isAr ? 'المقالات' : 'Writing',
  network: isAr ? 'الشبكة'  : 'Network',
};

// GTM/Marketing/Growth lens pages are EN-only. Keep them out of the Arabic
// footer so the column reads fully native (mirrors the header nav, which
// already drops the lenses for non-EN locales).
const lensLinks = isAr ? [] : [
  { label: 'GTM',       href: '/gtm/' },
  { label: 'Marketing', href: '/marketing/' },
  { label: 'Growth',    href: '/growth/' },
];

const nav = [
  { label: t.nav.work,       href: localizeHref('/work/',       locale) },
  ...lensLinks,
  { label: t.nav.aiSystems,  href: localizeHref('/ai-systems/', locale) },
  { label: t.nav.insights,   href: insightsHref },
  { label: t.nav.tools,      href: isAr ? '/ar/resources/' : '/resources/' },
  { label: t.nav.stack,      href: isAr ? '/ar/stack/'     : '/stack/' },
  { label: t.nav.about,      href: localizeHref('/about/',      locale) },
  { label: t.nav.contact,    href: contactHref },
];

const writing = [
  { label: isAr ? 'تبنّي الذكاء الاصطناعي بنهج CRM أولًا' : 'CRM-first AI adoption',     href: '/insights/crm-first-ai-adoption/' },
  { label: isAr ? 'الانطلاق في GTM مع Claude Code'         : 'Claude Code GTM Starter',   href: '/insights/claude-code-vs-clay/' },
  { label: isAr ? 'Claude Code في GTM لدى العملاء'         : 'Claude Code in client GTM', href: '/insights/claude-code-client-gtm/' },
  { label: isAr ? 'حزمة الذكاء الاصطناعي في الإنتاج'        : 'AI stack in production',    href: '/insights/ai-production-stack/' },
  { label: t.footer.allWriting,          href: insightsHref },
];

const network = [
  { label: isAr ? 'مساحة عمل التطبيق' : 'App workspace',     href: SITE.appUrl, external: true },
  { label: 'AI Espresso',       href: '/subscribe/' },
  { label: isAr ? 'جولة في الحزمة التقنية' : 'Stack walkthrough', href: '/decks/stack/' },
];

const connect = [
  {
    label: 'LinkedIn',
    href: SITE.linkedin,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: SITE.github,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: 'X',
    href: SITE.twitter,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    label: 'Substack',
    href: SITE.substack,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  },
  {
    label: 'RSS',
    href: '/rss.xml',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="6.75" cy="17.25" r="1.65" fill="currentColor"/><path d="M5.25 11.15C9.45 11.15 12.85 14.55 12.85 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5.25 5.25C12.7 5.25 18.75 11.3 18.75 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5.25 8.25C11.05 8.25 15.75 12.95 15.75 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".32"/></svg>`,
  },
];
---

<footer class="mt-auto w-full border-t border-[var(--color-border)] relative overflow-hidden">
  <!-- Subtle grid overlay like hero sections -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-grid-line)_1px,transparent_1px)] bg-[size:48px_48px] opacity-50" aria-hidden="true" />

  <!-- Accent top-line -->
  <div class="h-px w-full bg-[linear-gradient(90deg,transparent_0%,var(--color-accent-cta)_30%,var(--color-accent-cta)_70%,transparent_100%)] opacity-30" aria-hidden="true" />

  <div class="relative mx-auto w-full max-w-6xl px-6">

    <!-- ═══ AI ESPRESSO BAND ═══ -->
    {showNewsletter && <FooterNewsletter />}

    <!-- ═══ DESKTOP (lg+): brand + 3 columns ═══ -->
    <div class="hidden lg:grid lg:grid-cols-[200px_1.6fr_1.1fr_0.9fr] lg:gap-x-10 lg:items-start py-14">

      <!-- Brand -->
      <div class="flex flex-col gap-5">
        <a href="/" dir="ltr" class="wordmark-brand inline-flex items-center gap-0 no-underline group">
          <span class="obs-mono text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">wojciech</span>
          <span class="obs-mono ml-0.5 inline-flex items-center justify-center h-5 w-5 rounded-[6px] bg-[var(--color-text)] dark:bg-[var(--color-accent-cta)] text-[8px] font-bold leading-none text-[var(--color-bg)] dark:text-[var(--color-accent-text)]">.io</span>
        </a>
        <p class="text-[13px] leading-relaxed text-[var(--color-text-muted)]">
          {t.footer.brandTagline}
        </p>
        <a
          href={contactHref}
          class="mt-1 inline-flex items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border)] bg-[var(--color-glass)] backdrop-blur px-3.5 py-2 text-[12px] font-medium text-[var(--color-text)] no-underline transition-all hover:border-[var(--color-accent-cta)] hover:bg-[var(--color-accent-lo)] self-start"
        >
          {t.footer.getInTouch}
        </a>
      </div>

      <!-- Pages: 7 links flowed into 2 sub-columns so the column height
           matches Writing/Network instead of running far taller. -->
      <nav aria-label={col.pages}>
        <p class="obs-label mb-5">
          {col.pages}
        </p>
        <ul class="m-0 grid grid-flow-col grid-rows-4 list-none gap-x-8 gap-y-3 p-0">
          {nav.map(({ label, href }) => (
            <li>
              <a href={href} class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Writing -->
      <nav aria-label={col.writing}>
        <p class="obs-label mb-5">
          {col.writing}
        </p>
        <ul class="m-0 list-none space-y-3 p-0">
          {writing.map(({ label, href }) => (
            <li>
              <a href={href} class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Network -->
      <nav aria-label={col.network}>
        <p class="obs-label mb-5">
          {col.network}
        </p>
        <ul class="m-0 list-none space-y-3 p-0">
          {network.map(({ label, href, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >{label}</a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <!-- ═══ MOBILE / TABLET (< lg) ═══ -->
    <div class="lg:hidden py-10">

      <!-- Brand -->
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <a href="/" dir="ltr" class="wordmark-brand mb-3 inline-flex items-center gap-0 no-underline">
            <span class="obs-mono text-lg font-semibold text-[var(--color-text)]">wojciech</span>
            <span class="obs-mono ml-0.5 inline-flex items-center justify-center h-5 w-5 rounded-[6px] bg-[var(--color-text)] dark:bg-[var(--color-accent-cta)] text-[8px] font-bold leading-none text-[var(--color-bg)] dark:text-[var(--color-accent-text)]">.io</span>
          </a>
          <p class="text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            {t.footer.brandTagline}
          </p>
        </div>
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-border)] bg-[var(--color-glass)] backdrop-blur px-3.5 py-2 text-[12px] font-medium text-[var(--color-text)] no-underline transition-all hover:border-[var(--color-accent-cta)] hover:bg-[var(--color-accent-lo)] self-start"
        >
          {t.footer.getInTouch}
        </a>
      </div>

      <!-- Nav columns -->
      <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3">
        <nav aria-label={col.pages}>
          <p class="obs-label mb-3">
            {col.pages}
          </p>
          <ul class="m-0 list-none space-y-2 p-0">
            {nav.map(({ label, href }) => (
              <li>
                <a href={href} class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label={col.writing}>
          <p class="obs-label mb-3">
            {col.writing}
          </p>
          <ul class="m-0 list-none space-y-2 p-0">
            {writing.map(({ label, href }) => (
              <li>
                <a href={href} class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]">{label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label={col.network}>
          <p class="obs-label mb-3">
            {col.network}
          </p>
          <ul class="m-0 list-none space-y-2 p-0">
            {network.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class="link-underline text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
                >{label}</a>
              </li>
            ))}
          </ul>
        </nav>

      </div>
    </div>

    <!-- ═══ BOTTOM BAR ═══ -->
    <div class="relative flex items-center justify-between gap-4 border-t border-[var(--color-border)] py-5">
      <p class="text-[11px] text-[var(--color-text-dim)] whitespace-nowrap">
        &copy; {year} Wojciech Łuszczyński
      </p>
      <div class="flex items-center gap-1">
        {connect.map(({ label, href, icon }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={label}
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-text-dim)] no-underline transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text)]"
          >
            <span class="inline-flex items-center" set:html={icon} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(espressoSchema)} />
</footer>

