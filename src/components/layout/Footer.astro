---
import { SITE } from '../../data/site';

const year = new Date().getFullYear();

const nav = [
  { label: 'Work', href: '/work', desc: 'Selected proof and case studies' },
  { label: 'About', href: '/about', desc: 'Operator profile and background' },
  { label: 'AI Systems', href: '/ai-systems', desc: 'Agents, workflows, and automation' },
  { label: 'Insights', href: '/insights', desc: 'Writing on GTM, AI, and product' },
  { label: 'Contact', href: '/contact', desc: 'Book a call or send a message' },
];

const writing = [
  { label: 'How to Build a GTM AI Agent', href: '/insights/how-to-build-gtm-ai-agent-outbound-crm', desc: 'Four-layer GTM AI agent for outbound and CRM' },
  { label: 'Astro and Cloudflare Pages Portfolio Build', href: '/insights/astro-cloudflare-pages-portfolio-ai-workflow', desc: 'How I rebuilt my site with AI workflow' },
  { label: 'How to Build a Booking Engine', href: '/insights/how-to-build-booking-engine-product-architecture', desc: 'Product architecture for vertical markets' },
  { label: 'All writing →', href: '/insights', desc: '' },
];

const connect = [
  { label: 'LinkedIn', href: SITE.linkedin, desc: 'Wojciech Łuszczyński on LinkedIn' },
  { label: 'GitHub', href: SITE.github, desc: 'Open-source work and repositories' },
  { label: 'X / Twitter', href: SITE.twitter, desc: 'Short-form notes and links' },
  { label: 'Substack', href: SITE.substack, desc: 'Newsletter archive' },
  { label: 'Subscribe', href: '/subscribe', desc: 'Operator notes from live builds' },
];
---

<footer class="mt-auto w-full border-t border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto w-full max-w-6xl px-6">

    <!-- Main columns -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 py-12 md:grid-cols-[1.6fr_1fr_1fr_1fr]">

      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="mb-4 inline-flex items-center gap-0 no-underline">
          <span class="text-base font-bold text-[var(--color-text)]">wojciech</span>
          <span class="ml-1 rounded-[var(--radius-btn)] bg-[var(--color-accent-cta)] px-1.5 py-0.5 text-[10px] font-bold leading-none text-[var(--color-accent-text)]">.io</span>
        </a>
        <p class="mb-5 max-w-[260px] text-[13px] leading-relaxed text-[var(--color-text-muted)]">
          Wojciech Łuszczyński — GTM architect and AI-native builder. I design and ship revenue systems for B2B SaaS and technology companies.
        </p>
        <p class="text-[11px] text-[var(--color-text-dim)]">
          Based in Berlin · <a href="/contact" class="underline underline-offset-2 hover:text-[var(--color-text)] transition-colors">Available for projects</a>
        </p>
      </div>

      <!-- Pages -->
      <div>
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Pages</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {nav.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc}
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Writing -->
      <div>
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Writing</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {writing.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc || undefined}
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-dim)]">Connect</p>
        <ul class="m-0 list-none space-y-2.5 p-0">
          {connect.map(({ label, href, desc }) => (
            <li>
              <a
                href={href}
                title={desc}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="text-[13px] text-[var(--color-text-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-border)] py-5 text-[11px] text-[var(--color-text-dim)]">
      <p>© {year} Wojciech Łuszczyński · <a href="https://wojciech.io" class="hover:text-[var(--color-text)] transition-colors">wojciech.io</a></p>
      <p class="text-right">
        GTM architect · AI-native builder · Berlin
      </p>
    </div>
  </div>
</footer>
