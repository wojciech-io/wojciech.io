---
const year = new Date().getFullYear();

const links = [
  { label: 'Work', href: '/work' },
  { label: 'AI Systems', href: '/ai-systems' },
  { label: 'Insights', href: '/insights' },
  { label: 'About', href: '/about' },
  { label: 'Resources', href: '/resources' },
];

const social = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/wojciechluszczynski' },
  { label: 'X / Twitter', href: 'https://x.com/wluszczynski' },
  { label: 'GitHub', href: 'https://github.com/wluszczynski' },
];
---

<footer class="border-t border-[var(--color-border)] mt-auto">
  <div class="mx-auto max-w-6xl px-6 py-12">

    <div class="flex flex-col md:flex-row justify-between gap-8 mb-10">

      <!-- Brand -->
      <div class="max-w-xs">
        <p class="text-sm font-semibold text-[var(--color-text)] mb-2">Wojciech Łuszczyński</p>
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
          Growth operator. GTM architect. AI-native builder.
        </p>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none m-0 p-0">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Social -->
      <nav aria-label="Social links">
        <ul class="flex gap-4 list-none m-0 p-0">
          {social.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent-hi)] transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <div class="border-t border-[var(--color-border)] pt-6 flex flex-col sm:flex-row justify-between gap-3 text-xs text-[var(--color-text-dim)]">
      <p>© {year} Wojciech Łuszczyński. All rights reserved.</p>
      <a href="https://app.wojciech.io/apps" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-muted)] transition-colors">
        app.wojciech.io →
      </a>
    </div>

  </div>
</footer>
