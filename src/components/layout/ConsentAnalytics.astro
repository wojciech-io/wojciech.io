---
// GA4 and PostHog, loaded only after the visitor accepts analytics, plus the
// delegated click tracking for [data-mp-cta] links and outbound links.
// Shared by Layout.astro and the standalone home page so there is exactly one
// consent chokepoint. The data-mp-* attributes are live: do not remove them.
---

<script>
  const GA_ID = 'G-4ED804XJLP';
  const hasAnalyticsConsent = () => localStorage.getItem('cookie-consent') === 'accepted';
  let analyticsModule: Promise<typeof import('../../utils/analytics')> | null = null;
  let googleAnalyticsLoaded = false;

  const initGoogleAnalytics = () => {
    if (googleAnalyticsLoaded) return;
    googleAnalyticsLoaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    const w = window as typeof window & {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    };
    w.dataLayer = w.dataLayer || [];
    // gtag.js reads each dataLayer entry as an `arguments` object, not an
    // array. An arrow function spreading into push() looks equivalent but
    // leaves GA4 uninitialised: the tag loads, no _ga cookie is written and
    // no hit is ever sent. Google's snippet uses `function` + `arguments`
    // for exactly this reason, so keep it verbatim.
    function gtag() {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer!.push(arguments);
    }
    w.gtag = gtag as unknown as (...args: unknown[]) => void;
    gtag('js', new Date());
    gtag('config', GA_ID);
  };

  const loadAnalytics = async () => {
    if (!hasAnalyticsConsent()) return null;
    initGoogleAnalytics();
    analyticsModule ??= import('../../utils/analytics');
    const analytics = await analyticsModule;
    analytics.initAfterConsent();
    return analytics;
  };

  const trackCurrentPage = () => {
    loadAnalytics().then((analytics) => {
      analytics?.trackPageViewed({
        path: window.location.pathname,
        title: document.title,
      });
    });
  };

  setTimeout(trackCurrentPage, 300);
  window.addEventListener('analytics-consent-accepted', trackCurrentPage, { once: true });

  window.addEventListener('wio:outbound-clicked', (event) => {
    const detail = (event as CustomEvent<{
      href?: string;
      original_href?: string;
      label?: string;
      destination_host?: string;
      source_host?: string;
      path?: string;
    }>).detail;
    if (!detail.href) return;
    loadAnalytics().then((analytics) => analytics?.trackOutboundClicked({
      href: detail.href,
      original_href: detail.original_href,
      label: detail.label,
      destination_host: detail.destination_host,
      source_host: detail.source_host,
      path: detail.path,
    }));
  });

  // Track internal CTAs tagged with data-mp-cta globally via event delegation
  document.addEventListener('click', (e) => {
    const a = (e.target as Element)?.closest('a');
    if (!a) return;
    const href = a.getAttribute('href') ?? '';

    // Internal CTAs tagged with data-mp-cta
    const cta = a.dataset.mpCta;
    if (cta) {
      const location = a.dataset.mpLocation ?? 'unknown';
      if (cta === 'newsletter') {
        loadAnalytics().then((analytics) => analytics?.trackNewsletterCtaClicked({ location }));
      } else {
        loadAnalytics().then((analytics) => analytics?.trackCtaClicked({ label: cta, href, location }));
      }
    }
  });
</script>

