---
/* Share row for articles: LinkedIn, X, Threads, Reddit, copy link, and the
   system share sheet where the browser has one (phones). Plain links, no
   third-party scripts or trackers. */
interface Props {
  url: string;
  title: string;
  label?: string;
  copyLabel?: string;
  copiedLabel?: string;
  layout?: 'row' | 'column';
}

const {
  url,
  title,
  label = 'Share',
  copyLabel = 'Copy link',
  copiedLabel = 'Link copied',
  layout = 'row',
} = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const targets = [
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  },
  {
    name: 'X',
    href: `https://x.com/intent/post?url=${u}&text=${t}`,
    icon: '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  },
  {
    name: 'Threads',
    href: `https://www.threads.net/intent/post?text=${t}%20${u}`,
    icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>',
  },
  {
    name: 'Reddit',
    href: `https://www.reddit.com/submit?url=${u}&title=${t}`,
    icon: '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="14.5" rx="7.5" ry="5"/><circle cx="18.5" cy="5.5" r="1.4"/><path d="M12 9.5l1.3-5 3.8.8"/><circle cx="4.9" cy="11.4" r="1.5"/><circle cx="19.1" cy="11.4" r="1.5"/><circle cx="9.3" cy="14" r=".9" fill="currentColor" stroke="none"/><circle cx="14.7" cy="14" r=".9" fill="currentColor" stroke="none"/><path d="M9.6 16.8c1.4.8 3.4.8 4.8 0"/></svg>',
  },
];

const btn =
  'inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-text)] hover:text-[var(--color-text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]';
---

<div class:list={['article-share flex gap-3', layout === 'column' ? 'flex-col items-start' : 'flex-wrap items-center']} data-share-url={url} data-share-title={title}>
  <span class="t-label text-[var(--color-text-dim)]">{label}</span>
  <div class="flex flex-wrap items-center gap-2">
    {targets.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class={btn}
        aria-label={`${label}: ${s.name}`}
        title={s.name}
        data-share-network={s.name.toLowerCase()}
        set:html={s.icon}
      />
    ))}
    <button type="button" class={btn} aria-label={copyLabel} title={copyLabel} data-share-copy data-copied-label={copiedLabel}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    </button>
    <button type="button" class:list={[btn, 'hidden']} aria-label={label} title={label} data-share-native>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
    </button>
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-share-status></span>
</div>

<script>
  const wire = () => {
    document.querySelectorAll<HTMLElement>('.article-share').forEach((root) => {
      if (root.dataset.wired) return;
      root.dataset.wired = '1';
      const url = root.dataset.shareUrl ?? location.href;
      const title = root.dataset.shareTitle ?? document.title;
      const status = root.querySelector<HTMLElement>('[data-share-status]');

      const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          copy.classList.add('is-copied');
          if (status) status.textContent = copy.dataset.copiedLabel ?? 'Link copied';
          setTimeout(() => copy.classList.remove('is-copied'), 1800);
        } catch {
          window.prompt('', url);
        }
      });

      const native = root.querySelector<HTMLButtonElement>('[data-share-native]');
      if (native && typeof navigator.share === 'function' && window.matchMedia('(pointer: coarse)').matches) {
        native.classList.remove('hidden');
        native.addEventListener('click', () => {
          navigator.share({ title, url }).catch(() => {});
        });
      }
    });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .article-share :global(.is-copied) {
    border-color: var(--color-accent-cta);
    background: var(--color-accent-cta);
    color: var(--color-accent-text);
  }
</style>
