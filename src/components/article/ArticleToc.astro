---
/* "On this page" list, built from the rendered MDX headings (h2 only) and set inside the article column.
   It used to be a sticky side rail. The right margin now belongs to the notes that articles hang beside
   their paragraphs, and a list in the column also gives phones a table of contents. The list is open on
   screens wide enough to show it without pushing the article down, closed on a phone. */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  label?: string;
}

const { headings, label = 'On this page' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 2 && (
  <details class="article-toc" data-toc data-pagefind-ignore>
    <summary>{label}</summary>
    <nav aria-label={label}>
      <ol>
        {items.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}

<script>
  const openOnWideScreens = () => {
    const el = document.querySelector<HTMLDetailsElement>('details[data-toc]');
    if (el && matchMedia('(min-width: 640px)').matches) el.open = true;
  };
  openOnWideScreens();
  document.addEventListener('astro:page-load', openOnWideScreens);
</script>

<style>
  .article-toc {
    margin-block: 0 2.25rem;
    border-top: 1px solid var(--color-text);
  }
  .article-toc summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.875rem 0.5rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
  }
  .article-toc summary::-webkit-details-marker { display: none; }
  .article-toc summary::before {
    content: '';
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 1px;
    background: var(--color-accent);
  }
  .article-toc summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .article-toc ol {
    display: grid;
    gap: 0.125rem 2rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    counter-reset: toc;
  }
  @media (min-width: 640px) {
    .article-toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .article-toc li { counter-increment: toc; margin: 0; }
  .article-toc a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    padding-block: 0.3125rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .article-toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-dim);
  }
  .article-toc a:is(:hover, :focus-visible) { color: var(--color-text); }
  .article-toc a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
