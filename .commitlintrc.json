{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
        "copy"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "i18n",
        "seo",
        "academy",
        "growthhub",
        "notch",
        "subscribe",
        "app",
        "insights",
        "ai-systems",
        "about",
        "work",
        "contact",
        "cv",
        "security",
        "ops",
        "agents",
        "test",
        "ci",
        "dev",
        "copy",
        "dx",
        "sprint0",
        "sprint1",
        "sprint2",
        "release",
        "deps"
      ]
    ],
    "subject-case": [0],
    "subject-max-length": [2, "always", 100],
    "header-max-length": [2, "always", 100],
    "body-max-line-length": [0]
  }
}
