---
/**
 * NumberTicker — scroll-triggered animated counter with label.
 * Renders the final value, so it reads correctly without script and under
 * reduced motion; the script only replays the count-up from zero.
 * Usage:
 *   <NumberTicker value={3.2} suffix="x" label="Revenue growth" />
 *   <NumberTicker value={40} prefix="-" suffix="%" label="CAC reduction" />
 *   <NumberTicker value={524} label="Tests passing" />
 */
import '../styles/widgets.css';
import { figLen } from '../lib/figures';

interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  label?: string;
  duration?: number;
  decimals?: number;
}

const {
  value,
  prefix = '',
  suffix = '',
  label,
  duration = 1500,
  decimals = value % 1 !== 0 ? 1 : 0,
} = Astro.props;

const final = `${prefix}${value.toFixed(decimals)}${suffix}`;
const len = figLen(final);
const size = len <= 4 ? 'l' : len <= 6 ? 'm' : undefined;
---

<div
  class="w w-ticker"
  data-ticker
  data-value={value}
  data-prefix={prefix}
  data-suffix={suffix}
  data-duration={duration}
  data-decimals={decimals}
>
  <p class="w-ticker__value" data-size={size}>
    <span data-ticker-value aria-hidden="true">{final}</span>
    <span class="w-vh">{final}</span>
  </p>
  {label && <p class="w-ticker__label">{label}</p>}
</div>

<script>
  let observer: IntersectionObserver | undefined;

  function count(el: HTMLElement) {
    const target = parseFloat(el.dataset.value || '0');
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const duration = parseInt(el.dataset.duration || '1500', 10);
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const display = el.querySelector('[data-ticker-value]')!;

    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease out cubic
      display.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function wireTickers() {
    const fresh = document.querySelectorAll<HTMLElement>('[data-ticker]:not([data-ready])');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);
    observer ??= new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer!.unobserve(entry.target);
          count(entry.target as HTMLElement);
        });
      },
      { threshold: 0.3 },
    );
    fresh.forEach((el) => {
      el.setAttribute('data-ready', '');
      if (still) return; // the final value is already on the page
      const display = el.querySelector('[data-ticker-value]')!;
      display.textContent = `${el.dataset.prefix || ''}${(0).toFixed(parseInt(el.dataset.decimals || '0', 10))}${el.dataset.suffix || ''}`;
      observer!.observe(el);
    });
  }
  wireTickers();
  document.addEventListener('astro:page-load', wireTickers);
</script>
