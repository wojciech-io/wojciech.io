---
/**
 * EmbedDeck — inline mini slide deck within an article.
 * A slide's heading is `heading`, or `title` (the articles write `title`).
 * Usage:
 *   <EmbedDeck slides={[
 *     { heading: "Step 1", body: "Set up the pipeline.", tag: "Setup" },
 *     { heading: "Step 2", body: "Configure agents.",    tag: "Config" },
 *     { heading: "Step 3", body: "Deploy and monitor.",  tag: "Deploy" },
 *   ]} />
 */
import '../styles/widgets.css';

interface Slide {
  heading?: string;
  title?: string;
  body: string;
  tag?: string;
}
interface Props {
  slides: Slide[];
  title?: string;
}

const { slides, title } = Astro.props;
---

<figure class="w w-deck" data-embed-deck>
  {title && <p class="w-eyebrow">{title}</p>}
  <div class="w-deck__stage" aria-live="polite">
    {slides.map((slide, i) => (
      <div class="w-deck__slide" data-deck-slide={i} data-active={i === 0 ? '' : undefined}>
        {slide.tag && <span class="w-pill">{slide.tag}</span>}
        {(slide.heading ?? slide.title) && <p class="w-deck__heading">{slide.heading ?? slide.title}</p>}
        <p class="w-deck__body">{slide.body}</p>
      </div>
    ))}
  </div>
  {slides.length > 1 && (
    <div class="w-deck__bar">
      <button type="button" class="w-deck__btn" data-deck-prev aria-label="Previous slide" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <div class="w-deck__dots">
        {slides.map((_, i) => (
          <button
            type="button"
            class="w-deck__dot"
            data-deck-dot={i}
            aria-label={`Go to slide ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
      <button type="button" class="w-deck__btn" data-deck-next aria-label="Next slide">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
      </button>
    </div>
  )}
</figure>

<script>
  function wireDecks() {
    document.querySelectorAll<HTMLElement>('[data-embed-deck]:not([data-ready])').forEach((deck) => {
      const slides = [...deck.querySelectorAll<HTMLElement>('[data-deck-slide]')];
      const dots = [...deck.querySelectorAll<HTMLElement>('[data-deck-dot]')];
      const prev = deck.querySelector<HTMLButtonElement>('[data-deck-prev]');
      const next = deck.querySelector<HTMLButtonElement>('[data-deck-next]');
      if (!prev || !next) return;
      let current = 0;

      function go(i: number) {
        if (i < 0 || i >= slides.length) return;
        slides[current].removeAttribute('data-active');
        dots[current].removeAttribute('aria-current');
        current = i;
        slides[current].setAttribute('data-active', '');
        dots[current].setAttribute('aria-current', 'true');
        prev!.disabled = current === 0;
        next!.disabled = current === slides.length - 1;
      }

      prev.addEventListener('click', () => go(current - 1));
      next.addEventListener('click', () => go(current + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => go(Number(dot.dataset.deckDot)));
      });
      deck.setAttribute('data-ready', '');
    });
  }
  wireDecks();
  document.addEventListener('astro:page-load', wireDecks);
</script>
