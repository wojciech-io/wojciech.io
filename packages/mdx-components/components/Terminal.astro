---
import '../styles/widgets.css';

interface Props {
  title?: string;
  commands: { cmd: string; output?: string }[];
}

const { title = 'Terminal', commands } = Astro.props;
---

<div class="w">
  <div class="w-win">
    <div class="w-win__bar">
      <span class="w-win__dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="w-win__title">{title}</span>
    </div>
    <div class="w-term__body">
      {commands.map(({ cmd, output }) => (
        <div class="w-term__line">
          <div class="w-term__cmd">
            <span class="w-term__prompt" aria-hidden="true">$</span>
            <span class="w-term__text">{cmd}</span>
          </div>
          {output && <div class="w-term__out">{output}</div>}
        </div>
      ))}
      <slot />
    </div>
  </div>
</div>
