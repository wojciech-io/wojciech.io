---
import '../styles/widgets.css';

interface Step {
  label: string;
  sub?: string;
  active?: boolean;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;

// Same columns as ProcessFlow: one row up to four steps, then three or four per row so a long flow never gets thin
const n = steps.length;
const cols = n <= 4 ? Math.max(n, 1) : n <= 6 ? 3 : 4;
---

<figure class="w">
  <ol class="w-flow" style={`--n:${cols}`}>
    {steps.map((step) => (
      <li data-hl={step.active ? '' : undefined}>
        <span class="w-flow__label">{step.label}</span>
        {step.sub && <p class="w-flow__body">{step.sub}</p>}
      </li>
    ))}
  </ol>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
