---
interface Step {
  label: string;
  sub?: string;
  active?: boolean;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<figure class="flow">
  <ol class="flow__track">
    {steps.map((step, i) => (
      <>
        <li class="flow__step" data-active={step.active ? 'true' : 'false'}>
          <span class="flow__label">{step.label}</span>
          {step.sub && <span class="flow__sub">{step.sub}</span>}
        </li>
        {i < steps.length - 1 && (
          <li class="flow__arrow" aria-hidden="true">
            <svg width="22" height="10" viewBox="0 0 22 10" fill="none">
              <path d="M0 5h19M15 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </li>
        )}
      </>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .flow {
    margin-block: 1.75rem;
  }
  .flow__track {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__step {
    flex: 1 1 0;
    min-width: 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .flow__step[data-active='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-lo);
  }
  .flow__label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .flow__sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }
  .flow__step[data-active='true'] .flow__sub {
    color: var(--color-text-muted);
  }
  .flow__arrow {
    display: flex;
    align-items: center;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }
  @media (max-width: 560px) {
    .flow__track {
      flex-direction: column;
    }
    .flow__arrow {
      transform: rotate(90deg);
      align-self: center;
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-dim);
    text-align: center;
  }
</style>
