---
import '../styles/widgets.css';
import { figLen } from '../lib/figures';

interface Props {
  before: string;
  after: string;
  delta: string;
  label?: string;
  beforeLabel?: string;
  afterLabel?: string;
  tone?: 'positive' | 'warning' | 'neutral';
}

const {
  before,
  after,
  delta,
  label,
  beforeLabel = 'Before',
  afterLabel = 'After',
  tone = 'positive',
} = Astro.props;

const toneAttr = { positive: 'good', warning: 'warn', neutral: undefined }[tone];
const len = Math.max(figLen(before), figLen(after));
---

<figure class="w" data-tone={toneAttr} style={`--len:${len}`}>
  <div class="w-delta">
    <div class="w-delta__cell">
      <p class="w-delta__label">{beforeLabel}</p>
      <p class="w-delta__value">{before}</p>
    </div>
    <div class="w-delta__mid" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M3 10h14M13 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="w-delta__badge">{delta}</span>
    </div>
    <div class="w-delta__cell" data-after>
      <p class="w-delta__label">{afterLabel}</p>
      <p class="w-delta__value">{after}</p>
    </div>
  </div>
  {label && <figcaption class="w-cap">{label}</figcaption>}
</figure>
