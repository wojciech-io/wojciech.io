---
import '../styles/widgets.css';

interface Props {
  layers: { name: string; tech: string; badge?: string }[];
  title?: string;
}

const { layers, title } = Astro.props;
---

<section class="w">
  {title && <p class="w-eyebrow">{title}</p>}
  <ol class="w-layers__list">
    {layers.map((layer) => (
      <li class="w-layer">
        <div>
          <span class="w-layer__name">{layer.name}</span>
          <span class="w-layer__tech">{layer.tech}</span>
        </div>
        {layer.badge && <span class="w-pill">{layer.badge}</span>}
      </li>
    ))}
  </ol>
</section>
