---
/**
 * ImageSlider — drag-to-compare before/after image overlay.
 * Usage:
 *   <ImageSlider
 *     before="/images/old-dashboard.png"
 *     after="/images/new-dashboard.png"
 *     beforeLabel="v1"
 *     afterLabel="v2"
 *     alt="Dashboard redesign comparison"
 *   />
 */
import '../styles/widgets.css';

interface Props {
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
  alt?: string;
  startPosition?: number;
}

const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  alt = 'Comparison',
  startPosition = 50,
} = Astro.props;
---

<figure class="w" data-img-slider>
  <div class="w-slider__frame" style={`--split: ${startPosition}%`}>
    <img class="w-slider__img" data-side="after" src={after} alt={`${alt} (${afterLabel})`} loading="lazy" decoding="async" />
    <img class="w-slider__img" data-side="before" src={before} alt={`${alt} (${beforeLabel})`} loading="lazy" decoding="async" />
    <div
      class="w-slider__handle"
      role="separator"
      aria-orientation="vertical"
      aria-label="Comparison position"
      aria-valuenow={startPosition}
      aria-valuemin="0"
      aria-valuemax="100"
      tabindex="0"
    >
      <span class="w-slider__grip" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8L22 12L18 16" /><path d="M6 8L2 12L6 16" />
        </svg>
      </span>
    </div>
    <span class="w-pill w-slider__label" data-side="before">{beforeLabel}</span>
    <span class="w-pill w-slider__label" data-side="after" data-tone="mark">{afterLabel}</span>
  </div>
</figure>

<script>
  function wireSliders() {
    document.querySelectorAll<HTMLElement>('[data-img-slider]:not([data-ready])').forEach((slider) => {
      slider.setAttribute('data-ready', '');
      const frame = slider.querySelector<HTMLElement>('.w-slider__frame')!;
      const handle = slider.querySelector<HTMLElement>('.w-slider__handle')!;
      let dragging = false;

      const set = (pct: number) => {
        const v = Math.max(0, Math.min(100, pct));
        frame.style.setProperty('--split', `${v}%`);
        handle.setAttribute('aria-valuenow', String(Math.round(v)));
      };
      const at = (clientX: number) => {
        const rect = frame.getBoundingClientRect();
        set(((clientX - rect.left) / rect.width) * 100);
      };

      frame.addEventListener('pointerdown', (e) => {
        dragging = true;
        frame.setPointerCapture(e.pointerId);
        at(e.clientX);
      });
      frame.addEventListener('pointermove', (e) => {
        if (dragging) at(e.clientX);
      });
      const stop = () => { dragging = false; };
      frame.addEventListener('pointerup', stop);
      frame.addEventListener('pointercancel', stop);

      handle.addEventListener('keydown', (e) => {
        const current = Number(handle.getAttribute('aria-valuenow'));
        const step = e.shiftKey ? 10 : 2;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') set(current - step);
        else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') set(current + step);
        else if (e.key === 'Home') set(0);
        else if (e.key === 'End') set(100);
        else return;
        e.preventDefault();
      });
    });
  }
  wireSliders();
  document.addEventListener('astro:page-load', wireSliders);
</script>
