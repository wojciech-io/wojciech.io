---
import '../../styles/widgets.css';

interface Props {
  caption?: string;
  direction?: 'row' | 'column';
  align?: 'start' | 'center' | 'stretch';
}

const { caption, direction = 'row', align = 'center' } = Astro.props;
---

<figure class="w w-diagram" data-direction={direction}>
  <div class="w-diagram__body">
    <div class="w-diagram__canvas" data-align={align}>
      <slot />
    </div>
    {caption && <figcaption class="w-cap w-diagram__cap">{caption}</figcaption>}
  </div>
</figure>
