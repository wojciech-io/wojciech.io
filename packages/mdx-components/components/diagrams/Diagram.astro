---
interface Props {
  caption?: string;
  direction?: 'row' | 'column';
  align?: 'start' | 'center' | 'stretch';
}

const { caption, direction = 'row', align = 'center' } = Astro.props;
---

<figure class="diagram" data-direction={direction}>
  <div class="diagram-canvas" style={`align-items:${align === 'stretch' ? 'stretch' : align === 'start' ? 'flex-start' : 'center'}`}>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 2rem 0;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }
  .diagram-canvas {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .diagram[data-direction='column'] .diagram-canvas {
    flex-direction: column;
    align-items: stretch !important;
    gap: 0.25rem;
  }
  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Mobile: horizontal diagrams flip to column. The long arrow SVG is
     swapped for a short glyph so labels stay horizontal and nothing
     rotates or overflows the column. */
  @media (max-width: 640px) {
    .diagram {
      padding: 1.25rem 1rem;
    }
    .diagram[data-direction='row'] .diagram-canvas {
      flex-direction: column;
      align-items: stretch !important;
      gap: 0.375rem;
    }
    .diagram[data-direction='row'] :global(.diagram-box) {
      max-width: 100%;
      overflow-wrap: break-word;
    }
    .diagram[data-direction='row'] :global(.diagram-arrow) {
      flex-direction: row;
      justify-content: center;
      gap: 0.5rem;
      width: auto !important;
      min-width: 0 !important;
      align-self: center;
      margin: 0.125rem 0;
    }
    .diagram[data-direction='row'] :global(.diagram-arrow svg) {
      display: none;
    }
    .diagram[data-direction='row'] :global(.diagram-arrow)::before {
      content: '↓';
      font-size: 1rem;
      line-height: 1;
      color: var(--color-text-muted);
    }
    .diagram[data-direction='row'] :global(.diagram-arrow[data-dashed='true'])::before {
      content: '⇣';
    }
    .diagram[data-direction='row'] :global(.diagram-arrow-label) {
      margin-top: 0;
    }
  }
</style>
