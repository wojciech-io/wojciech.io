---
import '../../styles/widgets.css';

interface Props {
  direction?: 'row' | 'column';
  gap?: 'sm' | 'md' | 'lg';
  align?: 'start' | 'center' | 'stretch';
}

const { direction = 'column', gap = 'md', align = 'center' } = Astro.props;
---

<div class="w-nodes" data-dir={direction} data-gap={gap} data-align={align}>
  <slot />
</div>
