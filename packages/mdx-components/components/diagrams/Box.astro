---
interface Props {
  variant?: 'default' | 'accent' | 'muted' | 'outline';
  label?: string;
  sub?: string;
}

const { variant = 'default', label, sub } = Astro.props;
---

<div class="diagram-box" data-variant={variant}>
  {label ? (
    <>
      <span class="diagram-box-label">{label}</span>
      {sub && <span class="diagram-box-sub">{sub}</span>}
    </>
  ) : (
    <slot />
  )}
</div>

<style>
  .diagram-box {
    flex-shrink: 0;
    min-width: 6.5rem;
    padding: 0.625rem 0.9rem;
    border-radius: 0.5rem;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.3;
    border: 1px solid var(--color-border-2);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 500;
    transition: background 120ms ease;
  }
  .diagram-box-label {
    display: block;
    font-weight: 600;
  }
  .diagram-box-sub {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  /* accent: lime fill for highlighted node */
  /* accent: tinted card with a solid lime edge, not a solid lime slab. The
     filled version put muted grey sub-text on fluorescent yellow, which failed
     to read at body size and shouted next to everything around it. */
  .diagram-box[data-variant='accent'] {
    background: var(--color-accent-lo);
    border-color: color-mix(in srgb, var(--color-accent-cta) 45%, var(--color-border-2));
    border-left: 3px solid var(--color-accent-cta);
    color: var(--color-text);
  }
  .diagram-box[data-variant='accent'] .diagram-box-sub {
    color: var(--color-text-muted);
  }

  /* muted: dimmer for context-only nodes */
  .diagram-box[data-variant='muted'] {
    background: transparent;
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  /* outline: no fill, just stroke */
  .diagram-box[data-variant='outline'] {
    background: transparent;
    border-style: dashed;
    color: var(--color-text-muted);
  }
</style>
