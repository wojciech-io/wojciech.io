---
import '../../styles/widgets.css';

interface Props {
  variant?: 'default' | 'accent' | 'muted' | 'outline';
  label?: string;
  sub?: string;
}

const { variant = 'default', label, sub } = Astro.props;
---

<div class="w-box" data-variant={variant}>
  {label ? (
    <>
      <span class="w-box__label">{label}</span>
      {sub && <span class="w-box__sub">{sub}</span>}
    </>
  ) : (
    <slot />
  )}
</div>
