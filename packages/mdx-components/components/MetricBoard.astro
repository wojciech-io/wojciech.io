---
import Figures from './Figures.astro';

interface Props {
  title?: string;
  metrics: { label: string; value: string; delta?: string; unit?: string }[];
}

const { title, metrics } = Astro.props;

const items = metrics.map((m) => ({
  label: m.label,
  value: m.value,
  unit: m.unit,
  delta: m.delta,
  tone: m.delta ? (m.delta.trim().startsWith('-') ? ('bad' as const) : ('good' as const)) : undefined,
}));
---

<Figures items={items} title={title} />
