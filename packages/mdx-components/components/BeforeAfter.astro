---
// MDX component: Before/After comparison block.
// Usage:
//   <BeforeAfter
//     before={{ title: "Before", body: "Old way" }}
//     after={{ title: "After",  body: "New way" }}
//   />
// Use for transformations: process changes, system before/after, stack moves.
import '../styles/widgets.css';

interface Side {
  title: string;
  body: string;
  caption?: string;
}
interface Props {
  before: Side;
  after: Side;
  label?: string; // optional heading above the block
}
const { before, after, label } = Astro.props;
---

<figure class="w">
  {label && <p class="w-eyebrow">{label}</p>}
  <div class="w-versus">
    <div class="w-versus__side">
      <p class="w-versus__label">{before.title}</p>
      <p class="w-versus__body">{before.body}</p>
      {before.caption && <p class="w-versus__note">{before.caption}</p>}
    </div>
    <div class="w-versus__side" data-emph>
      <p class="w-versus__label">{after.title}</p>
      <p class="w-versus__body">{after.body}</p>
      {after.caption && <p class="w-versus__note">{after.caption}</p>}
    </div>
  </div>
</figure>
