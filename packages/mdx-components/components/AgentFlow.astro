---
import '../styles/widgets.css';

interface Props {
  agentLabel?: string;
  inputLabel?: string;
  outputLabel?: string;
  tools: string[];
  caption?: string;
  title?: string;
}

const {
  agentLabel = 'Agent',
  inputLabel = 'Input',
  outputLabel = 'Output',
  tools = [],
  caption,
  title,
} = Astro.props;
---

<figure class="w">
  {title && <p class="w-eyebrow">{title}</p>}

  <div class="w-agent__lane">
    <p class="w-agent__node" data-kind="input">{inputLabel}</p>
    <span class="w-agent__link" aria-hidden="true"></span>

    <p class="w-agent__node" data-kind="agent">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
        <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {agentLabel}
    </p>

    {tools.length > 0 && (
      <>
        <span class="w-agent__link" aria-hidden="true"></span>
        <ul class="w-agent__tools">
          {tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </>
    )}

    <span class="w-agent__link" aria-hidden="true"></span>
    <p class="w-agent__node" data-kind="output">{outputLabel}</p>
  </div>

  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
