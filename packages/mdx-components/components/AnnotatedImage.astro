---
import '../styles/widgets.css';
import { imageRungs } from '../lib/imageRungs';

interface Annotation {
  x: number;
  y: number;
  label: string;
  pos?: 'top' | 'bottom' | 'left' | 'right';
}

interface Props {
  src: string;
  alt: string;
  annotations?: Annotation[];
  caption?: string;
}

const { src, alt, annotations = [], caption } = Astro.props;

// This component takes no dimensions, so the rungs come from the file itself.
const art = imageRungs(src);
---

<figure class="w">
  <div class="w-annot__canvas">
    <img
      {...art}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    {annotations.map((ann, i) => (
      <span
        class="w-annot__pin"
        data-pos={ann.pos ?? 'top'}
        style={`left: ${ann.x}%; top: ${ann.y}%`}
        tabindex="0"
        role="note"
        aria-label={`Annotation ${i + 1}: ${ann.label}`}
      >
        <span class="w-annot__dot" aria-hidden="true">{i + 1}</span>
        <span class="w-annot__tip" aria-hidden="true">{ann.label}</span>
      </span>
    ))}
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
