---
import Figures from './Figures.astro';

interface Metric {
  value: string;
  label: string;
  delta?: string;
  deltaPositive?: boolean;
}

interface Props {
  items: Metric[];
  caption?: string;
}

const { items, caption } = Astro.props;

const figures = items.map(({ value, label, delta, deltaPositive }) => ({
  value,
  label,
  delta: delta ? `${deltaPositive === false ? '↓' : '↑'} ${delta}` : undefined,
  tone: delta ? (deltaPositive === false ? ('bad' as const) : ('good' as const)) : undefined,
}));
---

<Figures items={figures} caption={caption} />
