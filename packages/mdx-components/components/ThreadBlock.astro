---
import '../styles/widgets.css';

interface Props {
  messages: { role: 'user' | 'assistant' | 'system'; content: string; label?: string }[];
  title?: string;
}

const { messages, title } = Astro.props;

const roleLabels = { user: 'User', assistant: 'Assistant', system: 'System' };
---

<div class="w">
  {title && <p class="w-eyebrow">{title}</p>}
  <div class="w-thread">
    {messages.map((msg) => (
      <div class="w-msg" data-role={msg.role}>
        <p class="w-msg__role">{msg.label ?? roleLabels[msg.role]}</p>
        <div class="w-msg__body" set:html={msg.content} />
      </div>
    ))}
  </div>
</div>
