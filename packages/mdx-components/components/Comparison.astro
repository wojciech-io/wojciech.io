---
import '../styles/widgets.css';

interface ComparisonItem {
  label: string;
  body: string;
  tag?: string;
  tone?: 'muted' | 'accent' | 'warning';
}

interface Props {
  // Compact article cards API.
  items?: ComparisonItem[];
  // Classic before/after list API.
  left?: string;
  right?: string;
  leftItems?: string[];
  rightItems?: string[];
  caption?: string;
}

const {
  items = [],
  left,
  right,
  leftItems = [],
  rightItems = [],
  caption,
} = Astro.props;

const useCards = items.length > 0;
const cols = useCards ? Math.min(Math.max(items.length, 2), 3) : 2;
---

<figure class="w">
  <div class="w-versus" style={`--cols:${cols}`}>
    {useCards ? (
      items.map((item) => (
        <section class="w-versus__side" data-emph={item.tone === 'accent' ? '' : undefined}>
          <p class="w-versus__label">
            <span>{item.label}</span>
            {item.tag && <span class="w-versus__tag" data-tone={item.tone === 'warning' ? 'warn' : undefined}>{item.tag}</span>}
          </p>
          <p class="w-versus__body">{item.body}</p>
        </section>
      ))
    ) : (
      <>
        <section class="w-versus__side" aria-label={left}>
          <p class="w-versus__label">{left}</p>
          <ul class="w-list w-list--cross">
            {leftItems.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="w-versus__side" data-emph aria-label={right}>
          <p class="w-versus__label">{right}</p>
          <ul class="w-list">
            {rightItems.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </>
    )}
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
