---
import '../styles/widgets.css';

interface Props {
  icon?: 'info' | 'warning' | 'tip' | 'check';
  title?: string;
  body?: string;
  items?: string[];
  tone?: 'accent' | 'warning' | 'neutral';
}

const { icon, title, body, items = [], tone = 'accent' } = Astro.props;

const resolvedIcon = icon ?? (tone === 'warning' ? 'warning' : 'info');
const labels = { info: 'Key takeaway', warning: 'Watch out', tip: 'Tip', check: 'Confirmed' } as const;
const label = title ?? labels[resolvedIcon];
const panelTone = resolvedIcon === 'warning' ? 'warn' : resolvedIcon === 'check' ? 'good' : undefined;
---

<aside class="w w-panel" data-tone={panelTone} role="note" aria-label={label}>
  <p class="w-eyebrow">{label}</p>
  <div class="w-body">
    {body && <p>{body}</p>}
    {items.length > 0 && (
      <ul class="w-list w-list--dot">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    )}
    <slot />
  </div>
</aside>
