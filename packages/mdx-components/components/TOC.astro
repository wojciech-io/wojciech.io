---
import '../styles/widgets.css';

interface Props {
  title?: string;
  levels?: 'h2' | 'h2,h3';
  minItems?: number;
}

const { title = 'On this page', levels = 'h2,h3', minItems = 2 } = Astro.props;
---

<aside class="w w-toc" data-mdx-toc data-levels={levels} data-min-items={minItems}>
  <p class="w-eyebrow">{title}</p>
  <nav class="w-toc__nav" aria-label={title}>
    <ol class="w-toc__list"></ol>
  </nav>
</aside>

<script>
  function buildMdxTocs() {
    const tocs = document.querySelectorAll('[data-mdx-toc]');

    tocs.forEach((toc) => {
      if (toc instanceof HTMLElement && toc.dataset.ready === 'true') return;

      const container = toc.closest('#article-content')?.querySelector('.prose-content')
        ?? document.querySelector('.prose-content');

      if (!container) {
        toc.setAttribute('hidden', '');
        return;
      }

      const levels = (toc.getAttribute('data-levels') || 'h2,h3')
        .split(',')
        .map((level) => level.trim())
        .filter(Boolean);
      const selector = levels.map((level) => `:scope > ${level}`).join(',');
      const headings = Array.from(container.querySelectorAll(selector))
        .filter((heading) => heading instanceof HTMLElement && heading.textContent?.trim());
      const minItems = Number(toc.getAttribute('data-min-items') || 2);

      if (headings.length < minItems) {
        toc.setAttribute('hidden', '');
        return;
      }

      const usedIds = new Set(
        Array.from(document.querySelectorAll('[id]'))
          .map((node) => node.id)
          .filter(Boolean)
      );

      const slugify = (value) => {
        const slug = value
          .toLowerCase()
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

        return slug || 'section';
      };

      const uniqueSlug = (base) => {
        let slug = base;
        let i = 2;
        while (usedIds.has(slug)) {
          slug = `${base}-${i}`;
          i += 1;
        }
        usedIds.add(slug);
        return slug;
      };

      const list = toc.querySelector('.w-toc__list');
      if (!list) return;

      list.textContent = '';

      const headingLinks = headings.map((heading) => {
        const element = heading;
        if (!element.id) {
          element.id = uniqueSlug(slugify(element.textContent || 'section'));
        }

        const item = document.createElement('li');
        item.dataset.level = element.tagName.toLowerCase();

        const link = document.createElement('a');
        link.href = `#${element.id}`;
        link.textContent = element.textContent?.trim() || 'Section';

        item.appendChild(link);
        list.appendChild(item);

        return { heading: element, link };
      });

      const setActiveLink = () => {
        // a soft navigation replaces the page, so a listener left behind retires itself
        if (!toc.isConnected) {
          window.removeEventListener('scroll', setActiveLink);
          return;
        }
        const current = headingLinks.reduce((active, item) => (
          item.heading.getBoundingClientRect().top <= 130 ? item : active
        ), headingLinks[0]);

        headingLinks.forEach((item) => {
          if (item === current) {
            item.link.setAttribute('aria-current', 'true');
          } else {
            item.link.removeAttribute('aria-current');
          }
        });
      };

      window.addEventListener('scroll', setActiveLink, { passive: true });
      setActiveLink();

      if (toc instanceof HTMLElement) {
        toc.dataset.ready = 'true';
      }
    });
  }

  buildMdxTocs();
  document.addEventListener('astro:page-load', buildMdxTocs);
</script>
