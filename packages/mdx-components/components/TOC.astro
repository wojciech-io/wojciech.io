---
interface Props {
  title?: string;
  levels?: 'h2' | 'h2,h3';
  minItems?: number;
  sticky?: boolean;
}

const { title = 'On this page', levels = 'h2,h3', minItems = 2, sticky = true } = Astro.props;
---

<aside class:list={['toc', sticky && 'toc--sticky']} data-mdx-toc data-levels={levels} data-min-items={minItems}>
  <p class="toc__title">{title}</p>
  <nav class="toc__nav" aria-label={title}>
    <ol class="toc__list"></ol>
  </nav>
</aside>

<script>
  function buildMdxTocs() {
    const tocs = document.querySelectorAll('[data-mdx-toc]');

    tocs.forEach((toc) => {
      if (toc instanceof HTMLElement && toc.dataset.ready === 'true') return;

      const container = toc.closest('#article-content')?.querySelector('.prose-content')
        ?? document.querySelector('.prose-content');

      if (!container) {
        toc.setAttribute('hidden', '');
        return;
      }

      const levels = (toc.getAttribute('data-levels') || 'h2,h3')
        .split(',')
        .map((level) => level.trim())
        .filter(Boolean);
      const selector = levels.map((level) => `:scope > ${level}`).join(',');
      const headings = Array.from(container.querySelectorAll(selector))
        .filter((heading) => heading instanceof HTMLElement && heading.textContent?.trim());
      const minItems = Number(toc.getAttribute('data-min-items') || 2);

      if (headings.length < minItems) {
        toc.setAttribute('hidden', '');
        return;
      }

      const usedIds = new Set(
        Array.from(document.querySelectorAll('[id]'))
          .map((node) => node.id)
          .filter(Boolean)
      );

      const slugify = (value) => {
        const slug = value
          .toLowerCase()
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

        return slug || 'section';
      };

      const uniqueSlug = (base) => {
        let slug = base;
        let i = 2;
        while (usedIds.has(slug)) {
          slug = `${base}-${i}`;
          i += 1;
        }
        usedIds.add(slug);
        return slug;
      };

      const list = toc.querySelector('.toc__list');
      if (!list) return;

      list.textContent = '';

      const headingLinks = headings.map((heading) => {
        const element = heading;
        if (!element.id) {
          element.id = uniqueSlug(slugify(element.textContent || 'section'));
        }

        const item = document.createElement('li');
        item.className = `toc__item toc__item--${element.tagName.toLowerCase()}`;

        const link = document.createElement('a');
        link.href = `#${element.id}`;
        link.textContent = element.textContent?.trim() || 'Section';

        item.appendChild(link);
        list.appendChild(item);

        return { heading: element, link };
      });

      const setActiveLink = () => {
        const current = headingLinks.reduce((active, item) => (
          item.heading.getBoundingClientRect().top <= 130 ? item : active
        ), headingLinks[0]);

        headingLinks.forEach((item) => {
          if (item === current) {
            item.link.setAttribute('aria-current', 'true');
          } else {
            item.link.removeAttribute('aria-current');
          }
        });
      };

      window.addEventListener('scroll', setActiveLink, { passive: true });
      setActiveLink();

      if (toc instanceof HTMLElement) {
        toc.dataset.ready = 'true';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', buildMdxTocs, { once: true });
  } else {
    buildMdxTocs();
  }
</script>

<style>
  .toc {
    margin: 0 0 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }

  .toc[hidden] {
    display: none;
  }

  @media (min-width: 1180px) {
    .toc--sticky {
      float: right;
      position: sticky;
      top: 5rem;
      z-index: 1;
      width: 15rem;
      max-height: calc(100vh - 7rem);
      overflow: auto;
      margin: 0 -17rem 1.5rem 1.5rem;
    }
  }

  .toc__title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .toc__list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc :global(.toc__item) {
    margin: 0;
  }

  .toc :global(.toc__item a) {
    display: block;
    padding: 0.25rem 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc :global(.toc__item a:hover),
  .toc :global(.toc__item a[aria-current='true']) {
    color: var(--color-text);
  }

  .toc :global(.toc__item--h3 a) {
    padding-left: 0.875rem;
    color: var(--color-text-dim);
    font-size: 0.75rem;
  }

  :global(.prose-content h2[id]),
  :global(.prose-content h3[id]) {
    scroll-margin-top: 5.5rem;
  }
</style>
