---
import '../styles/widgets.css';

interface Step {
  label: string;
  body?: string;
  tag?: string;
  highlight?: boolean;
}

interface Props {
  steps?: Step[];
  title?: string;
  caption?: string;
  direction?: 'horizontal' | 'vertical';
}

const { steps = [], title, caption, direction = 'horizontal' } = Astro.props;

// columns: one row up to four steps, then three or four per row so a long flow never gets thin
const n = steps.length;
const cols = n <= 4 ? Math.max(n, 1) : n <= 6 ? 3 : 4;
---

<section class="w">
  {title && <p class="w-eyebrow">{title}</p>}
  {direction === 'vertical' ? (
    <ol class="w-rail">
      {steps.map((step) => (
        <li data-hl={step.highlight ? '' : undefined}>
          {step.tag && <span class="w-rail__meta">{step.tag}</span>}
          <strong class="w-rail__title">{step.label}</strong>
          {step.body && <p class="w-rail__body">{step.body}</p>}
        </li>
      ))}
      <slot />
    </ol>
  ) : (
    <ol class="w-flow" style={`--n:${cols}`}>
      {steps.map((step) => (
        <li data-hl={step.highlight ? '' : undefined}>
          {step.tag && <span class="w-flow__tag">{step.tag}</span>}
          <span class="w-flow__label">{step.label}</span>
          {step.body && <p class="w-flow__body">{step.body}</p>}
        </li>
      ))}
      <slot />
    </ol>
  )}
  {caption && <p class="w-cap">{caption}</p>}
</section>
