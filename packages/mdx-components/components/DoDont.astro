---
import '../styles/widgets.css';

interface Props {
  do?: string[];
  dont?: string[];
  doLabel?: string;
  dontLabel?: string;
  caption?: string;
}

const { do: doItems = [], dont = [], doLabel = 'Do', dontLabel = "Don't", caption } = Astro.props;
---

<figure class="w">
  <div class="w-versus">
    <div class="w-versus__side" data-ink>
      <p class="w-versus__label">{doLabel}</p>
      <ul class="w-list">
        {doItems.map((item) => <li>{item}</li>)}
        <slot name="do" />
      </ul>
    </div>
    <div class="w-versus__side" data-ink>
      <p class="w-versus__label">{dontLabel}</p>
      <ul class="w-list w-list--cross">
        {dont.map((item) => <li>{item}</li>)}
        <slot name="dont" />
      </ul>
    </div>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
