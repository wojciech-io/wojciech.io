---
/**
 * Accordion: collapsible rows on native <details>, one hairline between them.
 * Usage:
 *   <Accordion items={[
 *     { title: "What is this?", body: "A collapsible section." },
 *     { title: "Why use it?",   body: "To save vertical space." },
 *   ]} />
 *
 *   <Accordion items={[...]} multiple />  to allow several open at once
 */
import '../styles/widgets.css';

interface AccordionItem {
  title: string;
  body: string;
  open?: boolean;
}
interface Props {
  items: AccordionItem[];
  title?: string;
  multiple?: boolean;
}

const { items, title, multiple = false } = Astro.props;
---

<div class="w" data-accordion data-multiple={multiple ? 'true' : undefined}>
  {title && <p class="w-eyebrow">{title}</p>}
  <div class="w-acc">
    {items.map((item) => (
      <details class="w-acc__item" open={item.open || undefined}>
        <summary class="w-acc__sum">{item.title}</summary>
        <div class="w-acc__body"><p>{item.body}</p></div>
      </details>
    ))}
  </div>
</div>

<script>
  // Single-open mode: opening one row closes its siblings
  function wireAccordions() {
    document.querySelectorAll<HTMLElement>('[data-accordion]:not([data-multiple]):not([data-ready])').forEach((block) => {
      block.setAttribute('data-ready', '');
      block.querySelectorAll('details').forEach((details) => {
        details.addEventListener('toggle', () => {
          if (details.open) {
            block.querySelectorAll('details').forEach((other) => {
              if (other !== details) other.removeAttribute('open');
            });
          }
        });
      });
    });
  }
  wireAccordions();
  document.addEventListener('astro:page-load', wireAccordions);
</script>
