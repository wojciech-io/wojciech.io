---
import '../styles/widgets.css';

interface Props {
  cols?: 2 | 3 | 4;
  caption?: string;
}
const { cols, caption } = Astro.props;
---

<figure class="w">
  <div class="w-figs" data-cols={cols}>
    <div class="w-figs__grid">
      <slot />
    </div>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
