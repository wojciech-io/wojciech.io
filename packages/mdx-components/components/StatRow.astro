---
interface Props {
  cols?: 2 | 3 | 4;
  caption?: string;
}
const { cols = 3, caption } = Astro.props;

const colClass = {
  2: 'sr-cols-2',
  3: 'sr-cols-3',
  4: 'sr-cols-4',
}[cols];
---

<figure class="sr-wrap">
  <div class:list={['sr-row', colClass]}>
    <slot />
  </div>
  {caption && <figcaption class="sr-caption">{caption}</figcaption>}
</figure>

<style>
  .sr-wrap { margin: 2rem 0; }

  .sr-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .sr-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .sr-cols-3 { grid-template-columns: repeat(3, 1fr); }
    .sr-cols-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 860px) {
    .sr-cols-4 { grid-template-columns: repeat(4, 1fr); }
  }

  .sr-caption {
    display: block;
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }
</style>
