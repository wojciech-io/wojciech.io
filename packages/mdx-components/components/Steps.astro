---
import '../styles/widgets.css';

type StepInput = string | {
  title: string;
  body?: string;
  meta?: string;
};

interface Props {
  items?: StepInput[];
  title?: string;
  caption?: string;
  start?: number;
}

const { items = [], title, caption, start = 1 } = Astro.props;
const startAt = Math.max(1, Number(start) || 1);
const normalizedItems = items.map((item) => (typeof item === 'string' ? { title: item } : item));
---

<section class="w">
  {title && <p class="w-eyebrow">{title}</p>}
  <ol class="w-rail" style={`--rail-start:${startAt - 1}`}>
    {normalizedItems.map((item) => (
      <li>
        {item.meta && <span class="w-rail__meta">{item.meta}</span>}
        <strong class="w-rail__title">{item.title}</strong>
        {item.body && <p class="w-rail__body">{item.body}</p>}
      </li>
    ))}
    <slot />
  </ol>
  {caption && <p class="w-cap">{caption}</p>}
</section>
