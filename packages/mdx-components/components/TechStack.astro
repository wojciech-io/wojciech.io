---
import '../styles/widgets.css';

type StackItemInput = string | {
  label: string;
  detail?: string;
  href?: string;
};

interface StackGroupInput {
  label?: string;
  items: StackItemInput[];
}

interface StackItem {
  label: string;
  detail?: string;
  href?: string;
}

interface StackGroup {
  label?: string;
  items: StackItem[];
}

interface Props {
  title?: string;
  caption?: string;
  items?: StackItemInput[];
  groups?: StackGroupInput[];
  cols?: 2 | 3;
}

const { title, caption, items = [], groups = [], cols = 2 } = Astro.props;

const normalizeItem = (item: StackItemInput): StackItem => (
  typeof item === 'string' ? { label: item } : item
);

const normalizedGroups: StackGroup[] = groups.length > 0
  ? groups.map((group) => ({
      label: group.label,
      items: group.items.map(normalizeItem),
    }))
  : items.length > 0
    ? [{ items: items.map(normalizeItem) }]
    : [];
---

<section class="w w-panel w-stack" data-cols={cols}>
  {(title || caption) && (
    <header class="w-head">
      {title && <p class="w-eyebrow">{title}</p>}
      {caption && <p class="w-cap">{caption}</p>}
    </header>
  )}

  {normalizedGroups.length > 0 ? (
    <div class="w-stack__groups">
      {normalizedGroups.map((group) => (
        <div class="w-stack__group">
          {group.label && <p class="w-stack__label">{group.label}</p>}
          <ul class="w-stack__items">
            {group.items.map((item) => (
              <li>
                {item.href ? (
                  <a class="w-chip" href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.label}
                    {item.detail && <span class="w-chip__detail">{item.detail}</span>}
                  </a>
                ) : (
                  <span class="w-chip">
                    {item.label}
                    {item.detail && <span class="w-chip__detail">{item.detail}</span>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ) : (
    <div class="w-body"><slot /></div>
  )}
</section>
