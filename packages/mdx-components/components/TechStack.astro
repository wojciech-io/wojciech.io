---
type StackItemInput = string | {
  label: string;
  detail?: string;
  href?: string;
};

interface StackGroupInput {
  label?: string;
  items: StackItemInput[];
}

interface StackItem {
  label: string;
  detail?: string;
  href?: string;
}

interface StackGroup {
  label?: string;
  items: StackItem[];
}

interface Props {
  title?: string;
  caption?: string;
  items?: StackItemInput[];
  groups?: StackGroupInput[];
  cols?: 2 | 3;
}

const { title, caption, items = [], groups = [], cols = 2 } = Astro.props;

const normalizeItem = (item: StackItemInput): StackItem => (
  typeof item === 'string' ? { label: item } : item
);

const normalizedGroups: StackGroup[] = groups.length > 0
  ? groups.map((group) => ({
      label: group.label,
      items: group.items.map(normalizeItem),
    }))
  : items.length > 0
    ? [{ items: items.map(normalizeItem) }]
    : [];
---

<section class={`tech-stack tech-stack--cols-${cols}`}>
  {(title || caption) && (
    <header class="tech-stack__header">
      {title && <p class="tech-stack__title">{title}</p>}
      {caption && <p class="tech-stack__caption">{caption}</p>}
    </header>
  )}

  {normalizedGroups.length > 0 ? (
    <div class="tech-stack__groups">
      {normalizedGroups.map((group) => (
        <section class="tech-stack__group">
          {group.label && <p class="tech-stack__group-label">{group.label}</p>}
          <div class="tech-stack__items">
            {group.items.map((item) => (
              item.href ? (
                <a class="tech-stack__item" href={item.href} target="_blank" rel="noopener noreferrer">
                  <span class="tech-stack__item-label">{item.label}</span>
                  {item.detail && <span class="tech-stack__item-detail">{item.detail}</span>}
                </a>
              ) : (
                <span class="tech-stack__item">
                  <span class="tech-stack__item-label">{item.label}</span>
                  {item.detail && <span class="tech-stack__item-detail">{item.detail}</span>}
                </span>
              )
            ))}
          </div>
        </section>
      ))}
    </div>
  ) : (
    <div class="tech-stack__slot">
      <slot />
    </div>
  )}
</section>

<style>
  .tech-stack {
    margin-block: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
  }

  .tech-stack__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tech-stack__title,
  .tech-stack__group-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .tech-stack__caption {
    max-width: 24rem;
    margin: 0;
    text-align: right;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tech-stack__groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .tech-stack--cols-2 .tech-stack__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tech-stack--cols-3 .tech-stack__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tech-stack__group {
    min-width: 0;
  }

  .tech-stack__group-label {
    margin-bottom: 0.625rem;
    color: var(--color-text-dim);
  }

  .tech-stack__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-stack__item {
    min-width: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    max-width: 100%;
    padding: 0.45rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-badge);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  a.tech-stack__item {
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  a.tech-stack__item:hover {
    border-color: var(--color-border-2);
    color: var(--color-accent-hi);
  }

  .tech-stack__item-label {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .tech-stack__item-detail {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-text-dim);
  }

  .tech-stack__slot :global(> *:first-child) {
    margin-top: 0;
  }

  .tech-stack__slot :global(> *:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 520px) {
    .tech-stack__header {
      display: block;
    }

    .tech-stack__caption {
      margin-top: 0.5rem;
      text-align: left;
    }
  }
</style>
