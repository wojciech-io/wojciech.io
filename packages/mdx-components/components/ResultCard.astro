---
/**
 * ResultCard — hero result highlight for case study moments.
 * Shows a big outcome metric with context, client tag, and timeframe.
 * Drawn with the same `.w-hero` block as StatCallout.
 *
 * Usage:
 *   <ResultCard
 *     metric="3.2×"
 *     label="pipeline lift"
 *     context="Outbound motion rebuilt on AI-enriched sequences. CRM connected to scoring model."
 *     timeframe="6 weeks"
 *     tag="GTM architecture"
 *   />
 */
import '../styles/widgets.css';
import { figLen } from '../lib/figures';

interface Props {
  metric: string;
  label: string;
  context?: string;
  timeframe?: string;
  tag?: string;
  /** Smaller figure, for two ResultCards side by side in a Grid. Standalone by default. */
  compact?: boolean;
}

const { metric, label, context, timeframe, tag, compact = false } = Astro.props;

// Same two figure sizes as every other big number; compact never takes the largest
const len = figLen(metric);
const size = len <= 4 && !compact ? 'l' : len <= 6 ? 'm' : undefined;
const hasCopy = Boolean(context || timeframe || Astro.slots.has('default'));
---

<div class="w">
  <div class="w-hero" data-solo={hasCopy ? undefined : ''}>
    <div class="w-hero__metric">
      {tag && <p class="w-hero__eyebrow">{tag}</p>}
      <p class="w-hero__value" data-size={size}>{metric}</p>
      <p class="w-hero__label">{label}</p>
    </div>
    {hasCopy && (
      <div class="w-hero__copy">
        {timeframe && <p class="w-hero__delta">{timeframe}</p>}
        {context && <p>{context}</p>}
        <slot />
      </div>
    )}
  </div>
</div>
