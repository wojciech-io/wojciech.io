---
/**
 * CodeBlock: a code window with filename, language tag and copy button.
 *
 * Takes its content either as children or as a `code` string, the same way
 * PullQuote takes `quote`. Seven usages across five articles were already
 * passing `code`, and with only a slot to render into they shipped an empty
 * black box where a CLAUDE.md template was supposed to be. A template literal
 * is the practical way to write multi-line code in MDX without the markdown
 * parser touching it, so the prop is the right shape to support.
 *
 * Usage:
 *   <CodeBlock filename="wrangler.toml" lang="toml">
 *     name = "growthhub-cron"
 *   </CodeBlock>
 *
 *   <CodeBlock filename="CLAUDE.md" lang="markdown" code={`# Operator identity`} />
 */
import '../styles/widgets.css';

interface Props {
  filename?: string;
  lang?: string;
  caption?: string;
  code?: string;
}

const { filename, lang, caption, code } = Astro.props;
---

<figure class="w" data-code-block>
  <div class="w-win">
    {(filename || lang) && (
      <div class="w-win__bar">
        <span class="w-win__dots" aria-hidden="true"><span></span><span></span><span></span></span>
        {filename && <span class="w-win__title">{filename}</span>}
        {lang && <span class="w-pill">{lang}</span>}
        <button type="button" class="w-code__copy" data-copy-btn aria-label="Copy code">
          <svg class="w-code__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
          </svg>
          <svg class="w-code__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </button>
      </div>
    )}
    <div class="w-code__body" tabindex="0" role="region" aria-label={filename ?? 'Code'}>
      <pre><code>{code ?? <slot />}</code></pre>
    </div>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>

<script>
  function wireCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]:not([data-ready])').forEach((btn) => {
      btn.setAttribute('data-ready', '');
      let timer: number | undefined;
      btn.addEventListener('click', async () => {
        const code = btn.closest('[data-code-block]')?.querySelector('pre code')?.textContent;
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code.trim());
        } catch {
          return; // clipboard blocked (insecure context, iframe): leave the button as it was
        }
        btn.setAttribute('data-copied', '');
        btn.setAttribute('aria-label', 'Copied');
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.removeAttribute('data-copied');
          btn.setAttribute('aria-label', 'Copy code');
        }, 2000);
      });
    });
  }
  wireCopyButtons();
  document.addEventListener('astro:page-load', wireCopyButtons);
</script>
