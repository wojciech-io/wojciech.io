---
import '../styles/widgets.css';

interface Props {
  title?: string;
  items?: string[];
  type?: 'takeaway' | 'warning' | 'result';
}

const { title, items = [], type = 'takeaway' } = Astro.props;

const config = {
  takeaway: { label: 'Key takeaway', tone: undefined, list: 'w-list w-list--dot' },
  warning: { label: 'Watch out', tone: 'warn', list: 'w-list w-list--dot' },
  result: { label: 'Result', tone: undefined, list: 'w-list' },
}[type];
---

<div class="w w-panel" data-tone={config.tone} role="note">
  <p class="w-eyebrow">{title ?? config.label}</p>
  {items.length > 0 ? (
    <ul class={config.list}>
      {items.map((item) => <li>{item}</li>)}
    </ul>
  ) : (
    <div class="w-body"><slot /></div>
  )}
</div>

