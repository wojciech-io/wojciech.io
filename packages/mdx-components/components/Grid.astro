---
import '../styles/widgets.css';

interface Props {
  cols?: 2 | 3 | 4;
  gap?: 'sm' | 'md' | 'lg';
  title?: string;
  caption?: string;
}

const { cols = 3, gap = 'md', title, caption } = Astro.props;
---

<section class="w w-grid" data-cols={cols} data-gap={gap} style={`--n: ${cols}`}>
  {(title || caption) && (
    <header class="w-head">
      {title && <p class="w-eyebrow">{title}</p>}
      {caption && <p class="w-cap">{caption}</p>}
    </header>
  )}
  <div class="w-grid__cells">
    <slot />
  </div>
</section>
