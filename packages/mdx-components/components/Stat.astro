---
import '../styles/widgets.css';
import { figLen, isLong } from '../lib/figures';

interface Props {
  value: string;
  label: string;
  sub?: string;
  delta?: string;
  deltaDir?: 'up' | 'down' | 'neutral';
  source?: string;
  accent?: boolean;
}

const { value, label, sub, delta, deltaDir = 'up', source, accent = false } = Astro.props;

const tone = { up: 'good', down: 'bad', neutral: undefined }[deltaDir];
const arrow = { up: '↑', down: '↓', neutral: '' }[deltaDir];
---

<div class="w-fig" data-accent={accent ? '' : undefined}>
  <p class="w-fig__value" style={`--len:${figLen(value)}`} data-long={isLong(value) ? '' : undefined}>{value}</p>
  <p class="w-fig__label">{label}</p>
  {delta && <p class="w-fig__delta" data-tone={tone}>{arrow ? `${arrow} ` : ''}{delta}</p>}
  {sub && <p class="w-fig__sub">{sub}</p>}
  {source && <p class="w-fig__src">{source}</p>}
</div>
