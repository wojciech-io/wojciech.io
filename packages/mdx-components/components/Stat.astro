---
interface Props {
  value: string;
  label: string;
  sub?: string;
  delta?: string;
  deltaDir?: 'up' | 'down' | 'neutral';
  source?: string;
  accent?: boolean;
}

const { value, label, sub, delta, deltaDir = 'up', source, accent = false } = Astro.props;

const deltaColor = {
  up:      'text-[var(--color-accent)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] border-[color-mix(in_srgb,var(--color-accent)_25%,transparent)]',
  down:    'text-red-400 bg-red-900/20 border-red-800/30',
  neutral: 'text-[var(--color-text-dim)] bg-[var(--color-surface)] border-[var(--color-border)]',
}[deltaDir];

const deltaPath = {
  up:      'M5 12l5-5 5 5',
  down:    'M5 12l5 5 5-5',
  neutral: 'M5 12h14',
}[deltaDir];
---

<div class:list={[
  'relative overflow-hidden rounded-[var(--radius-card)] border p-5 transition-colors group',
  accent
    ? 'border-[color-mix(in_srgb,var(--color-accent)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_6%,var(--color-surface-2))]'
    : 'border-[var(--color-border)] bg-[var(--color-surface-2)] hover:border-[var(--color-border-2)]',
]}>
  {accent && (
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/50 to-transparent" aria-hidden="true" />
  )}

  <div class="flex items-start justify-between gap-2 mb-1.5">
    <p class:list={[
      'text-[2.75rem] font-bold leading-none tracking-tight tabular-nums',
      accent ? 'text-[var(--color-accent)]' : 'text-[var(--color-text)]',
    ]}>
      {value}
    </p>
    {delta && (
      <span class:list={[
        'inline-flex items-center gap-1 px-2 py-1 rounded-full border text-[11px] font-semibold shrink-0 mt-1.5',
        deltaColor,
      ]}>
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={deltaPath} />
        </svg>
        {delta}
      </span>
    )}
  </div>

  <p class="text-sm font-semibold text-[var(--color-text)] leading-snug">{label}</p>
  {sub && <p class="mt-1 text-xs text-[var(--color-text-muted)] leading-relaxed">{sub}</p>}
  {source && (
    <p class="mt-3 pt-3 border-t border-[var(--color-border)] text-[10px] text-[var(--color-text-dim)] uppercase tracking-widest">
      {source}
    </p>
  )}
</div>
