---
import Figures from './Figures.astro';

interface Stat {
  value: string;
  label: string;
  delta?: string;
  good?: boolean;
  sub?: string;
}
interface Props {
  stats: Stat[];
  columns?: 2 | 3 | 4;
  caption?: string;
}
const { stats, columns, caption } = Astro.props;

const items = stats.map(({ value, label, delta, good, sub }) => ({
  value,
  label,
  delta,
  sub,
  tone: good === true ? ('good' as const) : good === false ? ('bad' as const) : undefined,
}));
---

<Figures items={items} cols={columns} caption={caption} />
