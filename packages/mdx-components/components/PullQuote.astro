---
import '../styles/widgets.css';

interface Props {
  quote?: string;
  source?: string;
  role?: string;
  href?: string;
}

const { quote, source, role, href } = Astro.props;
---

<figure class="w w-quote">
  <blockquote class="w-quote__text">
    {quote ? <p>{quote}</p> : <slot />}
  </blockquote>
  {source && (
    <figcaption class="w-quote__by">
      {href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">{source}</a>
      ) : (
        <span>{source}</span>
      )}
      {role && <span class="w-quote__role">{role}</span>}
    </figcaption>
  )}
</figure>
