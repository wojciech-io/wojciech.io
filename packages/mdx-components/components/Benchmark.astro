---
/**
 * Benchmark: two horizontal bars on one scale, your result against a baseline.
 *
 * Usage:
 *   <Benchmark
 *     label="Email open rate"
 *     yours={42}
 *     baseline={21}
 *     yoursLabel="AI-personalised sequences"
 *     baselineLabel="Industry average"
 *     unit="%"
 *     caption="Source: campaign data Q1 2025"
 *   />
 */
import '../styles/widgets.css';

interface Props {
  label: string;
  yours: number;
  baseline: number;
  yoursLabel?: string;
  baselineLabel?: string;
  unit?: string;
  caption?: string;
  /** Flip so lower is better (e.g. cost, churn) */
  lowerIsBetter?: boolean;
}

const {
  label,
  yours,
  baseline,
  yoursLabel = 'Result',
  baselineLabel = 'Baseline',
  unit = '%',
  caption,
  lowerIsBetter = false,
} = Astro.props;

const max = Math.max(yours, baseline) * 1.25;
const yoursWidth = Math.min(100, (yours / max) * 100);
const baseWidth = Math.min(100, (baseline / max) * 100);
const ahead = lowerIsBetter ? yours < baseline : yours > baseline;
const delta = lowerIsBetter
  ? ((baseline - yours) / baseline) * 100
  : ((yours - baseline) / baseline) * 100;
const deltaText = `${delta > 0 ? '+' : ''}${delta.toFixed(0)}% vs baseline`;
---

<figure class="w">
  <div class="w-bench">
    <div class="w-bench__head">
      <p class="w-bench__title">{label}</p>
      {ahead && <span class="w-bench__badge">{deltaText}</span>}
    </div>
    <div class="w-bench__row" data-us data-behind={ahead ? undefined : ''}>
      <div class="w-bench__meta">
        <span>{yoursLabel}</span>
        <span class="w-bench__num">{yours}{unit}</span>
      </div>
      <div class="w-bench__track" role="presentation"><div class="w-bench__fill" style={`--w:${yoursWidth}%`}></div></div>
    </div>
    <div class="w-bench__row">
      <div class="w-bench__meta">
        <span>{baselineLabel}</span>
        <span class="w-bench__num">{baseline}{unit}</span>
      </div>
      <div class="w-bench__track" role="presentation"><div class="w-bench__fill" style={`--w:${baseWidth}%`}></div></div>
    </div>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
