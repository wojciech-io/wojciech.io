---
import '../styles/widgets.css';
import { imageRungs } from '../lib/imageRungs';

interface Props {
  src: string;
  alt: string;
  url?: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, alt, url, caption, width, height } = Astro.props;

/* The sources run up to 2360px and the prose column caps at 736px, so the
 * widest case needs about a third of the file. Rungs are read from disk rather
 * than from `width`, because not every screenshot on the site declares one. */
const art = imageRungs(src);
---

<figure class="w w-shot">
  <div class="w-shot__window">
    <div class="w-shot__bar">
      <span class="w-shot__dots" aria-hidden="true"><span></span><span></span><span></span></span>
      {url && <span class="w-shot__url">{url}</span>}
    </div>
    <img
      {...art}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
