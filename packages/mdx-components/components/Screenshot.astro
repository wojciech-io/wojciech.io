---
interface Props {
  src: string;
  alt: string;
  url?: string;
  caption?: string;
}

const { src, alt, url, caption } = Astro.props;
---

<figure class="shot">
  <div class="shot__window">
    <div class="shot__bar">
      <span class="shot__dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      {url && <span class="shot__url">{url}</span>}
    </div>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin-block: 1.75rem;
  }
  .shot__window {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
  }
  .shot__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .shot__dots {
    display: inline-flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }
  .shot__dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-border-2);
  }
  .shot__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.1875rem 0.625rem;
    border-radius: var(--radius-badge);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-dim);
  }
  .shot__window img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-dim);
    text-align: center;
  }
</style>
