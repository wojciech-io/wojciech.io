---
import '../styles/widgets.css';

interface Props {
  items?: string[];
  title?: string;
}

const { items = [], title = 'In short' } = Astro.props;
---

<aside class="w w-panel w-tldr" aria-label={title}>
  <p class="w-eyebrow">{title}</p>
  <ul class="w-list">
    {items.map((item) => <li>{item}</li>)}
    <slot />
  </ul>
</aside>
