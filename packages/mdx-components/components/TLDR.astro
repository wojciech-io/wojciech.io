---
interface Props {
  items?: string[];
  title?: string;
}

const { items = [], title = 'TL;DR · Key insights' } = Astro.props;
---

<div class="tldr">
  <p class="tldr-title">{title}</p>
  <ul>
    {items.map((item) => (
      <li>
        <span class="tldr-dot" aria-hidden="true" />
        <span>{item}</span>
      </li>
    ))}
    <slot />
  </ul>
</div>

<style>
  .tldr {
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    padding: 1.5rem 1.75rem;
    margin: 0 0 2.5rem 0;
  }
  .tldr-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1rem 0;
  }
  .tldr ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tldr :global(li) {
    display: flex;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text);
  }
  .tldr-dot {
    margin-top: 0.5rem;
    flex-shrink: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
</style>
