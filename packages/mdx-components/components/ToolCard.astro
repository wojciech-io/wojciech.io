---
type StatusType = 'live' | 'beta' | 'wip' | 'archived';
type IconType = 'chat' | 'cowork' | 'code' | 'spark';

interface Tool {
  name: string;
  description: string;
  href?: string;
  status?: StatusType;
  tags?: string[];
  meta?: string;
  icon?: IconType;
}

interface Props {
  title?: string;
  caption?: string;
  items?: Tool[];
  cols?: 2 | 3;
}

const { title, caption, items = [], cols = 2 } = Astro.props;

const statusLabels: Record<StatusType, string> = {
  live: 'Live',
  beta: 'Beta',
  wip: 'In progress',
  archived: 'Archived',
};

const iconPaths: Record<IconType, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  cowork:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  code: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  spark:
    '<path d="M12 2l1.9 5.7a2 2 0 0 0 1.3 1.3L21 11l-5.8 2a2 2 0 0 0-1.3 1.3L12 20l-1.9-5.7a2 2 0 0 0-1.3-1.3L3 11l5.8-2a2 2 0 0 0 1.3-1.3L12 2z"/>',
};
---

<section class={`tool-cards tool-cards--cols-${cols}`}>
  {(title || caption) && (
    <header class="tool-cards__header">
      {title && <p class="tool-cards__title">{title}</p>}
      {caption && <p class="tool-cards__caption">{caption}</p>}
    </header>
  )}

  {items.length > 0 ? (
    <div class="tool-cards__grid">
      {items.map((item) => {
        const El = item.href ? 'a' : 'div';
        return (
          <El
            class="tool-card"
            href={item.href}
            target={item.href?.startsWith('http') ? '_blank' : undefined}
            rel={item.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <header class="tool-card__head">
              <span class="tool-card__name">
                {item.icon && (
                  <svg
                    class="tool-card__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconPaths[item.icon]}
                  />
                )}
                {item.name}
              </span>
              {item.status && (
                <span class={`tool-card__status tool-card__status--${item.status}`}>
                  {statusLabels[item.status]}
                </span>
              )}
            </header>
            <p class="tool-card__desc">{item.description}</p>
            {(item.tags?.length || item.meta) && (
              <footer class="tool-card__foot">
                {item.tags && item.tags.map((tag) => (
                  <span class="tool-card__tag">{tag}</span>
                ))}
                {item.meta && <span class="tool-card__meta">{item.meta}</span>}
              </footer>
            )}
          </El>
        );
      })}
    </div>
  ) : (
    <div class="tool-cards__slot">
      <slot />
    </div>
  )}
</section>

<style>
  .tool-cards {
    margin-block: 2rem;
  }

  .tool-cards__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tool-cards__title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .tool-cards__caption {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .tool-cards--cols-2 .tool-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tool-cards--cols-3 .tool-cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  a.tool-card:hover {
    border-color: var(--color-border-2);
    background: var(--color-surface);
  }

  .tool-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tool-card__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
  }

  .tool-card__icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
    color: var(--color-accent-hi);
  }

  .tool-card__status {
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--color-border);
  }

  .tool-card__status--live {
    color: oklch(65% 0.18 145);
    border-color: oklch(65% 0.18 145 / 0.35);
    background: oklch(65% 0.18 145 / 0.08);
  }

  .tool-card__status--beta {
    color: var(--color-accent-hi);
    border-color: var(--color-accent) / 0.35;
    background: var(--color-accent) / 0.08;
  }

  .tool-card__status--wip {
    color: oklch(65% 0.15 55);
    border-color: oklch(65% 0.15 55 / 0.35);
    background: oklch(65% 0.15 55 / 0.08);
  }

  .tool-card__status--archived {
    color: var(--color-text-dim);
    border-color: var(--color-border);
    background: transparent;
  }

  .tool-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    flex: 1;
  }

  .tool-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .tool-card__tag {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-badge);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-text-dim);
    background: var(--color-surface);
  }

  .tool-card__meta {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }
</style>
