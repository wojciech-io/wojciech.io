---
import '../styles/widgets.css';

type StatusType = 'live' | 'beta' | 'wip' | 'archived';
type IconType = 'chat' | 'cowork' | 'code' | 'spark';

interface Tool {
  name: string;
  description: string;
  href?: string;
  status?: StatusType;
  tags?: string[];
  meta?: string;
  icon?: IconType;
}

interface Props {
  title?: string;
  caption?: string;
  items?: Tool[];
  cols?: 2 | 3;
}

const { title, caption, items = [], cols = 2 } = Astro.props;

const statusLabels: Record<StatusType, string> = {
  live: 'Live',
  beta: 'Beta',
  wip: 'In progress',
  archived: 'Archived',
};

const iconPaths: Record<IconType, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  cowork:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  code: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  spark:
    '<path d="M12 2l1.9 5.7a2 2 0 0 0 1.3 1.3L21 11l-5.8 2a2 2 0 0 0-1.3 1.3L12 20l-1.9-5.7a2 2 0 0 0-1.3-1.3L3 11l5.8-2a2 2 0 0 0 1.3-1.3L12 2z"/>',
};
---

<section class="w w-tools" data-cols={cols}>
  {(title || caption) && (
    <header class="w-tools__head">
      {title && <p class="w-eyebrow">{title}</p>}
      {caption && <p class="w-cap">{caption}</p>}
    </header>
  )}

  {items.length > 0 ? (
    <div class="w-tools__grid">
      {items.map((item) => {
        const El = item.href ? 'a' : 'div';
        const external = item.href?.startsWith('http');
        return (
          <El
            class="w-tool"
            href={item.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <header class="w-tool__head">
              <span class="w-tool__name">
                {item.icon && (
                  <svg
                    class="w-tool__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconPaths[item.icon]}
                  />
                )}
                {item.name}
              </span>
              {item.status && <span class="w-tool__status" data-s={item.status}>{statusLabels[item.status]}</span>}
            </header>
            <p class="w-tool__desc">{item.description}</p>
            {(item.tags?.length || item.meta) && (
              <footer class="w-tool__foot">
                {item.tags?.map((tag) => <span class="w-tool__tag">{tag}</span>)}
                {item.meta && <span class="w-tool__meta">{item.meta}</span>}
              </footer>
            )}
          </El>
        );
      })}
    </div>
  ) : (
    <div class="w-tools__slot"><slot /></div>
  )}
</section>
