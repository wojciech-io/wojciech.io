---
/**
 * Tabs: interactive tabbed content block.
 * Usage:
 *   <Tabs tabs={[
 *     { label: "Before", content: "Old way of doing things." },
 *     { label: "After",  content: "New way with AI agents." },
 *   ]} />
 *
 * Or with slots for rich content:
 *   <Tabs labels={["Setup", "Config", "Deploy"]}>
 *     <div data-tab="0">Setup content...</div>
 *     <div data-tab="1">Config content...</div>
 *     <div data-tab="2">Deploy content...</div>
 *   </Tabs>
 */
import '../styles/widgets.css';

interface TabItem {
  label: string;
  content?: string;
}
interface Props {
  tabs?: TabItem[];
  labels?: string[];
  defaultTab?: number;
}

const { tabs = [], labels = [], defaultTab = 0 } = Astro.props;
const tabLabels = tabs.length > 0 ? tabs.map((t) => t.label) : labels;
const hasSlots = tabs.length === 0;
const id = `tabs-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="w w-tabs" data-tabs={id} data-default={defaultTab}>
  <div class="w-tabs__bar" role="tablist">
    {tabLabels.map((label, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-selected={i === defaultTab ? 'true' : 'false'}
        aria-controls={hasSlots ? undefined : `${id}-panel-${i}`}
        tabindex={i === defaultTab ? 0 : -1}
        data-tab-index={i}
        class="w-tabs__tab"
      >
        {label}
      </button>
    ))}
    <span class="w-tabs__ink" aria-hidden="true"></span>
  </div>

  <div class="w-tabs__content">
    {tabs.length > 0
      ? tabs.map((tab, i) => (
          <div
            id={`${id}-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`${id}-tab-${i}`}
            class="w-tabs__panel"
            data-active={i === defaultTab ? '' : undefined}
            data-panel-index={i}
          >
            <p>{tab.content}</p>
          </div>
        ))
      : null}
    {hasSlots && <slot />}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((block) => {
    const triggers = [...block.querySelectorAll<HTMLButtonElement>('[data-tab-index]')];
    const panels = [...block.querySelectorAll<HTMLElement>('[data-panel-index]')];
    const slotPanels = [...block.querySelectorAll<HTMLElement>('[data-tab]')];
    const ink = block.querySelector<HTMLElement>('.w-tabs__ink');
    const blockId = block.dataset.tabs;

    // Slot panels are author-supplied <div data-tab="i"> with no id/role, so the
    // buttons' aria-controls would dangle. Wire the tab<->panel relationship here:
    // give each panel a matching id + role=tabpanel and point its trigger at it.
    slotPanels.forEach((panel) => {
      const i = Number(panel.dataset.tab);
      const panelId = `${blockId}-panel-${i}`;
      panel.id = panelId;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `${blockId}-tab-${i}`);
      triggers[i]?.setAttribute('aria-controls', panelId);
    });

    function moveInk(index: number) {
      const t = triggers[index];
      if (!ink || !t) return;
      ink.style.width = `${t.offsetWidth}px`;
      ink.style.transform = `translateX(${t.offsetLeft}px)`;
    }

    function activate(index: number, focus = false) {
      triggers.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, i) => p.toggleAttribute('data-active', i === index));
      slotPanels.forEach((p) => p.toggleAttribute('data-active', Number(p.dataset.tab) === index));
      moveInk(index);
      if (focus) triggers[index]?.focus();
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => activate(i));
      trigger.addEventListener('keydown', (e) => {
        const last = triggers.length - 1;
        const next =
          e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        activate(next, true);
      });
    });

    const start = Math.min(Number(block.dataset.default) || 0, triggers.length - 1);
    block.setAttribute('data-ready', '');
    activate(start);
    // the font may swap in after first paint and change the tab widths
    document.fonts?.ready.then(() => moveInk(triggers.findIndex((t) => t.getAttribute('aria-selected') === 'true')));
    new ResizeObserver(() => moveInk(triggers.findIndex((t) => t.getAttribute('aria-selected') === 'true'))).observe(block);
  });
</script>
