---
import '../styles/widgets.css';

// Side-by-side "live" before/after demo. Unlike BeforeAfter.astro which renders
// plain text bodies, this component takes two named slots (`before`, `after`)
// and renders them as actual interactive UI, so visitors can hover, click,
// and feel the difference instead of reading a description.
//
// Usage:
//   <BeforeAfterDemo label="Mobile drawer" caption="Press Escape after opening">
//     <Fragment slot="before">
//       <!-- broken implementation -->
//     </Fragment>
//     <Fragment slot="after">
//       <!-- fixed implementation -->
//     </Fragment>
//   </BeforeAfterDemo>

interface Props {
  label?: string;     // eyebrow above the block
  caption?: string;   // short hint shown above the panels ("Hover this →")
}
const { label, caption } = Astro.props;
---

<figure class="w">
  {label && <p class="w-eyebrow">{label}</p>}
  {caption && <p class="w-demo__hint">{caption}</p>}
  <div class="w-versus">
    <div class="w-versus__side">
      <p class="w-versus__label">Before</p>
      <div class="w-demo__stage"><slot name="before" /></div>
    </div>
    <div class="w-versus__side" data-emph>
      <p class="w-versus__label">After</p>
      <div class="w-demo__stage"><slot name="after" /></div>
    </div>
  </div>
</figure>
