---
import '../styles/widgets.css';

interface Props {
  author?: string;
  role?: string;
  source?: string;
}

const { author, role, source } = Astro.props;
---

<figure class="w w-quote" data-plain>
  <blockquote class="w-quote__text">
    <slot />
  </blockquote>
  {(author || source) && (
    <figcaption class="w-quote__by">
      {author && <strong>{author}</strong>}
      {role && <span class="w-quote__role">{role}</span>}
      {source && <cite class="w-quote__role">{source}</cite>}
    </figcaption>
  )}
</figure>
