---
interface Props {
  author?: string;
  role?: string;
  source?: string;
}

const { author, role, source } = Astro.props;
---

<figure class="article-quote">
  <blockquote class="article-quote__text">
    <slot />
  </blockquote>
  {(author || source) && (
    <figcaption class="article-quote__credit">
      {author && <strong class="article-quote__author">{author}</strong>}
      {role && <span class="article-quote__role">{role}</span>}
      {source && <cite class="article-quote__source">{source}</cite>}
    </figcaption>
  )}
</figure>

<style>
  .article-quote {
    margin-block: 2rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    position: relative;
  }

  .article-quote::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1.25rem;
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent);
    font-weight: 700;
    opacity: 0.4;
    pointer-events: none;
    user-select: none;
  }

  .article-quote__text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text);
    font-style: italic;
    padding-top: 0.5rem;
  }

  .article-quote__text :global(p) {
    margin: 0;
  }

  .article-quote__credit {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .article-quote__author {
    font-size: 0.875rem;
    font-weight: 600;
    font-style: normal;
    color: var(--color-text);
  }

  .article-quote__role {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    font-style: normal;
  }

  .article-quote__source {
    font-size: 0.8125rem;
    font-style: normal;
    color: var(--color-text-dim);
  }

  .article-quote__role::before {
    content: '·';
    margin-right: 0.375rem;
    color: var(--color-text-dim);
  }
</style>
