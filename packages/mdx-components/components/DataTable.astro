---
import '../styles/widgets.css';

interface Column {
  key: string;
  label: string;
  align?: 'left' | 'center' | 'right';
  mono?: boolean;
}

interface Props {
  columns: Column[];
  rows: Record<string, string | number>[];
  caption?: string;
  highlight?: number[];
}

const { columns, rows, caption, highlight = [] } = Astro.props;
const align = (c: Column) => (c.align && c.align !== 'left' ? `text-align:${c.align}` : undefined);
---

<figure class="w w-table">
  <div class="w-table__scroll" tabindex="0" role="region" aria-label={caption ?? 'Table'}>
    <table>
      <thead>
        <tr>
          {columns.map((col) => (
            <th scope="col" style={align(col)}>
              {col.label || <span class="sr-only">Info</span>}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr data-hl={highlight.includes(i) ? '' : undefined}>
            {columns.map((col) => (
              <td data-label={col.label || undefined} data-mono={col.mono ? '' : undefined} style={align(col)}>
                {row[col.key] ?? ''}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
