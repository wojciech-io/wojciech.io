---
import '../styles/widgets.css';

interface Props {
  label?: string;
}

const { label = 'Pro tip' } = Astro.props;
---

<div class="w w-callout" data-tone="tip" role="note">
  <p class="w-callout__head">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
    </svg>
    {label}
  </p>
  <div class="w-callout__body"><slot /></div>
</div>
