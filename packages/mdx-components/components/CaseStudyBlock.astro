---
/**
 * CaseStudyBlock — structured proof block for case study sections.
 * Shows: challenge → system built → result.
 *
 * Usage:
 *   <CaseStudyBlock
 *     tag="GTM architecture"
 *     challenge="Pipeline was generating volume but losing deals at qualification."
 *     system="AI-enriched ICP scoring, CRM routing rules, outbound sequences rebuilt."
 *     result="3× pipeline lift in 6 weeks. BDR time on admin cut by 60%."
 *   />
 */
import '../styles/widgets.css';

interface Props {
  tag?: string;
  client?: string;
  challenge: string;
  system: string;
  result: string;
  timeframe?: string;
}

const { tag, client, challenge, system, result, timeframe } = Astro.props;
---

<div class="w">
  <div class="w-case">
    {(tag || client || timeframe) && (
      <div class="w-case__head">
        {tag && <span class="w-pill">{tag}</span>}
        {client && <span class="w-case__meta">{client}</span>}
        {timeframe && <span class="w-case__meta" data-end>{timeframe}</span>}
      </div>
    )}
    <dl class="w-case__rows">
      <div class="w-case__row">
        <dt>Challenge</dt>
        <dd>{challenge}</dd>
      </div>
      <div class="w-case__row">
        <dt>System built</dt>
        <dd>{system}</dd>
      </div>
      <div class="w-case__row" data-result>
        <dt>Result</dt>
        <dd>{result}</dd>
      </div>
    </dl>
  </div>
</div>
