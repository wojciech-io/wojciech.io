---
import '../styles/widgets.css';
import { figLen } from '../lib/figures';

interface Props {
  value: string;
  label: string;
  body?: string;
  eyebrow?: string;
  delta?: string;
  tone?: 'neutral' | 'accent' | 'warning';
}

const { value, label, body, eyebrow, delta, tone = 'accent' } = Astro.props;
const toneAttr = tone === 'warning' ? 'warn' : undefined;
---

<aside class="w" data-tone={toneAttr}>
  <div class="w-hero">
    <div class="w-hero__metric">
      {eyebrow && <p class="w-hero__eyebrow">{eyebrow}</p>}
      <p class="w-hero__value" style={`--len:${figLen(value)}`}>{value}</p>
      <p class="w-hero__label">{label}</p>
    </div>
    {(body || delta) && (
      <div class="w-hero__copy">
        {delta && <p class="w-hero__delta">{delta}</p>}
        {body && <p>{body}</p>}
        <slot />
      </div>
    )}
  </div>
</aside>
