---
import '../styles/widgets.css';

// A column is an HTML string, a slot, or a titled list. Articles already pass the list form
// ({ title, items }); the component only knew strings, so it printed "[object Object]".
interface Pane {
  title?: string;
  items?: string[];
}

interface Props {
  left?: string | Pane;
  right?: string | Pane;
  ratio?: '1:1' | '2:1' | '1:2';
  gap?: 'sm' | 'md' | 'lg';
}

const { left, right, ratio = '1:1', gap = 'md' } = Astro.props;

const cols = {
  '1:1': '1fr 1fr',
  '2:1': '2fr 1fr',
  '1:2': '1fr 2fr',
};

const gaps = { sm: '1rem', md: '1.75rem', lg: '2.5rem' };
const isPane = (v: unknown): v is Pane => typeof v === 'object' && v !== null;
---

<div class="w">
  <div class="w-two__grid" style={`--cols: ${cols[ratio]}; --gap: ${gaps[gap]}`}>
    <div class="w-two__col">
      {isPane(left) ? (
        <div class="w-two__pane">
          {left.title && <p class="w-two__title">{left.title}</p>}
          {left.items && <ul class="w-list w-list--dot">{left.items.map((item) => <li>{item}</li>)}</ul>}
        </div>
      ) : left ? <Fragment set:html={left} /> : <slot name="left" />}
    </div>
    <div class="w-two__col">
      {isPane(right) ? (
        <div class="w-two__pane">
          {right.title && <p class="w-two__title">{right.title}</p>}
          {right.items && <ul class="w-list w-list--dot">{right.items.map((item) => <li>{item}</li>)}</ul>}
        </div>
      ) : right ? <Fragment set:html={right} /> : <slot name="right" />}
    </div>
  </div>
</div>
