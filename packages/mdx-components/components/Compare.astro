---
import '../styles/widgets.css';

interface Props {
  labelA: string;
  labelB: string;
  tagA?: string;
  tagB?: string;
  /** Emphasise the right-hand column (after). Default true. */
  colorCode?: boolean;
  caption?: string;
}

const { labelA, labelB, tagA, tagB, colorCode = true, caption } = Astro.props;
---

<figure class="w">
  <div class="w-versus">
    <section class="w-versus__side">
      <p class="w-versus__label">
        <span>{labelA}</span>
        {tagA && <span class="w-versus__tag">{tagA}</span>}
      </p>
      <div class="w-versus__body"><slot name="a" /></div>
    </section>
    <section class="w-versus__side" data-emph={colorCode ? '' : undefined}>
      <p class="w-versus__label">
        <span>{labelB}</span>
        {tagB && <span class="w-versus__tag">{tagB}</span>}
      </p>
      <div class="w-versus__body"><slot name="b" /></div>
    </section>
  </div>
  {caption && <figcaption class="w-cap">{caption}</figcaption>}
</figure>
