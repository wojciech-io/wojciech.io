---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'critical';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const variants = {
  note: {
    label: 'Note',
    borderColor: 'border-[var(--color-border-2)]',
    accentBar: 'bg-[var(--color-border-2)]',
    iconBg: 'bg-[var(--color-surface)] border-[var(--color-border)]',
    iconColor: 'text-[var(--color-text-muted)]',
    labelColor: 'text-[var(--color-text-dim)]',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>',
  },
  tip: {
    label: 'Tip',
    borderColor: 'border-[color-mix(in_srgb,var(--color-accent)_35%,transparent)]',
    accentBar: 'bg-[var(--color-accent)]',
    iconBg: 'bg-[var(--color-accent)] border-[var(--color-accent)]',
    iconColor: 'text-[var(--color-accent-text)]',
    labelColor: 'text-[var(--color-accent-hi)]',
    icon: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>',
  },
  warning: {
    label: 'Warning',
    borderColor: 'border-amber-700/40',
    accentBar: 'bg-amber-400',
    iconBg: 'bg-amber-900/30 border-amber-700/50',
    iconColor: 'text-amber-400',
    labelColor: 'text-amber-400',
    icon: '<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
  },
  critical: {
    label: 'Critical',
    borderColor: 'border-red-800/40',
    accentBar: 'bg-red-500',
    iconBg: 'bg-red-900/30 border-red-800/50',
    iconColor: 'text-red-400',
    labelColor: 'text-red-400',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>',
  },
}[type];
---

<aside class:list={[
  'relative flex gap-4 my-7 pl-5 pr-5 py-4 rounded-[var(--radius-card)] border bg-[var(--color-surface-2)] overflow-hidden',
  variants.borderColor,
]}>
  <div class:list={['absolute left-0 inset-y-0 w-[3px] rounded-l-[var(--radius-card)]', variants.accentBar]} aria-hidden="true" />

  <span class:list={[
    'flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center border',
    variants.iconBg, variants.iconColor,
  ]} aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={variants.icon} />
  </span>

  <div class="min-w-0 pt-0.5">
    <p class:list={['text-[11px] font-bold uppercase tracking-widest mb-1', variants.labelColor]}>
      {title ?? variants.label}
    </p>
    <div class="callout-body text-[0.9375rem] leading-relaxed text-[var(--color-text)] [&>p]:my-0 [&>p+p]:mt-2 [&>ul]:mt-1 [&>ul]:pl-4 [&>ul]:list-disc [&>li]:mt-1">
      <slot />
    </div>
  </div>
</aside>
