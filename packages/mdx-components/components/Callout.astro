---
import '../styles/widgets.css';

interface Props {
  type?: 'note' | 'tip' | 'warning' | 'critical';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const variants = {
  note: {
    label: 'Note',
    tone: 'note',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>',
  },
  tip: {
    label: 'Tip',
    tone: 'tip',
    icon: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>',
  },
  warning: {
    label: 'Watch out',
    tone: 'warn',
    icon: '<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
  },
  critical: {
    label: 'Critical',
    tone: 'bad',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>',
  },
}[type];
---

<div class="w w-callout" data-tone={variants.tone} role="note">
  <p class="w-callout__head">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={variants.icon} />
    {title ?? variants.label}
  </p>
  <div class="w-callout__body"><slot /></div>
</div>
