---
import '../styles/widgets.css';

interface TimelineItem {
  date: string;
  title: string;
  body?: string;
  tag?: string;
  highlight?: boolean;
}

interface Props {
  items: TimelineItem[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<div class="w">
  <ol class="w-rail w-rail--dots">
    {items.map(({ date, title, body, tag, highlight }) => (
      <li data-hl={highlight ? '' : undefined}>
        <span class="w-rail__meta">
          <time>{date}</time>
          {tag && <span class="w-rail__tag">{tag}</span>}
        </span>
        <strong class="w-rail__title">{title}</strong>
        {body && <p class="w-rail__body">{body}</p>}
      </li>
    ))}
  </ol>
  {caption && <p class="w-cap">{caption}</p>}
</div>
