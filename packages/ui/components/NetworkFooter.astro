---
/**
 * NetworkFooter — shared footer for all wojciech.io properties.
 *
 * variant="full"   : brand slot + Network column + Connect column + copyright bar.
 *                    Used by academy.wojciech.io and app.wojciech.io.
 * variant="minimal": single copyright line.
 *                    Used by gh.wojciech.io (dashboard context).
 *
 * CSS falls back through both token naming conventions:
 *   --color-* (wojciech.io / app) and -- (academy / gh)
 * so no per-app CSS changes are needed.
 */
interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'full' } = Astro.props;
const year = new Date().getFullYear();

const network = [
  { label: 'wojciech.io',     href: 'https://wojciech.io',           desc: 'Portfolio, writing, contact' },
  { label: 'app.wojciech.io', href: 'https://app.wojciech.io',       desc: 'Apps, CV, stack' },
  { label: 'AI Espresso',     href: 'https://subscribe.wojciech.io', desc: 'Newsletter on AI and GTM' },
  { label: 'AI Growth OS',    href: 'https://academy.wojciech.io',   desc: 'Audio-first AI course' },
  { label: 'NotchCue',        href: 'https://notch.wojciech.io',     desc: 'macOS teleprompter app' },
  { label: 'GrowthHub',       href: 'https://gh.wojciech.io',        desc: 'Operator demand & revenue dashboard' },
];

const connect = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/wojciech-luszczynski/',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: 'https://github.com/wojciechluszczynski',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: 'X / Twitter',
    href: 'https://twitter.com/w_luszczynski',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    label: 'Substack',
    href: 'https://substack.com/@wojciechluszczynski',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  },
  {
    label: 'Newsletter',
    href: 'https://subscribe.wojciech.io',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
];
---

{variant === 'full' ? (
  <footer class="nf-footer">
    <div class="nf-inner">
      <div class="nf-grid">

        <div class="nf-brand">
          <slot name="brand" />
        </div>

        <div>
          <p class="nf-col-title">Network</p>
          <ul class="nf-list">
            {network.map(({ label, href, desc }) => (
              <li>
                <a href={href} title={desc} target="_blank" rel="noopener noreferrer" class="nf-link">{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="nf-col-title">Connect</p>
          <ul class="nf-list">
            {connect.map(({ label, href, icon }) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="nf-link nf-link-icon">
                  <span class="nf-icon" set:html={icon} />
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <div class="nf-bottom">
        <p>© {year} Wojciech Łuszczyński · <a href="https://wojciech.io" class="nf-bottom-link">wojciech.io</a></p>
        <p class="nf-tagline">GTM architect · AI-native builder</p>
      </div>
    </div>
  </footer>
) : (
  <footer class="nf-footer nf-footer--minimal">
    <div class="nf-minimal-inner">
      <span>© {year} Wojciech Łuszczyński</span>
      <span class="nf-dot">·</span>
      <a href="https://wojciech.io" class="nf-bottom-link">wojciech.io</a>
      <span class="nf-dot">·</span>
      <span>GTM architect · AI-native builder</span>
    </div>
  </footer>
)}

<style>
  .nf-footer {
    margin-top: auto;
    width: 100%;
    border-top: 1px solid var(--color-border, var(--border, rgba(0,0,0,0.1)));
    background: var(--color-bg, var(--bg, #fff));
  }
  .nf-inner {
    margin: 0 auto;
    max-width: 1120px;
    padding: 0 24px;
  }
  .nf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 40px 0;
  }
  @media (min-width: 640px) {
    .nf-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 48px 0;
    }
  }
  @media (min-width: 880px) {
    .nf-grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      align-items: start;
    }
  }
  .nf-brand {
    max-width: 320px;
  }
  .nf-col-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-dim, var(--text-3, #999));
    margin: 0 0 16px;
  }
  .nf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .nf-link {
    color: var(--color-text-muted, var(--text-2, #666));
    font-size: 13px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .nf-link:hover {
    color: var(--color-text, var(--text, #111));
  }
  .nf-link-icon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nf-icon {
    flex-shrink: 0;
    opacity: 0.65;
    display: inline-flex;
    align-items: center;
  }
  .nf-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--color-border, var(--border, rgba(0,0,0,0.1)));
    padding: 18px 0;
    font-size: 11px;
    color: var(--color-text-dim, var(--text-3, #999));
  }
  .nf-bottom-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .nf-bottom-link:hover {
    color: var(--color-text, var(--text, #111));
  }
  .nf-tagline {
    text-align: right;
  }

  /* Minimal variant */
  .nf-footer--minimal {
    margin-top: 48px;
    padding: 0;
  }
  .nf-minimal-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 11px;
    color: var(--color-text-dim, var(--text-3, #999));
  }
  .nf-dot {
    opacity: 0.4;
  }
</style>
