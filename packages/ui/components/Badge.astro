---
interface Props {
  variant?: 'default' | 'accent' | 'muted';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'border border-[var(--color-border-2)] text-[var(--color-text-muted)] bg-[var(--color-surface)]',
  accent:  'border border-[var(--color-accent-lo)]/40 text-[var(--color-accent-hi)] bg-[var(--color-accent-lo)]/10',
  muted:   'border border-transparent text-[var(--color-text-dim)] bg-[var(--color-surface-2)]',
};

const classes = [
  'inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full tracking-wide',
  variants[variant],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
</span>
