---
/**
 * LangSwitcher — reusable language toggle for subdomains.
 *
 * On mount it reads localStorage (storageKey) → browser language → defaultLang.
 * On click it stores the selection and updates every element that has
 * data-{lang} attributes on the page (same pattern as app.wojciech.io).
 *
 * CSS falls back through both token conventions:
 *   --color-* (wojciech.io / app)  and  plain -- (academy / gh)
 */
interface Props {
  langs: string[];          // e.g. ['pl', 'en', 'it']
  storageKey?: string;      // localStorage key, default 'appLang'
  defaultLang?: string;     // fallback when nothing stored + browser miss
}

const { langs, storageKey = 'appLang', defaultLang = 'en' } = Astro.props;
---

<div
  class="ls"
  data-langs={langs.join(',')}
  data-storage-key={storageKey}
  data-default={defaultLang}
  role="group"
  aria-label="Language"
>
  {langs.map((l) => (
    <button class="ls-btn" data-lang={l} type="button" aria-pressed="false">
      {l.toUpperCase()}
    </button>
  ))}
</div>

<style>
  .ls {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .ls-btn {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 3px 7px;
    border: 1px solid var(--color-border, var(--border, rgba(0,0,0,0.12)));
    background: transparent;
    color: var(--color-text-dim, var(--text-3, #999));
    cursor: pointer;
    transition: color 0.12s, background 0.12s;
    line-height: 1.4;
    border-radius: 0;
  }
  .ls-btn:first-child { border-radius: 4px 0 0 4px; }
  .ls-btn:last-child  { border-radius: 0 4px 4px 0; }
  .ls-btn + .ls-btn   { border-left: none; }
  .ls-btn:hover {
    color: var(--color-text, var(--text, #111));
  }
  .ls-btn.active {
    color: var(--color-accent, var(--accent, var(--orange, #1a6ef8)));
    border-color: currentColor;
  }
</style>

<script>
  // Cross-subdomain language persistence.
  // Uses a cookie scoped to .wojciech.io so the choice follows the user across
  // wojciech.io, app.wojciech.io, subscribe.wojciech.io, academy.wojciech.io, etc.
  // Falls back to localStorage when the host has no shared parent domain (localhost dev).
  const COOKIE_NAME = 'wio_lang';

  function getSharedDomain(): string | null {
    const host = location.hostname;
    if (!host || host === 'localhost' || /^\d+\.\d+\.\d+\.\d+$/.test(host)) return null;
    // .wojciech.io covers every wojciech.io subdomain; other hosts get host-scoped cookies.
    if (host.endsWith('wojciech.io')) return '.wojciech.io';
    // Strip leftmost label so example.com stays example.com but app.example.com becomes .example.com.
    const parts = host.split('.');
    if (parts.length < 2) return null;
    return '.' + parts.slice(-2).join('.');
  }

  function readCookie(name: string): string | null {
    const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function writeCookie(name: string, value: string) {
    const domain = getSharedDomain();
    const secure = location.protocol === 'https:';
    const parts = [
      `${name}=${encodeURIComponent(value)}`,
      'Path=/',
      'Max-Age=31536000',          // 1 year
      'SameSite=Lax',
    ];
    if (domain) parts.push(`Domain=${domain}`);
    if (secure) parts.push('Secure');
    document.cookie = parts.join('; ');
  }

  function initLangSwitcher(switcher: HTMLElement) {
    const langs = (switcher.dataset.langs ?? 'en').split(',');
    const storageKey = switcher.dataset.storageKey ?? 'appLang';
    const defaultLang = switcher.dataset.default ?? 'en';
    const selector = langs.map((k) => `[data-${k}]`).join(',');

    function persist(l: string) {
      writeCookie(COOKIE_NAME, l);
      try { localStorage.setItem(storageKey, l); } catch (_) { /* */ }
    }

    function readStored(): string | null {
      const fromCookie = readCookie(COOKIE_NAME);
      if (fromCookie && langs.includes(fromCookie)) return fromCookie;
      try {
        const fromLocal = localStorage.getItem(storageKey);
        if (fromLocal && langs.includes(fromLocal)) {
          // Migrate to the shared cookie so the next subdomain hop carries it.
          writeCookie(COOKIE_NAME, fromLocal);
          return fromLocal;
        }
      } catch (_) { /* */ }
      return null;
    }

    function applyLang(l?: string | null) {
      if (l) {
        persist(l);
      } else {
        l = readStored();
        if (!l) {
          const bl = (navigator.language ?? 'en').toLowerCase();
          l = langs.find((k) => bl.startsWith(k)) ?? defaultLang;
        }
      }
      // Update translatable elements
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        const v = el.getAttribute(`data-${l}`) ?? el.getAttribute(`data-${defaultLang}`);
        if (v !== null) el.textContent = v;
      });
      // Sync button states
      switcher.querySelectorAll<HTMLButtonElement>('.ls-btn').forEach((btn) => {
        const active = btn.dataset.lang === l;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      // Expose globally for any legacy onclick="applyLang('xx')" attrs
      (window as Window & { applyLang?: (l: string) => void }).applyLang = (lang: string) => applyLang(lang);
    }

    switcher.querySelectorAll<HTMLButtonElement>('.ls-btn').forEach((btn) => {
      btn.addEventListener('click', () => applyLang(btn.dataset.lang));
    });

    applyLang(null);
  }

  // Init all switchers (dedup guard so safe to call multiple times)
  if (!document.documentElement.dataset.langSwitcherReady) {
    document.documentElement.dataset.langSwitcherReady = 'true';
    document.querySelectorAll<HTMLElement>('.ls[data-langs]').forEach(initLangSwitcher);
  }
</script>
